<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:DensRas</ows:Identifier>
		<ows:Title>DensRas:Densificación y desdensificación de rásters</ows:Title>
		<ows:Abstract>Este programa cambia el lado de la celda de un ráster (lo densifica o desdensifica, según el caso), sin exceder de la envolvente del ráster original, y permitiendo, si es necesario, un cambio de origen de malla. El procedimiento actúa mediante uno de los cuatro métodos de remuestreo siguientes: vecino más cercano, moda de 4 vecinos, interpolación bilineal o interpolación bicúbica. En estas dos últimas opcions (interpolación bilineal y interpolación bicúbica), cuando el valor resultado del remuestreo es un valor fuera del rango de valores del ráster original (inferior al valor mínimo o superior al valor máximo del ráster original), se permite que la persona usuaria seleccione si se desea saturar el valor remuestreado al valor mínimo del ráster original (o máximo según corresponda) o asignar sindatos. Por otro lado, el programa realiza un tratamiento cuidadoso del valor de los sindatos (no lo considera en el remuestreo: por ejemplo, si uno de los 4 vecinos en la posición de una celda en el nuevo ráster es un sindatos y el criterio es la moda, esta moda se calculará considerando sólo a los 3 vecinos con datos).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Densificación y desdensificación de rásters"/>
		<ows:Metadata xlink:title="Abstract:Este programa cambia el lado de la celda de un ráster (lo densifica o desdensifica, según el caso), sin exceder de la envolvente del ráster original, y permitiendo, si es necesario, un cambio de origen de malla. El procedimiento actúa mediante uno de los cuatro métodos de remuestreo siguientes: vecino más cercano, moda de 4 vecinos, interpolación bilineal o interpolación bicúbica. En estas dos últimas opcions (interpolación bilineal y interpolación bicúbica), cuando el valor resultado del remuestreo es un valor fuera del rango de valores del ráster original (inferior al valor mínimo o superior al valor máximo del ráster original), se permite que la persona usuaria seleccione si se desea saturar el valor remuestreado al valor mínimo del ráster original (o máximo según corresponda) o asignar sindatos. Por otro lado, el programa realiza un tratamiento cuidadoso del valor de los sindatos (no lo considera en el remuestreo: por ejemplo, si uno de los 4 vecinos en la posición de una celda en el nuevo ráster es un sindatos y el criterio es la moda, esta moda se calculará considerando sólo a los 3 vecinos con datos)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RasterOriginal</ows:Identifier>
				<ows:Title>Ráster original</ows:Title>
				<ows:Abstract>Nombre del ráster original a densificar.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:RasterOriginal"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Xmin</ows:Identifier>
				<ows:Title>X mínima</ows:Title>
				<ows:Abstract>Define la X mínima del ámbito del raster densificado.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Xmin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Xmax</ows:Identifier>
				<ows:Title>X máxima</ows:Title>
				<ows:Abstract>Define la X máxima del ámbito del raster densificado.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Xmax"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Ymin</ows:Identifier>
				<ows:Title>Y mínima</ows:Title>
				<ows:Abstract>Define la Y mínima del ámbito del raster densificado.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Ymin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Ymax</ows:Identifier>
				<ows:Title>Y máxima</ows:Title>
				<ows:Abstract>Define la Y máxima del ámbito del raster densificado.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:Ymax"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Cpix</ows:Identifier>
				<ows:Title>Lado de la celda</ows:Title>
				<ows:Abstract><![CDATA[Lado de la celda o píxel del ráster densificado.  Si Xmax no corresponde a un valor entero <i>n</i> tal que Xmax=Xmin+n*Cpix, Xmax será convenientemente adaptada. Análogamente para Ymax.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:Lpix"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Remostreig</ows:Identifier>
				<ows:Title>Tipo de remuestreo</ows:Title>
				<ows:Abstract>Indica el tipo de remuestreo: 'V' para vecino más próximo, 'M' para moda de 4 vecinos, 'L' para interpolación bilineal y 'C' para interpolación bicúbica.</ows:Abstract>
				<ows:Metadata xlink:title="Param8"/>
				<ows:Metadata xlink:title="Name:Remuestreo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>V</ows:Value>
						<ows:Value>M</ows:Value>
						<ows:Value>L</ows:Value>
						<ows:Value>C</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>RasterDensificat</ows:Identifier>
				<ows:Title>Ráster densificado</ows:Title>
				<ows:Abstract>Nombre del ráster densificado. Se asume que los ficheros tienen extensión img si no se indica.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:RasterDensificado"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>