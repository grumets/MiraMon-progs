<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Astres:1</ows:Identifier>
		<ows:Title>Obtention of the Sun azimuth and elevation in a place, date and hour on the Earth</ows:Title>
		<ows:Abstract>This program computes, for a place in the Earth given in geographic coordinates, a day and a local solar hour or UTC, the azimuth and elevation of the Sun.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Obtention of the Sun azimuth and elevation in a place, date and hour on the Earth"/>
		<ows:Metadata xlink:title="Abstract: his program computes, for a place in the Earth given in geographic coordinates, a day and a local solar hour or UTC, the azimuth and elevation of the Sun."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>longitud</ows:Identifier>
				<ows:Title>Longitude</ows:Title>
				<ows:Abstract>Longitude in geographic coordinates.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:longitude"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>latitud</ows:Identifier>
				<ows:Title>Latitude</ows:Title>
				<ows:Abstract>Latitude in geographic coordinates.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:latitude"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>dia</ows:Identifier>
				<ows:Title>Day</ows:Title>
				<ows:Abstract>Day of the month, expressed with a number from 1 to 31.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:day"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>6</ows:Value>
						<ows:Value>7</ows:Value>
						<ows:Value>8</ows:Value>
						<ows:Value>9</ows:Value>
						<ows:Value>10</ows:Value>
						<ows:Value>11</ows:Value>
						<ows:Value>12</ows:Value>
						<ows:Value>13</ows:Value>
						<ows:Value>14</ows:Value>
						<ows:Value>15</ows:Value>
						<ows:Value>16</ows:Value>
						<ows:Value>17</ows:Value>
						<ows:Value>18</ows:Value>
						<ows:Value>19</ows:Value>
						<ows:Value>20</ows:Value>
						<ows:Value>21</ows:Value>
						<ows:Value>22</ows:Value>
						<ows:Value>23</ows:Value>
						<ows:Value>24</ows:Value>
						<ows:Value>25</ows:Value>
						<ows:Value>26</ows:Value>
						<ows:Value>27</ows:Value>
						<ows:Value>28</ows:Value>
						<ows:Value>29</ows:Value>
						<ows:Value>30</ows:Value>
						<ows:Value>31</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>mes</ows:Identifier>
				<ows:Title>Month</ows:Title>
				<ows:Abstract>Month of the year, expressed with a number from 1 to 12.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:month"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>6</ows:Value>
						<ows:Value>7</ows:Value>
						<ows:Value>8</ows:Value>
						<ows:Value>9</ows:Value>
						<ows:Value>10</ows:Value>
						<ows:Value>11</ows:Value>
						<ows:Value>12</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>any</ows:Identifier>
				<ows:Title>Year</ows:Title>
				<ows:Abstract>Year, expressed with a number as 2013</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:year"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>hora</ows:Identifier>
				<ows:Title>Hora</ows:Title>
				<ows:Abstract><![CDATA[Time is expressed in hours; 10:45  is indicated 10.75. Local solar time is considered by default, but it can be in UTC if the  <i>/UTC</i> parameter is indicated.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:hour"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>UTC</ows:Identifier>
				<ows:Title>Coordinated Universal Time</ows:Title>
				<ows:Abstract>When time means UTC. Without this parameter time is considered local solar hour.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>StdOut</ows:Identifier>
				<ows:Title>Azimuth and Elevation</ows:Title>
				<ows:Abstract>Azimuth or angle given in degrees with respect to the North and clockwise and elevation or y altura or angle given in degrees with respect to the horizontal.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>