<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:IMGASCII:1</ows:Identifier>
		<ows:Title>IMGASCII</ows:Title>
		<ows:Abstract>Este módulo genera un fichero de texto ASCII a partir del formato raster de MiraMon: img+i.rel en versión 4 o img+doc en versiones anteriores.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Exportación a ASCII del formato ráster de MiraMon"/>
		<ows:Metadata xlink:title="Abstract:Este módulo genera un fichero de texto ASCII a partir del formato raster de MiraMon: img+i.rel en versión 4 o img+doc en versiones anteriores."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract><![CDATA[Indica el formato del fichero ASCII generado<ul><li>1: [Valores ...]</li><li>2: [Coordenada_X Coordenada_Y Valor_raster ...].</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigen</ows:Identifier>
				<ows:Title>Fichero Origen</ows:Title>
				<ows:Abstract>Es el fichero img que deseamos exportar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_DEC_VAL</ows:Identifier>
				<ows:Title>Número de decimales</ows:Title>
				<ows:Abstract>Define el número de decimales deseado para los valores en el caso de un raster con datos reales. Su valor por defecto está definido por la clave DigitsDecimals= de la sección [MiraMon] del fichero de configuración MiraMon.par.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_DEC_POS</ows:Identifier>
				<ows:Title>Numero de decimales coordenadas</ows:Title>
				<ows:Abstract>Define el número de decimales deseado para las coordenadas cuando hay que explicitarlas. Su valor por defecto está definido en la clave DigitsDecimals= de la sección [MiraMon] del fichero de configuración MiraMon.par .</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAPCALERA</ows:Identifier>
				<ows:Title>Cabecera</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>1 si exportamos el ámbito del ráster origen (envolvente y lado de píxel) al fichero resultado</li><li>2 si exportamos toda la documentación del ráster origen.</li><li>3 permite exportar los rásters IMG al formato ASCII adecuado para ArcView, ArcCatalog y ArcMap.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDesti</ows:Identifier>
				<ows:Title>Fichero Destino</ows:Title>
				<ows:Abstract>Es el fichero ASCII resultado. Si quiere extensión hay que ponerla.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-ASCII</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-ASCII</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>