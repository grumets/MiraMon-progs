<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:InfoTop:Param1:1</ows:Identifier>
		<ows:Title>InfoTop</ows:Title>
		<ows:Abstract>This program allows reading data from binary vector files of points, arcs, nodes and polygons, which are topologically structured, in an intelligible way from DOS sessions. Under Windows, this data can be graphically consulted with MiraMon in a more friendly way, but if you want to know some internal value or you want to debug some errors in the topological file, it can be better to use INFOTOP. Top-MiraMon vector files are also known as structured vector files</ows:Abstract>
		<ows:Metadata xlink:title="Title:Information of MiraMon topological files"/>
		<ows:Metadata xlink:title="Abstract:This program allows reading data from binary vector files of points, arcs, nodes and polygons, which are topologically structured, in an intelligible way from DOS sessions. Under Windows, this data can be graphically consulted with MiraMon in a more friendly way, but if you want to know some internal value or you want to debug some errors in the topological file, it can be better to use INFOTOP. Top-MiraMon vector files are also known as structured vector files"/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 1</ows:Title>
				<ows:Abstract>Points file information.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerPnt</ows:Identifier>
				<ows:Title>Point vector file</ows:Title>
				<ows:Abstract>It is the point vector file from which we want to obtain the information.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:PntFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>StdOut</ows:Identifier>
				<ows:Title>Output standar</ows:Title>
				<ows:Abstract>Data in an intelligible way from DOS sessions from binary vector files of points, arcs, nodes and polygons, which are topologically structured..</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:InfoTop:Param1:2</ows:Identifier>
		<ows:Title>InfoTop</ows:Title>
		<ows:Abstract>This program allows reading data from binary vector files of points, arcs, nodes and polygons, which are topologically structured, in an intelligible way from DOS sessions. Under Windows, this data can be graphically consulted with MiraMon in a more friendly way, but if you want to know some internal value or you want to debug some errors in the topological file, it can be better to use INFOTOP. Top-MiraMon vector files are also known as structured vector files</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 2</ows:Title>
				<ows:Abstract>Arcs information. Any information about the polygons will not be shown.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigenArc</ows:Identifier>
				<ows:Title>Arc vector file type</ows:Title>
				<ows:Abstract>It is the arc vector file from which we want to obtain the information.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:ArcFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>StdOut</ows:Identifier>
				<ows:Title>Output standar</ows:Title>
				<ows:Abstract>Data in an intelligible way from DOS sessions from binary vector files of points, arcs, nodes and polygons, which are topologically structured..</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:InfoTop:Param1:3</ows:Identifier>
		<ows:Title>InfoTop</ows:Title>
		<ows:Abstract>This program allows reading data from binary vector files of points, arcs, nodes and polygons, which are topologically structured, in an intelligible way from DOS sessions. Under Windows, this data can be graphically consulted with MiraMon in a more friendly way, but if you want to know some internal value or you want to debug some errors in the topological file, it can be better to use INFOTOP. Top-MiraMon vector files are also known as structured vector files</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 3</ows:Title>
				<ows:Abstract>Polygons information. Information related to arcs, nodes and polygons will be shown. If the arcs file has ever been cycled, we recommend using this option even to view arcs since the information given will be more comprehensive.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigenPol</ows:Identifier>
				<ows:Title>Polygon vector file type</ows:Title>
				<ows:Abstract>It is the polygon vector file from which we want to obtain the information.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:PolFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>StdOut</ows:Identifier>
				<ows:Title>Output standar</ows:Title>
				<ows:Abstract>Data in an intelligible way from DOS sessions from binary vector files of points, arcs, nodes and polygons, which are topologically structured..</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>