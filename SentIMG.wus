<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SentIMG:!Param03</ows:Identifier>
		<ows:Title>SentIMG: Import images Sentinel-2</ows:Title>
		<ows:Abstract>Import a Sentinel-2 data product.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importing images Sentinel-2."/>
		<ows:Metadata xlink:title="Abstract:This application imports Sentinel-2 images to IMG format."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>At the moment, it can only be 1.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerXMLUserProduct</ows:Identifier>
				<ows:Title>XML User Product file</ows:Title>
				<ows:Abstract><![CDATA[<i>User Product</i> XML metadada file of the unzipped product of Sentinel-2 data.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FileXMLUserProduct"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ImportQualMask</ows:Identifier>
				<ows:Title>Import quality masks</ows:Title>
				<ows:Abstract>Import the different quality masks in GML format in each tile to MiraMon format.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CopyQualMask</ows:Identifier>
				<ows:Title>Copy quality masks</ows:Title>
				<ows:Abstract>Copy the different quality masks in GML format in each tile.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>DirSortida</ows:Identifier>
				<ows:Title>Output folder</ows:Title>
				<ows:Abstract>Output directory where all data from each Sentinel-2 product tile or all images from the JP2 file list are imported in MiraMon format.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:OutputFolder"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SentIMG:!Param02</ows:Identifier>
		<ows:Title>SentIMG: Import images Sentinel-2</ows:Title>
		<ows:Abstract>Import a list of Sentinel-2 images of the same tile.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>At the moment, it can only be 1.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>LlistaFitxersJP2</ows:Identifier>
				<ows:Title>List of JP2 files of the same tile.</ows:Title>
				<ows:Abstract>List of JP2 files of the same tile of a Sentinel-2 product.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FileListJP2"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/txt</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/txt</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FitxerXMLUserProduct</ows:Identifier>
				<ows:Title>XML User Product file</ows:Title>
				<ows:Abstract><![CDATA[<i>User Product</i> XML metadada file of the unzipped product of Sentinel-2 data.]]></ows:Abstract>
				<ows:Metadata xlink:title="Name:FileXMLUserProduct"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FitxerXMLGranule</ows:Identifier>
				<ows:Title>Tile XML file</ows:Title>
				<ows:Abstract>XML metadata file of the tile belonging to the list of tile input images.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>DirSortida</ows:Identifier>
				<ows:Title>Output folder</ows:Title>
				<ows:Abstract>Output directory where all data from each Sentinel-2 product tile or all images from the JP2 file list are imported in MiraMon format.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:OutputFolder"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>