<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:IsoMM:1</ows:Identifier>
		<ows:Title>IsoMM</ows:Title>
		<ows:Abstract><![CDATA[This module performs an unsupervised image classification based on Duda and Hart's IsoData method: Duda, RO, PE Hart (1973) "<b>Pattern Classification and Scene Analysis</b>", John Wiley and Sons, New York, [chap. 6, "Unsupervised Learning and Clustering", pp. 226-227].]]></ows:Abstract>
		<ows:Metadata xlink:title="Title:Unsupervised image classification"/>
		<ows:Metadata xlink:title="Abstract:This module performs an unsupervised image classification based on Duda and Hart&apos;s IsoData method: Duda, RO, PE Hart (1973) &quot;&lt;b&gt;Pattern Classification and Scene Analysis&lt;/b&gt;&quot;, John Wiley and Sons, New York, [chap. 6, &quot;Unsupervised Learning and Clustering&quot;, pp. 226-227]."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NBandes</ows:Identifier>
				<ows:Title>Number of bands</ows:Title>
				<ows:Abstract>Number of bands to be used (maximum 250).</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:BandsNumber"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Llista</ows:Identifier>
				<ows:Title>List</ows:Title>
				<ows:Abstract>Text file with the names of the different bands (with path [relative if wished] if they are not in the same directory; and with extension (if not, .img will be assumed).</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:List"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NClusterInicialDiagonal</ows:Identifier>
				<ows:Title>Number of initial cluster centers in the diagonal</ows:Title>
				<ows:Abstract>Number of initial cluster centers in the multivariate diagonal that will be used in the classification.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:InitialclusterDiagonalNumber"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NClusterInicialAleatori</ows:Identifier>
				<ows:Title>Number of initial random cluster center</ows:Title>
				<ows:Abstract>Number of initial cluster centers randomly distributed in the multivariate space that will be used in the classification.</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:InitialRandomClusterNumber"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NClusterInicialMostreig</ows:Identifier>
				<ows:Title>Number of Initial sample cluster center</ows:Title>
				<ows:Abstract><![CDATA[Minimum distance, in map units, between the samples that will be used as cluster centers or initial clusters (<i>e.g.</i>, "D1000.5"), or the number of these samples (<i>e.g.</i>, "N300"). Indicate "D0" or "N0" if this criterion is not required.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:InitialSampleClusterNumber"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>LlindarConvergencia</ows:Identifier>
				<ows:Title>Convergence threshold</ows:Title>
				<ows:Abstract>When the percentage of pixels that move from one cluster to another between two iterations is below this convergence threshold, the process ends.</ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:ConvergenceThreshold"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MaxIter</ows:Identifier>
				<ows:Title>Maximum iterations</ows:Title>
				<ows:Abstract>Maximum number of iterations that the program will perform if the convergence threshold is not reached first.</ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:MaxIter"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MinCluster</ows:Identifier>
				<ows:Title>Minimum cluster</ows:Title>
				<ows:Abstract>Minimum number of pixels needed to form a cluster.</ows:Abstract>
				<ows:Metadata xlink:title="Param08"/>
				<ows:Metadata xlink:title="Name:MinCluster"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MinSimil</ows:Identifier>
				<ows:Title>Minimum similarity</ows:Title>
				<ows:Abstract>Minimum likelihood between classes (per band, >=0, real value). This parameter is only implemented in those classes coming from NClusterBeginSample criterion.</ows:Abstract>
				<ows:Metadata xlink:title="Param09"/>
				<ows:Metadata xlink:title="Name:MinLikeliH"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>NoData</ows:Title>
				<ows:Abstract><![CDATA[value to be ignored:<ul><li>0 in general (use NoData, if available).</li><li>1 if there is a 0 background but it is not correctly described as NoData.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param10"/>
				<ows:Metadata xlink:title="Name:NODATA"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NDesvStd</ows:Identifier>
				<ows:Title>Number standard deviations</ows:Title>
				<ows:Abstract>Number of standard deviations that will be added to or subtracted from the mean value in order to calculate where the initial class centers will be located in the multivariate diagonal; if it is given a value of zero, the range of values of the whole image will be used.</ows:Abstract>
				<ows:Metadata xlink:title="Param11"/>
				<ows:Metadata xlink:title="Name:NDesvStd"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TDist</ows:Identifier>
				<ows:Title>Types of distance</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>1 (Euclidean)</li><li>2 (Manhattan)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param12"/>
				<ows:Metadata xlink:title="Name:TDist"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MaxBandesNODATA</ows:Identifier>
				<ows:Title>Maximum bands NoData</ows:Title>
				<ows:Abstract>Is the maximum number of bands with NoData: 0,1,2,... MAX.</ows:Abstract>
				<ows:Metadata xlink:title="Param13"/>
				<ows:Metadata xlink:title="Name:MaxBandsNODATA"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FITXER_SIGNATURES</ows:Identifier>
				<ows:Title>File of spectral signatures</ows:Title>
				<ows:Abstract>List file of spectral signatures as an optional criterion for initial categories location.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_PROCES</ows:Identifier>
				<ows:Title>Number of processor cores used</ows:Title>
				<ows:Abstract> A specific number of processors to be used  or "MAX" (to use all processors) or "SUB_MAX" (to use all processors except one) can be specified.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Resultat</ows:Identifier>
				<ows:Title>Result</ows:Title>
				<ows:Abstract>Name of the output image (without extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param14"/>
				<ows:Metadata xlink:title="Name:Result"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>Disc</ows:Identifier>
				<ows:Title>Force not to upload the images to sort in memory</ows:Title>
				<ows:Abstract>Useful for low memory computers relative to the size of the files to be classified. Generally it is not necessary to apply because if the program runs out of memory, it switches to this mode automatically.</ows:Abstract>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>