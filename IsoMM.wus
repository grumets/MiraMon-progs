<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:IsoMM:1</ows:Identifier>
		<ows:Title>IsoMM</ows:Title>
		<ows:Abstract>This module performs an unsupervised image classification based on Duda and Hart_s IsoData method:Duda, RO, PE Hart (1973) "Pattern Classification and Scene Analysis" John Wiley and Sons, New York, [cap. 6, "Unsupervised Learning and Clustering", pp. 226-227].</ows:Abstract>
		<ows:Metadata xlink:title="Title:Unsupervised image classification"/>
		<ows:Metadata xlink:title="Abstract:Aquest mòdul realitza una classificació no supervisada d'una imatge inspirat en el mètode clàssic IsoData de Duda i Hart:Duda, RO, PE Hart (1973) Pattern Classification and Scene Analysis, John Wiley and Sons, New York, [cap. 6, Unsupervised Learning and Clustering, pp. 226-227]"/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NBandes</ows:Identifier>
				<ows:Title>Number of bands</ows:Title>
				<ows:Abstract>Number of bands to be used (maximum 250).</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:BandsNumber"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Llista</ows:Identifier>
				<ows:Title>List</ows:Title>
				<ows:Abstract>Text file with the names of the different bands (with path if they are not in the same directory and with extension if they are not IMG).</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:List"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NClusterInicialDiagonal</ows:Identifier>
				<ows:Title>Initial cluster diagonal Number</ows:Title>
				<ows:Abstract>Number of initial cluster centres in the multivariate diagonal that will be used in the classification.</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:InitialclusterDiagonalNumber"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NClusterInicialAleatori</ows:Identifier>
				<ows:Title>Initial random cluster Number</ows:Title>
				<ows:Abstract>Number of initial cluster centers randomly distributed in the multivariate space that will be used in the classification.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:InitialRandomClusterNumber"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NClusterInicialMostreig</ows:Identifier>
				<ows:Title>Initial sample cluster Number</ows:Title>
				<ows:Abstract>Minimum distance, in map units, between the samples that will be used as cluster centers or initial clusters (eg _D1000.5_), or the number of these samples (eg _N300_). Indicate _D0_ or _N0_ if they are not required. </ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:InitialSampleClusterNumber"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>LlindarConvergencia</ows:Identifier>
				<ows:Title>Convergence threshold</ows:Title>
				<ows:Abstract>When the percentage of pixels that move from one cluster to another between two iterations is below this convergence threshold, the process ends.</ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:ConvergenceThreshold"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MaxIter</ows:Identifier>
				<ows:Title>Maximum iterations</ows:Title>
				<ows:Abstract>Maximum number of iterations. Number of iterations that the program will perform if the convergence threshold is not reached first.</ows:Abstract>
				<ows:Metadata xlink:title="Param08"/>
				<ows:Metadata xlink:title="Name:MaxIter"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MinCluster</ows:Identifier>
				<ows:Title>Minimum Cluster</ows:Title>
				<ows:Abstract>Minimum number of pixels needed to form a cluster.</ows:Abstract>
				<ows:Metadata xlink:title="Param09"/>
				<ows:Metadata xlink:title="Name:MinCluster"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MinSimil</ows:Identifier>
				<ows:Title>Minimum similarity</ows:Title>
				<ows:Abstract>Minimum similarity between classes (per band, >=0, real value). This parameter is only implemented in those classes coming from NClusterBeginSample criterion</ows:Abstract>
				<ows:Metadata xlink:title="Param10"/>
				<ows:Metadata xlink:title="Name:MinSimil"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>NO DATA</ows:Title>
				<ows:Abstract> value to be ignored:<![CDATA[<ul><li>0 in general (use NODATA, if available).</li><li>1 if there is a 0 background but it is not correctly described as NODATA.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param11"/>
				<ows:Metadata xlink:title="Name:NODATA"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NDesvStd</ows:Identifier>
				<ows:Title>Number standard deviations</ows:Title>
				<ows:Abstract>Number of standard deviations that will be added to or subtracted from the mean value in order to calculate where the initial class centers will be located in the multivariate diagonal. If it is given a value of zero, the range of values of the whole image will be used.</ows:Abstract>
				<ows:Metadata xlink:title="Param12"/>
				<ows:Metadata xlink:title="Name:NDesvStd"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TDist</ows:Identifier>
				<ows:Title>Types of distance: </ows:Title>
				<ows:Abstract>Types of distance:<![CDATA[<ul><li>1 (Euclidiana)</li><li>2 (Eixample)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param13"/>
				<ows:Metadata xlink:title="Name:TDist"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MaxBandesNODATA</ows:Identifier>
				<ows:Title>Maximum Bands NODATA</ows:Title>
				<ows:Abstract>Is the nummber of maximum bands with NODATA: 0,1,2,... MAX.</ows:Abstract>
				<ows:Metadata xlink:title="Param14"/>
				<ows:Metadata xlink:title="Name:MaxBandsNODATA"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FITXER_SIGNATURES</ows:Identifier>
				<ows:Title>File of spectral signatures</ows:Title>
				<ows:Abstract>List file of spectral signatures as an optional criteria for initial categories location.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Resultat</ows:Identifier>
				<ows:Title>Result</ows:Title>
				<ows:Abstract>Name of the output image (without extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Result"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
