<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:RawIMG:Param1:0</ows:Identifier>
		<ows:Title>Opció 0</ows:Title>
		<ows:Abstract>Informació del fitxer de capçalera.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importació i exportació entre formats ràster binaris (BSQ, BIL, BIP) i IMG del MiraMon"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació permet la conversió entre fitxers binaris i fitxers IMG."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Informació del fitxer de capçalera.</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerHDR</ows:Identifier>
				<ows:Title>Fitxer d'entrada de la capçalera d'un ràster binari</ows:Title>
				<ows:Abstract>Fitxer d'entrada de la capçalera d'un ràster binari.</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:FitxerHDR"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-envi-hdr</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-envi-hdr</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Stdout</ows:Identifier>
				<ows:Title>Estàndard de sortida</ows:Title>
				<ows:Abstract>Informació del fitxer de capçalera d'un fitxer binari.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:RawIMG:Param1:1</ows:Identifier>
		<ows:Title>Opció 1</ows:Title>
		<ows:Abstract>Importació de fitxers binaris a IMG amb el fitxer de capçalera HDR.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Importació de fitxers binaris a IMG amb el fitxer de capçalera HDR.</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerRaw</ows:Identifier>
				<ows:Title>Fitxer ràster binari d'entrada</ows:Title>
				<ows:Abstract>Fitxer ràster binari d'entrada que pot ser monobanda o multibanda.</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:FitxerOriRaw"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerHDR</ows:Identifier>
				<ows:Title>Fitxer d'entrada de la capçalera d'un ràster binari</ows:Title>
				<ows:Abstract>Fitxer d'entrada de la capçalera d'un ràster binari.</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:FitxerHDR"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-envi-hdr</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-envi-hdr</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxSort</ows:Identifier>
				<ows:Title>Fitxer de sortida</ows:Title>
				<ows:Abstract>Fitxer de sortida IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:FitxSort"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:RawIMG:Param1:2</ows:Identifier>
		<ows:Title>Opció 2</ows:Title>
		<ows:Abstract>Importació de fitxers binaris a IMG introduint manualment les metadades.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Importació de fitxers binaris a IMG introduint manualment les metadades.</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerRaw</ows:Identifier>
				<ows:Title>Fitxer ràster binari d'entrada</ows:Title>
				<ows:Abstract>Fitxer ràster binari d'entrada que pot ser monobanda o multibanda.</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:FitxerOriRaw"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Bandes</ows:Identifier>
				<ows:Title>Número de bandes</ows:Title>
				<ows:Abstract>Número de bandes que conté el fitxer binari.</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:Bandes"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Columnes</ows:Identifier>
				<ows:Title>Número de columnes</ows:Title>
				<ows:Abstract>Número de columnes de les bandes que conté el fitxer binari.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:Columnes"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>100</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Files</ows:Identifier>
				<ows:Title>Número de files</ows:Title>
				<ows:Abstract>Número de files de les bandes que conté el fitxer binari.</ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:Files"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>100</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusDades</ows:Identifier>
				<ows:Title>Tipus de dades</ows:Title>
				<ows:Abstract><![CDATA[Tipus de dades de les bandes que conté el fitxer binari:  <ul><li>1 per a byte</li><li>2 per a integer</li><li>3 per a long</li><li>4 per a real</li><li>5 per a double</li><li>12 per a unsigned integer</li><li>13 per a unsigned long</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:TipusDades"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>12</ows:Value>
						<ows:Value>13</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Entrellacat</ows:Identifier>
				<ows:Title>Entrellaçat entre bandes</ows:Title>
				<ows:Abstract><![CDATA[Entrellaçat entre bandes:  <ul><li>0 per a BSQ</li><li>1 per a BIL</li><li>2 per a BIP</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param08"/>
				<ows:Metadata xlink:title="Name:Entrellaçat"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>OrdreBytes</ows:Identifier>
				<ows:Title>Ordre dels bytes</ows:Title>
				<ows:Abstract><![CDATA[Ordre dels bytes:  <ul><li>0 per a Little-Endian</li><li>1 per a Big-Endian</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param09"/>
				<ows:Metadata xlink:title="Name:OrdreBytes"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Offset</ows:Identifier>
				<ows:Title>Desplaçament a l'origen de les dades</ows:Title>
				<ows:Abstract>Número de bytes de la capçalera que s'ha de saltar per començar a llegir a l'origen de les dades.</ows:Abstract>
				<ows:Metadata xlink:title="Param10"/>
				<ows:Metadata xlink:title="Name:Offset"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>Valor sensedades</ows:Title>
				<ows:Abstract>Valor del sensedades.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>255</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SRH</ows:Identifier>
				<ows:Title>Sistema de referència horitzontal</ows:Title>
				<ows:Abstract>Sistema de referència horitzontal.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>UTM-31N-ETRS89</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>XMIN</ows:Identifier>
				<ows:Title>X mínima de l'extensió</ows:Title>
				<ows:Abstract>X mínima de l'extensió del fitxer binari.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>XMAX</ows:Identifier>
				<ows:Title>X màxima de l'extensió</ows:Title>
				<ows:Abstract>X màxima de l'extensió del fitxer binari.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>YMIN</ows:Identifier>
				<ows:Title>Y mínima de l'extensió</ows:Title>
				<ows:Abstract>Y mínima de l'extensió del fitxer binari.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>YMAX</ows:Identifier>
				<ows:Title>Y màxima de l'extensió</ows:Title>
				<ows:Abstract>Y màxima de l'extensió del fitxer binari.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxSort</ows:Identifier>
				<ows:Title>Fitxer de sortida</ows:Title>
				<ows:Abstract>Fitxer de sortida IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:FitxSort"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:RawIMG:Param1:3</ows:Identifier>
		<ows:Title>Opció 3</ows:Title>
		<ows:Abstract>Exportació de fitxers IMG a fitxer binari.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Exportació de fitxers IMG a fitxer binari.</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerIMG</ows:Identifier>
				<ows:Title>Fitxer ràster IMG d'entrada</ows:Title>
				<ows:Abstract>Fitxer ràster IMG d'entrada que pot ser monobanda o multibanda.</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:FitxerOriIMG"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Multibanda</ows:Identifier>
				<ows:Title>Multibanda</ows:Title>
				<ows:Abstract>Paràmetre opcional per si es vol desar els valors de totes les bandes del fitxer d'entrada.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxSort</ows:Identifier>
				<ows:Title>Fitxer de sortida</ows:Title>
				<ows:Abstract>Fitxer de sortida IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:FitxSort"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxSortHDR</ows:Identifier>
				<ows:Title>Fitxer de capçalera de sortida</ows:Title>
				<ows:Abstract>Fitxer de capçalera de sortida.</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:FitxHDRSort"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-envi-hdr</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-envi-hdr</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>