<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:AdapRas:1</ows:Identifier>
		<ows:Title>AdapRas</ows:Title>
		<ows:Abstract><![CDATA[This program fits a raster file according to a geometric pattern of another raster file, even when the pattern raster has a wider bounding box than the raster to be adapted. To change the pixel side of a raster without changing its origin <a href="CanviRes.htm">CanviRes</a> program should be used. To change the origin of the raster grid (without exceeding the bounding box of the original raster), use the program <a href="DensRas.htm">DensRas</a>.]]></ows:Abstract>
		<ows:Metadata xlink:title="Title:Raster fitting"/>
		<ows:Metadata xlink:title="Abstract:This program fits a raster file according to a geometric pattern of another raster file, even when the pattern raster has a wider bounding box than the raster to be adapted. To change the pixel side of a raster without changing its origin &lt;a href=&quot;CanviRes.htm&quot;&gt;CanviRes&lt;/a&gt; program should be used. To change the origin of the raster grid (without exceeding the bounding box of the original raster), use the program &lt;a href=&quot;DensRas.htm&quot;&gt;DensRas&lt;/a&gt;."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Only option in this version of the program. The value "1" must be added in the syntax line.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RasterAAdaptar</ows:Identifier>
				<ows:Title>Raster to fit</ows:Title>
				<ows:Abstract>The file name to fit. It is assumed that the file has extension IMG if not indicated.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:RasterToAdapt"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RasterPatroDeLaGeometria</ows:Identifier>
				<ows:Title>Raster with the geometry pattern.</ows:Title>
				<ows:Abstract>Raster with the new geometry pattern. It is assumed that the file has extension IMG if not indicated.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:RasterGeometryPattern"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusRemostreig</ows:Identifier>
				<ows:Title>Resampling method</ows:Title>
				<ows:Abstract>Resampling method: 'V' Closest neighbor, 'M' mode for the 4 closest neighbor, 'L' Bilinear interpolation and 'C' Bicubic interpolation.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:ResamplingMethod"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>V</ows:Value>
						<ows:Value>M</ows:Value>
						<ows:Value>L</ows:Value>
						<ows:Value>C</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>NoData value</ows:Title>
				<ows:Abstract>The NoData value will be equal to the value given by the user. If not indicated, it will be equal to that of the input raster or, if it does not exist, to that of the table indicated in this document.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>RasterResultat</ows:Identifier>
				<ows:Title>Output raster</ows:Title>
				<ows:Abstract>The name of the output raster file.  It is assumed that the file has extension IMG if not indicated.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:OutputRaster"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>