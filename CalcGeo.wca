<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CalcGeo:1</ows:Identifier>
		<ows:Title>CalcGeo</ows:Title>
		<ows:Abstract>Aquesta aplicació permet convertir les coordenades d'un punt en un cert sistema de referència a les coordenades en un altre sistema de referència.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Calculadora Geodèsica"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació permet convertir les coordenades d&apos;un punt en un cert sistema de referència a les coordenades en un altre sistema de referència."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>SistRefOri</ows:Identifier>
				<ows:Title>Sistema Referència Origen</ows:Title>
				<ows:Abstract>És l'identificador del sistema de referència d'origen, en el qual coneixem les coordenades cartogràfiques.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Sistema_Referencia_Origen"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CoordX</ows:Identifier>
				<ows:Title>Coordenada X</ows:Title>
				<ows:Abstract>Correspon al valor de la coordenada X o a la longitud en el sistema inicial.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Coordenada_X"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CoordY</ows:Identifier>
				<ows:Title>Coordenada Y</ows:Title>
				<ows:Abstract>Correspon al valor de la coordenada Y o a la longitud en el sistema inicial.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Coordenada_Y"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>SistRefResult</ows:Identifier>
				<ows:Title>Sistema Referència Resultat</ows:Title>
				<ows:Abstract>És l'identificador del sistema de referència de les coordenades a calcular. Pot adoptar el valor X i llavors el programa sol·licitarà en temps d'execució el sistema resultat, o pot deixar-se blanc i llavors el sistema final serà aquell descrit en la secció [METRICA] del fitxer de paràmetres MiraMon.par o, en el seu defecte, UTM-31N-ETRS89.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Sistema_Referencia_Resultat"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Stdout</ows:Identifier>
				<ows:Title>Coordenades X  i  Y resultat de la conversió</ows:Title>
				<ows:Abstract>Text descriptiu on es mostren les coordenades d'entrada en el sistema de referència inicial i les coordenades en el sistema de referència final.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>