<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ACP:Param5:0</ows:Identifier>
		<ows:Title>ACP en base a variables no estandarizadas (Opción 0)</ows:Title>
		<ows:Abstract>Calcula los componentes principales en base a variables no estandardizadas (utilitza la matriz de varianzas - covarianzas).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Análisis de Componentes Principales"/>
		<ows:Metadata xlink:title="Abstract:Esta aplicación permite realizar un Análisis de Componentes Principales (ACP) sobre imágenes ráster, basado en la matriz de varianzas - covarianzas o en la de correlaciones mediante el cálculo de los valores propios y vectores propios."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>LlistaImg</ows:Identifier>
				<ows:Title>Lista de imágenes</ows:Title>
				<ows:Abstract>Fichero de texto (típicamente con extensión lst o txt) que contiene una lista de las imágenes originales, dispuestas en líneas sucesivas y con extensión IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:ListaImg"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NumeroCP</ows:Identifier>
				<ows:Title>Nombre de imágenes</ows:Title>
				<ows:Abstract>Nombre de imágenes (componentes principales) a crear.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NumeroCP"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>En base a variables no estandarizadas (utilizar matriz de varianzas - covarianzas).</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Prefix</ows:Identifier>
				<ows:Title>Prefijo</ows:Title>
				<ows:Abstract>Prefijo de los ficheros de salida (componentes principales).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>TXTSortida</ows:Identifier>
				<ows:Title>Archivo de texto de salida</ows:Title>
				<ows:Abstract>Nombre del archivo ASCII a crear, donde se escribirán las matrices de varianzas - covarianzas y de correlaciones, y los valores y vectores propios para todas los componentes. Este archivo puede ser importado directamente a Excel y formateado haciendo "Datos | Texto en columnas".</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:TXTSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>CarpetaSortida</ows:Identifier>
				<ows:Title>Carpeta de salida</ows:Title>
				<ows:Abstract>Directorio dónde se guardarán las imágenes de los componentes principales.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:CarpetaSalida"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ACP:Param5:1</ows:Identifier>
		<ows:Title>ACP en base a variables estandarizadas (Opción 1)</ows:Title>
		<ows:Abstract>Calcula los componentes principales en base a variables estandarizadas (utilizar matriz de correlaciones).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>LlistaImg</ows:Identifier>
				<ows:Title>Lista de imágenes</ows:Title>
				<ows:Abstract>Fichero de texto (típicamente con extensión lst o txt) que contiene una lista de las imágenes originales, dispuestas en líneas sucesivas y con extensión IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:ListaImg"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NumeroCP</ows:Identifier>
				<ows:Title>Nombre de imágenes</ows:Title>
				<ows:Abstract>Nombre de imágenes (componentes principales) a crear.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NumeroCP"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>En base a variables estandarizadas (utilizar matriz de correlaciones).</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Prefix</ows:Identifier>
				<ows:Title>Prefijo</ows:Title>
				<ows:Abstract>Prefijo de los ficheros de salida (componentes principales).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>TXTSortida</ows:Identifier>
				<ows:Title>Archivo de texto de salida</ows:Title>
				<ows:Abstract>Nombre del archivo ASCII a crear, donde se escribirán las matrices de varianzas - covarianzas y de correlaciones, y los valores y vectores propios para todas los componentes. Este archivo puede ser importado directamente a Excel y formateado haciendo "Datos | Texto en columnas".</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:TXTSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>CarpetaSortida</ows:Identifier>
				<ows:Title>Carpeta de salida</ows:Title>
				<ows:Abstract>Directorio dónde se guardarán las imágenes de los componentes principales.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:CarpetaSalida"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>