<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:0</ows:Identifier>
		<ows:Title>Information (Option 0)</ows:Title>
		<ows:Abstract>Information about an MMZX or an MMZ files.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Compression and uncompression of MMZX/MMZ files (diffusion, preservation, etc; limited version)"/>
		<ows:Metadata xlink:title="Abstract:Program that compresses and uncompresses both MMZ files (compressed MiraMon files) and their standardized evolution, MMZX files."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Information about an MMZX or MMZ file.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>MMZ File</ows:Title>
				<ows:Abstract>This is the name of the compressed file (with or without extension) in MMZX, MMZ or ZIP format.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:MMZFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OBRIR_NAVEGADOR</ows:Identifier>
				<ows:Title>Open the browser with the file information</ows:Title>
				<ows:Abstract>Display the information of the compressed file in the Internet browser (in addition to  screen).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESCOMPRIMIR_OPC</ows:Identifier>
				<ows:Title>Uncompress OPC files</ows:Title>
				<ows:Abstract>Uncompress OPC files (only applies when the file to be uncompressed is an MMZX).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Stdout</ows:Identifier>
				<ows:Title>Standard output</ows:Title>
				<ows:Abstract>Information about compressed MiraMon file.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Stdout"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:1</ows:Identifier>
		<ows:Title>Uncompress (Option 1)</ows:Title>
		<ows:Abstract>Uncompress an MMZX or an  MMZ file.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Uncompress an MMZX or an MMZ.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>MMZ File</ows:Title>
				<ows:Abstract>This is the name of the compressed file (with or without extension) in MMZX, MMZ or ZIP format.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:MMZFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>US</ows:Identifier>
				<ows:Title>Mode</ows:Title>
				<ows:Abstract><![CDATA[Syntax simplified according to its use. They are indicated both when compressing and uncompressing.<ul><li>BACKUP: To backup maps or layers and restore them to the same place.</li><li>INTERNET: To make publications on the Internet, or on CD/DVD/USB.</li><li>INTERCANVI: To exchange data with other users.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>BACKUP</ows:Value>
						<ows:Value>INTERNET</ows:Value>
						<ows:Value>INTERCANVI</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>INTERNET</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REGENERACIO</ows:Identifier>
				<ows:Title>Regeneration</ows:Title>
				<ows:Abstract><![CDATA[This parameter refers to the method of regenerating the path when uncompressing, since when compressing it is indicated how to uncompress the files(s).  If not prompted upon uncompressing, the value indicated when compressing is used and, if prompted, the pre-established criterion is ignored when compressing:<ul><li>IDENTICATE: Path must be identical to the saved path (default value when compressing) (absolute as relative and relative as from the 'destination directory').</li><li>IRELATIVA: Path relative to the unit of the file to be open (for example the MMM). In this unit the path is simplified as much as possible. The 'directory tree' criterion is applied to other files that are in other disk drives or in UNC addresses. (Example of UNC address: \\server\resource\map.mmm).</li><li>TREE: The path is written completely above the current directory using the 'directory tree' criterion. (Recommended in the distribution of information by Internet/CD/DVD/USB.).</li><li>NO_PATH: The uncompressed path is deleted, placing all the files in the destination directory, but avoiding names matches.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>IDENTICA</ows:Value>
						<ows:Value>RELATIVA</ows:Value>
						<ows:Value>ARBRE</ows:Value>
						<ows:Value>NO_PATH</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESCOMPRIMIR_OPC</ows:Identifier>
				<ows:Title>Uncompress OPC files</ows:Title>
				<ows:Abstract>Uncompress OPC files (only applies when the file to be uncompressed is an MMZX).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Dir</ows:Identifier>
				<ows:Title>Directory</ows:Title>
				<ows:Abstract>It is the directory within which and from which the files will be uncompressed. It is only indicated in the uncompression; it is optional and if not indicated, the working directory is used. If the map is compressed with the option /US=BACKUP, it is not used.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Dir"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:2</ows:Identifier>
		<ows:Title>Compress directory (Option 2)</ows:Title>
		<ows:Abstract>Compress files in a directory (and subdirectories if indicated).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Compress files from a directory (and subdirectories if specified).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxersDir</ows:Identifier>
				<ows:Title>Files of the directory to be compressed</ows:Title>
				<ows:Abstract>Directory from where the user will extract the files to be compressed. The use of wildcards (using '*' and '?') is allowed. It does not make any special interpretation of MiraMon files and, therefore, it does not follow their links.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:DirFile"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>S</ows:Identifier>
				<ows:Title>Subdirectories</ows:Title>
				<ows:Abstract>Include files in subdirectories that may be in the directory.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>US</ows:Identifier>
				<ows:Title>Mode</ows:Title>
				<ows:Abstract><![CDATA[Syntax simplified according to its use. They are indicated both when compressing and uncompressing.<ul><li>BACKUP: To backup maps or layers and restore them to the same place.</li><li>INTERNET: To make publications on the Internet, or on CD/DVD/USB.</li><li>INTERCANVI: To exchange data with other users.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>BACKUP</ows:Value>
						<ows:Value>INTERNET</ows:Value>
						<ows:Value>INTERCANVI</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>INTERNET</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REGENERACIO</ows:Identifier>
				<ows:Title>Regeneration</ows:Title>
				<ows:Abstract><![CDATA[This parameter refers to the method of regenerating the path when uncompressing, since when compressing it is indicated how to uncompress the files(s).  If not prompted upon uncompressing, the value indicated when compressing is used and, if prompted, the pre-established criterion is ignored when compressing:<ul><li>IDENTICATE: Path must be identical to the saved path (default value when compressing) (absolute as relative and relative as from the 'destination directory').</li><li>IRELATIVA: Path relative to the unit of the file to be open (for example the MMM). In this unit the path is simplified as much as possible. The 'directory tree' criterion is applied to other files that are in other disk drives or in UNC addresses. (Example of UNC address: \\server\resource\map.mmm).</li><li>TREE: The path is written completely above the current directory using the 'directory tree' criterion. (Recommended in the distribution of information by Internet/CD/DVD/USB.).</li><li>NO_PATH: The uncompressed path is deleted, placing all the files in the destination directory, but avoiding names matches.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>IDENTICA</ows:Value>
						<ows:Value>RELATIVA</ows:Value>
						<ows:Value>ARBRE</ows:Value>
						<ows:Value>NO_PATH</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RELATIU</ows:Identifier>
				<ows:Title>Relative</ows:Title>
				<ows:Abstract>If indicated, the paths inside the file will be saved as relative; if not indicated, the paths will be saved as absolute. In place of value a directory can be indicated, and in this case the paths are saved relative to the location of this directory. The user can also leave it blank and the path will be simplified as much as possible in the map unit (.mmm). UNC units or addresses other than those of reference are always kept as absolute. (Indicate this parameter only when compressing.)</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ODBC</ows:Identifier>
				<ows:Title>ODBC</ows:Title>
				<ows:Abstract><![CDATA[Indicates how to compile the linked databases through ODBC (Indicate this parameter only when compressing). In all transforms to DBF format, extended DBF will be used whenever some loss of information would be produced by using classical DBF.<ul><li>FBD_TO_DBF: Convert file type databases (e.g. MDB files) into DBF before compressing. If FBD_SRV_A_DBF is not indicated, the database files are compressed directly in the original format. In the latter case, if these databases contain links to other files, they will also be compressed with the fact that the links should always be written with a relative path.</li> <li>SRV_TO_DBF: Convert server databases (e.g. Oracle) to DBF before compressing. If not indicated, or FBD_SRV_A_DBF has been indicated, this type of database is not compressed, nor the possible links to other files that may contain.</li><li>FBD_SRV_TO_DBF: Convert to DBF the two types of databases indicated above.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>FBD_A_DBF</ows:Value>
						<ows:Value>SRV_A_DBF</ows:Value>
						<ows:Value>FBD_SRV_A_DBF</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SDE</ows:Identifier>
				<ows:Title>ArcSDE/SDO to MiraMon</ows:Title>
				<ows:Abstract><![CDATA[Indicates how ArcSDE and/or SDO-type spatial databases will be compressed (This parameter must be specified only when compressing). <ul><li>SDE_A_DBF: Convert ArcSDE/SDO spatial databases to MiraMon formats before compression. If not specified, this type of database will not be compressed, only REL and/or connection files will be included.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>SDE_A_DBF</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC</ows:Identifier>
				<ows:Title>OPC Files</ows:Title>
				<ows:Abstract>Include OPC files (only applies when the compressed file is an MMZX).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC_THUMBNAIL</ows:Identifier>
				<ows:Title>Thumbnail of the file</ows:Title>
				<ows:Abstract>JPEG image to be used as a thumbnail view of the file. This setting is ideal for ensuring that all sheets in a map series have the same thumbnail preview or view. By default, if this parameter is not specified, an attempt will be made to generate an image automatically from the files/s open in MiraMon, the application will invoke MiraMon and generate the map print in a small JPEG automatically; with a result that will generally be reasonable but, in some cases, unsatisfactory. If the setting is specified but left blank, no preview image (not recommended) will be set. (Only applies when the file to be compressed is an MMZX).</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAPES_LLINATGE</ows:Identifier>
				<ows:Title>Include lineage layers</ows:Title>
				<ows:Abstract>Include all layers that are the source of the lineage of the layer to be compressed (Option not recommended).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRUP</ows:Identifier>
				<ows:Title>Group</ows:Title>
				<ows:Abstract>Group name (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>NOMVAR#</ows:Identifier>
				<ows:Title>Variable name</ows:Title>
				<ows:Abstract>Variable path name (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VALORVAR#</ows:Identifier>
				<ows:Title>Variable value</ows:Title>
				<ows:Abstract>Value to be replaced by the variable (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCVAR#</ows:Identifier>
				<ows:Title>Variable description</ows:Title>
				<ows:Abstract>Description of the variable (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VAR#PATH#</ows:Identifier>
				<ows:Title>Variable path</ows:Title>
				<ows:Abstract>Possible alternative values that the variable can take on when the file is uncompressed. (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATAACTUA</ows:Identifier>
				<ows:Title>Update date</ows:Title>
				<ows:Abstract>Expected update date of the layer. Format: yyyymmdd</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATACADUCA</ows:Identifier>
				<ows:Title>Expired date</ows:Title>
				<ows:Abstract>Layout expiration date. Format: yyyymmdd</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>UBIC#</ows:Identifier>
				<ows:Title>Location</ows:Title>
				<ows:Abstract>Updated information location. (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCUBIC#</ows:Identifier>
				<ows:Title>Location description</ows:Title>
				<ows:Abstract>Description of the location of the updated information (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>MMZ File</ows:Title>
				<ows:Abstract>This is the name of the compressed file (with or without extension) in MMZX, MMZ or ZIP format.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:MMZFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:3</ows:Identifier>
		<ows:Title>Compress map or layer (Option 3)</ows:Title>
		<ows:Abstract>Compress an MMM or a layer and all its linked files. This option also allows the user to certify an MMZX/MMZ that was not certified (only MiraMon Internet Map Publisher corporate license certifier applications).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Compress an MMM or layer, and all its linked files.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMM</ows:Identifier>
				<ows:Title>MMM File</ows:Title>
				<ows:Abstract>It is the file to be compressed (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:MMMFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/j2c</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/ecw</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-msaccess</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>US</ows:Identifier>
				<ows:Title>Mode</ows:Title>
				<ows:Abstract><![CDATA[Syntax simplified according to its use. They are indicated both when compressing and uncompressing.<ul><li>BACKUP: To backup maps or layers and restore them to the same place.</li><li>INTERNET: To make publications on the Internet, or on CD/DVD/USB.</li><li>INTERCANVI: To exchange data with other users.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>BACKUP</ows:Value>
						<ows:Value>INTERNET</ows:Value>
						<ows:Value>INTERCANVI</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>INTERNET</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REGENERACIO</ows:Identifier>
				<ows:Title>Regeneration</ows:Title>
				<ows:Abstract><![CDATA[This parameter refers to the method of regenerating the path when uncompressing, since when compressing it is indicated how to uncompress the files(s).  If not prompted upon uncompressing, the value indicated when compressing is used and, if prompted, the pre-established criterion is ignored when compressing:<ul><li>IDENTICATE: Path must be identical to the saved path (default value when compressing) (absolute as relative and relative as from the 'destination directory').</li><li>IRELATIVA: Path relative to the unit of the file to be open (for example the MMM). In this unit the path is simplified as much as possible. The 'directory tree' criterion is applied to other files that are in other disk drives or in UNC addresses. (Example of UNC address: \\server\resource\map.mmm).</li><li>TREE: The path is written completely above the current directory using the 'directory tree' criterion. (Recommended in the distribution of information by Internet/CD/DVD/USB.).</li><li>NO_PATH: The uncompressed path is deleted, placing all the files in the destination directory, but avoiding names matches.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>IDENTICA</ows:Value>
						<ows:Value>RELATIVA</ows:Value>
						<ows:Value>ARBRE</ows:Value>
						<ows:Value>NO_PATH</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RELATIU</ows:Identifier>
				<ows:Title>Relative</ows:Title>
				<ows:Abstract>If indicated, the paths inside the file will be saved as relative; if not indicated, the paths will be saved as absolute. In place of value a directory can be indicated, and in this case the paths are saved relative to the location of this directory. The user can also leave it blank and the path will be simplified as much as possible in the map unit (.mmm). UNC units or addresses other than those of reference are always kept as absolute. (Indicate this parameter only when compressing.)</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ODBC</ows:Identifier>
				<ows:Title>ODBC</ows:Title>
				<ows:Abstract><![CDATA[Indicates how to compile the linked databases through ODBC (Indicate this parameter only when compressing). In all transforms to DBF format, extended DBF will be used whenever some loss of information would be produced by using classical DBF.<ul><li>FBD_TO_DBF: Convert file type databases (e.g. MDB files) into DBF before compressing. If FBD_SRV_A_DBF is not indicated, the database files are compressed directly in the original format. In the latter case, if these databases contain links to other files, they will also be compressed with the fact that the links should always be written with a relative path.</li> <li>SRV_TO_DBF: Convert server databases (e.g. Oracle) to DBF before compressing. If not indicated, or FBD_SRV_A_DBF has been indicated, this type of database is not compressed, nor the possible links to other files that may contain.</li><li>FBD_SRV_TO_DBF: Convert to DBF the two types of databases indicated above.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>FBD_A_DBF</ows:Value>
						<ows:Value>SRV_A_DBF</ows:Value>
						<ows:Value>FBD_SRV_A_DBF</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SDE</ows:Identifier>
				<ows:Title>ArcSDE/SDO to MiraMon</ows:Title>
				<ows:Abstract><![CDATA[Indicates how ArcSDE and/or SDO-type spatial databases will be compressed (This parameter must be specified only when compressing). <ul><li>SDE_A_DBF: Convert ArcSDE/SDO spatial databases to MiraMon formats before compression. If not specified, this type of database will not be compressed, only REL and/or connection files will be included.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>SDE_A_DBF</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC</ows:Identifier>
				<ows:Title>OPC Files</ows:Title>
				<ows:Abstract>Include OPC files (only applies when the compressed file is an MMZX).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC_THUMBNAIL</ows:Identifier>
				<ows:Title>Thumbnail of the file</ows:Title>
				<ows:Abstract>JPEG image to be used as a thumbnail view of the file. This setting is ideal for ensuring that all sheets in a map series have the same thumbnail preview or view. By default, if this parameter is not specified, an attempt will be made to generate an image automatically from the files/s open in MiraMon, the application will invoke MiraMon and generate the map print in a small JPEG automatically; with a result that will generally be reasonable but, in some cases, unsatisfactory. If the setting is specified but left blank, no preview image (not recommended) will be set. (Only applies when the file to be compressed is an MMZX).</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAPES_LLINATGE</ows:Identifier>
				<ows:Title>Include lineage layers</ows:Title>
				<ows:Abstract>Include all layers that are the source of the lineage of the layer to be compressed (Option not recommended).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CERTIFICAT</ows:Identifier>
				<ows:Title>Certify</ows:Title>
				<ows:Abstract>Certify the files. If left empty, the files will not be certified. Combined with option 3 this allows the user to recompress and certify a MMZX or MMZ, or a layer that was not certified. (Only MiraMon Internet Map Publisher corporate license certifier applications).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRUP</ows:Identifier>
				<ows:Title>Group</ows:Title>
				<ows:Abstract>Group name (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>NOMVAR#</ows:Identifier>
				<ows:Title>Variable name</ows:Title>
				<ows:Abstract>Variable path name (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VALORVAR#</ows:Identifier>
				<ows:Title>Variable value</ows:Title>
				<ows:Abstract>Value to be replaced by the variable (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCVAR#</ows:Identifier>
				<ows:Title>Variable description</ows:Title>
				<ows:Abstract>Description of the variable (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VAR#PATH#</ows:Identifier>
				<ows:Title>Variable path</ows:Title>
				<ows:Abstract>Possible alternative values that the variable can take on when the file is uncompressed. (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATAACTUA</ows:Identifier>
				<ows:Title>Update date</ows:Title>
				<ows:Abstract>Expected update date of the layer. Format: yyyymmdd</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATACADUCA</ows:Identifier>
				<ows:Title>Expired date</ows:Title>
				<ows:Abstract>Layout expiration date. Format: yyyymmdd</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>UBIC#</ows:Identifier>
				<ows:Title>Location</ows:Title>
				<ows:Abstract>Updated information location. (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCUBIC#</ows:Identifier>
				<ows:Title>Location description</ows:Title>
				<ows:Abstract>Description of the location of the updated information (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>MMZ File</ows:Title>
				<ows:Abstract>This is the name of the compressed file (with or without extension) in MMZX, MMZ or ZIP format.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:MMZFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:4</ows:Identifier>
		<ows:Title>Compress MSA (Option 4)</ows:Title>
		<ows:Abstract>Compress an MSA. Not intended for program end users, but for people who have to distribute a MiraMon support application.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Compress an MSA.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>4</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerEXE</ows:Identifier>
				<ows:Title>EXE File</ows:Title>
				<ows:Abstract>This is the name of the EXE MSA file to be compressed (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:EXEFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-exe</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-exe</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>US</ows:Identifier>
				<ows:Title>Mode</ows:Title>
				<ows:Abstract><![CDATA[Syntax simplified according to its use. They are indicated both when compressing and uncompressing.<ul><li>BACKUP: To backup maps or layers and restore them to the same place.</li><li>INTERNET: To make publications on the Internet, or on CD/DVD/USB.</li><li>INTERCANVI: To exchange data with other users.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>BACKUP</ows:Value>
						<ows:Value>INTERNET</ows:Value>
						<ows:Value>INTERCANVI</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>INTERNET</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REGENERACIO</ows:Identifier>
				<ows:Title>Regeneration</ows:Title>
				<ows:Abstract><![CDATA[This parameter refers to the method of regenerating the path when uncompressing, since when compressing it is indicated how to uncompress the files(s).  If not prompted upon uncompressing, the value indicated when compressing is used and, if prompted, the pre-established criterion is ignored when compressing:<ul><li>IDENTICATE: Path must be identical to the saved path (default value when compressing) (absolute as relative and relative as from the 'destination directory').</li><li>IRELATIVA: Path relative to the unit of the file to be open (for example the MMM). In this unit the path is simplified as much as possible. The 'directory tree' criterion is applied to other files that are in other disk drives or in UNC addresses. (Example of UNC address: \\server\resource\map.mmm).</li><li>TREE: The path is written completely above the current directory using the 'directory tree' criterion. (Recommended in the distribution of information by Internet/CD/DVD/USB.).</li><li>NO_PATH: The uncompressed path is deleted, placing all the files in the destination directory, but avoiding names matches.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>IDENTICA</ows:Value>
						<ows:Value>RELATIVA</ows:Value>
						<ows:Value>ARBRE</ows:Value>
						<ows:Value>NO_PATH</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RELATIU</ows:Identifier>
				<ows:Title>Relative</ows:Title>
				<ows:Abstract>If indicated, the paths inside the file will be saved as relative; if not indicated, the paths will be saved as absolute. In place of value a directory can be indicated, and in this case the paths are saved relative to the location of this directory. The user can also leave it blank and the path will be simplified as much as possible in the map unit (.mmm). UNC units or addresses other than those of reference are always kept as absolute. (Indicate this parameter only when compressing.)</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ODBC</ows:Identifier>
				<ows:Title>ODBC</ows:Title>
				<ows:Abstract><![CDATA[Indicates how to compile the linked databases through ODBC (Indicate this parameter only when compressing). In all transforms to DBF format, extended DBF will be used whenever some loss of information would be produced by using classical DBF.<ul><li>FBD_TO_DBF: Convert file type databases (e.g. MDB files) into DBF before compressing. If FBD_SRV_A_DBF is not indicated, the database files are compressed directly in the original format. In the latter case, if these databases contain links to other files, they will also be compressed with the fact that the links should always be written with a relative path.</li> <li>SRV_TO_DBF: Convert server databases (e.g. Oracle) to DBF before compressing. If not indicated, or FBD_SRV_A_DBF has been indicated, this type of database is not compressed, nor the possible links to other files that may contain.</li><li>FBD_SRV_TO_DBF: Convert to DBF the two types of databases indicated above.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>FBD_A_DBF</ows:Value>
						<ows:Value>SRV_A_DBF</ows:Value>
						<ows:Value>FBD_SRV_A_DBF</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SDE</ows:Identifier>
				<ows:Title>ArcSDE/SDO to MiraMon</ows:Title>
				<ows:Abstract><![CDATA[Indicates how ArcSDE and/or SDO-type spatial databases will be compressed (This parameter must be specified only when compressing). <ul><li>SDE_A_DBF: Convert ArcSDE/SDO spatial databases to MiraMon formats before compression. If not specified, this type of database will not be compressed, only REL and/or connection files will be included.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>SDE_A_DBF</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC</ows:Identifier>
				<ows:Title>OPC Files</ows:Title>
				<ows:Abstract>Include OPC files (only applies when the compressed file is an MMZX).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC_THUMBNAIL</ows:Identifier>
				<ows:Title>Thumbnail of the file</ows:Title>
				<ows:Abstract>JPEG image to be used as a thumbnail view of the file. This setting is ideal for ensuring that all sheets in a map series have the same thumbnail preview or view. By default, if this parameter is not specified, an attempt will be made to generate an image automatically from the files/s open in MiraMon, the application will invoke MiraMon and generate the map print in a small JPEG automatically; with a result that will generally be reasonable but, in some cases, unsatisfactory. If the setting is specified but left blank, no preview image (not recommended) will be set. (Only applies when the file to be compressed is an MMZX).</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAPES_LLINATGE</ows:Identifier>
				<ows:Title>Include lineage layers</ows:Title>
				<ows:Abstract>Include all layers that are the source of the lineage of the layer to be compressed (Option not recommended).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRUP</ows:Identifier>
				<ows:Title>Group</ows:Title>
				<ows:Abstract>Group name (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>NOMVAR#</ows:Identifier>
				<ows:Title>Variable name</ows:Title>
				<ows:Abstract>Variable path name (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VALORVAR#</ows:Identifier>
				<ows:Title>Variable value</ows:Title>
				<ows:Abstract>Value to be replaced by the variable (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCVAR#</ows:Identifier>
				<ows:Title>Variable description</ows:Title>
				<ows:Abstract>Description of the variable (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VAR#PATH#</ows:Identifier>
				<ows:Title>Variable path</ows:Title>
				<ows:Abstract>Possible alternative values that the variable can take on when the file is uncompressed. (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATAACTUA</ows:Identifier>
				<ows:Title>Update date</ows:Title>
				<ows:Abstract>Expected update date of the layer. Format: yyyymmdd</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATACADUCA</ows:Identifier>
				<ows:Title>Expired date</ows:Title>
				<ows:Abstract>Layout expiration date. Format: yyyymmdd</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>UBIC#</ows:Identifier>
				<ows:Title>Location</ows:Title>
				<ows:Abstract>Updated information location. (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCUBIC#</ows:Identifier>
				<ows:Title>Location description</ows:Title>
				<ows:Abstract>Description of the location of the updated information (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>MMZ File</ows:Title>
				<ows:Abstract>This is the name of the compressed file (with or without extension) in MMZX, MMZ or ZIP format.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:MMZFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:5</ows:Identifier>
		<ows:Title>Change header (Option 5)</ows:Title>
		<ows:Abstract>Change a value in the header of the file. Option not intended for program end users, but for people that develop MiraMon.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Change a value in the header of the file.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>5</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>5</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>MMZ File</ows:Title>
				<ows:Abstract>This is the name of the compressed file (with or without extension) in MMZX, MMZ or ZIP format.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:MMZFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>IEntrada</ows:Identifier>
				<ows:Title>Input Index</ows:Title>
				<ows:Abstract>This is the index of the compressed file  to which the user will change a feature indicated in the header, indexed from 0.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:IEntry"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NouValor</ows:Identifier>
				<ows:Title>New Value</ows:Title>
				<ows:Abstract>New value in the header of the MMZX/MMZ file. At the moment, the user can only change the OBERTURA parameter that can take the value 1 or 0, or mark the file as installation file with INST_MM3.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NewValue"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>MMZ File</ows:Title>
				<ows:Abstract>This is the name of the compressed file (with or without extension) in MMZX, MMZ or ZIP format.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:MMZFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:6</ows:Identifier>
		<ows:Title>Certify (Option 6)</ows:Title>
		<ows:Abstract>Create map or layer certificates. Overwrites previous certificates if they exist.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Create certificates of MMM files or specific layers.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>6</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>6</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMM</ows:Identifier>
				<ows:Title>MMM File</ows:Title>
				<ows:Abstract>It is the file to be compressed (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:MMMFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/j2c</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/ecw</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-msaccess</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMM</ows:Identifier>
				<ows:Title>MMM File</ows:Title>
				<ows:Abstract>It is the file to be compressed (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:MMMFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/j2c</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/ecw</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-msaccess</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:7</ows:Identifier>
		<ows:Title>Compress without linked (Option 7)</ows:Title>
		<ows:Abstract>Compress an MMM or a layer without including linked files. Not intended for program end users, but for people that develop MiraMon.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Compress an MMM or a layer, but not including the linked files.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>7</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>7</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMM</ows:Identifier>
				<ows:Title>MMM File</ows:Title>
				<ows:Abstract>It is the file to be compressed (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:MMMFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/j2c</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/ecw</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-msaccess</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>US</ows:Identifier>
				<ows:Title>Mode</ows:Title>
				<ows:Abstract><![CDATA[Syntax simplified according to its use. They are indicated both when compressing and uncompressing.<ul><li>BACKUP: To backup maps or layers and restore them to the same place.</li><li>INTERNET: To make publications on the Internet, or on CD/DVD/USB.</li><li>INTERCANVI: To exchange data with other users.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>BACKUP</ows:Value>
						<ows:Value>INTERNET</ows:Value>
						<ows:Value>INTERCANVI</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>INTERNET</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REGENERACIO</ows:Identifier>
				<ows:Title>Regeneration</ows:Title>
				<ows:Abstract><![CDATA[This parameter refers to the method of regenerating the path when uncompressing, since when compressing it is indicated how to uncompress the files(s).  If not prompted upon uncompressing, the value indicated when compressing is used and, if prompted, the pre-established criterion is ignored when compressing:<ul><li>IDENTICATE: Path must be identical to the saved path (default value when compressing) (absolute as relative and relative as from the 'destination directory').</li><li>IRELATIVA: Path relative to the unit of the file to be open (for example the MMM). In this unit the path is simplified as much as possible. The 'directory tree' criterion is applied to other files that are in other disk drives or in UNC addresses. (Example of UNC address: \\server\resource\map.mmm).</li><li>TREE: The path is written completely above the current directory using the 'directory tree' criterion. (Recommended in the distribution of information by Internet/CD/DVD/USB.).</li><li>NO_PATH: The uncompressed path is deleted, placing all the files in the destination directory, but avoiding names matches.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>IDENTICA</ows:Value>
						<ows:Value>RELATIVA</ows:Value>
						<ows:Value>ARBRE</ows:Value>
						<ows:Value>NO_PATH</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RELATIU</ows:Identifier>
				<ows:Title>Relative</ows:Title>
				<ows:Abstract>If indicated, the paths inside the file will be saved as relative; if not indicated, the paths will be saved as absolute. In place of value a directory can be indicated, and in this case the paths are saved relative to the location of this directory. The user can also leave it blank and the path will be simplified as much as possible in the map unit (.mmm). UNC units or addresses other than those of reference are always kept as absolute. (Indicate this parameter only when compressing.)</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SDE</ows:Identifier>
				<ows:Title>ArcSDE/SDO to MiraMon</ows:Title>
				<ows:Abstract><![CDATA[Indicates how ArcSDE and/or SDO-type spatial databases will be compressed (This parameter must be specified only when compressing). <ul><li>SDE_A_DBF: Convert ArcSDE/SDO spatial databases to MiraMon formats before compression. If not specified, this type of database will not be compressed, only REL and/or connection files will be included.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>SDE_A_DBF</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC</ows:Identifier>
				<ows:Title>OPC Files</ows:Title>
				<ows:Abstract>Include OPC files (only applies when the compressed file is an MMZX).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC_THUMBNAIL</ows:Identifier>
				<ows:Title>Thumbnail of the file</ows:Title>
				<ows:Abstract>JPEG image to be used as a thumbnail view of the file. This setting is ideal for ensuring that all sheets in a map series have the same thumbnail preview or view. By default, if this parameter is not specified, an attempt will be made to generate an image automatically from the files/s open in MiraMon, the application will invoke MiraMon and generate the map print in a small JPEG automatically; with a result that will generally be reasonable but, in some cases, unsatisfactory. If the setting is specified but left blank, no preview image (not recommended) will be set. (Only applies when the file to be compressed is an MMZX).</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAPES_LLINATGE</ows:Identifier>
				<ows:Title>Include lineage layers</ows:Title>
				<ows:Abstract>Include all layers that are the source of the lineage of the layer to be compressed (Option not recommended).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRUP</ows:Identifier>
				<ows:Title>Group</ows:Title>
				<ows:Abstract>Group name (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>NOMVAR#</ows:Identifier>
				<ows:Title>Variable name</ows:Title>
				<ows:Abstract>Variable path name (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VALORVAR#</ows:Identifier>
				<ows:Title>Variable value</ows:Title>
				<ows:Abstract>Value to be replaced by the variable (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCVAR#</ows:Identifier>
				<ows:Title>Variable description</ows:Title>
				<ows:Abstract>Description of the variable (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VAR#PATH#</ows:Identifier>
				<ows:Title>Variable path</ows:Title>
				<ows:Abstract>Possible alternative values that the variable can take on when the file is uncompressed. (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATAACTUA</ows:Identifier>
				<ows:Title>Update date</ows:Title>
				<ows:Abstract>Expected update date of the layer. Format: yyyymmdd</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATACADUCA</ows:Identifier>
				<ows:Title>Expired date</ows:Title>
				<ows:Abstract>Layout expiration date. Format: yyyymmdd</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>UBIC#</ows:Identifier>
				<ows:Title>Location</ows:Title>
				<ows:Abstract>Updated information location. (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCUBIC#</ows:Identifier>
				<ows:Title>Location description</ows:Title>
				<ows:Abstract>Description of the location of the updated information (only when compressing).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>MMZ File</ows:Title>
				<ows:Abstract>This is the name of the compressed file (with or without extension) in MMZX, MMZ or ZIP format.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:MMZFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:8</ows:Identifier>
		<ows:Title>Preservation (Option 8)</ows:Title>
		<ows:Abstract>Preserve a map or a layer (either MiraMon, Oracle Spatial, SHP, JPG/JPEG o TIF/TIFF), and all its linked files compressing it into an MMZX file.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Compress for preservation.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>8</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>8</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>F_Ori</ows:Identifier>
				<ows:Title>Original File</ows:Title>
				<ows:Abstract>This is the file to be preserved (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Origin_F"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC_THUMBNAIL</ows:Identifier>
				<ows:Title>Thumbnail of the file</ows:Title>
				<ows:Abstract>JPEG image to be used as a thumbnail view of the file. This setting is ideal for ensuring that all sheets in a map series have the same thumbnail preview or view. By default, if this parameter is not specified, an attempt will be made to generate an image automatically from the files/s open in MiraMon, the application will invoke MiraMon and generate the map print in a small JPEG automatically; with a result that will generally be reasonable but, in some cases, unsatisfactory. If the setting is specified but left blank, no preview image (not recommended) will be set. (Only applies when the file to be compressed is an MMZX).</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAPES_LLINATGE</ows:Identifier>
				<ows:Title>Include lineage layers</ows:Title>
				<ows:Abstract>Include all layers that are the source of the lineage of the layer to be compressed (Option not recommended).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMZX</ows:Identifier>
				<ows:Title>MMZX File</ows:Title>
				<ows:Abstract>This is the name of the compressed file (with extension) in MMZX format.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:MMZXFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>