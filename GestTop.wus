<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestTop:param1:1</ows:Identifier>
		<ows:Title>Conversion of a 3D file to 2D.</ows:Title>
		<ows:Abstract>Converts a 3D vector into 2D by removing its Z component. Note that for polygons, it is necessary to refer to the arc file.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Vector format files"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació agrupa un conjunt d&apos;eines i funcionalitats vectorials, fonamentalment formats estructurats i procediments topològics, però en algun cas també aspectes no estrictament topològics. Són procediments molt específics, que moltes vegades ja formen part d&apos;alguns dels algorismes dels diferents aplicaciós de tractament vectorial i topològic, però en determinades ocasions l&apos;usuari pot necessitar-los de forma individualitzada."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Conversion of a 3D file to 2D.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Arc3D</ows:Identifier>
				<ows:Title>Arc3D</ows:Title>
				<ows:Abstract>The 3D arc file to be converted / converted to 2D.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Arc3D"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Arc3D</ows:Identifier>
				<ows:Title>Arc3D</ows:Title>
				<ows:Abstract>The 3D arc file to be converted / converted to 2D.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Arc3D"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestTop:param1:2</ows:Identifier>
		<ows:Title>Merging VEC objects.</ows:Title>
		<ows:Abstract><![CDATA[Merges connected objects in a VEC file containing arcs or polygons, without analyzing or merging any potential intersections. To handle intersections, please use the <a href="linarc.htm">LinArc</a> application.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Merging VEC objects.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>VectorOrigen</ows:Identifier>
				<ows:Title>Input vector</ows:Title>
				<ows:Abstract>Vector to which the process is applied. If OutputVector is the same as InputVector, the transformation is performed on the vector itself.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:InputVector"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Atribut</ows:Identifier>
				<ows:Title>Attribute</ows:Title>
				<ows:Abstract>This is the constant attribute of the VEC after merging any possible connections.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Attribute"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_DECIMALS</ows:Identifier>
				<ows:Title>Number decimal places.</ows:Title>
				<ows:Abstract>Number of decimal places written in the coordinates of the output file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>VectorDesti</ows:Identifier>
				<ows:Title>Output vector</ows:Title>
				<ows:Abstract>Output vector.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:OutputVector"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestTop:param1:3</ows:Identifier>
		<ows:Title>Bounding boxes of the elements of a topological vector.</ows:Title>
		<ows:Abstract><![CDATA[Writes the bounding box of each object in an arc or polygon file to 4 fields in the main table named MINX, MAXX, MINY, and MAXY. This does not apply to point files; in this case, <a href="PNTBD.htm">PntBd</a> should be used.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Bounding boxes of the elements of a topological vector.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Vector</ows:Identifier>
				<ows:Title>Vector</ows:Title>
				<ows:Abstract>Vector file from which the bounding box of each object will be written to the MINX, MAXX, MINY, and MAXY fields of the main table.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Vector"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Vector</ows:Identifier>
				<ows:Title>Vector</ows:Title>
				<ows:Abstract>Vector file from which the bounding box of each object will be written to the MINX, MAXX, MINY, and MAXY fields of the main table.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Vector"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestTop:param1:4</ows:Identifier>
		<ows:Title>Structuring polygon groups.</ows:Title>
		<ows:Abstract><![CDATA[Topologically structures a polygon layer. Some MiraMon applications, such as DGN_MM or DXFVEC, generate layers in which polygon groups may not be topologically structured for efficiency reasons. This option allows layers generated by these applications to be structured so they can generally be used as input for other applications that require this structure. For more information about polygon groups and their structuring, see the <a href="Ciclar.htm">Ciclar</a> application.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Structuring polygon groups.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>4</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerPolOrig</ows:Identifier>
				<ows:Title>Original polygon file</ows:Title>
				<ows:Abstract>Input file of unstructured polygons.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:InputPolFil"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>AREA_MIN</ows:Identifier>
				<ows:Title>Minimum area</ows:Title>
				<ows:Abstract>Minimum allowed area for a polygon.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>AREA_PERI_MIN</ows:Identifier>
				<ows:Title>Minimum perimeter area</ows:Title>
				<ows:Abstract>Minimum allowed area/perimeter ratio.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NEXE_CRITERIS</ows:Identifier>
				<ows:Title>Criteria connector</ows:Title>
				<ows:Abstract>If both criteria are specified, delete polygons that meet both conditions simultaneously (AND) or those that meet at least one of the conditions (OR). The default value is AND.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>AND</ows:Value>
						<ows:Value>OR</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>AND</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FONDRE</ows:Identifier>
				<ows:Title>Merge</ows:Title>
				<ows:Abstract>Specifies which polygon is assigned the space occupied by the micro-polygon being removed. Specify POL_GRAN to assign the space to the adjacent polygon with the largest area. The default value is FRONTERA_MES_LLARGA, which means that the longest arc of the micro-polygon being removed is deleted.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>POL_GRAN</ows:Value>
						<ows:Value>FRONTERA_MES_LLARGA</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>FRONTERA_MES_LLARGA</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ATRIB_ELIM</ows:Identifier>
				<ows:Title>ATRIB_ELIM</ows:Title>
				<ows:Abstract>Specifies that the polygon absorbing the removed micro-polygon inherits its attributes. If this option is not specified, the micro-polygon's attributes are lost. Note that there is no need to specify which field or fields determine whether the polygon has attributes: a polygon is considered to have no attributes if all non-geometric-topological fields are empty, except, of course, CAMP_LOGIC_ARC if this criterion is also enabled.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerPolDesti</ows:Identifier>
				<ows:Title>Output polygon file</ows:Title>
				<ows:Abstract>Structured polygon file.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:OutputPolFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestTop:param1:5</ows:Identifier>
		<ows:Title>Mark topology as verified</ows:Title>
		<ows:Abstract>Marks the file's topology as verified without checking whether it has actually been verified.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Marks the file's topology as verified without checking whether it has actually been verified.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>5</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>5</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>VectorEstr</ows:Identifier>
				<ows:Title>Vector</ows:Title>
				<ows:Abstract>Vector file from which the bounding box of each object will be written to the MINX, MAXX, MINY, and MAXY fields of the main table.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:StrucVector"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>VectorEstr</ows:Identifier>
				<ows:Title>Vector</ows:Title>
				<ows:Abstract>Vector file from which the bounding box of each object will be written to the MINX, MAXX, MINY, and MAXY fields of the main table.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:StrucVector"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>