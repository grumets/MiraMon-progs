<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:EvapoTr:Param1:ET_THORN_1948</ows:Identifier>
		<ows:Title>Càlcul de l'evapotranspiració potencial (Thornthwaite 1948)</ows:Title>
		<ows:Metadata xlink:title="Title:Càlcul de l&apos;evapotranspiració"/>
		<ows:Metadata xlink:title="Abstract:Aquest programa calcula l&apos;evapotranspiració."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Càlcul de l'evapotranspiració potencial (Thornthwaite 1948).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>ET_THORN_1948</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>ET_THORN_1948</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>LlistaTXT</ows:Identifier>
				<ows:Title>Llista de fitxers IMG</ows:Title>
				<ows:Abstract>Llista de fitxers IMG en format TXT o LST que corresponen a les capes de temperatura dels 12 mesos de l'any. Ha d'haver exactament 12 fitxers IMG a la llista per a poder calcular l'evapotranspiració potencial. En cas contrari, el programa donarà error.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:LlistaTXT"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefix dels fitxers de sortida</ows:Title>
				<ows:Abstract>Prefix que es concatenarà amb els fitxers d'entrada per escriure els fitxers de sortida. En cas de no assignar cap prefix, els fitxers de sortida tindran el mateix nom que els d'entrada.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>DirSortida</ows:Identifier>
				<ows:Title>Directori de sortida</ows:Title>
				<ows:Abstract>Directori de sortida on s'escriuran els fitxers resultants de l'execució del programa.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:DirectoriSortida"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>