	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestBD:param1:13</ows:Identifier>
		<ows:Title>MOSTRA_VALOR_CAMP_DBF (13)</ows:Title>
		<ows:Abstract>Muestra el contenido de un campo para un determinado rango de registros, indizados desde 1.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Muestra el contenido de un campo en un rango de registros, indizados desde 1.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>13</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fichero DBF</ows:Title>
				<ows:Abstract>Fichero en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDBF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomCamp</ows:Identifier>
				<ows:Title>Nombre Campo</ows:Title>
				<ows:Abstract>Nombre del campo de la tabla DBF.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NombreCampo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RegIni</ows:Identifier>
				<ows:Title>Registro Inicial</ows:Title>
				<ows:Abstract>Índice del registro empezando por 1 donde empezar a trabajar o '*' para empezar al final de la tabla.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:RegIni"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RegFi</ows:Identifier>
				<ows:Title>Registro Final</ows:Title>
				<ows:Abstract>Índice del registro (empezando por 1) donde acabar de trabajar o '*' para llegar al final de la tabla.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:RegFinal"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fichero DBF</ows:Title>
				<ows:Abstract>Fichero en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDBF"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestBD:param1:14</ows:Identifier>
		<ows:Title>JOIN_TAULES_DBF (14)</ows:Title>
		<ows:Abstract><![CDATA[Permite la agrupación (<i>join</i>) en una sola tabla de campos de dos tablas DBF diferentes. Se debe establecer una correspondencia entre las dos tablas a partir de uno o múltiples enlaces entre campos equivalentes en las dos tablas; estos campos se denominan campos clave. En la mayoría de casos es suficiente definir un solo campo clave en cada tabla (como se puede ver en el Ejemplo 1) para definir de manera inequívoca la correspondencia entre los registros de las dos tablas. En algunos casos, no obstante, es necesario definir más de un campo clave en una o en las dos tablas implicadas (Ejemplo 2) para definir de manera inequívoca la correspondencia entre las dos tablas; a la combinación de estos campos se llama clave combinada. También se deberá definir todos los campos presentes en la tabla de salida, resultado del <i>join</i>. Si se desea que los campos clave también estén en la tabla de salida, se deberá incluirlos en la lista de campos deseados ya que se podrían usar sólo para actuar de vínculo, pero no  quererlos incluir en la tabla resultado de la operación <i>join</i>.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract><![CDATA[Genera una nueva tabla resultado (FicheroDBFResultado) de un <i>join</i> entre las tablas FicheroDBFPrincipal y FicheroDBFSecundario a partir de uno o múltiples enlaces. Los enlaces se indican a partir de los campos claves /T1_CLAU#  (para la tabla 1) y /T2_CLAU# (para la tabla 2) y los campos presentes en la tabla resultado se indican a partir de sus orígenes con  /T1_CAMP# (para la tabla 1) y /T2_CAMP# (para la tabla 2). # es el número de campo, indizado  desde 1 <b><u>en cada</u></b> tabla.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>14</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDBFPrincipal</ows:Identifier>
				<ows:Title>Fichero DBF Principal</ows:Title>
				<ows:Abstract>Fichero DBF principal en la fusión de tablas  en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroDBFPrincipal"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDBFSecundari</ows:Identifier>
				<ows:Title>Fichero DBF Secundario</ows:Title>
				<ows:Abstract>Fichero DBF secundario en la fusión de tablas en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FicheroDBFSecundario"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>T1_CLAU#</ows:Identifier>
				<ows:Title>T1_CLAU#</ows:Title>
				<ows:Abstract><![CDATA[Nombres de campo clave de la tabla principal T1, a partir de los cuales se establecerá la correspondencia entre las dos tablas para poder realitzar el <I>join</I>. # Indica el orden de los campos claves enlazados, indexados des de 1. Si se indica más de un campo se entiende que se desea que actúen como una clave combinada.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>T2_CLAU#</ows:Identifier>
				<ows:Title>T2_CLAU#</ows:Title>
				<ows:Abstract><![CDATA[Nombres de campo clave de la tabla asociada T2, a partir de los cuales se establecerá la correspondencia entre las dos tablas para poder realitzar el <i>join</i>. # indica el orden de los campos claves enlazados, indexados des de 1.Si se indica más de un campo se entiende que se desea que actúen como una clave combinada.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>T1_CAMP#</ows:Identifier>
				<ows:Title>T1_CAMP#</ows:Title>
				<ows:Abstract>Nombres de los campos de la tabla T1 que formarán parte de la tabla resultado. # es un número de orden (correlativo y comenzando desde 1).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>T2_CAMP#</ows:Identifier>
				<ows:Title>T2_CAMP#</ows:Title>
				<ows:Abstract>Nombres de los campos de la tabla T2 que formarán parte de la tabla resultado. # es un número de orden (correlativo y comenzando desde 1).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RELACIO_1_N</ows:Identifier>
				<ows:Title>Relación 1 a muchos</ows:Title>
				<ows:Abstract>Indica que es posible una relación de cardinalidad múltiple entre un registro de la tabla principal y N registros de la tabla asociada. Su ausencia no permite esta múltiple relación.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NOMES_REG_ENLLAC</ows:Identifier>
				<ows:Title>Solo Registros Enlace</ows:Title>
				<ows:Abstract>Este parámetro implica que únicamente se almacena en la tabla resultado aquellos registros de la tabla principal que tienen correspondencia en la tabla asociada.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDBFResultat</ows:Identifier>
				<ows:Title>Fichero DBF Resultado</ows:Title>
				<ows:Abstract>Fichero DBF resultado en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDBFResultado"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestBD:param1:15</ows:Identifier>
		<ows:Title>ORDENA_TAULA_DBF (15)</ows:Title>
		<ows:Abstract>Realiza una ordenación por uno o múltiples criterios de una tabla DBF. La tabla ordenada se genera en un fichero DBF nuevo y se puede indicar el sentido de ordenación ascendente o descendente para cada criterio.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Genera una nueva tabla resultado (FicheroDBFResultado) de una ordenación definida por uno o más criterios con /CAMP_#. Para cada campo o criterio es posible definir una ordenación ascendente (por defecto) o descendente a partir de /ORDRE_#.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>15</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDBFOrigen</ows:Identifier>
				<ows:Title>Fichero DBF Origen</ows:Title>
				<ows:Abstract>Fichero DBF origen en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroDBFOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>CAMP_#</ows:Identifier>
				<ows:Title>CAMP_#</ows:Title>
				<ows:Abstract>Nombres de los campos que formarán parte de la tabla resultado. # és un número de orden (correlativo y empezando desde 1).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>ORDRE_#</ows:Identifier>
				<ows:Title>ORDRE_#</ows:Title>
				<ows:Abstract>"D" o "d" indica una ordenación descendente y "A" o "a" una ordenación ascendente (por defecto).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDBFResultat</ows:Identifier>
				<ows:Title>Fichero DBF Resultado</ows:Title>
				<ows:Abstract>Fichero DBF resultado en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDBFResultado"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestBD:param1:16</ows:Identifier>
		<ows:Title>SUPR_REGISTRE_DBF (16)</ows:Title>
		<ows:Abstract>Elimina uno o varios registros consecutivos de una tabla DBF. Si se desea  indicar un intervalo indíquese también RegFi. El registro RegFi también será borrado.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Elimina uno o más registros consecutivos de una tabla DBF. Si se desea especificar un intervalo debe indicarse también RegFinal. El registro RegFinal también será eliminado.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>16</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fichero DBF</ows:Title>
				<ows:Abstract>Fichero en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDBF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RegIni</ows:Identifier>
				<ows:Title>Registro Inicial</ows:Title>
				<ows:Abstract>Índice del registro empezando por 1 donde empezar a trabajar o '*' para empezar al final de la tabla.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:RegIni"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RegFi</ows:Identifier>
				<ows:Title>Registro Final</ows:Title>
				<ows:Abstract>Índice del registro (empezando por 1) donde acabar de trabajar o '*' para llegar al final de la tabla.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:RegFinal"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fichero DBF</ows:Title>
				<ows:Abstract>Fichero en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDBF"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestBD:param1:17</ows:Identifier>
		<ows:Title>JOIN_TOTS_ENLLACOS (17)</ows:Title>
		<ows:Abstract><![CDATA[Realiza tantos <i>joins</i> físicos como enlaces tiene la tabla principal y sus tablas asociadas, hasta conseguir una única tabla plana (en formato DBF) con todos los campos de todas las tablas asociadas, excepto los campos clave de las tablas secundarias que implicarían una repetición innecesaria. El tipo de relación indicada en los metadatos gobernará el estilo de <i>join</i> (RELACIO_1_N o RELACIO_N_1). Para realizar este cometido, convierte las tablas ODBC a DBF, lo que puede generar truncados en nombres de campos y cambios de tipos y tamaños. Además, el nombre máximo de campos de la supertabla está limitado a 256 (límite de la dbf resultante).]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract><![CDATA[Genera la 'tabla plana' (no relacional) FicheroDBFResultado, a partir de los <i>joins</i> físicos entre la tabla principal y las tablas asociadas, indicadas en el fichero REL correspondiente a FicheroDBFTablaPrincipal.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>17</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDBFTaulaPrincipal</ows:Identifier>
				<ows:Title>Fitxer DBF Taula Principal</ows:Title>
				<ows:Abstract>Fichero tabla principal en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroDBFTablaPrincipal"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDBFResultat</ows:Identifier>
				<ows:Title>Fichero DBF Resultado</ows:Title>
				<ows:Abstract>Fichero DBF resultado en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDBFResultado"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestBD:param1:18</ows:Identifier>
		<ows:Title>MULTIREGISTRE_A_MULTICAMP (18)</ows:Title>
		<ows:Abstract>Transforma de multiregistro a multicampo. Para definir el multiregistro se toma como criterio las repeticiones de los valores del campo clave, típicamente el campo identificador gráfico. Los campos son replicados como campos múltiples tantas veces como el máximo número de repeticiones de los valores del campo clave.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Se transforma de multiregistro a multicampo. Para definir el multiregistro se toma como a criterio las repeticiones del valor del campo NomCampClau (típicamente el campo identificador gráfico). Los campos entre NomCamp NomCampFinsA son replicados como campos múltiples con un nombre similar (con un índice incremental añadido) tantas veces como el máximo número de repeticiones de los valores del NomCampClau (son añadidos después del campo NomCampDespresDe; típicamente NomCampDespresDe y NomCampFinsA son el mismo).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>18</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fichero DBF</ows:Title>
				<ows:Abstract>Fichero en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDBF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomCampClau</ows:Identifier>
				<ows:Title>Nombre Campo Clave</ows:Title>
				<ows:Abstract>Es el nombre del campo de la tabla DBF que hace de campo clave.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NombreCampoClave"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomCamp</ows:Identifier>
				<ows:Title>Nombre Campo</ows:Title>
				<ows:Abstract>Nombre del campo de la tabla DBF.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NombreCampo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NomCampFinsA</ows:Identifier>
				<ows:Title>Nombre Campo Hasta</ows:Title>
				<ows:Abstract>Nombre del campo que cierra el intervalo, o '*' si se quiere hasta el último campo.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:NombreCampoHasta"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NomCampDespresDe</ows:Identifier>
				<ows:Title>Nombre Campo Después De</ows:Title>
				<ows:Abstract>Nombre del campo después del cual se realiza la operación indicada (crear, eliminar, etc) , o '*' si se realiza antes del primero o ']' si se realiza después del último.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:NombreCampoDespuesDe"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fichero DBF</ows:Title>
				<ows:Abstract>Fichero en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDBF"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestBD:param1:19</ows:Identifier>
		<ows:Title>DUPLICA_REGISTRE_DBF (19)</ows:Title>
		<ows:Abstract>Genera duplicados de registros.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Duplica un registro en una nova posición.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>19</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fichero DBF</ows:Title>
				<ows:Abstract>Fichero en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDBF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RegIni</ows:Identifier>
				<ows:Title>Registro Inicial</ows:Title>
				<ows:Abstract>Índice del registro empezando por 1 donde empezar a trabajar o '*' para empezar al final de la tabla.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:RegIni"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RegDespresDe</ows:Identifier>
				<ows:Title>Registro Después De</ows:Title>
				<ows:Abstract>Índice de registro empezando desde 1 donde se inserta el nuevo registro.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:RegDespuesDe"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fichero DBF</ows:Title>
				<ows:Abstract>Fichero en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDBF"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestBD:param1:20</ows:Identifier>
		<ows:Title>PAS_DE_ODBC_A_ODBC (20)</ows:Title>
		<ows:Abstract><![CDATA[Permite la generación de una tabla de una base de datos a partir de otra tabla, vista o selección (a partir de una sentencia SQL) de otra base de datos. El acceso a les bases de datos se realiza mediante el <i>driver</i> ODBC y por tanto, las bases de datos pueden ser diferentes entre ellas y de cualquier tipo (MS Access, Oracle, SQL Server...). La aplicación intentará crear un duplicado de la tabla, vista o selección, siguiendo lo más fielmente posible el formato de la tabla o datos originales en cuando a tipos de datos, medidas, restricciones,... (hay tipos de datos que son específicos de cada gestor y que no existen en los otros, en estos casos se escogerá el tipo con características más similares). Esta opción es muy útil cuando se tienen sistemas de bases de datos de tipo servidor y se necesita enviar parte de la información a alguien externo que no tiene acceso a la base de datos, por ejemplo si se tiene  una base de datos tipo Oracle o SQL Server. En este caso se pueden  coger les datos que  interesan e exportarlos hacia una base de datos tipo fichero por ejemplo MS Access, de manera que se tengan los datos en un solo fichero.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Permite la generación de una tabla de una base de datos a partir de otra tabla, vista o selección (a partir de una sentencia SQL) de otra base datos.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>20</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerBDOrigen</ows:Identifier>
				<ows:Title>Fichero BD Origen</ows:Title>
				<ows:Abstract>Base de datos origen. Fichero DSN o una base de datos de tipo fichero (como un MDB) accesible vía ODBC.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicherBDOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-msaccess</MimeType>
							<Encoding>Binay</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TaulaOrigen</ows:Identifier>
				<ows:Title>Tabla origen a convertir</ows:Title>
				<ows:Abstract>Puede ser una tabla, una vista o una consulta SQL sobre la base de datos ODBC (si la sentencia requiere comillas, debe usarse diéresis en el su lugar).</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:TablaOrigen"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TaulaResultat</ows:Identifier>
				<ows:Title>Tabla Resultado</ows:Title>
				<ows:Abstract>Tabla resultado de la conversión.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:TablaResultado"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerBDResultat</ows:Identifier>
				<ows:Title>Fichero BD resultado</ows:Title>
				<ows:Abstract>Base de datos resultado. Fichero DSN o una base de datos de tipo fichero (como un MDB) accesible vía ODBC.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroBDResultado"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-msaccess</MimeType>
							<Encoding>Binay</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestBD:param1:21</ows:Identifier>
		<ows:Title>PURGA_TAULA_DBF (21)</ows:Title>
		<ows:Abstract><![CDATA[Determina si hay registros que hayan sido marcados como borrados pero que todavía estén en  la tabla. En caso de encontrarlos los borra físicamente. Solo cambia la fecha del fichero si realmente se ha encontrado registros a borrar. La mayoría de programas de MiraMon ignoran la marca borrado y consideran los registros marcados como borrados como registros normales de la tabla. Así mismo, tanto Excel como ACCESS no muestran los registros marcados como borrados y el <i>driver</i> ODBC para DBF's lo usa en ejecutar una sentencia SQL DELETE.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Se eliminan físicamente del fichero los registros que hayan sido marcados como borrados.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>21</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fichero DBF</ows:Title>
				<ows:Abstract>Fichero en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDBF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fichero DBF</ows:Title>
				<ows:Abstract>Fichero en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDBF"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestBD:param1:22</ows:Identifier>
		<ows:Title>OMPLE_CAMP_TANTP_CENT_A_DBF (22)</ows:Title>
		<ows:Abstract>Se rellena un campo porcentualmente en función de los valores que contiene campo con un valor parcial y un campo que contiene un valor total.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Se rellena un campo porcentualmente en función de los valores que contiene campo con un valor parcial y un campo que contiene un valor total.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>22</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fichero DBF</ows:Title>
				<ows:Abstract>Fichero en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDBF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomCampTantPCent</ows:Identifier>
				<ows:Title>Nombre Campo %</ows:Title>
				<ows:Abstract>Campo a llenar de acuerdo con la razón entre los valores de NombreCampoParcial y NombreCampoTotal.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NombreCampoPorCiento"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomCampParcial</ows:Identifier>
				<ows:Title>Nombre Campo Parcial</ows:Title>
				<ows:Abstract>Nombre Campo Parcial</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NombreCampoParcial"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomCampTotal</ows:Identifier>
				<ows:Title>Nombre Campo Total</ows:Title>
				<ows:Abstract>Nombre Camp Total</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:NombreCampoTotal"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SUMA_CENT</ows:Identifier>
				<ows:Title>Suma Cien</ows:Title>
				<ows:Abstract>Asegurar que los porcentajes calculados sumen 100.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fichero DBF</ows:Title>
				<ows:Abstract>Fichero en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDBF"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestBD:param1:23</ows:Identifier>
		<ows:Title>COMPLETA_JOIN_1_A_N (23)</ows:Title>
		<ows:Abstract>Completa la tabla con los valores que puedan faltar en revisar un JOIN 1 a N entre la tabla y un tesauro a partir de los campos clave que hacen el enlace y los campos a completar. Una vez establecido el JOIN entre las dos tablas, se comprueba si los valores de los campos a completar que provienen del tesauro están presentes en la tabla y en caso contrario, se  incorporan como más registros para ese identificador gráfico.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract><![CDATA[Completa la tabla resultado (FitxerDBF) con los valores que puedan faltar en revisar un <i>join</i> 1 a N entre las tablas FicheroDBF y FicheroDBFSecundario a partir de uno o múltiples enlaces.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>23</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fichero DBF</ows:Title>
				<ows:Abstract>Fichero en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDBF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDBFSecundari</ows:Identifier>
				<ows:Title>Fichero DBF Secundario</ows:Title>
				<ows:Abstract>Fichero DBF secundario en la fusión de tablas en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroDBFSecundario"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>T1_CLAU#</ows:Identifier>
				<ows:Title>T1_CLAU#</ows:Title>
				<ows:Abstract><![CDATA[Nombres de campo clave de la tabla principal T1, a partir de los cuales se establecerá la correspondencia entre las dos tablas para poder realitzar el <I>join</I>. # Indica el orden de los campos claves enlazados, indexados des de 1. Si se indica más de un campo se entiende que se desea que actúen como una clave combinada.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>T2_CLAU#</ows:Identifier>
				<ows:Title>T2_CLAU#</ows:Title>
				<ows:Abstract><![CDATA[Nombres de campo clave de la tabla asociada T2, a partir de los cuales se establecerá la correspondencia entre las dos tablas para poder realitzar el <i>join</i>. # indica el orden de los campos claves enlazados, indexados des de 1.Si se indica más de un campo se entiende que se desea que actúen como una clave combinada.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>T1_CAMP#</ows:Identifier>
				<ows:Title>T1_CAMP#</ows:Title>
				<ows:Abstract>Nombres de los campos de la tabla T1 que formarán parte de la tabla resultado. # es un número de orden (correlativo y comenzando desde 1).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>T2_CAMP#</ows:Identifier>
				<ows:Title>T2_CAMP#</ows:Title>
				<ows:Abstract>Nombres de los campos de la tabla T2 que formarán parte de la tabla resultado. # es un número de orden (correlativo y comenzando desde 1).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fichero DBF</ows:Title>
				<ows:Abstract>Fichero en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDBF"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestBD:param1:24</ows:Identifier>
		<ows:Title>ELEMENT_XML_A_DBF (24)</ows:Title>
		<ows:Abstract><![CDATA[Escribe en una celda de un DBF el nodo XML apuntado por el XPath como un texto. Está pensado para recuperar el valor de los nodos "hoja" del árbol de elementos del documento ya sean elementos o atributos. En un documento como:<?xml version="1.0" encoding="UTF-8"?>               <MD_Metadata>                   <fileIdentifier>5400031_full28_ca</fileIdentifier>                                   <hierarchyLevel>                                     <MD_ScopeCode value="series" />                                   </hierarchyLevel>               </MD_Metadata> pedir el xpath "MD_Metadata/fileIdentifier" recupera: "5400031_full28_ca" o pedir el xpath "MD_Metadata/hierarchyLevel/MD_ScopeCode/@value" recupera: "series".<br/>  Recuérdese que si se pide el XPath de un nodo que no es "hoja" se obtendrán los valores de todos los elementos hijos separados por espacios, resultado que no parece demasiado útil. <br/>  Se debe tener cuidado con xpath como este: /bookstore/book[1]/title "IE5 and later has implemented that [0] should be the first node, but according to the W3C standard it should have been [1]!!" </br> En MiraMon, al usar las librerías de Windows (que son las de IE5) se tiene esta "característica", es decir, que los <i>arrays</i> de nodos comienzan a numerarse por 0 y no por 1.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Rellena una celda de un DBF con los valores (si QueExtr = 'V') o los nombre (si QueExtr = 'N') de un elemento o atributo designado por un XPath de un documento XML. Si el XPath da como resultado más de un elemento, llena más de un registro consecutivo para ese campo. En caso de que (si QueExtr = 'C') llena la celda con el número de nodos que cumplen el XPath.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>24</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fichero DBF</ows:Title>
				<ows:Abstract>Fichero en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDBF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerXML</ows:Identifier>
				<ows:Title>Fichero XML</ows:Title>
				<ows:Abstract>Fichero XML</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroXML"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="100">
				<ows:Identifier>RegIni</ows:Identifier>
				<ows:Title>Registro Inicial</ows:Title>
				<ows:Abstract>Índice del registro empezando por 1 donde empezar a trabajar o '*' para empezar al final de la tabla.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:RegIni"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="100">
				<ows:Identifier>NomCamp</ows:Identifier>
				<ows:Title>Nombre Campo</ows:Title>
				<ows:Abstract>Nombre del campo de la tabla DBF.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:NombreCampo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="100">
				<ows:Identifier>XPath</ows:Identifier>
				<ows:Title>XPath</ows:Title>
				<ows:Abstract>Xpath del documento XML referente a la parte del documento que se quiere extraer información.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:XPath"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>QueExtr</ows:Identifier>
				<ows:Title>Qué extraer</ows:Title>
				<ows:Abstract>Si QueExtr='V' llena la celda con el valor del elemento o el atributo designado por un XPath, si QueExtr='N' llena la celda con el nombre del elemento o el atributo designado por un XPath y si QueExtr='C' llena la celda con el número de nodos que cumplen el XPath.</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:QueExtr"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>V</ows:Value>
						<ows:Value>N</ows:Value>
						<ows:Value>C</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fichero DBF</ows:Title>
				<ows:Abstract>Fichero en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDBF"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
