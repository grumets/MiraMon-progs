					<ows:AllowedValues>
						<ows:Value>11</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fichero DBF</ows:Title>
				<ows:Abstract>Fichero en formato DBF clásico (dBASE III, dBASE III+ o dBASE IV) o en DBF extendido de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDBF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomCamp</ows:Identifier>
				<ows:Title>Nombre Campo</ows:Title>
				<ows:Abstract>Nombre del campo de la tabla DBF.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NombreCampo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
