	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestBD:param1:11</ows:Identifier>
		<ows:Title>DUPLICA_CAMP_DBF (11)</ows:Title>
		<ows:Abstract>Duplica uno o varios campos consecutivos y los sitúa después de un determinado campo.</ows:Abstract>
