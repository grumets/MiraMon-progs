<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GMLMM:Param1:1</ows:Identifier>
		<ows:Title>Importació i exportació entre el format GML i el MiraMon</ows:Title>
		<ows:Abstract>Importa un fitxer en format GML tot creant un Mapa del MiraMon que conté una o més capes (segons convingui en funció del contingut del fitxer GML) en format vectorial estructurat del MiraMon (PNT, ARC/NOD i POL) però no les estructura topològicament.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importació i exportació entre el format GML i el MiraMon"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació permet importar un fitxer en format GML a un Mapa del MiraMon (MMM) que conté capes en format vectorial estructurat del MiraMon (PNT, ARC/NOD i POL) i també permet exportar un Mapa del Miramon o una capa en format vectorial estructurat del MiraMon a GML."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Importació de GML a Mapa del MiraMon</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerGML</ows:Identifier>
				<ows:Title>Fitxer GML</ows:Title>
				<ows:Abstract>Fitxer GML a importar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerGML"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Sistema de Referència Horitzontal Destí</ows:Title>
				<ows:Abstract>Identificador del sistema de referència en què es vol reprojectar les capes, si és que es desitja un sistema de referència diferent al del fitxer origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ORDRECOOR</ows:Identifier>
				<ows:Title>ORDRECOOR</ows:Title>
				<ows:Abstract>LATLONG o LONGLAT. Si s'omet, l'ordre es determina automàticament (ORDRE_LL_AUTO_GML).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>LATLONG</ows:Value>
						<ows:Value>LONGLAT</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VULL_CAMPS_GEOTOPO</ows:Identifier>
				<ows:Title>Camps geomètric-topològics</ows:Title>
				<ows:Abstract>Es demana que s'escriguin també els camps geotopològics en la conversió de MM a GML.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VULL_TAULES_ASSOCIADES</ows:Identifier>
				<ows:Title>Taules associades</ows:Title>
				<ows:Abstract>Es demana que s'escriguin també les taules associades en la conversió de MM a GML.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VULL_TOPO_COM_DBF</ows:Identifier>
				<ows:Title>VULL_TOPO_COM_DBF</ows:Title>
				<ows:Abstract>Es demana que, si es pot, es faci una transformació a GML mantenint la topologia en dues taules associades. En importar un GML de polígons, si es vol recuperar la topologia, primer es llegeix un GML d'arcs associat al de polígons i se'n crea el fitxer d'arcs; després es llegeix el GML de polígons usant les taules de topologia (al mateix directori i amb uns noms concrets). Si no es demana la topologia, el GML de polígons es llegeix directament.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SEPARADOR_COM_A_COMPLEXTYPE</ows:Identifier>
				<ows:Title>SEPARADOR_COM_A_COMPLEXTYPE</ows:Title>
				<ows:Abstract>El separador de camp s'exporta com a GML ComplexType (SEPARADOR_COM_A_GML_COMPLEXTYPE).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMM</ows:Identifier>
				<ows:Title>Fitxer MMM</ows:Title>
				<ows:Abstract>Fitxer de sortida amb extensió .mmm. El programa crearà un directori amb el mateix nom del mapa on hi desarà les capes vectorials que formen el mapa.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerMMM"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GMLMM:Param1:2</ows:Identifier>
		<ows:Title>Exportació d'un Mapa o d'una capa vectorial del MiraMon a GML</ows:Title>
		<ows:Abstract>Exporta un Mapa o una capa en format vectorial estructurat del MiraMon a format GML (WFS Deegree)</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Exportació d'un Mapa o d'una capa vectorial del MiraMon a GML</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMOri</ows:Identifier>
				<ows:Title>Fitxer Vectorial Origen</ows:Title>
				<ows:Abstract>Fitxer origen a exportar. Pot ser un fitxer de mapes, de punts, d'arcs o de polígons.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerMMOri"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-nod</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ARREL_ESQUEMES</ows:Identifier>
				<ows:Title>Adreça base http esquemes validació GML</ows:Title>
				<ows:Abstract>Adreça base dels esquemes de validació GML. Per defecte s'usarà http://miramon.uab.cat/ogc/schemas</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VULL_CAMPS_GEOTOPO</ows:Identifier>
				<ows:Title>Camps geomètric-topològics</ows:Title>
				<ows:Abstract>Es demana que s'escriguin també els camps geotopològics en la conversió de MM a GML.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VULL_TAULES_ASSOCIADES</ows:Identifier>
				<ows:Title>Taules associades</ows:Title>
				<ows:Abstract>Es demana que s'escriguin també les taules associades en la conversió de MM a GML.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VULL_TOPO_COM_DBF</ows:Identifier>
				<ows:Title>VULL_TOPO_COM_DBF</ows:Title>
				<ows:Abstract>Es demana que, si es pot, es faci una transformació a GML mantenint la topologia en dues taules associades. En importar un GML de polígons, si es vol recuperar la topologia, primer es llegeix un GML d'arcs associat al de polígons i se'n crea el fitxer d'arcs; després es llegeix el GML de polígons usant les taules de topologia (al mateix directori i amb uns noms concrets). Si no es demana la topologia, el GML de polígons es llegeix directament.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SEPARADOR_COM_A_COMPLEXTYPE</ows:Identifier>
				<ows:Title>SEPARADOR_COM_A_COMPLEXTYPE</ows:Title>
				<ows:Abstract>El separador de camp s'exporta com a GML ComplexType (SEPARADOR_COM_A_GML_COMPLEXTYPE).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerGML</ows:Identifier>
				<ows:Title>Fitxer GML</ows:Title>
				<ows:Abstract>Fitxer GML de sortida.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerGML"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxerXSD</ows:Identifier>
				<ows:Title>Fitxer XSD</ows:Title>
				<ows:Abstract>Fitxer XSD que contindrà l'esquema d'aplicació en XML per al fitxer GML generat.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FitxerXSD"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
