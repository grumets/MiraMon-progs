<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:AreaSGN:Param1:2</ows:Identifier>
		<ows:Title>Opció 2</ows:Title>
		<ows:Abstract>Aquesta aplicació permet crear els fitxers de les signatures espectrals SGN de totes les bandes espectrals d'una imatge a partir d'unes àrees d'entrenament.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Creació de signatures i estadístiques espectrals a partir d&apos;àrees d&apos;entrenament"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació permet crear els fitxers de les signatures espectrals SGN de totes les bandes espectrals d&apos;una imatge a partir d&apos;unes àrees d&apos;entrenament."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Creació de les signatures espectrals i taula CSV a partir d'una capa ràster o de polígons categòrics.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigen</ows:Identifier>
				<ows:Title>Fitxer origen</ows:Title>
				<ows:Abstract>Fitxer ràster categòric IMG o de polígons POL amb la informació del tipus de classe associat a cada píxel de la imatge o a cada polígon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Llista</ows:Identifier>
				<ows:Title>Fitxer llista de capes ràster</ows:Title>
				<ows:Abstract>Fitxer de text on hi ha el noms de les diferents capes ràster corresponents a bandes d'imatges de satèl·lits, MDT, etc...</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Llista"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP</ows:Identifier>
				<ows:Title>Camp de categoria</ows:Title>
				<ows:Abstract>En el cas que el fitxer origen sigui una capa de polígons, és el camp de taula DBF que conté la classe associada a cada polígon.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REPE</ows:Identifier>
				<ows:Title>Registre escollit quan hi ha més d'un índex</ows:Title>
				<ows:Abstract><![CDATA[Indica quin és el registre triat quan hi ha més d'un registre per  identificador gràfic (registre múltiple). Per a saber més sobre els valors d'aquest paràmetre es pot seguir les consideracions del document de <a href="general.htm#TaulaCamp">sintaxi general</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_CAT</ows:Identifier>
				<ows:Title>Camp amb el nom de les categories</ows:Title>
				<ows:Abstract>En el cas de que el fitxer origen sigui de polígons i s'esculli un camp de categoria numèric, correspon al camp amb els noms de les categories.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MEDIANA_EMPAT</ows:Identifier>
				<ows:Title>Desempat dels quantils</ows:Title>
				<ows:Abstract><![CDATA[Si s'ha sol·licitat el càlcul d'algun quantil (com ara la mediana, un quartil o un percentil), indica el tipus de desempat a usar per al seu càlcul quan la posició del quantil sigui entre dos valors de la sèrie. El criteri també s'aplicarà quan s'ha de calcular la mitjana de les desviacions absolutes respecte de la mediana (ja que requereix calcular la mediana). Les opcions de càlcul són:<ul><li>1 per escollir valor alternat.</li><li>2 per escollir valor inferior.</li><li>3 per escollir valor superior.</li><li>4 per escollir mitjana dels dos valors entre els quals els troba.</li></ul> L'opció per defecte és la 1.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_DECIM_HTML</ows:Identifier>
				<ows:Title>Nombre de decimals de les dades HTML</ows:Title>
				<ows:Abstract>Nombre de decimals de les dades del fitxer HTML de gràfics de signatures.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRAF_HTML_W_IMP</ows:Identifier>
				<ows:Title>Ample resolució qualitat impressió gràfics HTML</ows:Title>
				<ows:Abstract>Ample de la resolució de qualitat per a la impressió dels gràfics de les signatures del fitxer HTML.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>2100</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRAF_HTML_H_IMP</ows:Identifier>
				<ows:Title>Altura resolució qualitat impressió gràfics HTML</ows:Title>
				<ows:Abstract>Altura de la resolució de la qualitat per a la impressió dels gràfics de les signatures del fitxer HTML.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1800</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRAF_HTML_W_VIS</ows:Identifier>
				<ows:Title>Ample resolució estàndard visualització gràfics HTML</ows:Title>
				<ows:Abstract>Ample de la resolució estàndard per a la visualització en pantalla dels gràfics de les signatures del fitxer HTML.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>700</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRAF_HTML_H_VIS</ows:Identifier>
				<ows:Title>Altura resolució estàndard visualització gràfics HTML</ows:Title>
				<ows:Abstract>Altura de la resolució estàndard per a la visualització en pantalla dels gràfics de les signatures del fitxer HTML.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>600</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OBRIR_HTML</ows:Identifier>
				<ows:Title>Obrir fitxer HTML generat</ows:Title>
				<ows:Abstract>Obrir directament el fitxer HTML un cop generat.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DIST_CSV</ows:Identifier>
				<ows:Title>Distància</ows:Title>
				<ows:Abstract><![CDATA[Tipus de distància:<ul><li>EUC: Euclidiana.</li><li>EIX: Eixample (o Manhattan).</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>EUC</ows:Value>
						<ows:Value>EIX</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>EUC</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OBRIR_CSV</ows:Identifier>
				<ows:Title>Obrir el fitxer CSV generat</ows:Title>
				<ows:Abstract>Obrir directament el fitxer CSV un cop generat.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>SGN</ows:Identifier>
				<ows:Title>Signatures espectrals</ows:Title>
				<ows:Abstract>Directori dels fitxers de les signatures espectrals de sortida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:SGN"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
			<Output>
				<ows:Identifier>HTML</ows:Identifier>
				<ows:Title>Fitxer HTML de gràfic de signatures</ows:Title>
				<ows:Abstract>Adreça del fitxer HTML de sortida dels gràfics de les signatures.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/html</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/html</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>CSV</ows:Identifier>
				<ows:Title>Fitxer CSV d'estadístiques espectrals</ows:Title>
				<ows:Abstract>Adreça del fitxer CSV de sortida amb estadístiques espectrals.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>