<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CreaTIN:1</ows:Identifier>
		<ows:Title>Generación de modelos TIN desde una nube de puntos</ows:Title>
		<ows:Abstract><![CDATA[Esta aplicación permite generar una malla TIN (red irregular de triángulos, por <i>triangulated irregular network</i> en inglés) a partir de un fichero de puntos.]]></ows:Abstract>
		<ows:Metadata xlink:title="Title:Generación de modelos TIN desde una nube de puntos"/>
		<ows:Metadata xlink:title="Abstract:Esta aplicación permite generar una malla TIN (red irregular de triángulos, por &lt;i&gt;triangulated irregular network&lt;/i&gt; en inglés) a partir de un fichero de puntos."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opcion</ows:Title>
				<ows:Abstract>Opción única en esta versión del programa. El valor "1" debe ser incluido en la línea de comandos.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>PNTOrigen</ows:Identifier>
				<ows:Title>Fichero de puntos origen</ows:Title>
				<ows:Abstract>Fichero de puntos origen en formato PNT.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroPNTOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CampZ</ows:Identifier>
				<ows:Title>Campo Z</ows:Title>
				<ows:Abstract>Campo utilizado para generar la coordenada Z de los polígonos del TIN de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:CampoZ"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>3D</ows:Identifier>
				<ows:Title>Usar cota 3D de los puntos origen</ows:Title>
				<ows:Abstract>En el caso que el fichero de puntos sea 3D, se utiliza la cota 3D de los puntos origen en lugar de utilizar un campo de la base de datos origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>Usar puntos con cota sindatos o etiqueta vacía</ows:Title>
				<ows:Abstract>Permite usar puntos con cota sindatos (en el caso de usar cota 3D de los puntos origen) o con etiqueta vacía (en el caso de usar un campo de la base de datos origen).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>TINSortida</ows:Identifier>
				<ows:Title>Fichero TIN de salida</ows:Title>
				<ows:Abstract>Fichero TIN de salida en formato POL.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroTINSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>