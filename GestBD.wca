	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestBD:param1:29</ows:Identifier>
		<ows:Title>GENERA_TESAURUS (29)</ows:Title>
		<ows:Abstract>Genera un tesaurus a partir de la projecció del camp indicat.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
