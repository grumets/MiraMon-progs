					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ValorSubstituit</ows:Identifier>
				<ows:Title>Valor Substituït</ows:Title>
				<ows:Abstract>Valor numèric o alfanumèric substituït en un camp d'un DBF.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:ValorSubstituit"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VALOR_COMPLET</ows:Identifier>
				<ows:Title>Valor Complet</ows:Title>
				<ows:Abstract>Indica que el valor buscat ha de coincidir amb tot el valor del registre del camp.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>INSENSIBLE_MAJ</ows:Identifier>
				<ows:Title>Insensible Majuscules</ows:Title>
