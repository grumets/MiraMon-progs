	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestBD:param1:6</ows:Identifier>
		<ows:Title>OMPLE_CAMP_DBF (6)</ows:Title>
		<ows:Abstract>Omple les cel·les (indexades des d'1) d'un camp amb un valor constant o amb una seqüència de valors en autoincrement.</ows:Abstract>
