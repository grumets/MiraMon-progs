	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestBD:param1:9</ows:Identifier>
		<ows:Title>FUSIONA_TAULES_DBF (9)</ows:Title>
		<ows:Abstract>Fusiona n taules d'idèntica estructura en una sola taula receptora afegint els registres de les altres taules al final de la taula receptora. La taula receptora pot ser preexistent o no ser-ho.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Fusió de n taules d'idèntica estructura en una sola taula receptora.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
