					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RegIni</ows:Identifier>
				<ows:Title>Registre Inicial</ows:Title>
				<ows:Abstract>Índex de registre començant des de 1 on començar a treballar o '*' per començar al final de la taula.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:RegIni"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
