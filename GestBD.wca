	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestBD:param1:13</ows:Identifier>
		<ows:Title>MOSTRA_VALOR_CAMP_DBF (13)</ows:Title>
		<ows:Abstract>Mostra el contingut d'un camp per a un determinat rang de registres, indexats des de 1.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
