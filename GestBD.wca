				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>9</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="100">
				<ows:Identifier>FitxerDBFDonador</ows:Identifier>
				<ows:Title>Fitxer DBF Donador</ows:Title>
				<ows:Abstract>Fitxer DBF donador en format DBF clàssic (dBASE III, dBASE III+ o dBASE IV) o una DBF estesa del MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerDBFDonador"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDBFReceptor</ows:Identifier>
				<ows:Title>Fitxer DBF Receptor</ows:Title>
				<ows:Abstract>Fitxer DBF receptor (resultat) en format DBF clàssic (dBASE III, dBASE III+ o dBASE IV) o una DBF estesa del MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerDBFReceptor"/>
				<ComplexOutput>
