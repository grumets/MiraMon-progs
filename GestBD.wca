							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomCamp</ows:Identifier>
				<ows:Title>Nom Camp</ows:Title>
				<ows:Abstract>Nom del camp de la taula DBF.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NomCamp"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ValorBuscat</ows:Identifier>
				<ows:Title>Valor Buscat</ows:Title>
				<ows:Abstract>Valor numèric o alfanumèric a buscar en un camp d'un DBF.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ValorBuscat"/>
