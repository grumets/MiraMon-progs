		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerTesaurusDBF</ows:Identifier>
				<ows:Title>Fitxer Tesaurus DBF</ows:Title>
				<ows:Abstract>Fitxer tesaurus resultat de fer la projecció del camp del fitxer DBF indicat. Fitxer en format DBF clàssic (dBASE III, dBASE III+ o dBASE IV) o en DBF estesa del MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerTesaurusDBF"/>
				<ComplexOutput>
					<Default>
