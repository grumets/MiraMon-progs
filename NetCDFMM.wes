<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:NDFIMG:1</ows:Identifier>
		<ows:Title>Importación del formato NetCDF</ows:Title>
		<ows:Abstract>Esta aplicación permite la importación de ciertos formatos NetCDF al formato vectorial estructurado de puntos de MiraMon, PNT, que será 3D de forma general. Durante la importación es posible también efectuar el cambio de proyección y/o sistema de referencia (dátum, etc).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importación del formato vectorial NetCDF"/>
		<ows:Metadata xlink:title="Abstract:Esta aplicación permite la importación de ciertos formatos NetCDF al formato vectorial estructurado de puntos de MiraMon, PNT, que será 3D de forma general. Durante la importación es posible también efectuar el cambio de proyección y/o sistema de referencia (dátum, etc)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract><![CDATA[<li>1 si se desea que no se reproyecten los puntos, es decir, que se mantengan en el sistema de referencia del fichero CDF.</li><li>2 si se desea que se reproyecte a cualquiera de los sistemas de referencia soportados por MiraMon. Hay que identificar correctamente el dátum del sistema de referencia origen.</li>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerCDF</ows:Identifier>
				<ows:Title>Fichero CDF</ows:Title>
				<ows:Abstract>Fichero_CDF es el fichero CDF a importar (con extensión).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroCDF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-netcdf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-netcdf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NDecimals</ows:Identifier>
				<ows:Title>Número de decimales</ows:Title>
				<ows:Abstract>Es el número de dígitos decimales con que se escribirán los campos numéricos de números reales en la base de datos.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NDecimales"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_ORI</ows:Identifier>
				<ows:Title>Sistema de referencia</ows:Title>
				<ows:Abstract>Indica el identificador del sistema de referencia del fichero NetCDF. Su valor por defecto es lat/long-ED50.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Sistema de referencia</ows:Title>
				<ows:Abstract>Indica el identificador del sistema de referencia del fichero destino. Su valor por defecto se encuentra en la clave RefSystem= de la sección [Metrica] del fichero de configuración MiraMon.par</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDesti</ows:Identifier>
				<ows:Title>Fichero destino</ows:Title>
				<ows:Abstract>Es el fichero PNT resultado.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroDestino"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>