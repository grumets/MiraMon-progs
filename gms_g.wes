<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:gms_g:Param1:1</ows:Identifier>
		<ows:Title>Origen en grados decimales y resultado en grados sexagesimales</ows:Title>
		<ows:Abstract>Origen en grados decimales y resultado en grados sexagesimales.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversiones entre unidades angulares y horarias"/>
		<ows:Metadata xlink:title="Abstract:Esta aplicación permite hacer conversiones entre magnitudes angulares:&lt;ul&gt;&lt;li&gt;de grados sexagesimales (grados, minutos y segundos, por ej.: 15° 30&apos; 36.72&quot;) a grados decimales  (grados y fracciones decimales de grado, por ej.: 15.51020000°) y viceversa&lt;/li&gt;&lt;li&gt;de grados sexagesimales o grados decimales  a radianes (por ej.: 0.2707040576 rad) y viceversa&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;así como entre magnitudes horarias:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;de horas y fracciones decimales de horas a horas, minutos y segundos y viceversa (útil para convertir, por ejemplo, horas de paso de satélites).&lt;/li&gt;&lt;/ul&gt;"/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusConversio</ows:Identifier>
				<ows:Title>Tipo de conversión</ows:Title>
				<ows:Abstract>Origen en grados decimales y resultado en grados sexagesimales</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:TipoConversion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>AngleAConvertir</ows:Identifier>
				<ows:Title>Ángulo a convertir</ows:Title>
				<ows:Abstract>Es el valor del ángulo a convertir en las unidades especificadas según la opción TipoConversion</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:AnguloAConvertir"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>AngleAConvertir</ows:Identifier>
				<ows:Title>Ángulo a convertir</ows:Title>
				<ows:Abstract>Es el valor del ángulo a convertir en las unidades especificadas según la opción TipoConversion</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:AnguloAConvertir"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
