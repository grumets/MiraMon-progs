<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GMS_G:1</ows:Identifier>
		<ows:Title>GMS_G</ows:Title>
		<ows:Abstract>Esta aplicación permite hacer conversiones de magnitudes angulares entre grados, grados, minutos y segundos, y radianes.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversiones entre unidades angulares"/>
		<ows:Metadata xlink:title="Abstract:Esta aplicación permite hacer conversiones de magnitudes angulares entre grados, grados, minutos y segundos, y radianes."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusConversio</ows:Identifier>
				<ows:Title>Tipo Conversion</ows:Title>
				<ows:Abstract><![CDATA[indica el formato de las cantidades de entrada y salida. Puede adoptar los siguientes posibles valores:<li>1 : Origen en grados y resultado en grados, minutos y segundos</li><li>2 : Origen en grados, minutos y segundos, y resultado en grados.</li><li>3 : Origen en grados y resultado en radianes.</li><li>4 : Origen en radianes y resultado en grados.</li><li>5 : Origen en radianes y resultado en grados, minutos y segundos</li>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:TipoConversion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>AngleAConvertir</ows:Identifier>
				<ows:Title>Angulo a convertir</ows:Title>
				<ows:Abstract>Es el valor del ángulo a convertir en las unidades especificadas según la opción TipoConversion</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:AnguloAConvertir"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>AngleAConvertir</ows:Identifier>
				<ows:Title>Angulo a convertir</ows:Title>
				<ows:Abstract>Es el valor del ángulo a convertir en las unidades especificadas según la opción TipoConversion</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:AnguloAConvertir"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>