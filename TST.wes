<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TST:param1:0</ows:Identifier>
		<ows:Title>Vapor de agua</ows:Title>
		<ows:Abstract>Esta opción sirve para calcular la temperatura de la superficie terrestre a partir de datos de vapor de agua.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Cálculo de la temperatura de la superficie terrestre"/>
		<ows:Metadata xlink:title="Abstract:Esta aplicación sirve para calcular la temperatura de la superficie terrestre a partir de datos de emisividad, vapor de agua y una banda térmica. También se pueden añadir datos de temperatura del aire."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Cálculo de la TST a partir de datos de vapor de agua.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Termic</ows:Identifier>
				<ows:Title>Térmico</ows:Title>
				<ows:Abstract>Fichero de entrada de la banda térmica.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Térmico"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Emissivitat</ows:Identifier>
				<ows:Title>Emisividad</ows:Title>
				<ows:Abstract>Fichero de entrada de los datos de emisividad.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Emisividad"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>VaporAigua</ows:Identifier>
				<ows:Title>Vapor de agua</ows:Title>
				<ows:Abstract>Fichero de entrada de los datos de vapor de agua.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:VaporAgua"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BD_Atmos</ows:Identifier>
				<ows:Title>BD_Atmos</ows:Title>
				<ows:Abstract>Base de datos atmosféricos. Los valores disponibles son: "TIGR-1", "TIGR-2", "TIGR-3" o "STD".</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:BD_Atmos"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string "> string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>TIGR-1</ows:Value>
						<ows:Value>TIGR-2</ows:Value>
						<ows:Value>TIGR-3</ows:Value>
						<ows:Value>STD</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Sensor</ows:Identifier>
				<ows:Title>Sensor</ows:Title>
				<ows:Abstract>Sensor de la banda térmica. Los valores posibles son:<![CDATA[<ul><li>
    0 (obtener sensor de los metadatos)</li><li>
    4 (para Landsat-4 MSS)</li><li>
    5 (para Landsat-5 TM)</li><li>
    7 (para Landsat-7 ETM+).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:Sensor"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>7</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>TST</ows:Identifier>
				<ows:Title>Temperatura Superficie Terrestre</ows:Title>
				<ows:Abstract>Fichero del resultado del cálculo de la temperatura de la superficie terrestre.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:TST"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TST:param1:1</ows:Identifier>
		<ows:Title>Vapor de agua y temperatura Aire</ows:Title>
		<ows:Abstract>Esta opción sirve para calcular la temperatura de la superficie terrestre a partir de datos vapor de agua y de temperatura del aire.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Cálculo de la TST a partir de datos de vapor de agua y de temperatura del aire.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
