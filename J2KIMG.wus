<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:j2kimg:Param1:0</ows:Identifier>
		<ows:Title>Metadata</ows:Title>
		<ows:Abstract>Shows the metadata of the JPEG2000 file.</ows:Abstract>
<ows:Metadata xlink:title="Title:Conversion between JPEG2000 and IMG or JPEG raster formats"/>
<ows:Metadata xlink:title="Abstract:This module allows you to obtain the information of the internal metadata of the JPEG2000 format, to import a JPEG2000 to a JPEG format (grey or RGB, depending on the JPEG2000 file) or to extract between one and three IMG bands of a JPEG2000."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Option</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>0. Metatdata</ows:Abstract>
			<ows:Metadata xlink:title="Param1" />
		<LiteralData>
			<ows:AllowedValues><ows:Value>0</ows:Value></ows:AllowedValues>
		</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>JPEG2000FileName</ows:Identifier>
				<ows:Title>JPEG2000 File Name</ows:Title>
				<ows:Abstract>Is the name of the JPEG2000 file to transform.
</ows:Abstract>
			<ows:Metadata xlink:title="Param2" />
		<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-JPEG2000</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
					<MimeType>application/x-JPEG2000</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>				
		</DataInputs>
		<ProcessOutputs>	
	      	<Output>
				<ows:Identifier>Stdout</ows:Identifier>
				<ows:Title>Output standard</ows:Title>
				<ows:Abstract>Metadata from the JPEG2000 File.
				</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
						<MimeType>application/x-display</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Default>
					<Supported>
						<Format>
						<MimeType>application/x-display</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:j2kimg:Param1:1</ows:Identifier>
		<ows:Title>JPEG</ows:Title>
		<ows:Abstract> This generates 1 JPEG file from a JPEG2000 image
</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Option</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>1. Generates JPEG </ows:Abstract>
			<ows:Metadata xlink:title="Param1" />
		<LiteralData>
			<ows:AllowedValues><ows:Value>1</ows:Value></ows:AllowedValues>
		</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>JPEG2000FileName</ows:Identifier>
				<ows:Title>JPEG2000 File Name</ows:Title>
				<ows:Abstract>Is the name of the JPEG2000 file to transform.
</ows:Abstract>
			<ows:Metadata xlink:title="Param2" />
		<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-JPEG2000</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
					<MimeType>application/x-JPEG2000</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>				
		</DataInputs>
		<ProcessOutputs>	
	      	<Output>
				<ows:Identifier>PEGFileName </ows:Identifier>
				<ows:Title>JPEG File Name </ows:Title>
				<ows:Abstract>Is the name of the JPEG file resulted from the transformation.
				</ows:Abstract>
					<ows:Metadata xlink:title="Param3" />
				<ComplexOutput>
					<Default>
						<Format>
						<MimeType>application/x-JPEG</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Default>
					<Supported>
						<Format>
						<MimeType>application/x-JPEG</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
