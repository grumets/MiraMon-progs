<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:J2KIMG:Param1:0</ows:Identifier>
		<ows:Title>Metadata</ows:Title>
		<ows:Abstract>Shows the metadata of the JPEG2000 file.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversion between JPEG2000 and IMG or JPEG raster formats"/>
		<ows:Metadata xlink:title="Abstract:This application allows you to obtain the information of the internal metadata of the JPEG2000 format, to import a JPEG2000 to a JPEG format (grey or RGB, depending on the JPEG2000 file) or to extract between one and three IMG bands of a JPEG2000."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 0</ows:Title>
				<ows:Abstract>Shows the metadata of the JPEG2000 file.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerJPEG2000</ows:Identifier>
				<ows:Title>JPEG2000 File</ows:Title>
				<ows:Abstract>Is the name of the JPEG2000 file to transform (for options 1..4) or the result of the transformation (options 5..11).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:JPEG2000File"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GMLBOX</ows:Identifier>
				<ows:Title>GMLBOX</ows:Title>
				<ows:Abstract>Name of the GML file that for options 0..4 will store the GML information present in the JPEG2000 file, and for options 5..11 will contain the GML information to write into the JPEG2000 file.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>utf-8</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>utf-8</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MRSID</ows:Identifier>
				<ows:Title>MRSID</ows:Title>
				<ows:Abstract>If specified, the MrSID libraries are used (only for options 2..4); otherwise, the ER Mapper ones.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>StdOut</ows:Identifier>
				<ows:Title>Output standard</ows:Title>
				<ows:Abstract>Metadata from the JPEG2000 File.</ows:Abstract>
				<ows:Metadata xlink:title="Hide:noHelp"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:J2KIMG:Param1:1</ows:Identifier>
		<ows:Title>JPEG</ows:Title>
		<ows:Abstract>This generates 1 JPEG file from a JPEG2000 image</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 1</ows:Title>
				<ows:Abstract>This generates 1 JPEG file from a JPEG2000 image</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerJPEG2000</ows:Identifier>
				<ows:Title>JPEG2000 File</ows:Title>
				<ows:Abstract>Is the name of the JPEG2000 file to transform (for options 1..4) or the result of the transformation (options 5..11).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:JPEG2000File"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALITAT</ows:Identifier>
				<ows:Title>Quality</ows:Title>
				<ows:Abstract>Quality of the compression in a range [0,100], where [5,95] is the useful range although in many cases a value will be between 70 and 75 (75 automatically). The low values indicate very few quality but great compression.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>100</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GMLBOX</ows:Identifier>
				<ows:Title>GMLBOX</ows:Title>
				<ows:Abstract>Name of the GML file that for options 0..4 will store the GML information present in the JPEG2000 file, and for options 5..11 will contain the GML information to write into the JPEG2000 file.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>utf-8</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>utf-8</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FWORLD</ows:Identifier>
				<ows:Title>World File</ows:Title>
				<ows:Abstract>It generates a world file of the stated extension. It is possible to indicate /FWORLD to generate it using the extension automatically. For JP2 files the extension is always J2W.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MRSID</ows:Identifier>
				<ows:Title>MRSID</ows:Title>
				<ows:Abstract>If specified, the MrSID libraries are used (only for options 2..4); otherwise, the ER Mapper ones.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>JPEG File</ows:Title>
				<ows:Abstract>Is the name of the JPEG file resulting from the transformation (option 1) or to transform (option 5).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:JPEGFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:J2KIMG:Param1:2</ows:Identifier>
		<ows:Title>IMG</ows:Title>
		<ows:Abstract>This generates 1 IMG file from a grey JPEG2000 file</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 2</ows:Title>
				<ows:Abstract>This generates one IMG file from a grey JPEG2000 file</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerJPEG2000</ows:Identifier>
				<ows:Title>JPEG2000 File</ows:Title>
				<ows:Abstract>Is the name of the JPEG2000 file to transform (for options 1..4) or the result of the transformation (options 5..11).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:JPEG2000File"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GMLBOX</ows:Identifier>
				<ows:Title>GMLBOX</ows:Title>
				<ows:Abstract>Name of the GML file that for options 0..4 will store the GML information present in the JPEG2000 file, and for options 5..11 will contain the GML information to write into the JPEG2000 file.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>utf-8</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>utf-8</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MRSID</ows:Identifier>
				<ows:Title>MRSID</ows:Title>
				<ows:Abstract>If specified, the MrSID libraries are used (only for options 2..4); otherwise, the ER Mapper ones.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>Nodata value</ows:Title>
				<ows:Abstract>Nodata value.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerIMG</ows:Identifier>
				<ows:Title>IMG File</ows:Title>
				<ows:Abstract>Is the name of the IMG file resulting from the transformation of a single-channel JPEG2000 (grey, option 2) or to transform (option 6).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:IMGFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:J2KIMG:Param1:3</ows:Identifier>
		<ows:Title>IMG MULTI</ows:Title>
		<ows:Abstract>This generates 3 IMG files from a 24 bit JPEG2000 file.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 3</ows:Title>
				<ows:Abstract>This generates three IMG files from a 24 bit JPEG2000 file.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerJPEG2000</ows:Identifier>
				<ows:Title>JPEG2000 File</ows:Title>
				<ows:Abstract>Is the name of the JPEG2000 file to transform (for options 1..4) or the result of the transformation (options 5..11).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:JPEG2000File"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GMLBOX</ows:Identifier>
				<ows:Title>GMLBOX</ows:Title>
				<ows:Abstract>Name of the GML file that for options 0..4 will store the GML information present in the JPEG2000 file, and for options 5..11 will contain the GML information to write into the JPEG2000 file.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>utf-8</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>utf-8</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MRSID</ows:Identifier>
				<ows:Title>MRSID</ows:Title>
				<ows:Abstract>If specified, the MrSID libraries are used (only for options 2..4); otherwise, the ER Mapper ones.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>Nodata value</ows:Title>
				<ows:Abstract>Nodata value.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerIMG_R</ows:Identifier>
				<ows:Title>Red IMG File</ows:Title>
				<ows:Abstract>Is the name of the IMG file resulting from the transformation of each band of the RGB triplet (option 3) or to transform (option 7).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:IMG_R_File"/>
				<ComplexOutput>
					<Default>
						<Format>
