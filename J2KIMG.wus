							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>PatroFitxers</ows:Identifier>
				<ows:Title>Pattern File</ows:Title>
				<ows:Abstract>It is the name pattern of the IMG files resulting from the transformation of a multiband JPEG2000 file.</ows:Abstract>
				<ows:Metadata xlink:title="Name:PatternFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-JPEG2000</MimeType>
