		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerJPEG2000</ows:Identifier>
				<ows:Title>JPEG2000 File</ows:Title>
				<ows:Abstract>Is the name of the JPEG2000 file to transform (for options 1..4) or the result of the transformation (options 5..11).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:JPEG2000File"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:J2KIMG:Param1:10</ows:Identifier>
		<ows:Title>SID</ows:Title>
		<ows:Abstract>JPEG2000 file from a SID file.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 10</ows:Title>
				<ows:Abstract>Generates a JPEG2000 file from a SID file.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>10</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>10</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerSID</ows:Identifier>
				<ows:Title>SID File</ows:Title>
				<ows:Abstract>The SID file name to transform to JPEG2000 file.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:SIDFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/sid</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/sid</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALITAT_J2K</ows:Identifier>
				<ows:Title>JPEG2000 quality</ows:Title>
				<ows:Abstract>Compression quality of a JPG2000 file, in a supraunitary range (value 1 means lossless compression). Default is 20. High values mean less quality but more compression.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GMLBOX</ows:Identifier>
				<ows:Title>GMLBOX</ows:Title>
				<ows:Abstract>Name of the GML file that for options 0..4 will store the GML information present in the JPEG2000 file, and for options 5..11 will contain the GML information to write into the JPEG2000 file.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>utf-8</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>utf-8</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FWORLD</ows:Identifier>
				<ows:Title>World File</ows:Title>
				<ows:Abstract>It generates a world file of the stated extension. It is possible to indicate /FWORLD to generate it using the extension automatically. For JP2 files the extension is always J2W.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerJPEG2000</ows:Identifier>
				<ows:Title>JPEG2000 File</ows:Title>
				<ows:Abstract>Is the name of the JPEG2000 file to transform (for options 1..4) or the result of the transformation (options 5..11).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:JPEG2000File"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
