<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:OrdreRas:1</ows:Identifier>
		<ows:Title>Ordenació dels valors d'un ràster.</ows:Title>
		<ows:Abstract>Aquest mòdul genera un ràster d'índexs segons l'ordre (ascendent o descendent) que correspon als valors del ràster origen a ordenar.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Ordenació dels valors d&apos;un ràster"/>
		<ows:Metadata xlink:title="Abstract:Aquest mòdul genera un ràster d&apos;índexs segons l&apos;ordre (ascendent o descendent) que correspon als valors del ràster origen a ordenar."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Ordre</ows:Identifier>
				<ows:Title>Ordre</ows:Title>
				<ows:Abstract><![CDATA[<li><ul>A per ordenar ascendentment.</li><li>    D per ordenar descendentment.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Ordre"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>A</ows:Value>
						<ows:Value>D</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>A</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerRAS</ows:Identifier>
				<ows:Title>Fitxer ràster</ows:Title>
				<ows:Abstract>Fitxer origen ràster IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerRAS"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>LIM_INF</ows:Identifier>
				<ows:Title>Límit Inferior</ows:Title>
				<ows:Abstract>Valor límit de les cel·les fins on es vol ordenar. S'ha d'afegir "/LIM_INF=" abans del valor límit si es vol ordenar els valors superiors o iguals al valor límit.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>LIM_SUP</ows:Identifier>
				<ows:Title>Límit Superior</ows:Title>
				<ows:Abstract>Valor límit de les cel·les fins on es vol ordenar. S'ha d'afegir "/LIM_SUP=" si es vol ordenar els valors inferiors o iguals al valor límit.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>LIM_PIX</ows:Identifier>
				<ows:Title>Nombre de píxels</ows:Title>
				<ows:Abstract>Nombre màxim de nivells que es desitja obtenir.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESEMPAT_POSICIO</ows:Identifier>
				<ows:Title>Desempat en posició</ows:Title>
				<ows:Abstract>Si no es volen valors empatats, es pot indicar /DESEMPAT_POSICIO i es donarà prioritat a la cel·la en posició més baixa pel cas ascendent i en posició més alta pel descendent. Si les cel·les són a la mateixa fila, es donarà prioritat a la cel·la de més a l'esquerra pel cas ascendent i a la de més a la dreta pel descendent. Aquesta opció proporciona resultats com el mòdul Rank del programari Idrisi.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerOrdenat</ows:Identifier>
				<ows:Title>Fitxer ordenat</ows:Title>
				<ows:Abstract>Fitxer de sortida que contindrà els valors de les cel·les ordenats segons els valors originals.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerOrdenat"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>