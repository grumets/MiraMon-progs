<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
		<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:HDFIMG:param1</ows:Identifier>
		<ows:Title>HDFIMG</ows:Title>
		<ows:Abstract>This program allows to import HDF4 files to MiraMon raster format.
</ows:Abstract>
<ows:Metadata xlink:title="Title:Program to import HDF4 files to IMG format"/>
<ows:Metadata xlink:title="Abstract:This program allows to import HDF4 files to MiraMon raster format."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Option</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>1: Información HDF</li><li>
    2: Importación HDF</li></ul>]]></ows:Abstract>
			<ows:Metadata xlink:title="Param1" />
			<LiteralData>
				<ows:AllowedValues>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
				<ows:Value>0</ows:Value>
				</ows:AllowedValues>
			</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FileHDF</ows:Identifier>
				<ows:Title>File HDF</ows:Title>
				<ows:Abstract>HDF file to inform or to import (with extension).
</ows:Abstract>
			<ows:Metadata xlink:title="Param2" />
			<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-HDF</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
					<MimeType>application/x-HDF</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>		
		</DataInputs>
		<ProcessOutputs>	
			<Output>
				<ows:Identifier>OutputFolder</ows:Identifier>
				<ows:Title>Output Folder</ows:Title>
				<ows:Abstract>Folder is typically pre-existing, which generate the new output folder with the files on the import (REL + IMG multiband) for option 2 or the request for information (TXT) for Option 1. This new folder naming scheme is detailed in the application support by product.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
				<LiteralOutput>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyUri">anyUri</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
