<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GrADSIMG:param1</ows:Identifier>
		<ows:Title>GrADSIMG</ows:Title>
		<ows:Abstract>This application allows to import raster files in format used by the software GrADS. GrADS is the acronym for Grid Analysis and Display System, an environment frequently used in meteorology.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Import GrADS rasters"/>
		<ows:Metadata xlink:title="Abstract:This application allows to import raster files in format used by the software GrADS. GrADS is the acronym for Grid Analysis and Display System, an environment frequently used in meteorology."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>1 If the user does not want to reproject the original raster, or that the original reference system of the GrADS file is kept.</li><li>2 If the user wants to reproject to one of the other reference systems supported by MiraMon. It is necessary to correctly identify the datum of the original reference system..</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigen</ows:Identifier>
				<ows:Title>Input File</ows:Title>
				<ows:Abstract>Is the file to be imported (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_ORI</ows:Identifier>
				<ows:Title>Reference System</ows:Title>
				<ows:Abstract>Indicates the identifier of the reference system of the GrADS file. The defect value is lat/long-ED50.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Output reference system</ows:Title>
				<ows:Abstract>Indicates the identifier of the reference system for the output files. The default value corresponds to the RefSystem= key in the [Metrica] section of the MiraMon.par configuration file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>DirectoriDesti</ows:Identifier>
				<ows:Title>Output Directory</ows:Title>
				<ows:Abstract>Is the folder where all the IMG bands created as a result of the program will be stored.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>