<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:RegLog:1</ows:Identifier>
		<ows:Title>MiraMon:RegLog:1</ows:Title>
		<ows:Abstract><![CDATA[Aquesta aplicació permet generar un model explicatiu i predictiu d'una variable espacial dicotòmica <i>Y</i> en funció de n variables espacials independents <i>X</i><sub>n</sub> quantitatives.]]></ows:Abstract>
		<ows:Metadata xlink:title="Title:Regressió logística"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació permet generar un model explicatiu i predictiu d&apos;una variable espacial dicotòmica &lt;i&gt;Y&lt;/i&gt; en funció de n variables espacials independents &lt;i&gt;X&lt;/i&gt;&lt;sub&gt;n&lt;/sub&gt; quantitatives."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Ajust</ows:Identifier>
				<ows:Title>Opció ajust</ows:Title>
				<ows:Abstract>Actualment exclusivament pot valer 2.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Ajust"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxMostra</ows:Identifier>
				<ows:Title>Fitxer d'entrada de la mostra</ows:Title>
				<ows:Abstract>Fitxer d'entrada corresponent a les dades de la mostra.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxMostra"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-msaccess</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampModel</ows:Identifier>
				<ows:Title>Camp a modelitzar (variable dependent)</ows:Title>
				<ows:Abstract>Camp a modelitzar (variable dependent)</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:CampModel"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Criteri</ows:Identifier>
				<ows:Title>Criteri estadístic</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>0: Totes les variables són independents</li><li>1: Criteri <i>Deviance</i></li><li>2: Criteri R<sup>2</sup> <i>Naglekerke</i></li><li>3: Criteri AIC</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Criteri"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Multiregistre</ows:Identifier>
				<ows:Title>Multiregistre</ows:Title>
				<ows:Abstract><![CDATA[Com tractar les dades d'entrada amb multiregistre, és a dir, què fer quan es té més d'un registre per cada punt: <ul><li>0: Negligir el punt.</li><li>1: Triar el primer.</li><li>2: Calcular la mitjana dels valors.</li><li>3: Calcular el sumatori dels valors.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Multiregistre"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="100">
				<ows:Identifier>FitxVarIndep</ows:Identifier>
				<ows:Title>Fitxers de les variables independents</ows:Title>
				<ows:Abstract>Fitxers de les variables independents</ows:Abstract>
				<ows:Metadata xlink:title="Param8"/>
				<ows:Metadata xlink:title="Name:FitxVarIndep"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MOSTRA_VALORS_CRITERIS</ows:Identifier>
				<ows:Title>Mostra valors i criteris</ows:Title>
				<ows:Abstract>Mostra en pantalla informació de cada regressió.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMPY</ows:Identifier>
				<ows:Title>Camp seleccionat de les coordenades Y</ows:Title>
				<ows:Abstract>En cas de demanar la creació d'un fitxer de punts a partir de la base de dades de la mostra, és el camp seleccionat de les coordenades Y.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MASCARA</ows:Identifier>
				<ows:Title>Fitxer màscara</ows:Title>
				<ows:Abstract>Fitxer màscara</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_MASC</ows:Identifier>
				<ows:Title>Camp de la base de dades triada</ows:Title>
				<ows:Abstract><![CDATA[Quan la màscara és un fitxer estructurat, indica el camp de la base de dades triada. Per a saber més sobre els valors d'aquest paràmetre es pot consultar les consideracions del document de <a href="general.htm#TaulaCamp">sintaxi general</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TAULA_MASC</ows:Identifier>
				<ows:Title>Taula de la base de dades triada</ows:Title>
				<ows:Abstract><![CDATA[Quan la màscara és un fitxer estructurat, indica la taula de la base de dades triada. Per a saber més sobre els valors d'aquest paràmetre es pot consultar les consideracions del document de <a href="general.htm#TaulaCamp">sintaxi general</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPER_MASC</ows:Identifier>
				<ows:Title>Operador de la projecció del camp</ows:Title>
				<ows:Abstract>Operador de la projecció del camp. Exclusivament en el cas que el fitxer màscara sigui un fitxer de polígons no estructurat.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CONSIDER_NODATA</ows:Identifier>
				<ows:Title>Valor sensedades en màscara</ows:Title>
				<ows:Abstract>En el cas d'un fitxer màscara, considerar el valor sensedades.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMPX</ows:Identifier>
				<ows:Title>Camp de les coordenades X</ows:Title>
				<ows:Abstract>En cas de demanar la creació d'un fitxer de punts a partir de la base de dades de la mostra, és el camp seleccionat de les coordenades X.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REFSYSTEM</ows:Identifier>
				<ows:Title>Sistema de referencia horitzontal del fitxer PNT de la base de dades</ows:Title>
				<ows:Abstract>En cas que es demani crear un fitxer PNT a partir de la base de dades de la mostra, és el sistema de referència horitzontal seleccionat per  aquest fitxer.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input>
				<ows:Identifier>ATR_MASC</ows:Identifier>
				<ows:Title>Valor seleccionat del fitxer màscara</ows:Title>
				<ows:Abstract>Valor seleccionat del fitxer màscara.  Exclusivament en el cas que el fitxer màscara sigui un fitxer de polígons no estructurat.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>MDTSortida</ows:Identifier>
				<ows:Title>Fitxer MDT de sortida</ows:Title>
				<ows:Abstract>Fitxer MDT de sortida</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:MDTSortida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>TXTSortida</ows:Identifier>
				<ows:Title>Fitxer TXT de sortida</ows:Title>
				<ows:Abstract>Fitxer TXT de sortida</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:TXTSortida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-ini</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-ini</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>PNTdeBD</ows:Identifier>
				<ows:Title>Fitxer PNT a partir d'una base de dades</ows:Title>
				<ows:Abstract>En cas que les dades de la mostra sigui el resultat d'una consulta a una base de dades, es pot demanar la creació d'un fitxer de PNT si també hi ha els identificadors /CAMPX i /CAMPY.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>