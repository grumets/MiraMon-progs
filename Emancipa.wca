<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Emancipa:1</ows:Identifier>
		<ows:Title>Emancipa polígons dels arcs</ows:Title>
		<ows:Abstract>Emancipa els polígons dels arcs.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Extracció de la base d&apos;arcs mínima per a un fitxer de polígons"/>
		<ows:Metadata xlink:title="Abstract:Aquest programa està pensat per treballar sobre fitxers de polígons que només fan servir alguns arcs de la base de dades. Un reciclat selectiu (CICLAR 3) o una selecció de polígons feta des de MiraMon (VECSELEC) generen aquest tipus de fitxers."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>PolOri</ows:Identifier>
				<ows:Title>Fitxer origen de tipus polígon </ows:Title>
				<ows:Abstract>Nom del fitxer de polígons a emancipar i el resultat de l'emancipació si no es desitja duplicat.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FitxerPolOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>PolDest</ows:Identifier>
				<ows:Title>Fitxer destí de tipus polígon </ows:Title>
				<ows:Abstract>Nom del fitxer de polígons emancipat quan es desitja un duplicat.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerPolDesti"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>ARC_SOURCE</ows:Identifier>
				<ows:Title>Fitxer d'arcs emancipat</ows:Title>
				<ows:Abstract>Nom del fitxer d'arcs emancipat. Si no s'indica, se suposa igual al FitxerPolDestí.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>