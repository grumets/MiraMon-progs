<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ECWIMG:param1:0</ows:Identifier>
		<ows:Title>ECWIMG 0</ows:Title>
		<ows:Abstract>Muestra los metadatos internos guardados en el fichero ECW.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importación del formato ráster ECW a IMG o JPEG"/>
		<ows:Metadata xlink:title="Abstract:Los ficheros ECW (Enhanced Compressed Wavelet) son rásters altamente comprimidos gracias a el uso de las transformadas wavelet."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Muestra los metadatos internos guardados en el fichero ECW.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerECW</ows:Identifier>
				<ows:Title>Nombre Fichero ECW</ows:Title>
				<ows:Abstract>Es el nombre del fichero ECW.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NombreFicheroECW"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/ecw</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/ecw</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>stdout</ows:Identifier>
				<ows:Title>Estandar de salida</ows:Title>
				<ows:Abstract>Información sobre el fichero ECW.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ECWIMG:param1:1</ows:Identifier>
		<ows:Title>ECWIMG 1</ows:Title>
		<ows:Abstract>Genera un fichero JPEG a partir de una imagen ECW.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Genera 1 fichero JPEG a partir de una imagen ECW.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerECW</ows:Identifier>
				<ows:Title>Nombre Fichero ECW</ows:Title>
				<ows:Abstract>Es el nombre del fichero ECW.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NombreFicheroECW"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/ecw</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/ecw</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALITAT</ows:Identifier>
				<ows:Title>Calidad de compresión</ows:Title>
				<ows:Abstract>Calidad de compresión en un rango [0,100], donde [5,95] es el rango útil aunque en muchos casos es recomendable introducir un valor entre 70 y 75 (por defecto es 75). Los valores bajos indican muy poca calidad pero mucha compresión.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>1</ows:MinimumValue>
							<ows:MaximumValue>100</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
					<DefaultValue>75</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFitxerJPEG</ows:Identifier>
				<ows:Title>Nombre Fichero JPEG</ows:Title>
				<ows:Abstract>Es el nombre del fichero JPEG resultado de la transformación.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NombreFicheroJPEG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ECWIMG:param1:2</ows:Identifier>
		<ows:Title>ECWIMG 2</ows:Title>
		<ows:Abstract>Genera 1 fichero IMG a partir de un fichero ECW de grises.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Genera 1 fichero IMG a partir de un fichero ECW de grises.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerECW</ows:Identifier>
				<ows:Title>Nombre Fichero ECW</ows:Title>
				<ows:Abstract>Es el nombre del fichero ECW.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NombreFicheroECW"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/ecw</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/ecw</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFitxerIMG</ows:Identifier>
				<ows:Title>Nombre Fichero IMG</ows:Title>
				<ows:Abstract>Es el nombre del fichero IMG resultado de la transformación a ECW de una sola banda espectral (grises)</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NombreFicheroIMG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ECWIMG:param1:3</ows:Identifier>
		<ows:Title>ECWIMG 3</ows:Title>
		<ows:Abstract>Genera 3 ficheros IMG a partir de un fichero ECW de 24 bits.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Genera 3 ficheros IMG a partir de un fichero ECW de 24 bits</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerECW</ows:Identifier>
				<ows:Title>Nombre Fichero ECW</ows:Title>
				<ows:Abstract>Es el nombre del fichero ECW.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NombreFicheroECW"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/ecw</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/ecw</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFitxerIMG_R</ows:Identifier>
				<ows:Title>Nombre Fichero IMG rojo</ows:Title>
				<ows:Abstract>Es el nombre del fichero IMG rojo resultado de la transformación de cada banda del triplete RGB.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NombreFicheroIMG_R"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>NomFitxerIMG_G</ows:Identifier>
				<ows:Title>Nombre Fichero IMG verde</ows:Title>
				<ows:Abstract>Es el nombre del fichero IMG verde resultado de la transformación de cada banda del triplete RGB.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NombreFicheroIMG_G"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>NomFitxerIMG_B</ows:Identifier>
				<ows:Title>Nombre Fichero IMG R</ows:Title>
				<ows:Abstract>Es el nombre del fichero IMG azul resultado de la transformación de cada banda del triplete RGB.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:NombreFicheroIMG_B"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>