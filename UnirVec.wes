<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:UNIRVEC:Param:3</ows:Identifier>
		<ows:Title>Fusiona Lista</ows:Title>
		<ows:Abstract>Esta opción une dos o mas ficheros vectoriales de MiraMon a partir de un fichero lista que contiene una llista de los ficheros a unir.</ows:Abstract>
<ows:Metadata xlink:title="Title:Programa de unión de ficheros vectoriales de Miramon."/>
<ows:Metadata xlink:title="Abstract:Este programa une dos o más ficheros vectoriales de MiraMon en un solo fichero sin tomar ninguna consideración topológica. Por eso los ficheros estructurados de destino son marcados como no topológicos. Eso hace que el proceso sea muy rápido. En cambio, el programa &quot;Mosaico&quot; realiza una estructuración topológica del fichero destino cosa que lo hace más robusto pero más lento, necesitando más memoria."/>
		<DataInputs>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcion</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract><![CDATA[<li>1. fusiona ficheros VEC y permite sobreescribir sobre el fichero destino.</li><li>2.  fusiona ficheros ARC, PNT o ARC ciclados.</li>]]>
</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
			<LiteralData>
				<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:Value>1</ows:Value>
					<ows:Value>2</ows:Value>
				</ows:AllowedValues>
			</LiteralData>				
		</Input>			
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>OrigenLista</ows:Identifier>
				<ows:Title>OrigenLista</ows:Title>
				<ows:Abstract>Es un fichero lista (habitualmente txt o lst) que contiene una lista de ficheros a unir.
</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
		<ComplexData>
				<Default>
					<Format>
								<MimeType>application/x-TXT</MimeType>
								<Encoding>Text</Encoding>
							</Format>
				</Default>
				<Supported>
					<Format>
								<MimeType>application/x-TXT</MimeType>
								<Encoding>Text</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-LST</MimeType>
								<Encoding>lst</Encoding>
							</Format>
				</Supported>
			</ComplexData>	
		</Input>
		</DataInputs>
		<ProcessOutputs>	
				<Output>
				<ows:Identifier>Destino</ows:Identifier>
				<ows:Title>Destino</ows:Title>
				<ows:Abstract>Es el fichero de salida de la unión de los ficheros a unir.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexOutput>
					<Default>
					<Format>
						<MimeType>application/x-ARC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Default>
					<Supported>
					<Format>
						<MimeType>application/x-PNT</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					<Format>
						<MimeType>application/x-VEC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>	
</ProcessDescription>
<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:UNIRVEC:!Param:3</ows:Identifier>
		<ows:Title>Fusiona ficheros ARC, PNT o ARC ciclados.</ows:Title>
		<ows:Abstract>Esta opción une dos o mas ficheros vectoriales de MiraMon a partir de una secuencia de nombres de ficheros en linea de comando.</ows:Abstract>
		<DataInputs>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcion</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>1. Fusiona ficheros VEC y permite sobreescribir sobre el fichero destino.</li><li>2. Fusiona ficheros ARC, PNT o ARC ciclados.</li></ul>]]>
</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
			<LiteralData>
				<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:Value>1</ows:Value>
					<ows:Value>2</ows:Value>
				</ows:AllowedValues>
			</LiteralData>				
		</Input>			
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Origen#</ows:Identifier>
				<ows:Title>Origen#</ows:Title>
				<ows:Abstract>Es una secuencia de nombres de ficheros. Esta opción es especialmente útil para unir 2 o 3 ficheros en linea de comando sin tener que generar una lista. La caja de diálogo de la aplicación no refleja esta opción.
</ows:Abstract>
				<ows:Metadata xlink:title="Param4" />
		<ComplexData>
				<Default>
					<Format>
								<MimeType>application/x-ARC</MimeType>
								<Encoding>Text</Encoding>
							</Format>
				</Default>
				<Supported>
					<Format>
								<MimeType>application/x-PNT</MimeType>
								<Encoding>Text</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>lst</Encoding>
							</Format>
				</Supported>
			</ComplexData>	
		</Input>
		</DataInputs>
		<ProcessOutputs>	
				<Output>
				<ows:Identifier>Destí</ows:Identifier>
				<ows:Title>Destí</ows:Title>
				<ows:Abstract>Es el fichero de salida de la unión de los ficheros a unir.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexOutput>
					<Default>
					<Format>
						<MimeType>application/x-ARC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Default>
					<Supported>
					<Format>
						<MimeType>application/x-PNT</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					<Format>
						<MimeType>application/x-VEC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>	
</ProcessDescription>
</wps:ProcessDescriptions>
