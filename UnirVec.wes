<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:UNIRVEC:!Param:4&amp;Param1:1</ows:Identifier>
		<ows:Title>Fusiona lista ficheros VEC</ows:Title>
		<ows:Abstract>Esta opción une dos o mas ficheros vectoriales de MiraMon a partir de un fichero lista que contiene una llista de los ficheros a unir.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Programa de unión de ficheros vectoriales de Miramon."/>
		<ows:Metadata xlink:title="Abstract:Este programa une dos o más ficheros vectoriales de MiraMon en un solo fichero sin tomar ninguna consideración topológica. Por eso los ficheros estructurados de destino son marcados como no topológicos. Eso hace que el proceso sea muy rápido. En cambio, el programa &quot;Mosaico&quot; realiza una estructuración topológica del fichero destino cosa que lo hace más robusto pero más lento, necesitando más memoria."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Fusiona una lista o una secuencia de ficheros VEC.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>OrigenLlista</ows:Identifier>
				<ows:Title>Origen lista</ows:Title>
				<ows:Abstract>Es un fichero lista (habitualmente txt o lst) que contiene una lista de ficheros a unir.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OrigenLista"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-TXT</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-TXT</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-LST</MimeType>
							<Encoding>lst</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Desti</ows:Identifier>
				<ows:Title>Destino</ows:Title>
				<ows:Abstract>Es el fichero de salida de la unión de los ficheros a unir.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDestino"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
