<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:veccor:Param1:1</ows:Identifier>
		<ows:Title>VECCOR 2D</ows:Title>
		<ows:Abstract>Aquesta opció fa la transformació de fitxers VEC de punts al format COR, sense incorporar les alçades.</ows:Abstract>
<ows:Metadata xlink:title="Title:Transformació de fitxers VEC de punts a fitxers COR usats per CorrGeom" />
<ows:Metadata xlink:title="Abstract:Aquest programa fa la transformació de fitxers VEC de punts a format de treball del programa CORRGEOM." />
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Mode</ows:Identifier>
				<ows:Title>Mode</ows:Title>
				<ows:Abstract>1. Pas de format VEC a format COR sense alçades.</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerVEC</ows:Identifier>
				<ows:Title>NomFitxerVEC</ows:Title>
				<ows:Abstract>Fitxer origen que conté els punts de control en format VEC.</ows:Abstract>
						<ows:Metadata xlink:title="Param2" />
					<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>	
			</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFitxerCOR</ows:Identifier>
				<ows:Title>NomFitxerCOR</ows:Title>
				<ows:Abstract>fItxer destí que conté els punts de control en format COR.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
						<ComplexOutput>
							<Default>
						<Format>
							<MimeType>application/x-COR</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-COR</MimeType>
							<Encoding>Text</Encoding>
						</Format>
							</Supported>
						</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:veccor:Param1:2</ows:Identifier>
		<ows:Title>VECCOR 3D</ows:Title>
		<ows:Abstract>Aquesta opció fa la transformació de fitxers VEC de punts al format COR incorporant les alçades que seran extretes del model digital d'elevacions (MDE).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Mode</ows:Identifier>
				<ows:Title>Mode</ows:Title>
				<ows:Abstract>2. Pas de format VEC a format COR amb alçades que seran extretes del model digital d'elevacions (MDE).</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerVEC</ows:Identifier>
				<ows:Title>NomFitxerVEC</ows:Title>
				<ows:Abstract>Fitxer origen que conté els punts de control en format VEC.</ows:Abstract>
						<ows:Metadata xlink:title="Param2" />
					<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerMDE</ows:Identifier>
				<ows:Title>Nom Fitxer MDE</ows:Title>
				<ows:Abstract>Fitxer IMG que conté el Model Digital d'Elevacions de la zona d'interès (només opció 2).</ows:Abstract>
						<ows:Metadata xlink:title="Param4" />
					<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>
	<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ModeInterpol</ows:Identifier>
				<ows:Title>Mode Interpol·lació</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>0: Veí més proper</li><li>1: Interpolació bilineal</li><li>2: Interpolació bicúbica</li></ul>]]> 
</ows:Abstract>
				<ows:Metadata xlink:title="Param5" />
				<LiteralData>
					<ows:AllowedValues>                                                                                            
					<ows:Value>0</ows:Value>
					<ows:Value>1</ows:Value>
					<ows:Value>2</ows:Value>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					</ows:AllowedValues>
				</LiteralData>
			</Input>				
	<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>UNITATSXY</ows:Identifier>
				<ows:Title>Unitats XY</ows:Title>
				<ows:Abstract>Unitats de l'atribut del fitxer VEC, que correspon a les coordenades en el sistema de referència horitzontal destí, típicament m (només opció 2). 
</ows:Abstract>
				<LiteralData>
					<ows:AllowedValues>
					<ows:Value>mm</ows:Value>
					<ows:Value>dm</ows:Value>
					<ows:Value>cm</ows:Value>
					<ows:Value>m</ows:Value>
					<ows:Value>km</ows:Value>
					<ows:Value>graus</ows:Value>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					</ows:AllowedValues>
				</LiteralData>
			</Input>				
			</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFitxerCOR</ows:Identifier>
				<ows:Title>NomFitxerCOR</ows:Title>
				<ows:Abstract>fItxer destí que conté els punts de control en format COR.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
						<ComplexOutput>
							<Default>
						<Format>
							<MimeType>application/x-COR</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-COR</MimeType>
							<Encoding>Text</Encoding>
						</Format>
							</Supported>
						</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
