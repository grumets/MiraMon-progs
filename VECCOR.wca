<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:VECCOR:Param1:1</ows:Identifier>
		<ows:Title>VECCOR 2D</ows:Title>
		<ows:Abstract>Aquesta opció fa la transformació de fitxers VEC de punts al format COR, sense incorporar les alçades.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Transformació de fitxers VEC de punts a fitxers COR usats per CorrGeom"/>
		<ows:Metadata xlink:title="Abstract:Aquest programa fa la transformació de fitxers VEC de punts a format de treball del programa CORRGEOM."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 1</ows:Title>
				<ows:Abstract>Pas de format VEC a format COR sense alçades.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerVEC</ows:Identifier>
				<ows:Title>NomFitxerVEC</ows:Title>
				<ows:Abstract>Fitxer origen que conté els punts de control en format VEC.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NomFitxerVEC"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SRH_COORD_VEC</ows:Identifier>
				<ows:Title>Sistema de referència origen</ows:Title>
				<ows:Abstract>Sistema de referència de les coordenades de l'atribut del fitxer VEC d'entrada. Si no s'indica, no es fa transformació i es suposa el mateix sistema de referència.</ows:Abstract>
				<ows:Metadata xlink:title="Name:SRH_COORD_VEC"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SRH_COORD_COR</ows:Identifier>
				<ows:Title>Sistema de referència destí</ows:Title>
				<ows:Abstract>Sistema de referència de destí dels punts del fitxer COR.</ows:Abstract>
				<ows:Metadata xlink:title="Name:SRH_COORD_COR"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFitxerCOR</ows:Identifier>
				<ows:Title>NomFitxerCOR</ows:Title>
				<ows:Abstract>Fitxer destí que conté els punts de control en format COR.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NomFitxerCOR"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-COR</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-COR</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:VECCOR:Param1:2</ows:Identifier>
		<ows:Title>VECCOR 3D</ows:Title>
		<ows:Abstract>Aquesta opció fa la transformació de fitxers VEC de punts al format COR incorporant les alçades que seran extretes del model digital d'elevacions (MDE).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 2</ows:Title>
				<ows:Abstract>Pas de format VEC a format COR amb alçades que seran extretes del model digital d'elevacions (MDE).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerVEC</ows:Identifier>
				<ows:Title>NomFitxerVEC</ows:Title>
				<ows:Abstract>Fitxer origen que conté els punts de control en format VEC.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NomFitxerVEC"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerMDE</ows:Identifier>
				<ows:Title>NomFitxerMDE</ows:Title>
				<ows:Abstract>Fitxer IMG que conté el Model Digital d'Elevacions de la zona d'interès (només opció 2).</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NomFitxerMDE"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ModeInterpol</ows:Identifier>
				<ows:Title>Mode Interpolació</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>0: Veí més proper</li><li>1: Interpolació bilineal</li><li>2: Interpolació bicúbica</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:ModeInterpol"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>UNITATSXY</ows:Identifier>
				<ows:Title>Unitats XY</ows:Title>
				<ows:Abstract>Unitats de l'atribut del fitxer VEC, que correspon a les coordenades en el sistema de referència horitzontal destí, típicament m (només opció 2).</ows:Abstract>
				<ows:Metadata xlink:title="Name:UNITATSXY"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>mm</ows:Value>
						<ows:Value>dm</ows:Value>
						<ows:Value>cm</ows:Value>
						<ows:Value>m</ows:Value>
						<ows:Value>km</ows:Value>
						<ows:Value>graus</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SRH_COORD_VEC</ows:Identifier>
				<ows:Title>Sistema de referència origen</ows:Title>
				<ows:Abstract>Sistema de referència de les coordenades de l'atribut del fitxer VEC d'entrada. Si no s'indica, no es fa transformació i es suposa el mateix sistema de referència.</ows:Abstract>
				<ows:Metadata xlink:title="Name:SRH_COORD_VEC"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFitxerCOR</ows:Identifier>
				<ows:Title>NomFitxerCOR</ows:Title>
				<ows:Abstract>Fitxer destí que conté els punts de control en format COR.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NomFitxerCOR"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-COR</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-COR</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>