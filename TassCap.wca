<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TassCap:1</ows:Identifier>
		<ows:Title>TassCap</ows:Title>
		<ows:Abstract>Kauth i Thomas (Kauth, R.J. i Thomas, G.S. "The Tasseled Cap-A graphic description of the spectral-temporal development of agricultural crops as seen by Landsat" (1976) Prec. Symp. On Machine Processing of Remote Sensed Data, Purdue Univ., West Lafayette, Indiana, pp. 41-51.), amb l_objecte de millorar la predicció de collites, van proposar una transformació que usava les quatre bandes del sensor MSS de Landsat en combinacions lineals per a produir quatre índexs anomenats: brillantor (soil brightness index, SBI), verdor (green vegetative index, GVI), grogor (yellow stuff vegetation index, YVI) i un quart sense significat aparent anomenat "nonsuch" (NSI). D_una imatge Landsat, van seleccionar clusters de píxels identificats com a sòl, i uns altres identificats com a vegetació i van calcular, pel procés d_ortogonalització de Gram-Schmidt, els vectors propis que formarien els coeficients dels índexs.</ows:Abstract>
<ows:Metadata xlink:title="Title:Programa per calcular la transformació Tasseled Cap"/>
<ows:Metadata xlink:title="Abstract:Programa per calcular la transformació Tasseled Cap"/>
		<DataInputs>
		<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Mode</ows:Identifier>
				<ows:Title>Mode</ows:Title>
				<ows:Abstract>pot ser 1 o 2.
</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
			<LiteralData>
				<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:Value>1</ows:Value>
					<ows:Value>2</ows:Value>
				</ows:AllowedValues>
			</LiteralData>				
		</Input>
		<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Banda1</ows:Identifier>
				<ows:Title>Banda1</ows:Title>
				<ows:Abstract>Banda que correspon al canal 4 (1) del sensor MSS</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
			<ComplexData>
				<Default>
					<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
				</Default>
				<Supported>
					<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
				</Supported>
			</ComplexData>	
		</Input>
