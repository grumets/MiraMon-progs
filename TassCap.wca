		</Input>
		<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PrefixSortida</ows:Identifier>
				<ows:Title>PrefixSortida</ows:Title>
				<ows:Abstract>Prefix de la imatge de sortida. Els sufixos seran GVI, SBI, YVI i NSI amb un subratllat davant, respectivament.
</ows:Abstract>
			<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
