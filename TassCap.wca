				<ows:Identifier>Banda2</ows:Identifier>
				<ows:Title>Banda2</ows:Title>
				<ows:Abstract>Banda que correspon al canal 5 (2) del sensor MSS</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
			<ComplexData>
				<Default>
					<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
				</Default>
				<Supported>
					<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
				</Supported>
			</ComplexData>	
		</Input>
		<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Banda3</ows:Identifier>
				<ows:Title>Banda3</ows:Title>
				<ows:Abstract>Banda que correspon al canal 6 (3) del sensor MSS</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
			<ComplexData>
				<Default>
					<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
				</Default>
				<Supported>
					<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
				</Supported>
			</ComplexData>	
