<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Rastop:1</ows:Identifier>
		<ows:Title>Vectorización de rásters categóricos</ows:Title>
		<ows:Abstract>Este programa realiza la vectorización de uno o varios ficheros ráster con contenido categórico (mapas de cubiertas del suelo, de unidades geológicas, etc) a un fichero topológico de polígonos.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Vectorización de rásters categóricos"/>
		<ows:Metadata xlink:title="Abstract:Este programa realiza la vectorización de uno o varios ficheros ráster con contenido categórico (mapas de cubiertas del suelo, de unidades geológicas, etc) a un fichero topológico de polígonos."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="100">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Opción única</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="100">
				<ows:Identifier>FitxerRas</ows:Identifier>
				<ows:Title>Nombre Fichero Ráster</ows:Title>
				<ows:Abstract>Es el primero de los ficheros ráster a vectorizar. Se puede indicar más de un fichero ráster. En este caso, todos deben tener el mismo ámbito y resolución.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroRas"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>Multibanda</ows:Title>
				<ows:Abstract>Cuando el fichero FicheroRas1 es multibanda se toman en consideración todas las bandas. Todas ellas deben ser del mismo ámbito y resolución.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TOTS_VALORS_VALIDS</ows:Identifier>
				<ows:Title>Todos los valores</ows:Title>
				<ows:Abstract>Vectoriza todos los valores diferentes de sindatos como único atributo 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GENERALITZAR</ows:Identifier>
				<ows:Title>Generalizar</ows:Title>
				<ows:Abstract>Desactiva (0) o activa (1) la capacidad de generalización de bordes</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_CICLAR_POLIGONS</ows:Identifier>
				<ows:Title>No ciclar polígonos</ows:Title>
				<ows:Abstract>El resultado del RasTop es un fichero de arcos que son los bordes de los polígonos de las zonas vectorizadas.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_AGRUPAR_POLIGONS_PER_NODES</ows:Identifier>
				<ows:Title>No agrupar polígonos por nodos</ows:Title>
				<ows:Abstract>Se evita la agrupación de los polígonos con un mismo atributo y que se tocan por un nodo.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerTop</ows:Identifier>
				<ows:Title>Fichero Topológico</ows:Title>
				<ows:Abstract>Es el fichero topológico de polígonos resultado de la vectorización.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroTop"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>