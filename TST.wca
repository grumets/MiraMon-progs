						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Termic</ows:Identifier>
				<ows:Title>Tèrmic</ows:Title>
				<ows:Abstract>Fitxer d'entrada de la banda tèrmica.</ows:Abstract>
