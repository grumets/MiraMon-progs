					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TempAire</ows:Identifier>
				<ows:Title>Temperatura de l'Aire</ows:Title>
				<ows:Abstract>Fitxer d'entrada de dades de temperatura de l'aire.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:TempAire"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BD_Atmos</ows:Identifier>
				<ows:Title>BD_Atmos</ows:Title>
				<ows:Abstract>Base de dades atmosfèrics. Els valors disponibles són: "TIGR-1", "TIGR-2", "TIGR-3" o "STD".</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:BD_Atmos"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>TIGR-1</ows:Value>
						<ows:Value>TIGR-2</ows:Value>
						<ows:Value>TIGR-3</ows:Value>
						<ows:Value>STD</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Sensor</ows:Identifier>
				<ows:Title>Sensor</ows:Title>
				<ows:Abstract>Sensor de la banda tèrmica. Els valors possibles són:<![CDATA[
<ul>
<li>0 (obtenir sensor de metadades)</li>
<li>4 (per Landsat-4 MSS)</li>
<li>5 (per Landsat-5 TM)</li>
<li>7 (per Landsat-7 ETM+).</li>
</ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param8"/>
				<ows:Metadata xlink:title="Name:Sensor"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
