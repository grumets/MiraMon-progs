			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Emissivitat</ows:Identifier>
				<ows:Title>Emissivitat</ows:Title>
				<ows:Abstract>Fitxer d'entrada de dades de emissivitat.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Emissivitat"/>
				<ComplexData>
					<Default>
