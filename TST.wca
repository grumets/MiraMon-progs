<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TST:param1:0</ows:Identifier>
		<ows:Title>Vapor d'aigua</ows:Title>
		<ows:Abstract>Aquesta opció s'utilitza per calcular la temperatura de la superfície de la Terra a partir de dades de vapor d'aigua.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Càlcul de la Temperatura de la Superfície Terrestre (TST)"/>
		<ows:Metadata xlink:title="Abstract:Aquest módul serveix per calcular la temperatura de la superficie terrestre a partir de dades d'emisivitat, vapor d'aigua i una banda tèrmica. Tambè es poden afegir dades de temperatura de l'aire."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Càlcul de la TST a partir de dades de vapor d'aigua.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Termic</ows:Identifier>
				<ows:Title>Tèrmic</ows:Title>
				<ows:Abstract>Fitxer d'entrada de la banda tèrmica.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Tèrmic"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Emissivitat</ows:Identifier>
				<ows:Title>Emissivitat</ows:Title>
				<ows:Abstract>Fitxer d'entrada de dades de emissivitat.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Emissivitat"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>VaporAigua</ows:Identifier>
				<ows:Title>Vapor d'aigua</ows:Title>
				<ows:Abstract>Fitxer d'entrada de dades de vapor d'aigua.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:VaporAigua"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BD_Atmos</ows:Identifier>
				<ows:Title>BD_Atmos</ows:Title>
				<ows:Abstract>Base de dades atmosfèrics. Els valors disponibles són: "TIGR-1", "TIGR-2", "TIGR-3" o "STD".</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:BD_Atmos"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>TIGR-1</ows:Value>
						<ows:Value>TIGR-2</ows:Value>
						<ows:Value>TIGR-3</ows:Value>
						<ows:Value>STD</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Sensor</ows:Identifier>
				<ows:Title>Sensor</ows:Title>
				<ows:Abstract>Sensor de la banda tèrmica. Els valors possibles són:<![CDATA[
<ul>
<li>0 (obtenir sensor de metadades)</li>
<li>4 (per Landsat-4 MSS)</li>
<li>5 (per Landsat-5 TM)</li>
<li>7 (per Landsat-7 ETM+).</li>
</ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:Sensor"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>7</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>TST</ows:Identifier>
				<ows:Title>Temperatura Superfície Terrestre</ows:Title>
				<ows:Abstract>Fitxer de sortida del resultat del càlcul de la temperatura de la superfície terrestre.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:TST"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TST:param1:1</ows:Identifier>
		<ows:Title>Vapor d'aigua i temperatura de l'aire</ows:Title>
		<ows:Abstract>Aquesta opció s'utilitza per calcular la temperatura de la superfície de la Terra a partir de dades de vapor d'aigua i de temperatura de l'aire.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Càlcul de la TST a partir de dades de vapor d'aigua i temperatura de l'aire.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
