<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:HISTO:param1</ows:Identifier>
		<ows:Title>HISTO</ows:Title>
		<ows:Abstract>Aquest mòdul genera l'histograma de freqüències d'un ràster en format IMG.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Histograma d'un ràster"/>
		<ows:Metadata xlink:title="Abstract:Aquest mòdul genera l'histograma de freqüències d'un ràster en format IMG."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Tipus d'histograma que es vol generar: <![CDATA[<ul><li>1: Histograma de barres.</li><li>2: Histograma de línies.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerRaster</ows:Identifier>
				<ows:Title>FitxerRaster</ows:Title>
				<ows:Abstract>Fitxer IMG a usar per a generar l'histograma.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerRaster"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Min</ows:Identifier>
				<ows:Title>Mínim</ows:Title>
				<ows:Abstract>Mínim valor que es vol representar a l'histograma</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Mínim"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Max</ows:Identifier>
				<ows:Title>Màxim</ows:Title>
				<ows:Abstract>Màxim valor que es vol representar a l'histograma</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Màxim"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>255</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NClasses</ows:Identifier>
				<ows:Title>Nombre de classes</ows:Title>
				<ows:Abstract>Nombre de classes a representar a l'histograma</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:NClasses"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Tractament</ows:Identifier>
				<ows:Title>Tractament</ows:Title>
				<ows:Abstract>Tractament de les dades origen: <![CDATA[<ul>
          <li>1: Quantitatiu continu.</li>
          <li>2: Quantitatiu/Ordinal.</li>      
          <li>3: Categòric.</li>                
          </ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:Tractament"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CLASSES</ows:Identifier>
				<ows:Title>FitxerCSV</ows:Title>
				<ows:Abstract>Fitxer CSV on es desarà la freqüència de cada classe i les corresponents àrees (en cas que les metadades del fitxer d'entrada contingui unitats geogràfiques mètriques).</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>AREA</ows:Identifier>
				<ows:Title>Area</ows:Title>
				<ows:Abstract>Per generar l'histograma respecte les àrees de cada classe.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OBRIR</ows:Identifier>
				<ows:Title>Obrir</ows:Title>
				<ows:Abstract>Per obrir l'histograma un cop s'hagi generat.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>DIR_GRAFICS</ows:Identifier>
				<ows:Title>CarpetaSortida</ows:Title>
				<ows:Abstract>Carpeta on es desaran els fitxers necessaris per la generació de l'histograma.</ows:Abstract>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyUri">anyUri</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
