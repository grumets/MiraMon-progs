<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GMLMM:Param1:1</ows:Identifier>
		<ows:Title>Importació i exportació entre el format GML i el MiraMon</ows:Title>
		<ows:Abstract>Importa un fichero en formato GML creando un Mapa de MiraMon que contiene una o más capas (según convenga en función del contenido del fichero GML) en formato vectorial estructurado de MiraMon (PNT, ARC/NOD y POL) pero no las estructura  topológicamente.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importació i exportació entre el format GML i el MiraMon"/>
		<ows:Metadata xlink:title="Abstract:Importa un fichero en formato GML creando un Mapa de MiraMon que contiene una o más capas (según convenga en función del contenido del fichero GML) en formato vectorial estructurado de MiraMon (PNT, ARC/NOD y POL) pero no las estructura  topológicamente."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Importación de GML a Mapa de MiraMon</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerGML</ows:Identifier>
				<ows:Title>Fichero GML</ows:Title>
				<ows:Abstract>Fichero GML a importar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroGML"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Sistema de Referencia Horizontal Destino</ows:Title>
				<ows:Abstract>Identificador del sistema de referencia en el que se quiere reproyectar las capas, si es que se desea un sistema de referencia diferente al del fichero origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ORDRECOOR</ows:Identifier>
				<ows:Title>ORDRECOOR</ows:Title>
				<ows:Abstract>LATLONG o LONGLAT. Si se omite, el orden se determina automáticamente (ORDRE_LL_AUTO_GML).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>LATLONG</ows:Value>
						<ows:Value>LONGLAT</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VULL_CAMPS_GEOTOPO</ows:Identifier>
				<ows:Title>Campos geométrico-topológicos</ows:Title>
				<ows:Abstract>Se pide que se escriban también los campos geotopológicos en la conversión de MM a GML.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VULL_TAULES_ASSOCIADES</ows:Identifier>
				<ows:Title>Tablas asociadas</ows:Title>
				<ows:Abstract>Se pide que se escriban también las tablas asociadas en la conversión de MM a GML.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VULL_TOPO_COM_DBF</ows:Identifier>
				<ows:Title>VULL_TOPO_COM_DBF</ows:Title>
				<ows:Abstract>Se pide que, si es posible, se haga una transformación a GML manteniendo la topología en dos tablas asociadas. Al importar un GML de polígonos, si se quiere recuperar la topología, primero se lee un GML de arcos asociado al de polígonos y se crea el fichero de arcos; después se lee el GML de polígonos usando las tablas de topología (en el mismo directorio y con unos nombres concretos). Si no se pide la topología, el GML de polígonos se lee directamente.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SEPARADOR_COM_A_COMPLEXTYPE</ows:Identifier>
				<ows:Title>SEPARADOR_COM_A_COMPLEXTYPE</ows:Title>
				<ows:Abstract>El separador de campo se exporta como GML ComplexType (SEPARADOR_COM_A_GML_COMPLEXTYPE).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMM</ows:Identifier>
				<ows:Title>Fichero MMM</ows:Title>
				<ows:Abstract>Fichero de salida con extensión .mmm. El programa creará un directorio con el mismo nombre del mapa en el cual se guardarán las capas vectoriales que forman el mapa.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroMMM"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GMLMM:Param1:2</ows:Identifier>
		<ows:Title>Exportación de un Mapa o de una capa vectorial de MiraMon a GML</ows:Title>
		<ows:Abstract>Exporta un Mapa o una capa en formato vectorial estructurado de MiraMon a formato GML (WFS Deegree)</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Exportación de un Mapa o de una capa vectorial de MiraMon a GML</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMOri</ows:Identifier>
				<ows:Title>Fichero Vectorial Origen</ows:Title>
				<ows:Abstract>Fichero origen  a exportar. Puede ser un fichero de mapas, de puntos, de arcos o de polígonos.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroMMOri"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-nod</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ARREL_ESQUEMES</ows:Identifier>
				<ows:Title>Dirección base http esquemas validación GML</ows:Title>
				<ows:Abstract>Dirección base de los esquemas de validación GML. Por defecto se utilizará http://miramon.uab.cat/ogc/schemas</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VULL_CAMPS_GEOTOPO</ows:Identifier>
				<ows:Title>Campos geométrico-topológicos</ows:Title>
				<ows:Abstract>Se pide que se escriban también los campos geotopológicos en la conversión de MM a GML.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VULL_TAULES_ASSOCIADES</ows:Identifier>
				<ows:Title>Tablas asociadas</ows:Title>
				<ows:Abstract>Se pide que se escriban también las tablas asociadas en la conversión de MM a GML.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VULL_TOPO_COM_DBF</ows:Identifier>
				<ows:Title>VULL_TOPO_COM_DBF</ows:Title>
				<ows:Abstract>Se pide que, si es posible, se haga una transformación a GML manteniendo la topología en dos tablas asociadas. Al importar un GML de polígonos, si se quiere recuperar la topología, primero se lee un GML de arcos asociado al de polígonos y se crea el fichero de arcos; después se lee el GML de polígonos usando las tablas de topología (en el mismo directorio y con unos nombres concretos). Si no se pide la topología, el GML de polígonos se lee directamente.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SEPARADOR_COM_A_COMPLEXTYPE</ows:Identifier>
				<ows:Title>SEPARADOR_COM_A_COMPLEXTYPE</ows:Title>
				<ows:Abstract>El separador de campo se exporta como GML ComplexType (SEPARADOR_COM_A_GML_COMPLEXTYPE).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerGML</ows:Identifier>
				<ows:Title>Fichero GML</ows:Title>
				<ows:Abstract>Fichero GML de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroGML"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxerXSD</ows:Identifier>
				<ows:Title>Fichero XSD</ows:Title>
				<ows:Abstract> Fichero XSD que contendrá el esquema de aplicación en XML para el fichero GML generado.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FicheroXSD"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
