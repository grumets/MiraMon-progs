<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:EstRas:1</ows:Identifier>
		<ows:Title>Datos estadísticos de un ráster.</ows:Title>
		<ows:Abstract>Esta opción calcula datos estadísticos de un solo ráster (monobanda o multibanda).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Estadísticas de un ráster o de una serie de rásters"/>
		<ows:Metadata xlink:title="Abstract:Esta aplicación realiza cálculos estadísticos de un ráster, de una serie de rásters o la normalización de un ráster."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Datos estadísticos de un ráster.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerIMG</ows:Identifier>
				<ows:Title>Fichero IMG</ows:Title>
				<ows:Abstract>Fichero ráster a usar para el cálculo de estadísticas.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroIMG"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Tractament</ows:Identifier>
				<ows:Title>Tratamiento de los datos origen</ows:Title>
				<ows:Abstract><![CDATA[Indica el tratamiento de los datos del ráster origen:<ul>           <li>C: Categórico.</li>           <li>N: Cuantitativo.</li>           <li>M: Según metadatos.</li>           </ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Tratamiento"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>C</ows:Value>
						<ows:Value>N</ows:Value>
						<ows:Value>M</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>M</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_VAL</ows:Identifier>
				<ows:Title>Número de valores</ows:Title>
				<ows:Abstract>Para calcular el número de píxeles del ráster origen (sin contar los píxeles con valor sindatos en caso de que existan).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MIN</ows:Identifier>
				<ows:Title>Mínimo valor</ows:Title>
				<ows:Abstract>Para calcular el valor mínimo del ráster origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MAX</ows:Identifier>
				<ows:Title>Máximo valor</ows:Title>
				<ows:Abstract>Para calcular el valor máximo del ráster origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MITJANA</ows:Identifier>
				<ows:Title>Media</ows:Title>
				<ows:Abstract>Para calcular la media del ráster origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESV_STD</ows:Identifier>
				<ows:Title>Desviación estándar</ows:Title>
				<ows:Abstract>Para calcular la desviación estándar del ráster origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MEDIANA</ows:Identifier>
				<ows:Title>Mediana</ows:Title>
				<ows:Abstract>Para calcular la mediana del ráster origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESV_MEDIANA</ows:Identifier>
				<ows:Title>Media de la desviación absoluta respecto la mediana</ows:Title>
				<ows:Abstract>Para calcular la media de la desviación absoluta respecto la mediana del ráster origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MODA</ows:Identifier>
				<ows:Title>Moda</ows:Title>
				<ows:Abstract>Para calcular la moda del ráster origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>I_SHAN</ows:Identifier>
				<ows:Title>Índice de Shannon</ows:Title>
				<ows:Abstract>Para calcular el índice de Shannon del ráster origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>1Q</ows:Identifier>
				<ows:Title>Primer cuartil</ows:Title>
				<ows:Abstract>Para calcular el primer cuartil del ráster origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>3Q</ows:Identifier>
				<ows:Title>Tercer cuartil</ows:Title>
				<ows:Abstract>Para calcular el tercer cuartil del ráster origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>Multibanda</ows:Title>
				<ows:Abstract>Modificador para indicar que se quiere utilizar todas las bandas del fichero de entrada.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MEDIANA_EMPAT</ows:Identifier>
				<ows:Title>Desempate para los cuantiles</ows:Title>
				<ows:Abstract><![CDATA[  Si se ha solicitado el cálculo de algún cuantil (como mediana, cuartil o percentil), indica el tipo de desempate a usar para su cálculo cuando la posición del cuantil sea entre dos valores de la serie. El criterio también se aplicará al calcular la media de las desviaciones absolutas respecto a la mediana (ya que requiere calcular la mediana). Las opciones de cálculo son:<ul><li>1 para elegir valor alternado.</li><li>2 para elegir valor inferior.</li><li>3 para elegir valor superior.</li><li>4 para elegir promedio de los dos valores entre los que los encuentra.</li></ul> La opción predeterminada es la 1.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PERCENTIL</ows:Identifier>
				<ows:Title>Percentil</ows:Title>
				<ows:Abstract>En el caso de elegir la función estadística Percentil, indica qué percentil se quiere calcular.</ows:Abstract>
				<ows:Metadata xlink:title="Name:Percentil"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>100</ows:MaximumValue>
							<ows:Spacing></ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerINI</ows:Identifier>
				<ows:Title>Fichero INI</ows:Title>
				<ows:Abstract>Fichero INI con los resultados de los datos estadísticos calculados.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroINI"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-ini</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-ini</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:EstRas:2</ows:Identifier>
		<ows:Title>Imagen de las estadísticas de una serie de rásters.</ows:Title>
		<ows:Abstract>Esta opción genera una imagen con el resultado de la función estadística elegida a partir de una serie de ráster.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Imagen de las estadísticas de una serie de rásters.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FEstadistica</ows:Identifier>
				<ows:Title>Función estadística</ows:Title>
				<ows:Abstract><![CDATA[Función estadística a calcular para cada píxel de la serie de rásters:<ul>           <li>1: Mínimo.</li>           <li>2: Máximo.</li>           <li>3: Media.</li>           <li>4: Desviación estándar.</li>                 <li>5: Mediana.</li>           <li>6: Moda.</li>           <li>7: Índice de Shannon.</li>           <li>8: Media de las desviaciones absolutas respecto de la mediana.</li>                 <li>10: Primer cuartil.</li>           <li>12: Tercer cuartil.</li>                 <li>14: Percentil.</li>           <li>15: Recta de regresión.</li>           </ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FunciónEstadística"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>6</ows:Value>
						<ows:Value>7</ows:Value>
						<ows:Value>8</ows:Value>
						<ows:Value>10</ows:Value>
						<ows:Value>12</ows:Value>
						<ows:Value>14</ows:Value>
						<ows:Value>15</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>LlistaIMG</ows:Identifier>
				<ows:Title>Lista IMG</ows:Title>
				<ows:Abstract>Fichero TXT con la lista de archivos que se quieren usar para el cálculo de la imagen de la función estadística elegida.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:ListaIMG"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MEDIANA_EMPAT</ows:Identifier>
				<ows:Title>Desempate para los cuantiles</ows:Title>
				<ows:Abstract><![CDATA[  Si se ha solicitado el cálculo de algún cuantil (como mediana, cuartil o percentil), indica el tipo de desempate a usar para su cálculo cuando la posición del cuantil sea entre dos valores de la serie. El criterio también se aplicará al calcular la media de las desviaciones absolutas respecto a la mediana (ya que requiere calcular la mediana). Las opciones de cálculo son:<ul><li>1 para elegir valor alternado.</li><li>2 para elegir valor inferior.</li><li>3 para elegir valor superior.</li><li>4 para elegir promedio de los dos valores entre los que los encuentra.</li></ul> La opción predeterminada es la 1.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>AJUST</ows:Identifier>
				<ows:Title>Tipo de ajuste para la recta de regresión</ows:Title>
				<ows:Abstract><![CDATA[En caso de que se haya indicado calcular la Recta de regresión, indica el tipo de ajuste a realizar:<ul>           <li>L: Lineal.</li>           <li>Q: Cuadrática.</li>           </ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>L</ows:Value>
						<ows:Value>Q</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>L</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>OutputIMG</ows:Identifier>
				<ows:Title>Fichero IMG</ows:Title>
				<ows:Abstract>Fichero ráster con el resultado de los datos estadísticos calculados.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FicheroIMGSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:EstRas:3</ows:Identifier>
		<ows:Title>Normalización de un ráster.</ows:Title>
		<ows:Abstract>Esta opción calcula la normalización de un ráster (monobanda o multibanda).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Normalización de un ráster.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerIMG</ows:Identifier>
				<ows:Title>Fichero IMG</ows:Title>
				<ows:Abstract>Fichero ráster a usar para el cálculo de estadísticas.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroIMG"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>Multibanda</ows:Title>
				<ows:Abstract>Modificador para indicar que se quiere utilizar todas las bandas del fichero de entrada.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefijo</ows:Title>
				<ows:Abstract>Prefijo de los ficheros de salida.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>OutputNorIMG</ows:Identifier>
				<ows:Title>Fichero IMG</ows:Title>
				<ows:Abstract>Fichero ráster con el resultado de la normalización de la imagen de entrada.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroIMGNorm"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>