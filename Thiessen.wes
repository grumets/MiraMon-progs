				<ows:Title>Atributo de fusión</ows:Title>
				<ows:Abstract>Campo del fichero origen usado como atributo de fusión de los polígonos de Thiessen generados.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:AtriFusion"/>
				<LiteralData>
