	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Thiessen:Param4:2</ows:Identifier>
		<ows:Title>Generar polígonos Thiessen recortado por un fichero como máscara</ows:Title>
		<ows:Abstract>Generar polígonos Thiessen recortado por un fichero como máscara.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxOri</ows:Identifier>
				<ows:Title>Fichero origen</ows:Title>
				<ows:Abstract>Fichero origen de puntos estructurados en formato PNT.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FichOri"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>AtriFusio</ows:Identifier>
				<ows:Title>Atributo de fusión</ows:Title>
				<ows:Abstract>Campo del fichero origen usado como atributo de fusión de los polígonos de Thiessen generados.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:AtriFusion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción ámbito de salida</ows:Title>
				<ows:Abstract><![CDATA[Opción por el ámbito del fichero resultante. Puede valer: <ul><li>0: Ajustar a los límites definidos por la selección de puntos origen</li><li>1: Especificar ámbito</li><li>2: Recorta el resultado utilizando un fichero como máscara</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxMasc</ows:Identifier>
				<ows:Title>Fichero máscara</ows:Title>
				<ows:Abstract>Fichero máscara usado para recortar el fichero resultante por el ámbito de este fichero.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:FichMasc"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>COND#_VALOR</ows:Identifier>
				<ows:Title>Valor de la condición #</ows:Title>
				<ows:Abstract>Valor a utilizar en la # condición de la selección. Puede haber hasta 100 condiciones y por tanto hasta 100 valores (COND#_VALOR) empezando por el índice 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>COND#_CAMP</ows:Identifier>
				<ows:Title>Campo de la condición #</ows:Title>
				<ows:Abstract>Nombre del campo de la condición # de la selección. Puede haber hasta 100 condiciones y por tanto, hasta 100 nombres de campo (COND#_CAMP).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>COND#_NEXE</ows:Identifier>
				<ows:Title>Nexo de la condición #</ows:Title>
				<ows:Abstract>Nexo a usar para enlazar entre sucesivas condiciones de selección. En ese caso entre la condición # y la condición #+1. Puede haber hasta 100 condiciones y por tanto hasta 99 nexos (COND#_NEXE) empezando por el índice 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>AND</ows:Value>
						<ows:Value>OR</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>COND#_PRIOR</ows:Identifier>
				<ows:Title>Prioridad del nexo de la condición #</ows:Title>
				<ows:Abstract>Prioridad del nexo a utilizar para enlazar entre sucesivas condiciones de selección. En ese caso entre la condición # y la condición #+1. Puede haber hasta 100 condiciones y por tanto hasta 99 prioridades (COND#_PRIOR) empezando por el índice 1. Es un parámetro optativo, donde de no indicarse, la prioridad es simplemente el orden.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>1</ows:MinimumValue>
							<ows:MaximumValue>99</ows:MaximumValue>
							<ows:Spacing>99</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>COND#_OP</ows:Identifier>
				<ows:Title>Operador de la condición #</ows:Title>
				<ows:Abstract>Operador a utilizar en la # condición de la selección. Puede haber hasta 100 condiciones y por tanto hasta 100 operadores (COND#_OP).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>EQ</ows:Value>
						<ows:Value>NO_EQ</ows:Value>
						<ows:Value>LT</ows:Value>
						<ows:Value>GT</ows:Value>
						<ows:Value>LT_EQ</ows:Value>
						<ows:Value>GT_EQ</ows:Value>
						<ows:Value>INTERVAL</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TIN</ows:Identifier>
				<ows:Title>Fichero triangulación Delaunay</ows:Title>
				<ows:Abstract>Generar fichero con la triangulación de Delaunay.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CONSIDER_NODATA</ows:Identifier>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxDest</ows:Identifier>
				<ows:Title>Fichero destino</ows:Title>
				<ows:Abstract>Fichero destino de polígonos Thiessen.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FichDest"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>