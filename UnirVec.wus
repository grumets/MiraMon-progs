<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:UnirVec:1&amp;!Param4</ows:Identifier>
		<ows:Title>Joining a VEC list</ows:Title>
		<ows:Abstract>This option joins two or more MiraMon vector files from a file that contains a list of the files to be joined.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Joining two or more vector files"/>
		<ows:Metadata xlink:title="Abstract:This program joins two or more MiraMon vector files into a single file without taking any topological consideration. That is why the output structured files are marked as non-topologic files. This way this is a very fast process. On the other hand, the &lt;a href=&quot;mosaic.htm&quot;&gt;Mosaic&lt;/a&gt; application performs a topological structuring of the output file, making it more robust but slower and requiring more memory."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 1</ows:Title>
				<ows:Abstract>Joins a list or sequence of VEC files.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>OrigenLlista</ows:Identifier>
				<ows:Title>List origin</ows:Title>
				<ows:Abstract>This is a list file (usually txt or lst) that contains a list of files to join.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:ListOrigin"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-TXT</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-TXT</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-LST</MimeType>
							<Encoding>lst</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Desti</ows:Identifier>
				<ows:Title>Output_File</ows:Title>
				<ows:Abstract>It is the output file of the union of the files.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Output_File"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:UnirVec:1&amp;Param4</ows:Identifier>
		<ows:Title>Joining a sequence of VEC files</ows:Title>
		<ows:Abstract>This option joins two or more MiraMon vector files from a sequence of filenames in command line.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 1</ows:Title>
				<ows:Abstract>Joins a list or sequence of VEC files.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Origen1</ows:Identifier>
				<ows:Title>Origin1</ows:Title>
				<ows:Abstract>First file of a sequence of file names. This option is especially useful to join 2 or 3 files on the command line without having to generate a list. The application dialog box does not reflect this option.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Origin1"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Origen2</ows:Identifier>
				<ows:Title>Origin2</ows:Title>
				<ows:Abstract>Second file of a sequence of file names. This option is especially useful to join 2 or 3 files on the command line without having to generate a list. The application dialog box does not reflect this option.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Origin2"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Origen3</ows:Identifier>
				<ows:Title>Origin3</ows:Title>
				<ows:Abstract>Third file of a sequence of file names. This option is especially useful to join 2 or 3 files on the command line without having to generate a list. The application dialog box does not reflect this option.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Origin3"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Desti</ows:Identifier>
				<ows:Title>Output_File</ows:Title>
				<ows:Abstract>It is the output file of the union of the files.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Output_File"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:UnirVec:2&amp;!Param4</ows:Identifier>
		<ows:Title>Joining of a list of ARC, PNT or cycled ARC files</ows:Title>
		<ows:Abstract>This option joins two or more MiraMon vector files from a file that contains a list of the files to be joined.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 2</ows:Title>
				<ows:Abstract>Joins a list or sequence of cycled ARC, PNT, or ARC files.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>OrigenLlista</ows:Identifier>
				<ows:Title>List origin</ows:Title>
				<ows:Abstract>This is a list file (usually txt or lst) that contains a list of files to join.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:ListOrigin"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-TXT</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-TXT</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-LST</MimeType>
							<Encoding>lst</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX_ORI</ows:Identifier>
				<ows:Title>PREFIX_ORI</ows:Title>
				<ows:Abstract>Given that the number of cycles on an arc may be greater than 1, the name of the polygon files is built from a manipulation of the origin polygon files. Thus, the program looks for 'PREFIX_ORI' (and 'SUFIX_ORI') in the original name and replaces them with 'PREFIX_DESTI' and 'SUFIX_DESTI'. The destination directory is the same as the directory of the destination arcs file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SUFIX_ORI</ows:Identifier>
				<ows:Title>SUFIX_ORI</ows:Title>
				<ows:Abstract>Given that the number of cycles on an arc may be greater than 1, the name of the polygon files is built from a manipulation of the origin polygon files. Thus, the program looks for 'SUFIX_ORI' (and 'PREFIX_ORI') in the original name and replaces them with 'PREFIX_DESTI' and 'SUFIX_DESTI'. The destination directory is the same as the directory of the destination arcs file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX_DESTI</ows:Identifier>
				<ows:Title>PREFIX_DESTI</ows:Title>
				<ows:Abstract>Given that the number of cycles on an arc may be greater than 1, the name of the polygon files is built from a manipulation of the origin polygon files. Thus, the program looks for 'PREFIX_ORI' and 'SUFIX_ORI' in the original name and replaces them with 'PREFIX_DESTI' (and 'SUFIX_DESTI'). The destination directory is the same as the directory of the destination arcs file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SUFIX_DESTI</ows:Identifier>
				<ows:Title>SUFIX_DESTI</ows:Title>
				<ows:Abstract>Given that the number of cycles on an arc may be greater than 1, the name of the polygon files is built from a manipulation of the origin polygon files. Thus, the program looks for 'PREFIX_ORI' and 'SUFIX_ORI' in the original name and replaces them with 'SUFIX_DESTI' (and 'PREFIX_DESTI'). The destination directory is the same as the directory of the destination arcs file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Desti</ows:Identifier>
				<ows:Title>Output_File</ows:Title>
				<ows:Abstract>It is the output file of the union of the files.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Output_File"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:UnirVec:2&amp;Param4</ows:Identifier>
		<ows:Title>Joining a sequence of ARC, PNT or cycled ARC files</ows:Title>
		<ows:Abstract>This option joins two or more MiraMon vector files from a sequence of file names on the command line.</ows:Abstract>
