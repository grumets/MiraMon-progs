<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:UNIRVEC:Param:3</ows:Identifier>
		<ows:Title>Merge List</ows:Title>
		<ows:Abstract>This option merge  two or more MiraMon vector files from a text file.</ows:Abstract>
<ows:Metadata xlink:title="Title:Joint of two VEC files"/>
<ows:Metadata xlink:title="Abstract:This program connects two or more MiraMon vector files into one file without topological consideration."/>
		<DataInputs>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Option</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract><![CDATA[<li>1. Merges files and allows to overwrite the file destination.</li><li>2. Merges files ARC, PNT.</li>]]>
</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
			<LiteralData>
				<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:Value>1</ows:Value>
					<ows:Value>2</ows:Value>
				</ows:AllowedValues>
			</LiteralData>				
		</Input>			
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>List</ows:Identifier>
				<ows:Title>List</ows:Title>
				<ows:Abstract>This is a list file (usually txt or lst) that contains a list of files to merge.
</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
		<ComplexData>
				<Default>
					<Format>
								<MimeType>application/x-TXT</MimeType>
								<Encoding>Text</Encoding>
							</Format>
				</Default>
				<Supported>
					<Format>
								<MimeType>application/x-TXT</MimeType>
								<Encoding>Text</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-LST</MimeType>
								<Encoding>lst</Encoding>
							</Format>
				</Supported>
			</ComplexData>	
		</Input>
		</DataInputs>
		<ProcessOutputs>	
				<Output>
				<ows:Identifier>Output_File</ows:Identifier>
				<ows:Title>Output_File</ows:Title>
				<ows:Abstract>The resulting output file. It can be equal to one of the two input files and it has to be indicated without extension.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexOutput>
					<Default>
					<Format>
						<MimeType>application/x-ARC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Default>
					<Supported>
					<Format>
						<MimeType>application/x-PNT</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					<Format>
						<MimeType>application/x-VEC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>	
</ProcessDescription>
<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:UNIRVEC:!Param:3</ows:Identifier>
		<ows:Title>Merge a sequence of files</ows:Title>
		<ows:Abstract>This option connects two or more MiraMon vector files from a sequence of filenames in command line.</ows:Abstract>
		<DataInputs>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Option</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract><![CDATA[<li>1. Merges files and allows to overwrite the file destination.</li><li>2. Merges files ARC, PNT.</li>]]>
</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
			<LiteralData>
				<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:Value>1</ows:Value>
					<ows:Value>2</ows:Value>
				</ows:AllowedValues>
			</LiteralData>				
		</Input>			
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Origin#</ows:Identifier>
				<ows:Title>Origin#</ows:Title>
				<ows:Abstract>Is a sequence of filenames. This option is especially useful for merging 2 or 3 files in command line without a list of filenames. The dialog box does not reflect the application of this option.
</ows:Abstract>
				<ows:Metadata xlink:title="Param4" />
		<ComplexData>
				<Default>
					<Format>
								<MimeType>application/x-ARC</MimeType>
								<Encoding>Text</Encoding>
							</Format>
				</Default>
				<Supported>
					<Format>
								<MimeType>application/x-PNT</MimeType>
								<Encoding>Text</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>lst</Encoding>
							</Format>
				</Supported>
			</ComplexData>	
		</Input>
		</DataInputs>
		<ProcessOutputs>	
				<Output>
				<ows:Identifier>Destí</ows:Identifier>
				<ows:Title>Destí</ows:Title>
				<ows:Abstract>The resulting output file. It can be equal to one of the two input files and it has to be indicated without extension.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexOutput>
					<Default>
					<Format>
						<MimeType>application/x-ARC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Default>
					<Supported>
					<Format>
						<MimeType>application/x-PNT</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					<Format>
						<MimeType>application/x-VEC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>	
</ProcessDescription>
</wps:ProcessDescriptions>
