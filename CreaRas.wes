<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CreaRas</ows:Identifier>
		<ows:Title>CreaRas: Inicializa un nuevo raster</ows:Title>
		<ows:Metadata xlink:title="Title:Inicializa un nuevo raster."/>
		<ows:Metadata xlink:title="Abstract:Inicializa un nuevo raster a partir de un fichero patrón preexistente o de unas características dadas manualmente."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxPatro</ows:Identifier>
				<ows:Title>Fichero patrón</ows:Title>
				<ows:Abstract>Fichero que define el área geográfica del mapa. Hay que indicar la extensión. En caso de que no se quiera dar un fichero patrón, este parámetro valdrá "NUL".</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FichPatron"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-nod</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusDada</ows:Identifier>
				<ows:Title>Tipo de dato</ows:Title>
				<ows:Abstract>Se indica el tipo de dato de la nueva imagen. Puede ser cualquiera de los tipos soportados por MiraMon, por ejemplo "byte", "integer-RLE", etc.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:TipoDato"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>integer-RLE</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ValorFons</ows:Identifier>
				<ows:Title>Valor de fondo</ows:Title>
				<ows:Abstract>Valor que se utilizará para inicializar el fichero de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ValorFondo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MarcarValorFons</ows:Identifier>
				<ows:Title>Marcar valor de fondo</ows:Title>
				<ows:Abstract>Bandera que puede valer 0 o 1 en función de si se quiere marcar el valor inicializado como valor de fondo en el fichero de documentación (1) o no (0).</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:MarcarValorFondo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CostatCella</ows:Identifier>
				<ows:Title>Lado de celda</ows:Title>
				<ows:Abstract>Tamaño del píxel de la imagen de salida.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Mult</ows:Identifier>
				<ows:Title>Múltiple</ows:Title>
				<ows:Abstract>En el caso que FitxPatró sea tipo vector, el programa amplía el área geográfica para que así las coordenadas mínX y mínY del nuevo ráster sean múltiplos del factor Múlt y, además, haya como mínimo un píxel en exceso a lo largo de todo el borde.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DescripcioNoData</ows:Identifier>
				<ows:Title>Descripción de NoData</ows:Title>
				<ows:Abstract>Parámetro optativo para definir un descriptor al valor de fondo cuando se haya activado MarcarValorFondo. El descriptor por defecto es NODATA.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>NODATA</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxSort</ows:Identifier>
				<ows:Title>Fichero de salida</ows:Title>
				<ows:Abstract>Fichero de salida del nuevo ráster IMG (o un grid dentro de un VEC).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>