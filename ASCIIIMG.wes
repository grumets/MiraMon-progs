<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ASCIIIMG:!Param05</ows:Identifier>
		<ows:Title>ASCIIIMG ESRI</ows:Title>
		<ows:Abstract>Opción que interpreta la cabecera del formato ESRI ASCII para hacer la transformación.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importación de ficheros ráster ASCII a ficheros ráster MiraMon"/>
		<ows:Metadata xlink:title="Abstract: Esta aplicación importa ficheros ráster de diversos formatos ASCII a MiraMon (formato IMG)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>reg</ows:Identifier>
				<ows:Title>Tamaño registro o delimitador</ows:Title>
				<ows:Abstract><![CDATA[Indica el tratamiento para los tres tipos principales de fichero ASCII:<ul><li>-1 (y menos de 6 parámetros) cuando se trata de un fichero ESRI ASCII.</li> 				<li> 0 cuando los valores están separados por un delimitador.</li> 				<li>n cuando indica el ancho en caracteres de cada celda para registro fijo.</li> 				<li>-n (y 6 o más parámetros) cuando se trata de un fichero ASCII estructurado por columnas, la n indica el número de columna a importar.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:reg"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FOri</ows:Identifier>
				<ows:Title>Fichero origen</ows:Title>
				<ows:Abstract>Fichero ASCII de entrada</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:FOri"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusDada</ows:Identifier>
				<ows:Title>Tipo de Dato</ows:Title>
				<ows:Abstract><![CDATA[Tipo de dato de salida: <ul><li>bit (entero [0,1], 1 bit/celda)</li><li>byte (enteros [0,255], 1 byte/celda)</li><li>integer (enteros [-32768, 32767], 2 bytes/celda)</li><li>uinteger (enteros [0, 65535], 2 bytes/celda)</li><li>long (enteros [-2147483648, 2147483647], 4 bytes/celda)</li><li>real (punto flotante ±3.4E±38, 4 bytes/celda)</li><li>double (punto flotante ±1.7E±308, 8 bytes/celda)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:TipoDato"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>bit</ows:Value>
						<ows:Value>byte</ows:Value>
						<ows:Value>byte-RLE</ows:Value>
						<ows:Value>integer</ows:Value>
						<ows:Value>integer-RLE</ows:Value>
						<ows:Value>uinteger</ows:Value>
						<ows:Value>uinteger-RLE</ows:Value>
						<ows:Value>long</ows:Value>
						<ows:Value>long-RLE</ows:Value>
						<ows:Value>real</ows:Value>
						<ows:Value>real-RLE</ows:Value>
						<ows:Value>double</ows:Value>
						<ows:Value>double-RLE</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SisRef</ows:Identifier>
				<ows:Title>Sistema de referencia</ows:Title>
				<ows:Abstract><![CDATA[Nombre del sistema de referencia espacial (proyección, dátum, etc). Si no se indica será <i>plane</i> por defecto.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:SisRef"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>plane</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RefUnit</ows:Identifier>
				<ows:Title>Unidades</ows:Title>
				<ows:Abstract><![CDATA[Unidades del sistema de referencia espacial. Cuando se indican deben ser las correspondientes al SisRef (típicamente "m" para proyecciones convencionales, o grados (°) para sistemas en longitud-latitud). Si el parámetro no se indica será <i>pixel</i> por defecto.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:RefUnit"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>pixel</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FDest</ows:Identifier>
				<ows:Title>Fichero destino</ows:Title>
				<ows:Abstract>Fichero IMG de salida</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:FDest"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ASCIIIMG:!Param10</ows:Identifier>
		<ows:Title>ASCIIIMG NO ENV</ows:Title>
		<ows:Abstract>En esta opción no se indica el ámbito ni el sistema de referencia. El número de filas y columnas que contiene el fichero ASCII se debe escribir manualmente, así como también el numero líneas de cabecera a saltar.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>reg</ows:Identifier>
				<ows:Title>Tamaño registro o delimitador</ows:Title>
				<ows:Abstract><![CDATA[Indica el tratamiento para los tres tipos principales de fichero ASCII:<ul><li>-1 (y menos de 6 parámetros) cuando se trata de un fichero ESRI ASCII.</li> 				<li> 0 cuando los valores están separados por un delimitador.</li> 				<li>n cuando indica el ancho en caracteres de cada celda para registro fijo.</li> 				<li>-n (y 6 o más parámetros) cuando se trata de un fichero ASCII estructurado por columnas, la n indica el número de columna a importar.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:reg"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FOri</ows:Identifier>
				<ows:Title>Fichero origen</ows:Title>
				<ows:Abstract>Fichero ASCII de entrada</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:FOri"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ncol</ows:Identifier>
				<ows:Title>Número de columnas</ows:Title>
				<ows:Abstract>Número de columnas del fichero ASCII.</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:ncol"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>nfil</ows:Identifier>
				<ows:Title>Número de filas</ows:Title>
				<ows:Abstract>Número de filas del fichero ASCII.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:nfil"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>nlin</ows:Identifier>
				<ows:Title>Número líneas saltar</ows:Title>
				<ows:Abstract>La cabecera del fichero ASCII se esquiva indicando el número de líneas que la constituye; se debe indicar cero (0) para ficheros sin cabecera.</ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:nlin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusDada</ows:Identifier>
				<ows:Title>Tipo de Dato</ows:Title>
				<ows:Abstract><![CDATA[Tipo de dato de salida: <ul><li>bit (entero [0,1], 1 bit/celda)</li><li>byte (enteros [0,255], 1 byte/celda)</li><li>integer (enteros [-32768, 32767], 2 bytes/celda)</li><li>uinteger (enteros [0, 65535], 2 bytes/celda)</li><li>long (enteros [-2147483648, 2147483647], 4 bytes/celda)</li><li>real (punto flotante ±3.4E±38, 4 bytes/celda)</li><li>double (punto flotante ±1.7E±308, 8 bytes/celda)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:TipoDato"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>bit</ows:Value>
						<ows:Value>byte</ows:Value>
						<ows:Value>byte-RLE</ows:Value>
						<ows:Value>integer</ows:Value>
						<ows:Value>integer-RLE</ows:Value>
						<ows:Value>uinteger</ows:Value>
						<ows:Value>uinteger-RLE</ows:Value>
						<ows:Value>long</ows:Value>
						<ows:Value>long-RLE</ows:Value>
						<ows:Value>real</ows:Value>
						<ows:Value>real-RLE</ows:Value>
						<ows:Value>double</ows:Value>
						<ows:Value>double-RLE</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ValorFons</ows:Identifier>
				<ows:Title>Valor fondo</ows:Title>
				<ows:Abstract>Valor correspondiente al sindatos de la imagen o "none" para no indicarlo.</ows:Abstract>
				<ows:Metadata xlink:title="Param08"/>
				<ows:Metadata xlink:title="Name:ValorFondo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DefValFons</ows:Identifier>
				<ows:Title>Definición Valor Fondo</ows:Title>
				<ows:Abstract>Definición del valor sindatos o "none" si no hay valor de fondo.</ows:Abstract>
				<ows:Metadata xlink:title="Param09"/>
				<ows:Metadata xlink:title="Name:DefValFondo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FDest</ows:Identifier>
				<ows:Title>Fichero destino</ows:Title>
				<ows:Abstract>Fichero IMG de salida</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:FDest"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ASCIIIMG:Param10</ows:Identifier>
		<ows:Title>ASCIIIMG ENV</ows:Title>
		<ows:Abstract>En esta opción se indica el ámbito ni sistema de referencia. El número de filas y columnas que contiene el fichero ASCII se debe escribir manualmente, así como también el numero líneas de cabecera a saltar.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>reg</ows:Identifier>
				<ows:Title>Tamaño registro o delimitador</ows:Title>
				<ows:Abstract><![CDATA[Indica el tratamiento para los tres tipos principales de fichero ASCII:<ul><li>-1 (y menos de 6 parámetros) cuando se trata de un fichero ESRI ASCII.</li> 				<li> 0 cuando los valores están separados por un delimitador.</li> 				<li>n cuando indica el ancho en caracteres de cada celda para registro fijo.</li> 				<li>-n (y 6 o más parámetros) cuando se trata de un fichero ASCII estructurado por columnas, la n indica el número de columna a importar.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:reg"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FOri</ows:Identifier>
				<ows:Title>Fichero origen</ows:Title>
				<ows:Abstract>Fichero ASCII de entrada</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:FOri"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ncol</ows:Identifier>
				<ows:Title>Número de columnas</ows:Title>
				<ows:Abstract>Número de columnas del fichero ASCII.</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:ncol"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>nfil</ows:Identifier>
				<ows:Title>Número de filas</ows:Title>
				<ows:Abstract>Número de filas del fichero ASCII.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:nfil"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>nlin</ows:Identifier>
				<ows:Title>Número líneas saltar</ows:Title>
				<ows:Abstract>La cabecera del fichero ASCII se esquiva indicando el número de líneas que la constituye; se debe indicar cero (0) para ficheros sin cabecera.</ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:nlin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusDada</ows:Identifier>
				<ows:Title>Tipo de Dato</ows:Title>
				<ows:Abstract><![CDATA[Tipo de dato de salida: <ul><li>bit (entero [0,1], 1 bit/celda)</li><li>byte (enteros [0,255], 1 byte/celda)</li><li>integer (enteros [-32768, 32767], 2 bytes/celda)</li><li>uinteger (enteros [0, 65535], 2 bytes/celda)</li><li>long (enteros [-2147483648, 2147483647], 4 bytes/celda)</li><li>real (punto flotante ±3.4E±38, 4 bytes/celda)</li><li>double (punto flotante ±1.7E±308, 8 bytes/celda)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:TipoDato"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>bit</ows:Value>
						<ows:Value>byte</ows:Value>
						<ows:Value>byte-RLE</ows:Value>
						<ows:Value>integer</ows:Value>
						<ows:Value>integer-RLE</ows:Value>
						<ows:Value>uinteger</ows:Value>
						<ows:Value>uinteger-RLE</ows:Value>
						<ows:Value>long</ows:Value>
						<ows:Value>long-RLE</ows:Value>
						<ows:Value>real</ows:Value>
						<ows:Value>real-RLE</ows:Value>
						<ows:Value>double</ows:Value>
						<ows:Value>double-RLE</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ValorFons</ows:Identifier>
				<ows:Title>Valor fondo</ows:Title>
				<ows:Abstract>Valor correspondiente al sindatos de la imagen o "none" para no indicarlo.</ows:Abstract>
				<ows:Metadata xlink:title="Param08"/>
				<ows:Metadata xlink:title="Name:ValorFondo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DefValFons</ows:Identifier>
				<ows:Title>Definición Valor Fondo</ows:Title>
				<ows:Abstract>Definición del valor sindatos o "none" si no hay valor de fondo.</ows:Abstract>
				<ows:Metadata xlink:title="Param09"/>
				<ows:Metadata xlink:title="Name:DefValFondo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>minx</ows:Identifier>
				<ows:Title>X mínima</ows:Title>
				<ows:Abstract>Definición de la X mínima de la envolvente de la imagen.</ows:Abstract>
				<ows:Metadata xlink:title="Param10"/>
				<ows:Metadata xlink:title="Name:minx"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>maxx</ows:Identifier>
				<ows:Title>X máxima</ows:Title>
				<ows:Abstract>Definición de la X máxima de la envolvente de la imagen.</ows:Abstract>
				<ows:Metadata xlink:title="Param11"/>
				<ows:Metadata xlink:title="Name:maxx"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>miny</ows:Identifier>
				<ows:Title>Y mínima</ows:Title>
				<ows:Abstract>Definición de la Y mínima de la envolvente de la imagen.</ows:Abstract>
				<ows:Metadata xlink:title="Param12"/>
				<ows:Metadata xlink:title="Name:miny"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>maxy</ows:Identifier>
				<ows:Title>Y máxima</ows:Title>
				<ows:Abstract>Definición de la Y máxima de la envolvente de la imagen.</ows:Abstract>
				<ows:Metadata xlink:title="Param13"/>
				<ows:Metadata xlink:title="Name:maxy"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>SisRef</ows:Identifier>
				<ows:Title>Sistema de referencia</ows:Title>
				<ows:Abstract><![CDATA[Nombre del sistema de referencia espacial (proyección, dátum, etc). Si no se indica será <i>plane</i> por defecto.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param14"/>
				<ows:Metadata xlink:title="Name:SisRef"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>plane</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RefUnit</ows:Identifier>
				<ows:Title>Unidades</ows:Title>
				<ows:Abstract><![CDATA[Unidades del sistema de referencia espacial. Cuando se indican deben ser las correspondientes al SisRef (típicamente "m" para proyecciones convencionales, o grados (°) para sistemas en longitud-latitud). Si el parámetro no se indica será <i>pixel</i> por defecto.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param15"/>
				<ows:Metadata xlink:title="Name:RefUnit"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>pixel</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FDest</ows:Identifier>
				<ows:Title>Fichero destino</ows:Title>
				<ows:Abstract>Fichero IMG de salida</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:FDest"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>