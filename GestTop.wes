<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestTop:param1:1</ows:Identifier>
		<ows:Title>Transformación de un fichero 3D a 2D.</ows:Title>
		<ows:Abstract>Transforma un vector 3D a 2D, eliminando su componente Z. Se debe tener en cuenta que para polígonos es necesario referirse al fichero de arcos.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Gestión de formatos vectoriales"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació agrupa un conjunt d&apos;eines i funcionalitats vectorials, fonamentalment formats estructurats i procediments topològics, però en algun cas també aspectes no estrictament topològics. Són procediments molt específics, que moltes vegades ja formen part d&apos;alguns dels algorismes dels diferents aplicaciós de tractament vectorial i topològic, però en determinades ocasions l&apos;usuari pot necessitar-los de forma individualitzada."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Transformación de un fichero 3D a 2D.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Arc3D</ows:Identifier>
				<ows:Title>Arc3D</ows:Title>
				<ows:Abstract>El fichero de arcos 3D que se va a transformar / transformado a 2D.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Arc3D"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Arc3D</ows:Identifier>
				<ows:Title>Arc3D</ows:Title>
				<ows:Abstract>El fichero de arcos 3D que se va a transformar / transformado a 2D.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Arc3D"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestTop:param1:2</ows:Identifier>
		<ows:Title>Unión de objectos VEC.</ows:Title>
		<ows:Abstract><![CDATA[Une objetos de un fichero VEC de arcos o polígonos que estén conectados, pero sin analizar ni fusionar posibles intersecciones. En este caso, sería necesario utilizar la aplicación <a href="linarc.htm">LinArc</a>.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Unión de objetos VEC.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>VectorOrigen</ows:Identifier>
				<ows:Title>Vector origen</ows:Title>
				<ows:Abstract>Vector al que se aplica el proceso. Si VectorDesti es el mismo que VectorOrigen, la transformación se realiza sobre el propio vector.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:VectorOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Atribut</ows:Identifier>
				<ows:Title>Atributo</ows:Title>
				<ows:Abstract>Es el atributo constante del VEC después de la unión de las posibles conexiones.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Atributo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_DECIMALS</ows:Identifier>
				<ows:Title>Número decimales.</ows:Title>
				<ows:Abstract>Número de cifras decimales escritas en las coordenadas del fichero de salida.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>VectorDesti</ows:Identifier>
				<ows:Title>Vector destino</ows:Title>
				<ows:Abstract>Vector de destino.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:VectorDestino"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestTop:param1:3</ows:Identifier>
		<ows:Title>Envolventes de los elementos de un vector topológico.</ows:Title>
		<ows:Abstract><![CDATA[Escribe la envolvente de cada objeto de un fichero de arcos o polígonos en 4 campos de la tabla principal denominados MINX, MAXX, MINY y MAXY. No se aplica a ficheros de puntos; en este caso, se debe utilizar <a href="PNTBD.htm">PntBd</a>.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Envolventes de los elementos de un vector topológico.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Vector</ows:Identifier>
				<ows:Title>Vector</ows:Title>
				<ows:Abstract>Fichero vectorial del que se escribirán las envolventes de cada objeto en los campos MINX, MAXX, MINY y MAXY de la tabla principal.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Vector"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Vector</ows:Identifier>
				<ows:Title>Vector</ows:Title>
				<ows:Abstract>Fichero vectorial del que se escribirán las envolventes de cada objeto en los campos MINX, MAXX, MINY y MAXY de la tabla principal.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Vector"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestTop:param1:4</ows:Identifier>
		<ows:Title>Estructuración de grupos de polígonos.</ows:Title>
		<ows:Abstract><![CDATA[Estructura topológicamente una capa de polígonos. Algunas aplicaciones de MiraMon, como DGN_MM o DXFVEC, generan capas que, por motivos de eficiencia, pueden no tener los grupos de polígonos estructurados topológicamente. Esta opción permite estructurar las capas de este origen para, generalmente, poder utilizarlas como entrada en otras aplicaciones que sí requieren esta estructuración. Para obtener más información sobre los grupos de polígonos y su estructuración, se puede consultar la aplicación <a href="Ciclar.htm">Ciclar</a>.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Estructuración de grupos de polígonos.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>4</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerPolOrig</ows:Identifier>
				<ows:Title>Fichero polígonos original</ows:Title>
				<ows:Abstract>Fichero original de polígonos no estructurados.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroPolOrig"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>AREA_MIN</ows:Identifier>
				<ows:Title>Area mínima</ows:Title>
				<ows:Abstract>Área mínima permitida para un polígono.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>AREA_PERI_MIN</ows:Identifier>
				<ows:Title>Área perímetro mínima</ows:Title>
				<ows:Abstract>Relación área/perímetro mínima permitida.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NEXE_CRITERIS</ows:Identifier>
				<ows:Title>Nexo criterios</ows:Title>
				<ows:Abstract>En caso de indicar ambos criterios, eliminar los polígonos que cumplan las dos condiciones a la vez (AND) o los que cumplan al menos una de ellas (OR). El valor por defecto es AND.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>AND</ows:Value>
						<ows:Value>OR</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>AND</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FONDRE</ows:Identifier>
				<ows:Title>Fundir</ows:Title>
				<ows:Abstract>Indica a qué polígono se asigna el espacio ocupado por el micropolígono que desaparece. Se debe indicar POL_GRAN si se desea asignar el espacio al polígono contiguo de mayor área. El valor por defecto es FRONTERA_MES_LLARGA, que significa que se elimina el arco más largo del micropolígono que desaparece.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>POL_GRAN</ows:Value>
						<ows:Value>FRONTERA_MES_LLARGA</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>FRONTERA_MES_LLARGA</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ATRIB_ELIM</ows:Identifier>
				<ows:Title>ATRIB_ELIM</ows:Title>
				<ows:Abstract>Indica que el polígono que absorbe el micropolígono eliminado hereda sus atributos. Su ausencia significa que los atributos del micropolígono se pierden. Cabe señalar que no es necesario indicar qué campo o campos definen si el polígono tiene atributos: se considera que el polígono no tiene atributos si todos los campos no geométrico-topológicos están vacíos, excepto, por supuesto, el CAMP_LOGIC_ARC si este criterio también está activado.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerPolDesti</ows:Identifier>
				<ows:Title>Ficher polígono destino</ows:Title>
				<ows:Abstract>Fichero de polígonos estructurados.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroPolDestino"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestTop:param1:5</ows:Identifier>
		<ows:Title>Marca topología verificada</ows:Title>
		<ows:Abstract>Marca la topología del fichero como verificada sin comprobar que realmente lo esté.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Marca la topología del fichero como verificada sin comprobar que realmente lo esté.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>5</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>5</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>VectorEstr</ows:Identifier>
				<ows:Title>Vector</ows:Title>
				<ows:Abstract>Fichero vectorial del que se escribirán las envolventes de cada objeto en los campos MINX, MAXX, MINY y MAXY de la tabla principal.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:VectorEstr"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>VectorEstr</ows:Identifier>
				<ows:Title>Vector</ows:Title>
				<ows:Abstract>Fichero vectorial del que se escribirán las envolventes de cada objeto en los campos MINX, MAXX, MINY y MAXY de la tabla principal.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:VectorEstr"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>