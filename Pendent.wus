<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Pendent:1</ows:Identifier>
		<ows:Title>Terrain analysis: slope, orientation, etc</ows:Title>
		<ows:Abstract>This program calculates, based on a Digital Elevation Model, a number of digital models (slope: MDP, orientation: MDO, etc) which are derived from the elevations and help to describe and to characterise the relief. </ows:Abstract>
		<ows:Metadata xlink:title="Title:Terrain analysis: slope, orientation, etc"/>
		<ows:Metadata xlink:title="Abstract:AThis program calculates, based on a Digital Elevation Model, a number of digital models (slope: MDP, orientation: MDO, etc) which are derived from the elevations and help to describe and to characterise the relief."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MDE</ows:Identifier>
				<ows:Title>Digital Elevation Model</ows:Title>
				<ows:Abstract>igital Elevation Model raster file
</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
			<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
					<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Tipus_analisi</ows:Identifier>
				<ows:Title>Analysi Type</ows:Title>
				<ows:Abstract>Option that indicates the choice of analysis to be carried out:<![CDATA[<li>1: Slope (°)</li><li>2: Slope (%)</li><li>4: Orientation (° + plane)</li><li>5: 4 orientations</li><li>6: 8 orientations</li><li>7: Curvature </li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
					<LiteralData>
					<ows:AllowedValues>
					<ows:Value>1</ows:Value>
					<ows:Value>2</ows:Value>
					<ows:Value>4</ows:Value>
					<ows:Value>5</ows:Value>
					<ows:Value>6</ows:Value>
					<ows:Value>7</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Number_neigh</ows:Identifier>
				<ows:Title>Number neighbours</ows:Title>
				<ows:Abstract>Can take values 4 or 8 depending on the number of neighbours to be used in the calculations related to the central pixel.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
					<LiteralData>
					<ows:AllowedValues>
					<ows:Value>4</ows:Value>
					<ows:Value>8</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PEN_PLA</ows:Identifier>
				<ows:Title>Flat slope</ows:Title>
				<ows:Abstract>For calculating orientation, allows the user to indicate the value of the slope below which the area is considered as flat (horizontal) and the orientation of that point undefined. The default value is 2°. To only consider perfectly flat surfaces as having no orientation it is necessary to set this parameter to 0°.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>	
				</LiteralData>
			</Input>
		</DataInputs>
			<ProcessOutputs>
					<Output>
					<ows:Identifier>Output</ows:Identifier>
					<ows:Title>Output</ows:Title>
					<ows:Abstract> Raster file containing the output from the terrain analysis</ows:Abstract>
					<ows:Metadata xlink:title="Param2"/>
					<ComplexOutput>
						<Default>
							<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Supported>
					</ComplexOutput>
				</Output>
			</ProcessOutputs>
		</ProcessDescription>
</wps:ProcessDescriptions>
