<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:0</ows:Identifier>
		<ows:Title>Informació de capçalera</ows:Title>
		<ows:Abstract>(Opció 0) Mostra metadades</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversió entre els formats ràster JPEG i IMG o BMP"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació converteix entre el format IMG de MiraMon o el format BMP (sense georeferència), al format JPEG amb metadades de MiraMon, o al format JPEG sense georeferència."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opcio</ows:Title>
				<ows:Abstract>Metadades</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>Fitxer JPEG</ows:Title>
				<ows:Abstract>És el nom del fitxer JPEG  del que es vol obtenir informació de les metadades.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerJPEG"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Stdout</ows:Identifier>
				<ows:Title>Estandar de sortida</ows:Title>
				<ows:Abstract>Informació de les metadades del fitxer JPEG.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:1&amp;!Param5</ows:Identifier>
		<ows:Title>IMG/BMP a JPEG</ows:Title>
		<ows:Abstract>(Opció 1) Pas de IMG/BMP a JPEG. En aquesta opció es transforma un BMP (FitxerIn), un IMG amb paleta de grisos (FitxerIn), un IMG amb paleta P25 (FitxerIn i FitxerP25) o una combinació RGB (FitxerR, FitxerG i FitxerB) a un unic fitxer JPEG (FitxerJPEG).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Conversió de fitxer IMG/BMP a JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerIn</ows:Identifier>
				<ows:Title>Fitxer Entrada</ows:Title>
				<ows:Abstract>És el nom del fitxer imatge que volem transformar.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerIn"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FitxerP25</ows:Identifier>
				<ows:Title>Fitxer P25</ows:Title>
				<ows:Abstract>És el nom de la paleta que s'utilitzara per representar el JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Name:FitxerP25"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALITAT</ows:Identifier>
				<ows:Title>Qualitat</ows:Title>
				<ows:Abstract>Qualitat de compressió en un rang [0,100], on [5,95] és el rang útil encara que en mots casos introduirem un valor entre 70 i 75 (per defecte és 75). Els valors baixos indiquen molt poca qualitat però molta compressió.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>100</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRISOS</ows:Identifier>
				<ows:Title>Grisos</ows:Title>
				<ows:Abstract>Crea un JPEG en escala de grisos: converteix un ràster color a escala de grisos (monocrom).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPTIMITZAT</ows:Identifier>
				<ows:Title>Optimitzat</ows:Title>
				<ows:Abstract>Optimitza la taula de Huffman (el fitxer serà més petit però la compressió serà més lenta).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PROGRESSIU</ows:Identifier>
				<ows:Title>Progressiu</ows:Title>
				<ows:Abstract>Crea un JPEG progressiu. Aquest tipus de JPG permet previsualització en les primeres fases de la descompressió.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DENOM_ESCALA</ows:Identifier>
				<ows:Title>Denominador de escala</ows:Title>
				<ows:Abstract>Denominador de l'escala a la qual voleu imprimir el JPEG o 0 si no ho voleu indicar. La informació sobre la mida de la cel·la del ràster més aquest paràmetre serveixen per guardar internament en el JPEG la mida del pixel de la imatge de sortida en unitats paper, com són les ppp (píxels per polzada).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_METADADES</ows:Identifier>
				<ows:Title>No metadades</ows:Title>
				<ows:Abstract>Indica que no voleu crea un fitxer de metadades associat al fitxer JPEG en base a les metadades dels fitxers IMG. Per defecte es crea. No aplica si el fitxer a transformar no és un IMG.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>Fitxer JPEG</ows:Title>
				<ows:Abstract>És el nom del fitxer JPEG  del que es vol obtenir informació de les metadades.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerJPEG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:2&amp;!Param5</ows:Identifier>
		<ows:Title>JPEG a IMG/BMP</ows:Title>
		<ows:Abstract>(Opció 2) Pas de JPEG a IMG/BMP: En aquesta opció es transforma un JPEG (FitxerJPEGs) a BMP (FitxerIn), a un IMG amb paleta de grisos (FitxerIn), a un IMG amb paleta P25 predefinida (FitxerIn i FitxerP25), a un IMG amb paleta P25 optimitzada (FitxerIn i FitxerP25), o a una combinació RGB (FitxerR, FitxerG, i FitxerB).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Conversió de fitxer JPEG a IMG/BMP.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>Fitxer JPEG</ows:Title>
				<ows:Abstract>És el nom del fitxer JPEG  del que es vol obtenir informació de les metadades.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerJPEG"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FitxerP25</ows:Identifier>
				<ows:Title>Fitxer P25</ows:Title>
				<ows:Abstract>És el nom de la paleta que s'utilitzara per representar el JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Name:FitxerP25"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NCOLORS</ows:Identifier>
				<ows:Title>Nombre de colors</ows:Title>
				<ows:Abstract>orça una reducció de l'espai de colors a un nombre de colors limitat a n. Aquest serà el nombre final de colors a la paleta si demaneu IMG+paleta optimitzada.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MAP_PAL</ows:Identifier>
				<ows:Title>Paleta determinada</ows:Title>
				<ows:Abstract>Força l'espai de color a una paleta determinada. Noteu que si indiqueu aquest paràmetre, la paleta indicada és llegida del disc. De no indicar aquest paràmetre l'aplicació escriu al disc una paleta optimitzada per aquesta imatge en concret.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_SUAVIZAT</ows:Identifier>
				<ows:Title>No suavitzat</ows:Title>
				<ows:Abstract>Permet no fer el pas de suavitzat de mesures que millora el resultat final.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>1PAS</ows:Identifier>
				<ows:Title>Un sol pas</ows:Title>
				<ows:Abstract>Usar un sol pas de quantització. El resultat s'obté més ràpidament però té més baixa qualitat. Requereix menys memòria.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ESCALAT</ows:Identifier>
				<ows:Title>Escala</ows:Title>
				<ows:Abstract>m/n Escalat de sortida expressat en una fracció m/n, p.ex: 1/8. Aquest paràmetre resulta útil quan la imatge, un cop descomprimida, resultaria inacceptablement gran.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FWORLD</ows:Identifier>
				<ows:Title>Fitxer World</ows:Title>
				<ows:Abstract>Generar un fitxer world de l'extensió indicada.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerIMGBMP</ows:Identifier>
				<ows:Title>Fitxer IMG/BMP</ows:Title>
				<ows:Abstract>És el nom del fitxer IMG que volem trasnformar a JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:3&amp;!Param5</ows:Identifier>
		<ows:Title>IMG/BMP a JPEG Indexat</ows:Title>
		<ows:Abstract>(Opció 3)Pas de IMG/BMP a JPEG Indexat. En aquesta opció es transforma un BMP (FitxerIn), un IMG amb paleta de grisos (FitxerIn), un IMG amb paleta P25 (FitxerIn i FitxerP25) o una combinació RGB (FitxerR, FitxerG i FitxerB) a un unic fitxer JPEG Indexat (FitxerJPEG).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Conversió de fitxer IMG/BMP a JPEG indexat.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerIMGBMP</ows:Identifier>
				<ows:Title>Fitxer IMG/BMP</ows:Title>
				<ows:Abstract>És el nom del fitxer IMG que volem trasnformar a JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FitxerP25</ows:Identifier>
				<ows:Title>Fitxer P25</ows:Title>
				<ows:Abstract>És el nom de la paleta que s'utilitzara per representar el JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Name:FitxerP25"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALITAT</ows:Identifier>
				<ows:Title>Qualitat</ows:Title>
				<ows:Abstract>Qualitat de compressió en un rang [0,100], on [5,95] és el rang útil encara que en mots casos introduirem un valor entre 70 i 75 (per defecte és 75). Els valors baixos indiquen molt poca qualitat però molta compressió.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>100</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_METADADES</ows:Identifier>
				<ows:Title>No metadades</ows:Title>
				<ows:Abstract>Indica que no voleu crea un fitxer de metadades associat al fitxer JPEG en base a les metadades dels fitxers IMG. Per defecte es crea. No aplica si el fitxer a transformar no és un IMG.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FWORLD</ows:Identifier>
				<ows:Title>Fitxer World</ows:Title>
				<ows:Abstract>Generar un fitxer world de l'extensió indicada.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NFIL_PAQUET</ows:Identifier>
				<ows:Title>Previsualització</ows:Title>
				<ows:Abstract>Nombre de files de cada paquet indexat. Es recomana que sigui superior a 64.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUICKLOOK</ows:Identifier>
				<ows:Title>Quicklook</ows:Title>
				<ows:Abstract>Imatge petita que Windows ensenya com a previsualització i que tots els programes de processament d'imatges obriràn donat que no saben llegir el format JPEG indexat de MiraMon. Pot no indicar-se i en aquest cas Windows i els altres programes mostraran només el primier paquet de files de la imatge.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>Fitxer JPEG</ows:Title>
				<ows:Abstract>És el nom del fitxer JPEG  del que es vol obtenir informació de les metadades.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerJPEG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:1&amp;Param5</ows:Identifier>
		<ows:Title>IMG/BMP Multibanda a JPEG</ows:Title>
		<ows:Abstract>(Opció 1) Pas de IMG/BMP a JPEG. En aquesta opció es transforma un BMP (FitxerIn), un IMG amb paleta de grisos (FitxerIn), un IMG amb paleta P25 (FitxerIn i FitxerP25) o una combinació RGB (FitxerR, FitxerG i FitxerB) a un unic fitxer JPEG (FitxerJPEG).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Conversió de fitxer IMG/BMP a JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerR</ows:Identifier>
				<ows:Title>Fitxer Vermell</ows:Title>
				<ows:Abstract>Fitxer de la banda del vermell</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerG</ows:Identifier>
				<ows:Title>Fitxer Verd</ows:Title>
				<ows:Abstract>Fitxer de la banda del verd</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerB</ows:Identifier>
				<ows:Title>Fitxer Blau</ows:Title>
				<ows:Abstract>Fitxer de la banda del blau</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALITAT</ows:Identifier>
				<ows:Title>Qualitat</ows:Title>
				<ows:Abstract>Qualitat de compressió en un rang [0,100], on [5,95] és el rang útil encara que en mots casos introduirem un valor entre 70 i 75 (per defecte és 75). Els valors baixos indiquen molt poca qualitat però molta compressió.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>100</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRISOS</ows:Identifier>
				<ows:Title>Grisos</ows:Title>
				<ows:Abstract>Crea un JPEG en escala de grisos: converteix un ràster color a escala de grisos (monocrom).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPTIMITZAT</ows:Identifier>
				<ows:Title>Optimitzat</ows:Title>
				<ows:Abstract>Optimitza la taula de Huffman (el fitxer serà més petit però la compressió serà més lenta).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PROGRESSIU</ows:Identifier>
				<ows:Title>Progressiu</ows:Title>
				<ows:Abstract>Crea un JPEG progressiu. Aquest tipus de JPG permet previsualització en les primeres fases de la descompressió.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DENOM_ESCALA</ows:Identifier>
				<ows:Title>Denominador de escala</ows:Title>
				<ows:Abstract>Denominador de l'escala a la qual voleu imprimir el JPEG o 0 si no ho voleu indicar. La informació sobre la mida de la cel·la del ràster més aquest paràmetre serveixen per guardar internament en el JPEG la mida del pixel de la imatge de sortida en unitats paper, com són les ppp (píxels per polzada).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_METADADES</ows:Identifier>
				<ows:Title>No metadades</ows:Title>
				<ows:Abstract>Indica que no voleu crea un fitxer de metadades associat al fitxer JPEG en base a les metadades dels fitxers IMG. Per defecte es crea. No aplica si el fitxer a transformar no és un IMG.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>Fitxer JPEG</ows:Title>
				<ows:Abstract>És el nom del fitxer JPEG  del que es vol obtenir informació de les metadades.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerJPEG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:2&amp;Param5</ows:Identifier>
		<ows:Title>JPEG a IMG/BMP MultiBanda</ows:Title>
		<ows:Abstract>(Opció 2)Pas de JPEG a IMG/BMP: En aquesta opció es transforma un JPEG (FitxerJPEGs) a BMP (FitxerIn), a un IMG amb paleta de grisos (FitxerIn), a un IMG amb paleta P25 predefinida (FitxerIn i FitxerP25), a un IMG amb paleta P25 optimitzada (FitxerIn i FitxerP25), o a una combinació RGB (FitxerR, FitxerG, i FitxerB).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Conversió de fitxer JPEG a IMG/BMP.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>Fitxer JPEG</ows:Title>
				<ows:Abstract>És el nom del fitxer JPEG  del que es vol obtenir informació de les metadades.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerJPEG"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NCOLORS</ows:Identifier>
				<ows:Title>Nombre de colors</ows:Title>
				<ows:Abstract>orça una reducció de l'espai de colors a un nombre de colors limitat a n. Aquest serà el nombre final de colors a la paleta si demaneu IMG+paleta optimitzada.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MAP_PAL</ows:Identifier>
				<ows:Title>Paleta determinada</ows:Title>
				<ows:Abstract>Força l'espai de color a una paleta determinada. Noteu que si indiqueu aquest paràmetre, la paleta indicada és llegida del disc. De no indicar aquest paràmetre l'aplicació escriu al disc una paleta optimitzada per aquesta imatge en concret.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_SUAVIZAT</ows:Identifier>
				<ows:Title>No suavitzat</ows:Title>
				<ows:Abstract>Permet no fer el pas de suavitzat de mesures que millora el resultat final.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>1PAS</ows:Identifier>
				<ows:Title>Un sol pas</ows:Title>
				<ows:Abstract>Usar un sol pas de quantització. El resultat s'obté més ràpidament però té més baixa qualitat. Requereix menys memòria.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ESCALAT</ows:Identifier>
				<ows:Title>Escala</ows:Title>
				<ows:Abstract>m/n Escalat de sortida expressat en una fracció m/n, p.ex: 1/8. Aquest paràmetre resulta útil quan la imatge, un cop descomprimida, resultaria inacceptablement gran.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FWORLD</ows:Identifier>
				<ows:Title>Fitxer World</ows:Title>
				<ows:Abstract>Generar un fitxer world de l'extensió indicada.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerR</ows:Identifier>
				<ows:Title>Fitxer Vermell</ows:Title>
				<ows:Abstract>Fitxer de la banda del vermell</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxerG</ows:Identifier>
				<ows:Title>Fitxer Verd</ows:Title>
				<ows:Abstract>Fitxer de la banda del verd</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxerB</ows:Identifier>
				<ows:Title>Fitxer Blau</ows:Title>
				<ows:Abstract>Fitxer de la banda del blau</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:3&amp;Param5</ows:Identifier>
		<ows:Title>IMG/BMP Multibanda JPEG Indexat</ows:Title>
		<ows:Abstract>(Opció 3) Pas de IMG/BMP a JPEG Indexat. En aquesta opció es transforma un BMP (FitxerIn), un IMG amb paleta de grisos (FitxerIn), un IMG amb paleta P25 (FitxerIn i FitxerP25) o una combinació RGB (FitxerR, FitxerG i FitxerB) a un unic fitxer JPEG Indexat (FitxerJPEG).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Conversió de fitxer IMG/BMP a JPEG indexat.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerR</ows:Identifier>
				<ows:Title>Fitxer Vermell</ows:Title>
				<ows:Abstract>Fitxer de la banda del vermell</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerG</ows:Identifier>
				<ows:Title>Fitxer Verd</ows:Title>
				<ows:Abstract>Fitxer de la banda del verd</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerB</ows:Identifier>
				<ows:Title>Fitxer Blau</ows:Title>
				<ows:Abstract>Fitxer de la banda del blau</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALITAT</ows:Identifier>
				<ows:Title>Qualitat</ows:Title>
				<ows:Abstract>Qualitat de compressió en un rang [0,100], on [5,95] és el rang útil encara que en mots casos introduirem un valor entre 70 i 75 (per defecte és 75). Els valors baixos indiquen molt poca qualitat però molta compressió.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>100</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_METADADES</ows:Identifier>
				<ows:Title>No metadades</ows:Title>
				<ows:Abstract>Indica que no voleu crea un fitxer de metadades associat al fitxer JPEG en base a les metadades dels fitxers IMG. Per defecte es crea. No aplica si el fitxer a transformar no és un IMG.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FWORLD</ows:Identifier>
				<ows:Title>Fitxer World</ows:Title>
				<ows:Abstract>Generar un fitxer world de l'extensió indicada.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NFIL_PAQUET</ows:Identifier>
				<ows:Title>Previsualització</ows:Title>
				<ows:Abstract>Nombre de files de cada paquet indexat. Es recomana que sigui superior a 64.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUICKLOOK</ows:Identifier>
				<ows:Title>Quicklook</ows:Title>
				<ows:Abstract>Imatge petita que Windows ensenya com a previsualització i que tots els programes de processament d'imatges obriràn donat que no saben llegir el format JPEG indexat de MiraMon. Pot no indicar-se i en aquest cas Windows i els altres programes mostraran només el primier paquet de files de la imatge.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>Fitxer JPEG</ows:Title>
				<ows:Abstract>És el nom del fitxer JPEG  del que es vol obtenir informació de les metadades.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerJPEG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>