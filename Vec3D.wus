<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:vec3d:1</ows:Identifier>
		<ows:Title>Vec3d</ows:Title>
		<ows:Abstract>This program incorporates the third dimension into unstructured vector files and PNT or ARC files based on the Digital Elevation Model (DEM) of the area. The POL and NOD files acquire the third dimension when the linked ARC files are ARC 3D.</ows:Abstract>
<ows:Metadata xlink:title="Title:Include the 3rd dimension in vector files" />
<ows:Metadata xlink:title="Abstract:This program incorporates the third dimension into unstructured vector files and PNT or ARC files based on the Digital Elevation Model (DEM) of the area. The POL and NOD files acquire the third dimension when the linked ARC files are ARC 3D. " />
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Option</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract><![CDATA[<li>1. Adds 3D information to the preexisting vertices</li><li>2. Enriches with new vertices and adds 3D information (arc files only).</li>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DEMFile</ows:Identifier>
				<ows:Title>DEMFile</ows:Title>
				<ows:Abstract>Is the name of the DEM raster.</ows:Abstract>
						<ows:Metadata xlink:title="Param2" />
					<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>InputFile</ows:Identifier>
				<ows:Title>Input File</ows:Title>
				<ows:Abstract>is the input 2D or 3D vector file (*.VEC, *.PNT, *.ARC).</ows:Abstract>
						<ows:Metadata xlink:title="Param3" />
					<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
								<Format>
								<MimeType>application/x-PNT</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
								<Format>
								<MimeType>application/x-ARC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-POL</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ModeInterpol</ows:Identifier>
				<ows:Title>ModeInterpol</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>0: Nearest neighbour. No interpolation; select nearest neighbour.</li><li>1: Bilinear interpolation (4 neighbours).</li><li>2: Bicubic interpolation (16 neighbours).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param5" />
				<LiteralData>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>N_DECIMALS</ows:Identifier>
				<ows:Title>Numero de decimals</ows:Title>
				<ows:Abstract>Is the number of decimal places written in the output file; default value 6. Only applied when the output, OutputFile, is VEC type file.</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
						<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>OutputFile</ows:Identifier>
				<ows:Title>Output File</ows:Title>
				<ows:Abstract>Is the name of the 3D output vector file. This may be the same as the input file name and must have the same format.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param4" />
						<ComplexOutput>
							<Default>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-PNT</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					<Format>
							<MimeType>application/x-ARC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-POL</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
							</Supported>
						</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
