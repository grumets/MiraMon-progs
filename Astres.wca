<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Astres:1</ows:Identifier>
		<ows:Title>Astres: Obtenció de l'azimut i l'altura del Sol a un lloc, data i hora de la Terra</ows:Title>
		<ows:Abstract>Aquest programa permet saber, donat un punt de la Terra en coordenades geogràfiques un dia de l'any i l'hora solar local o UTC, l'azimut i l'altura del Sol.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Obtenció de l&apos;azimut i l&apos;altura del Sol a un lloc, data i hora de la Terra"/>
		<ows:Metadata xlink:title="Abstract:Aquest programa permet saber, donat un punt de la Terra en coordenades geogràfiques un dia de l&apos;any i l&apos;hora solar local o UTC, l&apos;azimut i l&apos;altura del Sol."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>longitud</ows:Identifier>
				<ows:Title>Longitud</ows:Title>
				<ows:Abstract>Longitud en coordenades geogràfiques.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:longitud"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>latitud</ows:Identifier>
				<ows:Title>Latitud</ows:Title>
				<ows:Abstract>Latitud en coordenades geogràfiques.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:latitud"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>dia</ows:Identifier>
				<ows:Title>Dia</ows:Title>
				<ows:Abstract>Dia del mes, expressat amb un nombre de l'1 al 31.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:dia"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>6</ows:Value>
						<ows:Value>7</ows:Value>
						<ows:Value>8</ows:Value>
						<ows:Value>9</ows:Value>
						<ows:Value>10</ows:Value>
						<ows:Value>11</ows:Value>
						<ows:Value>12</ows:Value>
						<ows:Value>13</ows:Value>
						<ows:Value>14</ows:Value>
						<ows:Value>15</ows:Value>
						<ows:Value>16</ows:Value>
						<ows:Value>17</ows:Value>
						<ows:Value>18</ows:Value>
						<ows:Value>19</ows:Value>
						<ows:Value>20</ows:Value>
						<ows:Value>21</ows:Value>
						<ows:Value>22</ows:Value>
						<ows:Value>23</ows:Value>
						<ows:Value>24</ows:Value>
						<ows:Value>25</ows:Value>
						<ows:Value>26</ows:Value>
						<ows:Value>27</ows:Value>
						<ows:Value>28</ows:Value>
						<ows:Value>29</ows:Value>
						<ows:Value>30</ows:Value>
						<ows:Value>31</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>mes</ows:Identifier>
				<ows:Title>Mes</ows:Title>
				<ows:Abstract>Mes de l'any, expressat amb un nombre de l'1 al 12.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:mes"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>6</ows:Value>
						<ows:Value>7</ows:Value>
						<ows:Value>8</ows:Value>
						<ows:Value>9</ows:Value>
						<ows:Value>10</ows:Value>
						<ows:Value>11</ows:Value>
						<ows:Value>12</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>any</ows:Identifier>
				<ows:Title>Any</ows:Title>
				<ows:Abstract>Any, expressat amb un nombre tipus 2013.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:any"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>hora</ows:Identifier>
				<ows:Title>Hora</ows:Title>
				<ows:Abstract>El temps s'expressa en hores; 10:45 s'indica 10.75. Per defecte es considera hora solar local, però pot ser en UTC si s'indica el paràmetre /UTC.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:hora"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>UTC</ows:Identifier>
				<ows:Title>Temps Universal Coordinat</ows:Title>
				<ows:Abstract>Quan l'hora indicada és UTC. En la seva absència l'hora es considera hora solar local.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>StdOut</ows:Identifier>
				<ows:Title>Azimut i Altura</ows:Title>
				<ows:Abstract>Azimut o angle del Sol respecte al nord en sentit horari i altura o angle d'elevació del Sol respecte a l'horitzontal.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>