;==========================================================================
; Miramon: Parameters file
;==========================================================================
;==========================================================================
; This file must be in the disk and directory indicated in the "Working
; Directory" box of the "Properties of the program" (select the program
; icon and execute "Alt+Return" or choose "File/Properties..." in the
; Program Manager menu).

; In this file, comments are lines that begin with a semicolon(;).

;==========================================================================



;==========================================================================
[MiraMon]
;==========================================================================
; MAIN SECTION
;==========================================================================

; Corporative MiraMon: 
;cfg_corporativa=
;msg_queixa_grup=
;info_grup=
;path_log=


; Size of the window when the program starts: 0=Normal 1=Maximized
MaxIni=1

; Default background color of the client area
; This parameter can be changed during the session by choosing 
; the appropriate option of the "View" menu.
; 41 = WHITE       -> (R,G,B) = (255,255,255)
; 42 = LIGHT GRAY  -> (R,G,B) = (192,192,192)
; 43 = GRAY        -> (R,G,B) = (128,128,128)
; 44 = DARK GRAY   -> (R,G,B) = ( 64, 64, 64)
; 45 = BLACK       -> (R,G,B) = (  0,  0,  0)
ColorFonsInit=41

; Directory where, by default, images and vectors you want to
; display will be searched.
ImgDir=C:\maps

; Directories where MiraMon explores the files defining favorite collections
CollecDir1=C:\maps\FavoriteCollections
;CollecDir2=
;CollecDir3=
;...

; HTML page to be displayed as an alternative to the pages of the Journal of versions,
; Users Forum (FUM) and Twiter of MiraMon. Typically used to show corporate information
; (latest news in the intranet of a public administration, guidance for students in a classroom, etc).
;PaginaHTM_AlternativaPresentacio=

; Directory where, by default, color palettes will be searched.
PalDir=Palettes

; Extension used, by default, when the color palettes are searched:
;       0=*.PAL         Palettes of    64 levels for each RGB color gun
;       1=*.P25         Palettes of   256 levels for each RGB color gun 
;       2=*.P65         Palettes of 65536 levels for each RGB color gun
; This extension will apear as a a secondary option on the drop-down box of the
; file explorer window, always after symbolization tables of version 4.
PalExt=1

; Directory where, by default, symbols (EMF and WMF) will be searched.
SimbolDir=Symbols

; Directory where, by default, patterns will be searched
PatroDir=Patterns

; Directory where, by default, printing and metadata export templates 
; will be searched.
PlantillaDir=Template

; User templates for printing. It is assumed that they are in
; the "PlantillaDir=" directory.
;PlantillaVerticUsuari=User_Vert.mmm
;PlantillaHoritzUsuari=User_Hori.mmm
PlantillaVerticUsuari=
PlantillaHoritzUsuari=

; Number of decimal figures in the map coordinates shown on the
; screen. It must be in the [0, 15] interval. Default value: 2
DigitsDecimals=2

; Number of decimal figures in the long/lat coordinates shown on the
: screen It must be in the [0, 15] interval. Default value: 4
;DigitsDecimalsLonLat=4

; Number of decimal figures shown in the queries by location of floating point rasters, and in the
; statistics of the queries by attributes.
; It must be in the [0, 15] interval. Default value: 4
;DigitsDecimalsConsultEstad=4

; State of the Coordinates Box: 0=Not visible  1=Visible.
; This parameter can be changed during the session by choosing 
; "Show Coords." in the "Information" menu or by pressing F6.
MostrarCoordenades=0

; Position and dimensions of the Coordinates Box:
;   XCaixaCoord, YCaixaCoord * coordinates of the upper left vertex
;                            of the box, related to the upper left vertex
;                            of the screen.
;   AmpleCaixaCoord          * width of the box.
; All 3 values must be expressed in screen pixels.
; YCaixaCoord=448 ->Win 3.x; 640x480
XCaixaCoord=100
YCaixaCoord=425
AmpleCaixaCoord=550

; Visualitzation of map coordinates in several information windows
; 1: show (default value) 0: hide
;MostrarCoordMapa=1;

; Visualitzation of long/lat coordinates in several information windows
; 1: show (default value) 0: hide
;MostrarCoordLonLat=1

; Order in which the longitude/latitude coordinates are displayed in several information windows.
; 0: show in order Longitude Latitude (default value)
; 1: show in order Latitude Longitude
;OrdreMostrarCoordLongLat=0

; Long/Lat coordinates format
; 1 : show in degrees minutes seconds (° ' ''); 0: show in degrees (°)
;FormatLonLatGMS=1

; State of legend: 0=Not visible; 1=Visible
;MostrarLlegenda=0

; State of the Zoom Bar: 0=Not visible  1=Visible (default value).
; This parameter can be changed during the session by choosing 
; "View | Environment" or from the "Zoom" menu.
;MostrarBarraZoom=0

; Position of the Zoom Bar
; XBarraZoom, YBarraZoom are the coordinates of the upper left vertex of the box,
; in screen pixels
; Default values: XBarraZoom=0 and YBarraZoom=128
;XBarraZoom=100
;YBarraZoom=428

; State of the Toolbar (buttons bar): 0=Not visible  1=Visible.
; This parameter can be changed during the session by choosing 
; "Show buttons bar" in the "Help" menu.
MostrarBarraBotons=1

; With the following parameter we determine if the numerical color
; index corresponding to each category will precede the value or
; the category name in the window that shows the legend: 0=No (default value) 1=Yes.
; This parameter substitutes the old MostrarAtributLlegenda
MostrarIndColLleg=0

; Radius of representation of point vectors, expressed in screen pixels.
; This value must be >=0
RadiPnt=1

; Show link indices to relational fields in the legend
;MostrarIndEnllacCat=0;				

; Default options when opening the first polygon file.
; "PolTransparent" indicates whether to fill the polygon or no.
; 0=No  1=Yes
PolTransparent=1

; When a file contains flag values, you can reserve the last palette entry
; as the color for the pixels or entities marked with that flag value
; 0=No  1=Yes
UsarUltimColorPaletaComFlagValue=0

; Radius to draw point entities lacking of database record or
; having empty (blank) the field indexing the radius.
; This value must be >=0
RadiObjectesSenseAtribut=1

; Width to draw line entities lacking of database record or
; having empty (blank) the field indexing the width.
; This value must be >=0
GruixObjectesSenseAtribut=1.0

; Color to draw entities lacking of database record or
; having empty (blank) the field indexing the color.
; An (R,G,B) value must be indicated. Remember that each R,G,B component
; must be inside the [0, 255] range.
ColorObjectesSenseAtribut=(0,0,0)

; When a file is a part of a cartographic series and it is saved into a map,
; you have the chance of maintain its links with the series regarding visualization
; and legend or to save the current characteristics in the map file.
; 0=Do not preserve links to cartographic series  1=Maintain them
MantenirSeriesCartografiquesEnMMM=1

; Prior to show complete information after a query by location on vectors,
; MiraMon shows a little box allowing "continue searching" or "cancel": 0=No  1=Yes
; This parameter can be changed during the session through the
; "Information" menu.
PreInfoBox=0

; Initial position and dimensions of the box resulting from a query by location on vectors.
; This parameter can be changed during the session through the corners or the edges of the box itself.
; All 4 values (X,Y,Width,Height) must be expressed in screen pixels. If some value 
; exceeds the screen resolution, MiraMon will adapt it to a valid one.
MidaCaixaConLoc=50,77,547,604

; (R,G,B) color to highlight selected elements. If you indicate (-1,-1,-1),
; the color is determined by MiraMon to get an optimum display.
; If you indicate any other valid RGB combination (always within [0, 255]),
; you will get this color as a constant color for selections; for
; example, to obtain selections in red set:
; ColorSeleccio= (255,0,0)
; to obtain selections in white set:
; ColorSeleccio= (255,255,255)
; This parameter can be changed during the session through the
; "View" menu.
ColorSeleccio=(-1,-1,-1)

; After a query by location, it can be convenient to redraw the whole
; screen to avoid artifacts as polygons overlaying points, etc.
; If you indicate 0 (default value), this redrawing will not be effective
; (this is the fastest option, but you may visually appreciate the problem
; just explained and then you need to force a screen refresh trough the
; brush button of the toolbar (buttons bar) or through "View | Redraw";
; if you indicate 1, a complet redraw is done each time you close the
; query by location dialog box.
;RedibuixaDespresDeConsultaLocalit=1

; This parameter indicates whether in the print design dialog box redrawing will be done
; automatically (option 1) or will be done under user request via the corresponding button or
; via F5 (option 0, the default behavior and the classical one).
;RedibAutomPrevisImpr=1

; The following variable sets which information you wish to show 
; when querying by location on structured vectors. Variable
; "ParamInfoConsultaLocalitz" can be composed by ine or more of these
; informations:
;    Titol           : Descriptive title of the file being queried
;    NomFitxer       : Name of the file being queried (also shows the
;                      full path)
;    TipusFitxer     : File type (points, polygons, etc)
;    Visualitzacio   : Display characteristics (color, etc)
;    Posicio_XY      : X,Y position of the query; place in the vector entity
;                      (final or interm. vertex, interior of polygons, etc)
;    LongitudArcs    : Length of lines and arcs
;    PeriAreaPoligs  : Perimetre and area of polygons
;    AltresGeomTopol : Other geometrical and topological information (number
;                      of elementary polygons, from/to arc nodes, etc)
;    InfoBasesDades  : Information about the databases (number of graphical
;                      elements, number of records, etc)
;    BaseDadesAlfan  : Information contained in the fields of the
;                      alphanumerical database
; During program execution you can change these settings through the
; "+/- Information..." button, located in the query by location box.
; The variable is set simply by typing the desired information, for ex.
; ParamInfoConsultaLocalitz=Titol Posicio_XY BaseDadesAlfan
ParamInfoConsultaLocalitz=Titol NomFitxer Posicio_XY LongitudArcs PeriAreaPoligs BaseDadesAlfan

; How to show links broken by NODATA values
; si 1: show blank 
; si 2: show the field with the broken link
;ComMostrarEnllacosTrencatsPerNODATA=1

; Who manage raster zooms: MiraMon or Windows
; This parameter can be changed during the session through the "Zoom" menu.
; Note: This key is purely related to the computer management of the zooms in the case
; of raster files and should not be confused with the key ModeGestioZoom in section [METRICA].
GestZoom=MiraMon

; MiraMon acoustically informs you if it cannot redraw.
; This parameter can be changed during the session through the
; "View" menu.
; 0=No  1=Yes
AvisaErrorRed=0

; Ignore changes in file attributes.
; This option is useful under Windows 3.1x when accessing data located
; on a network server, because sometimes you get false warnings
; about unavailability of accessing file attributes. Nevertheless, if
; you this option is ON (1), MiraMon will not detect if some change occurred
; in graphic (ARC, POL,...) or tabular (DBF) files during the current
; working session (for example, because some other user in the net has
; modified your DBF file or because you are rebuiding topology) and this
; can result on an incorrect running of MiraMon.
; Under Windows 9x or NT this option must be OFF (0) to ensure an optimum
; program running (i.e., it will detect any changes in the files you are
; working on).
; This parameter can be changed during the session through the
; "View | Special" menu.
; 0=No  1=Yes
IgnorarCanvisAtributsHoraDataMida=0

; Reports or asks regarding the reload when MiraMon detects files that have changed in the attributes, time, date and/or size. 
; The default recommended value of 1, that explicitly informs or asks the user about the changes. 
; If you do not want to receive the message, but always prudently to reload, enter a value of 0. 
; If you do not want to receive the message, but only recharge when the changes are in size, specify a value of 2. This option should only be 
; set by expert users. 
;InformaRecarregaFitxersModif = 0
InformaRecarregaFitxersModif=1

; Character set to be used for plain text files (TXT, REL, DVC, etc).
; This parameter can be changed during the session through the
; "Information" menu.
; 1252=Windows ANSI (US, Western Europe)
;  850=DOS OEM-850  (MS-DOS Multilingual, Latin I)
JocCaracTXTPerDefecte=1252

; Character set to be used for character fields of database files (DBF)
; when the character set is not specified in the DBF or it is not supported
; by MiraMon.
; This parameter can be changed during the session through the
; "Information" menu.
; 1252=Windows ANSI (US, Western Europe)
;  850=DOS OEM-850  (MS-DOS Multilingual, Latin I)
JocCaracDBFPerDefecte=850

; When during digitizing an object is copied, you can highlight it or
; not (so it is showed with its final color).
; This parameter can be changed during the session through the
; "Edit" menu.
; 0=No highlighting   1=Yes
MarcaObjecteCopiat=1

; When digitizing explicit polygons, MiraMon will ask you
; if you want to add a new polygon, to define a hole in a pre-existing polygon, or
; to ask which of the two options do you want, which is the default option (0).
; 0=Ask 1=Add polygon 2=Define a hole
;DefineixForatCreaPoligonOPregunta=2

; Initial position and dimensions of the Legend Box:
; All 4 values (X,Y,Width,Height) must be expressed in screen pixels.
PosicioDimensioLlegenda=476,9,152,456

; Allows ignoring the existence of the key "MostrarLlegenda=" on maps,
; causing the legend to be always visible (value 1). Default value is 0.
; IgnorarMostrarLlegenda=1
IgnorarMostrarLlegenda=0

; Number of steps of digitizing/editing between backups.
; This parameter also controls the balance between time spent on backup
; and speed to undo (Ctrl+Z).
; Examples: 0 implies no backup, and therefore undo will not be allowed.
; 1 (not recommended) performs a backup at each operation of digitizing/editing, and the
; undo rate is highest.
; The default value is 20. A higher value means that the process of digitizing/editing
; is considerably faster if the layer being edited is very large (in the graphic part
; and/or in its database) or is in a computer resource of slow access; nevertheless,
; less backup copies will be done and undo operations will be slower because they have
; to regenerate a more complex situation.
NPassosEntreCopiesEnDigit=20

; Show digitizing toolbar when starting digitizing . 0=No  1=Yes (default value)
; MostrarBarraEinesDigit=0
MostrarBarraEinesDigit=1

; Continuos connexion while digitizing. 0=No  1=Yes (default value)
; F3Continu=0
F3Continu=1

; Default colors to inform that a connexion in F3Continu mode has been done:
ColorVertexFinal_F3Continu=(255,0,0)
ColorVertexIntermedi_F3Continu=(255,255,0)
ColorVertexNou_F3Continu=(0,255,255)

; Default radius and thickness to inform that a connexion in F3Continu mode has been done:
Radi_F3Continu=7
Gruix_F3Continu=2

; Default exageration applying to point radius and line widths when printing
ExageraRadi_i_Gruix=3

; Request confirmation before leaving MiraMon
; 0=No  1=Yes
ConfirmacioSortirMiraMon=0

; This parameter controls the elapsed time, in minutes, betwen each
; Director warning informing that a certain MiraMon session does not
; answer. If you are working with files being of slow processing in
; your computer and you receive too much messages of this kind,
; increase this value. The minimum value is 1.
MinutsCicleTestDirector=60

; Controls wether an object selected interactively or by attributes
; must bu hidden when it should be shown at some scala at which the layer
; is not shown. 0=No  1=Yes (default value)
;EscalaApagaObjectesSeleccionats=0

; Documentary Database by default
;BDDocumental=pathname of DB

; Controls whether, in reference to the ID_GRAFIC field, a thorough analysis of its
; content and coherence will be done (option 2, usual behavior until January 2013 but
; that heavily slows opening large main tables), or if a fast test will be done (option 1,
; which is the current default, and only checks for multiple registry or additional records
; with negative indexes or exceeding the number of objects). The vast majority of the layers
; have a right ID_GRAFIC field (sorted in ascending order, etc) and, therefore, this effort is
; usually unnecessary except to verify layers showing a strange behavior. You can temporarily
; change the behavior within a session via "Exhaustive test of Graphic Id. field when
; opening dataset".
;TestIdGr=2

; Legend will show layers not visible due to they are declared as not visible, due to they are
; at a certain scale where declared not visible or, simply, due to the fact they are not visible on
; the map field. The default value (0) hides those layers during printing.
ImprLlegMostraCapesNoVisib=0

; Open the classical Windows box or te modern box (allowing print to file whithout
; redefining printer port) when pushing button "Printer..." on the printing dessign
; dialog box. The default value (1) shows the modern box.
; CaixaModernaTriaImpressora=0
CaixaModernaTriaImpressora=1

; Show, in toolbar,  a button that allows to publish/export vector "open" data 
; from the information in the current MiraMon session to various formats.
; 0: not to show the button for special publishing (default value) 
; 1: show the button for special publishing.
;BarraBotonsEspecial=1

; Build a single table using the main table of the layer and all linked tables associated with it.
; It will produce faster queries in MiraMon.
; 1: Use the single table (default value).
; 0: Not use the single table.
UsarTaulaUnica=1

;==========================================================================
[METRICA]
;==========================================================================
; SECTION TO CONFIGURE METRICS, CARTOGRAPHIC PROJECTIONS, ETC
;==========================================================================

; Reference system and units by default when performing geometric corrections  
; and format conversions (import).
;RefSystem=UTM-31N-UB/ICC
RefSystem=lat/long-WGS84

; When the reference system is of "Cartographic" type and it is described in 
; the geodesy tables, units are read from those tables. This is the common
; situation. Nevertheless, in the other cases (as when the system is "Local")
; they may be specified.
RefUnits=m

; Reference system and units by default when digitizing and 
; ONLY having the digitizing layer loaded.
RefSystemScreen=plane
RefUnitsScreen=pixels

; Transformation of the reference system on the fly. The default value is 1 (yes).
; If you do not want to use it, write 0.
;TransformacioGeometriaAlVol=0

; Conversion factors for lengths and areas.
; If you do not want to use them, write 0 or comment the line with
; a semicolon.
ConversorLong=0.001
UnitLong=km
ConversorArea=0.0001
UnitArea=ha
;ConversorArea=1E-6
;UnitArea=km²

; Mantain current view when opening a new layer or map. This parameter,
; with a default value of 0 (false), acts inhibiting the reading of the [VISTA]
; section in maps and avoiding the zoom tho the whole ambit of the new layer when opening a new one.
; The parameter only acts when there is some layer loaded.
; Its value can also be modified from the "View | Special" menu.
;MantenirVistaActualEnObrirNovaCapa=1
MantenirVistaActualEnObrirNovaCapa=0

; When doing a zoom to selected, this parameter indicates centering on the screen (value 1)
; instead of showing the selected objectes on the upper left angle (valor 0). Default value: 1
;CentraSeleccio=0
CentraSeleccio=1

; When doing a zoom to selected, this parameter allows giving some extra area all around the
; selected objects.
; The default value is 1 (no extra area) but can be reduced up to 0.5 (use the central half of the screen). 
;PercentPantallaSeleccio=.8
PercentPantallaSeleccio=1

; How the program manages the Zoom:
;  Mode General view (option 0 and default):  The zoom is managed based on the general view of all layers.
:  Mode Reference raster (option 1): The zoom is managed based on one of the open ràsters, being the first the default,
;	independently of the presence of other raster or vector layers.
;  Mode Automatic (option 2): Switches between the two previous modes, applying the mode Reference raster if all open
;	rasters have the same pixel size, and  applying the mode General view otherwise.
ModeGestioZoom=0

; Do you want to show the status window? 0: no; 1 yes (default value)
BarraEstatVisible=1

; Do you want to show scroll bars on the main window? 0: no; 1 yes (default value)
MostrarBarresFinestraPintar=1

;==========================================================================
[GPS]
;==========================================================================
; SECTION FOR GPS TRACKING
;==========================================================================

; Percentage of the screen center not needing a recentering of the last
; point of the GPS path.
;	A value of 100% only recenters when the path falls beyond the screen.
;	A value of   0% recenters at each refresh sent by GPSMM.
PercentPantallaNOCentratGPS=80

; Radius of the circle drawn around the last GPS point read.
RadiSeguimentGPS=500

; Type of units applying to RadiSeguimentGPS: 0=UNITATS_PIXELS, 1=UNITATS_MAPA (cartesian), 2=UNITATS_MAPA (geodetic)
TipusUnitatsRadiSeguimentGPS=2


;==========================================================================
[Hardware]
;==========================================================================
; SECTION TO CONFIGURE HARDWARE
;==========================================================================

; Time, in seconds, that the program waits between a mouse click and a drag to
; considered that it is a dynamic change to the pan mode.
; Default value is 0.2. You can set any positive value up to 1.
; Set -1 if you want to inactivate the dynamic change to the pan mode.
;TempsArrossegamentDinamicSegons =- 1

; The next parameter allows you to enable or disable the dynamic pan during
; digitizing because some people tend to "drag" the mouse between
; clicks and dynamically change to pan too frequently.
; 0 = No 1 = Yes (default)
;ActivaArrossegamentDinamicDurantDigitalitzacio = 0

; Screen width, in mm. It is necessary to calculate scales.
;X_mm_Pantalla=260
X_mm_Pantalla=304.8
; PolzadesDiagonalPantalla=15

; Some graphic cards and printers fail when trying to draw very complex
; objects (for instance, lines of 20000 vertices). This problem can become
; worse for polygons and thicker lines. The problem is also dependent on the
; scale of detail and on the output peripheral (normally at a more detailed
; scale or in a peripheral of higher resolution there are more chances
; of having problems) and of the 'quantity' of the object that is visualized 
; or printed. The general view of an object is the case that has a higher
; probability of having problems, specially in screens and printers of high
; resolution and in big-sized papers. The parameters 'MaxVertexsTargetaGraficaEx'
; and 'MaxVertexsImpressoraEx' allows to define which is this limit value for your
; computer (for screen and printer respectively). If an object
; is over this limit, MiraMon will simplify it with an intelligent algorism
; which normally does not cause non-desired aesthetics effects. If your 
; screen or printer are not successful at drawing a given object, you should
; lower down the value for this parameter till they can draw it. A value
; between 10000 and 15000 is normally adequate for most peripherals, but
; you can empirically do a finer tuning because these parameters can be changed from
; the MiraMon menus (it is also usefull when selecting a printer different from
; the default one).
; The parameters 'MaxVertexsTargetaGraficaEx' and 'MaxVertexsImpressoraEx'
; substitute, in December 2021 the old parameters 'MaxVertexsTargetaGrafica' and 'MaxVertexsImpressora'.
MaxVertexsTargetaGraficaEx=1048576
;MaxVertexsTargetaGrafica=32767
MaxVertexsImpressoraEx=1048576
;MaxVertexsImpressora=32767

; From Vista and Windows 7 versions, the operating system can turn off
; the drawing of an application as it seems that the application is "Not Responding". This leads,
; in complex layers, that from a certain element the system cannot longer draw on the screen, and
; even worse, once MiraMon stops drawing, it receives a new
; instruction to redraw from the operating system, which generates a loop
; sometimes eternal of incomplete redrawns that only finishes when pressing the shift key
; followed by making a zoom that lets you work on a lower level of complexity
; (less objects). The parameters N_Objectes_PntNod_EvitaNoRespon and N_Objectes_ArcPol_EvitaNoRespon
; allow, for points and nodes, and arcs and polygons respectively, to disable this
; behavior of Windows for complex layers. Default values have been adjusted
; to the  most common processors in late 2012, but if you have substantially
; older computers and observe this behavior, you should decrease these values until
; you do not see the problem.
N_Objectes_PntNod_EvitaNoRespon=500000
N_Objectes_ArcPol_EvitaNoRespon=10000

; It is interesting that the program can interrupt the drawing to make a query,
; a new zoom, etc, not just by pressing the Shift key, but also from a mouse action.
; However, during the loop of drawing objects the program can not "hear" from the very beginning
; if the user has clicked the left mouse button (or the wheel zoom button)
; because if the click was the second of a zoom by window or an indication of the end of a pan operation,
; the event happens so fast that MiraMon detects this click while still drawing the first
; items and always stop any drawn after a zoom or pan, which
; would be an unintended effect of interrupting the drawing with a mouse click. So
; it is necessary to specify how many objects are allowed to be left drawn before
; considering that the fact that the mouse button is pressed is not the end of an operation
; of zoom or pan, but a petition to stop the redrawn from a mouse action,
; which will be initiated afterwards.
; The default values are: 1000 for points and nodes, and 500 for arcs and polygons, but these
; values may have to be higher in very fast computers or networks, and vice versa, have
; to become shorter in computers or networks relatively slow. If you find that many
; objects are left without redrawing after a zoom by window or pan, you should increase these value, while
; if you do need pressing too long the mouse button for the program to understand you wish to stop
; drawing, you must decrease the value.
; By specifying -1, it is assumed that you do not want the program to stop never through
; a mouse click (but you can do it if you wish by pressing the Shift key).
;N_PntNod_SenseAturarRedib_x_clic=-1
;N_ArcPol_SenseAturarRedib_x_clic=-1

; However, and since the calculation for simplification is complex and it 
; can determine a slow drawing, you can tell MiraMon not to draw the 
; objects that get to this level of complexity by establishing the
; value of the parameter 'DibuixaObjectesComplexos' to 0. In this way, you
; can work with polygons of, for instance, 50000 vertexes, by not drawing
; them in views that oblige to have a number of vertices higher than
; 'MaxVertexsTargetaGraficaOImpressora'. This way the drawing of objects will be 
; faster and, when trying to print, you only have to activate again the
; menu option "View | Special | Draw complex objects". Possible values
; are:
;   0=Do not draw complex objects
;   1=Draw complex objects
DibuixaObjectesComplexos=1

; Next option generates printing in the computer before is sent to the printer;
; this is useful when printing complex documents (with transparencies,
; semitransparencies, etc) on large printers or plotters.
; Possible values are:
;   0=Send printing directly to the printer, except when non-text semitransparencies exist (default value).
;   1=Genetex printing in the computer and then sends it to the printer, except in the case of semitransparent texts
;     and dynamic labels.
;   2=As 1, but printing is stored in a temporal file before to be sent to the printer.
;     This mode is needed, for example, in the HP 9600 printer.
;GenerarImpressioAOrdinadorAbansDEnviarAImpressora=1
GenerarImpressioAOrdinadorAbansDEnviarAImpressora=0

; Next option is useful when the drivers of a printing device cannot
; print rasters which are bigger than 1 Mbyte in size, or when the result
; is a garbaged image. We DO NOT recommend option 0.
; 0=No  1=Yes
ImprimirRastersEnPaquetsPetits=1

; Maximum size of raster printing packets in X and in Y
; Default values are 768; specifying a larger value makes printing faster, but generates
; problems on some plotters, specialy when printing is prepared "on printer" instead of
; "on computer".
MaximPaquetX_a_Impressora=768
MaximPaquetY_a_Impressora=768

; The following option is useful when the drivers of a printer device cannot
; print transparencies; the impression is carried out automatically in tiles
; for the layers that have some level of transparency, causing that
; many printer drivers can then generate a correct result.
; Indicate the number of pixels of the side of the tile in the printing result.
; The default value is 512; if tile printing is not wished please use
; a value of 2147483648.
; VERY IMPORTANT: If although using an small value printing is not OK, set the printer
; driver to prepare printing "on the computer" and not "on the printer".
PixelsPerRajolaImpressioTransp=512

; Maximum number of WMS views saved to speed WMS redrawing. These views are stored in the temporal directory and are
; erased by MiraMon each time the application is closed or one day after if the session was abruptly closed.
: By setting 0 no view is saved, but this causes that each redraw sends a request to the local or remote WMS server,
; being much more slower than using saved previous views;
; The default value is 350.
MaxNVistesWMSSalvades=350

; This parameter allows controlling requests to WMS services establishing if they should be adjusted to fit the window area
; (value 0)  or simulating tiled requests, like in a WMTS service (valor 1, default).Using the tiled WMS makes the first request 
; slower, but it optimizes the pan displacements since the information has been requested previously and 
; can be reused, so only areas not visited yet are requested. However, if a “pure” WMS is used, each view requests a new 
; download, except if the area has been visited (but this area must match completely in scope and resolution, which is unlikely).
;WMS_Tessellat=0

; This parameter allows to choose between IE or the WinInet function to download files in OGC requests
; 1 : IE will be used; usually this method is faster but allows a lower control from MiraMon
; 0 : WinInet function will be used, the usual method and the default value
;UsaIEPerPeticionsOGC=0

; Indicates the User Agent to be used when opening an Internet connection.
; The first parameter is related to the Web browser and the other parameters to the version of Windows we have and also
; other parameters can be added such as the application from which the Internet connection is started.
; If nothing is specified the default value will be used:  "Mozilla/5.0 (compatible; Windows NT 6.1; Win64; x64; rv:74.0)"
; According to the Mozilla Developer documentation: The User-Agent request header is a characteristic string that lets servers and network peers identify the application, 
; operating system, vendor, and/or version of the requesting user agent.
; Syntax:
; User-Agent: <product>/<product-version> <comment>
; Common format for web browsers:
; User-Agent: Mozilla/5.0 (<system-information>) <platform> (<platform-details>) <extensions>
; Directives:
; <product> A product identifier — its name or development codename.
; <product-version> Version number of the product.
; <comment> Zero or more comments containing more details; sub-product information, for example. 
;InternetUserAgent=Mozilla/5.0 (compatible; Windows NT 6.1; Win64; x64; rv:74.0)

; Memory management on files of type IMG,TIFF
; Possible values are:
;	0=Automatic  1=Keep visualization prepared in memory  2=Keep visualization prepared in temporary disk
;	3=Generate each visualization from the original file
; The default value is 0
; GestioMemoriaIMG=3
GestioMemoriaIMG=0

; Memory management on files of type RGB->24-bit
; Possible values are:
;	0=Automatic  1=Keep visualization prepared in memory  2=Keep visualization prepared in temporary disk
;	3=Generate each visualization from the original file
; The default value is 0
; GestioMemoriaRGB24=3
GestioMemoriaRGB24=0

; Memory management on files of type JPEG
; Possible values are:
;	0=Automatic  1=Keep visualization prepared in memory  2=Keep visualization prepared in temporary disk
; The default value is 0
; GestioMemoriaJPEG=1
GestioMemoriaJPEG=0

; Memory management on files of type JPEG2000
; Possible values are:
;	0=Automatic  1=Keep visualization prepared in memory  2=Keep visualization prepared in temporary disk
;	3=Generate each visualization from the original file
; The default value is 0
; GestioMemoriaJPEG2000=3
GestioMemoriaJPEG2000=0

; Memory management on files of type BMP
; Possible values are:
;	0=Automatic  1=Keep visualization prepared in memory  2=Keep visualization prepared in temporary disk
;	3=Generate each visualization from the original file
; The default value is 0
; GestioMemoriaBMP=3
GestioMemoriaBMP=0

; Memory management on files of type SID
; Possible values are:
;	0=Automatic  1=Keep visualization prepared in memory  2=Keep visualization prepared in temporary disk
;	3=Generate each visualization from the original file
; The default value is 0
; GestioMemoriaSID=3
GestioMemoriaSID=0

; Memory management on files of type ECW
; Possible values are:
;	0=Automatic  1=Keep visualization prepared in memory
;	3=Generate each visualization from the original file
; The default value is 0
; GestioMemoriaECW=3
GestioMemoriaECW=0

; Memory management on vector files of type PNT, ARC, NOD, POL, SHP and DXF.
; Possible values are:
;	0=Automatic  1=Keep visualization prepared in memory
;	3=Generate each visualization from the original file
; The default value is 0
; GestioMemoriaVectorsTipics=1
GestioMemoriaVectorsTipics=0

; Memory management on DBF tables (classical and extended)
; Possible values are:
; 0=Automatic  1=Load in memory
; 3=Manage from the original file
; The default value is 0
; GestioMemoriaTaules=1
GestioMemoriaTaules=0

; Maximum waiting time (in seconds) to visualize ECWP files.
; The ECWP protocol (ecwp://) allows accessing ECW remote files that,
; in some circumstances, can take a long time to get to the client
; at their maximum resolution. Nevertheless, it is possible that an
; image having enough quality can already be used for visualization once
; a reasonable amount of time has been spent. Since the download 
; of the requested fragment continues as a background process, 
; users can request a redraw (F5 or the appropriate button/menu) to improve the definition of
; the  shown image.
; The default value is 7
;TempsEsperaRespostaECWP=7


