;linkage=http://www.creaf.cat
;function=2

;[ORGANISME:ONLINE_RESOURCE_2]
;linkage=https://www.miramon.cat
;function=2


;===========================================================================
[CONFIG_METADATA]
;===========================================================================
: CONFIGURING VISUALIZATION OF OBLIGATORY KEYS IN THE METADATA MANAGER
;===========================================================================
; The key ObligatorietatNegreta indicates to the Metadata Manager if it is
; desired to show the mandatory metadata in boldface.
; Possible values:
; 0 -> No to indicate the mandatory metadata in boldface
; 1 -> Yes to indicate the mandatory metadata in boldface (default value)
;ObligatorietatNegreta=1

; The key TipusObligatorietatEx indicates 'who' determines which metadata are
; mandatory in the Metadata Manager (GeM+) (for example to show them in boldface if it is necessary).
; Possible values:
; -1 -> Compulsory Nature automatically defined according to the format (Rel o XML) and standards (ISO 19115-19139 o the INSPIRE directive) (default value)
; 0 -> Compulsory Nature defined by the Metadata Manager (based on the standards)
; 1 -> Compulsory Nature defined by the user
; 2 -> Compulsory Nature defined by ISO 1915-19139
; 3 -> Compulsory Nature defined by ISO 1915-19139 under INSPIRE directive
;TipusObligatorietatEx=-1

; Wheter TipusObligatorietat=1 (user), location (path) and filename of the text template
; defining the mandatory nature of each metadata entry.
; By default, the internal MiraMon template for ISO and GeM+ standards is used.
; This template can be created from the GeM+ when exporting the mandatory nature
; characteristics from the Configuration tab.
; PlantillaObligatoriUsu=c:\MiraMon\Template\UserMandatoryTemplate.txt
;PlantillaObligatoriUsu=

;IdiomaMostrar=cat
; The key IdiomaMostrar indicates which is the language of the multilingual metadata
; that it is wanted to view in first term when opening a layer in the MiraMon and
; in the Metadata Manager itself.
; By default it is initialized with the language in which MiraMon is installed, but
; in the Metadata Manager it can be modified (for that session of the Manager).
; The key IdiomaMostrar allows forcing a language above this behavior provided
; the layer has the metadata in the required language.
; Possible values:
; cat -> Catalan
; spa -> Spanish
; eng -> English
; alt -> the other language in which the metadata can be documented
; Remember that if nothing is indicated the language of the MiraMon is adopted if
; it coincides with one of the languages of the layer.
IdiomaMostrar=eng

; The key DesarProcesEdicioMD indicates to the Metadata Manager that when saving
; metadata after editing from GeM+ you want to create (or update)
; a metadata editing lineage process.
; Possible values:
; 0 -> Do not save (or update) metadata editing processes in the lineage (default value)
; 1 -> Save (or update) metadata editing processes in the lineage
DesarProcesEdicioMD=0

; Desired color as the background color of the GeM+ interface
; If nothing is specified the default color of Windows will be used
ColorFons=(225,234,247)

; Color in which the edges of the resources of the GeM+ interface will be painted
; If nothing is specified the default color of Windows will be used
ColorVores=(122,153,177)

; Some views or exports of the metadata in HTML incorporate
; or can incorporate a location map made from the layer bounding box and general maps extracted from WMS services

; Maximum size of the square where the location image will be displayed in the HTML views of the metadata
; Default value 300
MidaSituacioHTML=300

; Templates of layer request in WMS format that will be used to build the location image in HTML views of metadata
; It will start with the first one and if this fault will be used the next one and so on
; These are requests to WMS services with all parameters set except BBOX, HEIGHT and WIDTH
; There is no default value
PeticioCapaWMS1=https://maps.heigit.org/osm-wms/service?SERVICE=WMS&VERSION=1.1.1&REQUEST=GetMap&SRS=EPSG:3857&LAYERS=osm_auto:all&FORMAT=image/jpeg&STYLES=default
PeticioCapaWMS2=https://ows.terrestris.de/osm/service?VERSION=1.1.1&REQUEST=GetMap&SRS=EPSG:4326&SERVICE=WMS&LAYERS=TOPO-OSM-WMS&FORMAT=image/jpeg&STYLES=default
PeticioCapaWMS3=https://ows.mundialis.de/osm/service?VERSION=1.1.1&REQUEST=GetMap&SRS=EPSG:4326&SERVICE=WMS&LAYERS=OSM-WMS&FORMAT=image/jpeg&STYLES=default
PeticioCapaWMS4=https://ows.terrestris.de/osm/service?VERSION=1.1.1&REQUEST=GetMap&SRS=EPSG:3857&SERVICE=WMS&LAYERS=OSM-WMS&FORMAT=image/jpeg&STYLES=default
PeticioCapaWMS5=https://ows.mundialis.de/osm/service?VERSION=1.1.1&REQUEST=GetMap&SRS=EPSG:3857&SERVICE=WMS&LAYERS=OSM-WMS&FORMAT=image/jpeg&STYLES=default
PeticioCapaWMS6=https://ows.terrestris.de/osm/service?VERSION=1.1.1&REQUEST=GetMap&SRS=EPSG:3857&SERVICE=WMS&LAYERS=TOPO-WMS&FORMAT=image/jpeg&STYLES=default
PeticioCapaWMS7=https://ows.mundialis.de/osm/service?VERSION=1.1.1&REQUEST=GetMap&SRS=EPSG:3857&SERVICE=WMS&LAYERS=TOPO-WMS&FORMAT=image/jpeg&STYLES=default

; The metadata associated layer, if it exists, will be opened with Windows registered program.
; If this variable is 0, it will always be opened with MiraMon or the button will be left inactive
; if none of the named programs are available.
; Default value 1
UsarProgramaRegistrat=1

;===========================================================================
[GEODATABASE]
;===========================================================================
;===========================================================================
; GEODATABASES RELATED ASPECTS: SDE, SDO,...
;===========================================================================
; The key RefrescLlistaCapesSDO indicates that the SDO layers list refresh
; button will be activated. It is an action that can last a lot
; so it can be interesting to deactivate it for some users.
; Possible values:
; 0: No, it does not allow to refresh layers.
; 1: Yes, it allows to refresh layers.
;RefrescLlistaCapesSDO=0
RefrescLlistaCapesSDO=1