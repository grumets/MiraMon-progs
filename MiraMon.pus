;==========================================================================
[MSA]
;==========================================================================
; SECTION TO CONFIGURE THE BEHAVIOUR OF THE MiraMon SUPPORT APPLICATIONS (MSA)
;==========================================================================

; Generation of fields with ellipsoidal distances and areas: 0=No 1=Yes (default)
CampsAmbMesuresEllipsoidals=1

; Version of REL/DOC/DVC when creating new files: 1=REL1/DOC/DV?, 4=REL4, 4+DOC=REL4 and DOC
; 4 is the default option
VersioEnCrearREL=4

; Lineage style used for new or modified files:
;   0/ Lineage is represented in a tree in the REL of the output layer
;      (lineage of previous layers is imported during the creation
;      of the layer and does not create links to them). (Introduced in 2015.)
;   1/ List of single processes without formally mention data sources
;      (although sources may appear cited in the text of the history
;      of each process). (It was the only available style prior to 01.12.2013.)
;   2/ Lineage is inherited from the REL of the original layers in a tree.
;      (Introduced on 12/01/2013 but as another option number. The need for this change was made evident 
;      because this style creates a chain of links between layers that the user often breaks
;      unwittingly, for example when erasing only intermediate layers he/she no longer needs. Therefore, it is
;      considered that if the user wants these links it is better than he/she sets them
;      manually with the metadata manager tool [GeM+].). Default value.
;
;EstilLlinatge=2

; This option indicates that you want to open automatically the file resulting from a MSA execution in the MiraMon
; session which called the MSA. Default is 1. (0 indicates not to open)
;ObrirResultatMSAaMiraMon=0

