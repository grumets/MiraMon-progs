;==========================================================================
[Xarxa]
;==========================================================================
; NETWORK SECTION
;==========================================================================

; Suggested wait time (in seconds)  after a network error occurs when
; checking for the the network license.
; This value is irrelevant if you install MM_NET in your login script or similar.
; This value is shown to the user in the message:
;   "No access to network license. Please wait about 'x' seconds and retry."
; The network administrator should adjust this setting following this
; protocol:
;   1/ Start MiraMon and, when the about box appears, wait 10
;      seconds before pressing the OK button.
;   2/ If the program starts without problems, repeat the test
;      with, for example, 5 seconds, until you get a message
;      as the previously cited ("No access...").
;   3/ Now increase this setting up to a value (for ex. 7 seconds)
;      that always works fine.
; This value is only important when MM_NET is NOT installed AND when
; running Windows 3.1x, because of the characteristics of non-preemptive
; multitasking of that operating system, that avoids a real background
; access to the license. When MM_NET is installed or under Windows 9x or
; NT this value should never be suggested to the user because a proper
; adjustment of MaxReintents_1_Xarxa and MaxReintents_2_Xarxa (see next)
; guarantees a perfect connection in the background.
TempsEsperaRespostaXarxa=10

; Maximum number of retries before assuming a network error occurred
; (server not available)
; Under Windows 3.1x this parameter MUST BE SET TO 1
; The default value prior to August-2001 was 100, but the increasing
; speed of the CPUs suggests to raise it.
MaxReintents_1_Xarxa=10000

; Maximum number of retries before assuming that there is no license
; available in the server.
; Under Windows 3.1x this parameter MUST BE SET TO 1
MaxReintents_2_Xarxa=1000

;==========================================================================
[MENUS]
;==========================================================================
; CUSTOM MENUS SECTION
;==========================================================================

; Key "Suprimir" indicates which Menu entries do you want to eliminate.
; Note that the "Full Menu" option suppresses nothing and that the
; "Basic Menu" option suppresses many entries. You should refer to each
; menu entry by using the numerical code published in the MM32.DST file,
; that you can edit using any text editor.
; Also note that suppressions are hierarchical, so to suppress a complete
; popup menu you only need to suppress the corresponding parent menu entry.
; You can create your own menu configurations. These ones are only examples.


; Key "MenusValids" indicates the numbers (#) of the MENU_# sections you
; want to show. Key "MenuInicial" indicates the default menu when starting
; MiraMon.

; Key "Titol" is the title of each custom menu entry.

; Key "Insertar" allows users adding entries to launch their favourite
; applications. Sections APLIC_0, APLIC_1, etc allow specify the new
; entry title, the Menu code after which do you want to addd the entry
; (use a minus '-' sign to indicate 'before' and not 'after' this code),
; the command line and, if needed, a separator.
MenusValids=0 1 2 5 3 4
MenuInicial=0

[MENU_0]
Titol=Ful&l Menu
Suprimir=
; Following line adds two external applications at the end of the Tools menu
Insertar=APLIC_0 APLIC_1

[MENU_1]
Titol=&Advanced Menu
; ·$· Provisional
Suprimir=20213 20267 20268 20360 20373
Insertar=APLIC_0 APLIC_1

[MENU_2]
