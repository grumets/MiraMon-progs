<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ANSIOEM:Param4</ows:Identifier>
		<ows:Title>Conversió ANSI-OEM</ows:Title>
		<ows:Abstract>Converteix fitxers de text pla o en format DBF entre els jocs de caràcters ANSI (Windows) i OEM-850 (DOS), amb la qual cosa és possible visualitzar-los i editar-los correctament tant des d'editors Windows (com el bloc de notes) com MS-DOS (com l'EDIT).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Programa per a convertir fitxers a ANSI (Windows), OEM (DOS) [Joc 850] o UTF-8"/>
		<ows:Metadata xlink:title="Abstract:Aquest programa converteix fitxers de text pla o en format DBF entre els jocs de caràcters ANSI (Windows), OEM-850 (DOS) i UTF-8, amb la qual cosa és possible visualitzar-los i editar-los correctament tant des d&apos;editors Windows (com el bloc de notes) com MS-DOS (com l&apos;EDIT). A més, i per al cas dels fitxers DBF, el programa permet marcar-los com a pertanyents a qualsevol dels dos jocs (ANSI (Windows), OEM-850 (DOS))."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigen</ows:Identifier>
				<ows:Title>Fitxer Origen</ows:Title>
				<ows:Abstract>És el nom del fitxer origen amb extensió. Si l'extensió és DBF només es traduirà el contingut dels camps de tipus 'C'. Les altres extensions es tracten com a fitxers de text i es tradueixen sencers.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FitxerOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Mode</ows:Identifier>
				<ows:Title>Mode</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>0 ANSI -> OEM-850 (conversió de Borland).</li><li>1 ANSI -> OEM-850 (adaptació Semi-Estricta X. Pons - Recomanada).</li><li>2 ANSI -> OEM-850 (adaptació Estricta X. Pons).</li><li>3 OEM-850 -> ANSI (conversió de Borland).</li><li>4 ANSI -> UTF-8.</li><li>5 OEM-850 (conversió de Borland) -> UTF-8.</li><li>6 UTF-8 -> ANSI.</li><li>7 UTF-8 -> OEM-850 (conversió de Borland).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Mode"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>7</ows:MaximumValue>
							<ows:Spacing>7</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Substitut</ows:Identifier>
				<ows:Title>Substitut</ows:Title>
				<ows:Abstract>És el caràcter usat per a omplir els caràcters no convertibles (p.ex.: "X", "_"). Vàlid només en els modes 1 i 2. Si no s'indica es demanarà.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Substitut"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerResultat</ows:Identifier>
				<ows:Title>Fitxer Resultat</ows:Title>
				<ows:Abstract>És el nom de fitxer de destí. Es pot indicar sense extensió i el programa l'afegeix.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerResultat"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ANSIOEM:Param2</ows:Identifier>
		<ows:Title>Marcar ANSI-OEM</ows:Title>
		<ows:Abstract><![CDATA[Per al cas dels fitxers DBF, el programa permet marcar el joc de caràcters de fitxers en format DBF com a OEM-850 (DOS), ANSI o d'altres jocs. Això resulta especialment útil quan es tracta de fitxers sense marcatge específic (marcats amb el joc 0), la qual cosa és habitual en arxius creats amb versions antigues de dBASE o que provenen de <i>software</i> que genera fitxers DBF sense especificar cap joc de caràcters en concret. Cal recordar, però, que marcar una taula DBF com a pertanyent a un cert joc de caràcters NO vol dir convertir-la sinó simplement indicar com s'ha d'interpretar.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fitxer DBF</ows:Title>
				<ows:Abstract>És el nom del fitxer origen DBF. Només es traduirà el contingut dels camps de tipus 'C'. Les altres extensions es tracten com a fitxers de text i es tradueixen sencers.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FitxerDBF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>JocCarac</ows:Identifier>
				<ows:Title>Joc de Caràcters</ows:Title>
				<ows:Abstract><![CDATA[Joc de caràcters amb el qual voleu marcar el fitxer: <ul><li>ANSI</li><li>OEM-850</li><li>qualsevol valor decimal [0,255]</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:JocCarac"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>ANSI</ows:Value>
						<ows:Value>OEM-850</ows:Value>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>255</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fitxer DBF</ows:Title>
				<ows:Abstract>És el nom del fitxer origen DBF. Només es traduirà el contingut dels camps de tipus 'C'. Les altres extensions es tracten com a fitxers de text i es tradueixen sencers.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FitxerDBF"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>