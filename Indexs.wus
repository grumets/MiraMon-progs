				<ows:Title>Channel 7 of MODIS sensor</ows:Title>
				<ows:Abstract>Band that corresponds to the channel 6 of MODIS sensor.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Banda_6_MODIS"/>
				<ComplexData>
					<Default>
