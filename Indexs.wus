					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:18</ows:Identifier>
		<ows:Title>NDWI-OT (Normalized Difference Water Index - Ouma &amp; Tateishi)</ows:Title>
		<ows:Abstract><![CDATA[The NDWI-OT index is another of the very diverse approaches to indices for the delimitation of water bodies, in this case one used by Ouma &amp; Tateishi (2006) as part of an approach called WI. Specifically, the NDWI-OT (which in the authors' terminology is called NDWI<sub>3</sub>), uses the IRoc (SWIR) and IRp (NIR) bands (bands 5 and 4 of the TM/ETM+ sensors) to quickly delineate the coastline of bodies of water. <br/><br/><img  src="Indexs_NDWI_OT.GIF"/><br/><br/><b>Ouma, YO; Tateishi, R</b> (2006)  <i>A water index for rapid mapping  of shoreline changes of five East African Rift Valley lakes: an empirical analysis using Landsat TM and ETM+ data</i>. International Journal of Remote Sensing, 27: 3153-3181.<br/><br/>]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>NDWI-OT (Normalized Difference Water Index - Ouma &amp; Tateishi)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>18</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>NIR Band</ows:Title>
				<ows:Abstract>Band that corresponds to the near-infrared spectral region.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NIRband"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIRoc</ows:Identifier>
				<ows:Title>SWIR band</ows:Title>
				<ows:Abstract>Band that corresponds to the short-wave infrared spectral region.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:SWIRband"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
