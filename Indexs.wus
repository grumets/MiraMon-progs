<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
<ows:Identifier>MiraMon:Indexs:Param1:1</ows:Identifier>
<ows:Title>1. DVI</ows:Title>
<ows:Abstract><![CDATA[<b>(Differential Vegetation Index):</b>Difference between near infrared (NIR) and red (R) bands of a sensor.<br/><br/><img alt="Imatge no visible des de DOS" src="DVI.gif"/><br/>]]>
</ows:Abstract>
<ows:Metadata xlink:title="Title:Program for computing vegetation index"/>
<ows:Metadata xlink:title="Abstract:This program allows to calculate a set of predefined vegetation indices."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Option</ows:Identifier>
				<ows:Title>option</ows:Title>
				<ows:Abstract>Differential Vegetation Index
</ows:Abstract>
			<ows:Metadata xlink:title="Param1" />
			<LiteralData>
				<ows:AllowedValues>
				<ows:Value>1</ows:Value>
			</ows:AllowedValues>
		</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandIR</ows:Identifier>
				<ows:Title>Band IR</ows:Title>
				<ows:Abstract>Infrared band.</ows:Abstract>
			<ows:Metadata xlink:title="Param2" />
			<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>		
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandR</ows:Identifier>
				<ows:Title>Band R</ows:Title>
				<ows:Abstract>Red band.
</ows:Abstract>
			<ows:Metadata xlink:title="Param3" />
			<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>		
		</DataInputs>
		<ProcessOutputs>	
			  <Output>
				<ows:Identifier>OutputFile</ows:Identifier>
				<ows:Title>Output File</ows:Title>
				<ows:Abstract>Output filename</ows:Abstract>
				<ows:Metadata xlink:title="Param4" />
				<ComplexOutput>
					<Default>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Default>
					<Supported>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
<ows:Identifier>MiraMon:Indexs:Param1:2</ows:Identifier>
<ows:Title>2. RVI</ows:Title>
<ows:Abstract><![CDATA[<b>(Ratio Vegetation Index):</b>Simple division between the near infrared and red bands. It is being used for biomass and leaf area index (LAI) assessments from 1969.<br/><br/><img alt="Imatge no visible des de DOS" src="RVI.gif"/>]]>
</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
			<ows:Identifier>Option</ows:Identifier>
				<ows:Title>option</ows:Title>
				<ows:Abstract>Ratio Vegetation Index
</ows:Abstract>
			<ows:Metadata xlink:title="Param1" />
			<LiteralData>
				<ows:AllowedValues>
				<ows:Value>2</ows:Value>
			</ows:AllowedValues>
		</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandIR</ows:Identifier>
				<ows:Title>Band IR</ows:Title>
				<ows:Abstract>Infrared band.</ows:Abstract>
			<ows:Metadata xlink:title="Param2" />
			<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>		
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandR</ows:Identifier>
				<ows:Title>Band R</ows:Title>
				<ows:Abstract>Red band.
</ows:Abstract>
			<ows:Metadata xlink:title="Param3" />
			<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>		
		</DataInputs>
		<ProcessOutputs>	
			  <Output>
				<ows:Identifier>OutputFile</ows:Identifier>
				<ows:Title>Output File</ows:Title>
				<ows:Abstract>Output filename</ows:Abstract>
				<ows:Metadata xlink:title="Param4" />
				<ComplexOutput>
					<Default>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Default>
					<Supported>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Supported>
