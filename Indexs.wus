				<ows:Abstract>Output image filename.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:OutputImage"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:19</ows:Identifier>
		<ows:Title>EVI  (Enhanced Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[The EVI obtains a response from the structural variations of the vegetation canopy including the leaf area index (LAI), the type and architecture of the canopy, etc. The EVI was developed to optimize the vegetation signal with improved sensitivity for high biomass densities. This optimization is achieved by separating the signal coming from the vegetation from the atmospheric influence.<br><br><img  src="Indexs_EVI.GIF"/>.<br><br>The EVI is an improved version of the NDVI with an L=1 soil correction factor, two C1=6 and C2=7.5 coefficients designed to correct atmospheric dispersion effects and a G=2.5 gain factor for data from the MODIS sensor.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>EVI (Enhanced Vegetation Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>19</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>NIR Band</ows:Title>
				<ows:Abstract>Band that corresponds to the near-infrared spectral region.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NIRband"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
