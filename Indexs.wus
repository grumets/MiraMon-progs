	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:22</ows:Identifier>
		<ows:Title>PRI (Photochemical Reflectance Index)</ows:Title>
		<ows:Abstract><![CDATA[The PRI is an index of photosynthetic efficiency of the vegetation useful in the estimation of the carbon balance in the Mediterranean ecosystems.<br/><br/>In effect, the Mediterranean evergreen forest presents a very low seasonality in vegetation indices such as NDVI or EVI, despite having a high seasonality of carbon fixation. In these cases, the PRI makes it possible to detect which part of the carbon fixation capacity has become effective. It is calculated: .<br/><br/><img src="Indexs_PRI.GIF"/></p> <br><br>where <img src="Indexs_PRI_531.GIF"/>  and <img src="Indexs_PRI_570.GIF"/> correspond to the reflectance in the wavelengths of 531 nm and 570 nm, respectively. These wavelengths can be slightly modified depending on the sensor, the species, etc.<br><br>PRI index is related to the use of radiation, with values between -1 and 1, increasing as photosynthetic efficiency increases.<br><b>Gamon J, Peñuelas J, Field C</b> (1992) <i>A narrow-waveband spectral index that tracks diurnal changes in photosynthetic efficiency</i>. Remote Sensing of Environment, 41, 35-44.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>PRI (Photochemical Reflectance Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>22</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Banda_570_nm</ows:Identifier>
				<ows:Title>570 nm band</ows:Title>
				<ows:Abstract>570 nm wavelength band.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:570_nm_band"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Banda_531_nm</ows:Identifier>
				<ows:Title>531 nm band</ows:Title>
				<ows:Abstract>531 nm wavelength band.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:531_nm_band"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Output image</ows:Title>
				<ows:Abstract>Output image filename.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:OutputImage"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:23</ows:Identifier>
		<ows:Title>NDSI (Normalized Difference Snow Index)</ows:Title>
		<ows:Abstract><![CDATA[Index that allows the detection of the snow cover. It is calculated:  <br><br><img src="Indexs_NDSI.GIF"/><br><br>where <img src="Indexs_RoV.GIF"/> and <img src="Indexs_RoIRoc.GIF"/> correspond to the reflectance in the spectral region of the green and the shortwave infrared, respectively, since the snow is very reflective in the visible and, on the other hand, absorbing in the shortwave infrared. In the case of TM sensor data, band 5 is used as shortwave band. NDSI values greater than 0.4 correspond to areas with snow cover.<br><br>Several authors recommend applying masks in shady areas and in the existence of lakes to avoid confusion with snowy areas.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>NDSI (Normalized Difference Snow Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>23</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaV</ows:Identifier>
				<ows:Title>Green band</ows:Title>
				<ows:Abstract>Band that corresponds to the green spectral region.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:GBand"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIRoc</ows:Identifier>
				<ows:Title>SWIR band</ows:Title>
				<ows:Abstract>Band that corresponds to the short-wave infrared spectral region.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:SWIRband"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Output image</ows:Title>
				<ows:Abstract>Output image filename.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:OutputImage"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:24</ows:Identifier>
		<ows:Title>BI (Brightness Index)</ows:Title>
		<ows:Abstract><![CDATA[Index used in the study of soil conditions (color, moisture and structure), especially in arid and semi-arid regions.<br><br>It is calculated:<br><br><img src="Indexs_BI.GIF"/><br><br>where <img src="Indexs_RoR.GIF"/> is the reflectance in the spectral region of red and <img src="Indexs_RoIRp.GIF"/> is the reflectance in the spectral region of near infrared (NIR, IRp in this document).  As this is not a standardized index, the result is not bounded above by any constants. High BI values indicate higher reflectance, a situation that corresponds to dry, bare, light-colored soils.  <br><br>The use of this index is included on page 81 of the doctoral dissertation of <b>Sebastien Rapinel</b> (2012) <i>Contribution de la télédétection à l'évaluation des fonctions des zones humides: de l'observation à la modélisation prospective</i>, available at <a href="https://tel.archives-ouvertes.fr/tel-00731169/document">https://tel.archives-ouvertes.fr/tel-00731169/document</a>. There is also a wording similar to  <b>Escadafal R, Bacha S</b> (1995) <i>Strategy for the Dynamic Study of Desertification</i>, Proceedings of the ISSS International Symposium, Ouagadougou, Burkina Faso, 6-10 February 1995, pp. 19-34, disponible a  <a href="https://horizon.documentation.ird.fr/exl-doc/pleins_textes/pleins_textes_6/colloques2/010008392.pdf">https://horizon.documentation.ird.fr/exl-doc/pleins_textes/pleins_textes_6/colloques2/010008392.pdf</a>, which uses a formulation (p. 27 of the printed text) where it adds to the sum the square of the reflectance in the green band. Finally, in the work of b>Marques et al.</b> (2020) <i>The use of remote sensing to detect the consequences of erosion in gypsiferous soils</i> Water Conservation Research, 8:383e392,  it is used a similar formulation (equation 2), but with the green and red bands, probably less informative due to the usual high correlation between these bands.  <br><br>Note: Some erroneous references or some that use other approximations are often attributed to this index   (linear combinations such as the brightness of the Tasseled Cap transformation, etc). In order to avoid confusion and waste of time for MiraMon users, here is a reference that do NOT have to do with the 24 index that is implemented in this application:<br><br><b>Escadafal R, Belghith A, Ben Moussa H</b> (1994) <i>Indices spectraux pour la dégradation des milieux naturels en Tunisie aride</i>. 6ème Symp. Int. Mesures Physiques et Signatures en Télédétection. ISPRS-CNES <a href="https://horizon.documentation.ird.fr/exl-doc/pleins_textes/pleins_textes_5/b_fdi_20-21/26946.pdf">https://horizon.documentation.ird.fr/exl-doc/pleins_textes/pleins_textes_5/b_fdi_20-21/26946.pdf</a>.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>IB (Brightness Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>24</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>NIR Band</ows:Title>
				<ows:Abstract>Band that corresponds to the near-infrared spectral region.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NIRband"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaR</ows:Identifier>
				<ows:Title>R Band</ows:Title>
				<ows:Abstract>Band that corresponds to the red spectral region.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:RBand"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Output image</ows:Title>
				<ows:Abstract>Output image filename.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:OutputImage"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:25</ows:Identifier>
		<ows:Title>NDWI-Chen (Normalized Difference Water Index Chen, Huang, Jackson)</ows:Title>
		<ows:Abstract><![CDATA[Index proposed by Chen and collaborators in 2005 to determine the water content in vegetation with data from the MODIS sensor. It is based on the absorption of water in the SWIR and is calculated: <br/><br/><img src="Indexs_NDWI_Chen.gif"/><br/><br/> where <img src= "Indexs_RoIRp.gif"/> and <img src="Indexs_RoIRoc.gif"/> correspond to the reflectance in the spectral region centered at 858 nm and 1640 (or 2130) nm, respectively; formulated like this, the NDWI takes values between slightly negative and 1 depending on the water content of the vegetation.<br/><br/><b>Chen D, Huang J, Jackson TJ</b> (2005) <i>Vegetation water content estimation for corn and soybeans using spectral indices derived from MODIS near- and short-wave infrared bands</i>. Remote Sensing of Environment, 98:225-236. This index corresponds to the one explained in entry NDWI<sup>2</sup> of the work by Pons and Arcalís (2012).]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>NDWI-Chen (Normalized Difference Water Index Chen, Huang, Jackson)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>25</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>NIR Band</ows:Title>
				<ows:Abstract>Band that corresponds to the near-infrared spectral region.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NIRband"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIRoc</ows:Identifier>
				<ows:Title>SWIR band</ows:Title>
				<ows:Abstract>Band that corresponds to the short-wave infrared spectral region.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:SWIRband"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Output image</ows:Title>
				<ows:Abstract>Output image filename.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:OutputImage"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>