	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:13</ows:Identifier>
		<ows:Title>SARVI (Soil Adjusted and Atmospherically Resistant Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[Vegetation index that corrects the radiance of red band by the effect of aerosols incorporating the blue band. <br/><br/><img  src="Indexs_SARVI.gif"/><br/><br/> where <img src="Indexs_RoIRp.gif"/> is the reflectance in the near infrared spectral region and <img src="Indexs_RoRB.gif"/>  is the combined reflectance of the two spectral regions of red and blue, which is calculated  <br/><br/><img src="Indexs_SARVIn.gif"/><br/><br/> where <img src="Indexs_RoR.gif"/>  is the reflectance in the red spectral region and <img src="Indexs_RoB.giF"/> is the reflectance in the blue spectral region. <br/><br/>"Nu" constant is a calibration parameter that depends on the type of atmosphere, but is generally used with a value of 1. "L" is a constant that depends on the vegetation cover and can take a value between 0 and 1.  L=0 is often taken for very high vegetation densities, L=0.5 for intermediate densities and L=1 for very low vegetation densities.<br/><br/> This index takes values between -1 and 1. Negative SARVI values correspond to areas of water, values close to zero correspond to bare soils and positive values correspond to areas of vegetation, with more vigor of vegetation as closer to 1 is the value obtained. When L=0, the SARVI is exactly the same as the ARVI.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>SARVI (Soil Adjusted and Atmospherically Resistant Vegetation Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
