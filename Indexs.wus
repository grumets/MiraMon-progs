	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:9</ows:Identifier>
		<ows:Title>MSAVI1 (Modified Soil Adjusted Vegetation Index - 1)</ows:Title>
		<ows:Abstract><![CDATA[The adjustment factor "L" of SAVI index is not constant, but an inverse function of the vegetation cover. There have been proposed two solutions:<br/><br/><img  src="Indexs_MSAVI1.gif"/><br/><br/><img  src="Indexs_MSAVI1n.gif"/><br/><br/> or:]]></ows:Abstract>
