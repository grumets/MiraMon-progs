				<ows:Identifier>BandIRM</ows:Identifier>
				<ows:Title>Band IRM</ows:Title>
				<ows:Abstract>Mid-infrared
</ows:Abstract>
			<ows:Metadata xlink:title="Param3" />
			<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
