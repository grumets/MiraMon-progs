</ProcessDescription>
<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
<ows:Identifier>MiraMon:Indexs:Param1:16</ows:Identifier>
<ows:Title>16. GEMI</ows:Title>
<ows:Abstract><![CDATA[<b>(Global Environment Monitoring Index):</b>This index was proposed for NOAA-AVHRR sensor in order to have a global knowledgement of the vegetation on the Earth. It is a non linear index that minimizes the solar and atmospheric affects.<br/><br/><img alt="Imatge no visible des de DOS" src="GEMI.gif"/><br/><br/><img alt="Imatge no visible des de DOS" src="GEMIn.gif"/>]]>
</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Option</ows:Identifier>
				<ows:Title>option</ows:Title>
				<ows:Abstract>Global Environment Monitoring Index
</ows:Abstract>
			<ows:Metadata xlink:title="Param1" />
			<LiteralData>
				<ows:AllowedValues>
				<ows:Value>16</ows:Value>
			</ows:AllowedValues>
		</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandIR</ows:Identifier>
				<ows:Title>Band IR</ows:Title>
				<ows:Abstract>Infrared band.</ows:Abstract>
			<ows:Metadata xlink:title="Param2" />
			<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>		
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandR</ows:Identifier>
				<ows:Title>Band R</ows:Title>
				<ows:Abstract>Red band.
</ows:Abstract>
			<ows:Metadata xlink:title="Param3" />
			<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>		
		</DataInputs>
		<ProcessOutputs>	
			  <Output>
