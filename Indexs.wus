<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:7</ows:Identifier>
		<ows:Title>7. SAVI</ows:Title>
		<ows:Abstract><![CDATA[<b>(Soil Adjusted Vegetation Index):</b>ndex that intends to minimize the soil effect on the vegetation index. This effect is important for partially covered surfaces.<br/><br/><img alt="Imatge no visible des de DOS" src="SAVI.gif"/><br/>
    <br/>L = constant that depends on the type of soil. A typical value is 0.5.]]></ows:Abstract>
	<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
			<ows:Identifier>Option</ows:Identifier>
				<ows:Title>option</ows:Title>
