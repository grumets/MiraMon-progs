	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:11</ows:Identifier>
		<ows:Title>TWVI (Two-axis adjusted Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[Studying the complexity of the soil line, it has been proposed an index that improves some aspects of PVI and SAVI indexes. This improvement is appreciable when the distance D between a pixel of soil without vegetation and the soil line is large: <br/><br/><img  src="Indexs_TWVI.gif"/><br/><br/>where <img  src="Indexs_TWVIn.gif"/>]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>TWVI (Two-axis adjusted Vegetation Index)</ows:Title>
				<ows:Abstract>TWVI (Two-axis adjusted Vegetation Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
