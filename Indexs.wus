				<ows:Metadata xlink:title="Name:OutputImage"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:21</ows:Identifier>
		<ows:Title>AFRI1.6 (Aerosol Free Vegetation Index 1.6)</ows:Title>
		<ows:Abstract><![CDATA[AFRI1.6 is developed from NDVI, using the SWIR bands, 1.6 µm, instead of red band to reduce the effects of aerosols. It is proposed with the MODIS band (<span class="style7">p</span><sub>1.6</sub>) and the near infrared band, NIR. <br/><br/><img src="Indexs_AFRI_1.6.GIF"/><br/><br/>  The superiority of the AFRI is due to the capacity of the SWIR bands to penetrate the atmospheric column, even with the presence of smoke and sulphates. These indices are therefore useful for evaluating vegetation in the presence of smoke, anthropic pollution or volcanic eruptions. In clear sky conditions with low atmospheric influence these indices correlate highly with the NDVI <br/><br/><b>Karnieli A,  Kaufman YJ, Remer L,  Wald A</b> (2001) <i>AFRI  Aerosol free vegetation index</i>. Remote Sensing of Environment, 77(1):10-21.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>AFRI1.6 (Aerosol Free Vegetation Index 1.6)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>21</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>NIR Band</ows:Title>
				<ows:Abstract>Band that corresponds to the near-infrared spectral region.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NIRband"/>
				<ComplexData>
					<Default>
						<Format>
