	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:12</ows:Identifier>
		<ows:Title>ARVI (Atmospherically Resistant Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[Vegetation index similar to NDVI but improved in the way that it considers the atmospheric effects. To achieve this, the red band is substituted by a red-blue band that considers the different atmospheric dispersion in these two spectral regions, giving the following expression:<br/><br/><img  src="Indexs_ARVI.gif"/><br/><br/> where <img  src="Indexs_ARVIn.gif"/> is the combined reflectance of the red and blue bands. The constant  "nu", in Greek, is a calibration parameter that depends on the type of atmosphere, but it is usually taken equal to 1.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>ARVI (Atmospherically Resistant Vegetation Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>12</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>NIR Band</ows:Title>
				<ows:Abstract>Band that corresponds to the near-infrared spectral region.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NIRband"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaR</ows:Identifier>
				<ows:Title>R Band</ows:Title>
				<ows:Abstract>Band that corresponds to the red spectral region.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:RBand"/>
				<ComplexData>
