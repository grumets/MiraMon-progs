	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:7</ows:Identifier>
		<ows:Title>SAVI (Soil Adjusted Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[Index that intends to minimize the soil effect on the vegetation index. This effect is important for partially covered surfaces.<br/><br/><img  src="Indexs_SAVI.gif"/><br/><br/>"L" is a constant that depends on the vegetation cover and can take a value between 0 and 1.  L=0 is often taken for very high vegetation densities, L=0.5 for intermediate densities and L=1 for very low vegetation densities.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>SAVI (Soil Adjusted Vegetation Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>7</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>NIR Band</ows:Title>
				<ows:Abstract>Band that corresponds to the near-infrared spectral region.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NIRband"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaR</ows:Identifier>
				<ows:Title>R Band</ows:Title>
				<ows:Abstract>Band that corresponds to the red spectral region.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:RBand"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>L</ows:Identifier>
				<ows:Title>L</ows:Title>
				<ows:Abstract>"L" parameter of the equations. If no parameters are given, the program also works interactively, but the names of the images (both input and output) and the index to be calculated must be given.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:L"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Output image</ows:Title>
				<ows:Abstract>Output image filename.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:OutputImage"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:8</ows:Identifier>
		<ows:Title>TSAVI (Transformed Soil Adjusted Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[Readjustment of the SAVI index to consider the effect of the soil brightness.<br/><br/><img  src="Indexs_TSAVI.gif"/>. <br><br>"a" and "b" are, respectively, the slope and the ordinate at the origin of the soil baseline and "chi" represents an adjustment factor to minimize the soil effect, which the authors recommend applying with a value of 0.08. The TSAVI takes values between 0 and 1. TSAVI values close to zero correspond to bare soil and values close to 1 (generally greater than 0.70) correspond to areas with active vegetation. This index is very suitable for semi-arid regions, where soil moisture and vegetation coverage are very low.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>TSAVI (Transformed Soil Adjusted Vegetation Index)</ows:Abstract>
