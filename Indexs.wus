					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>b</ows:Identifier>
				<ows:Title>b</ows:Title>
				<ows:Abstract>"b" parameter of the equations. If no parameters are given, the program also works interactively, but the names of the images (both input and output) and the index to be calculated must be given.</ows:Abstract>
