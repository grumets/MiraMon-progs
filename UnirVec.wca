<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:UNIRVEC:Param:3</ows:Identifier>
		<ows:Title>Fusiona Llista</ows:Title>
		<ows:Abstract>Aquesta opció uneix dos més fitxers vectorials de MiraMon a partir d'un fitxer llista que conté una llista de fitxers a unir.</ows:Abstract>
<ows:Metadata xlink:title="Title:Programa d'unió de fitxers vectorials de Miramon."/>
<ows:Metadata xlink:title="Abstract:Aquest programa uneix dos o més fitxers vectorials de MiraMon en un sol fitxer sense prendre cap consideració topològica. Per això els fitxers estructurats de destí són marcats com a no topològics. Això fa que el procés sigui molt ràpid. En canvi, el programa &quot;Mosaic&quot; realitza una estructuració topològica del fitxer destí cosa que el fa més robust però més lent, necessitant més memòria.."/>
		<DataInputs>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract><![CDATA[<li>1. fusiona fitxers VEC i permet sobreescriure sobre el fitxer destí.</li><li>2. fusiona fitxers ARC, PNT o ARC ciclats.</li>]]>
</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
			<LiteralData>
				<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:Value>1</ows:Value>
					<ows:Value>2</ows:Value>
				</ows:AllowedValues>
			</LiteralData>				
		</Input>			
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>OrigenLlista</ows:Identifier>
				<ows:Title>Origen Llista</ows:Title>
				<ows:Abstract>És un fitxer llista (habitualment txt o lst) que conté una llista de fitxers a unir.
</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
		<ComplexData>
				<Default>
					<Format>
								<MimeType>application/x-TXT</MimeType>
								<Encoding>Text</Encoding>
							</Format>
				</Default>
				<Supported>
					<Format>
								<MimeType>application/x-TXT</MimeType>
								<Encoding>Text</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-LST</MimeType>
								<Encoding>lst</Encoding>
							</Format>
				</Supported>
			</ComplexData>	
		</Input>
		</DataInputs>
		<ProcessOutputs>	
				<Output>
				<ows:Identifier>Destí</ows:Identifier>
				<ows:Title>Destí</ows:Title>
				<ows:Abstract>És el fitxer de sortida de la unió dels fitxers a unir.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexOutput>
					<Default>
					<Format>
						<MimeType>application/x-ARC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Default>
					<Supported>
					<Format>
						<MimeType>application/x-PNT</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					<Format>
						<MimeType>application/x-VEC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>	
</ProcessDescription>
<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:UNIRVEC:!Param:3</ows:Identifier>
		<ows:Title>Fusiona seqüència fitxers</ows:Title>
		<ows:Abstract>Aquesta opció uneix dos més fitxers vectorials de MiraMon a partir d'una seqüència de noms de fitxers en línia de comanda.</ows:Abstract>
		<DataInputs>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>1. fusiona fitxers VEC i permet sobreescriure sobre el fitxer destí.</li><li>2. fusiona fitxers ARC, PNT o ARC ciclats.</li></ul>]]>
</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
			<LiteralData>
				<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:Value>1</ows:Value>
					<ows:Value>2</ows:Value>
				</ows:AllowedValues>
			</LiteralData>				
		</Input>			
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Origen#</ows:Identifier>
				<ows:Title>Origen#</ows:Title>
				<ows:Abstract>És una seqüència de noms de fitxers. Aquesta opció és especialment útil per unir 2 o 3 fitxers en línia de comanda sense haver de generar una llista. La caixa de diàleg de l'aplicació no reflexa aquesta opció.
</ows:Abstract>
				<ows:Metadata xlink:title="Param4" />
		<ComplexData>
				<Default>
					<Format>
								<MimeType>application/x-ARC</MimeType>
								<Encoding>Text</Encoding>
							</Format>
				</Default>
				<Supported>
					<Format>
								<MimeType>application/x-PNT</MimeType>
								<Encoding>Text</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>lst</Encoding>
							</Format>
				</Supported>
			</ComplexData>	
		</Input>
		</DataInputs>
		<ProcessOutputs>	
				<Output>
				<ows:Identifier>Destí</ows:Identifier>
				<ows:Title>Destí</ows:Title>
				<ows:Abstract>És el fitxer de sortida de la unió dels fitxers a unir.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexOutput>
					<Default>
					<Format>
						<MimeType>application/x-ARC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Default>
					<Supported>
					<Format>
						<MimeType>application/x-PNT</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					<Format>
						<MimeType>application/x-VEC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>	
</ProcessDescription>
</wps:ProcessDescriptions>
