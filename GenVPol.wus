<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GenVPol:Param1:1</ows:Identifier>
		<ows:Title>GenVPol (moving average + Douglas-Peucker)</ows:Title>
		<ows:Abstract>Option to apply to every vertex a moving average filter over its position (on its XY coordinates) followed by Douglas-Peucker vertex simplification algorithm.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Polygon boundary generalization"/>
		<ows:Metadata xlink:title="Abstract:By default, the application guarantees that the generalization process of the polygons boundaries does not produce intersection among the arcs, collapses of individual arcs forming an enclosed area (avoiding that a ring becomes a point) or other changes that alter the topological relationships among the arc objects which form the boundaries or between the polygons themselves."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Apply moving average filter followed by Douglas-Peucker algorithm.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerPolOrigen</ows:Identifier>
				<ows:Title>Origin file</ows:Title>
				<ows:Abstract>Name of the vector file to generalize.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerPolOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ToleranciaLM</ows:Identifier>
				<ows:Title>Tolerance</ows:Title>
				<ows:Abstract>Tolerance of the moving average filter. Expressed in the unites of the origin layer reference system.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ToleranciaLM"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ToleranciaDP</ows:Identifier>
				<ows:Title>Douglas-Peucker tolerance</ows:Title>
				<ows:Abstract>Tolerance (epsilon) applied to Douglas-Peucker algorithm. Expressed in the unites of the origin layer reference system.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:ToleranciaDP"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NumPesos</ows:Identifier>
				<ows:Title>Number of weights</ows:Title>
				<ows:Abstract>Number of weights for the moving average filter.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:NumPesos"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>7</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PESOS_IGUALS</ows:Identifier>
				<ows:Title>Equal weights.</ows:Title>
				<ows:Abstract>Equal weights for all moving average vertices.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PESOS_CENTR</ows:Identifier>
				<ows:Title>Central weights.</ows:Title>
				<ows:Abstract>Automatic weights, weighting the position of the central vertices of the moving average, but not changing the weights according to the distances between vertices.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PESOS_INV_DIST</ows:Identifier>
				<ows:Title>Inverse distance weights.</ows:Title>
				<ows:Abstract>Automatic weights of every vertex according to the inverse of the planimetric distance to the central vertex of the moving average.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PESOS_USR</ows:Identifier>
				<ows:Title>Weights stated by the user.</ows:Title>
				<ows:Abstract>Weights of values and distribution stated by the user. They must be as much values as "NumPesos", separated by commas "," and their sum must be 1. For example 0.25,0.50,0.25.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESCARTA_POL_0</ows:Identifier>
				<ows:Title>Discard the zero polygon</ows:Title>
				<ows:Abstract>Involves not generalizing the arcs that are boundary with the zero polygon (external to all others, or internal to all others in layers of special topology).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_PRESERVAR_TOPOLOGIA</ows:Identifier>
				<ows:Title>Not preserving topology.</ows:Title>
				<ows:Abstract>It implies to not preserve the topology of the result. The file will be marked with non-verified topology and it will not be monitored if the objects intersect with other objects.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerPolDesti</ows:Identifier>
				<ows:Title>Output file</ows:Title>
				<ows:Abstract>Name of the resulting generalized file. Both FitxerPolOrigen and FitxerPolDesti cannot be the same.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerPolDesti"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GenVPol:Param2:2</ows:Identifier>
		<ows:Title>GenVPol (moving average)</ows:Title>
		<ows:Abstract>Option to apply to each vertex a moving average filter over its position (on its XY coordinates).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Apply moving average filter only.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
