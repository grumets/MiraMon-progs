			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>XMax</ows:Identifier>
				<ows:Title>Maximum X</ows:Title>
				<ows:Abstract>Maximum X of the scope of the resulting file.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:MaxX"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
