			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>XMin</ows:Identifier>
				<ows:Title>Minimum x</ows:Title>
				<ows:Abstract>Minimum X of the scope of the resulting file.</ows:Abstract>
