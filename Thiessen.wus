			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>YMin</ows:Identifier>
				<ows:Title>Minimum Y</ows:Title>
				<ows:Abstract>Minimum Y of the scope of the resulting file.</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:MinY"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
