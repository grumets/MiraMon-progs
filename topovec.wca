<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TIFIMG:param1:0</ows:Identifier>
		<ows:Title>Informació TIFF</ows:Title>
		<ows:Abstract>Aquesta opció mostra la informació de la capçelera de l'arxiu TIFF.</ows:Abstract>
<ows:Metadata xlink:title="Title:Programa de conversió entre fitxers TIFF i IMG."/>
<ows:Metadata xlink:title="Abstract:Aquest programa permet transformar bidireccionalment  fitxers TIFF i IMG."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>0. Informació de capçalera d'un fitxer TIFF.
</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
			<LiteralData>
				<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:Value>0</ows:Value>
				</ows:AllowedValues>
			</LiteralData>				
		</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerTIF</ows:Identifier>
				<ows:Title>Fitxer TIFF</ows:Title>
				<ows:Abstract>És el nom del fitxer TIFF del qual se'n vol obtenir la informació de capçelera.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
			<ComplexData>
				<Default>
					<Format>
								<MimeType>application/x-TIFF</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
				</Default>
				<Supported>
					<Format>
								<MimeType>application/x-TIFF</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
				</Supported>
			</ComplexData>	
		</Input>
		</DataInputs>
			<ProcessOutputs>	
				<Output>
				<ows:Identifier>stdout</ows:Identifier>
				<ows:Title>Estandard de sortida</ows:Title>
				<ows:Abstract>Informació sobre el TIF</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
						<MimeType>application/x-display</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Default>
					<Supported>
						<Format>
						<MimeType>application/x-display</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>	
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TIFIMG:param1:1</ows:Identifier>
		<ows:Title>TIFF a IMG</ows:Title>
		<ows:Abstract>Aquesta opció transforma  fitxers TIFF b/n(1 bit) a fitxer IMG (1bit) .</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>1. Transformació a IMG bit.
</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
			<LiteralData>
				<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:Value>1</ows:Value>
				</ows:AllowedValues>
			</LiteralData>				
		</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerTIF</ows:Identifier>
				<ows:Title>Fitxer TIFF</ows:Title>
				<ows:Abstract>És el nom del fitxer TIFF que es vol tranformar a IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
			<ComplexData>
				<Default>
					<Format>
								<MimeType>application/x-TIFF</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
				</Default>
				<Supported>
					<Format>
								<MimeType>application/x-TIFF</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
				</Supported>
			</ComplexData>	
		</Input>
		</DataInputs>
			<ProcessOutputs>	
				<Output>
				<ows:Identifier>FitxerIMG</ows:Identifier>
				<ows:Title>Fitxer IMG</ows:Title>
				<ows:Abstract>És el nom del fitxer IMG resultat de transformació.</ows:Abstract>
							<ows:Metadata xlink:title="Param3" />
				<ComplexOutput>
					<Default>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Default>
					<Supported>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>	
	</ProcessDescription>
</wps:ProcessDescriptions>
