<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GMLMM:Param1:1</ows:Identifier>
		<ows:Title>Importing and exporting between GML format and MiraMon format</ows:Title>
		<ows:Abstract>Imports a file from GML format creating a MiraMon Map that contains one or more layers (as required according to the GLM file content) in MiraMon structured vector format (PNT, ARC/NOD and POL) but it does not structure them topologically.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importing and exporting between GML format and MiraMon format"/>
		<ows:Metadata xlink:title="Abstract:This application allows to import a file in GML format to a MiraMon Map (MMM) that contains layers in structured vector format of MiraMon (PNT, ARC/NOD and POL)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Import GML files to a MiraMon Map</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerGML</ows:Identifier>
				<ows:Title>GML file</ows:Title>
				<ows:Abstract>GML file to import.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:GMLFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Output Horizontal Reference System</ows:Title>
				<ows:Abstract>Identifier of the reference system to reproject the output layers, if a reference system different from the input file is desired.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ORDRECOOR</ows:Identifier>
				<ows:Title>ORDRECOOR</ows:Title>
				<ows:Abstract>LATLONG or LONGLAT. If omitted, order is determined automatically (ORDRE_LL_AUTO_GML).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>LATLONG</ows:Value>
						<ows:Value>LONGLAT</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VULL_CAMPS_GEOTOPO</ows:Identifier>
				<ows:Title>Geometric-topological fields</ows:Title>
				<ows:Abstract>Also write the geotopological fields in the MM to GML conversion.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VULL_TAULES_ASSOCIADES</ows:Identifier>
				<ows:Title>Linked tables</ows:Title>
				<ows:Abstract>Also write the associated tables in the MM to GML conversion.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VULL_TOPO_COM_DBF</ows:Identifier>
				<ows:Title>VULL_TOPO_COM_DBF</ows:Title>
				<ows:Abstract>If possible, convert to GML keeping topology in two associated tables. When importing a polygon GML, if topology is to be recovered, an associated arc GML is read first and the arc file is created; then the polygon GML is read using the topology tables (same directory, with specific names). If topology is not requested, the polygon GML is read directly.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SEPARADOR_COM_A_COMPLEXTYPE</ows:Identifier>
				<ows:Title>SEPARADOR_COM_A_COMPLEXTYPE</ows:Title>
				<ows:Abstract>The field separator is exported as a GML ComplexType (SEPARADOR_COM_A_GML_COMPLEXTYPE).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMM</ows:Identifier>
				<ows:Title>Fitxer MMM</ows:Title>
				<ows:Abstract>Output file with .mmm extension. The program will create a folder with the same map name where the vector layers of the map will be saved.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:MMMFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GMLMM:Param1:2</ows:Identifier>
		<ows:Title>Export from a MiraMon Map or from a MiraMon vector layer to GML</ows:Title>
		<ows:Abstract>Export from a MiraMon Map or from a MiraMon structured vector layer to a GML format file (WFS Deegree).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Export from a MiraMon Map or from a MiraMon structured vector layer to a GML format file (WFS Deegree)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMOri</ows:Identifier>
				<ows:Title>Input Vector File</ows:Title>
				<ows:Abstract>Input file to export. It can be a file of maps, points, arcs or polygons.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:InMMFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-nod</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ARREL_ESQUEMES</ows:Identifier>
				<ows:Title>Base address http schemas GML validation.</ows:Title>
				<ows:Abstract>Base address of GML validation schemes. By default it will be used http://miramon.uab.cat/ogc/schemas</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VULL_CAMPS_GEOTOPO</ows:Identifier>
				<ows:Title>Geometric-topological fields</ows:Title>
				<ows:Abstract>Also write the geotopological fields in the MM to GML conversion.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VULL_TAULES_ASSOCIADES</ows:Identifier>
				<ows:Title>Linked tables</ows:Title>
				<ows:Abstract>Also write the associated tables in the MM to GML conversion.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VULL_TOPO_COM_DBF</ows:Identifier>
				<ows:Title>VULL_TOPO_COM_DBF</ows:Title>
				<ows:Abstract>If possible, convert to GML keeping topology in two associated tables. When importing a polygon GML, if topology is to be recovered, an associated arc GML is read first and the arc file is created; then the polygon GML is read using the topology tables (same directory, with specific names). If topology is not requested, the polygon GML is read directly.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SEPARADOR_COM_A_COMPLEXTYPE</ows:Identifier>
				<ows:Title>SEPARADOR_COM_A_COMPLEXTYPE</ows:Title>
				<ows:Abstract>The field separator is exported as a GML ComplexType (SEPARADOR_COM_A_GML_COMPLEXTYPE).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerGML</ows:Identifier>
				<ows:Title>GML file</ows:Title>
				<ows:Abstract>Output GML file.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutGMLFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/gml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxerXSD</ows:Identifier>
				<ows:Title>XSD file</ows:Title>
				<ows:Abstract>XSD file containing the XML schema for the generated GML file.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:OutXSDFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
