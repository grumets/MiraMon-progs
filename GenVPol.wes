<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GenVPol:Param1:1</ows:Identifier>
		<ows:Title>GenVPol (media móvil + Douglas-Peucker)</ows:Title>
		<ows:Abstract>Opción para aplicar a cada vértice un filtro de media móvil sobre su posición (sobre sus coordenadas XY) seguido del algoritmo de simplificación de vértices de Douglas-Peucker.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Generalización de bordes de polígonos"/>
		<ows:Metadata xlink:title="Abstract:Esta aplicación generaliza los bordes (arcos) de una capa de polígonos. Por defecto, la aplicación garantiza que el proceso de generalización de los bordes de los polígonos no produzca intersecciones entre los arcos, colapsos de arcos individuales que forman un recinto cerrado (evitando que un anillo se convierta en un punto) u otros cambios que alteren las relaciones topológicas entre los objetos arco que forman los bordes o entre los polígonos en sí."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Aplica el filtro de media móvil seguido del algoritmo de Douglas-Peucker.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerPolOrigen</ows:Identifier>
				<ows:Title>Fichero origen</ows:Title>
				<ows:Abstract>Nombre del archivo vectorial a generalizar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerPolOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ToleranciaLM</ows:Identifier>
				<ows:Title>Tolerancia</ows:Title>
				<ows:Abstract>Tolerancia del filtro de media móvil. Está expresada en las unidades del sistema de referencia de la capa origen.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ToleranciaLM"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ToleranciaDP</ows:Identifier>
				<ows:Title>Tolerancia Douglas-Peucker</ows:Title>
				<ows:Abstract>Tolerancia (épsilon) aplicada en el algoritmo de Douglas-Peucker. Está expresada en las unidades del sistema de referencia de la capa origen.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:ToleranciaDP"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NumPesos</ows:Identifier>
				<ows:Title>Número de pesos</ows:Title>
				<ows:Abstract>Número de pesos para el filtro de media móvil.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:NumPesos"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>7</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PESOS_IGUALS</ows:Identifier>
				<ows:Title>Pesos iguales.</ows:Title>
				<ows:Abstract>Pesos iguales para todos los vértices de la media móvil.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PESOS_CENTR</ows:Identifier>
				<ows:Title>Pesos centrales.</ows:Title>
				<ows:Abstract>Pesos automáticos, favoreciendo la posición de los vértices centrales de la media móvil, pero no cambiando los pesos en función de las distancias entre vértices.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PESOS_INV_DIST</ows:Identifier>
				<ows:Title>Pesos inversos de la distancia.</ows:Title>
				<ows:Abstract>Pesos automáticos en cada vértice en función del inverso de la distancia planimétrica al vértice central de la media móvil.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PESOS_USR</ows:Identifier>
				<ows:Title>Pesos indicados por el usuario.</ows:Title>
				<ows:Abstract>Pesos de valores y distribución indicados por el usuario. Deben ser tantos valores como "NumPesos", deben estar separados por comas "," y deben sumar 1. Por ejemplo 0.25,0.50,0.25.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESCARTA_POL_0</ows:Identifier>
				<ows:Title>Descarta el polígono cero</ows:Title>
				<ows:Abstract>Implica no generalizar los arcos que son fronteras con el polígono cero (externo a todos los otros, o interno a todos los otros en capas de topología especial).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_PRESERVAR_TOPOLOGIA</ows:Identifier>
				<ows:Title>No preservar topología.</ows:Title>
				<ows:Abstract>Implica no preservar la topología del resultado. El archivo se marcará con topología no verificada y no se vigilará que los objetos puedan intersecar con otros objetos.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerPolDesti</ows:Identifier>
				<ows:Title>Fichero destino</ows:Title>
				<ows:Abstract>Nombre del archivo generalizado resultado. Los FitxerPolOrigen y FitxerPolDestí no pueden ser iguales.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerPolDesti"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GenVPol:Param2:2</ows:Identifier>
