<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SIDIMG:Param1:0</ows:Identifier>
		<ows:Title>Muestra metadatos</ows:Title>
		<ows:Abstract>Muestra los metadatos internos que hay guardados dentro del fichero MrSID.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importación del formato ráster MrSID a IMG o JPEG"/>
		<ows:Metadata xlink:title="Abstract:Esta aplicación permite obtener la información de los metadatos internos del formato MrSID, importar un MrSID a un formato JPEG (de grises o RGB, según sea el fichero MrSID) o extraer entre una y tres bandas IMG de un MrSID."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 0</ows:Title>
				<ows:Abstract>Muestra los metadatos internos que hay guardados dentro del fichero MrSID.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerMrSID</ows:Identifier>
				<ows:Title>Nombre Fichero MrSID</ows:Title>
				<ows:Abstract>Es el nombre del fichero MrSID v2 o v3 a transformar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NombreFicheroMrSID"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/x-mrsid</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/x-mrsid</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Stdout</ows:Identifier>
				<ows:Title>Salida estándar</ows:Title>
				<ows:Abstract>Muestra los metadatos del MrSID.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SIDIMG:Param1:1</ows:Identifier>
		<ows:Title>JPEG</ows:Title>
		<ows:Abstract>Genera un fichero JPEG a partir de una imagen MrSID.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 1</ows:Title>
				<ows:Abstract>Genera un fichero JPEG a partir de una imagen MrSID.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerMrSID</ows:Identifier>
				<ows:Title>Nombre Fichero MrSID</ows:Title>
				<ows:Abstract>Es el nombre del fichero MrSID v2 o v3 a transformar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NombreFicheroMrSID"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/x-mrsid</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/x-mrsid</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALITAT</ows:Identifier>
				<ows:Title>Calidad de compresión</ows:Title>
				<ows:Abstract>Calidad de compresión en un rango [0,100], donde [5,95] es el rango útil aunque en muchos casos es recomendable introducir un valor entre 70 y 75 (por defecto es 75). Los valores bajos indican muy poca calidad pero mucha compresión.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>100</ows:MaximumValue>
							<ows:Spacing></ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
					<DefaultValue>75</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FWORLD</ows:Identifier>
				<ows:Title>Fichero WORLD</ows:Title>
				<ows:Abstract><![CDATA[Permite generar un fichero <i>world</i> (georreferenciación) con la extensión indicada. Puede indicar <i>/FWORLD</i> para generarlo usando la extensión por defecto.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFitxerJPEG</ows:Identifier>
				<ows:Title>Nombre Fichero JPEG</ows:Title>
				<ows:Abstract>Es el nombre del fichero JPEG resultante de la transformación.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NombreFicheroJPEG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SIDIMG:Param1:2</ows:Identifier>
		<ows:Title>IMG</ows:Title>
		<ows:Abstract>Genera un fichero IMG a partir de un fichero MrSID de grises.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 2</ows:Title>
				<ows:Abstract>Genera un fichero IMG a partir de un fichero MrSID de grises.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerMrSID</ows:Identifier>
				<ows:Title>Nombre Fichero MrSID</ows:Title>
				<ows:Abstract>Es el nombre del fichero MrSID v2 o v3 a transformar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NombreFicheroMrSID"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/x-mrsid</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/x-mrsid</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFitxerIMG</ows:Identifier>
				<ows:Title>Nombre Fichero IMG</ows:Title>
				<ows:Abstract>Es el nombre del fichero IMG resultante de la transformación para MrSID de una sola banda espectral (grises).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NombreFicheroIMG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SIDIMG:Param1:3</ows:Identifier>
		<ows:Title>MULTIBANDA</ows:Title>
		<ows:Abstract>Genera tres ficheros IMG a partir de un fichero MrSID de 24 bits.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 3</ows:Title>
				<ows:Abstract>Genera tres ficheros IMG a partir de un fichero MrSID de 24 bits.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerMrSID</ows:Identifier>
				<ows:Title>Nombre Fichero MrSID</ows:Title>
				<ows:Abstract>Es el nombre del fichero MrSID v2 o v3 a transformar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NombreFicheroMrSID"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/x-mrsid</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/x-mrsid</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFitxerIMG_R</ows:Identifier>
				<ows:Title>Nombre Fichero IMG Rojo</ows:Title>
				<ows:Abstract>Es el nombre del fichero IMG resultante de la transformación de la banda del rojo del triplete RGB.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NombreFicheroIMG_R"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>NomFitxerIMG_G</ows:Identifier>
				<ows:Title>Nombre Fichero IMG Verde</ows:Title>
				<ows:Abstract>Es el nombre del fichero IMG resultante de la transformación de la banda del verde del triplete RGB.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NombreFicheroIMG_G"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>NomFitxerIMG_B</ows:Identifier>
				<ows:Title>Nombre Fichero IMG Azul</ows:Title>
				<ows:Abstract>Es el nombre del fichero IMG resultante de la transformación de la banda del azul del triplete RGB.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:NombreFicheroIMG_B"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>