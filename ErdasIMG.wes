<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ErdasIMG:Param1:0</ows:Identifier>
		<ows:Title>Información de cabecera</ows:Title>
		<ows:Abstract>El programa permite tomar la información de cabecera del fichero Erdas y la presenta de una manera ordenada.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversión entre ficheros LAN o GIS (Erdas) y IMG"/>
		<ows:Metadata xlink:title="Abstract:Este programa permite tomar diversos ficheros IMG y ponerlos en un solo fichero Erdas de tipo LAN o GIS, o bien extraer, en forma de ficheros IMG, todas las bandas contenidas en un fichero LAN. Los ficheros GIS sólo contienen una banda y suelen ser ficheros de tipo temático, no imágenes radiométricas ni fotográficas."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 0</ows:Title>
				<ows:Abstract>Información de la cabecera del fichero Erdas.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitxer_Erdas.LAN</ows:Identifier>
				<ows:Title>Fichero Erdas</ows:Title>
				<ows:Abstract>Es el nombre del fichero en formato Erdas (CON extensión LAN o GIS).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Fichero_Erdas"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-gis</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>StdOut</ows:Identifier>
				<ows:Title>Estandard de salida</ows:Title>
				<ows:Abstract>Información del fichero Erdas.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ErdasIMG:Param1:1&amp;!Param4</ows:Identifier>
		<ows:Title>Conversión Erdas -> IMG</ows:Title>
		<ows:Abstract>El programa permite tomar ficheros de Erdas de tipo LAN o GIS y convertirlos en IMG. Para los ficheros LAN, el número de ficheros IMG dependerá del número de bandas que contenga el fichero ERDAS. Ejecute esta aplicación con la opción 0 para obtener esta información. Para los ficheros GIS, si no se encuentra ningún fichero TRL, no se escribirá ninguna paleta (el nombre Fitxer_P25 se ignora).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 1</ows:Title>
				<ows:Abstract>Conversión Erdas -> IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitxer_Erdas.LAN</ows:Identifier>
				<ows:Title>Fichero Erdas</ows:Title>
				<ows:Abstract>Es el nombre del fichero en formato Erdas (CON extensión LAN o GIS).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Fichero_Erdas"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-gis</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Fitxer_IMG_#</ows:Identifier>
				<ows:Title>Fichero IMG</ows:Title>
				<ows:Abstract>Son los nombres de los ficheros raster IMG. Se necesita tantos Fitxer_IMG como bandas tenga el origen LAN.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Fichero_IMG_#"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ErdasIMG:Param1:1&amp;Param4</ows:Identifier>
		<ows:Title>Conversión Erdas -> IMG (con paleta P25)</ows:Title>
		<ows:Abstract>Conversión de ficheros Erdas GIS a IMG, con fichero P25 de salida explícito.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 1</ows:Title>
				<ows:Abstract>Conversión Erdas -> IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitxer_Erdas.LAN</ows:Identifier>
				<ows:Title>Fichero Erdas</ows:Title>
				<ows:Abstract>Es el nombre del fichero en formato Erdas (CON extensión LAN o GIS).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Fichero_Erdas"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-gis</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Fitxer_IMG</ows:Identifier>
				<ows:Title>Fichero IMG</ows:Title>
				<ows:Abstract>Es el nombre del fichero raster IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Fichero_IMG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>Fitxer_P25</ows:Identifier>
				<ows:Title>Fichero P25</ows:Title>
				<ows:Abstract>Es el nombre de la paleta de colores en formato P25. Por defecto es el nombre del Fichero_IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Fichero_P25"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-p25</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-p25</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ErdasIMG:Param1:2&amp;!Param4</ows:Identifier>
		<ows:Title>Conversión IMG -> Erdas</ows:Title>
		<ows:Abstract>El programa permite tomar distintos ficheros IMG y poner-los en un solo fichero Erdas de tipo LAN o GIS.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 2</ows:Title>
				<ows:Abstract>Conversión IMG -> Erdas.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1000">
				<ows:Identifier>Fitxer_IMG_#</ows:Identifier>
				<ows:Title>Fichero IMG</ows:Title>
				<ows:Abstract>Son los nombres de los ficheros raster IMG. Se necesita tantos Fitxer_IMG como bandas tenga el origen LAN.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Fichero_IMG_#"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Fitxer_Erdas.LAN</ows:Identifier>
				<ows:Title>Fichero Erdas</ows:Title>
				<ows:Abstract>Es el nombre del fichero en formato Erdas (CON extensión LAN o GIS).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Fichero_Erdas"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-gis</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ErdasIMG:Param1:2&amp;Param4</ows:Identifier>
		<ows:Title>Conversión IMG -> Erdas (con paleta P25)</ows:Title>
		<ows:Abstract>Conversión de ficheros IMG a fichero Erdas GIS, con fichero P25 de entrada explícito.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 2</ows:Title>
				<ows:Abstract>Conversión IMG -> Erdas.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitxer_IMG</ows:Identifier>
				<ows:Title>Fichero IMG</ows:Title>
				<ows:Abstract>Es el nombre del fichero raster IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Fichero_IMG"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitxer_P25</ows:Identifier>
				<ows:Title>Fichero P25</ows:Title>
				<ows:Abstract>Es el nombre de la paleta de colores en formato P25. Por defecto es el nombre del Fichero_IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Fichero_P25"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-p25</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-p25</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Fitxer_Erdas.LAN</ows:Identifier>
				<ows:Title>Fichero Erdas</ows:Title>
				<ows:Abstract>Es el nombre del fichero en formato Erdas (CON extensión LAN o GIS).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Fichero_Erdas"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-gis</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>