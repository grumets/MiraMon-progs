<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Illum:Param1:1&amp;!Param7</ows:Identifier>
		<ows:Title>Constant elevation and azimuth (neighbors)</ows:Title>
		<ows:Abstract>Calculates illumination with constant solar elevation and azimuth and 4, 8 or 9 neighbors for the normal vector calculation.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Calculation of the illumination image from a Digital Elevation Model"/>
		<ows:Metadata xlink:title="Abstract:This program calculates, from a Digital Elevation Model (DEM), the illumination received by a point in the terrain when the Sun occupies a certain position in the celestial sphere."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 1</ows:Title>
				<ows:Abstract>Elevation and azimuth are constant parameters for the file extent.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MDE</ows:Identifier>
				<ows:Title>Digital Elevation Model</ows:Title>
				<ows:Abstract>Digital Elevation model in the raster format IMG. It may also be a text file listing a set of raster IMG files when using trend surface options.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:DEMFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ElevacioSol</ows:Identifier>
				<ows:Title>Solar elevation</ows:Title>
				<ows:Abstract>Value or file which determines the solar elevation (except for Option 3 which uses the zenith angle). If a file is used, it must be a raster file type IMG but not necessarily of the same resolution as the output illumination model.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:SolarElev"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>AzimutSol</ows:Identifier>
				<ows:Title>Solar azimuth</ows:Title>
				<ows:Abstract>Value or file which determines the solar azimuth. If a file is used, it must be a raster file type IMG but not necessarily of the same resolution as the output illumination model.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:SolarAz"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>N_veins_o_grau</ows:Identifier>
				<ows:Title>N_neighb_or_degrees</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>4: 4 neighbors will be used for the calculation of the normal vector at each point. With this option, the generated illumination model output will be the same resolution and extent as the DEM.</li><li>8: 8 neighbors will be used for the calculation of the normal vector at each point. Output conditions are the same as with the 4 neighbor option.</li><li>9: The 8 neighbors plus the central cell (9 values) will be used to fit a plane (1st degree polynomial) for the calculation of the normal vector at each point; at least 3 of the 9 values are required. Output conditions are the same as with the 4 neighbor option.</li><li>1: A surface of local tendency of the 1st degree will be defined for each calculation of the normal vector at each point. In this option, the DEM has a greater spatial resolution (smaller pixel size) than the generated illumination model, which inherits the extent and the pixel size of the Reference file.</li><li>2: A surface of local tendency of the 2nd degree will be defined for each calculation of the normal vector at each point. Output conditions are the same as with Option 1.</li><li>3: A surface of local tendency of the 3rd degree will be defined for each calculation of the normal vector at each point. Output conditions are the same as with Option 1.</li><li>A or a: Autoadaptive mode. For each cell of the illumination model, the best local trend surface (1st, 2nd or 3rd degree) is chosen from the higher resolution DEM cells inside it. Output conditions are the same as with Option 1.</li><li>F or f: Finite elements mode. A plane (1st degree polynomial) is fitted to each group of 4 contiguous cells of the higher resolution DEM, provided at least 3 of the 4 cells have a value, and each cell of the illumination model is assigned the mean of the illuminations calculated inside it. Output conditions are the same as with Option 1.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:N_neighb_or_degrees"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
						<ows:Value>8</ows:Value>
						<ows:Value>9</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>MULTIBANDA</ows:Title>
				<ows:Abstract>If the DEM is multiband (normally of similar extent and different pixel sizes between bands), this parameter indicates that the desired output illumination model will also be multiband.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefix</ows:Title>
				<ows:Abstract>Defines a prefix to be affixed to the original file names in order to determine the names of the corrected files in the /MULTIBANDA case. By default this prefix is i_. The program only reads /PREFIX= when /MULTIBANDA is also specified; without /MULTIBANDA, /PREFIX= is left as an extra parameter and the command line is incorrect.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>i_</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VORA</ows:Identifier>
				<ows:Title>VORA</ows:Title>
				<ows:Abstract>Edge treatment of the raster in 4, 8 and 9 neighbor modes. Values: TEND (default) or IDEM.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>TEND</ows:Value>
						<ows:Value>IDEM</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FACTOR</ows:Identifier>
				<ows:Title>Factor</ows:Title>
				<ows:Abstract>Indicates the multiplicative factor for the unit values of the elevation and azimuth files to degrees. For example, for a raster where the units are decimal degrees, it is necessary to define /FACTOR=0.01. This parameter is optional (by default the factor is set to 1) and only is applicable to the principal options 2 and 3.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_MODELS_INTRACEL</ows:Identifier>
				<ows:Title>N_MODELS_INTRACEL</ows:Title>
				<ows:Abstract>Number of incidence angle models per cell in trend surface modes (must be a perfect square).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_REP_AUTOADAP</ows:Identifier>
				<ows:Title>N_REP_AUTOADAP</ows:Title>
				<ows:Abstract>Number of repetitions in autoadaptive mode to determine the best trend surface [1,100].</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALEAT_DIF</ows:Identifier>
				<ows:Title>ALEAT_DIF</ows:Title>
				<ows:Abstract>Enables a different random series in autoadaptive mode (by default the series is reproducible).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>INCR_PT_AJ</ows:Identifier>
				<ows:Title>INCR_PT_AJ</ows:Title>
				<ows:Abstract>Increment factor for the number of adjustment points in trend surface modes [1,100]; default 2.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TIPUS_RASTER</ows:Identifier>
				<ows:Title>TIPUS_RASTER</ows:Title>
				<ows:Abstract>Output file data type: 1 (byte, default) or 4 (real).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Resultat</ows:Identifier>
				<ows:Title>Output IMG</ows:Title>
				<ows:Abstract>Output illumination file in the raster format IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Illum:Param1:1&amp;Param7</ows:Identifier>
		<ows:Title>Constant elevation and azimuth (trend surface)</ows:Title>
		<ows:Abstract>Calculates illumination with constant solar elevation and azimuth and trend surface, autoadaptive or finite elements mode.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 1</ows:Title>
				<ows:Abstract>Elevation and azimuth are constant parameters for the file extent.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MDE</ows:Identifier>
				<ows:Title>Digital Elevation Model</ows:Title>
				<ows:Abstract>Digital Elevation model in the raster format IMG. It may also be a text file listing a set of raster IMG files when using trend surface options.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:DEMFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ElevacioSol</ows:Identifier>
				<ows:Title>Solar elevation</ows:Title>
				<ows:Abstract>Value or file which determines the solar elevation (except for Option 3 which uses the zenith angle). If a file is used, it must be a raster file type IMG but not necessarily of the same resolution as the output illumination model.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:SolarElev"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>AzimutSol</ows:Identifier>
				<ows:Title>Solar azimuth</ows:Title>
				<ows:Abstract>Value or file which determines the solar azimuth. If a file is used, it must be a raster file type IMG but not necessarily of the same resolution as the output illumination model.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:SolarAz"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>N_veins_o_grau</ows:Identifier>
				<ows:Title>N_neighb_or_degrees</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>4: 4 neighbors will be used for the calculation of the normal vector at each point. With this option, the generated illumination model output will be the same resolution and extent as the DEM.</li><li>8: 8 neighbors will be used for the calculation of the normal vector at each point. Output conditions are the same as with the 4 neighbor option.</li><li>9: The 8 neighbors plus the central cell (9 values) will be used to fit a plane (1st degree polynomial) for the calculation of the normal vector at each point; at least 3 of the 9 values are required. Output conditions are the same as with the 4 neighbor option.</li><li>1: A surface of local tendency of the 1st degree will be defined for each calculation of the normal vector at each point. In this option, the DEM has a greater spatial resolution (smaller pixel size) than the generated illumination model, which inherits the extent and the pixel size of the Reference file.</li><li>2: A surface of local tendency of the 2nd degree will be defined for each calculation of the normal vector at each point. Output conditions are the same as with Option 1.</li><li>3: A surface of local tendency of the 3rd degree will be defined for each calculation of the normal vector at each point. Output conditions are the same as with Option 1.</li><li>A or a: Autoadaptive mode. For each cell of the illumination model, the best local trend surface (1st, 2nd or 3rd degree) is chosen from the higher resolution DEM cells inside it. Output conditions are the same as with Option 1.</li><li>F or f: Finite elements mode. A plane (1st degree polynomial) is fitted to each group of 4 contiguous cells of the higher resolution DEM, provided at least 3 of the 4 cells have a value, and each cell of the illumination model is assigned the mean of the illuminations calculated inside it. Output conditions are the same as with Option 1.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:N_neighb_or_degrees"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>A</ows:Value>
						<ows:Value>a</ows:Value>
						<ows:Value>F</ows:Value>
						<ows:Value>f</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Patro</ows:Identifier>
				<ows:Title>Reference</ows:Title>
				<ows:Abstract>Obligatory parameter for options 1, 2, 3, A and F of N_neighb_or_degrees, which indicates the raster reference file that defines the extent and pixel size of the output illumination model.</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:Reference"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>MULTIBANDA</ows:Title>
				<ows:Abstract>If the DEM is multiband (normally of similar extent and different pixel sizes between bands), this parameter indicates that the desired output illumination model will also be multiband.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefix</ows:Title>
				<ows:Abstract>Defines a prefix to be affixed to the original file names in order to determine the names of the corrected files in the /MULTIBANDA case. By default this prefix is i_. The program only reads /PREFIX= when /MULTIBANDA is also specified; without /MULTIBANDA, /PREFIX= is left as an extra parameter and the command line is incorrect.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>i_</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VORA</ows:Identifier>
				<ows:Title>VORA</ows:Title>
				<ows:Abstract>Edge treatment of the raster in 4, 8 and 9 neighbor modes. Values: TEND (default) or IDEM.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>TEND</ows:Value>
						<ows:Value>IDEM</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FACTOR</ows:Identifier>
				<ows:Title>Factor</ows:Title>
				<ows:Abstract>Indicates the multiplicative factor for the unit values of the elevation and azimuth files to degrees. For example, for a raster where the units are decimal degrees, it is necessary to define /FACTOR=0.01. This parameter is optional (by default the factor is set to 1) and only is applicable to the principal options 2 and 3.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_MODELS_INTRACEL</ows:Identifier>
				<ows:Title>N_MODELS_INTRACEL</ows:Title>
				<ows:Abstract>Number of incidence angle models per cell in trend surface modes (must be a perfect square).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_REP_AUTOADAP</ows:Identifier>
				<ows:Title>N_REP_AUTOADAP</ows:Title>
				<ows:Abstract>Number of repetitions in autoadaptive mode to determine the best trend surface [1,100].</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALEAT_DIF</ows:Identifier>
				<ows:Title>ALEAT_DIF</ows:Title>
				<ows:Abstract>Enables a different random series in autoadaptive mode (by default the series is reproducible).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>INCR_PT_AJ</ows:Identifier>
				<ows:Title>INCR_PT_AJ</ows:Title>
				<ows:Abstract>Increment factor for the number of adjustment points in trend surface modes [1,100]; default 2.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TIPUS_RASTER</ows:Identifier>
				<ows:Title>TIPUS_RASTER</ows:Title>
				<ows:Abstract>Output file data type: 1 (byte, default) or 4 (real).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Resultat</ows:Identifier>
				<ows:Title>Output IMG</ows:Title>
				<ows:Abstract>Output illumination file in the raster format IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Illum:Param1:2&amp;!Param7</ows:Identifier>
		<ows:Title>Elevation and azimuth as files (neighbors)</ows:Title>
		<ows:Abstract>Calculates illumination from solar elevation and azimuth raster files and 4, 8 or 9 neighbors.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 2</ows:Title>
				<ows:Abstract>Elevation and azimuth are raster files.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MDE</ows:Identifier>
				<ows:Title>Digital Elevation Model</ows:Title>
				<ows:Abstract>Digital Elevation model in the raster format IMG. It may also be a text file listing a set of raster IMG files when using trend surface options.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:DEMFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ElevacioSol</ows:Identifier>
				<ows:Title>Solar elevation</ows:Title>
				<ows:Abstract>Value or file which determines the solar elevation (except for Option 3 which uses the zenith angle). If a file is used, it must be a raster file type IMG but not necessarily of the same resolution as the output illumination model.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:SolarElev"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>AzimutSol</ows:Identifier>
				<ows:Title>Solar azimuth</ows:Title>
				<ows:Abstract>Value or file which determines the solar azimuth. If a file is used, it must be a raster file type IMG but not necessarily of the same resolution as the output illumination model.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:SolarAz"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>N_veins_o_grau</ows:Identifier>
				<ows:Title>N_neighb_or_degrees</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>4: 4 neighbors will be used for the calculation of the normal vector at each point. With this option, the generated illumination model output will be the same resolution and extent as the DEM.</li><li>8: 8 neighbors will be used for the calculation of the normal vector at each point. Output conditions are the same as with the 4 neighbor option.</li><li>9: The 8 neighbors plus the central cell (9 values) will be used to fit a plane (1st degree polynomial) for the calculation of the normal vector at each point; at least 3 of the 9 values are required. Output conditions are the same as with the 4 neighbor option.</li><li>1: A surface of local tendency of the 1st degree will be defined for each calculation of the normal vector at each point. In this option, the DEM has a greater spatial resolution (smaller pixel size) than the generated illumination model, which inherits the extent and the pixel size of the Reference file.</li><li>2: A surface of local tendency of the 2nd degree will be defined for each calculation of the normal vector at each point. Output conditions are the same as with Option 1.</li><li>3: A surface of local tendency of the 3rd degree will be defined for each calculation of the normal vector at each point. Output conditions are the same as with Option 1.</li><li>A or a: Autoadaptive mode. For each cell of the illumination model, the best local trend surface (1st, 2nd or 3rd degree) is chosen from the higher resolution DEM cells inside it. Output conditions are the same as with Option 1.</li><li>F or f: Finite elements mode. A plane (1st degree polynomial) is fitted to each group of 4 contiguous cells of the higher resolution DEM, provided at least 3 of the 4 cells have a value, and each cell of the illumination model is assigned the mean of the illuminations calculated inside it. Output conditions are the same as with Option 1.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:N_neighb_or_degrees"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
						<ows:Value>8</ows:Value>
						<ows:Value>9</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>MULTIBANDA</ows:Title>
				<ows:Abstract>If the DEM is multiband (normally of similar extent and different pixel sizes between bands), this parameter indicates that the desired output illumination model will also be multiband.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefix</ows:Title>
				<ows:Abstract>Defines a prefix to be affixed to the original file names in order to determine the names of the corrected files in the /MULTIBANDA case. By default this prefix is i_. The program only reads /PREFIX= when /MULTIBANDA is also specified; without /MULTIBANDA, /PREFIX= is left as an extra parameter and the command line is incorrect.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>i_</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VORA</ows:Identifier>
				<ows:Title>VORA</ows:Title>
				<ows:Abstract>Edge treatment of the raster in 4, 8 and 9 neighbor modes. Values: TEND (default) or IDEM.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>TEND</ows:Value>
						<ows:Value>IDEM</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FACTOR</ows:Identifier>
				<ows:Title>Factor</ows:Title>
				<ows:Abstract>Indicates the multiplicative factor for the unit values of the elevation and azimuth files to degrees. For example, for a raster where the units are decimal degrees, it is necessary to define /FACTOR=0.01. This parameter is optional (by default the factor is set to 1) and only is applicable to the principal options 2 and 3.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_MODELS_INTRACEL</ows:Identifier>
				<ows:Title>N_MODELS_INTRACEL</ows:Title>
				<ows:Abstract>Number of incidence angle models per cell in trend surface modes (must be a perfect square).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_REP_AUTOADAP</ows:Identifier>
				<ows:Title>N_REP_AUTOADAP</ows:Title>
				<ows:Abstract>Number of repetitions in autoadaptive mode to determine the best trend surface [1,100].</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALEAT_DIF</ows:Identifier>
				<ows:Title>ALEAT_DIF</ows:Title>
				<ows:Abstract>Enables a different random series in autoadaptive mode (by default the series is reproducible).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>INCR_PT_AJ</ows:Identifier>
				<ows:Title>INCR_PT_AJ</ows:Title>
				<ows:Abstract>Increment factor for the number of adjustment points in trend surface modes [1,100]; default 2.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TIPUS_RASTER</ows:Identifier>
				<ows:Title>TIPUS_RASTER</ows:Title>
				<ows:Abstract>Output file data type: 1 (byte, default) or 4 (real).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Resultat</ows:Identifier>
				<ows:Title>Output IMG</ows:Title>
				<ows:Abstract>Output illumination file in the raster format IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Illum:Param1:2&amp;Param7</ows:Identifier>
		<ows:Title>Elevation and azimuth as files (trend surface)</ows:Title>
		<ows:Abstract>Calculates illumination from solar elevation and azimuth raster files and trend surface, autoadaptive or finite elements mode.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 2</ows:Title>
				<ows:Abstract>Elevation and azimuth are raster files.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MDE</ows:Identifier>
				<ows:Title>Digital Elevation Model</ows:Title>
				<ows:Abstract>Digital Elevation model in the raster format IMG. It may also be a text file listing a set of raster IMG files when using trend surface options.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:DEMFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ElevacioSol</ows:Identifier>
				<ows:Title>Solar elevation</ows:Title>
				<ows:Abstract>Value or file which determines the solar elevation (except for Option 3 which uses the zenith angle). If a file is used, it must be a raster file type IMG but not necessarily of the same resolution as the output illumination model.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:SolarElev"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>AzimutSol</ows:Identifier>
				<ows:Title>Solar azimuth</ows:Title>
				<ows:Abstract>Value or file which determines the solar azimuth. If a file is used, it must be a raster file type IMG but not necessarily of the same resolution as the output illumination model.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:SolarAz"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>N_veins_o_grau</ows:Identifier>
				<ows:Title>N_neighb_or_degrees</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>4: 4 neighbors will be used for the calculation of the normal vector at each point. With this option, the generated illumination model output will be the same resolution and extent as the DEM.</li><li>8: 8 neighbors will be used for the calculation of the normal vector at each point. Output conditions are the same as with the 4 neighbor option.</li><li>9: The 8 neighbors plus the central cell (9 values) will be used to fit a plane (1st degree polynomial) for the calculation of the normal vector at each point; at least 3 of the 9 values are required. Output conditions are the same as with the 4 neighbor option.</li><li>1: A surface of local tendency of the 1st degree will be defined for each calculation of the normal vector at each point. In this option, the DEM has a greater spatial resolution (smaller pixel size) than the generated illumination model, which inherits the extent and the pixel size of the Reference file.</li><li>2: A surface of local tendency of the 2nd degree will be defined for each calculation of the normal vector at each point. Output conditions are the same as with Option 1.</li><li>3: A surface of local tendency of the 3rd degree will be defined for each calculation of the normal vector at each point. Output conditions are the same as with Option 1.</li><li>A or a: Autoadaptive mode. For each cell of the illumination model, the best local trend surface (1st, 2nd or 3rd degree) is chosen from the higher resolution DEM cells inside it. Output conditions are the same as with Option 1.</li><li>F or f: Finite elements mode. A plane (1st degree polynomial) is fitted to each group of 4 contiguous cells of the higher resolution DEM, provided at least 3 of the 4 cells have a value, and each cell of the illumination model is assigned the mean of the illuminations calculated inside it. Output conditions are the same as with Option 1.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:N_neighb_or_degrees"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>A</ows:Value>
						<ows:Value>a</ows:Value>
						<ows:Value>F</ows:Value>
						<ows:Value>f</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Patro</ows:Identifier>
				<ows:Title>Reference</ows:Title>
				<ows:Abstract>Obligatory parameter for options 1, 2, 3, A and F of N_neighb_or_degrees, which indicates the raster reference file that defines the extent and pixel size of the output illumination model.</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:Reference"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>MULTIBANDA</ows:Title>
				<ows:Abstract>If the DEM is multiband (normally of similar extent and different pixel sizes between bands), this parameter indicates that the desired output illumination model will also be multiband.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefix</ows:Title>
				<ows:Abstract>Defines a prefix to be affixed to the original file names in order to determine the names of the corrected files in the /MULTIBANDA case. By default this prefix is i_. The program only reads /PREFIX= when /MULTIBANDA is also specified; without /MULTIBANDA, /PREFIX= is left as an extra parameter and the command line is incorrect.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>i_</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VORA</ows:Identifier>
				<ows:Title>VORA</ows:Title>
				<ows:Abstract>Edge treatment of the raster in 4, 8 and 9 neighbor modes. Values: TEND (default) or IDEM.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>TEND</ows:Value>
						<ows:Value>IDEM</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FACTOR</ows:Identifier>
				<ows:Title>Factor</ows:Title>
				<ows:Abstract>Indicates the multiplicative factor for the unit values of the elevation and azimuth files to degrees. For example, for a raster where the units are decimal degrees, it is necessary to define /FACTOR=0.01. This parameter is optional (by default the factor is set to 1) and only is applicable to the principal options 2 and 3.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_MODELS_INTRACEL</ows:Identifier>
				<ows:Title>N_MODELS_INTRACEL</ows:Title>
				<ows:Abstract>Number of incidence angle models per cell in trend surface modes (must be a perfect square).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_REP_AUTOADAP</ows:Identifier>
				<ows:Title>N_REP_AUTOADAP</ows:Title>
				<ows:Abstract>Number of repetitions in autoadaptive mode to determine the best trend surface [1,100].</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALEAT_DIF</ows:Identifier>
				<ows:Title>ALEAT_DIF</ows:Title>
				<ows:Abstract>Enables a different random series in autoadaptive mode (by default the series is reproducible).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>INCR_PT_AJ</ows:Identifier>
				<ows:Title>INCR_PT_AJ</ows:Title>
				<ows:Abstract>Increment factor for the number of adjustment points in trend surface modes [1,100]; default 2.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TIPUS_RASTER</ows:Identifier>
				<ows:Title>TIPUS_RASTER</ows:Title>
				<ows:Abstract>Output file data type: 1 (byte, default) or 4 (real).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Resultat</ows:Identifier>
				<ows:Title>Output IMG</ows:Title>
				<ows:Abstract>Output illumination file in the raster format IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Illum:Param1:3&amp;!Param7</ows:Identifier>
		<ows:Title>Zenith angles as file (neighbors)</ows:Title>
		<ows:Abstract>Calculates illumination from zenith angle and solar azimuth raster files and 4, 8 or 9 neighbors.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 3</ows:Title>
				<ows:Abstract>Variation of Option 2, where a file of relative solar angles with respect to zenith is specified instead of a file with respect to the horizon (elevation). The zenith angle and the elevation angle are complimentary.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MDE</ows:Identifier>
				<ows:Title>Digital Elevation Model</ows:Title>
				<ows:Abstract>Digital Elevation model in the raster format IMG. It may also be a text file listing a set of raster IMG files when using trend surface options.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:DEMFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ElevacioSol</ows:Identifier>
				<ows:Title>Solar elevation</ows:Title>
				<ows:Abstract>Value or file which determines the solar elevation (except for Option 3 which uses the zenith angle). If a file is used, it must be a raster file type IMG but not necessarily of the same resolution as the output illumination model.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:SolarElev"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>AzimutSol</ows:Identifier>
				<ows:Title>Solar azimuth</ows:Title>
				<ows:Abstract>Value or file which determines the solar azimuth. If a file is used, it must be a raster file type IMG but not necessarily of the same resolution as the output illumination model.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:SolarAz"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>N_veins_o_grau</ows:Identifier>
				<ows:Title>N_neighb_or_degrees</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>4: 4 neighbors will be used for the calculation of the normal vector at each point. With this option, the generated illumination model output will be the same resolution and extent as the DEM.</li><li>8: 8 neighbors will be used for the calculation of the normal vector at each point. Output conditions are the same as with the 4 neighbor option.</li><li>9: The 8 neighbors plus the central cell (9 values) will be used to fit a plane (1st degree polynomial) for the calculation of the normal vector at each point; at least 3 of the 9 values are required. Output conditions are the same as with the 4 neighbor option.</li><li>1: A surface of local tendency of the 1st degree will be defined for each calculation of the normal vector at each point. In this option, the DEM has a greater spatial resolution (smaller pixel size) than the generated illumination model, which inherits the extent and the pixel size of the Reference file.</li><li>2: A surface of local tendency of the 2nd degree will be defined for each calculation of the normal vector at each point. Output conditions are the same as with Option 1.</li><li>3: A surface of local tendency of the 3rd degree will be defined for each calculation of the normal vector at each point. Output conditions are the same as with Option 1.</li><li>A or a: Autoadaptive mode. For each cell of the illumination model, the best local trend surface (1st, 2nd or 3rd degree) is chosen from the higher resolution DEM cells inside it. Output conditions are the same as with Option 1.</li><li>F or f: Finite elements mode. A plane (1st degree polynomial) is fitted to each group of 4 contiguous cells of the higher resolution DEM, provided at least 3 of the 4 cells have a value, and each cell of the illumination model is assigned the mean of the illuminations calculated inside it. Output conditions are the same as with Option 1.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:N_neighb_or_degrees"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
						<ows:Value>8</ows:Value>
						<ows:Value>9</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>MULTIBANDA</ows:Title>
				<ows:Abstract>If the DEM is multiband (normally of similar extent and different pixel sizes between bands), this parameter indicates that the desired output illumination model will also be multiband.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefix</ows:Title>
				<ows:Abstract>Defines a prefix to be affixed to the original file names in order to determine the names of the corrected files in the /MULTIBANDA case. By default this prefix is i_. The program only reads /PREFIX= when /MULTIBANDA is also specified; without /MULTIBANDA, /PREFIX= is left as an extra parameter and the command line is incorrect.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>i_</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VORA</ows:Identifier>
				<ows:Title>VORA</ows:Title>
				<ows:Abstract>Edge treatment of the raster in 4, 8 and 9 neighbor modes. Values: TEND (default) or IDEM.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>TEND</ows:Value>
						<ows:Value>IDEM</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FACTOR</ows:Identifier>
				<ows:Title>Factor</ows:Title>
				<ows:Abstract>Indicates the multiplicative factor for the unit values of the elevation and azimuth files to degrees. For example, for a raster where the units are decimal degrees, it is necessary to define /FACTOR=0.01. This parameter is optional (by default the factor is set to 1) and only is applicable to the principal options 2 and 3.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_MODELS_INTRACEL</ows:Identifier>
				<ows:Title>N_MODELS_INTRACEL</ows:Title>
				<ows:Abstract>Number of incidence angle models per cell in trend surface modes (must be a perfect square).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_REP_AUTOADAP</ows:Identifier>
				<ows:Title>N_REP_AUTOADAP</ows:Title>
				<ows:Abstract>Number of repetitions in autoadaptive mode to determine the best trend surface [1,100].</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALEAT_DIF</ows:Identifier>
				<ows:Title>ALEAT_DIF</ows:Title>
				<ows:Abstract>Enables a different random series in autoadaptive mode (by default the series is reproducible).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>INCR_PT_AJ</ows:Identifier>
				<ows:Title>INCR_PT_AJ</ows:Title>
				<ows:Abstract>Increment factor for the number of adjustment points in trend surface modes [1,100]; default 2.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TIPUS_RASTER</ows:Identifier>
				<ows:Title>TIPUS_RASTER</ows:Title>
				<ows:Abstract>Output file data type: 1 (byte, default) or 4 (real).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Resultat</ows:Identifier>
				<ows:Title>Output IMG</ows:Title>
				<ows:Abstract>Output illumination file in the raster format IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Illum:Param1:3&amp;Param7</ows:Identifier>
		<ows:Title>Zenith angles as file (trend surface)</ows:Title>
		<ows:Abstract>Calculates illumination from zenith angle and solar azimuth raster files and trend surface, autoadaptive or finite elements mode.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 3</ows:Title>
				<ows:Abstract>Variation of Option 2, where a file of relative solar angles with respect to zenith is specified instead of a file with respect to the horizon (elevation). The zenith angle and the elevation angle are complimentary.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MDE</ows:Identifier>
				<ows:Title>Digital Elevation Model</ows:Title>
				<ows:Abstract>Digital Elevation model in the raster format IMG. It may also be a text file listing a set of raster IMG files when using trend surface options.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:DEMFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ElevacioSol</ows:Identifier>
				<ows:Title>Solar elevation</ows:Title>
				<ows:Abstract>Value or file which determines the solar elevation (except for Option 3 which uses the zenith angle). If a file is used, it must be a raster file type IMG but not necessarily of the same resolution as the output illumination model.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:SolarElev"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>AzimutSol</ows:Identifier>
				<ows:Title>Solar azimuth</ows:Title>
				<ows:Abstract>Value or file which determines the solar azimuth. If a file is used, it must be a raster file type IMG but not necessarily of the same resolution as the output illumination model.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:SolarAz"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>N_veins_o_grau</ows:Identifier>
				<ows:Title>N_neighb_or_degrees</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>4: 4 neighbors will be used for the calculation of the normal vector at each point. With this option, the generated illumination model output will be the same resolution and extent as the DEM.</li><li>8: 8 neighbors will be used for the calculation of the normal vector at each point. Output conditions are the same as with the 4 neighbor option.</li><li>9: The 8 neighbors plus the central cell (9 values) will be used to fit a plane (1st degree polynomial) for the calculation of the normal vector at each point; at least 3 of the 9 values are required. Output conditions are the same as with the 4 neighbor option.</li><li>1: A surface of local tendency of the 1st degree will be defined for each calculation of the normal vector at each point. In this option, the DEM has a greater spatial resolution (smaller pixel size) than the generated illumination model, which inherits the extent and the pixel size of the Reference file.</li><li>2: A surface of local tendency of the 2nd degree will be defined for each calculation of the normal vector at each point. Output conditions are the same as with Option 1.</li><li>3: A surface of local tendency of the 3rd degree will be defined for each calculation of the normal vector at each point. Output conditions are the same as with Option 1.</li><li>A or a: Autoadaptive mode. For each cell of the illumination model, the best local trend surface (1st, 2nd or 3rd degree) is chosen from the higher resolution DEM cells inside it. Output conditions are the same as with Option 1.</li><li>F or f: Finite elements mode. A plane (1st degree polynomial) is fitted to each group of 4 contiguous cells of the higher resolution DEM, provided at least 3 of the 4 cells have a value, and each cell of the illumination model is assigned the mean of the illuminations calculated inside it. Output conditions are the same as with Option 1.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:N_neighb_or_degrees"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>A</ows:Value>
						<ows:Value>a</ows:Value>
						<ows:Value>F</ows:Value>
						<ows:Value>f</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Patro</ows:Identifier>
				<ows:Title>Reference</ows:Title>
				<ows:Abstract>Obligatory parameter for options 1, 2, 3, A and F of N_neighb_or_degrees, which indicates the raster reference file that defines the extent and pixel size of the output illumination model.</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:Reference"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>MULTIBANDA</ows:Title>
				<ows:Abstract>If the DEM is multiband (normally of similar extent and different pixel sizes between bands), this parameter indicates that the desired output illumination model will also be multiband.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefix</ows:Title>
				<ows:Abstract>Defines a prefix to be affixed to the original file names in order to determine the names of the corrected files in the /MULTIBANDA case. By default this prefix is i_. The program only reads /PREFIX= when /MULTIBANDA is also specified; without /MULTIBANDA, /PREFIX= is left as an extra parameter and the command line is incorrect.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>i_</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VORA</ows:Identifier>
				<ows:Title>VORA</ows:Title>
				<ows:Abstract>Edge treatment of the raster in 4, 8 and 9 neighbor modes. Values: TEND (default) or IDEM.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>TEND</ows:Value>
						<ows:Value>IDEM</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FACTOR</ows:Identifier>
				<ows:Title>Factor</ows:Title>
				<ows:Abstract>Indicates the multiplicative factor for the unit values of the elevation and azimuth files to degrees. For example, for a raster where the units are decimal degrees, it is necessary to define /FACTOR=0.01. This parameter is optional (by default the factor is set to 1) and only is applicable to the principal options 2 and 3.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_MODELS_INTRACEL</ows:Identifier>
				<ows:Title>N_MODELS_INTRACEL</ows:Title>
				<ows:Abstract>Number of incidence angle models per cell in trend surface modes (must be a perfect square).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_REP_AUTOADAP</ows:Identifier>
				<ows:Title>N_REP_AUTOADAP</ows:Title>
				<ows:Abstract>Number of repetitions in autoadaptive mode to determine the best trend surface [1,100].</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALEAT_DIF</ows:Identifier>
				<ows:Title>ALEAT_DIF</ows:Title>
				<ows:Abstract>Enables a different random series in autoadaptive mode (by default the series is reproducible).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>INCR_PT_AJ</ows:Identifier>
				<ows:Title>INCR_PT_AJ</ows:Title>
				<ows:Abstract>Increment factor for the number of adjustment points in trend surface modes [1,100]; default 2.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TIPUS_RASTER</ows:Identifier>
				<ows:Title>TIPUS_RASTER</ows:Title>
				<ows:Abstract>Output file data type: 1 (byte, default) or 4 (real).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Resultat</ows:Identifier>
				<ows:Title>Output IMG</ows:Title>
				<ows:Abstract>Output illumination file in the raster format IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>