<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:EscalVEC:param1:1</ows:Identifier>
		<ows:Title>EscalVEC 1</ows:Title>
		<ows:Abstract>Escalat general.</ows:Abstract>
	<ows:Metadata xlink:title="Title:Escalat i desplaçament de fitxers VEC"/>
<ows:Metadata xlink:title="Abstract:Realitza l'escalat o el canvi d'escala de fitxers vectorials en format VEC. També permet canviar coordenades mapa a coordenades paper com a pas anterior a l'exportació cap a alguns paquets de dibuix."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>1. Escalat general. El desplaçament en X i en Y (DesplaçX i DesplaçY) s'aplica després de l'Escalat. Unitats permet escriure al doc les noves unitats (pots ser x per deixar les prèvies).</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOri</ows:Identifier>
				<ows:Title>Fitxer Origen</ows:Title>
				<ows:Abstract>És el nom del fitxer d'entrada a reescalar.
</ows:Abstract>
			<ows:Metadata xlink:title="Param2" />
			<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-VEC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
					<MimeType>application/x-VEC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Escalat</ows:Identifier>
				<ows:Title>Escalat</ows:Title>
				<ows:Abstract>factor d'escalat.
</ows:Abstract>
			<ows:Metadata xlink:title="Param4" />
	<LiteralData>
		<ows:AllowedValues>
		<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
		<ows:AnyValue/>
		</ows:AllowedValues>
	</LiteralData>
			</Input>			
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Unitats</ows:Identifier>
				<ows:Title>Unitats</ows:Title>
				<ows:Abstract>Unitats són les noves unitats:<![CDATA[
        <ul><li>mm (mil·límetres)</li>
        <li>cm (centímetres)</li>
        <li>pz o inch (polzades)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param5" />
				<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
						<ows:Value>mm</ows:Value>
						<ows:Value>cm</ows:Value>
						<ows:Value>pz</ows:Value>
						<ows:Value>inch</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DesplaçX</ows:Identifier>
				<ows:Title>Desplaç X</ows:Title>
				<ows:Abstract>desplaçament X</ows:Abstract>
				<ows:Metadata xlink:title="Param6" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AllowedValues>
						<ows:AnyValue/>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DesplaçY</ows:Identifier>
				<ows:Title>Desplaç Y</ows:Title>
				<ows:Abstract>desplaçament Y</ows:Abstract>
				<ows:Metadata xlink:title="Param7" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AllowedValues>
						<ows:AnyValue/>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Precisio</ows:Identifier>
				<ows:Title>Precisió</ows:Title>
				<ows:Abstract>És el nombre de decimals escrits al fitxer de sortida; per defecte val 3.</ows:Abstract>
			<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
						<ows:AnyValue/>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ESCALAT_Z</ows:Identifier>
				<ows:Title>ESCALAT_Z</ows:Title>
				<ows:Abstract>És l'escalat en Z quan el fitxer és un VEC 3D. 
</ows:Abstract>
	<LiteralData>
	<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
		<ows:AllowedValues>
		<ows:AnyValue/>
		</ows:AllowedValues>
	</LiteralData>
			</Input>				
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DESPLAC_Z</ows:Identifier>
				<ows:Title>DESPLAC_Z</ows:Title>
				<ows:Abstract>És el desplaçament en Z quan el fitxer és un VEC 3D. 
</ows:Abstract>
	<LiteralData>
	<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
		<ows:AllowedValues>
		<ows:AnyValue/>
		</ows:AllowedValues>
	</LiteralData>
			</Input>						
</DataInputs>
	<ProcessOutputs>	
		<Output>
				<ows:Identifier>FitxerDest</ows:Identifier>
				<ows:Title>Ràster Diferencies</ows:Title>
				<ows:Abstract>Ràster en format IMG de reals amb les diferències entre el MDT i els valors interpolats localment. 
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
				<ComplexOutput>
					<Default>
							<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:EscalVEC:param1:2</ows:Identifier>
		<ows:Title>EscalVEC 2</ows:Title>
		<ows:Abstract>Canvi d'escala.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>2. Canvi d'escala.
</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOri</ows:Identifier>
				<ows:Title>Fitxer Origen</ows:Title>
				<ows:Abstract>És el nom del fitxer d'entrada a reescalar.
</ows:Abstract>
			<ows:Metadata xlink:title="Param2" />
			<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-VEC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
					<MimeType>application/x-VEC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Escala</ows:Identifier>
				<ows:Title>Escala</ows:Title>
				<ows:Abstract>És el denominador de la nova escala: (p.ex.: 50000) 
</ows:Abstract>
			<ows:Metadata xlink:title="Param4" />
	<LiteralData>
	<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
		<ows:AllowedValues>
		<ows:AnyValue/>
		</ows:AllowedValues>
	</LiteralData>
			</Input>			
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Unitats</ows:Identifier>
				<ows:Title>Unitats</ows:Title>
				<ows:Abstract>Unitats són les noves unitats:<![CDATA[
        <ul><li>mm (mil·límetres)</li>
        <li>cm (centímetres)</li>
        <li>pz o inch (polzades)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param5" />
				<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
						<ows:Value>mm</ows:Value>
						<ows:Value>cm</ows:Value>
						<ows:Value>pz</ows:Value>
						<ows:Value>inch</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Xmin</ows:Identifier>
				<ows:Title>X minima</ows:Title>
				<ows:Abstract>Coordenada Xmin.</ows:Abstract>
				<ows:Metadata xlink:title="Param6" />
			<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Ymin</ows:Identifier>
				<ows:Title>Y minima</ows:Title>
				<ows:Abstract>Coordenada Ymin. Les coordenades Ymin  i Xmin són les coordenades actuals que passaran a tenir situació 0,0. Podeu usar nombres o utilitzar alguna de les coordenades extremes del fitxer escrivint, per exemple, 'Xmin Ymin' o bé 'Xmin Ymax'.</ows:Abstract>
				<ows:Metadata xlink:title="Param7" />
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Precisio</ows:Identifier>
				<ows:Title>Precisió</ows:Title>
				<ows:Abstract>És el nombre de decimals escrits al fitxer de sortida; per defecte val 3.</ows:Abstract>
			<LiteralData>
			<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:AnyValue/>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ESCALAT_Z</ows:Identifier>
				<ows:Title>ESCALAT_Z</ows:Title>
				<ows:Abstract>És l'escalat en Z quan el fitxer és un VEC 3D. 
</ows:Abstract>
	<LiteralData>
	<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
		<ows:AllowedValues>
		<ows:AnyValue/>
		</ows:AllowedValues>
	</LiteralData>
			</Input>				
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DESPLAC_Z</ows:Identifier>
				<ows:Title>DESPLAC_Z</ows:Title>
				<ows:Abstract>És el desplaçament en Z quan el fitxer és un VEC 3D. 
</ows:Abstract>
	<LiteralData>
	<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
		<ows:AllowedValues>
		<ows:AnyValue/>
		</ows:AllowedValues>
	</LiteralData>
			</Input>						
</DataInputs>
	<ProcessOutputs>	
		<Output>
				<ows:Identifier>FitxerDest</ows:Identifier>
				<ows:Title>Ràster Diferencies</ows:Title>
				<ows:Abstract>Ràster en format IMG de reals amb les diferències entre el MDT i els valors interpolats localment. 
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
				<ComplexOutput>
					<Default>
							<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
