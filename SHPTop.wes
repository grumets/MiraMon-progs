<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SHPTop:Param1:0</ows:Identifier>
		<ows:Title>Información SHP</ows:Title>
		<ows:Abstract>La opción 0 muestra información sobre el fichero SHP.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversión de ficheros Shapefile a ficheros topológicos de MiraMon"/>
		<ows:Metadata xlink:title="Abstract:Este programa convierte un fichero SHP (Shapefile) de ArcView al formato topológico de MiraMon (PNT, ARC/NOD, POL) y vice-versa."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Información</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerSHP</ows:Identifier>
				<ows:Title>Fichero Shapefile</ows:Title>
				<ows:Abstract>Es el nombre del fichero SHP a importar, sin extensión.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroSHP"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Stdout</ows:Identifier>
				<ows:Title>Estandard de salida</ows:Title>
				<ows:Abstract>Información sobre los archivos shapefile</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SHPTop:Param1:1</ows:Identifier>
		<ows:Title>Importación y estructuración topológica</ows:Title>
		<ows:Abstract>La opción 1 del programa importa un fichero SHP de polílíneas y genera topología arco/nodo, eliminando intersecciones y superposiciones. Para ficheros SHP de polígonos, se genera, además, topología de polígonos; el fichero de arcos no presenta bordes duplicados (el fichero de arcos és más pequeño) y el fichero de polígonos no presenta superposiciones. También es posible eliminar a los eventuales micropolígonos. Esta opción es la recomendada.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Importación al formato de MiraMon y estructuración topológica (recomendado).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerSHP</ows:Identifier>
				<ows:Title>Fichero Shapefile</ows:Title>
				<ows:Abstract>Es el nombre del fichero SHP a importar, sin extensión.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroSHP"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>AREA_MIN</ows:Identifier>
				<ows:Title>Area Mínima</ows:Title>
				<ows:Abstract>Área mínima permitida para un polígono.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>AREA_PERI_MIN</ows:Identifier>
				<ows:Title>Area perímetro mínima</ows:Title>
				<ows:Abstract>Relación área/perímetro mínima permitida.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NEXE_CRITERIS</ows:Identifier>
				<ows:Title>Criterios de nexo</ows:Title>
				<ows:Abstract>En caso de indicar los dos criterios, eliminar los polígonos que cumplen ambas condiciones simultáneamente (AND), o los que cumplen solamente una (OR). El valor por defecto es AND.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>AND</ows:Value>
						<ows:Value>OR</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FONDRE</ows:Identifier>
				<ows:Title>Fundir micropolígonos</ows:Title>
				<ows:Abstract>Indica a qué polígono se le asigna el espacio ocupado por el micropolígono que desaparece. Indique POL_GRAN si quiere asignar el espacio al polígono contiguo de área más grande. El valor por defecto es FRONTERA_MES_LLARGA, que quiere decir que se elimina el arco más largo del micropolígono que desaparece.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>POL_GRAN</ows:Value>
						<ows:Value>FRONTERA_MES_LLARGA</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ATRIB_ELIM</ows:Identifier>
				<ows:Title>Eliminar por atributo</ows:Title>
				<ows:Abstract>El polígono que absorbe al micropolígono hereda sus atributos si el valor es 1. El valor por defecto es 0, que quiere decir que los atributos del micropolígono se pierden.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALGORISME</ows:Identifier>
				<ows:Title>Algoritmo</ows:Title>
				<ows:Abstract><![CDATA[Éste parámetro sirve para determinar el tipo de algortimo que la aplicación usará para recortar los vectores durante la estructuración topológica. <ul><li>ESCOMBRATGE: basado en la intersección de segmentos de Bentley-Ottmann. </li><li>DIRECTE: basado en la exploración de todos los segmentos contra todos para determinar las intersecciones entre vectores en la estructuración topológica.</li><li> AUTOMATIC: el programa decide automáticamente qual de los dos algoritmos usará. </li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>ESCOMBRATGE</ows:Value>
						<ows:Value>DIRECTE</ows:Value>
						<ows:Value>AUTOMATIC</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>AUTOMATIC</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIMPLIFICA_VERTEXS</ows:Identifier>
				<ows:Title>Simplifica vértices</ows:Title>
				<ows:Abstract>Simplifica los vértices intermedios de los arcos, sempre  que esto no signifiqui un cambio en la topologia.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ESCALAT</ows:Identifier>
				<ows:Title>Escalado</ows:Title>
				<ows:Abstract>Es el escalado aplicado a las coordenadas X,Y. Por defecto vale 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_X</ows:Identifier>
				<ows:Title>Desplazamiento X</ows:Title>
				<ows:Abstract>Es el desplazamiento aplicado a las coordenadas X. Por defecto vale 0.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_Y</ows:Identifier>
				<ows:Title>Desplazamiento Y</ows:Title>
				<ows:Abstract>Es el desplazamiento aplicado a las coordenadas X. Por defecto vale 0.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SLD</ows:Identifier>
				<ows:Title>Fichero SLD</ows:Title>
				<ows:Abstract>Fichero de simbologia en formato SLD (Styled Layer Descriptor).</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/vnd.ogc.sld+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/vnd.ogc.sld+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerTOP</ows:Identifier>
				<ows:Title>Fichero TOP</ows:Title>
				<ows:Abstract>Es el nombre, sin extensión, del fichero de salida. La extensión de salida la decide el programa en función del tipo de capa SHP indicada.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroTOP"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SHPTop:Param1:2</ows:Identifier>
		<ows:Title>Importación</ows:Title>
		<ows:Abstract>La opción 2 del programa realiza una simple importación del formato sin modificar la geometría o la topología de las entidades gráficas. Para ficheros SHP de polilíneas, se generan ficheros ARC/NOD que pueden presentar intersecciones entre líneas, superposiciones y otras situaciones no deseadas en un modelo topológico. Para ficheros SHP de polígonos, se genera un fichero ARC donde cada polígono SHP se representa mediante un arco cerrado con el borde del polígono (o más de un arco si este polígono contiene agujeros o enclaves exteriores) y, por tanto, los bordes de polígonos pueden estar duplicados si los polígonos son adyacentes (como pasa en el fichero SHP). También se genera un fichero de grupos de polígonos no topológicos POL (polígonos explícitos) en el mismo orden en que están en el fichero SHP. Al no realizar ninguna transformación, este proceso es más rápido que el correspondiente a la opción 1 y puede ser visualizado con MiraMon igualmente; asimismo, al no contener información topológica, las herramientas de análisis pueden no aceptarlos como entrada. Construir topología sobre este fichero implicaría el uso combinado de las herramientas de estructuración topológica: estructurar los arcos con LINARC y, si el fichero es de polígonos, hacer un nuevo ciclado de polígonos con CICLAR y transferir los atributos entre polígonos con ATRITOP.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Importación al formato de MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerSHP</ows:Identifier>
				<ows:Title>Fichero Shapefile</ows:Title>
				<ows:Abstract>Es el nombre del fichero SHP a importar, sin extensión.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroSHP"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ESCALAT</ows:Identifier>
				<ows:Title>Escalado</ows:Title>
				<ows:Abstract>Es el escalado aplicado a las coordenadas X,Y. Por defecto vale 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_X</ows:Identifier>
				<ows:Title>Desplazamiento X</ows:Title>
				<ows:Abstract>Es el desplazamiento aplicado a las coordenadas X. Por defecto vale 0.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_Y</ows:Identifier>
				<ows:Title>Desplazamiento Y</ows:Title>
				<ows:Abstract>Es el desplazamiento aplicado a las coordenadas X. Por defecto vale 0.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SLD</ows:Identifier>
				<ows:Title>Fichero SLD</ows:Title>
				<ows:Abstract>Fichero de simbologia en formato SLD (Styled Layer Descriptor).</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/vnd.ogc.sld+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/vnd.ogc.sld+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerTOP</ows:Identifier>
				<ows:Title>Fichero TOP</ows:Title>
				<ows:Abstract>Es el nombre, sin extensión, del fichero de salida. La extensión de salida la decide el programa en función del tipo de capa SHP indicada.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroTOP"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SHPTop:Param1:3</ows:Identifier>
		<ows:Title>Exportación al formato de ArcView</ows:Title>
		<ows:Abstract>La opción 3 del programa exporta un fichero MiraMon (PNT, ARC/NOD, POL) a un fichero SHP (Shapefile) de ArcView generando tres dicheros con el mismo nombre y las extensiones SHP, SHX y DBF. La tabla principal se transforma en la tabla asociada al fichero SHP, eliminando el multiregistro según las especificaciones de la DBF del formato SHP i los campos geométrico-topológicos, propios del formato MiraMon.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Exportación al formato ArcView (SHP).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerTOPMM</ows:Identifier>
				<ows:Title>FicheroTOPMM</ows:Title>
				<ows:Abstract>FicheroTOPMM es el nombre, con extensión, del fichero a exportar: PNT, ARC o POL.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroTOPMM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ESCALAT</ows:Identifier>
				<ows:Title>Escalado</ows:Title>
				<ows:Abstract>Es el escalado aplicado a las coordenadas X,Y. Por defecto vale 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_X</ows:Identifier>
				<ows:Title>Desplazamiento X</ows:Title>
				<ows:Abstract>Es el desplazamiento aplicado a las coordenadas X. Por defecto vale 0.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_Y</ows:Identifier>
				<ows:Title>Desplazamiento Y</ows:Title>
				<ows:Abstract>Es el desplazamiento aplicado a las coordenadas X. Por defecto vale 0.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VULL_CAMPS_GEOTOPO</ows:Identifier>
				<ows:Title>Campos geométrico-topologicos</ows:Title>
				<ows:Abstract>Los campos geométrico-topologicos, propios de  formatos de MiraMon, se mantienen en la DBF del Shape. Por defecto estos campos són eliminados.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VULL_TAULES_ASSOCIADES</ows:Identifier>
				<ows:Title>Tablas asociadas</ows:Title>
				<ows:Abstract>Loscampos de las tablas asociadas se mantienen en la DBF del Shape (no en forma de tabla asociada). Se incluyen como máximo 255 campos. Por defecto estos campos no son exportados.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerSHPMM</ows:Identifier>
				<ows:Title>Fichero SHPMM</ows:Title>
				<ows:Abstract>Es el nombre del fichero SHP de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroSHPMM"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>