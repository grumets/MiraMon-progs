<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ANSIOEM:Param4</ows:Identifier>
		<ows:Title>ANSI-OEM-UTF8 conversion</ows:Title>
		<ows:Abstract>Converts file in plain text or in DBF format between ANSI (Windows), OEM-850 (DOS) and/or UTF-8  character sets. This way, they can be visualized and edited correctly either with Windows (notepad) or MS-DOS editors (as EDIT).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Program to convert files between ANSI (Windows), OEM (DOS) [Set 850] and UTF-8"/>
		<ows:Metadata xlink:title="Abstract:This program converts plain or DBF formatted text between ANSI (Windows), OEM-850 (DOS) and UTF-8character sets. This way, they can be visualized and edited correctly either with Windows (notepad) or MS-DOS editors (as EDIT). In addition, in the case of DBF text fields, the program allows to mark the file as belonging to any of these character sets (ANSI (Windows), OEM-850 (DOS))."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigen</ows:Identifier>
				<ows:Title>Input File</ows:Title>
				<ows:Abstract>Is the name of input file with the extension. In DBF extensions, only 'C' fields are translated. Other extensions are treated as text files and are fully translated.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:InputFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Mode</ows:Identifier>
				<ows:Title>Mode</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>0 ANSI -> OEM-850  (Borland conversion).</li><li>1 ANSI -> OEM-850 (Semi-Strict adaptation X. Pons - Recommended).</li><li>2 ANSI -> OEM-850 (Strict adaptation X. Pons).</li><li>3 OEM-850 -> ANSI (Borland conversion).</li><li>4 ANSI -> UTF-8.</li><li>5 OEM-850  (Borland conversion) -> UTF-8.</li><li>6 UTF-8 -> ANSI.</li><li>7 UTF-8 -> OEM-850  (Borland conversion).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Mode"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>7</ows:MaximumValue>
							<ows:Spacing>7</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Substitut</ows:Identifier>
				<ows:Title>Substitute</ows:Title>
				<ows:Abstract>Character used to fill non convertible characters (for ex.: "X", "_"). Only valid in modes 1 and 2. If it is not specified, it will be requested.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Substitute"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerResultat</ows:Identifier>
				<ows:Title>Output File</ows:Title>
				<ows:Abstract>Is the name of output file. The program adds the extension if it is omitted.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:OutputFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ANSIOEM:Param2</ows:Identifier>
		<ows:Title>ANSI-OEM-UTF8 Mark</ows:Title>
		<ows:Abstract>In the case of DBF text fields, the program allows to mark the file as OEM-850 (DOS), ANSI, UTF-8 or others character sets. This is especially useful when working with files with no specific mark (that is, marked as 0), usual in files created with former dBASE versions or with software that does not specify any particular character set. However, it must be kept in mind that marking a DBF table as belonging to a particular character set does NOT mean translating it. It is only a clue for knowing how it has to be interpreted.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>DBF file</ows:Title>
				<ows:Abstract>The name of DBF file. Only 'C' fields are translated. Other extensions are treated as text files and are fully translated.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:DBFFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>JocCarac</ows:Identifier>
				<ows:Title>Character Set</ows:Title>
				<ows:Abstract><![CDATA[Character set with which you want to mark the file: <ul><li>ANSI</li><li>OEM-850</li><li>UTF-8</li><li>any decimal value [0,255]</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:CharSet"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>ANSI</ows:Value>
						<ows:Value>OEM-850</ows:Value>
						<ows:Value>UTF-8</ows:Value>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>255</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>DBF file</ows:Title>
				<ows:Abstract>The name of DBF file. Only 'C' fields are translated. Other extensions are treated as text files and are fully translated.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:DBFFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>