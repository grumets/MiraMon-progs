<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:DensRas</ows:Identifier>
		<ows:Title>DensRas:Raster densification and dedensification</ows:Title>
		<ows:Abstract>This program changes the spatial resolution of a raster (densifies or dedensifies it, depending on the case), without exceeding the bounding box of the original raster and allowing, if necessary, a change of the origin grid. The procedure acts using one of the four resampling methods: nearest neighbor, 4 neighbors mode, bilinear interpolation, or bicubic interpolation. The program makes a careful treatment of the NoData value (it does not consider it in resampling: for example, if one of the 4 neighbors at the position of a cell in the new raster is NoData and the criterion is the mode, this mode will be calculated considering only the 3 neighbors with data).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Raster densification and dedensification"/>
		<ows:Metadata xlink:title="Abstract:This program changes the spatial resolution of a raster (densifies or dedensifies it, depending on the case), without exceeding the bounding box of the original raster and allowing, if necessary, a change of the origin grid. The procedure acts using one of the four resampling methods: nearest neighbor, 4 neighbors mode, bilinear interpolation, or bicubic interpolation. The program makes a careful treatment of the NoData value (it does not consider it in resampling: for example, if one of the 4 neighbors at the position of a cell in the new raster is NoData and the criterion is the mode, this mode will be calculated considering only the 3 neighbors with data)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RasterOriginal</ows:Identifier>
				<ows:Title>Original raster</ows:Title>
				<ows:Abstract>Name of the input raster file to densifier.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:OriginalRaster"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Xmin</ows:Identifier>
				<ows:Title>Minimum X</ows:Title>
				<ows:Abstract>Define the minimum X of the densified raster bounding box.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Xmin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Xmax</ows:Identifier>
				<ows:Title>Maximum X</ows:Title>
				<ows:Abstract>Define the maximum X of the densified raster bounding box.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Xmax"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Ymin</ows:Identifier>
				<ows:Title>Minimum Y</ows:Title>
				<ows:Abstract>Define the minimum Y of the densified raster bounding box.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Ymin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Ymax</ows:Identifier>
				<ows:Title>Maximum Y</ows:Title>
				<ows:Abstract>Define the maximum X of the densified raster bounding box.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:Ymax"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Cpix</ows:Identifier>
				<ows:Title>Cell side</ows:Title>
				<ows:Abstract><![CDATA[Cell side or pixel of the densified raster. If Xmax does not correspond to an integer value <i>n</i> such that Xmax=Xmin+n*Cpix, Xmax will be adapted accordingly. Similarly for Ymax.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:Spix"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Remostreig</ows:Identifier>
				<ows:Title>Resampling mode</ows:Title>
				<ows:Abstract>Points the resampling mode: 'V' for the nearest neighbor, 'M' for the 4 neighbors mode, 'L' for bilineal interpolation and 'C' for bicubic interpolation interpolation.</ows:Abstract>
				<ows:Metadata xlink:title="Param8"/>
				<ows:Metadata xlink:title="Name:Resampling"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>V</ows:Value>
						<ows:Value>M</ows:Value>
						<ows:Value>L</ows:Value>
						<ows:Value>C</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>RasterDensificat</ows:Identifier>
				<ows:Title>Densified raster</ows:Title>
				<ows:Abstract>Name of the densified raster file. If not indicated, it is assumed that both files have img extension.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:DensifiedRaster"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>