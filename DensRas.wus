<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:DensRas</ows:Identifier>
		<ows:Title>DensRas:Densification of rasters</ows:Title>
		<ows:Abstract><![CDATA[This program changes the spatial resolution of a raster (densifies it)  using one of the four resampling methods: nearest neighbor, 4 neighbors mode, bilinear interpolation, or bicubic interpolation. The program makes a careful treatment of the NoData value (does not consider it in the interpolation). In order to change the pixel side of a raster without changing the origin of the net, use the <a href="CanviRes.HTM">CanviRes</a> program. For more sophisticated operations, particularly to expand the geographic extent by filling it with NoData use the program <a href="AdapRas.HTM">AdapRas</a>. At the end of this text there is a summary explaining when CanviRes should be used and when DensRas should be used, including the options for each one.]]></ows:Abstract>
		<ows:Metadata xlink:title="Title:Raster densification"/>
		<ows:Metadata xlink:title="Abstract:This program changes the spatial resolution of a raster (densifies it)  using one of the four resampling methods: nearest neighbor, 4 neighbors mode, bilinear interpolation, or bicubic interpolation. The program makes a careful treatment of the NoData value (does not consider it in the interpolation). In order to change the pixel side of a raster without changing the origin of the net, use the &lt;a href=&quot;CanviRes.HTM&quot;&gt;CanviRes&lt;/a&gt; program. For more sophisticated operations, particularly to expand the geographic extent by filling it with NoData use the program &lt;a href=&quot;AdapRas.HTM&quot;&gt;AdapRas&lt;/a&gt;. At the end of this text there is a summary explaining when CanviRes should be used and when DensRas should be used, including the options for each one."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RasterOriginal</ows:Identifier>
				<ows:Title>Original raster</ows:Title>
				<ows:Abstract>Name of the input raster file to densifier.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:OriginalRaster"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Xmin</ows:Identifier>
				<ows:Title>Minimum X</ows:Title>
				<ows:Abstract>Define the minimum X of the densified raster bounding box.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Xmin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Xmax</ows:Identifier>
				<ows:Title>Maximum X</ows:Title>
				<ows:Abstract>Define the maximum X of the densified raster bounding box.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Xmax"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Ymin</ows:Identifier>
				<ows:Title>Minimum Y</ows:Title>
				<ows:Abstract>Define the minimum Y of the densified raster bounding box.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Ymin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Ymax</ows:Identifier>
				<ows:Title>Maximum Y</ows:Title>
				<ows:Abstract>Define the maximum X of the densified raster bounding box.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:Ymax"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Cpix</ows:Identifier>
				<ows:Title>Pixel side</ows:Title>
				<ows:Abstract>Pixel side of the densified raster. MaxX and MaxY will be adapted according to this value.</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:Spix"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Remostreig</ows:Identifier>
				<ows:Title>Resampling mode</ows:Title>
				<ows:Abstract>Points the resampling mode: 'V' for the nearest neighbor, 'M' for the 4 neighbors mode, 'L' for bilineal interpolation and 'C' for bicubic interpolation interpolation.</ows:Abstract>
				<ows:Metadata xlink:title="Param8"/>
				<ows:Metadata xlink:title="Name:Resampling"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>V</ows:Value>
						<ows:Value>M</ows:Value>
						<ows:Value>L</ows:Value>
						<ows:Value>C</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>RasterDensificat</ows:Identifier>
				<ows:Title>Densified raster</ows:Title>
				<ows:Abstract>Name of the densified raster file. If not indicated, it is assumed that both files have IMG extension.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:DensifiedRaster"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>