<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SPOTIMG:1</ows:Identifier>
		<ows:Title>SPOTIMG</ows:Title>
		<ows:Abstract><![CDATA[Aquest programa llegeix dades dels satèl·lits de la sèrie SPOT (<i>Satellite Pour l'Observation de la Terre</i>) en el format DIMAP (<i>Digital Image Map</i>, es pot consultar <a href="http://www.spotimage.fr/html/_167_224_232_235_.php">http://www.spotimage.fr/html/_167_224_232_235_.php</a>).]]></ows:Abstract>
		<ows:Metadata xlink:title="Title:Transforma ràsters en format DIMAP (SPOT) al format IMG de MiraMon"/>
		<ows:Metadata xlink:title="Abstract:Aquest programa llegeix dades dels satèl·lits de la sèrie SPOT (&lt;i&gt;Satellite Pour l&apos;Observation de la Terre&lt;/i&gt;) en el format DIMAP (&lt;i&gt;Digital Image Map&lt;/i&gt;, es pot consultar &lt;a href=&quot;http://www.spotimage.fr/html/_167_224_232_235_.php&quot;&gt;http://www.spotimage.fr/html/_167_224_232_235_.php&lt;/a&gt;)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Transforma ràsters en format DIMAP (SPOT) al format IMG del MiraMon</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerTIF</ows:Identifier>
				<ows:Title>Nom del fitxerTIF</ows:Title>
				<ows:Abstract>És el nom i adreça del fitxer TIF que conté la imatge. Sovint aquest fitxer s'anomena "imagery.tif".</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerTIF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDIM</ows:Identifier>
				<ows:Title>Nom del fitxer DIM</ows:Title>
				<ows:Abstract>És el nom i adreça del fitxer XML de metadades en format DIMAP 1.1. Sovint aquest fitxer s'anomena "metadata.dim".</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerDIM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-DIM</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DIM</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxSortG</ows:Identifier>
				<ows:Title>Nom del fitxer de sortida banda verda</ows:Title>
				<ows:Abstract>És el nom i adreça del fitxer IMG de sortida que contindrà la banda espectral verda (és a dir la banda que està en 2a posició dins el TIF).</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FitxSortG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxSortR</ows:Identifier>
				<ows:Title>Nom del fitxer de sortida banda vermella</ows:Title>
				<ows:Abstract>És el nom i adreça del fitxer IMG de sortida que contindrà la banda espectral vermella (és a dir la banda que està en 3a posició dins el TIF).</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:FitxSortR"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxSortIRm</ows:Identifier>
				<ows:Title>Nom del fitxer de sortida banda de l'infraroig mitjà</ows:Title>
				<ows:Abstract>És el nom i adreça del fitxer IMG de sortida que contindrà la banda espectral de l'infraroig d'ona curta (és a dir la banda que està en 4a posició dins el TIF).</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:FitxSortIRm"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxSortIRp</ows:Identifier>
				<ows:Title>Nom del fitxer de sortida banda de l'infraroig proper</ows:Title>
				<ows:Abstract>És el nom i adreça del fitxer IMG de sortida que contindrà la banda espectral de l'infraroig proper (és a dir la banda que està en 1a posició dins el TIF).</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:FitxSortIRp"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>