<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SPOTIMG:1</ows:Identifier>
		<ows:Title>SPOTIMG</ows:Title>
		<ows:Abstract>Aquest programa llegeix dades dels satèl·lits de la sèrie SPOT (Satellite Pour l'Observation de la Terre) en el format DIMAP (Digital Image Map, vegeu http://www.spotimage.fr/html/_167_224_232_235_.php).</ows:Abstract>
<ows:Metadata xlink:title="Title:Transforma ràsters en format DIMAP (SPOT) al format IMG de MiraMon"/>
<ows:Metadata xlink:title="Abstract:Aquest programa llegeix dades dels satèl·lits de la sèrie SPOT (Satellite Pour l'Observation de la Terre) en el format DIMAP (Digital Image Map, vegeu http://www.spotimage.fr/html/_167_224_232_235_.php)."/>
		<DataInputs>
		<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>1. opció unica</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
			<LiteralData>
				<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:Value>1</ows:Value>
				</ows:AllowedValues>
			</LiteralData>				
		</Input>
		<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerTIF</ows:Identifier>
				<ows:Title>NomFitxerTIF</ows:Title>
				<ows:Abstract>És el nom i adreça del fitxer TIF que conté la imatge. Sovint aquest fitxer s'anomena "imagery.tif".</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
			<ComplexData>
				<Default>
					<Format>
								<MimeType>application/x-TIF</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
				</Default>
				<Supported>
					<Format>
								<MimeType>application/x-TIF</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
				</Supported>
			</ComplexData>	
		</Input>
		<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerDIM</ows:Identifier>
				<ows:Title>Nom Fitxer DIM</ows:Title>
				<ows:Abstract>És el nom i adreça del fitxer XML de metadades en format DIMAP 1.1. Sovint aquest fitxer s'anomena "metadata.dim".</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
			<ComplexData>
				<Default>
					<Format>
								<MimeType>application/x-DIM</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
				</Default>
				<Supported>
					<Format>
								<MimeType>application/x-DIM</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
				</Supported>
			</ComplexData>	
		</Input>
		</DataInputs>
			<ProcessOutputs>	
	      	<Output>
				<ows:Identifier>NomFitxerSortidaG</ows:Identifier>
				<ows:Title>Nom Fitxer Sortida Verda</ows:Title>
				<ows:Abstract>És el nom i adreça del fitxer IMG de sortida que contindrà la banda espectral verda (és a dir la banda que està en 2a posició dins el TIF).
				</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ComplexOutput>
					<Default>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Default>
					<Supported>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>NomFitxerSortidaR</ows:Identifier>
				<ows:Title>NomFitxerSortida Vermell</ows:Title>
				<ows:Abstract>És el nom i adreça del fitxer IMG de sortida que contindrà la banda espectral vermella (és a dir la banda que està en 3a posició dins el TIF).
				</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ComplexOutput>
					<Default>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Default>
					<Supported>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>NomFitxerSortidaIRp</ows:Identifier>
				<ows:Title>NomFitxerSortida Infraroig Proper</ows:Title>
				<ows:Abstract>És el nom i adreça del fitxer IMG de sortida que contindrà la banda espectral de l'infraroig proper (és a dir la banda que està en 1a posició dins el TIF).
				</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ComplexOutput>
					<Default>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Default>
					<Supported>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>NomFitxerSortidaIRm</ows:Identifier>
				<ows:Title>NomFitxerSortidaI infrarog Mitjà</ows:Title>
				<ows:Abstract>És el nom i adreça del fitxer IMG de sortida que contindrà la banda espectral de l'infraroig mitjà (és a dir la banda que està en 4a posició dins el TIF).
				</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ComplexOutput>
					<Default>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Default>
					<Supported>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs> 
	</ProcessDescription>
</wps:ProcessDescriptions>
