<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:veccor:Param1:1</ows:Identifier>
		<ows:Title>VECCOR 2D</ows:Title>
		<ows:Abstract>This option transforms VEC files of point to  COR files without Z dimension</ows:Abstract>
<ows:Metadata xlink:title="Title:Transformation of VEC files of points to COR files used by CorrGeom" />
<ows:Metadata xlink:title="Abstract:This program transforms VEC files of point to the working format of CORRGEOM program." />
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Mode</ows:Identifier>
				<ows:Title>Mode</ows:Title>
				<ows:Abstract>1.Conversion from VEC format to COR format.</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>VECFileName</ows:Identifier>
				<ows:Title>VEC File Name</ows:Title>
				<ows:Abstract>Input file containing the ground control points VEC format.</ows:Abstract>
						<ows:Metadata xlink:title="Param2" />
					<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>	
			</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>CORFileName</ows:Identifier>
				<ows:Title>COR File Name</ows:Title>
				<ows:Abstract>Output file containing the ground control points COR format.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
						<ComplexOutput>
							<Default>
						<Format>
							<MimeType>application/x-COR</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-COR</MimeType>
							<Encoding>Text</Encoding>
						</Format>
							</Supported>
						</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:veccor:Param1:2</ows:Identifier>
		<ows:Title>VECCOR 3D</ows:Title>
		<ows:Abstract>This option transforms VEC files of point to  COR files incorporating Z  dimension extracted from the the Digital Elevation Model (MDE).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Mode</ows:Identifier>
				<ows:Title>Mode</ows:Title>
				<ows:Abstract>2. Conversion from VEC format to COR format with heights that will be extracted from a Digital Elevation Model (DEM).</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>VECFileName</ows:Identifier>
				<ows:Title>VEC File Name</ows:Title>
				<ows:Abstract>Input file containing the ground control points VEC format.</ows:Abstract>
						<ows:Metadata xlink:title="Param2" />
					<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DEM File Name</ows:Identifier>
				<ows:Title>DEMFileName</ows:Title>
				<ows:Abstract>IMG file containing the Digital Elevation Model of the region of interest (only option 2).</ows:Abstract>
						<ows:Metadata xlink:title="Param4" />
					<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>InterpolMode</ows:Identifier>
				<ows:Title>Interpol Mode</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>0: Nearest neighbour</li><li>1: Bilinear interpolation</li><li>2: Bicubic interpolation</li></ul>]]> 
</ows:Abstract>
				<ows:Metadata xlink:title="Param5" />
				<LiteralData>
					<ows:AllowedValues>                                                                                            
					<ows:Value>0</ows:Value>
					<ows:Value>1</ows:Value>
					<ows:Value>2</ows:Value>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					</ows:AllowedValues>
				</LiteralData>
			</Input>				
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>UNITATSXY</ows:Identifier>
				<ows:Title>Unitats XY</ows:Title>
				<ows:Abstract>Units from the VEC file attribute, that correspond to coordinates from output horitzontal reference system, usually 'm' (only option 2).
</ows:Abstract>
				<LiteralData>
					<ows:AllowedValues>
					<ows:Value>mm</ows:Value>
					<ows:Value>dm</ows:Value>
					<ows:Value>cm</ows:Value>
					<ows:Value>m</ows:Value>
					<ows:Value>km</ows:Value>
					<ows:Value>graus</ows:Value>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					</ows:AllowedValues>
				</LiteralData>
			</Input>				
			</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>CORFileName</ows:Identifier>
				<ows:Title>COR File Name</ows:Title>
				<ows:Abstract>Output file containing the ground control points COR format.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
						<ComplexOutput>
							<Default>
						<Format>
							<MimeType>application/x-COR</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-COR</MimeType>
							<Encoding>Text</Encoding>
						</Format>
							</Supported>
						</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
