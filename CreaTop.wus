<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CREATOP:Param1:T</ows:Identifier>
		<ows:Title>Creatop Points</ows:Title>
		<ows:Abstract>Building topology of point file.</ows:Abstract>
<ows:Metadata xlink:title="Title:Simplified Topology Builder" />
<ows:Metadata xlink:title="Abstract:This program integrates and makes easier the process of building topology done by the VECPNT, LINARC, CICLAR and ATRIPOL modules of MiraMon. Nevertheless, you should be aware about the limitations of this simplified module."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>T</ows:Identifier>
				<ows:Title>Points</ows:Title>
				<ows:Abstract>Indicates point files</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
		<LiteralData>
		<ows:AllowedValues>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
						<ows:Value>T</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Name_of_VEC_file</ows:Identifier>
				<ows:Title>Name of VEC file</ows:Title>
				<ows:Abstract>VEC or PNT file to be converted.
				</ows:Abstract>
<ows:Metadata xlink:title="Param2" />
		<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
		</ComplexData>
		</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Tolerance</ows:Identifier>
				<ows:Title>Tolerance</ows:Title>
				<ows:Abstract>Tolerance value. If not specified, an 0.001 tolerance is assumed.</ows:Abstract>
		<LiteralData>
			<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integrer">integrer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0.001</DefaultValue>
				</LiteralData>
			</Input>
	</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Name_of_VEC_file</ows:Identifier>
				<ows:Title>Name of VEC file</ows:Title>
				<ows:Abstract>PNT file converted
				</ows:Abstract>
				<ows:Metadata xlink:title="Param2" />
						<ComplexOutput>
						<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CREATOP:Param1:A</ows:Identifier>
		<ows:Title>Creatop Arcs</ows:Title>
		<ows:Abstract>Building topology of Arc file.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>A</ows:Identifier>
				<ows:Title>Arc</ows:Title>
				<ows:Abstract>Indicates arc files.</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
		<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
						<ows:Value>A</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Name_of_VEC_file</ows:Identifier>
				<ows:Title>Name of VEC file</ows:Title>
				<ows:Abstract>VEC or ARC file to be converted. 
				</ows:Abstract>
<ows:Metadata xlink:title="Param2" />
		<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
		</ComplexData>
		</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Tolerance</ows:Identifier>
				<ows:Title>Tolerance</ows:Title>
				<ows:Abstract>Tolerance value. If not specified, an 0.001 tolerance is assumed.</ows:Abstract>
		<LiteralData>
			<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integrer">integrer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0.001</DefaultValue>
				</LiteralData>
			</Input>
	</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Name_of_VEC_file</ows:Identifier>
				<ows:Title>Name of VEC file</ows:Title>
				<ows:Abstract>VEC or ARC file converted
				</ows:Abstract>
				<ows:Metadata xlink:title="Param2" />
						<ComplexOutput>
						<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-nod</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>	
<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CREATOP:Param1:P</ows:Identifier>
		<ows:Title>Creatop Polygons</ows:Title>
		<ows:Abstract>Building topology of polygons file.</ows:Abstract>
		<DataInputs>
	<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>P</ows:Identifier>
				<ows:Title>Polygons</ows:Title>
				<ows:Abstract>Indicates polygon files.</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
		<LiteralData>
		<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>P</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
	<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>x</ows:Identifier>
				<ows:Title>Structuration</ows:Title>
				<ows:Abstract>If not indicated, the process of building topology is done from the arcs file. When x is set to 1, the program assumes that a valid arc file exists and uses it to build polygon topology. When x is set to 2, the program assumes that a valid polygon file exists and it is directly labelled.</ows:Abstract>
					<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:Value>1</ows:Value>
					<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>			
	<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Name_of_VEC_file</ows:Identifier>
				<ows:Title>Name of VEC file</ows:Title>
				<ows:Abstract>VEC or POL file to be converted
				</ows:Abstract>
<ows:Metadata xlink:title="Param2" />
		<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
		</ComplexData>
		</Input>
	<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Name_of_label_file</ows:Identifier>
				<ows:Title>Name of label file</ows:Title>
				<ows:Abstract>VEC or PNT file of labels(points) for polygons. 
				</ows:Abstract>
<ows:Metadata xlink:title="Param3" />
		<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
		</ComplexData>
		</Input>
	<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Tolerance</ows:Identifier>
				<ows:Title>Tolerance</ows:Title>
				<ows:Abstract>Tolerance value. If not specified, an 0.001 tolerance is assumed</ows:Abstract>
		<LiteralData>
			<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integrer">integrer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0.001</DefaultValue>
				</LiteralData>
			</Input>
	</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Name_of_VEC_file:</ows:Identifier>
				<ows:Title>Name of VEC file:</ows:Title>
				<ows:Abstract>VEC or POL file converted
				</ows:Abstract>
				<ows:Metadata xlink:title="Param2" />
						<ComplexOutput>
						<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>		
</wps:ProcessDescriptions>
