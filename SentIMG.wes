<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SentIMG:!Param03</ows:Identifier>
		<ows:Title>SentIMG: Importación de imágenes Sentinel-2</ows:Title>
		<ows:Abstract>Importación de un producto de datos Sentinel-2.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importación de imágenes Sentinel-2."/>
		<ows:Metadata xlink:title="Abstract:Esta aplicación permite importar imágenes Sentinel-2 a IMG."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>De momento, solamente puede valer 1.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerXMLUserProduct</ows:Identifier>
				<ows:Title>Fichero XML User Product</ows:Title>
				<ows:Abstract><![CDATA[Fichero XML de metadatos del <i>User Product</i> del producto descomprimido de datos de Sentinel-2.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroXMLUserProduct"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ImportQualMask</ows:Identifier>
				<ows:Title>Importar máscaras de calidad</ows:Title>
				<ows:Abstract>Importar las diferentes máscaras de calidad en formato GML que hay en cada tesela a formato MiraMon.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CopyQualMask</ows:Identifier>
				<ows:Title>Copiar máscaras de calidad</ows:Title>
				<ows:Abstract>Copiar las diferentes máscaras de calidad en formato GML que hay en cada tesela.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>DirSortida</ows:Identifier>
				<ows:Title>Directorio de salida</ows:Title>
				<ows:Abstract>Directorio de salida donde se importan a formato MiraMon todos los datos de cada tesela del producto de Sentinel-2 o todas las imágenes de la lista de ficheros JP2.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:DirSalida"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SentIMG:!Param02</ows:Identifier>
		<ows:Title>SentIMG: Importación de imágenes Sentinel-2</ows:Title>
		<ows:Abstract>Importación de una lista de imágenes Sentinel-2 de una misma tesela.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>De momento, solamente puede valer 1.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>LlistaFitxersJP2</ows:Identifier>
				<ows:Title>Lista de ficheros JP2 de una misma tesela.</ows:Title>
				<ows:Abstract>Lista de ficheros JP2 de una misma tesela de un producto de Sentinel-2.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:ListaFicherosJP2"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/txt</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/txt</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FitxerXMLUserProduct</ows:Identifier>
				<ows:Title>Fichero XML User Product</ows:Title>
				<ows:Abstract><![CDATA[Fichero XML de metadatos del <i>User Product</i> del producto descomprimido de datos de Sentinel-2.]]></ows:Abstract>
				<ows:Metadata xlink:title="Name:FicheroXMLUserProduct"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FitxerXMLGranule</ows:Identifier>
				<ows:Title>Fichero XML de la tesela</ows:Title>
				<ows:Abstract>Fichero XML de metadatos de la tesela correspondiente al listado de las imágenes de entrada.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>DirSortida</ows:Identifier>
				<ows:Title>Directorio de salida</ows:Title>
				<ows:Abstract>Directorio de salida donde se importan a formato MiraMon todos los datos de cada tesela del producto de Sentinel-2 o todas las imágenes de la lista de ficheros JP2.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:DirSalida"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>