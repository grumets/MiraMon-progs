<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Vec2Map:Param1:1</ows:Identifier>
		<ows:Title>Vec2Map</ows:Title>
		<ows:Abstract>Mapa HTML desde VEC</ows:Abstract>
		<ows:Metadata xlink:title="Title:Crear un mapa HTML"/>
		<ows:Metadata xlink:title="Abstract:Esta aplicación genera una página web con un mapa sensible a partir de un fichero VEC de polígonos, POL o PNT y de una imagen ráster en formato GIF o JPG."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 1</ows:Title>
				<ows:Abstract>Generación del mapa HTML a partir de un fichero VEC digitalizado sobre JPEG o GIF sin georreferenciar.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Imatge</ows:Identifier>
				<ows:Title>Imatge</ows:Title>
				<ows:Abstract>Es el nom del fitxer ráster GIF o JPG amb extensió que s'incrusta a la plana HTML (En la opción 1 se suposa que hi ha un fitxer VEC de polígonos amb el mateix nom).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Imatge"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/gif</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/gif</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomSortida</ows:Identifier>
				<ows:Title>Nombre salida</ows:Title>
				<ows:Abstract>Es el nombre de fichero HTML de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NomSortida"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-html</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-html</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NCols</ows:Identifier>
				<ows:Title>NCols</ows:Title>
				<ows:Abstract>Es el número de columnas de la imagen.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NCols"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NFils</ows:Identifier>
				<ows:Title>NFils</ows:Title>
				<ows:Abstract>Es el número de filas de la imagen.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:NFils"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Vec2Map:Param1:2</ows:Identifier>
		<ows:Title>Vec2Map</ows:Title>
		<ows:Abstract>Mapa HTML desde POL</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 2</ows:Title>
				<ows:Abstract>Generación del mapa HTML a partir de un fichero POL y un JPEG georreferenciado.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDePoligons</ows:Identifier>
				<ows:Title>Fichero de polígonos</ows:Title>
				<ows:Abstract>Es el nombre del fichero vectorial estructurado POL.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerDePoligons"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Imatge</ows:Identifier>
				<ows:Title>Imatge</ows:Title>
				<ows:Abstract>Es el nom del fitxer ráster GIF o JPG amb extensió que s'incrusta a la plana HTML (En la opción 1 se suposa que hi ha un fitxer VEC de polígonos amb el mateix nom).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Imatge"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/gif</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/gif</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomSortida</ows:Identifier>
				<ows:Title>Nombre salida</ows:Title>
				<ows:Abstract>Es el nombre de fichero HTML de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NomSortida"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-html</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-html</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TOLERANCIA</ows:Identifier>
				<ows:Title>TOLERANCIA</ows:Title>
				<ows:Abstract>Hace referencia a la tolerancia considerada para eliminar redundancia de vértices cercanos y así hacer más ligero el fichero HTML. Su valor por defecto es 3.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ID</ows:Identifier>
				<ows:Title>ID</ows:Title>
				<ows:Abstract>Hace referencia a la propiedad id de cada área sensible. Ejemplo: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>HREF</ows:Identifier>
				<ows:Title>HREF</ows:Title>
				<ows:Abstract>Hace referencia a la propiedad href de cada área sensible. Ejemplo: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TITLE</ows:Identifier>
				<ows:Title>TITLE</ows:Title>
				<ows:Abstract>Hace referencia a la propiedad title de cada área sensible. Ejemplo: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALT</ows:Identifier>
				<ows:Title>ALT</ows:Title>
				<ows:Abstract>Hace referencia a la propiedad alt de cada área sensible. Ejemplo: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ONCLICK</ows:Identifier>
				<ows:Title>ONCLICK</ows:Title>
				<ows:Abstract>Hace referencia a la propiedad onclick de cada área sensible. Ejemplo: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ONDBLCLICK</ows:Identifier>
				<ows:Title>ONDBLCLICK</ows:Title>
				<ows:Abstract>Hace referencia a la propiedad ondblclick de cada área sensible. Ejemplo: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ONMOUSEOVER</ows:Identifier>
				<ows:Title>ONMOUSEOVER</ows:Title>
				<ows:Abstract>Hace referencia a la propiedad onmouseover de cada área sensible. Ejemplo: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Vec2Map:Param1:3</ows:Identifier>
		<ows:Title>Vec2Map</ows:Title>
		<ows:Abstract>Mapa HTML desde PNT</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 3</ows:Title>
				<ows:Abstract>Generación del mapa HTML a partir de un fichero PNT.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDePunts</ows:Identifier>
				<ows:Title>Fichero de puntos</ows:Title>
				<ows:Abstract>Es el nombre del fichero vectorial estructurado PNT.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerpDePuntos"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Imatge</ows:Identifier>
				<ows:Title>Imatge</ows:Title>
				<ows:Abstract>Es el nom del fitxer ráster GIF o JPG amb extensió que s'incrusta a la plana HTML (En la opción 1 se suposa que hi ha un fitxer VEC de polígonos amb el mateix nom).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Imatge"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/gif</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/gif</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomSortida</ows:Identifier>
				<ows:Title>Nombre salida</ows:Title>
				<ows:Abstract>Es el nombre de fichero HTML de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NomSortida"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-html</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-html</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Amplada</ows:Identifier>
				<ows:Title>Anchura</ows:Title>
				<ows:Abstract>Anchura en píxeles del rectángulo del area shape.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Anchura"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Alcada</ows:Identifier>
				<ows:Title>Altura</ows:Title>
				<ows:Abstract>Altura en píxeles del rectángulo del area shape.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:Altura"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Orientacio</ows:Identifier>
				<ows:Title>Orientación</ows:Title>
				<ows:Abstract>1: NW; 2: NE; 3: SW; 4: SE; 5: C.</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:Orientación"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ID</ows:Identifier>
				<ows:Title>ID</ows:Title>
				<ows:Abstract>Hace referencia a la propiedad id de cada área sensible. Ejemplo: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>HREF</ows:Identifier>
				<ows:Title>HREF</ows:Title>
				<ows:Abstract>Hace referencia a la propiedad href de cada área sensible. Ejemplo: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TITLE</ows:Identifier>
				<ows:Title>TITLE</ows:Title>
				<ows:Abstract>Hace referencia a la propiedad title de cada área sensible. Ejemplo: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALT</ows:Identifier>
				<ows:Title>ALT</ows:Title>
				<ows:Abstract>Hace referencia a la propiedad alt de cada área sensible. Ejemplo: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ONCLICK</ows:Identifier>
				<ows:Title>ONCLICK</ows:Title>
				<ows:Abstract>Hace referencia a la propiedad onclick de cada área sensible. Ejemplo: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ONDBLCLICK</ows:Identifier>
				<ows:Title>ONDBLCLICK</ows:Title>
				<ows:Abstract>Hace referencia a la propiedad ondblclick de cada área sensible. Ejemplo: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ONMOUSEOVER</ows:Identifier>
				<ows:Title>ONMOUSEOVER</ows:Title>
				<ows:Abstract>Hace referencia a la propiedad onmouseover de cada área sensible. Ejemplo: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>