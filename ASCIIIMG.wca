				<ows:Metadata xlink:title="Param09"/>
				<ows:Metadata xlink:title="Name:DefValFons"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>minx</ows:Identifier>
				<ows:Title>X mínima</ows:Title>
				<ows:Abstract>Definició de la X mínima de l'envolupant.</ows:Abstract>
				<ows:Metadata xlink:title="Param10"/>
				<ows:Metadata xlink:title="Name:minx"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>maxx</ows:Identifier>
				<ows:Title>X màxima</ows:Title>
				<ows:Abstract>Definició de la X màxima de l'envolupant.</ows:Abstract>
				<ows:Metadata xlink:title="Param11"/>
				<ows:Metadata xlink:title="Name:maxx"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>miny</ows:Identifier>
				<ows:Title>Y mínima</ows:Title>
				<ows:Abstract>Definició de la Y mínima de l'envolupant.</ows:Abstract>
				<ows:Metadata xlink:title="Param12"/>
				<ows:Metadata xlink:title="Name:miny"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>maxy</ows:Identifier>
				<ows:Title>Y màxima</ows:Title>
				<ows:Abstract>Definició de la Y màxima de l'envolupant.</ows:Abstract>
				<ows:Metadata xlink:title="Param13"/>
				<ows:Metadata xlink:title="Name:maxy"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>SisRef</ows:Identifier>
				<ows:Title>Sistema de referència</ows:Title>
				<ows:Abstract><![CDATA[Nom del sistema de referència espacial (projecció, dàtum, etc). Si no s'indica serà <i>plane</i> per defecte.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param14"/>
				<ows:Metadata xlink:title="Name:SisRef"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>plane</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RefUnit</ows:Identifier>
				<ows:Title>Unitats del sistema de referència</ows:Title>
				<ows:Abstract><![CDATA[Unitats del sistema de referència espacial. Quan s'indiquen han de ser les corresponents al SisRef (típicament "m" per a projeccions convencionals, o graus (°) per a sistemes en longitud-latitud). Si el paràmetre no s'indica serà <i>píxel</i> per defecte.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param15"/>
				<ows:Metadata xlink:title="Name:RefUnit"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>pixel</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FDest</ows:Identifier>
				<ows:Title>Fitxer destí</ows:Title>
				<ows:Abstract>Fitxer IMG de sortida.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:FDest"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>