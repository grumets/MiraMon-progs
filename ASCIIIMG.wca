<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ASCIIIMG:!Param05</ows:Identifier>
		<ows:Title>ASCIIIMG ESRI</ows:Title>
		<ows:Abstract>Opció que interpreta la capçalera del format ESRI ASCII per fer la transformació.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importació de fitxers ràster ASCII a fitxers ràster MiraMon"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació importa fitxers ràster de diversos formats ASCII a MiraMon (format IMG)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>reg</ows:Identifier>
				<ows:Title>Mida del registre o delimitador</ows:Title>
				<ows:Abstract><![CDATA[Indica el tractament per als tres tipus principals de fitxer ASCII:<ul><li>-1 (i menys de 6 paràmetres) quan es tracta d'un fitxer ESRI ASCII ràster format.</li> 				<li>0 quan els valors estan separats per un delimitador.</li> 				<li>n quan indica l'amplada en caràcters de cada cel·la per a registre fix.</li> 				<li>-n (i 6 o més paràmetres) quan es tracta d'un fitxer ASCII estructurat per columnes; la n indica el nombre de columna a importar. </li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:reg"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FOri</ows:Identifier>
				<ows:Title>Fitxer origen</ows:Title>
				<ows:Abstract>Fitxer ASCII d'entrada</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:FOri"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusDada</ows:Identifier>
				<ows:Title>Tipus de dada</ows:Title>
				<ows:Abstract><![CDATA[Tipus de dada de sortida:<ul><li>bit (enters [0,1], 1 bit/cel·la)</li><li>byte (enters [0,255], 1 byte/cel·la)</li><li>integer (enters [-32768, 32767], 2 bytes/cel·la)</li><li>uinteger (enters [0, 65535], 2 bytes/cel·la)</li><li>long (enters [-2147483648, 2147483647], 4 bytes/cel·la)</li><li>real (punt flotant ±3.4E±32, 4 bytes/cel·la)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:TipusDada"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>bit</ows:Value>
						<ows:Value>byte</ows:Value>
						<ows:Value>byte-RLE</ows:Value>
						<ows:Value>integer</ows:Value>
						<ows:Value>integer-RLE</ows:Value>
						<ows:Value>uinteger</ows:Value>
						<ows:Value>uinteger-RLE</ows:Value>
						<ows:Value>long</ows:Value>
						<ows:Value>long-RLE</ows:Value>
						<ows:Value>real</ows:Value>
						<ows:Value>real-RLE</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SisRef</ows:Identifier>
				<ows:Title>Sistema de referència</ows:Title>
				<ows:Abstract><![CDATA[Nom del sistema de referència espacial (projecció, dàtum, etc). Si no s'indica serà <i>plane</i> per defecte.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:SisRef"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>plane</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RefUnit</ows:Identifier>
				<ows:Title>Unitats del sistema de referència</ows:Title>
				<ows:Abstract><![CDATA[Unitats del sistema de referència espacial. Quan s'indiquen han de ser les corresponents al SisRef (típicament "m" per a projeccions convencionals, o graus (°) per a sistemes en longitud-latitud). Si el paràmetre no s'indica serà <i>píxel</i> per defecte.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:RefUnit"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>pixel</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FDest</ows:Identifier>
				<ows:Title>Fitxer destí</ows:Title>
				<ows:Abstract>Fitxer IMG de sortida.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:FDest"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ASCIIIMG:!Param10</ows:Identifier>
		<ows:Title>ASCIIIMG NO ENV</ows:Title>
		<ows:Abstract>En aquesta opció no s'indica l'àmbit ni el sistema de referència. El nombre de files i columnes que conté el fitxer ASCII s'ha d'escriure manualment, així com també el nombre de línies de capçalera a saltar.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>reg</ows:Identifier>
				<ows:Title>Mida del registre o delimitador</ows:Title>
				<ows:Abstract><![CDATA[Indica el tractament per als tres tipus principals de fitxer ASCII:<ul><li>-1 (i menys de 6 paràmetres) quan es tracta d'un fitxer ESRI ASCII ràster format.</li> 				<li>0 quan els valors estan separats per un delimitador.</li> 				<li>n quan indica l'amplada en caràcters de cada cel·la per a registre fix.</li> 				<li>-n (i 6 o més paràmetres) quan es tracta d'un fitxer ASCII estructurat per columnes; la n indica el nombre de columna a importar. </li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:reg"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FOri</ows:Identifier>
				<ows:Title>Fitxer origen</ows:Title>
				<ows:Abstract>Fitxer ASCII d'entrada</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:FOri"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ncol</ows:Identifier>
				<ows:Title>Nombre de columnes</ows:Title>
				<ows:Abstract>Nombre de columnes.</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:ncol"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>nfil</ows:Identifier>
				<ows:Title>Nombre de files</ows:Title>
				<ows:Abstract>Nombre de files.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:nfil"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>nlin</ows:Identifier>
				<ows:Title>Nombre de línies</ows:Title>
				<ows:Abstract>La capçalera del fitxer ASCII s'esquiva indicant el nombre de línies que la constitueix; cal indicar zero (0) per a fitxers sense capçalera.</ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:nlin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusDada</ows:Identifier>
				<ows:Title>Tipus de dada</ows:Title>
				<ows:Abstract><![CDATA[Tipus de dada de sortida:<ul><li>bit (enters [0,1], 1 bit/cel·la)</li><li>byte (enters [0,255], 1 byte/cel·la)</li><li>integer (enters [-32768, 32767], 2 bytes/cel·la)</li><li>uinteger (enters [0, 65535], 2 bytes/cel·la)</li><li>long (enters [-2147483648, 2147483647], 4 bytes/cel·la)</li><li>real (punt flotant ±3.4E±32, 4 bytes/cel·la)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:TipusDada"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>bit</ows:Value>
						<ows:Value>byte</ows:Value>
						<ows:Value>byte-RLE</ows:Value>
						<ows:Value>integer</ows:Value>
						<ows:Value>integer-RLE</ows:Value>
						<ows:Value>uinteger</ows:Value>
						<ows:Value>uinteger-RLE</ows:Value>
						<ows:Value>long</ows:Value>
						<ows:Value>long-RLE</ows:Value>
						<ows:Value>real</ows:Value>
						<ows:Value>real-RLE</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ValorFons</ows:Identifier>
				<ows:Title>Valor de fons</ows:Title>
				<ows:Abstract>Valor corresponent al sensedades de la imatge o "none" per no indicar-lo.</ows:Abstract>
				<ows:Metadata xlink:title="Param08"/>
				<ows:Metadata xlink:title="Name:ValorFons"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DefValFons</ows:Identifier>
				<ows:Title>Definició del valor de fons</ows:Title>
				<ows:Abstract>Definició del valor sensedades o "none" si no hi ha valor de fons.</ows:Abstract>
				<ows:Metadata xlink:title="Param09"/>
				<ows:Metadata xlink:title="Name:DefValFons"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FDest</ows:Identifier>
				<ows:Title>Fitxer destí</ows:Title>
				<ows:Abstract>Fitxer IMG de sortida.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:FDest"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ASCIIIMG:Param10</ows:Identifier>
		<ows:Title>ASCIIIMG ENV</ows:Title>
		<ows:Abstract>En aquesta opció s'indica l'àmbit i el sistema de referència. El nombre de files i columnes que conté el fitxer ASCII s'ha d'escriure manualment, així com també el nombre de línies de capçalera a saltar.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>reg</ows:Identifier>
				<ows:Title>Mida del registre o delimitador</ows:Title>
				<ows:Abstract><![CDATA[Indica el tractament per als tres tipus principals de fitxer ASCII:<ul><li>-1 (i menys de 6 paràmetres) quan es tracta d'un fitxer ESRI ASCII ràster format.</li> 				<li>0 quan els valors estan separats per un delimitador.</li> 				<li>n quan indica l'amplada en caràcters de cada cel·la per a registre fix.</li> 				<li>-n (i 6 o més paràmetres) quan es tracta d'un fitxer ASCII estructurat per columnes; la n indica el nombre de columna a importar. </li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:reg"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FOri</ows:Identifier>
				<ows:Title>Fitxer origen</ows:Title>
				<ows:Abstract>Fitxer ASCII d'entrada</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:FOri"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ncol</ows:Identifier>
				<ows:Title>Nombre de columnes</ows:Title>
				<ows:Abstract>Nombre de columnes.</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:ncol"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>nfil</ows:Identifier>
				<ows:Title>Nombre de files</ows:Title>
				<ows:Abstract>Nombre de files.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:nfil"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>nlin</ows:Identifier>
				<ows:Title>Nombre de línies</ows:Title>
				<ows:Abstract>La capçalera del fitxer ASCII s'esquiva indicant el nombre de línies que la constitueix; cal indicar zero (0) per a fitxers sense capçalera.</ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:nlin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusDada</ows:Identifier>
				<ows:Title>Tipus de dada</ows:Title>
				<ows:Abstract><![CDATA[Tipus de dada de sortida:<ul><li>bit (enters [0,1], 1 bit/cel·la)</li><li>byte (enters [0,255], 1 byte/cel·la)</li><li>integer (enters [-32768, 32767], 2 bytes/cel·la)</li><li>uinteger (enters [0, 65535], 2 bytes/cel·la)</li><li>long (enters [-2147483648, 2147483647], 4 bytes/cel·la)</li><li>real (punt flotant ±3.4E±32, 4 bytes/cel·la)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:TipusDada"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>bit</ows:Value>
						<ows:Value>byte</ows:Value>
						<ows:Value>byte-RLE</ows:Value>
						<ows:Value>integer</ows:Value>
						<ows:Value>integer-RLE</ows:Value>
						<ows:Value>uinteger</ows:Value>
						<ows:Value>uinteger-RLE</ows:Value>
						<ows:Value>long</ows:Value>
						<ows:Value>long-RLE</ows:Value>
						<ows:Value>real</ows:Value>
						<ows:Value>real-RLE</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ValorFons</ows:Identifier>
				<ows:Title>Valor de fons</ows:Title>
				<ows:Abstract>Valor corresponent al sensedades de la imatge o "none" per no indicar-lo.</ows:Abstract>
				<ows:Metadata xlink:title="Param08"/>
				<ows:Metadata xlink:title="Name:ValorFons"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DefValFons</ows:Identifier>
				<ows:Title>Definició del valor de fons</ows:Title>
