<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ErrorMDT:1</ows:Identifier>
		<ows:Title>ErrorMDT</ows:Title>
		<ows:Abstract>This application searches for locations in a Digital Terrain Model (MDT) that contain candidate values to be considered errors.</ows:Abstract>
		<ows:Metadata xlink:title="Title:DTM error detection"/>
		<ows:Metadata xlink:title="Abstract:This application searches for locations in a Digital Terrain Model (MDT) that contain candidate values to be considered errors."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MDT</ows:Identifier>
				<ows:Title>Digital terrain model</ows:Title>
				<ows:Abstract>Digital terrain model in raster format.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:DTM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>tStudent</ows:Identifier>
				<ows:Title>Student t Value</ows:Title>
				<ows:Abstract>Student t value for the desired significance level  (for example, for 0.01 is 2.5758, for 0.001 is 3.2905, for 0.0001 is 3.8906, for 0.00001 is 4.4172, for 0.000001 is 4.8933 y for 0.0000001 is 5.3631).</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Student-t"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>nVeins</ows:Identifier>
				<ows:Title>Number of neighbors</ows:Title>
				<ows:Abstract><![CDATA[Number of neighbors used to perform interpolation. It is recommended to use 8 neighbors.<ul><li>4: 4 neighbors</li><li>8: 8 neighbors</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:nNeighbors"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
						<ows:Value>8</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>RasterDiferencies</ows:Identifier>
				<ows:Title>Differences raster</ows:Title>
				<ows:Abstract>Raster in real IMG format with the differences between the MDT and the locally interpolated values.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:DifferencesRaster"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>VectorErrors</ows:Identifier>
				<ows:Title>Errors vector</ows:Title>
				<ows:Abstract>Vector points in VEC format with cell locations with high differences (above the value marked by Student's t).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:ErrorsVector"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>DIFER_TXT</ows:Identifier>
				<ows:Title>List of differences</ows:Title>
				<ows:Abstract>List of differences higher than the indicated Student's t.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-txt</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-txt</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>