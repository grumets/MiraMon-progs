<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Dilata:1</ows:Identifier>
		<ows:Title>Dilata</ows:Title>
		<ows:Abstract>Efectúa la operación de procesamiento de imágenes y morfología matemática conocida como dilatación,la cual toma un valor y lo replica en su entorno geométrico inmediato.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Dilatación de píxeles con cierto valor en ficheros rásters"/>
		<ows:Metadata xlink:title="Abstract:Efectúa la operación de procesamiento de imágenes y morfología matemática conocida como dilatación,la cual toma un valor y lo replica en su entorno geométrico inmediato."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxOrigen</ows:Identifier>
				<ows:Title>Fichero ráster a dilatar</ows:Title>
				<ows:Abstract>Fichero ráster con uno o más valores que se quiere dilatar.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FichOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ValorDilatar</ows:Identifier>
				<ows:Title>Valor a dilatar</ows:Title>
				<ows:Abstract>Valor que se quiere dilatar. Si desea dilatar cualquier valor distinto del sindatos, indique X.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:ValorDilatar"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusDilatacio</ows:Identifier>
				<ows:Title>Tipo de dilatación</ows:Title>
				<ows:Abstract><![CDATA[Tipo de dilatación:<ul><li>1  N-S</li><li>2  E-W</li> <li>3  En cruz de Malta (N-S y E-W)</li><li>4  En cruz de Malta y en diagonal (todos los vecinos)</li> <li>5  Hacia abajo y hacia la izquierda (S y W)</li> <li>6  Hacia abajo y hacia la izquierda, y ambos (S, W y SW)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:TipoDilatacion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>6</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxSortida</ows:Identifier>
				<ows:Title>Fichero de salida</ows:Title>
				<ows:Abstract>Fichero resultado de la dilatación del valor pedido.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FichSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>