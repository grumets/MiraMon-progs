<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SPI_SPEI:Param2:RAS&amp;!Param4</ows:Identifier>
		<ows:Title>Computing of SPI drought indices (raster mode)</ows:Title>
		<ows:Abstract>Computing of SPI drought indices (raster mode)</ows:Abstract>
		<ows:Metadata xlink:title="Title:Computing of SPI and SPEI drought indices"/>
		<ows:Metadata xlink:title="Abstract:Computing of SPI and SPEI drought indices"/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Metode</ows:Identifier>
				<ows:Title>Method</ows:Title>
				<ows:Abstract><![CDATA[Calculation method: <ul><li>SPI_GAMMA for SPI set to a gamma function.</li><li>SPI_PEARSON for SPI set based on Pearson III.</le><li>SPEI_LLOG for SPEI adjusted based on a Logistic Log distribution.</li></ul>You can ask the program to fill in the lost values with an average between the two previous and next values by adding "_FS" to the name of the index you want to calculate.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Method"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>SPI_GAMMA</ows:Value>
						<ows:Value>SPEI_LLOG</ows:Value>
						<ows:Value>SPI_GAMMA_FS</ows:Value>
						<ows:Value>SPEI_LLOG_FS</ows:Value>
						<ows:Value>SPI_PEARSON_FS</ows:Value>
						<ows:Value>SPI_PEARSON</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>SPI</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Mode</ows:Identifier>
				<ows:Title>Mode</ows:Title>
				<ows:Abstract><![CDATA[Mode:<ul><li>EST for Station</li><li>RAS for Rasters</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Mode"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>EST</ows:Value>
						<ows:Value>RAS</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>EST</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Prec</ows:Identifier>
				<ows:Title>Precipitation file</ows:Title>
				<ows:Abstract>Precipitation file corresponding to a file with a list of precipitation rasters in raster mode or a precipitation text file (and temperatures by the SPEI method) in station mode.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:PrecipFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>DIR</ows:Identifier>
				<ows:Title>Output folder</ows:Title>
				<ows:Abstract>Output folder where the result files will be saved. If not specified, they will be saved in the input file directory.</ows:Abstract>
				<ows:Metadata xlink:title="Name:DIR"/>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SPI_SPEI:Param2:RAS&amp;Param4</ows:Identifier>
		<ows:Title>Computing of SPEI drought indices (raster mode)</ows:Title>
		<ows:Abstract>Computing of SPEI drought indices (raster mode)</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Metode</ows:Identifier>
				<ows:Title>Method</ows:Title>
				<ows:Abstract><![CDATA[Calculation method: <ul><li>SPI_GAMMA for SPI set to a gamma function.</li><li>SPI_PEARSON for SPI set based on Pearson III.</le><li>SPEI_LLOG for SPEI adjusted based on a Logistic Log distribution.</li></ul>You can ask the program to fill in the lost values with an average between the two previous and next values by adding "_FS" to the name of the index you want to calculate.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Method"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>SPI_GAMMA</ows:Value>
						<ows:Value>SPEI_LLOG</ows:Value>
						<ows:Value>SPI_GAMMA_FS</ows:Value>
						<ows:Value>SPEI_LLOG_FS</ows:Value>
						<ows:Value>SPI_PEARSON_FS</ows:Value>
						<ows:Value>SPI_PEARSON</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>SPI</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Mode</ows:Identifier>
				<ows:Title>Mode</ows:Title>
				<ows:Abstract><![CDATA[Mode:<ul><li>EST for Station</li><li>RAS for Rasters</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Mode"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>EST</ows:Value>
						<ows:Value>RAS</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>EST</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Prec</ows:Identifier>
				<ows:Title>Precipitation file</ows:Title>
				<ows:Abstract>Precipitation file corresponding to a file with a list of precipitation rasters in raster mode or a precipitation text file (and temperatures by the SPEI method) in station mode.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:PrecipFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Tem</ows:Identifier>
				<ows:Title>Temperature file</ows:Title>
				<ows:Abstract>Text file with a list of temperature rasters (for SPEI method and raster mode only).</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:TemFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DIR</ows:Identifier>
				<ows:Title>Output folder</ows:Title>
				<ows:Abstract>Output folder where the result files will be saved. If not specified, they will be saved in the input file directory.</ows:Abstract>
				<ows:Metadata xlink:title="Name:DIR"/>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
