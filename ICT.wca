<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ICT:1</ows:Identifier>
		<ows:Title>Càlcul de l'Índex de Connectivitat Terrestre</ows:Title>
		<ows:Abstract>Càlcul de l'Índex de Connectivitat Terrestre.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Càlcul de l&apos;Índex de Connectivitat Terrestre"/>
		<ows:Metadata xlink:title="Abstract:Genera un BAT/PS1 per al càlcul de l&apos;Índex de Connectivitat Terrestre"/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxBAT</ows:Identifier>
				<ows:Title>Fitxer BAT/PS1 que permet crear el ràster d'ICT</ows:Title>
				<ows:Abstract>Fitxer BAT/PS1 que permet crear el ràster d'ICT.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FitxBAT"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-bat</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-bat</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Dist</ows:Identifier>
				<ows:Title>Distància de separació entre punts focals</ows:Title>
				<ows:Abstract>Distància de separació entre les mostres o punts focals utilitzats per al càlcul de l'ICT; aquesta distància s'expressa en les unitats del Sistema de Referència Horitzontal dels fitxers originals (d'impedàncies, etc).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Distància"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Radi</ows:Identifier>
				<ows:Title>Radi de la zona explorada al voltant de cada punt focal</ows:Title>
				<ows:Abstract>Radi de la zona explorada al voltant de cada mostra o punt focal; aquest valor s'expressa en les mateixes unitats que Distància.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Radi"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxImped</ows:Identifier>
				<ows:Title>Fitxer d'impedàncies</ows:Title>
				<ows:Abstract>Nom del fitxer ràster d'impedàncies.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FitxImped"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxAfin</ows:Identifier>
				<ows:Title>Fitxer d'afinitats</ows:Title>
				<ows:Abstract>Nom del fitxer ràster d'afinitats.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:FitxAfin"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FilaIni</ows:Identifier>
				<ows:Title>Fila inicial</ows:Title>
				<ows:Abstract><![CDATA[Fila inicial (inclosa) dels ràsters d'afinitats i impedàncies en què es vol que es prepari el càlcul de l'ICT, numerada des de 0 (fila superior). Si es desitja que es faci en tot el ràster cal indicar -1 i -1. Fer que el programa generi el BAT/PS1 per tal que el càlcul es faci només en una faixa (la definida entre la fila inicial i final) del ràster és pràctic quan es vol paral·lelitzar el procés per a accelerar-lo, engegant el BAT/PS1 de cada faixa en una sessió de comandes diferent i/o en un ordinador diferent. Al final, caldrà simplement unir totes les faixes amb el mòdul <a href="Mosaic.htm">Mosaic</a>.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:FilaIni"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>-1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FilaFin</ows:Identifier>
				<ows:Title>Fila final</ows:Title>
				<ows:Abstract><![CDATA[Fila inicial (inclosa) dels ràsters d'afinitats i impedàncies en què es  vol que es prepari el càlcul de l'ICT, numerada des de 0 (fila superior). Si es vol que es faci en tot el ràster cal indicar -1 i -1. Fer que el programa generi el BAT/PS1 per tal que el càlcul es faci només en una faixa (la definida entre la fila inicial i final) del ràster és pràctic quan es vol paral·lelitzar el procés per a accelerar-lo, engegant el BAT/PS1 de cada faixa en una sessió de comandes diferent i/o en un ordinador diferent. Al final, caldrà simplement unir totes les faixes amb el mòdul <a href="Mosaic.htm">Mosaic</a>.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:FilaFin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>-1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NFaixa</ows:Identifier>
				<ows:Title>Numerador de faixa</ows:Title>
				<ows:Abstract>Numerador de faixa que serà afegit al nom del fitxer del BAT/PS1 generat i al nom del fitxer de sortida resultant de l'execució del BAT/PS1 (se suggereix afegir 1, 2, etc a cada execució). Aquest paràmetre no s'utilitza quan FilaIni i FilaFin són -1 i, per tant, es pot indicar qualsevol valor (se suggereix 0, que implica que el fitxer final no tindrà el numerador "_0" enganxat al seu nom).</ows:Abstract>
				<ows:Metadata xlink:title="Param8"/>
				<ows:Metadata xlink:title="Name:NFaixa"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxICT</ows:Identifier>
				<ows:Title>Fitxer resultat del Índex de Connectivitat Terrestre</ows:Title>
				<ows:Abstract>Nom que es desitja per al fitxer ràster que resulti de l'execució del fitxer FitxBAT. El nom d'aquest fitxer no cal que porti indicat el valor de NFaixa ja que el programa s'encarrega de posar-lo automàticament.</ows:Abstract>
				<ows:Metadata xlink:title="Param9"/>
				<ows:Metadata xlink:title="Name:FitxICT"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>UNITS_M2</ows:Identifier>
				<ows:Title>UnitatsM2</ows:Title>
				<ows:Abstract>Indica que els resultats s'han de proporcionar en log(m²) en lloc de log(ha).</ows:Abstract>
				<ows:Metadata xlink:title="Name:UNITS_M2"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CREA_AUX</ows:Identifier>
				<ows:Title>Crea fitxers auxiliars</ows:Title>
				<ows:Abstract>Indica que es generaran dos fitxers addicionals, un amb punts centrats a cada punt focal i un de polígons delimitant la zona analitzada en cada  punt focal, amb el mateix nom que Fitx_ICT però afegint-hi els sufixos "_Mostres" i "_Zones", respectivament.</ows:Abstract>
				<ows:Metadata xlink:title="Name:CREA_AUX"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>