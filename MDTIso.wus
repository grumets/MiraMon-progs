<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MDTISO:1</ows:Identifier>
		<ows:Title>MDTISO</ows:Title>
		<ows:Abstract>Aquest mòdul permet generar isolínies a partir d'un model digital del terreny (MDT) (p.ex., elevació, pluviometria, evapotranspiració, contaminació, etc).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Generació d&apos;isolínies a partir d&apos;un MDT."/>
		<ows:Metadata xlink:title="Abstract:Aquest mòdul permet generar isolínies a partir d&apos;un model digital del terreny (MDT) (p.ex., elevació, pluviometria, evapotranspiració, contaminació, etc)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMDT</ows:Identifier>
				<ows:Title>Fitxer MDT</ows:Title>
				<ows:Abstract>Fitxer Model Digital del Terreny.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:DTMFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Equidistancia</ows:Identifier>
				<ows:Title>Equidistance</ows:Title>
				<ows:Abstract>Diferència del valor Z entre dues isolínies.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Equidistance"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>EQUID_MESTRA</ows:Identifier>
				<ows:Title>Equidistància entre corbes mestres</ows:Title>
				<ows:Abstract>Equidistància entre corbes mestres.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ZMIN</ows:Identifier>
				<ows:Title>Z mínima</ows:Title>
				<ows:Abstract>Valor mínim Z de les isolínies.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ZMAX</ows:Identifier>
				<ows:Title>Z màxima</ows:Title>
				<ows:Abstract>Valor màxim Z de les isolínies.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ZBASE</ows:Identifier>
				<ows:Title>Z base</ows:Title>
				<ows:Abstract>Valor origen de Z.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DENSIFICACIO</ows:Identifier>
				<ows:Title>Densificació</ows:Title>
				<ows:Abstract>Valor corresponent a la densificació de l'MDT. Aquest valor ha de ser un nombre enter i senar entre 1 i 9.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>7</ows:Value>
						<ows:Value>9</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MIGPIXEL</ows:Identifier>
				<ows:Title>Lìmit cerca</ows:Title>
				<ows:Abstract>Paràmetre que implica que es limiti la cerca de vèrtexs d'isolínies fins a una distància de mig píxel de les vores de l'MDT.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GENERALITZACIO</ows:Identifier>
				<ows:Title>Generalització</ows:Title>
				<ows:Abstract>Paràmetre que implica la generalització de les isolínies generades.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ZINCREM</ows:Identifier>
				<ows:Title>Tolerància Z</ows:Title>
				<ows:Abstract>Tolerància del valor Z del píxel de l'MDT en cas que aquest valor correspongui al valor Z d'una de les isolínies. És un valor positiu o negatiu en parts per mil.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PROBL</ows:Identifier>
				<ows:Title>Fitxer de punts extrems</ows:Title>
				<ows:Abstract>Fitxer de punts on es guarden els extrems de les isolínies que no s'ha aconseguit generar satisfactòriament, en cas que n'hi hagi.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerSortida</ows:Identifier>
				<ows:Title>Fitxer de Sortida</ows:Title>
				<ows:Abstract>Vector d'arcs que contindrà les isolínies generades a partir de l'MDT en format ARC.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>