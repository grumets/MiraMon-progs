<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MDTIso:1</ows:Identifier>
		<ows:Title>MDTIso</ows:Title>
		<ows:Abstract>This module allows generating contour lines (also known as contour lines or isopleths) from a digital terrain model (DTM) (for instance elevation, rainfall, evapotranspiration, pollution, etc).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Generation of contour lines from a DTM."/>
		<ows:Metadata xlink:title="Abstract:Aquest mòdul permet generar isolínies a partir d&apos;un model digital del terreny (MDT) (p.ex., elevació, pluviometria, evapotranspiració, contaminació, etc)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMDT</ows:Identifier>
				<ows:Title>DTM file</ows:Title>
				<ows:Abstract>Raster containing the Digital Terrain Model in  IMG format.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:DTMFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Equidistancia</ows:Identifier>
				<ows:Title>Equidistance</ows:Title>
				<ows:Abstract>Contour interval, difference of the Z value between two neighbor contour lines with different value.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Equidistance"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>EQUID_MESTRA</ows:Identifier>
				<ows:Title>Equidistance between principal lines</ows:Title>
				<ows:Abstract>Equidistance between principal lines.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ZMIN</ows:Identifier>
				<ows:Title>Minimum Z</ows:Title>
				<ows:Abstract>Minimum Z value of the contour lines.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ZMAX</ows:Identifier>
				<ows:Title>Maximum Z</ows:Title>
				<ows:Abstract>Maximum Z value of the contour lines.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ZBASE</ows:Identifier>
				<ows:Title>Z base</ows:Title>
				<ows:Abstract>Origin of Z values.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DENSIFICACIO</ows:Identifier>
				<ows:Title>Densification</ows:Title>
				<ows:Abstract>Value corresponding to the densification of the DTM. This value must be an integer and odd number between 1 and 9.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>7</ows:Value>
						<ows:Value>9</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MIGPIXEL</ows:Identifier>
				<ows:Title>Search limit</ows:Title>
				<ows:Abstract>Parameter implying a limitation of the search of contour line vertices up to a distance of half a pixel of the borders of the DTM.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GENERALITZACIO</ows:Identifier>
				<ows:Title>Generalization</ows:Title>
				<ows:Abstract>Parameter implying the generalization of the generated contour lines.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ZINCREM</ows:Identifier>
				<ows:Title>Z tolerance</ows:Title>
				<ows:Abstract>Tolerance of the Z value of the DTM pixel in case this value corresponds to the Z value of one of the contour lines. It is a positive or negative value in  thousands of the contour interval.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PROBL</ows:Identifier>
				<ows:Title>End points file</ows:Title>
				<ows:Abstract>Point file where the ends of the contour lines that have not been generated successfully are saved, in case there are.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerSortida</ows:Identifier>
				<ows:Title>Output file</ows:Title>
				<ows:Abstract>Arc-type vector that will contain the contour lines generated from the DTM in ARC format.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>