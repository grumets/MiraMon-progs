<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 https://schemas.opengis.net/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:DBFCSV:Param1:1</ows:Identifier>
		<ows:Title>De DBF a CSV (opción 1)</ows:Title>
		<ows:Abstract>Convierte archivos desde el formato DBF (tablas dBASE en formato DBF clásica o en DBF extendida) al formato CSV (exportación de tablas de Excel), y al revés.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversión entre ficheros DBF y CSV"/>
		<ows:Metadata xlink:title="Abstract:Esta aplicación convierte archivos desde el formato DBF (tablas dBASE en formato DBF clásica o en DBF extendida) al formato CSV (exportación de tablas de Excel), y viceversa."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Conversión de DBF a CSV.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigenDBF</ows:Identifier>
				<ows:Title>Fichero origen</ows:Title>
				<ows:Abstract>Nombre del archivo DBF a convertir.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroOrigenDBF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SEPARA</ows:Identifier>
				<ows:Title>Separador</ows:Title>
				<ows:Abstract>En la conversión de DBF a CSV se puede escoger el separador de listas, que usualmente es un punto y coma (";"). Se acepta también la palabra especial "TAB" (sin comillas) para escoger el tabulador como separador de listas. También se aceptan las palabras especiales SPA, para indicar que el espacio será el carácter separador de listas, y CAP, para indicar que no hay ningún separador de listas. En la conversión inversa, de CSV a DBF, se debe  escoger el separador que se ha usado en el CSV para generar las diferentes columnas (si se tienen dudas, se puede abrir el archivo con un editor de texto y mirar qué separador se utiliza; téngase en cuenta que si hay comillas (dobles: "), normalmente delimitan un texto que irá a parar a un mismo campo o bien, si están duplicadas, indican que ese carácter es unas comillas).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>;</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDestiCSV</ows:Identifier>
				<ows:Title>Fichero destino</ows:Title>
				<ows:Abstract>Nombre del archivo de salida CSV.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroDestinoCSV"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>CSVW</ows:Identifier>
				<ows:Title>Fichero CSVW</ows:Title>
				<ows:Abstract>Fichero CSVW donde se almacenan los metadatos del contenido de los datos tabulares del fichero CSV.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/json</MimeType>
							<Encoding>UTF-8</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/json</MimeType>
							<Encoding>UTF-8</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:DBFCSV:Param1:2</ows:Identifier>
		<ows:Title>De CSV a DBF (opción 2)</ows:Title>
		<ows:Abstract>Convierte archivos desde el formato CSV (exportación de tablas de Excel) al formato DBF (tablas dBASE en formato DBF clásica o en DBF extendida).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Conversión de CSV a DBF.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampIdGrafic</ows:Identifier>
				<ows:Title>Campo del identificador gráfico</ows:Title>
				<ows:Abstract>Vale 0 si se desea añadir una columna con el campo que contiene el identificador gráfico, si existe, y vale 1 en caso contrario.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:CampoIdGrafico"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Capcalera</ows:Identifier>
				<ows:Title>Cabecera de la primera fila.</ows:Title>
				<ows:Abstract>Vale 1 si se desea usar la primera fila del archivo CSV como cabecera de la DBF (que contiene los nombres de los campos de la DBF).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Cabecera"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DBFClassica</ows:Identifier>
				<ows:Title>Restricción a DBF clásica</ows:Title>
				<ows:Abstract>Vale 1 si se desea restringir la conversión de CSV a una DBF no extendida (clásica), y vale 0 si no se desea aplicar ninguna restricción. En tal caso, la DBF quedará correctamente marcada (si es extendida se podrá ver en "Información | Información de la tabla" abriendo la tabla en MiraDades).</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:DBFClasica"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigenCSV</ows:Identifier>
				<ows:Title>Fichero origen</ows:Title>
				<ows:Abstract>Nombre del archivo CSV o DBF a convertir según la opción elegida.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:FicheroOrigenCSV"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SEPARA</ows:Identifier>
				<ows:Title>Separador</ows:Title>
				<ows:Abstract>En la conversión de DBF a CSV se puede escoger el separador de listas, que usualmente es un punto y coma (";"). Se acepta también la palabra especial "TAB" (sin comillas) para escoger el tabulador como separador de listas. También se aceptan las palabras especiales SPA, para indicar que el espacio será el carácter separador de listas, y CAP, para indicar que no hay ningún separador de listas. En la conversión inversa, de CSV a DBF, se debe  escoger el separador que se ha usado en el CSV para generar las diferentes columnas (si se tienen dudas, se puede abrir el archivo con un editor de texto y mirar qué separador se utiliza; téngase en cuenta que si hay comillas (dobles: "), normalmente delimitan un texto que irá a parar a un mismo campo o bien, si están duplicadas, indican que ese carácter es unas comillas).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>;</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DOBLE_QUALIF</ows:Identifier>
				<ows:Title>Doble calificador</ows:Title>
				<ows:Abstract>Puede valer CARACTER_NORMAL (si el calificador es " y encuentra "", lo considera como una comilla simple, lo cual es útil para soportar segundos de arco en una cadena y, al mismo tiempo, que haya cadenas con calificadores que sean comillas) o QUALIF (opción que considera que el doble calificador tiene el carácter de calificador y que, por tanto, define una cadena vacía). CARACTER_NORMAL es el valor por defecto.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>CARACTER_NORMAL</ows:Value>
						<ows:Value>QUALIF</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>CARACTER_NORMAL</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALIF_TEXT</ows:Identifier>
				<ows:Title>Calificador de texto</ows:Title>
				<ows:Abstract>Puede tomar los siguientes valores: CAP, APOSTROF, COMETES, APOSTROF_EXCEPTE_SI_TAB, COMETES_EXCEPTE_SI_TAB</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>CAP</ows:Value>
						<ows:Value>APOSTROF</ows:Value>
						<ows:Value>COMETES</ows:Value>
						<ows:Value>APOSTROF_EXCEPTE_SI_TAB</ows:Value>
						<ows:Value>COMETES_EXCEPTE_SI_TAB</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>CAP</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CSVW</ows:Identifier>
				<ows:Title>Fichero CSVW</ows:Title>
				<ows:Abstract>Fichero CSVW donde se leen los metadatos del contenido de los datos tabulares del fichero CSV.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/json</MimeType>
							<Encoding>UTF-8</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/json</MimeType>
							<Encoding>UTF-8</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GENERA_UTF8</ows:Identifier>
				<ows:Title>GENERA_UTF8</ows:Title>
				<ows:Abstract>Permite generar el fichero DBF en codificación de caracteres UTF-8.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDestiDBF</ows:Identifier>
				<ows:Title>Fichero destino</ows:Title>
				<ows:Abstract>Nombre del archivo de salida DBF o CSV, según la opción elegida.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:FicheroDestinoDBF"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>