<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GPXMM:param1:1</ows:Identifier>
		<ows:Title>Importación</ows:Title>
		<ows:Abstract>Conversión de un fichero en formato GPX (GPS eXchange Format) al formato topológico de MiraMon (PNT, ARC).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importación y exportación entre el formato GPX y MiraMon"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació serveix per convertir un fitxer en format GPX (GPS eXchange Format) al format topològic del MiraMon (PNT, ARC) i vice-versa."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Importación del formato GPX en el formato MMM.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerGPX</ows:Identifier>
				<ows:Title>Fichero GPX</ows:Title>
				<ows:Abstract>Es el fichero GPX a importar o exportar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerGPX"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/gpx+xml</MimeType>
							<Encoding>utf-8</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/gpx+xml</MimeType>
							<Encoding>utf-8</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Sistema de referencia de destino.</ows:Title>
				<ows:Abstract>Identificador del sistema de proyección del fichero destino en el caso de que se opte por reproyectar. Si no se indica se mantendrá el sistema de referencia indicado en el GPXMM.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ELIP</ows:Identifier>
				<ows:Title>Altura elipsoidal a altura optométrica</ows:Title>
				<ows:Abstract>Asignar la altura elipsoidal a la altura optométrica.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMM</ows:Identifier>
				<ows:Title>Fichero MMM</ows:Title>
				<ows:Abstract>Fichero de salida en formato MMM</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerMMM"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GPXMM:Param1:2&amp;!Param4</ows:Identifier>
		<ows:Title>Exportación del formato PNT y/o ARC al formato GPX</ows:Title>
		<ows:Abstract>Exportación del formato PNT y/o ARC al formato GPX.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Exportación de formato PNT y/o ARC a formato GPX.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerPNToARC</ows:Identifier>
				<ows:Title>Fichero PNT o fichero ARC</ows:Title>
				<ows:Abstract>Es el fichero PNT o el fichero ARC a exportar a GPX</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerPNToARC"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NAME_PNT</ows:Identifier>
				<ows:Title>Nombre campo PNT para etiqueta Name</ows:Title>
				<ows:Abstract>Indica el nombre del campo del PNT que hará de etiqueta Name (si el fichero a exportar es un PNT).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESC_PNT</ows:Identifier>
				<ows:Title>Nombre campo PNT para etiqueta Desc</ows:Title>
				<ows:Abstract>Indica el nombre del campo del PNT que hará de etiqueta Desc (si el archivo a exportar es un PNT).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NAME_ARC</ows:Identifier>
				<ows:Title>Nombre campo ARC para etiqueta Name</ows:Title>
				<ows:Abstract>Indica el nombre del campo de ARC que hará de etiqueta Name (si el archivo a exportar es un ARC).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESC_ARC</ows:Identifier>
				<ows:Title>Nombre campo ARC para etiqueta Desc</ows:Title>
				<ows:Abstract>Indica el nombre del campo del ARC que hará de etiqueta Desc (si el archivo a exportar es un ARC).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ELIP</ows:Identifier>
				<ows:Title>Altura elipsoidal a altura optométrica</ows:Title>
				<ows:Abstract>Asignar la altura elipsoidal a la altura optométrica.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerGPX</ows:Identifier>
				<ows:Title>Fichero GPX</ows:Title>
				<ows:Abstract>Es el fichero GPX a importar o exportar.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerGPX"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/gpx+xml</MimeType>
							<Encoding>utf-8</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/gpx+xml</MimeType>
							<Encoding>utf-8</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GPXMM:param1:2&amp;Param4</ows:Identifier>
		<ows:Title>Exportación del formato PNT y/o ARC al formato GPX</ows:Title>
		<ows:Abstract>Exportación del formato PNT y/o ARC al formato GPX.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Exportación de formato PNT y/o ARC a formato GPX.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerPNT</ows:Identifier>
				<ows:Title>Fichero PNT</ows:Title>
				<ows:Abstract>Es el fichero PNT a exportar a GPX</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerPNT"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
