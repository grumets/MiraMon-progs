						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerARC</ows:Identifier>
				<ows:Title>Fichero ARC</ows:Title>
				<ows:Abstract>Es el fichero ARC a exportar a GPX</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerARC"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NAME_PNT</ows:Identifier>
				<ows:Title>Nombre campo PNT para etiqueta Name</ows:Title>
				<ows:Abstract>Indica el nombre del campo del PNT que hará de etiqueta Name (si el fichero a exportar es un PNT).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESC_PNT</ows:Identifier>
				<ows:Title>Nombre campo PNT para etiqueta Desc</ows:Title>
				<ows:Abstract>Indica el nombre del campo del PNT que hará de etiqueta Desc (si el archivo a exportar es un PNT).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NAME_ARC</ows:Identifier>
				<ows:Title>Nombre campo ARC para etiqueta Name</ows:Title>
				<ows:Abstract>Indica el nombre del campo de ARC que hará de etiqueta Name (si el archivo a exportar es un ARC).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESC_ARC</ows:Identifier>
				<ows:Title>Nombre campo ARC para etiqueta Desc</ows:Title>
				<ows:Abstract>Indica el nombre del campo del ARC que hará de etiqueta Desc (si el archivo a exportar es un ARC).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ELIP</ows:Identifier>
				<ows:Title>Altura elipsoidal a altura optométrica</ows:Title>
				<ows:Abstract>Asignar la altura elipsoidal a la altura optométrica.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerGPX</ows:Identifier>
				<ows:Title>Fichero GPX</ows:Title>
				<ows:Abstract>Es el fichero GPX a importar o exportar.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FitxerGPX"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/gpx+xml</MimeType>
							<Encoding>utf-8</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/gpx+xml</MimeType>
							<Encoding>utf-8</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>