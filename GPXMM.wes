<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GPXMM:param1:1</ows:Identifier>
		<ows:Title>Importació</ows:Title>
		<ows:Abstract>Conversió d'un fitxer en format GPX (GPS eXchange Format) al format topològic de MiraMon (PNT, ARC).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversió de fitxers GPX a fitxers topològics del MiraMon"/>
		<ows:Metadata xlink:title="Abstract:Aquest mòdul serveix per convertir un fitxer en format GPX (GPS eXchange Format) al format topològic del MiraMon (PNT, ARC) i vice-versa."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Importació de format GPX al format MMM.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerGPX</ows:Identifier>
				<ows:Title>Fitxer GPX</ows:Title>
				<ows:Abstract>És el fitxer GPX a importar o exportar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerGPX"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/gpx+xml</MimeType>
							<Encoding>utf-8</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/gpx+xml</MimeType>
							<Encoding>utf-8</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Sistema de referència de destí.</ows:Title>
				<ows:Abstract>Identificador del sistema de projecció del fitxer destí en el cas de que s'opti per reprojectar. Si no s'indica es mantindrà el sistema de referència indicat en el GPXMM.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ELIP</ows:Identifier>
				<ows:Title>Altura el·lipsoïdal a altura optomètrica</ows:Title>
				<ows:Abstract>Assignar l'altura el·lipsoïdal a l'altura optomètrica.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMM</ows:Identifier>
				<ows:Title>Fitxer MMM</ows:Title>
				<ows:Abstract>Fitxer de sortida en format MMM</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerMMM"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GPXMM:Param1:2&amp;!Param4</ows:Identifier>
		<ows:Title>Exportació de format PNT i/o ARC a format GPX.</ows:Title>
		<ows:Abstract>Exportació del format PNT o el format ARC a format GPX.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Exportació de format PNT i/o ARC a format GPX.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerPNToARC</ows:Identifier>
				<ows:Title>Fitxer PNT o fitxer ARC</ows:Title>
				<ows:Abstract>És el fitxer PNT o el fitxer ARC a exportar a GPX</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerPNToARC"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NAME_PNT</ows:Identifier>
				<ows:Title>Nom camp PNT per a etiqueta Name</ows:Title>
				<ows:Abstract>Indica el nom del camp del PNT que farà d'etiqueta Name (si el fitxer a exportar és un PNT).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESC_PNT</ows:Identifier>
				<ows:Title>Nom camp PNT per a etiqueta Desc</ows:Title>
				<ows:Abstract>Indica el nom del camp del PNT que farà d'etiqueta Desc (si el fitxer a exportar és un PNT).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NAME_ARC</ows:Identifier>
				<ows:Title>Nom camp ARC per a etiqueta Name</ows:Title>
				<ows:Abstract>Indica el nom del camp de l'ARC que farà d'etiqueta Name (si el fitxer a exportar és un ARC).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESC_ARC</ows:Identifier>
				<ows:Title>Nom camp ARC per a etiqueta Desc</ows:Title>
				<ows:Abstract>Indica el nom del camp de l'ARC que farà d'etiqueta Desc (si el fitxer a exportar és un ARC).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ELIP</ows:Identifier>
				<ows:Title>Altura el·lipsoïdal a altura optomètrica</ows:Title>
				<ows:Abstract>Assignar l'altura el·lipsoïdal a l'altura optomètrica.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerGPX</ows:Identifier>
				<ows:Title>Fitxer GPX</ows:Title>
				<ows:Abstract>És el fitxer GPX a importar o exportar.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerGPX"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/gpx+xml</MimeType>
							<Encoding>utf-8</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/gpx+xml</MimeType>
							<Encoding>utf-8</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
