<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ClsMix:Param1:1</ows:Identifier>
		<ows:Title>ClsMix</ows:Title>
		<ows:Abstract>ClsMix is a module for the mixed classification of remote sensing images. The adjective mixed is used because the classification method combines elements of a supervised classification (the training areas) with elements of an unsupervised classification (the results of the latter).</ows:Abstract>
<ows:Metadata xlink:title="Title:Mixed classification of images" />
<ows:Metadata xlink:title="Abstract:ClsMix is a module for the mixed classification of remote sensing images. The adjective mixed is used because the classification method combines elements of a supervised classification (the training areas) with elements of an unsupervised classification (the results of the latter)." />
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TrainingImage</ows:Identifier>
				<ows:Title>Training Image</ows:Title>
				<ows:Abstract>Name of the image with the training areas (without extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
			<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>UnsupervisedClsImage</ows:Identifier>
				<ows:Title>Unsupervised ClsImage</ows:Title>
				<ows:Abstract>Name of the image produced by unsupervised classification (without extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param2" />
			<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TextResults</ows:Identifier>
				<ows:Title>TextResults</ows:Title>
				<ows:Abstract>Name of the text file with the results (with extension, if desired;txt) is commonly used.</ows:Abstract>
<ows:Metadata xlink:title="Param4" />
		<ComplexData>
					<Default>
						<Format>
							<MimeType>text/x-txt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/x-txt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
		</ComplexData>
		</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Faith</ows:Identifier>
				<ows:Title>Fidelity</ows:Title>
				<ows:Abstract>Fidelity of the spectral class to a thematic class, in per one percentage.</ows:Abstract>
				<ows:Metadata xlink:title="Param5" />
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Represent</ows:Identifier>
				<ows:Title>Representativity</ows:Title>
				<ows:Abstract>Representativity of the spectral class in the thematic class, in per one percentage.</ows:Abstract>
				<ows:Metadata xlink:title="Param6" />
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Weighting</ows:Identifier>
				<ows:Title>Weighting</ows:Title>
				<ows:Abstract><![CDATA[possible frequency weighting of the thematic classes according to the number of pixels of each training area. Options:<ul><li>0: without weighting</li><li>1: with weighting</li><li>2: weighting by conditioned probabilities, which should be in a text file which will be required during the execution of the module (2 columns, the 1st with the code of the thematic class, and the 2nd with the frequency).</li></ul>]]>
</ows:Abstract>
				<ows:Metadata xlink:title="Param7" />
				<LiteralData>
					<ows:AllowedValues>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
	</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ResultingImage</ows:Identifier>
				<ows:Title>ResultingImage</ows:Title>
				<ows:Abstract>Name of the image to be created (without extension).
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
						<ComplexOutput>
						<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
