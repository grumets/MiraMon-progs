<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:VrtPunt:1</ows:Identifier>
		<ows:Title>Creación de un fichero de puntos a partir de ficheros de líneas y polígonos.</ows:Title>
		<ows:Abstract>Este programa crea un fichero de puntos a partir de la extracción de los vértices de los ficheros de líneas o polígonos dados.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Creación de un fichero de puntos a partir de ficheros de líneas y polígonos."/>
		<ows:Metadata xlink:title="Abstract:Este programa crea un fichero de puntos a partir de la extracción de los vértices de los ficheros de líneas o polígonos dados."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>F_file_in</ows:Identifier>
				<ows:Title>Fichero de líneas o polígonos</ows:Title>
				<ows:Abstract>Nombre del fichero de líneas o polígonos a convertir en fichero de puntos.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FicheroEntrada"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>F_file_out</ows:Identifier>
				<ows:Title>Fichero VEC</ows:Title>
				<ows:Abstract>Nombre del fichero  VEC de puntos de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
