<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SIDIMG:Param1:0</ows:Identifier>
		<ows:Title>Mostra medadades</ows:Title>
		<ows:Abstract>Mostra les metadades internes que hi ha desades dins del fitxer MrSID.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversió entre els formats ràster MrSID i IMG o JPEG"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació permet obtenir la informació de les metadades internes del format MrSID, importar un MrSID a un format JPEG (de grisos o RGB, segons sigui el fitxer MrSID) o extreure entre una i tres bandes IMG d'un MrSID."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 0</ows:Title>
				<ows:Abstract>Mostra les metadades internes que hi ha desades dins del fitxer MrSID.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerMrSID</ows:Identifier>
				<ows:Title>Nom Fitxer MrSID</ows:Title>
				<ows:Abstract>És el nom del fitxer MrSID v2 o v3 a transformar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NomFitxerMrSID"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/x-mrsid</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/x-mrsid</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Stdout</ows:Identifier>
				<ows:Title>Estàndard de sortida</ows:Title>
				<ows:Abstract>Mostra les medadades del MrSID.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SIDIMG:Param1:1</ows:Identifier>
		<ows:Title>JPEG</ows:Title>
		<ows:Abstract>Genera un fitxer JPEG a partir d'una imatge MrSID.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 1</ows:Title>
				<ows:Abstract>Genera un fitxer JPEG a partir d'una imatge MrSID.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerMrSID</ows:Identifier>
				<ows:Title>Nom Fitxer MrSID</ows:Title>
				<ows:Abstract>És el nom del fitxer MrSID v2 o v3 a transformar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NomFitxerMrSID"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/x-mrsid</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/x-mrsid</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALITAT</ows:Identifier>
				<ows:Title>Qualitat de compressió</ows:Title>
				<ows:Abstract>Qualitat de compressió en un rang [0,100], on [5,95] és el rang útil encara que en molts casos és recomenable introduir un valor entre 70 i 75 (per defecte és 75). Els valors baixos indiquen molt poca qualitat però molta compressió.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>100</ows:MaximumValue>
						</ows:Range>
					</ows:AllowedValues>
					<DefaultValue>75</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FWORLD</ows:Identifier>
				<ows:Title>Fitxer WORLD</ows:Title>
				<ows:Abstract><![CDATA[Permet generar un fitxer <i>world</i> (georeferenciació) amb l'extensió indicada. Podeu indicar <i>/FWORLD</i> per generar-lo usant l'extensió per defecte.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFitxerJPEG</ows:Identifier>
				<ows:Title>Nom Fitxer JPEG</ows:Title>
				<ows:Abstract>És el nom del fitxer JPEG resultat de la transformació.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NomFitxerJPEG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SIDIMG:Param1:2</ows:Identifier>
		<ows:Title>IMG</ows:Title>
		<ows:Abstract>Genera 1 fitxer IMG a partir d'un fitxer MrSID de grisos.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 2</ows:Title>
				<ows:Abstract>Genera 1 fitxer IMG a partir d'un fitxer MrSID de grisos.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerMrSID</ows:Identifier>
				<ows:Title>Nom Fitxer MrSID</ows:Title>
				<ows:Abstract>És el nom del fitxer MrSID v2 o v3 a transformar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NomFitxerMrSID"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/x-mrsid</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/x-mrsid</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALITAT</ows:Identifier>
				<ows:Title>Qualitat de compressió</ows:Title>
				<ows:Abstract>Qualitat de compressió en un rang [0,100], on [5,95] és el rang útil encara que en molts casos és recomenable introduir un valor entre 70 i 75 (per defecte és 75). Els valors baixos indiquen molt poca qualitat però molta compressió.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>100</ows:MaximumValue>
						</ows:Range>
					</ows:AllowedValues>
					<DefaultValue>75</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FWORLD</ows:Identifier>
				<ows:Title>Fitxer WORLD</ows:Title>
				<ows:Abstract><![CDATA[Permet generar un fitxer <i>world</i> (georeferenciació) amb l'extensió indicada. Podeu indicar <i>/FWORLD</i> per generar-lo usant l'extensió per defecte.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFitxerIMG</ows:Identifier>
				<ows:Title>Nom Fitxer IMG</ows:Title>
				<ows:Abstract>És el nom del fitxer IMG resultat de la transformació per a MrSID d'una sola banda espectral (grisos).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NomFitxerIMG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SIDIMG:Param1:3</ows:Identifier>
		<ows:Title>MULTIBANDA</ows:Title>
		<ows:Abstract>Genera 3 fitxers IMG a partir d'un fitxer MrSID de 24 bits.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 3</ows:Title>
				<ows:Abstract>Genera 3 fitxers IMG a partir d'un fitxer MrSID de 24 bits.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerMrSID</ows:Identifier>
				<ows:Title>Nom Fitxer MrSID</ows:Title>
				<ows:Abstract>És el nom del fitxer MrSID v2 o v3 a transformar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NomFitxerMrSID"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/x-mrsid</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/x-mrsid</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALITAT</ows:Identifier>
				<ows:Title>Qualitat de compressió</ows:Title>
				<ows:Abstract>Qualitat de compressió en un rang [0,100], on [5,95] és el rang útil encara que en molts casos és recomenable introduir un valor entre 70 i 75 (per defecte és 75). Els valors baixos indiquen molt poca qualitat però molta compressió.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>100</ows:MaximumValue>
						</ows:Range>
					</ows:AllowedValues>
					<DefaultValue>75</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FWORLD</ows:Identifier>
				<ows:Title>Fitxer WORLD</ows:Title>
				<ows:Abstract><![CDATA[Permet generar un fitxer <i>world</i> (georeferenciació) amb l'extensió indicada. Podeu indicar <i>/FWORLD</i> per generar-lo usant l'extensió per defecte.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFitxerIMG_R</ows:Identifier>
				<ows:Title>Nom Fitxer IMG Vermell</ows:Title>
				<ows:Abstract>És el nom del fitxer IMG resultat de la transformació de la banda del vermell del triplet RGB.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NomFitxerIMG_R"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>NomFitxerIMG_G</ows:Identifier>
				<ows:Title>Nom Fitxer IMG Verd</ows:Title>
				<ows:Abstract>És el nom del fitxer IMG resultat de la transformació de la banda del verd del triplet RGB.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NomFitxerIMG_G"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>NomFitxerIMG_B</ows:Identifier>
				<ows:Title>Nom Fitxer IMG Blau</ows:Title>
				<ows:Abstract>És el nom del fitxer IMG resultat de la transformació de la banda del blau del triplet RGB.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:NomFitxerIMG_B"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
