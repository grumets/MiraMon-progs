<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:RasSelec:1</ows:Identifier>
		<ows:Metadata xlink:title="Title:Selección de un subconjunto de celdas en rásters"/>
		<ows:Metadata xlink:title="Abstract:Selección de un subconjunto de celdas de un ráster monobanda o multibanda."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxOri</ows:Identifier>
				<ows:Title>Fichero origen</ows:Title>
				<ows:Abstract>Fichero origen para realizar la selección.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FicheroOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RETALL_SEL</ows:Identifier>
				<ows:Title>Recortar por selección</ows:Title>
				<ows:Abstract>Recortar el fichero de salida ajustado a la selección.</ows:Abstract>
				<ows:Metadata xlink:title="Name:RETALL_SEL"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefijo multibanda</ows:Title>
				<ows:Abstract>Prefijo en los ficheros de salida en caso de multibanda.</ows:Abstract>
				<ows:Metadata xlink:title="Name:PREFIX"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MASC_NODATA</ows:Identifier>
				<ows:Title>Marcar los 0 como sindatos</ows:Title>
				<ows:Abstract>En caso de que se seleccione la salida como formato máscara, se marca el 0 (condición falsa) como valor sin datos.</ows:Abstract>
				<ows:Metadata xlink:title="Name:MASC_NODATA"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>Salida multibanda</ows:Title>
				<ows:Abstract>En caso de que el fichero origen sea multibanda, se asigna que la salida sea también multibanda.</ows:Abstract>
				<ows:Metadata xlink:title="Name:MULTIBANDA"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="50">
				<ows:Identifier>COND#_OP</ows:Identifier>
				<ows:Title>Condición o operador</ows:Title>
				<ows:Abstract><![CDATA[Selección del operador lógico que actuará sobre /COND_CAMP(banda) para filtrar las celdas del fichero origen. Para más detalles de este y los siguientes modificadores, se puede consultar el apartado <a href="General.htm#SelecAtrib">Selección de objetos gráficos por atributos de la base de datos, o de celdas de rásters por consulta sobre sus valores</a> en <a href="General.htm">Aspectos generales de sintaxis en las Aplicaciones de Soporte a MiraMon (MSA)</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>EQ</ows:Value>
						<ows:Value>NO_EQ</ows:Value>
						<ows:Value>EQ_SUBCADENA</ows:Value>
						<ows:Value>NO_EQ_SUBCADENA</ows:Value>
						<ows:Value>LT_EQ</ows:Value>
						<ows:Value>GT_EQ</ows:Value>
						<ows:Value>INTERVAL</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="50">
				<ows:Identifier>COND#_CAMP</ows:Identifier>
				<ows:Title>Bandas de la condición</ows:Title>
				<ows:Abstract>Selección de la banda sobre la cual se aplicará la /COND_OP.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="50">
				<ows:Identifier>COND#_VALOR</ows:Identifier>
				<ows:Title>Valor de la condición</ows:Title>
				<ows:Abstract>Valor del /COND_CAMP sobre el que se aplicará la /COND_OP. Hacen falta comillas si lleva espacios.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="50">
				<ows:Identifier>COND#_NEXE</ows:Identifier>
				<ows:Title>Nexo entre condiciones</ows:Title>
				<ows:Abstract>Nexo entre las condiciones # y #+1. Puede ser AND (y) o OR (o).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>OR</ows:Value>
						<ows:Value>AND</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>BANDA</ows:Identifier>
				<ows:Title>Banda</ows:Title>
				<ows:Abstract>En el caso de un fichero leído a través de GDAL, es la banda de referencia a la que se desea aplicar la selección. En caso de que no se indique la banda, se utilizará la primera banda de referencia. Si se selecciona una salida multibanda, se escribirán todas las bandas del mismo subconjunto de datos que tengan el mismo paso de malla que la banda de referencia.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SDS</ows:Identifier>
				<ows:Title>Subconjunto de datos</ows:Title>
				<ows:Abstract>En caso de un fichero leído vía GDAL, es el subconjunto de datos del fichero de entrada sobre el que se desea aplicar la selección.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MASC</ows:Identifier>
				<ows:Title>Fichero destino como máscara</ows:Title>
				<ows:Abstract>Se guardará el fichero de salida como una máscara, es decir, las celdas que cumplan las condiciones de la selección tendrán el valor 1, mientras que las celdas que no las cumplan tendrán el valor 0  (se puede consultar también /MASC_NODATA). El fichero de salida se guardará en formato byte comprimido e indexado.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxOut</ows:Identifier>
				<ows:Title>Fichero o directorio de salida</ows:Title>
				<ows:Abstract>Fichero de salida en caso de monobanda, o directorio de salida en caso de multibanda.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>