<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CreaTIN:1</ows:Identifier>
		<ows:Title>Generació de models TIN des d'un núvol de punts</ows:Title>
		<ows:Abstract><![CDATA[Aquesta aplicació permet generar una malla TIN (xarxa irregular de triangles, per <i>triangulated irregular network</i> en anglès) a partir d'un fitxer de punts.]]></ows:Abstract>
		<ows:Metadata xlink:title="Title:Generació de models TIN des d&apos;un núvol de punts"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació permet generar una malla TIN (xarxa irregular de triangles, per &lt;i&gt;triangulated irregular network&lt;/i&gt; en anglès) a partir d&apos;un fitxer de punts."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Opció única en aquesta versió del programa. El valor "1" s'ha d'incloure a la línia de comandes.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>PNTOrigen</ows:Identifier>
				<ows:Title>Fitxer de punts origen</ows:Title>
				<ows:Abstract>Fitxer de punts origen en format PNT.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerPNTOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CampZ</ows:Identifier>
				<ows:Title>Camp Z</ows:Title>
				<ows:Abstract>Camp emprat per a generar la coordenada Z dels polígons del TIN de sortida (paràmetre opcional).</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:CampZ"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>3D</ows:Identifier>
				<ows:Title>Usar cota 3D dels punts origen</ows:Title>
				<ows:Abstract>En el cas que el fitxer de punts sigui 3D, s'usa la cota 3D dels punts origen en lloc d'usar un camp de la base de dades origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>Usar punts amb cota sensedades o etiqueta buida</ows:Title>
				<ows:Abstract>Permet usar punts amb cota sensedades (en el cas d'usar cota 3D dels punts origen) o amb etiqueta buida (en el cas d'usar un camp de la base de dades origen).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>TINSortida</ows:Identifier>
				<ows:Title>Fitxer TIN de sortida</ows:Title>
				<ows:Abstract>Fitxer TIN de sortida en format POL.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerTINSortida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>