<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MatConf:Param3</ows:Identifier>
		<ows:Title>Texto</ows:Title>
		<ows:Abstract>Esta opción construye la 'Matriz de confusión', una tabla bidimensional de comparación de los datos de la imagen clasificada con los datos de referencia o verdad-terreno. El formato de salida es un fichero de texto.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Generación de matrices de confusión para la evaluación de cartografía temática categórica"/>
		<ows:Metadata xlink:title="Abstract:Este programa construye la &apos;Matriz de confusión&apos;, una tabla bidimensional de comparación de los datos de la imagen clasificada con los datos de referencia o verdad-terreno. El formato de salida puede ser un fichero de texto o un fichero en formato de hoja de cálculo (CSV)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Referencia</ows:Identifier>
				<ows:Title>Referencia</ows:Title>
				<ows:Abstract>Referencia es el ráster verdad-terreno.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Referencia"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Test</ows:Identifier>
				<ows:Title>Test</ows:Title>
				<ows:Abstract>Test corresponde al ráster clasificado a evaluar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Test"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NCOL</ows:Identifier>
				<ows:Title>Numero de columnas</ows:Title>
				<ows:Abstract>Solicita el valor numérico de la paginación o tamaño máximo del informe expresado en número de columnas (categorías). Este parámetro es válido para los dos tipos de informe.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CATEG_FIXAT</ows:Identifier>
				<ows:Title>Categorías de la imagen</ows:Title>
				<ows:Abstract>El tesauro de categorías de la imagen verdad-terreno marca el número de columnas de la matriz de confusión.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SEPARA</ows:Identifier>
				<ows:Title>Separador</ows:Title>
				<ows:Abstract>Especifica el separador de listas necesario para el formato hoja de cálculo (CSV).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FTXT</ows:Identifier>
				<ows:Title>Fichero de Texto</ows:Title>
				<ows:Abstract>Hay que indicar el nombre del fichero de texto donde el programa escribirá la matriz de confusión.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MatConf:!Param3</ows:Identifier>
		<ows:Title>CSV</ows:Title>
		<ows:Abstract>esta opción construye la 'Matriz de confusión', una tabla bidimensional de comparación de los datos de la imagen clasificada con los datos de referencia o verdad-terreno. El formato de salida es un fichero en formato de hoja de cálculo (CSV).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Referencia</ows:Identifier>
				<ows:Title>Referencia</ows:Title>
				<ows:Abstract>Referencia es el ráster verdad-terreno.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Referencia"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Test</ows:Identifier>
				<ows:Title>Test</ows:Title>
				<ows:Abstract>Test corresponde al ráster clasificado a evaluar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Test"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NCOL</ows:Identifier>
				<ows:Title>Numero de columnas</ows:Title>
				<ows:Abstract>Solicita el valor numérico de la paginación o tamaño máximo del informe expresado en número de columnas (categorías). Este parámetro es válido para los dos tipos de informe.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CATEG_FIXAT</ows:Identifier>
				<ows:Title>Categorías de la imagen</ows:Title>
				<ows:Abstract>El tesauro de categorías de la imagen verdad-terreno marca el número de columnas de la matriz de confusión.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SEPARA</ows:Identifier>
				<ows:Title>Separador</ows:Title>
				<ows:Abstract>Especifica el separador de listas necesario para el formato hoja de cálculo (CSV).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FCSV</ows:Identifier>
				<ows:Title>Fichero de CSV</ows:Title>
				<ows:Abstract>Hay que indicar el nombre del fichero de salida que contiene la matriz de confusión en formato hoja de cálculo.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>