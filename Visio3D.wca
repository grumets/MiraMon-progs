<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:visio3d:1</ows:Identifier>
		<ows:Title>Visio3d</ows:Title>
		<ows:Abstract>Aquesta aplicació permet generar una perspectiva 3D a partir del model digital d_elevacions de qualsevol imatge: temàtica, ortofotografia o qualsevol model continu com el propi MDE. Existeixen dos modes d'execució: Previsualització i Definitiva. El mode de previsualització és més ràpid que el definitiu i es recomana per cercar els paràmetres geomètrics més propers a la representació que es desitgi aconseguir. Amb la elecció d'aquest mode, no és possible activar l'opció d'ombrejat. El mode definitiu és més lent però genera una representació tridimensional de major qualitat.</ows:Abstract>
<ows:Metadata xlink:title="Title:Generació de perspectives 3D a partir d'un mapa ràster i el seu MDE."/>
<ows:Metadata xlink:title="Abstract:Aquesta aplicació permet generar una perspectiva 3D a partir del model digital d_elevacions de qualsevol imatge: temàtica, ortofotografia o qualsevol model continu com el propi MDE. Existeixen dos modes d'execució: Previsualització i Definitiva. El mode de previsualització és més ràpid que el definitiu i es recomana per cercar els paràmetres geomètrics més propers a la representació que es desitgi aconseguir. Amb la elecció d'aquest mode, no és possible activar l'opció d'ombrejat. El mode definitiu és més lent però genera una representació tridimensional de major qualitat." />
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract><![CDATA[<li>1 per fer una previsualització del resultat.</li><li>2 per a la versió definitiva.</li>]]></ows:Abstract>
						<ows:Metadata xlink:title="Param1" />
					<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer "> integer</ows:DataType>
						<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						</ows:AllowedValues>
					</LiteralData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMDE</ows:Identifier>
				<ows:Title>Fitxer MDE</ows:Title>
				<ows:Abstract>Fitxer que conté el Model Digital del Terreny en format .IMG</ows:Abstract>
				<ows:Metadata xlink:title="Param2" />
				<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Text</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Text</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerRaster</ows:Identifier>
				<ows:Title>Fitxer Raster</ows:Title>
				<ows:Abstract> Fitxer que conté la informació temàtica en format ràster .IMG o .JPG</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
				<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Text</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Text</Encoding>
							</Format>
								<Format>
								<MimeType>application/x-JPG</MimeType>
								<Encoding>Text</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>AzimPuntVista</ows:Identifier>
				<ows:Title>Azimut Punt Vista</ows:Title>
				<ows:Abstract>Azimut del punt de vista en graus.</ows:Abstract>
				<ows:Metadata xlink:title="Param5" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ElevPuntVista</ows:Identifier>
				<ows:Title>ElevacióPunt Vista</ows:Title>
				<ows:Abstract>ModeInterpol:<![CDATA[<ul><li>0: Veí més proper</li><li>1: Interpolació bilineal</li><li>2: Interpolació bicúbica</li></ul>]]>
</ows:Abstract>
<ows:Metadata xlink:title="Param6" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ExagVert</ows:Identifier>
				<ows:Title>Exageració vertical</ows:Title>
				<ows:Abstract>És el factor d'escala de l'eix vertical. Quan el valor és 1, no hi ha exageració vertical.</ows:Abstract>
<ows:Metadata xlink:title="Param7" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>AzimSolar</ows:Identifier>
				<ows:Title>Azimut Solar</ows:Title>
				<ows:Abstract> Azimut de la posició solar en graus. Aquest valor és necessari en el cas que és vulgui afegir ombrejat.</ows:Abstract>
<ows:Metadata xlink:title="Param8" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ElevSolar</ows:Identifier>
				<ows:Title>Elevació Solar</ows:Title>
				<ows:Abstract>Angle d'elevació de la posició solar en graus. Aquest valor és necessari en el cas que és vulgui afegir ombrejat.</ows:Abstract>
<ows:Metadata xlink:title="Param9" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>IncremIllum</ows:Identifier>
				<ows:Title>Increment Illuminació</ows:Title>
				<ows:Abstract>Correspon al nivell constant d'il·luminació amb que s'incrementa tota la imatge per a contrarestar globalment la disminució variable d'il·luminació deguda a l'aplicació del model d'ombres i el model d'il·luminacions. Un valor genèric recomanat és el 33%, però caldrà ajustar-lo segons el cas. Aquest valor és necessari en el cas que és vulgui afegir ombrejat.</ows:Abstract>
<ows:Metadata xlink:title="Param10" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>		
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MinimIllum</ows:Identifier>
				<ows:Title>Mínim Illuminació</ows:Title>
				<ows:Abstract>Percentatge mínim que pot arribar a quedar enfosquit un color en l'espai HSI. Els valors inferiors es saturaran. Si es permet un percentatge excessivament baix, els colors enfosquits no es diferenciaran. Un valor genèric recomanat és el 5%, però caldrà ajustar-lo segons el cas. Aquest valor és necessari en el cas que és vulgui afegir ombrejat.</ows:Abstract>
<ows:Metadata xlink:title="Param11" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>		
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MaximIllum</ows:Identifier>
				<ows:Title>Màxim Illuminació</ows:Title>
				<ows:Abstract>Percentatge màxim que pot arribar a quedar enfosquit un color en l'espai HSI. Els valors superiors es saturaran. Si es permet un percentatge excessivament alt, els colors molt clars no es diferenciaran. Un valor genèric recomanat és el 95%, però caldrà ajustar-lo segons el cas. Aquest valor és necessari en el cas que és vulgui afegir ombrejat.</ows:Abstract>
<ows:Metadata xlink:title="Param12" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Ombra</ows:Identifier>
				<ows:Title>Ombra</ows:Title>
				<ows:Abstract>Per afegir un ombrejat al resultat final.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues><ows:Value>##blank##</ows:Value></ows:AllowedValues>
				</LiteralData>
			</Input>			
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Paleta</ows:Identifier>
				<ows:Title>Paleta</ows:Title>
				<ows:Abstract>Fitxer que conté una paleta de colors. Aquest paràmetre és obligatori en el cas d'introduir un fitxer ràster en format .IMG i un fitxer de sortida en format .JPG.</ows:Abstract>
			<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-PAL</MimeType>
								<Encoding>Text</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-PAL</MimeType>
								<Encoding>Text</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>			
			</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerSortida</ows:Identifier>
				<ows:Title>Fitxer Sortida</ows:Title>
				<ows:Abstract>Fitxer que conté la perspectiva 3D de la informació temàtica respecte el MDE d'entrada. Aquest fitxer pot ser un format .IMG o .JPG
				</ows:Abstract>
				<ows:Metadata xlink:title="Param4" />
						<ComplexOutput>
							<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
							<Format>
							<MimeType>application/x-JPG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
							</Supported>
						</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	</wps:ProcessDescriptions>
