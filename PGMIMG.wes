					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerPPM</ows:Identifier>
				<ows:Title>Fichero PPM</ows:Title>
				<ows:Abstract>Fichero en formato PPM</ows:Abstract>
