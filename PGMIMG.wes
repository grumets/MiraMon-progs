	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:PGMIMG:2:!Param4</ows:Identifier>
		<ows:Title>Exportació de IMG a PGM</ows:Title>
