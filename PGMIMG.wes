			<Output>
				<ows:Identifier>FitxerB</ows:Identifier>
				<ows:Title>Fichero B</ows:Title>
				<ows:Abstract>Fichero en formato IMG de la banda B (azul)</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
