<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:PGMIMG:0</ows:Identifier>
		<ows:Title>Información de la cabecera</ows:Title>
		<ows:Abstract>Muestra la información de la cabecera del archivo</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importación y exportación entre los formatos PGM/PPM (Meteosat, etc) y MiraMon"/>
		<ows:Metadata xlink:title="Abstract:Esta aplicación permite importar y exportar las versiones binarias de los formatos PGM y PPM."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Muestra la información de la cabecera del fichero</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerPGM_PPM</ows:Identifier>
				<ows:Title>Fichero PGM o PPM</ows:Title>
				<ows:Abstract>Fichero en formato PGM o PPM</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroPGM/PPM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/x-portable-pixmap</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/x-portable-pixmap</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>image/x-portable-pixmap</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/x-portable-graymap</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>image/x-portable-graymap</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Stdout</ows:Identifier>
				<ows:Title>Estàndard de sortida</ows:Title>
				<ows:Abstract>Informació sobre els PGM o PPM</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:PGMIMG:1:!Param4</ows:Identifier>
		<ows:Title>Importación de PGM a MiraMon</ows:Title>
		<ows:Abstract>Importación de ficheros PGM al formato ràster IMG de MiraMon</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Importación de PGM/PPM a MiraMon</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerPGM</ows:Identifier>
				<ows:Title>Fichero PGM</ows:Title>
				<ows:Abstract>Fichero en formato PGM</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroPGM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/x-portable-graymap</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/x-portable-graymap</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>image/x-portable-graymap</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ORDRE_MOTOROLA</ows:Identifier>
				<ows:Title>Origen con ordenación de bytes Motorola</ows:Title>
				<ows:Abstract><![CDATA[Indica que los datos originales son <i>integer</i> o <i>long</i> y que el orden de los <i>bytes</i> es  inverso al orden utilizado por MiraMon (ordenación Intel). Así pues, fuerza la inversión de los bytes en la importación en MiraMon.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MSG</ows:Identifier>
				<ows:Title>Fichero de entrada Meteosat</ows:Title>
				<ows:Abstract>Indica que el archivo de entrada es un fichero Meteosat de segunda generación.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>Valor sindatos</ows:Title>
				<ows:Abstract>Indica cuál es el valor de los datos originales que se documentará como valor sindatos</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerIMG</ows:Identifier>
				<ows:Title>Fichero IMG</ows:Title>
				<ows:Abstract>Fichero en formato IMG</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroIMG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:PGMIMG:1:Param4</ows:Identifier>
		<ows:Title>Importación de PPM a MiraMon</ows:Title>
		<ows:Abstract>Importación de ficheros PPM al formato ràster RGB de MiraMon</ows:Abstract>
