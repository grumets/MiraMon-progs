			<Output>
				<ows:Identifier>FitxerG</ows:Identifier>
				<ows:Title>Fichero G</ows:Title>
				<ows:Abstract>Fichero en formato IMG de la banda G (verde)</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FicheroG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
