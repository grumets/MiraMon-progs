			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier> format_sortida</ows:Identifier>
				<ows:Title>Format sortida</ows:Title>
				<ows:Abstract>Per canals no tèrmics, 1 si es desitja un format de sortida byte o 4 si es desitja real; pels canals tèrmics sempre és real i aquest paràmetre és ignorat.</ows:Abstract>
<ows:Metadata xlink:title="Param7" />
