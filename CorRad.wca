<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CorRad:!Param8</ows:Identifier>
		<ows:Title>CorRad</ows:Title>
		<ows:Abstract>Permet corregir radiomètricament imatges de Teledetecció captades en les regions espectrals visible i infraroig (proper, mitjà i tèrmic).</ows:Abstract>
<ows:Metadata xlink:title="Title:Correcció radiomètrica d'imatges de Teledetecció." />
<ows:Metadata xlink:title="Abstract:Aquest mòdul permet corregir radiomètricament imatges de Teledetecció captades en les regions espectrals visible i infraroig (proper, mitjà i tèrmic)" />
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Imatge_a_corregir</ows:Identifier>
				<ows:Title>Imatge a corregir</ows:Title>
				<ows:Abstract> Imatge a corregir radiomètricament (pot formar part d'un ràster multibanda) </ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
			<ComplexData>
					<Default>
						<Format>
								<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
		</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MDE</ows:Identifier>
				<ows:Title>Model Digital d'Elevacions</ows:Title>
				<ows:Abstract>Model Digital d'Elevacions </ows:Abstract>
				<ows:Metadata xlink:title="Param2" />
			<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
		</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Sensor</ows:Identifier>
				<ows:Title>Sensor</ows:Title>
				<ows:Abstract>Sensor utilitzat o el fitxer RAD amb els paràmetres necessaris S0, tau0, tau0_ret, TempK1, TempK2</ows:Abstract>
<ows:Metadata xlink:title="Param4" />
		<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-rad</MimeType>
							<Encoding>UTF-8</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-rad</MimeType>
							<Encoding>UTF-8</Encoding>
						</Format>
					</Supported>
		</ComplexData>
		</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>K1</ows:Identifier>
				<ows:Title>K1</ows:Title>
				<ows:Abstract>Valor de Kl, constat d'objecte fosc</ows:Abstract>
<ows:Metadata xlink:title="Param5" />
		<LiteralData>
		<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
			<ows:AnyValue/>
		</LiteralData>
		</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Angle_limit</ows:Identifier>
				<ows:Title>Angle Limit</ows:Title>
				<ows:Abstract>És l'angle límit lambertià</ows:Abstract>
<ows:Metadata xlink:title="Param6" />
		<LiteralData>
		<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
			<ows:AnyValue/>
		</LiteralData>
		</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>format_sortida</ows:Identifier>
				<ows:Title>Format sortida</ows:Title>
				<ows:Abstract>Per canals no tèrmics, 1 si es desitja un format de sortida byte o 4 si es desitja real; pels canals tèrmics sempre és real i aquest paràmetre és ignorat.</ows:Abstract>
<ows:Metadata xlink:title="Param7" />
		<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
						<ows:Value>4</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
			</LiteralData>
		</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ERROR_MDE</ows:Identifier>
				<ows:Title>Error a Assumir</ows:Title>
				<ows:Abstract>Error a assumir en les altituds de l'MDE. Si no s'indica es pendrà el que estigui documentat a les metadades o zero si no es troba. Si l'error documentat a les metadades és un RMS, es pendrà el doble d'aquest valor.</ows:Abstract>
		<LiteralData>
			<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:AnyValue/>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
			</LiteralData>
		</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATA</ows:Identifier>
				<ows:Title>Data del contingut de la imatge</ows:Title>
				<ows:Abstract>Si no s'indica es pendrà el que estigui documentat a les metadades. Data del contingut de la imatge a corregir, en format ANYMESDIA HORAMINUTSEGONCENTÈSSIMES detallat a la sintaxi general.</ows:Abstract>
				<LiteralData>
			<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AllowedValues>
						<ows:AnyValue/>
					</ows:AllowedValues>
			</LiteralData>
		</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GUANY</ows:Identifier>
				<ows:Title>Pendent aplicat</ows:Title>
				<ows:Abstract>És el pendent aplicat per a una transformació lineal dels DN abans de la correcció, però després de restar Kl (útil en imatges MSS processades per Eurimage).</ows:Abstract>
		<LiteralData>
			<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integrer">integrer</ows:DataType>
					<ows:AllowedValues>
						<ows:AnyValue/>
					</ows:AllowedValues>
			</LiteralData>
		</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ILLUM_ORI</ows:Identifier>
				<ows:Title>Model digital d'il·luminacions</ows:Title>
				<ows:Abstract>Model digital d'il·luminacions prèviament generat amb els mateixos paràmetres de posició solar.</ows:Abstract>
		<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
		</ComplexData>
		</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OMBRA_ORI</ows:Identifier>
				<ows:Title>Model digital d'ombres</ows:Title>
				<ows:Abstract>Model digital d'ombres prèviament generat amb els mateixos paràmetres de posició solar.</ows:Abstract>
		<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
		</ComplexData>
		</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ILLUM_DEST</ows:Identifier>
				<ows:Title>Nom MDE I-luminacions generat</ows:Title>
				<ows:Abstract>Nom on es desarà el model digital d'il·luminacions generat. Si no s'indica es generarà en un directori temporal i serà esborrat en acabar. </ows:Abstract>
			<LiteralData>
			<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integrer">integrer</ows:DataType>
					<ows:AllowedValues>
						<ows:AnyValue/>
					</ows:AllowedValues>
			</LiteralData>
		</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OMBRA_DEST</ows:Identifier>
				<ows:Title>Nom MDE ombres generat</ows:Title>
				<ows:Abstract>Nom on es desarà el model digital d'ombres generat. Si no s'indica es generarà en un directori temporal i serà esborrat en acabar.</ows:Abstract>
			<LiteralData>
			<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integrer">integrer</ows:DataType>
					<ows:AllowedValues>
						<ows:AnyValue/>
					</ows:AllowedValues>
			</LiteralData>
		</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REF_SUP_100</ows:Identifier>
				<ows:Title>Reflectancies superios a 100%</ows:Title>
				<ows:Abstract>paràmetre que s'indica pel cas singular en què es permet sobrepassar el 100% de reflectàncies, i per tant es vol evitar marcar aquest cas com a NODATA (valor de fons).</ows:Abstract>
	<LiteralData>
					<ows:AllowedValues>
							<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:Value>##blank##</ows:Value></ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
		</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>INCID_SUP_90</ows:Identifier>
				<ows:Title>Angles incidència  superiors a 90%</ows:Title>
				<ows:Abstract>Paràmetre que s'indica pel cas singular en què es permet sobrepassar angles d'incidència superiors a 90° i que és equivalent a definir un teòric angle lambertià de 180°. Si no s'indica, els píxels amb angles d'incidència >90° queden marcats com a NODATA.</ows:Abstract>
	<LiteralData>
					<ows:AllowedValues>
							<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:Value>##blank##</ows:Value></ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
		</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CALC_A_L_OMBRA</ows:Identifier>
				<ows:Title>reflectàncies calculades a les zones sense radiació directa</ows:Title>
				<ows:Abstract>S'usa quan es desitja obtenir reflectàncies calculades a les zones sense radiació directa, en comptes que quedin marcades com a NODATA.</ows:Abstract>
		<LiteralData>
					<ows:AllowedValues>
							<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:Value>##blank##</ows:Value></ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
		</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ESCALAT</ows:Identifier>
				<ows:Title>reflectàncies calculades a les zones sense radiació directa</ows:Title>
				<ows:Abstract>S'usa quan es desitja obtenir reflectàncies calculades a les zones sense radiació directa, en comptes que quedin marcades com a NODATA.</ows:Abstract>
		<LiteralData>
			<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AllowedValues>
						<ows:AnyValue/>
					</ows:AllowedValues>
			</LiteralData>
		</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>LIMIT</ows:Identifier>
				<ows:Title>Límit de saturació</ows:Title>
				<ows:Abstract> És el límit de saturació per a evitar valors excessivament fora de rang [0,100] en casos singulars quan el format de sortida és real. El rang de sortida serà llavors [-limit, +limit] on limit>=100. </ows:Abstract>
		<LiteralData>
			<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AllowedValues>
						<ows:AnyValue/>
					</ows:AllowedValues>
			</LiteralData>
		</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CANAL</ows:Identifier>
				<ows:Title>Canal del sensor</ows:Title>
				<ows:Abstract>Canal del sensor. S'indica quan no està documentat a la radiometria de les metadades.</ows:Abstract>
		<LiteralData>
			<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AllowedValues>
						<ows:AnyValue/>
					</ows:AllowedValues>
			</LiteralData>
		</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CALIB_SCALE</ows:Identifier>
				<ows:Title> Pendent de la recta de calibració</ows:Title>
				<ows:Abstract>Pendent de la recta de calibració per transformar DN a radiàncies. S'indica quan la radiometria no està documentada a les metadades.</ows:Abstract>
		<LiteralData>
			<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integrer">integrer</ows:DataType>
					<ows:AllowedValues>
						<ows:AnyValue/>
					</ows:AllowedValues>
			</LiteralData>
		</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CALIB_OFFSET</ows:Identifier>
				<ows:Title>Ordenada en l'origen de la recta de calibració</ows:Title>
				<ows:Abstract>Ordenada en l'origen de la recta de calibració per transformar DN a radiàncies. S'indica quan la radiometria no està documentada a les metadades.</ows:Abstract>
		<LiteralData>
					<ows:AllowedValues>
							<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:Value>##blank##</ows:Value></ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
		</Input>
	</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Resultat</ows:Identifier>
				<ows:Title>Fitxer resultat</ows:Title>
				<ows:Abstract>Es el fitxer resultat de la correcció radiomètrica. 
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
						<ComplexOutput>							
							<Default>
								<Format>
								<MimeType>application/x-bmp</MimeType>
								<Encoding>Binary</Encoding>
								</Format>
							</Default>
								<Supported>
								<Format>
								<MimeType>application/x-bmp</MimeType>
								<Encoding>Binary</Encoding>
								</Format>
							</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CorRad:Param1:8</ows:Identifier>
