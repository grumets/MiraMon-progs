<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GenCost:1</ows:Identifier>
		<ows:Title>GenCost</ows:Title>
		<ows:Abstract>Este módulo crea un raster de costes a partir de un modelo de fricciones (resistencia al paso) y de un raster de entidades diana a las que se pretende llegar.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Análisis de mínimo coste de desplazamiento sobre un modelo de fricción"/>
		<ows:Metadata xlink:title="Abstract:Este módulo crea un raster de costes a partir de un modelo de fricciones (resistencia al paso) y de un raster de entidades diana a las que se pretende llegar."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>1. Aplicación del modelo de análisis de tipo celda.</li><li>2: Aplicación del modelo de análisis de tipo nodo.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDianes</ows:Identifier>
				<ows:Title>Fichero Dianas</ows:Title>
				<ows:Abstract>Fichero raster con la posición de las celdas diana.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroDianas"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerFriccions</ows:Identifier>
				<ows:Title>Fichero Fricción</ows:Title>
				<ows:Abstract>Fichero raster con los valores de fricción de cada celda.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroFricción"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>OpcióDiana</ows:Identifier>
				<ows:Title>Opción diana</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>0: Cálculo de los costes hasta el extremo de la diana.</li><li>1: Cálculo de los costes hasta el centro de la diana.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:OpciónDiana"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerCostos</ows:Identifier>
				<ows:Title>Fichero Costes</ows:Title>
				<ows:Abstract>Fichero raster de salida con el valor de coste de cada celda.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FicheroCostes"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>