<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:visio3d:1</ows:Identifier>
		<ows:Title>Visio3d</ows:Title>
		<ows:Abstract>Este módulo permite generar una perspectiva 3D a partir del modelo digital de elevaciones de cualquier imagen: temática, ortofotografía o cualquier modelo continuo como el propio MDE. Existen dos modos de ejecución: Previsualización y Definitiva. El modo de previsualización es más rápido que el definitivo y se recomienda para buscar los parámetros geométricos más próximos a la representación que se desea conseguir. Con la elección de este modo, no es posible activar la opción de sombreado. El modo definitivo es más lento pero genera una representación tridimensional de mayor calidad.</ows:Abstract>
<ows:Metadata xlink:title="Title:Generación de perspectivas 3D a partir de un mapa ráster y su MDE."/>
<ows:Metadata xlink:title="Abstract:Este módulo permite generar una perspectiva 3D a partir del modelo digital de elevaciones de cualquier imagen: temática, ortofotografía o cualquier modelo continuo como el propio MDE. Existen dos modos de ejecución: Previsualización y Definitiva. El modo de previsualización es más rápido que el definitivo y se recomienda para buscar los parámetros geométricos más próximos a la representación que se desea conseguir. Con la elección de este modo, no es posible activar la opción de sombreado. El modo definitivo es más lento pero genera una representación tridimensional de mayor calidad." />
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcion</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract><![CDATA[<li>1. Para hacer una previsualización del resultado.</li><li>2. Para la versión definitiva.</li>]]></ows:Abstract>
						<ows:Metadata xlink:title="Param1" />
					<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer "> integer</ows:DataType>
						<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						</ows:AllowedValues>
					</LiteralData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FicheroMDE</ows:Identifier>
				<ows:Title>Fichero MDE</ows:Title>
				<ows:Abstract>Fichero que contiene el Modelo Digital del Terreno en formato .IMG</ows:Abstract>
				<ows:Metadata xlink:title="Param2" />
				<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Text</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Text</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FicheroRaster</ows:Identifier>
				<ows:Title>Fichero Raster</ows:Title>
				<ows:Abstract>Fichero que contiene la información temática en formato raster .IMG o .JPG</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
				<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Text</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Text</Encoding>
							</Format>
								<Format>
								<MimeType>application/x-JPG</MimeType>
								<Encoding>Text</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>AzimPuntoVista</ows:Identifier>
				<ows:Title>Azimut Punto Vista</ows:Title>
				<ows:Abstract>Azimut del punto de vista en grados.</ows:Abstract>
				<ows:Metadata xlink:title="Param5" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ElevPuntoVista</ows:Identifier>
				<ows:Title>Elevación Punto Vista</ows:Title>
				<ows:Abstract>Ángulo de elevación del punto de vista en grados.</ows:Abstract>
<ows:Metadata xlink:title="Param6" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ExagVert</ows:Identifier>
				<ows:Title>Exageración vertical</ows:Title>
				<ows:Abstract>Es el factor de escala del eje vertical. Cuando el valor es 1, no hay exageración vertical.</ows:Abstract>
<ows:Metadata xlink:title="Param7" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>AzimSolar</ows:Identifier>
				<ows:Title>Azimut Solar</ows:Title>
				<ows:Abstract>Azimut de la posición solar en grados. Este valor es necesario en el caso de que se quiera añadir sombreado.</ows:Abstract>
<ows:Metadata xlink:title="Param8" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ElevSolar</ows:Identifier>
				<ows:Title>Elevación Solar</ows:Title>
				<ows:Abstract>Ángulo de elevación de la posición solar en grados. Este valor es necesario en el caso de que se quiera añadir sombreado.</ows:Abstract>
<ows:Metadata xlink:title="Param9" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>IncremIllum</ows:Identifier>
				<ows:Title>Incremento Iluminación</ows:Title>
				<ows:Abstract>Corresponde al nivel constante de iluminación con que se incrementa toda la imagen para contrarrestar globalmente la disminución variable de iluminación debida a la aplicación del modelo de sombras y el modelo de iluminaciones. Un valor genérico recomendado es el 33%, pero habrá ajustarlo según el caso. Este valor es necesario en el caso de que se quiera añadir sombreado.</ows:Abstract>
<ows:Metadata xlink:title="Param10" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>		
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MinimIllum</ows:Identifier>
				<ows:Title>Mínima Iluminación</ows:Title>
				<ows:Abstract>Porcentaje mínimo que puede llegar a quedar oscurecido un color en el espacio HSI. Los valores inferiores se saturarán. Si se permite un porcentaje excesivamente bajo, los colores oscurecidos no se diferenciarán. Un valor genérico recomendado es el 5%, pero habrá ajustarlo según el caso. Este valor es necesario en el caso de que se quiera añadir sombreado.</ows:Abstract>
<ows:Metadata xlink:title="Param11" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>		
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MaximIllum</ows:Identifier>
				<ows:Title>Màxima Iluminación</ows:Title>
				<ows:Abstract>Porcentaje máximo que puede llegar a quedar oscurecido un color en el espacio HSI. Los valores superiores se saturarán. Si se permite un porcentaje excesivamente alto, los colores muy claros no se diferenciarán. Un valor genérico recomendado es el 95%, pero habrá ajustarlo según el caso. Este valor es necesario en el caso de que se quiera añadir sombreado.
Sombra: Para añadir un sombreado al resultado final.</ows:Abstract>
<ows:Metadata xlink:title="Param12" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
				<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Sombra</ows:Identifier>
				<ows:Title>Sombra</ows:Title>
				<ows:Abstract>Para añadir un sombreado al resultado final.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues><ows:Value>##blank##</ows:Value></ows:AllowedValues>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Paleta</ows:Identifier>
				<ows:Title>Paleta</ows:Title>
				<ows:Abstract>Fitxer que conté una paleta de colors. Aquest paràmetre és obligatori en el cas d'introduir un fitxer ràster en format .IMG i un fitxer de sortida en format .JPG.</ows:Abstract>
			<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-PAL</MimeType>
								<Encoding>Text</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-PAL</MimeType>
								<Encoding>Text</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>			
			</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FicheroSalida</ows:Identifier>
				<ows:Title>Fichero Salida</ows:Title>
				<ows:Abstract> Fichero que contiene la perspectiva 3D de la información temática respecto al MDE de entrada. Este archivo puede ser un formato .IMG o .JPG.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param4" />
						<ComplexOutput>
							<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
							<Format>
							<MimeType>application/x-JPG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
							</Supported>
						</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	</wps:ProcessDescriptions>
