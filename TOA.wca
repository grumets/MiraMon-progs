<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 ../wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-CA">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TOA</ows:Identifier>
		<ows:Title>TOA: Reflectivitat Aparent TOA</ows:Title>
		<ows:Abstract></ows:Abstract>
	<ows:Metadata xlink:title="Title:Reflectivitat Aparent TOA." />
<ows:Metadata xlink:title="Abstract:Aquesta aplicació permet calcular la reflectivitat aparent TOA (Top Of Atmosphere) en imatges de Teledetecció captades en la regió espectral visible i la temperatura aparent de brillantor en imatges de lespectre tèrmic." />
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Input</ows:Identifier>
				<ows:Title>Imatge a corregir</ows:Title>
				<ows:Abstract>Imatge a corregir (pot formar part d'un ràster multibanda).</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<ComplexData>
					<Default>
						<Format>
						<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Unitats</ows:Identifier>
				<ows:Title>Unitats del tèrmic</ows:Title>
				<ows:Abstract>Unitats en les que s'expressa la temperatura per les imatges de l'espectre infraroig tèrmic</ows:Abstract>
			<ows:Metadata xlink:title="Param3" />
			<LiteralData>
          <ows:AllowedValues>
            <ows:Value>KELVIN</ows:Value>
            <ows:Value>CELSIUS</ows:Value>            
          </ows:AllowedValues>
					<DefaultValue>KELVIN</DefaultValue>
				</LiteralData>
			</Input>
				<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerRAD</ows:Identifier>
				<ows:Title>Fitxer RAD</ows:Title>
				<ows:Abstract>Fitxer RAD que conté els paràmetres necessaris per la correcció S0, K1, K2; i opcionalment tau0</ows:Abstract>
				<ows:Metadata xlink:title="Param4" />
				<ComplexData>
					<Default>
						<Format>
						<MimeType>application/x-rad</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-rad</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
				<Input minOccurs="0" maxOccurs="1">
			<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>Multibanda</ows:Title>
				<ows:Abstract>Paràmetre opcional per a corregir en una sola execució del programa totes les bandes d'un ràster multibanda i generar com a resultat un ràster multibanda amb les corresponents bandes corregides.</ows:Abstract>
				<LiteralData>
					<ows:AllowedValues>blank</ows:AllowedValues>
					<DefaultValue>blank</DefaultValue>
				</LiteralData>
			</Input>
				<Input minOccurs="0" maxOccurs="1">
			<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefix</ows:Title>
				<ows:Abstract>Prefix que s'afegeix als noms dels fitxers originals per a determinar els noms dels fitxers corregits per al cas multibanda. Si no s'indica no s'afegeix cap prefix, excepte que les imatges d'entrada i de sortida estiguin al mateix directori, cas en el qual s'afegeix el prefix "t_".</ows:Abstract>
				<LiteralData>
					<ows:DataType>string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>"t_"</DefaultValue>
				</LiteralData>
			</Input>						
</DataInputs>
	<ProcessOutputs>	
		<Output>
		<!-- ·$· 'En aquest cas, pot ser un fitxer o un directori, com ho hauríem de posar?-->
				<ows:Identifier>Output</ows:Identifier>
				<ows:Title>Fitxer o directori de sortida</ows:Title>
				<ows:Abstract>Fitxer resultat de la correcció per execucions d'una sola banda, o bé el directori on s'escriuran els fitxers resultat per execucions de totes les bandes alhora (indicant el paràmetre /MULTIBANDA)</ows:Abstract>
				<ows:Metadata xlink:title="Param2" />
				<ComplexOutput>
					<Default>
						<Format>
						<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
