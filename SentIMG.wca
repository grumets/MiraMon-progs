<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 ../wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
<!-- Opció 0: Fitxer XML User Product-->
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SentIMG:!Param03</ows:Identifier>
		<ows:Title>SentIMG: Importació d'imatges Sentinel-2</ows:Title>
		<ows:Abstract>Importació d'un producte de dades Sentinel-2.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importació d'imatges Sentinel-2." />
		<ows:Metadata xlink:title="Abstract:Aquest mòdul permet importar imatges Sentinel-2 a IMG." />
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>De moment, solament pot valer 1.</ows:Abstract>
				<ows:Metadata xlink:title="Param01" />
				<ows:Metadata xlink:title="Name:Opcio" />
				<LiteralData>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>					
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerXMLUserProduct</ows:Identifier>
				<ows:Title>Fitxer XML User Product</ows:Title>
				<ows:Abstract><![CDATA[Fitxer XML de metadades del <i>User Product</i> del producte descomprimit de dades de Sentinel-2.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param02" />
				<ows:Metadata xlink:title="Name:FitxerXMLUserProduct" />
				<ComplexData>
					<Default>
						<Format>
						<MimeType>text/xml</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ImportQualMask</ows:Identifier>
				<ows:Title>Importar màscares de qualitat</ows:Title>
				<ows:Abstract>Importar les diferents màscares de qualitat en format GML que hi ha a cada tessel·la a format MiraMon.</ows:Abstract>
				<LiteralData>
					<ows:AllowedValues>##blank##</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>		
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CopyQualMask</ows:Identifier>
				<ows:Title>Copiar màscares de qualitat</ows:Title>
				<ows:Abstract>Copiar les diferents màscares de qualitat en format GML que hi ha a cada tessel·la.</ows:Abstract>
				<LiteralData>
					<ows:AllowedValues>##blank##</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>							
		</DataInputs>
		<ProcessOutputs>	
			<Output>
				<ows:Identifier>DirSortida</ows:Identifier>
				<ows:Title>Directori de sortida</ows:Title>
				<ows:Abstract>Directori de sortida on s'importaran totes les dades de cada tessel·la del producte de Sentinel-2.</ows:Abstract>
				<ows:Metadata xlink:title="Param04" />
				<ows:Metadata xlink:title="Name:DirSortida" />
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
<!-- Opció 1: Fitxers o llista de fitxers JP2 d'una tessel·la-->
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SentIMG:!Param02</ows:Identifier>
		<ows:Title>SentIMG: Importació d'imatges Sentinel-2</ows:Title>
		<ows:Abstract>Importació d'una llista d'imatges Sentinel-2 d'una mateixa tessel·la.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importació d'imatges Sentinel-2." />
		<ows:Metadata xlink:title="Abstract:Aquest mòdul permet importar una llista d'imatges Sentinel-2 d'una mateixa tessel·la a format MiraMon." />
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>De moment, solament pot valer 1.</ows:Abstract>
				<ows:Metadata xlink:title="Param01" />
				<ows:Metadata xlink:title="Name:Opcio" />
				<LiteralData>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>					
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>LlistaFitxersJP2</ows:Identifier>
				<ows:Title>Llista de fitxers JP2 d'una mateixa tessel·la.</ows:Title>
				<ows:Abstract>Llista de fitxers JP2 d'una mateixa tessel·la d'un producte de Sentinel-2.</ows:Abstract>
				<ows:Metadata xlink:title="Param03" />
				<ows:Metadata xlink:title="Name:LlistaFitxersJP2" />
				<ComplexData>
					<Default>
						<Format>
						<MimeType>text/txt</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/txt</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>		
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FitxerXMLUserProduct</ows:Identifier>
				<ows:Title>Fitxer XML User Product</ows:Title>
				<ows:Abstract><![CDATA[Fitxer XML de metadades del <i>User Product</i> del producte descomprimit de dades de Sentinel-2.]]></ows:Abstract>				
				<ComplexData>
					<Default>
						<Format>
						<MimeType>text/xml</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FitxerXMLGranule</ows:Identifier>
				<ows:Title>Fitxer XML de la tessel·la</ows:Title>
				<ows:Abstract>Fitxer XML de metadades de la tessel·la corresponent al llistat de les imatges d'entrada.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
						<MimeType>text/xml</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/xml</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>					
		</DataInputs>
		<ProcessOutputs>	
			<Output>
				<ows:Identifier>DirSalida</ows:Identifier>
				<ows:Title>Directori de sortida</ows:Title>
				<ows:Abstract>Directori de sortida on s'importaran totes les imatges de la llista a format MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param04" />
				<ows:Metadata xlink:title="Name:DirSortida" />
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>		
	</ProcessDescription>
</wps:ProcessDescriptions>
