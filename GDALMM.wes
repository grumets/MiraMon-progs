<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GDALMM:0</ows:Identifier>
		<ows:Title>Información</ows:Title>
		<ows:Abstract>Proporciona información sobre el fichero en un formato importable mediante OGR/GDAL.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importación de ficheros via GDAL"/>
		<ows:Metadata xlink:title="Abstract:Importa archivos vectoriales o ráster en cualquier formato compatible con GDAL al formato MiraMon. El usuario tiene la opción de seleccionar si desea importar solo algunas capas específicas o todas las capas contenidas en el archivo. Se puede definir un directorio de salida o, en el caso de que el archivo contenga una única capa de un solo tipo, se puede especificar un nombre de archivo de salida con la extensión correspondiente: pnt, arc, pol o img."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Proporciona información sobre un archivo mediante GDAL.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerEntrada</ows:Identifier>
				<ows:Title>Fichero OGR/GDAL a importar</ows:Title>
				<ows:Abstract>Fichero a importar usando las librerías OGR/GDAL.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroEntrada"/>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GDALMM:1</ows:Identifier>
		<ows:Title>Importación de un fichero usando librerias OGR/GDAL</ows:Title>
		<ows:Abstract>Importa un subconjunto de capas de un archivo compatible con librerias OGR/GDAL.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Importa un archivo al MiraMon mediante GDAL.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerEntrada</ows:Identifier>
				<ows:Title>Fichero OGR/GDAL a importar</ows:Title>
				<ows:Abstract>Fichero a importar usando las librerías OGR/GDAL.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroEntrada"/>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FitxLListaCapes</ows:Identifier>
				<ows:Title>Fichero de lista de capas</ows:Title>
				<ows:Abstract>Fichero que contiene una lista de capas (en caso de un fichero vectorial) o de subdataset (en caso de un fichero ráster) que se quiere importar. En caso que no se indique este fichero, se importará todas las capas o subdatasets que se encuentren en el fichero origen.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FichListaCapas"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>DirectoriSortida</ows:Identifier>
				<ows:Title>Directorio o fichero de salida</ows:Title>
				<ows:Abstract>Fichero de salida (en caso de que se encuentre una capa) o directorio de salida (en caso de que se encuentre más de una capa o subdatasets) donde se guardarán los ficheros importados a formato MiraMon a partir del fichero origen usando las librerías OGR/GDAL.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:DirOFichSalida"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>