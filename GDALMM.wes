<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GDALMM:0</ows:Identifier>
		<ows:Title>Información</ows:Title>
		<ows:Abstract>Proporciona información sobre el fichero en un formato importable mediante GDAL/OGR.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importación de ficheros con librerías GDAL/OGR"/>
		<ows:Metadata xlink:title="Abstract:Importa archivos vectoriales o ráster en cualquier formato compatible con GDAL/OGR al formato MiraMon. El usuario tiene la opción de seleccionar si desea importar solo algunas capas específicas o todas las capas contenidas en el archivo. Se puede definir un directorio de salida o, en el caso de que el archivo contenga una única capa de un solo tipo, se puede especificar un nombre de archivo de salida con la extensión correspondiente: pnt, arc, pol o img."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Proporciona información sobre un archivo mediante GDAL/OGR.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerEntrada</ows:Identifier>
				<ows:Title>Fichero GDAL/OGR a importar</ows:Title>
				<ows:Abstract>Fichero a importar usando las librerías GDAL/OGR.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroEntrada"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GDALMM:1</ows:Identifier>
		<ows:Title>Importación de un fichero usando librerías GDAL/OGR</ows:Title>
		<ows:Abstract>Importa el fichero, o un subconjunto de los elementos que contiene, con librerías GDAL/OGR.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Importa un archivo al MiraMon mediante GDAL/OGR.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerEntrada</ows:Identifier>
				<ows:Title>Fichero GDAL/OGR a importar</ows:Title>
				<ows:Abstract>Fichero a importar usando las librerías GDAL/OGR.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroEntrada"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FitxLListaCapes</ows:Identifier>
				<ows:Title>Fichero de lista de capas</ows:Title>
				<ows:Abstract><![CDATA[Fichero de texto que contiene una lista de capas, bandas, subconjuntos de información ráster (<i>subdatasets</i>) y/o tablas a importar. En caso de que no se indique este fichero, se importará toda la información que se encuentre en el fichero de origen.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FichListaCapas"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TIPUS_SORTIDA</ows:Identifier>
				<ows:Title>Tipo de salida</ows:Title>
				<ows:Abstract>Permite determinar si la salida es un directorio (D) o un fichero (F). Por defecto será siempre un directorio. Use la opción F únicamente cuando desee importar solo una capa vectorial o un conjunto de información ráster y el resultado de dicha importación sea una sola capa en formato MiraMon.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>F</ows:Value>
						<ows:Value>D</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>D</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>AJUSTA_AMPLADA_CAMPS</ows:Identifier>
				<ows:Title>Ajusta el ancho de los campos</ows:Title>
				<ows:Abstract>Permite efectuar un ajuste del ancho de los campos, tanto numéricos como de texto, al mínimo necesario. En el caso de los campos numéricos, el nuevo número de decimales se elige para preservar el valor más alto que garantice la presencia de dígitos distintos de cero.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#boolean">boolean</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>FALSE</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>DirectoriSortida</ows:Identifier>
				<ows:Title>Directorio o fichero de salida</ows:Title>
				<ows:Abstract>Directorio o fichero de salida (según se especifique a través de /TIPUS_SORTIDA=) donde se guardarán los ficheros importados al formato MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:DirOFichSalida"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>