<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GDALMM:0</ows:Identifier>
		<ows:Title>Información</ows:Title>
		<ows:Abstract>Proporciona información sobre el fichero en un formato importable mediante GDAL.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importación de ficheros via GDAL"/>
		<ows:Metadata xlink:title="Abstract:Importa archivos vectoriales o ráster en cualquier formato compatible con GDAL al formato MiraMon. El usuario tiene la opción de seleccionar si desea importar solo algunas capas específicas o todas las capas contenidas en el archivo. Se puede definir un directorio de salida o, en el caso de que el archivo contenga una única capa de un solo tipo, se puede especificar un nombre de archivo de salida con la extensión correspondiente: pnt, arc, pol o img."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>opcio</ows:Identifier>
				<ows:Title>0</ows:Title>
				<ows:Abstract>Proporciona información sobre un archivo mediante GDAL.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:0"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerEntrada</ows:Identifier>
				<ows:Title>Fichero en un formato que GDAL pueda importar.</ows:Title>
				<ows:Abstract>Fichero en un formato que GDAL pueda importar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroEntrada"/>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GDALMM:1:fitxer</ows:Identifier>
		<ows:Title>Importación a fichero</ows:Title>
		<ows:Abstract>Importa un fitxer via GDAL sempre i quan el fitxer d'entrada contingui només una sola capa d'un sol tipus.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>opcio</ows:Identifier>
				<ows:Title>1</ows:Title>
				<ows:Abstract>Importa un archivo al MiraMon mediante GDAL.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:1"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerEntrada</ows:Identifier>
				<ows:Title>Fichero en un formato que GDAL pueda importar.</ows:Title>
				<ows:Abstract>Fichero en un formato que GDAL pueda importar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroEntrada"/>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerSortida</ows:Identifier>
				<ows:Title>Fichero en formato MiraMon</ows:Title>
				<ows:Abstract>Fichero en formato MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroSalida"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GDALMM:1:directori</ows:Identifier>
		<ows:Title>Importació a directori</ows:Title>
		<ows:Abstract>Importació a directori</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>opcio</ows:Identifier>
				<ows:Title>1</ows:Title>
				<ows:Abstract>Importa un archivo al MiraMon mediante GDAL.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:1"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerEntrada</ows:Identifier>
				<ows:Title>Fichero en un formato que GDAL pueda importar.</ows:Title>
				<ows:Abstract>Fichero en un formato que GDAL pueda importar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroEntrada"/>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DirectoriSortida</ows:Identifier>
				<ows:Title>Directorio de salida</ows:Title>
				<ows:Abstract>Directorio de salida</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:DirectorioSalida"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>