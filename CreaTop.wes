<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CREATOP:Param1:T</ows:Identifier>
		<ows:Title>Creatop Puntos</ows:Title>
		<ows:Abstract>Estructuración topológica de un fichero de Puntos.</ows:Abstract>
<ows:Metadata xlink:title="Title:Estructuración topológica simplificada" />
<ows:Metadata xlink:title="Abstract:Este programa integra y facilita el uso de los programas de estructuración topológica VECPNT, LINARC, CICLAR, ATRIPOL y TESTTOP. Hay que ser consciente de sus limitaciones."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>T</ows:Identifier>
				<ows:Title>Puntos</ows:Title>
				<ows:Abstract>Indica fichero de puntos</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
		<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
						<ows:Value>T</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NombreFicheroVEC</ows:Identifier>
				<ows:Title>Nombre Fichero Vectorial</ows:Title>
				<ows:Abstract>Fichero VEC o PNT a convertir
				</ows:Abstract>
<ows:Metadata xlink:title="Param2" />
		<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
		</ComplexData>
		</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Tolerancia</ows:Identifier>
				<ows:Title>Tolerancia</ows:Title>
				<ows:Abstract>Valor de la tolerancia. Si no se indica se asume una tolerancia igual a 0.001.</ows:Abstract>
		<LiteralData>
			<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integrer">integrer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0.001</DefaultValue>
				</LiteralData>
			</Input>
	</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NombreFicheroVEC</ows:Identifier>
				<ows:Title>Nombre Fichero VECTORIAL</ows:Title>
				<ows:Abstract>Fichero VEC o PNT  convertido.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param2" />
						<ComplexOutput>
						<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CREATOP:Param1:A</ows:Identifier>
		<ows:Title>Creatop Arcos</ows:Title>
		<ows:Abstract>Estructuración topológica de un fichero de Arcos.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>A</ows:Identifier>
				<ows:Title>Arc</ows:Title>
				<ows:Abstract>Indica fichero de Arcos.</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
		<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
						<ows:Value>A</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NombreFicheroVEC</ows:Identifier>
				<ows:Title>Nombre Fichero Vectorial</ows:Title>
				<ows:Abstract>Fichero VEC o ARC a convertir.
				</ows:Abstract>
<ows:Metadata xlink:title="Param2" />
		<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
		</ComplexData>
		</Input>
		<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Tolerancia</ows:Identifier>
				<ows:Title>Tolerancia</ows:Title>
				<ows:Abstract>Valor de la tolerancia. Si no se indica se asume una tolerancia igual a 0.001.</ows:Abstract>
		<LiteralData>
			<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integrer">integrer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0.001</DefaultValue>
				</LiteralData>
			</Input>
	</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NombreFicheroVEC</ows:Identifier>
				<ows:Title>Nombre Fichero Vectorial</ows:Title>
				<ows:Abstract>Fichero VEC o ARC a convertido
				</ows:Abstract>
				<ows:Metadata xlink:title="Param2" />
						<ComplexOutput>
						<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-nod</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>	
<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CREATOP:Param1:P</ows:Identifier>
		<ows:Title>Creatop Polígonos</ows:Title>
		<ows:Abstract>Estructuración topológica de un fichero de Polígonos.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>P</ows:Identifier>
				<ows:Title>Poligonos</ows:Title>
				<ows:Abstract>Indica si queremos un fichero de polígonos</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
		<LiteralData>
					<ows:AllowedValues>
								<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
						<ows:Value>P</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>x</ows:Identifier>
				<ows:Title>Tipo de estructuración</ows:Title>
				<ows:Abstract>Si no se indica se realiza la estructuración a partir del fichero de líneas. Si se indica 1 se supone la existencia de un fichero de arcos válido y se utiliza como punto de partida para construir polígonos. Si se indica 2 se asume que el fichero de polígonos es válido y sólo se reetiquetan los polígonos.</ows:Abstract>
					<LiteralData>
					<ows:AllowedValues>
								<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integrer">integrer</ows:DataType>
					<ows:Value>1</ows:Value>
					<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>			
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NombreFicheroVEC</ows:Identifier>
				<ows:Title>Nombre Fichero Vectorial</ows:Title>
				<ows:Abstract>Fichero VEC o POL a convertir
				</ows:Abstract>
<ows:Metadata xlink:title="Param2" />
		<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
		</ComplexData>
		</Input>
		<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NombreFicheroEtiqueta</ows:Identifier>
				<ows:Title>Nombre Fichero Etiqueta</ows:Title>
				<ows:Abstract>Fichero VEC o PNT de etiquetas (puntos) de polígonos. 
				</ows:Abstract>
<ows:Metadata xlink:title="Param3" />
		<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
		</ComplexData>
		</Input>
		<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Tolerancia</ows:Identifier>
				<ows:Title>Tolerancia</ows:Title>
				<ows:Abstract>Valor de la tolerancia. Si no se indica se asume una tolerancia igual a 0.001.</ows:Abstract>
		<LiteralData>
			<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integrer">integrer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0.001</DefaultValue>
				</LiteralData>
			</Input>
	</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NombreFicheroVEC</ows:Identifier>
				<ows:Title>Nombre Fichero Vectorial</ows:Title>
				<ows:Abstract>Fichero VEC o POL a convertido.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param2" />
						<ComplexOutput>
						<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>		
</wps:ProcessDescriptions>
