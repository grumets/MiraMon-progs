<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:gms_g:Param1:1</ows:Identifier>
		<ows:Title>Origen en graus decimals i resultat en graus sexagesimals</ows:Title>
		<ows:Abstract>Origen en graus decimals i resultat en graus sexagesimals.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversions entre unitats angulars i horàries"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació permet fer conversions entre magnituds angulars:&lt;ul&gt;&lt;li&gt;de graus sexagesimals (graus, minuts i segons, p. ex.: 15° 30&apos; 36.72&quot;) a graus decimals  (graus i fraccions decimals de grau, p.ex.: 15.51020000°) i viceversa&lt;/li&gt;&lt;li&gt;de graus sexagesimals o graus decimals a radians (p. ex.: 0.2707040576 rad) i viceversa&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;així com entre magnituds horàries:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;d&apos;hores i fraccions decimals d&apos;hores a hores, minuts i segons i viceversa (útil per a convertir, per exemple, hores de pas de satèl·lits).&lt;/li&gt;&lt;/ul&gt;"/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Tipus de conversió</ows:Title>
				<ows:Abstract>Origen en graus decimals i resultat en graus sexagesimals</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>AngleAConvertir</ows:Identifier>
				<ows:Title>Angle a convertir</ows:Title>
				<ows:Abstract>És el valor de l'angle a convertir en les unitats especificades segons l'opció TipusConversio.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:AngleAConvertir"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>StdOut</ows:Identifier>
				<ows:Title>Resultat de la conversió</ows:Title>
				<ows:Abstract>Resultat de la conversió</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
