<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ESTRAS:1</ows:Identifier>
		<ows:Title>Dades estadístiques d'un ràster.</ows:Title>
		<ows:Abstract>Aquesta opció calcula dades estadístiques d'un sol ràster (monobanda o multibanda).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Estadístiques d'un ràster o d'una sèrie de ràsters"/>
		<ows:Metadata xlink:title="Abstract:Aquest mòdul realitza càlculs estadístics d'un ràster, d'una sèrie de ràsters o la normalització d'un raster."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Dades estadístiques d'un ràster.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerIMG</ows:Identifier>
				<ows:Title>Fitxer IMG</ows:Title>
				<ows:Abstract>Fitxer ràster a usar pel càlcul d'estadístiques.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerIMG"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Tractament</ows:Identifier>
				<ows:Title>Tractament de les dades origen</ows:Title>
				<ows:Abstract>Indica el tractament de les dades del ràster origen:<![CDATA[<ul>
          <li>C: Categòric.</li>
          <li>N: Quantitatiu.</li>
          <li>M: Segons metadades.</li>
          </ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Tractament"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>C</ows:Value>
						<ows:Value>N</ows:Value>
						<ows:Value>M</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>M</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_VAL</ows:Identifier>
				<ows:Title>Nombre de valors</ows:Title>
				<ows:Abstract>Per calcular el nombre de píxels del ràster origen (sense comptar els píxels amb valor sensedades en el cas que n'hi hagi).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MIN</ows:Identifier>
				<ows:Title>Mínim valor</ows:Title>
				<ows:Abstract>Per calcular el valor mínim del ràster origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MAX</ows:Identifier>
				<ows:Title>Màxim valor</ows:Title>
				<ows:Abstract>Per calcular el valor màxim del ràster origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MITJANA</ows:Identifier>
				<ows:Title>Mitjana</ows:Title>
				<ows:Abstract>Per calcular la mitjana del ràster origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESV_STD</ows:Identifier>
				<ows:Title>Desviació estàndard</ows:Title>
				<ows:Abstract>Per calcular la desviació estàndard del ràster origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MEDIANA</ows:Identifier>
				<ows:Title>Mediana</ows:Title>
				<ows:Abstract>Per calcular la mediana del ràster origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESV_MEDIANA</ows:Identifier>
				<ows:Title>Mitjana de la desviació absoluta respecte la mediana</ows:Title>
				<ows:Abstract>Per calcular la mitjana de la desviació absoluta respecte la mediana del ràster origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MODA</ows:Identifier>
				<ows:Title>Moda</ows:Title>
				<ows:Abstract>Per calcular la moda del ràster origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>I_SHAN</ows:Identifier>
				<ows:Title>Índex de Shannon</ows:Title>
				<ows:Abstract>Per calcular l'índex de Shannon del ràster origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>1Q</ows:Identifier>
				<ows:Title>Primer quartil</ows:Title>
				<ows:Abstract>Per calcular el primer quartil del ràster origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>3Q</ows:Identifier>
				<ows:Title>Tercer quartil</ows:Title>
				<ows:Abstract>Per calcular el tercer quartil del ràster origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PERCENTIL</ows:Identifier>
				<ows:Title>Percentil</ows:Title>
				<ows:Abstract>Per calcular el percentil escollit per l'usuari del ràster origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>100</ows:MaximumValue>
						</ows:Range>
						<ows:Value/>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>Multibanda</ows:Title>
				<ows:Abstract>Paràmetre opcional per si es vol utilitzar totes les bandes del fitxer d'entrada.</ows:Abstract>
				<LiteralData>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MEDIANA_EMPAT</ows:Identifier>
				<ows:Title>Desempat per a la mediana</ows:Title>
				<ows:Abstract>En el cas que s'hagi indicat el càlcul de la Mediana o de la Mitjana de la desviació absoluta respecte la mediana, indica quin desempat usar per a la mediana, en cas de tenir un nombre parell de valors:<![CDATA[<ul>
          <li>1: Valor alternat.</li>
          <li>2: Valor inferior.</li>
          <li>3: Valor superior.</li>
          <li>4: Mitjana dels valors centrals.</li>          
          </ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerINI</ows:Identifier>
				<ows:Title>Fitxer INI</ows:Title>
				<ows:Abstract>Fitxer INI amb el resultat de les dades estadístiques calculades.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerINI"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-ini</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-ini</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ESTRAS:2</ows:Identifier>
		<ows:Title>Imatge de les estadístiques d'una sèrie de ràsters</ows:Title>
		<ows:Abstract>Aquesta opció genera una imatge amb el resultat de la funció estadística escollida a partir d'una sèrie de ràsters.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Imatge de les estadístiques d'una sèrie de ràsters.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FEstadistica</ows:Identifier>
				<ows:Title>Funció estadística</ows:Title>
				<ows:Abstract>Funció estadística a calcular per a cada píxel d'una sèrie de ràsters:<![CDATA[<ul>
          <li>1: Mínim.</li>
          <li>2: Màxim.</li>
          <li>3: Mitjana.</li>
          <li>4: Desviació estàndard.</li>      
          <li>5: Mediana.</li>
          <li>6: Moda.</li>
          <li>7: Índex de Shannon.</li>
          <li>8: Mitjana de la desviació absoluta respecte la mediana.</li>      
          <li>10: Primer quartil.</li>
          <li>12: Tercer quartil.</li>      
          <li>14: Percentil.</li>
          <li>15: Recta de regressió.</li>
          </ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FuncióEstadística"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>6</ows:Value>
						<ows:Value>7</ows:Value>
						<ows:Value>8</ows:Value>
						<ows:Value>10</ows:Value>
						<ows:Value>12</ows:Value>
						<ows:Value>14</ows:Value>
						<ows:Value>15</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>LlistaIMG</ows:Identifier>
				<ows:Title>Llista IMG</ows:Title>
				<ows:Abstract>Fitxer TXT amb la lista de fitxers que es volen usar pel càlcul de la imatge de la funció estadística escollida.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:LlistaIMG"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MEDIANA_EMPAT</ows:Identifier>
				<ows:Title>Desempat per a la mediana</ows:Title>
				<ows:Abstract>En el cas que s'hagi indicat el càlcul de la Mediana o de la Mitjana de la desviació absoluta respecte la mediana, indica quin desempat usar per a la mediana, en cas de tenir un nombre parell de valors:<![CDATA[<ul>
          <li>1: Valor alternat.</li>
          <li>2: Valor superior.</li>
          <li>3: Valor inferior.</li>
          <li>4: Mitjana dels valors centrals.</li>          
          </ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Percentil</ows:Identifier>
				<ows:Title>Percentil</ows:Title>
				<ows:Abstract>En el cas d'escollir la funció estadística Percentil, indica quin percentil es vol calcular.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Percentil"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>100</ows:MaximumValue>
						</ows:Range>
						<ows:Value/>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>AJUST</ows:Identifier>
				<ows:Title>Tipus d'ajust per a la recta de regressió</ows:Title>
				<ows:Abstract>En el cas que s'hagi indicat calcular la Recta de regressió, indica el tipus d'ajust a realitzar:<![CDATA[<ul>
          <li>L: Lineal.</li>
          <li>Q: Quadràtica.</li>
          </ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>L</ows:Value>
						<ows:Value>Q</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>L</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>OutputIMG</ows:Identifier>
				<ows:Title>Fitxer IMG</ows:Title>
				<ows:Abstract>Fitxer IMG amb el resultat de les dades estadístiques calculades.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FitxerIMGSortida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ESTRAS:3</ows:Identifier>
		<ows:Title>Normalització d'un ràster.</ows:Title>
		<ows:Abstract>Aquesta opció calcula la normalització d'un ràster (monobanda o multibanda).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Normalització d'un ràster.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerIMG</ows:Identifier>
				<ows:Title>Fitxer IMG</ows:Title>
				<ows:Abstract>Fitxer ràster a usar pel càlcul d'estadístiques.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerIMG"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>Multibanda</ows:Title>
				<ows:Abstract>Paràmetre opcional per si es vol utilitzar totes les bandes del fitxer d'entrada.</ows:Abstract>
				<LiteralData>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefix</ows:Title>
				<ows:Abstract>Prefix dels fitxers de sortida.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>OutputNorIMG</ows:Identifier>
				<ows:Title>Fitxer IMG</ows:Title>
				<ows:Abstract>Fitxer IMG amb el resultat de la normalització de la imatge d'entrada.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerIMGNorm"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
