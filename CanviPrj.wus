			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>int</ows:Identifier>
				<ows:Title>Interpolation type</ows:Title>
				<ows:Abstract>Criterion to decide output pixel value (interpolation type)<![CDATA[<li>x: Ask interactively.</li><li>0: Nearest neighbor (thematic maps; preserve original radiometry).</li><li>1: Bilineal interpolation (images for photointerpretation; DEM).</li><li>2: Bicubic interpolation (as 1; smoothed results, but slower). </li>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:int"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>x</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>xm</ows:Identifier>
				<ows:Title>X lower</ows:Title>
				<ows:Abstract>X lower output raster bounding coordinates in the order Xminimum Xmaximum Yminimum Ymaximum. Type 'x x x x' if you want the program to calculate them.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:xm"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>xM</ows:Identifier>
				<ows:Title>X Upper</ows:Title>
				<ows:Abstract>X Upper output raster bounding coordinates in the order Xminimum Xmaximum Yminimum Ymaximum. Type 'x x x x' if you want the program to calculate them.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:xM"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ym</ows:Identifier>
				<ows:Title>Y lower</ows:Title>
				<ows:Abstract>Y lower output raster bounding coordinates in the order Xminimum Xmaximum Yminimum Ymaximum. Type 'x x x x' if you want the program to calculate them.</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:ym"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>yM</ows:Identifier>
				<ows:Title>Y Upper</ows:Title>
				<ows:Abstract>Y Upper output raster bounding coordinates in the order Xminimum Xmaximum Yminimum Ymaximum. Type 'x x x x' if you want the program to calculate them.</ows:Abstract>
				<ows:Metadata xlink:title="Param8"/>
				<ows:Metadata xlink:title="Name:yM"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>res</ows:Identifier>
				<ows:Title>Resolution</ows:Title>
				<ows:Abstract>Output image resolution</ows:Abstract>
				<ows:Metadata xlink:title="Param9"/>
				<ows:Metadata xlink:title="Name:res"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>x</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>v_f</ows:Identifier>
				<ows:Title>Flag value</ows:Title>
				<ows:Abstract>Flag value when input file (InpFile) has no data to fill output values. Type 'x' if you want the default value (0).</ows:Abstract>
				<ows:Metadata xlink:title="Param10"/>
				<ows:Metadata xlink:title="Name:v_f"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>x</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATUM_ESTRICTE</ows:Identifier>
				<ows:Title>DATUM_ESTRICTE</ows:Title>
				<ows:Abstract>It allows to make the datum change between datums of the same group (by default is not done).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>f_s</ows:Identifier>
				<ows:Title>Output File</ows:Title>
				<ows:Abstract>Output file.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:OutputFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CanviPrj:!Param4 </ows:Identifier>
		<ows:Title>CanviPrj Structured Vectors</ows:Title>
		<ows:Abstract>It allows to transform structured vector files of points (PNT), arcs (ARC) and polygons (POL). To transform node (NOD) files, it is required to transform their associated arc files, and the corresponding NOD will be automatically transformed.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>f_v_est</ows:Identifier>
				<ows:Title> Input file</ows:Title>
				<ows:Abstract>f_i.PNT, f_i.ARC, f_i.POL:  Input file (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:EstructVecFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RefSystem</ows:Identifier>
				<ows:Title>Output projection system</ows:Title>
				<ows:Abstract>Output projection system. Type 'x' if you wish to indicate it interactively.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:RefSystem"/>
