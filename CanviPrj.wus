						<ows:Value>Normalized_Geostationary</ows:Value>
						<ows:Value>Conic_Equidistant_4S_21S-SAD69</ows:Value>
						<ows:Value>Conic_Equidistant_4S_21S-Normal-Sphere</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>int</ows:Identifier>
				<ows:Title>Interpolation type</ows:Title>
				<ows:Abstract><![CDATA[Criterion to decide the output pixel value (Interpolation):<ul><li>x: Ask interactively.</li><li>0: Nearest neighbor (suitable for thematic maps since it preserves the original radiometry).</li><li>1: Bilineal interpolation (suitable for images for photointerpretation, digital elevation models, etc).</li><li>2: Bicubic interpolation (as 1 with smoothed results, but slower). </li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:int"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>x</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>xMin</ows:Identifier>
				<ows:Title>X minimum</ows:Title>
				<ows:Abstract>Coordinate X minimum of the output raster bounding.  'x' should be typed for calculate it.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:xMin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>xMax</ows:Identifier>
				<ows:Title>X maximum</ows:Title>
				<ows:Abstract>Coordinate X maximum of the output raster bounding.  'x' should be typed for calculate it.</ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:xMax"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>yMin</ows:Identifier>
				<ows:Title>Y minimum</ows:Title>
				<ows:Abstract>Coordinate Y minimum of the output raster bounding.  'x' should be typed for calculate it.</ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:yMin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>yMax</ows:Identifier>
				<ows:Title>Y maximum</ows:Title>
				<ows:Abstract>Coordinate Y maximum of the output raster bounding.  'x' should be typed for calculate it.</ows:Abstract>
				<ows:Metadata xlink:title="Param08"/>
				<ows:Metadata xlink:title="Name:yMax"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>res</ows:Identifier>
				<ows:Title>Output image resolution</ows:Title>
				<ows:Abstract>Output image resolution, in map units. If 'x' is typed, the input resolution is used.</ows:Abstract>
				<ows:Metadata xlink:title="Param09"/>
				<ows:Metadata xlink:title="Name:res"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>x</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>v_f</ows:Identifier>
				<ows:Title>Flag value</ows:Title>
				<ows:Abstract>Flag value when the input file (InpFile) has no data to fill output values. 'x' has to be typed for the default value (0).</ows:Abstract>
				<ows:Metadata xlink:title="Param10"/>
				<ows:Metadata xlink:title="Name:v_f"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>x</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATUM_ESTRICTE</ows:Identifier>
				<ows:Title>Strict datum</ows:Title>
				<ows:Abstract>It allows to make the datum change between datums of the same group (by default it is not done).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>f_s</ows:Identifier>
				<ows:Title>Raster output file</ows:Title>
				<ows:Abstract>Raster output file.</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:OutputFileIMG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CanviPrj:!Param4</ows:Identifier>
		<ows:Title>CanviPrj Structured Vectors</ows:Title>
		<ows:Abstract>Allows to transform structured vector files of points (PNT), arcs (ARC) and polygons (POL). To transform node (NOD) files, it is required to transform their associated arc files.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>f_v_est</ows:Identifier>
				<ows:Title>Structured input file</ows:Title>
				<ows:Abstract>Input structured vector file (with extension), of point type (f_i.PNT), arc (f_i.ARC) or polygon (f_i.POL).</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:EstructVecFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RefSystem</ows:Identifier>
				<ows:Title>Reference system</ows:Title>
				<ows:Abstract>Reference system of the output image. The available reference systems are in the field ID_GEODES of the m_geodes.dbf or u_geodes.dbf table.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:RefSystem"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
