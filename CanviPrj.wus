						<ows:Value>Albers_Equal_Area_Conic-Africa</ows:Value>
						<ows:Value>Albers_Equal_Area_Conic-Ukraine</ows:Value>
						<ows:Value>Albers_Equal_Area_Conic-California_Esf</ows:Value>
						<ows:Value>Azimuthal_Equidistant-0-90-WGS84</ows:Value>
						<ows:Value>LambertAzimEqualA-0-90-WGS84-Ellipsoide</ows:Value>
						<ows:Value>Lambert_Azimuthal_Equal_Area-1052-ETRS89</ows:Value>
						<ows:Value>Lambert_Azimuthal_Equal_Area-9-48-ETRS89</ows:Value>
						<ows:Value>LambertAzimEqualA-0-90-WGS84-Esfera</ows:Value>
						<ows:Value>LambertAzimEqualA-1052-ETRS89-Esfera</ows:Value>
						<ows:Value>LambertAzimEqualA-9-48-ETRS89-Esfera</ows:Value>
						<ows:Value>Cylindrical_Equal_Area-15-0-WGS84</ows:Value>
						<ows:Value>Lambert_Conformal_Conic-ZoneI-NTF</ows:Value>
						<ows:Value>Lambert_Conformal_Conic-ZoneII-NTF</ows:Value>
						<ows:Value>Lambert_Conformal_Conic-ZoneIII-NTF</ows:Value>
						<ows:Value>Lambert_Conformal_Conic-ZoneIII_ext-NTF</ows:Value>
						<ows:Value>Lambert_Conformal_Conic-ZoneII_ext-NTF</ows:Value>
						<ows:Value>Lambert_Conformal_Conic-AND01</ows:Value>
						<ows:Value>Lambert_Conformal_Conic_ICC_Mediterrani</ows:Value>
