	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CanviPrj:!Param5 </ows:Identifier>
		<ows:Title>CanviPrj Non structured Vectors</ows:Title>
		<ows:Abstract>It allows to transform structured vector files of points (PNT), arcs (ARC) and polygons (POL). To transform node (NOD) files, it is required to transform their associated arc files, and the corresponding NOD will be automatically transformed.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>f_vec</ows:Identifier>
				<ows:Title> Input file</ows:Title>
				<ows:Abstract>f_i.VEC:  Input file (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:VecFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
