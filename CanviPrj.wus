<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CanviPrj:Param5</ows:Identifier>
		<ows:Title>CanviPrj IMG</ows:Title>
		<ows:Abstract>This program allows to transform from one projection system to another and allows, by setting the projection parameters, to change the reference system as well. It works on raster files (IMG).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Change Geographical Reference System (cartographic projection, datum, etc) of raster and vector layers"/>
		<ows:Metadata xlink:title="Abstract:This program allows to transform from one projection system to another and allows, by setting the projection parameters, to change the reference system as well. It works on raster files (IMG), non structured vector files (VEC) and structured vector files of points (PNT), arcs (ARC) and polygons (POL). To transform node (NOD) files, it is required to transform their associated arc files, and the corresponding NOD will be automatically transformed."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>f_IMG</ows:Identifier>
				<ows:Title>Input file</ows:Title>
				<ows:Abstract>Input file (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:IMGFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RefSystem</ows:Identifier>
				<ows:Title>Output projection system</ows:Title>
				<ows:Abstract>Output projection system. Type 'x' if you wish to indicate it interactively.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:RefSystem"/>
