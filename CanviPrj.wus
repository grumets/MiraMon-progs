						<ows:Value>Lambert_Conformal_Conic-Maroc_N-Merchich</ows:Value>
						<ows:Value>Lambert_Conformal_Conic-Europa-ETRS89</ows:Value>
						<ows:Value>Lambert_Conformal_Conic-Franþa-ETRS89</ows:Value>
						<ows:Value>Goode_Homolosine-WGS84</ows:Value>
						<ows:Value>Mercator-Equator-ED50-UB/ICC</ows:Value>
