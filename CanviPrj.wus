						<ows:Value>UTM-22N-SAD69-BR</ows:Value>
						<ows:Value>UTM-23N-SAD69-BR</ows:Value>
						<ows:Value>UTM-24N-SAD69-BR</ows:Value>
						<ows:Value>UTM-25N-SAD69-BR</ows:Value>
						<ows:Value>UTM-36S-Tete-MZ</ows:Value>
