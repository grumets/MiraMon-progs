<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Pendent:1</ows:Identifier>
		<ows:Title>Análisis del Terreno: Pendientes, Orientaciones, etc</ows:Title>
		<ows:Abstract>Este programa calcula, a partir de un Modelo Digital de Elevaciones, diferentes Modelos Digitales (Pendientes: MDP, Orientaciones: MDO, etc) derivados de las elevaciones y que ayudan a describir y caracterizar el relieve.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Anàlisi del Terreny: Pendents, Orientacions, etc."/>
		<ows:Metadata xlink:title="Abstract:Este programa calcula, a partir de un Modelo Digital de Elevaciones, diferentes Modelos Digitales (Pendientes: MDP, Orientaciones: MDO, etc) derivados de las elevaciones y que ayudan a describir y caracterizar el relieve."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MDE</ows:Identifier>
				<ows:Title>Modelo Digital de Elevaciones</ows:Title>
				<ows:Abstract>Ráster modelo digital d'elevaciones.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:MDE"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusAnalisi</ows:Identifier>
				<ows:Title>Tipo análisis</ows:Title>
				<ows:Abstract><![CDATA[Opción que indica el procedimiento de análisis escogido:<li>1: Pendiente (°)</li><li>2: Pendiente (%)</li><li>4: Orientación (° + plano)</li><li>5: 4 orientaciones</li><li>6: 8 orientaciones</li><li>7: Curvatura </li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:TipusAnalisis"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>6</ows:Value>
						<ows:Value>7</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NombreVeins</ows:Identifier>
				<ows:Title>Numero Vecinos</ows:Title>
				<ows:Abstract>Puede tomar los valores 4 ó 8 según el número de vecinos que participen en el cálculo del píxel central.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NumeroVecinos"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
						<ows:Value>8</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>4</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PEN_PLA</ows:Identifier>
				<ows:Title>Pendiente Pla</ows:Title>
				<ows:Abstract>Para el cálculo de orientaciones, permite indicar cuál es el valor de pendiente por debajo del cual se considera indefinida (zona plana) la orientación en un punto. Su valor por defecto es 2°, y para el caso estricto hay que definirlo como 0°.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerSortida</ows:Identifier>
				<ows:Title>Resultado</ows:Title>
				<ows:Abstract>Fichero ráster resultado del procedimiento de análisis del terreno.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>