<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:AutoCor:1</ows:Identifier>
		<ows:Title><![CDATA[Índex <i>I</i> de Moran]]></ows:Title>
		<ows:Abstract><![CDATA[Aquesta aplicació permet quantificar el grau d'autocorrelació espacial d'una variable en un fitxer ràster mitjançat el càlcul d'un indicador, en aquest cas a través de l'índex  <i>I</i>(i) de Moran.]]></ows:Abstract>
		<ows:Metadata xlink:title="Title:Anàlisi d&apos;autocorrelació espacial (Moran)"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació permet quantificar el grau d&apos;autocorrelació espacial d&apos;una variable en un fitxer ràster mitjançat el càlcul d&apos;un indicador, en aquest cas a través de l&apos;índex  &lt;i&gt;I&lt;/i&gt;(i) de Moran."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract><![CDATA[<li>1: Índex <i>I</i> de Moran.</li>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxOri</ows:Identifier>
				<ows:Title>Fitxer origen</ows:Title>
				<ows:Abstract>Fitxer ràster origen en format IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxOri"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Pesos</ows:Identifier>
				<ows:Title>Matriu de pesos</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>2: Veïnatge reina (4 veïns).</li><li>1: Veïnatge torre (8 veïns).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Pesos"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxSor</ows:Identifier>
				<ows:Title>Fitxer de sortida</ows:Title>
				<ows:Abstract>Fitxer informe de sortida en format INI.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxSor"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-ini</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-ini</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>