<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ArcInfMM:Param1</ows:Identifier>
		<ows:Title>MM-ArcInf</ows:Title>
		<ows:Abstract>MiraMon a ArcInfo. Converteix fitxers vectorials estructurats del MiraMon al format export/"interchange file" (E00) d'Arc/Info.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversió de fitxers vectorials entre el MiraMon i Arc/Info (Export/interchange file)"/>
		<ows:Metadata xlink:title="Abstract:Aquest programa permet passar d&apos;una família de fitxers vectorials estructurats del MiraMon al format export/interchange file (E00) d&apos;Arc/Info. El format export també pot ser llegit per ArcView."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerTopMM</ows:Identifier>
				<ows:Title>Fitxer topològic d'origen</ows:Title>
				<ows:Abstract>És un fitxer de punts, arcs o polígons (amb extensió PNT, ARC o POL).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FitxerTopMM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Escalat</ows:Identifier>
				<ows:Title>Escalat</ows:Title>
				<ows:Abstract>Factor d'Escala</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Escalat"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DesplaX</ows:Identifier>
				<ows:Title>Desplaçament X</ows:Title>
				<ows:Abstract>Factor de desplaçament X</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:DesplaçX"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DesplaY</ows:Identifier>
				<ows:Title>Desplaçament Y</ows:Title>
				<ows:Abstract>Factor de desplaçament Y</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:DesplaçY"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>a</ows:Identifier>
				<ows:Title>Tipus de precisió (en les coordenades)</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>1: ArcInfo de doble precisió. És l'opció per defecte.</li><li>2: ArcInfo de precisió simple; com algunes versions de PC-Arc/Info.</li><li>Noteu que en les conversions Arc/Info->MM (E00 com a origen), el paràmetre 'a' no s'ha de posar, perquè el MiraMon sempre treballa amb coordenades en doble precisió.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerE00</ows:Identifier>
				<ows:Title>Fitxer E00</ows:Title>
				<ows:Abstract>És un fitxer d'exportació d'Arc/Info (amb extensió).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerE00"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ArcInfMM:!Param1</ows:Identifier>
		<ows:Title>ArcInf-MM</ows:Title>
		<ows:Abstract>ArcInfo al MiraMon. Converteix fitxers (E00) d'Arc/Info (export/interchange files) a fitxers vectorials estructurats del MiraMon</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerE00</ows:Identifier>
				<ows:Title>Fitxer E00</ows:Title>
				<ows:Abstract>És un fitxer d'exportació d'Arc/Info (amb extensió).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FitxerE00"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Escalat</ows:Identifier>
				<ows:Title>Escalat</ows:Title>
				<ows:Abstract>Factor d'Escala</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Escalat"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DesplaX</ows:Identifier>
				<ows:Title>Desplaçament X</ows:Title>
				<ows:Abstract>Factor de desplaçament X</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:DesplaçX"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DesplaY</ows:Identifier>
				<ows:Title>Desplaçament Y</ows:Title>
				<ows:Abstract>Factor de desplaçament Y</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:DesplaçY"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMM</ows:Identifier>
				<ows:Title>Fitxer de Sortida</ows:Title>
				<ows:Abstract>És un fitxer de punts, arcs o polígons o un ràster (amb extensió, PNT, ARC, POL o IMG).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerMM"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>