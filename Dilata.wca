<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Dilata:1</ows:Identifier>
		<ows:Title>Dilata</ows:Title>
		<ows:Abstract>Efectua l'operació de processament d'imatges i morfologia matemàtica coneguda com a dilatació, la qual pren un valor i el replica en el seu entorn geomètric immediat.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Dilatació de píxels d&apos;un cert valor en fitxers ràster"/>
		<ows:Metadata xlink:title="Abstract:Efectua l&apos;operació de processament d&apos;imatges i morfologia matemàtica coneguda com a dilatació, la qual pren un valor i el replica en el seu entorn geomètric immediat."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxOrigen</ows:Identifier>
				<ows:Title>Fitxer ràster a dilatar</ows:Title>
				<ows:Abstract>Fitxer ràster amb un o més valors que volem dilatar.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FitxOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ValorDilatar</ows:Identifier>
				<ows:Title>Valor a dilatar</ows:Title>
				<ows:Abstract>Valor que es vol dilatar. Si voleu dilatar qualsevol valor diferent del sensedades, indiqueu X.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:ValorDilatar"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusDilatacio</ows:Identifier>
				<ows:Title>Tipus de dilatació</ows:Title>
				<ows:Abstract><![CDATA[Pot tenir els següents valors:<ul> <li>1  N-S</li><li>2  E-W</li> <li>3  En creu de Malta (N-S i E-W)</li> <li>4  En creu de Malta i en diagonal (tots els veïns)</li> <li>5  Cap a sota i cap a l'esquerra (S i W)</li><li>6  Cap a sota i cap a l'esquerra, i tots dos (S, W i SW)</li> </ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:TipusDilatacio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>6</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxSortida</ows:Identifier>
				<ows:Title>Fitxer de sortida</ows:Title>
				<ows:Abstract>Fitxer resultat de la dilatacció del valor demanat.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxSortida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>