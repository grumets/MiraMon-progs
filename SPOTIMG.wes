<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SPOTIMG:1</ows:Identifier>
		<ows:Title>SPOTIMG</ows:Title>
		<ows:Abstract><![CDATA[Esta aplicación lee datos de los satélites de la serie SPOT (<i>Satellite Pour l'Observation de la Terre</i>) en formato DIMAP (<i>Digital Image Map</i>, se puede consultar <a href="http://www.spotimage.fr/html/_167_224_232_235_.php">http://www.spotimage.fr/html/_167_224_232_235_.php</a>).]]></ows:Abstract>
		<ows:Metadata xlink:title="Title:Importación de rásters en formato DIMAP (SPOT) a MiraMon"/>
		<ows:Metadata xlink:title="Abstract:Esta aplicación lee datos de los satélites de la serie SPOT (&lt;i&gt;Satellite Pour l&apos;Observation de la Terre&lt;/i&gt;) en formato DIMAP (&lt;i&gt;Digital Image Map&lt;/i&gt;, se puede consultar &lt;a href=&quot;http://www.spotimage.fr/html/_167_224_232_235_.php&quot;&gt;http://www.spotimage.fr/html/_167_224_232_235_.php&lt;/a&gt;)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Transforma rásters en formato DIMAP (SPOT) al formato IMG de MiraMon</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerTIF</ows:Identifier>
				<ows:Title>Nombre del ficheroTIF</ows:Title>
				<ows:Abstract>Es el nombre y dirección del fichero TIF que contiene la imagen. A menudo este fichero se denomina "imagery.tif".</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroTIF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDIM</ows:Identifier>
				<ows:Title>Nombre del fichero DIM</ows:Title>
				<ows:Abstract>Es el nombre y dirección del fichero XML de metadatos en formato DIMAP 1.1. A menudo este fichero se denomina "metadata.dim".</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroDIM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-DIM</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DIM</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxSortG</ows:Identifier>
				<ows:Title>Nombre del fichero salida banda verde</ows:Title>
				<ows:Abstract>Es el nombre y dirección del fichero IMG de salida que contendrá la banda espectral verde (es decir la banda que está en 2a posición dentro del TIF).</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FichSalG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxSortR</ows:Identifier>
				<ows:Title>Nombre del fichero de salida banda roja</ows:Title>
				<ows:Abstract>Es el nombre y dirección del fichero IMG de salida que contendrá la banda espectral rojo (es decir la banda que está en 3a posición dentro del TIF).</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:FichSalR"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxSortIRp</ows:Identifier>
				<ows:Title>Nombre del fichero de salida banda del infrarrojo cercano</ows:Title>
				<ows:Abstract>Es el nombre y dirección del fichero IMG de salida que contendrá la banda infrarojo cercano (es decir la banda que está en 1a posición dentro del TIF).</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:FichSalIRc"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxSortIRoc</ows:Identifier>
				<ows:Title>Nombre del fichero de salida banda del infrarrojo de onda corta</ows:Title>
				<ows:Abstract>Es el nombre y dirección del fichero IMG de salida que contendrá la banda espectral infrarojo de onda corta (es decir la banda que está en 4a posición dentro del TIF).</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:FichSalIRoc"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>