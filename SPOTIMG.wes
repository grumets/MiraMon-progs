<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SPOTIMG:1</ows:Identifier>
		<ows:Title>SPOTIMG</ows:Title>
		<ows:Abstract>Este programa lee datos de los satélites de la serie SPOT (Satellite Pour l'Observation de la Terre) en formato DIMAP (Digital Image Map, vea http://www.spotimage.fr/html/_167_224_232_235_.php).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Transforma rásters en formato DIMAP (SPOT) al formato IMG de MiraMon"/>
		<ows:Metadata xlink:title="Abstract:Este programa lee datos de los satélites de la serie SPOT (Satellite Pour l&apos;Observation de la Terre) en formato DIMAP (Digital Image Map, vea http://www.spotimage.fr/html/_167_224_232_235_.php)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Transforma rásters en formato DIMAP (SPOT) al formato IMG de MiraMon</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerTIF</ows:Identifier>
				<ows:Title>NombreFicheroTIF</ows:Title>
				<ows:Abstract>Es el nombre y path del fichero TIF que contiene la imagen. A menudo este fichero se denomina "imagery.tif".</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroTIF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDIM</ows:Identifier>
				<ows:Title>Nombre Fichero DIM</ows:Title>
				<ows:Abstract>Es el nombre y path del fichero XML de metadatos en formato DIMAP 1.1. A menudo este fichero se denomina "metadata.dim".</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroDIM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-DIM</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DIM</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxSortG</ows:Identifier>
				<ows:Title>Nombre Fichero Salida Verde</ows:Title>
				<ows:Abstract>Es el nombre y path del fichero IMG de salida que contendrá la banda espectral verde (es decir la banda que está en 2a posición dentro del TIF).</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FichSalG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxSortR</ows:Identifier>
				<ows:Title>Nombre Fichero Salida Roja</ows:Title>
				<ows:Abstract>Es el nombre y path del fichero IMG de salida que contendrá la banda espectral rojo (es decir la banda que está en 3a posición dentro del TIF).</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:FichSalR"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxSortIRm</ows:Identifier>
				<ows:Title>Nombre Fichero Salida Infrarrojo medio</ows:Title>
				<ows:Abstract>Es el nombre y path del fichero IMG de salida que contendrá la banda espectral infrarojo medio (es decir la banda que está en 4a posición dentro del TIF).</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:FichSalIRm"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxSortIRp</ows:Identifier>
				<ows:Title>Nombre Fichero Salida Infrarrojo cercano</ows:Title>
				<ows:Abstract>Es el nombre y path del fichero IMG de salida que contendrá la banda infrarojo cercano (es decir la banda que está en 1a posición dentro del TIF).</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:FichSalIRp"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>