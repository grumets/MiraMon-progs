<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 https://schemas.opengis.net/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:0</ows:Identifier>
		<ows:Title>Informació (Opció 0)</ows:Title>
		<ows:Abstract>Informació sobre un fitxer MMZX o un MMZ.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Compressió i descompressió de fitxers MMZX/MMZ (difusió, preservació, etc; versió limitada)"/>
		<ows:Metadata xlink:title="Abstract:Programa per comprimir i descomprimir tant fitxers MMZ (fitxers del MiraMon comprimits) com la seva evolució estandarditzada, fitxers MMZX."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Informació sobre un fitxer MMZX o un MMZ.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>Fitxer MMZ</ows:Title>
				<ows:Abstract>És el nom del fitxer comprimit (amb o sense extensió) en format MMZX, MMZ o ZIP.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerMMZ"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OBRIR_NAVEGADOR</ows:Identifier>
				<ows:Title>Obrir el navegador amb la informació del fitxer</ows:Title>
				<ows:Abstract>Mostrar la informació del fitxer comprimit al navegador d'Internet (a més a més de per pantalla).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESCOMPRIMIR_OPC</ows:Identifier>
				<ows:Title>Descomprimir fitxers OPC</ows:Title>
				<ows:Abstract>Descomprimir fitxers OPC (només aplica quan el fitxer a descomprimir és un MMZX).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Stdout</ows:Identifier>
				<ows:Title>Sortida estàndard</ows:Title>
				<ows:Abstract>Informació sobre el fitxer MiraMon comprimit.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Stdout"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:1</ows:Identifier>
		<ows:Title>Descomprimir (Opció 1)</ows:Title>
		<ows:Abstract>Descomprimir un fitxer MMZX o un MMZ.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Descomprimir un MMZX o un MMZ.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>Fitxer MMZ</ows:Title>
				<ows:Abstract>És el nom del fitxer comprimit (amb o sense extensió) en format MMZX, MMZ o ZIP.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerMMZ"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>US</ows:Identifier>
				<ows:Title>Fondre</ows:Title>
				<ows:Abstract><![CDATA[Sintaxi simplificada segons el seu ús. S'indiquen tant en comprimir com en descomprimir.<ul><li>BACKUP: Per fer backup's (còpies de seguretat) de mapes o capes i restaurar-los en el mateix lloc.</li><li>INTERNET: Per a fer publicacions a Internet.</li><li>INTERCANVI: Per a intercanviar dades amb altres usuaris.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>BACKUP</ows:Value>
						<ows:Value>INTERNET</ows:Value>
						<ows:Value>INTERCANVI</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REGENERACIO</ows:Identifier>
				<ows:Title>Regeneració</ows:Title>
				<ows:Abstract><![CDATA[Aquest paràmetre fa referència al mètode de regeneració del <i>path</i> en descomprimir, ja que en comprimir és quan s'indica com s'ha de descomprimir. En descomprimir, si no s'indica, es fa servir el valor indicat en comprimir i, si s'indica, no es fa cas del criteri preestablert en comprimir:<ul><li>IDENTICA: <i>Path</i> ha de ser idèntic a l'informat (valor per defecte en comprimir) (absoluts com absoluts i relatius com a relatius a partir del 'directori de destí').</li><li>IRELATIVA: <i>Path</i> relatiu a la unitat del fitxer a obrir (per exemple el MMM). En aquesta unitat el <i>path</i> se simplifica tant com sigui possible. S'aplica el criteri 'arbre a partir de directori' per a la resta de fitxers que estiguin en altres unitats de disc o en adreces UNC. (Exemple d'adreça UNC: \\servidor\recurs\mapa.mmm).</li><li>ARBRE: El <i>path</i> s'escriu complet per sobre del directori actual fent servir sempre el criteri 'arbre a partir de directori'. (Recomanat en la distribució d'informació per Internet.).</li><li>NO_PATH: S'elimina el <i>path</i> en descomprimir, situant tots els fitxers al directori de destí, però evitant coincidències de noms.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>IDENTICA</ows:Value>
						<ows:Value>RELATIVA</ows:Value>
						<ows:Value>ARBRE</ows:Value>
						<ows:Value>NO_PATH</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESCOMPRIMIR_OPC</ows:Identifier>
				<ows:Title>Descomprimir fitxers OPC</ows:Title>
				<ows:Abstract>Descomprimir fitxers OPC (només aplica quan el fitxer a descomprimir és un MMZX).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Dir</ows:Identifier>
				<ows:Title>Directori</ows:Title>
				<ows:Abstract>És el directori dins del qual i a partir del qual es descomprimiran els fitxers. Només s'indica en la descompressió; és optatiu i, si no s'indica, es fa servir el directori de treball. Si el mapa s'ha comprimit amb la opció /US=BACKUP, no es fa servir.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Dir"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:2</ows:Identifier>
		<ows:Title>Comprimir directori (Opció 2)</ows:Title>
		<ows:Abstract>Comprimir els fitxers d'un directori (i dels subdirectoris si s'indica).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Comprimir els fitxers d'un directori (i dels subdirectoris si s'indica).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxersDir</ows:Identifier>
				<ows:Title>Fitxers directori a comprimir</ows:Title>
				<ows:Abstract>Directori d'on s'extrauran els fitxers a comprimir. Es permet l'ús de comodins (fent servir '*' i '?'). No fa cap interpretació especial dels fitxers del MiraMon i, per tant, no segueix els seus vincles.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxersDir"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>S</ows:Identifier>
				<ows:Title>Subdirectoris</ows:Title>
				<ows:Abstract>Incloure els fitxers dels subdirectoris que hi pugui haver dins del directori.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>US</ows:Identifier>
				<ows:Title>Fondre</ows:Title>
				<ows:Abstract><![CDATA[Sintaxi simplificada segons el seu ús. S'indiquen tant en comprimir com en descomprimir.<ul><li>BACKUP: Per fer backup's (còpies de seguretat) de mapes o capes i restaurar-los en el mateix lloc.</li><li>INTERNET: Per a fer publicacions a Internet.</li><li>INTERCANVI: Per a intercanviar dades amb altres usuaris.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>BACKUP</ows:Value>
						<ows:Value>INTERNET</ows:Value>
						<ows:Value>INTERCANVI</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REGENERACIO</ows:Identifier>
				<ows:Title>Regeneració</ows:Title>
				<ows:Abstract><![CDATA[Aquest paràmetre fa referència al mètode de regeneració del <i>path</i> en descomprimir, ja que en comprimir és quan s'indica com s'ha de descomprimir. En descomprimir, si no s'indica, es fa servir el valor indicat en comprimir i, si s'indica, no es fa cas del criteri preestablert en comprimir:<ul><li>IDENTICA: <i>Path</i> ha de ser idèntic a l'informat (valor per defecte en comprimir) (absoluts com absoluts i relatius com a relatius a partir del 'directori de destí').</li><li>IRELATIVA: <i>Path</i> relatiu a la unitat del fitxer a obrir (per exemple el MMM). En aquesta unitat el <i>path</i> se simplifica tant com sigui possible. S'aplica el criteri 'arbre a partir de directori' per a la resta de fitxers que estiguin en altres unitats de disc o en adreces UNC. (Exemple d'adreça UNC: \\servidor\recurs\mapa.mmm).</li><li>ARBRE: El <i>path</i> s'escriu complet per sobre del directori actual fent servir sempre el criteri 'arbre a partir de directori'. (Recomanat en la distribució d'informació per Internet.).</li><li>NO_PATH: S'elimina el <i>path</i> en descomprimir, situant tots els fitxers al directori de destí, però evitant coincidències de noms.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>IDENTICA</ows:Value>
						<ows:Value>RELATIVA</ows:Value>
						<ows:Value>ARBRE</ows:Value>
						<ows:Value>NO_PATH</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RELATIU</ows:Identifier>
				<ows:Title>Relatiu</ows:Title>
				<ows:Abstract><![CDATA[Si s'indica, es guardaran els <i>paths</i> a l'interior del fitxer com a relatius; si no s'indica, els <i>paths</i>seran guardats com absoluts. Com a valor es pot indicar un directori, i en aquest cas els <i>paths</i> es guarden relatius a la posició d'aquest directori. També podeu deixar-ho en blanc i el <i>path</i> se simplificarà tant com sigui possible en la unitat del mapa (.mmm). Les unitats o adreces UNC diferents a les de referència es guarden sempre com a absolutes. (Cal indicar aquest paràmetre només en comprimir.)]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ODBC</ows:Identifier>
				<ows:Title>ODBC</ows:Title>
				<ows:Abstract><![CDATA[Indica com es comprimiran les bases de dades enllaçades via ODBC (cal indicar aquest paràmetre només en comprimir). En totes les transformacions al format DBF, s'utilitzarà DBF estesa  sempre que es produeixi una pèrdua d'informació mitjançant l'ús del format de DBF clàssica.<ul><li>FBD_A_DBF: Convertir les bases de dades de tipus fitxer (p.ex. els fitxers MDB) a DBF abans de comprimir. Si no s'indica ni s'indica FBD_SRV_A_DBF, es comprimeixen directament els fitxers de base de dades en el format original. En aquest darrer cas, si aquestes bases de dades contenen enllaços a altres fitxers, aquesta també seran comprimits amb el benentès que els vincles s'hauran d'escriure sempre amb <i>path</i> relatiu.</li><li>SRV_A_DBF: Convertir les bases de dades residents en servidor (p.ex Oracle) a DBF abans de comprimir. Si no s'indica, o s'ha indicat FBD_SRV_A_DBF, aquest tipus de base de dades no es comprimeixen, ni tampoc els eventuals enllaços a altres fitxers que puguin contenir.</li><li>FBD_SRV_A_DBF: Convertir a DBF els dos tipus de bases de dades indicats anteriorment.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>FBD_A_DBF</ows:Value>
						<ows:Value>SRV_A_DBF</ows:Value>
						<ows:Value>FBD_SRV_A_DBF</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SDE</ows:Identifier>
				<ows:Title>ArcSDE/SDO a MiraMon</ows:Title>
				<ows:Abstract><![CDATA[Indica com es comprimiran les bases de dades espacials tipus ArcSDE i/o SDO (cal indicar aquest paràmetre només en comprimir).<ul><li>SDE_A_DBF: Convertir les bases de dades espacials del ArcSDE/SDO als formats de MiraMon abans de comprimir. Si no s'indica, aquest tipus de base de dades no es comprimeixen, només s'inclourà el REL i/o els fitxers de connexió.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>SDE_A_DBF</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC</ows:Identifier>
				<ows:Title>Fitxers OPC</ows:Title>
				<ows:Abstract>Incloure els fitxers OPC (només aplica quan el fitxer a comprimir és un MMZX).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC_THUMBNAIL</ows:Identifier>
				<ows:Title>Vista en miniatura del fitxer</ows:Title>
				<ows:Abstract>Imatge en format JPEG que es vol usar com a vista en miniatura del fitxer. Aquest paràmetre resulta ideal per garantir que tots els full d'una sèrie cartogràfica presentin la mateixa previsualització o vista en miniatura. Per defecte, si no s'indica aquest paràmetre, s'intentarà generar una imatge de manera automàtica a partir dels fitxer/s obribles en MiraMon, l'aplicació invocarà el MiraMon i generarà la impressió del mapa en un petit JPEG automàticament; amb un resultat que generalment serà raonable però, en alguns casos, no satisfactori. Si s'indica el paràmetre però es deixa en blanc, no es posarà cap imatge de previsualització (no recomanat). (Només aplica quan el fitxer a comprimir és un MMZX).</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAPES_LLINATGE</ows:Identifier>
				<ows:Title>Incloure capes del llinatge</ows:Title>
				<ows:Abstract>Incloure totes les capes que són font del llinatge de la capa a comprimir (opció no recomanada).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRUP</ows:Identifier>
				<ows:Title>Grup</ows:Title>
				<ows:Abstract>Nom de grup (només en comprimir).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>NOMVAR#</ows:Identifier>
				<ows:Title>Nom variable</ows:Title>
				<ows:Abstract><![CDATA[Nom de la variable de <i>path</i> (només en comprimir).]]></ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VALORVAR#</ows:Identifier>
				<ows:Title>Valor variable</ows:Title>
				<ows:Abstract>Valor a substituir per la variable (només en comprimir).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCVAR#</ows:Identifier>
				<ows:Title>Descripció variable</ows:Title>
				<ows:Abstract>Descripció de la variable (només en comprimir).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VAR#PATH#</ows:Identifier>
				<ows:Title><![CDATA[Variable <i>path</i>]]></ows:Title>
				<ows:Abstract>Possibles valors alternatius que pot prendre la variable quan el fitxer sigui descomprimit (només en comprimir).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATAACTUA</ows:Identifier>
				<ows:Title>Data actualització</ows:Title>
				<ows:Abstract>Data prevista d'actualització de la capa. Format: aaaammdd</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATACADUCA</ows:Identifier>
				<ows:Title>Data caducitat</ows:Title>
				<ows:Abstract>Data de caducitat de la capa. Format: aaaammdd</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>UBIC#</ows:Identifier>
				<ows:Title>Ubicació</ows:Title>
				<ows:Abstract>Ubicació de la informació actualitzada. (només en comprimir).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCUBIC#</ows:Identifier>
				<ows:Title>Descripció ubicació</ows:Title>
				<ows:Abstract>Descripció de la ubicació de la informació actualitzada (només en comprimir).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>Fitxer MMZ</ows:Title>
				<ows:Abstract>És el nom del fitxer comprimit (amb o sense extensió) en format MMZX, MMZ o ZIP.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerMMZ"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:3</ows:Identifier>
		<ows:Title>Comprimir mapa o capa (Opció 3)</ows:Title>
		<ows:Abstract>Comprimir un MMM o una capa, i tots els seus fitxers vinculats. Aquesta opció també permet certificar un MMZX/MMZ que no estava certificat (només aplicacions certificadores amb llicència corporativa MiraMon Internet Map Publisher).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Comprimir un MMM o una capa, i tots els seus fitxers vinculats.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMM</ows:Identifier>
				<ows:Title>Fitxer MMM</ows:Title>
				<ows:Abstract>És el fitxer a comprimir (amb extensió).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerMMM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/j2c</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/ecw</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-msaccess</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>US</ows:Identifier>
				<ows:Title>Mode</ows:Title>
				<ows:Abstract><![CDATA[Sintaxi simplificada segons el seu ús. S'indiquen tant en comprimir com en descomprimir.<ul><li>BACKUP: Per fer backup's (còpies de seguretat) de mapes o capes i restaurar-los en el mateix lloc.</li><li>INTERNET: Per a fer publicacions a Internet.</li><li>INTERCANVI: Per a intercanviar dades amb altres usuaris.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>BACKUP</ows:Value>
						<ows:Value>INTERNET</ows:Value>
						<ows:Value>INTERCANVI</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>INTERNET</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REGENERACIO</ows:Identifier>
				<ows:Title>Regeneració</ows:Title>
				<ows:Abstract><![CDATA[Aquest paràmetre fa referència al mètode de regeneració del <i>path</i> en descomprimir, ja que en comprimir és quan s'indica com s'ha de descomprimir. En descomprimir, si no s'indica, es fa servir el valor indicat en comprimir i, si s'indica, no es fa cas del criteri preestablert en comprimir:<ul><li>IDENTICA: <i>Path</i> ha de ser idèntic a l'informat (valor per defecte en comprimir) (absoluts com absoluts i relatius com a relatius a partir del 'directori de destí').</li><li>IRELATIVA: <i>Path</i> relatiu a la unitat del fitxer a obrir (per exemple el MMM). En aquesta unitat el <i>path</i> se simplifica tant com sigui possible. S'aplica el criteri 'arbre a partir de directori' per a la resta de fitxers que estiguin en altres unitats de disc o en adreces UNC. (Exemple d'adreça UNC: \\servidor\recurs\mapa.mmm).</li><li>ARBRE: El <i>path</i> s'escriu complet per sobre del directori actual fent servir sempre el criteri 'arbre a partir de directori'. (Recomanat en la distribució d'informació per Internet.).</li><li>NO_PATH: S'elimina el <i>path</i> en descomprimir, situant tots els fitxers al directori de destí, però evitant coincidències de noms.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>IDENTICA</ows:Value>
						<ows:Value>RELATIVA</ows:Value>
						<ows:Value>ARBRE</ows:Value>
						<ows:Value>NO_PATH</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RELATIU</ows:Identifier>
				<ows:Title>Relatiu</ows:Title>
				<ows:Abstract><![CDATA[Si s'indica, es guardaran els <i>paths</i> a l'interior del fitxer com a relatius; si no s'indica, els <i>paths</i>seran guardats com absoluts. Com a valor es pot indicar un directori, i en aquest cas els <i>paths</i> es guarden relatius a la posició d'aquest directori. També podeu deixar-ho en blanc i el <i>path</i> se simplificarà tant com sigui possible en la unitat del mapa (.mmm). Les unitats o adreces UNC diferents a les de referència es guarden sempre com a absolutes. (Cal indicar aquest paràmetre només en comprimir.)]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ODBC</ows:Identifier>
				<ows:Title>ODBC</ows:Title>
				<ows:Abstract><![CDATA[Indica com es comprimiran les bases de dades enllaçades via ODBC (cal indicar aquest paràmetre només en comprimir). En totes les transformacions al format DBF, s'utilitzarà DBF estesa  sempre que es produeixi una pèrdua d'informació mitjançant l'ús del format de DBF clàssica.<ul><li>FBD_A_DBF: Convertir les bases de dades de tipus fitxer (p.ex. els fitxers MDB) a DBF abans de comprimir. Si no s'indica ni s'indica FBD_SRV_A_DBF, es comprimeixen directament els fitxers de base de dades en el format original. En aquest darrer cas, si aquestes bases de dades contenen enllaços a altres fitxers, aquesta també seran comprimits amb el benentès que els vincles s'hauran d'escriure sempre amb <i>path</i> relatiu.</li><li>SRV_A_DBF: Convertir les bases de dades residents en servidor (p.ex Oracle) a DBF abans de comprimir. Si no s'indica, o s'ha indicat FBD_SRV_A_DBF, aquest tipus de base de dades no es comprimeixen, ni tampoc els eventuals enllaços a altres fitxers que puguin contenir.</li><li>FBD_SRV_A_DBF: Convertir a DBF els dos tipus de bases de dades indicats anteriorment.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>FBD_A_DBF</ows:Value>
						<ows:Value>SRV_A_DBF</ows:Value>
						<ows:Value>FBD_SRV_A_DBF</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SDE</ows:Identifier>
				<ows:Title>ArcSDE/SDO a MiraMon</ows:Title>
				<ows:Abstract><![CDATA[Indica com es comprimiran les bases de dades espacials tipus ArcSDE i/o SDO (cal indicar aquest paràmetre només en comprimir).<ul><li>SDE_A_DBF: Convertir les bases de dades espacials del ArcSDE/SDO als formats de MiraMon abans de comprimir. Si no s'indica, aquest tipus de base de dades no es comprimeixen, només s'inclourà el REL i/o els fitxers de connexió.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>SDE_A_DBF</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC</ows:Identifier>
				<ows:Title>Fitxers OPC</ows:Title>
				<ows:Abstract>Incloure els fitxers OPC (només aplica quan el fitxer a comprimir és un MMZX).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC_THUMBNAIL</ows:Identifier>
				<ows:Title>Vista en miniatura del fitxer</ows:Title>
				<ows:Abstract>Imatge en format JPEG que es vol usar com a vista en miniatura del fitxer. Aquest paràmetre resulta ideal per garantir que tots els full d'una sèrie cartogràfica presentin la mateixa previsualització o vista en miniatura. Per defecte, si no s'indica aquest paràmetre, s'intentarà generar una imatge de manera automàtica a partir dels fitxer/s obribles en MiraMon, l'aplicació invocarà el MiraMon i generarà la impressió del mapa en un petit JPEG automàticament; amb un resultat que generalment serà raonable però, en alguns casos, no satisfactori. Si s'indica el paràmetre però es deixa en blanc, no es posarà cap imatge de previsualització (no recomanat). (Només aplica quan el fitxer a comprimir és un MMZX).</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAPES_LLINATGE</ows:Identifier>
				<ows:Title>Incloure capes del llinatge</ows:Title>
				<ows:Abstract>Incloure totes les capes que són font del llinatge de la capa a comprimir (opció no recomanada).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CERTIFICAT</ows:Identifier>
				<ows:Title>Certificat</ows:Title>
				<ows:Abstract>Certificar els fitxers. Si no es posa res se sobreentén que els fitxers no es volen certificar. Combinat amb la opció 3 permet recomprimir i certificar un MMZX o MMZ, o una capa que no estava certificat. (Només aplicacions certificadores amb llicència corporativa MiraMon Internet Map Publisher.).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRUP</ows:Identifier>
				<ows:Title>Grup</ows:Title>
				<ows:Abstract>Nom de grup (només en comprimir).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>NOMVAR#</ows:Identifier>
				<ows:Title>Nom variable</ows:Title>
				<ows:Abstract><![CDATA[Nom de la variable de <i>path</i> (només en comprimir).]]></ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VALORVAR#</ows:Identifier>
				<ows:Title>Valor variable</ows:Title>
				<ows:Abstract>Valor a substituir per la variable (només en comprimir).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCVAR#</ows:Identifier>
				<ows:Title>Descripció variable</ows:Title>
				<ows:Abstract>Descripció de la variable (només en comprimir).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VAR#PATH#</ows:Identifier>
				<ows:Title><![CDATA[Variable <i>path</i>]]></ows:Title>
				<ows:Abstract>Possibles valors alternatius que pot prendre la variable quan el fitxer sigui descomprimit (només en comprimir).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATAACTUA</ows:Identifier>
				<ows:Title>Data actualització</ows:Title>
				<ows:Abstract>Data prevista d'actualització de la capa. Format: aaaammdd</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATACADUCA</ows:Identifier>
				<ows:Title>Data caducitat</ows:Title>
				<ows:Abstract>Data de caducitat de la capa. Format: aaaammdd</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>UBIC#</ows:Identifier>
				<ows:Title>Ubicació</ows:Title>
				<ows:Abstract>Ubicació de la informació actualitzada. (només en comprimir).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCUBIC#</ows:Identifier>
				<ows:Title>Descripció ubicació</ows:Title>
				<ows:Abstract>Descripció de la ubicació de la informació actualitzada (només en comprimir).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>Fitxer MMZ</ows:Title>
				<ows:Abstract>És el nom del fitxer comprimit (amb o sense extensió) en format MMZX, MMZ o ZIP.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerMMZ"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:4</ows:Identifier>
		<ows:Title>Comprimir MSA (Opció 4)</ows:Title>
		<ows:Abstract>Comprimir una MSA. Opció no destinada als usuaris finals del programa, sinó a les persones que han de fer distribució d'una aplicació de suport al MiraMon.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Comprimir una MSA.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>4</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerEXE</ows:Identifier>
				<ows:Title>Fitxer EXE</ows:Title>
				<ows:Abstract>És el nom del fitxer EXE d'una MSA a comprimir (amb extensió).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerEXE"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-exe</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-exe</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>US</ows:Identifier>
				<ows:Title>Fondre</ows:Title>
				<ows:Abstract><![CDATA[Sintaxi simplificada segons el seu ús. S'indiquen tant en comprimir com en descomprimir.<ul><li>BACKUP: Per fer backup's (còpies de seguretat) de mapes o capes i restaurar-los en el mateix lloc.</li><li>INTERNET: Per a fer publicacions a Internet.</li><li>INTERCANVI: Per a intercanviar dades amb altres usuaris.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>BACKUP</ows:Value>
						<ows:Value>INTERNET</ows:Value>
						<ows:Value>INTERCANVI</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REGENERACIO</ows:Identifier>
				<ows:Title>Regeneració</ows:Title>
				<ows:Abstract><![CDATA[Aquest paràmetre fa referència al mètode de regeneració del <i>path</i> en descomprimir, ja que en comprimir és quan s'indica com s'ha de descomprimir. En descomprimir, si no s'indica, es fa servir el valor indicat en comprimir i, si s'indica, no es fa cas del criteri preestablert en comprimir:<ul><li>IDENTICA: <i>Path</i> ha de ser idèntic a l'informat (valor per defecte en comprimir) (absoluts com absoluts i relatius com a relatius a partir del 'directori de destí').</li><li>IRELATIVA: <i>Path</i> relatiu a la unitat del fitxer a obrir (per exemple el MMM). En aquesta unitat el <i>path</i> se simplifica tant com sigui possible. S'aplica el criteri 'arbre a partir de directori' per a la resta de fitxers que estiguin en altres unitats de disc o en adreces UNC. (Exemple d'adreça UNC: \\servidor\recurs\mapa.mmm).</li><li>ARBRE: El <i>path</i> s'escriu complet per sobre del directori actual fent servir sempre el criteri 'arbre a partir de directori'. (Recomanat en la distribució d'informació per Internet.).</li><li>NO_PATH: S'elimina el <i>path</i> en descomprimir, situant tots els fitxers al directori de destí, però evitant coincidències de noms.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>IDENTICA</ows:Value>
						<ows:Value>RELATIVA</ows:Value>
						<ows:Value>ARBRE</ows:Value>
						<ows:Value>NO_PATH</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RELATIU</ows:Identifier>
				<ows:Title>Relatiu</ows:Title>
				<ows:Abstract><![CDATA[Si s'indica, es guardaran els <i>paths</i> a l'interior del fitxer com a relatius; si no s'indica, els <i>paths</i>seran guardats com absoluts. Com a valor es pot indicar un directori, i en aquest cas els <i>paths</i> es guarden relatius a la posició d'aquest directori. També podeu deixar-ho en blanc i el <i>path</i> se simplificarà tant com sigui possible en la unitat del mapa (.mmm). Les unitats o adreces UNC diferents a les de referència es guarden sempre com a absolutes. (Cal indicar aquest paràmetre només en comprimir.)]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ODBC</ows:Identifier>
				<ows:Title>ODBC</ows:Title>
				<ows:Abstract><![CDATA[Indica com es comprimiran les bases de dades enllaçades via ODBC (cal indicar aquest paràmetre només en comprimir). En totes les transformacions al format DBF, s'utilitzarà DBF estesa  sempre que es produeixi una pèrdua d'informació mitjançant l'ús del format de DBF clàssica.<ul><li>FBD_A_DBF: Convertir les bases de dades de tipus fitxer (p.ex. els fitxers MDB) a DBF abans de comprimir. Si no s'indica ni s'indica FBD_SRV_A_DBF, es comprimeixen directament els fitxers de base de dades en el format original. En aquest darrer cas, si aquestes bases de dades contenen enllaços a altres fitxers, aquesta també seran comprimits amb el benentès que els vincles s'hauran d'escriure sempre amb <i>path</i> relatiu.</li><li>SRV_A_DBF: Convertir les bases de dades residents en servidor (p.ex Oracle) a DBF abans de comprimir. Si no s'indica, o s'ha indicat FBD_SRV_A_DBF, aquest tipus de base de dades no es comprimeixen, ni tampoc els eventuals enllaços a altres fitxers que puguin contenir.</li><li>FBD_SRV_A_DBF: Convertir a DBF els dos tipus de bases de dades indicats anteriorment.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>FBD_A_DBF</ows:Value>
						<ows:Value>SRV_A_DBF</ows:Value>
						<ows:Value>FBD_SRV_A_DBF</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SDE</ows:Identifier>
				<ows:Title>ArcSDE/SDO a MiraMon</ows:Title>
				<ows:Abstract><![CDATA[Indica com es comprimiran les bases de dades espacials tipus ArcSDE i/o SDO (cal indicar aquest paràmetre només en comprimir).<ul><li>SDE_A_DBF: Convertir les bases de dades espacials del ArcSDE/SDO als formats de MiraMon abans de comprimir. Si no s'indica, aquest tipus de base de dades no es comprimeixen, només s'inclourà el REL i/o els fitxers de connexió.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>SDE_A_DBF</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC</ows:Identifier>
				<ows:Title>Fitxers OPC</ows:Title>
				<ows:Abstract>Incloure els fitxers OPC (només aplica quan el fitxer a comprimir és un MMZX).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC_THUMBNAIL</ows:Identifier>
				<ows:Title>Vista en miniatura del fitxer</ows:Title>
				<ows:Abstract>Imatge en format JPEG que es vol usar com a vista en miniatura del fitxer. Aquest paràmetre resulta ideal per garantir que tots els full d'una sèrie cartogràfica presentin la mateixa previsualització o vista en miniatura. Per defecte, si no s'indica aquest paràmetre, s'intentarà generar una imatge de manera automàtica a partir dels fitxer/s obribles en MiraMon, l'aplicació invocarà el MiraMon i generarà la impressió del mapa en un petit JPEG automàticament; amb un resultat que generalment serà raonable però, en alguns casos, no satisfactori. Si s'indica el paràmetre però es deixa en blanc, no es posarà cap imatge de previsualització (no recomanat). (Només aplica quan el fitxer a comprimir és un MMZX).</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAPES_LLINATGE</ows:Identifier>
				<ows:Title>Incloure capes del llinatge</ows:Title>
				<ows:Abstract>Incloure totes les capes que són font del llinatge de la capa a comprimir (opció no recomanada).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRUP</ows:Identifier>
				<ows:Title>Grup</ows:Title>
				<ows:Abstract>Nom de grup (només en comprimir).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>NOMVAR#</ows:Identifier>
				<ows:Title>Nom variable</ows:Title>
				<ows:Abstract><![CDATA[Nom de la variable de <i>path</i> (només en comprimir).]]></ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VALORVAR#</ows:Identifier>
				<ows:Title>Valor variable</ows:Title>
				<ows:Abstract>Valor a substituir per la variable (només en comprimir).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCVAR#</ows:Identifier>
				<ows:Title>Descripció variable</ows:Title>
				<ows:Abstract>Descripció de la variable (només en comprimir).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VAR#PATH#</ows:Identifier>
				<ows:Title><![CDATA[Variable <i>path</i>]]></ows:Title>
				<ows:Abstract>Possibles valors alternatius que pot prendre la variable quan el fitxer sigui descomprimit (només en comprimir).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATAACTUA</ows:Identifier>
				<ows:Title>Data actualització</ows:Title>
				<ows:Abstract>Data prevista d'actualització de la capa. Format: aaaammdd</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATACADUCA</ows:Identifier>
				<ows:Title>Data caducitat</ows:Title>
				<ows:Abstract>Data de caducitat de la capa. Format: aaaammdd</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>UBIC#</ows:Identifier>
				<ows:Title>Ubicació</ows:Title>
				<ows:Abstract>Ubicació de la informació actualitzada. (només en comprimir).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCUBIC#</ows:Identifier>
				<ows:Title>Descripció ubicació</ows:Title>
				<ows:Abstract>Descripció de la ubicació de la informació actualitzada (només en comprimir).</ows:Abstract>
				<ows:Metadata xlink:title="Hide:deprecated"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>Fitxer MMZ</ows:Title>
				<ows:Abstract>És el nom del fitxer comprimit (amb o sense extensió) en format MMZX, MMZ o ZIP.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerMMZ"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:5</ows:Identifier>
		<ows:Title>Canvi capçalera (Opció 5)</ows:Title>
		<ows:Abstract>Canvi d'un valor en la capçalera del fitxer. Opció no destinada als usuaris finals del programa, sinó a les persones que fan desenvolupament del MiraMon.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Canviar un valor en la capçalera del fitxer.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>5</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>5</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>Fitxer MMZ</ows:Title>
				<ows:Abstract>És el nom del fitxer comprimit (amb o sense extensió) en format MMZX, MMZ o ZIP.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerMMZ"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>IEntrada</ows:Identifier>
				<ows:Title>Índex d'Entrada</ows:Title>
				<ows:Abstract>És l'índex de fitxer comprimit al qual es canviarà una característica indicada a la capçalera, indexat des de 0.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:IEntrada"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NouValor</ows:Identifier>
				<ows:Title>Nou Valor</ows:Title>
				<ows:Abstract>Nou valor a la  capçalera del fitxer MMZX/MMZ. De moment només es pot canviar l'OBERTURA que pot prendre els valor 1 o 0, o marcar el fitxer com de la instal·lació amb INST_MM3.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NouValor"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>Fitxer MMZ</ows:Title>
				<ows:Abstract>És el nom del fitxer comprimit (amb o sense extensió) en format MMZX, MMZ o ZIP.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerMMZ"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:6</ows:Identifier>
		<ows:Title>Certificació (Opció 6)</ows:Title>
		<ows:Abstract>Crear certificats de mapes o de capes. Sobreescriu els certificats previs si existeixen.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Crear certificats de fitxers MMM o de capes específiques.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>6</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>6</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMM</ows:Identifier>
				<ows:Title>Fitxer MMM</ows:Title>
				<ows:Abstract>És el fitxer a comprimir (amb extensió).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerMMM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/j2c</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/ecw</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-msaccess</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMM</ows:Identifier>
				<ows:Title>Fitxer MMM</ows:Title>
				<ows:Abstract>És el fitxer a comprimir (amb extensió).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerMMM"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/j2c</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/ecw</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-msaccess</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
