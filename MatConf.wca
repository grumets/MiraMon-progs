<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MatConf:Param3</ows:Identifier>
		<ows:Title>Text</ows:Title>
		<ows:Abstract>Aquest programa construeix la 'Matriu de confusió', taula bidimensional de comparació de les dades de la imatge classificada amb les dades de referència o veritat-terreny. El format de sortida ès un fitxer de text.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Generació de matrius de confusió per a l&apos;avaluació de cartografia temàtica"/>
		<ows:Metadata xlink:title="Abstract:Aquest programa construeix la &apos;Matriu de confusió&apos;, taula bidimensional de comparació de les dades de la imatge classificada amb les dades de referència o veritat-terreny. El format de sortida pot ser un fitxer de text o un fitxer en format de full de càlcul (CSV)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Referencia</ows:Identifier>
				<ows:Title>Referència</ows:Title>
				<ows:Abstract>Referència és el ràster veritat-terreny.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Referència"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Test</ows:Identifier>
				<ows:Title>Test</ows:Title>
				<ows:Abstract>Test correspon al ràster classificat a avaluar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Test"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NCOL</ows:Identifier>
				<ows:Title>Numero de columnes</ows:Title>
				<ows:Abstract>Demana el valor numèric de la paginació o mida màxima de l'informe mesurada en nombre de columnes (categories). Aquest paràmetre és vàlid pels dos tipus d'informe.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CATEG_FIXAT</ows:Identifier>
				<ows:Title>Categories de la Imatge</ows:Title>
				<ows:Abstract>El tesaure de categories de la imatge veritat-terreny marca el nombre de columnes de la matriu de confusió.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SEPARA</ows:Identifier>
				<ows:Title>Separador</ows:Title>
				<ows:Abstract>Especifica el separador de llistes necessari pel format full de càlcul (CSV).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FTXT</ows:Identifier>
				<ows:Title>Fitxer de Text</ows:Title>
				<ows:Abstract>Cal indicar el nom del fitxer de text on el programa escriurà la matriu de confusió</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MatConf:!Param3</ows:Identifier>
		<ows:Title>CSV</ows:Title>
		<ows:Abstract>Aquest programa construeix la 'Matriu de confusió', taula bidimensional de comparació de les dades de la imatge classificada amb les dades de referència o veritat-terreny. El format de sortida ès un fitxer en format de full de càlcul (CSV).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Referencia</ows:Identifier>
				<ows:Title>Referència</ows:Title>
				<ows:Abstract>Referència és el ràster veritat-terreny.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Referència"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Test</ows:Identifier>
				<ows:Title>Test</ows:Title>
				<ows:Abstract>Test correspon al ràster classificat a avaluar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Test"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NCOL</ows:Identifier>
				<ows:Title>Numero de columnes</ows:Title>
				<ows:Abstract>Demana el valor numèric de la paginació o mida màxima de l'informe mesurada en nombre de columnes (categories). Aquest paràmetre és vàlid pels dos tipus d'informe.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CATEG_FIXAT</ows:Identifier>
				<ows:Title>Categories de la Imatge</ows:Title>
				<ows:Abstract>El tesaure de categories de la imatge veritat-terreny marca el nombre de columnes de la matriu de confusió.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SEPARA</ows:Identifier>
				<ows:Title>Separador</ows:Title>
				<ows:Abstract>Especifica el separador de llistes necessari pel format full de càlcul (CSV).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FCSV</ows:Identifier>
				<ows:Title>Fitxer de CSV</ows:Title>
				<ows:Abstract>Cal indicar el nom del fitxer de sortida que conté la matriu de confusió en format full de càlcul.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>