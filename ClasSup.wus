<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CLASSUP:Param4</ows:Identifier>
		<ows:Title>Supervised Classification of Images</ows:Title>
		<ows:Abstract>Supervised classification based on classics classifiers such as: minimum Euclidean distance, Manhattan minimum distance and maximum likelihood.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Supervised Classification of Images"/>
		<ows:Metadata xlink:title="Abstract:Supervised classification based on classics classifiers such as: minimum Euclidean distance, Manhattan minimum distance and maximum likelihood."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FiTXT</ows:Identifier>
				<ows:Title>List of the source bands</ows:Title>
				<ows:Abstract>List of source bands to be used for the supervised classification by the chosen classifier.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:BandsList"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ValorFons</ows:Identifier>
				<ows:Title>Criterion of background value to avoid</ows:Title>
				<ows:Abstract>Criterion of background value to avoid.<![CDATA[ <ul><li>0 if you want to avoid the background value indicated in the metadata.</li><li>1 if the background value to avoid is the value zero.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BackgroundValue"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Classificador</ows:Identifier>
				<ows:Title>Classifier to use</ows:Title>
				<ows:Abstract><![CDATA[ <ul><li>Euc to do a minimum Euclidean distance classification.</li><li>Eix to do a Manhattan minimum distance classification.</li><li>MaxVers to do a maximum likelihood classification.</li><li>MaxBay to do a maximum Bayesian likelihood classification.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Classifier"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>Euc</ows:Value>
						<ows:Value>Eix</ows:Value>
						<ows:Value>MaxVers</ows:Value>
						<ows:Value>MaxBay</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>Euc</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MaxBandesNoData</ows:Identifier>
				<ows:Title>Number maximum of bands with NODATA values</ows:Title>
				<ows:Abstract>Currently, this input only can worth 0</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:MaxBandsNoData"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FiTXT_SGN</ows:Identifier>
				<ows:Title>Source file of signatures</ows:Title>
				<ows:Abstract>The signatures file to be used at the classification. It is typically a list file that contains all SGN files generated with AreaSGN from the same list file "FiTXT" which introduces the variables to the classifier.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:SignaturesFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_FiDist</ows:Identifier>
				<ows:Title>Number of belonging probabilities file</ows:Title>
				<ows:Abstract>This parameter is an integer value between 0 and 3. <![CDATA[ <ul><li>If the value is 1, it only will be generated the file of maximum probabilities (or distances) of belonging with the name indicated on fisor_dist variable.</li><li>If the value is greater than 1, it will be generated files with name fisor_dist_1 (with the maximum probability), fisor_dist_2 (with the second maximum probability or distance), etc.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param8"/>
				<ows:Metadata xlink:title="Name:N_FiDist"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Disc</ows:Identifier>
				<ows:Title>Force not to upload the images to sort in memory</ows:Title>
				<ows:Abstract>Useful for low memory computers relative to the size of the files to be classified. Generally it is not necessary to apply because if the program runs out of memory, it switchs to this mode automatically.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NProces</ows:Identifier>
				<ows:Title>Number of processor cores used</ows:Title>
				<ows:Abstract>You can specify a specific number of processor to use or "MAX" (to use all processors) or "SUB_MAX" (to use all processors minus one).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>SUB_MAX</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerResultat</ows:Identifier>
				<ows:Title>Output file</ows:Title>
				<ows:Abstract>This is the output file of the supervised classification.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:OutputFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FiDist</ows:Identifier>
				<ows:Title>Belonging probabilities file</ows:Title>
				<ows:Abstract>File of the belonging probabilities (or distances to the center, in distance classifiers) of every pixel to the winner class. If NUL word is indicated, the distances or probabilities raster (depending on the classifier) will not be generated.</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:ProbabilitiesFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CLASSUP:!Param4</ows:Identifier>
		<ows:Title>Transform divergent calculation</ows:Title>
		<ows:Abstract>Transform divergent calculation to compute the class separability.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FiTXT_SGN</ows:Identifier>
				<ows:Title>Signatures file</ows:Title>
				<ows:Abstract>Signatures file to be used for the transform divergent analysis.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:SGNFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Disc</ows:Identifier>
				<ows:Title>Force not to upload the images to sort in memory</ows:Title>
				<ows:Abstract>Useful for low memory computers relative to the size of the files to be classified. Generally it is not necessary to apply because if the program runs out of memory, it switchs to this mode automatically.</ows:Abstract>
				<LiteralData>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NProces</ows:Identifier>
				<ows:Title>Number of processor cores used</ows:Title>
				<ows:Abstract>You can specify a specific number of processor to use or "MAX" (to use all processors) or "SUB_MAX" (to use all processors minus one).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>SUB_MAX</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerValorsDT</ows:Identifier>
				<ows:Title>Transform divergent values file</ows:Title>
				<ows:Abstract>File where the TD values among all the signatures provided will be written with all the covariance and correlation matrices.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:DTValuesFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
