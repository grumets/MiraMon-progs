<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CreaMMS:1</ows:Identifier>
		<ows:Title>Capa de puntos (opción 1)</ows:Title>
		<ows:Abstract>Prepara una capa de puntos para ser visualizada.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Preparación de capas para su publicación en el WMS de MiraMon"/>
		<ows:Metadata xlink:title="Abstract:Prepara niveles de zoom para el servidor de mapas. Detalle de origen: plantilla de ayuda."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 1</ows:Title>
				<ows:Abstract>Prepara una capa de puntos para ser visualizada.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Directori</ows:Identifier>
				<ows:Title>Directorio</ows:Title>
				<ows:Abstract>Directorio del nivel de zoom.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Directori"/>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerLST</ows:Identifier>
				<ows:Title>Fichero LST</ows:Title>
				<ows:Abstract>Lista de teselas generadas.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerLST"/>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>costat</ows:Identifier>
				<ows:Title>Lado</ows:Title>
				<ows:Abstract>Tamaño de píxel del raster.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:costat"/>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerPNT</ows:Identifier>
				<ows:Title>Fichero PNT</ows:Title>
				<ows:Abstract>PNT origen.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:FitxerPNT"/>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TRACTAMENT</ows:Identifier>
				<ows:Title>Tratamiento</ows:Title>
				<ows:Abstract>S o T (símbolos o textos).</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VALOR_CONSTANT</ows:Identifier>
				<ows:Title>Valor constante</ows:Title>
				<ows:Abstract>Símbolo o fuente; no con /CAMP.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP</ows:Identifier>
				<ows:Title>Campo</ows:Title>
				<ows:Abstract>Campo BD4; no con /VALOR_CONSTANT.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TAULA_SIMBOLS</ows:Identifier>
				<ows:Title>Tabla símbolos</ows:Title>
				<ows:Abstract>dbf si no /VALOR_CONSTANT.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_TEXT_MOSTRAR</ows:Identifier>
				<ows:Title>Campo texto</ows:Title>
				<ows:Abstract>Textos si tratamiento T.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CreaMMS:2</ows:Identifier>
		<ows:Title>Capa raster o vector (opción 2)</ows:Title>
