						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>		
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaR</ows:Identifier>
				<ows:Title>Banda 	R</ows:Title>
				<ows:Abstract>Banda que correspon al Roig.</ows:Abstract>
			<ows:Metadata xlink:title="Param3" />
			<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>	
				<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaB</ows:Identifier>
				<ows:Title>Banda 	B</ows:Title>
				<ows:Abstract>Banda que correspon al Blau.</ows:Abstract>
			<ows:Metadata xlink:title="Param3" />
