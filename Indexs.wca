<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:1</ows:Identifier>
		<ows:Title>DVI (Differential Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[Diferència entre la reflectància a la banda de l'infraroig proper (IRp) i del vermell (R) d'un sensor.<br/><br/><img src="Indexs_DVI.gif"/><br/>]]></ows:Abstract>
		<ows:Metadata xlink:title="Title:Programa per a calcular índexs de vegetació i altres índexs d&apos;interès en teledetecció"/>
		<ows:Metadata xlink:title="Abstract:Aquest programa permet calcular fàcilment índexs de vegetació i altres índexs d&apos;interès en teledetecció a partir d&apos;un conjunt predefinit. En cas que l&apos;índex que us interessi no estigui disponible en aquest programa, podeu calcular-lo a través del mòdul &lt;a href=&quot;CalcIMG.htm&quot;&gt;CalcImg&lt;/a&gt;. També podeu utilitzar el &lt;a href=&quot;CalcIMG.htm&quot;&gt;CalcImg&lt;/a&gt; per a reescalar els valors de sortida."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>DVI (Differential Vegetation Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IRp</ows:Title>
				<ows:Abstract>Banda que correspon a la regió espectral de l'infraroig proper.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:BandaIRp"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaR</ows:Identifier>
				<ows:Title>Banda R</ows:Title>
				<ows:Abstract>Banda que correspon a la regió espectral del vermell.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BandaR"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Imatge de sortida</ows:Title>
				<ows:Abstract>Nom de la imatge de sortida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ImatgeSortida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:2</ows:Identifier>
		<ows:Title>RVI (Ratio Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[Quocient simple entre la reflectància a la banda de l'infraroig proper i del vermell que s'ha utilitzat per estimacions de biomassa i índex d'àrea foliar (LAI) des del 1969.<br/><br/><img src="Indexs_RVI.gif"/>]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>RVI (Ratio Vegetation Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IRp</ows:Title>
				<ows:Abstract>Banda que correspon a la regió espectral de l'infraroig proper.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:BandaIRp"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaR</ows:Identifier>
				<ows:Title>Banda R</ows:Title>
				<ows:Abstract>Banda que correspon a la regió espectral del vermell.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BandaR"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Imatge de sortida</ows:Title>
				<ows:Abstract>Nom de la imatge de sortida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ImatgeSortida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:3</ows:Identifier>
		<ows:Title>NDVI (Normalized Difference Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[L'índex de vegetació NDVI ha estat el més usat en teledetecció de vegetació durant les últimes dues dècades. Fou emprat per primer cop per Kriegler <i>et al.</i> (<b>Kriegler FJ, Malila WA, Nalepka RF i Richardson W</b> (1969) <i>Preprocessing transformations and their effects on multispectral recognition</i>. Proceedings of the Sixth International Symposium on Remote Sensing of Environment, p. 97-131) i desenvolupat per Rouse <i>et al.</i> (<b>Rouse JW, Haas, RH, Schell, JA i Deering, DW</b> (1973) <i>Monitoring Vegetation Systems in the Great Plains with ERTS</i>. Third ERT Symposium, NASA SP-351, I:309-317 (1973)) a partir de l'anàlisi de dades de Landsat-MSS. Van trobar que, encara que el quocient simple (RVI) podia ser usat com a mesura relativa de verdor, la localització i desviacions cícliques podien introduir un important error. D'aquesta manera defineixen l'índex de vegetació de diferències normalitzades com:<br/><br/><img src="Indexs_NDVI.gif"/><br/><br/>Un aspecte interessant d'aquest índex enfront el quocient simple és que pren valors entre -1 i 1, qual cosa facilita notablement la seva interpretació. Aquest índex ha estat usat per estimar un gran nombre de variables: l'índex d'àrea foliar (LAI), el flux net de CO<sub>2</sub>, radiació fotosintèticament activa absorbida per la planta (APAR), productivitat neta de la vegetació, contingut de clorofil·la, dinàmica fenològica, evapotranspiració potencial i quantitat de pluja rebuda per la coberta vegetal. Les aplicacions més habituals són: pel seguiment de les condicions de la coberta vegetal a escala global, estudis de desforestació, desertització, detecció d'incendis, caracterització de biomes a escala global, prevenció de sequera i risc d'incendis forestals a partir de l'anàlisi de sèries multitemporals.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>NDVI (Normalized Difference Vegetation Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IRp</ows:Title>
				<ows:Abstract>Banda que correspon a la regió espectral de l'infraroig proper.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:BandaIRp"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaR</ows:Identifier>
				<ows:Title>Banda R</ows:Title>
				<ows:Abstract>Banda que correspon a la regió espectral del vermell.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BandaR"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Imatge de sortida</ows:Title>
				<ows:Abstract>Nom de la imatge de sortida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ImatgeSortida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:4</ows:Identifier>
		<ows:Title>TVI (Transformed Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[Transformació del NDVI que evita treballar amb valors negatius.<br/><br/><img  src="Indexs_TVI.gif"/>]]></ows:Abstract>
		<DataInputs>
