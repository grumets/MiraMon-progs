	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:15</ows:Identifier>
		<ows:Title>AVI (Angular Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[L'índex AVI (Plummer et al. 1994) es va proposar per al sensor ATRS-2 i pretén emprar la disponibilitat de la banda verda per normalitzar els efectes dels sòls i de l'atmosfera i mantenir la sensibilitat a les propietats  de la vegetació. L'índex es basa en un concepte geomètric de l'angle definit entre les bandes verd, vermell i infraroig proper que caracteritza l'absorció de la clorofil·la.<br/><br/><img  src="Indexs_AVI.gif"/><br/><br/>Les<img  src="Indexs_Lambda.gif"/> corresponen als centres de cadascuna de les bandes.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>AVI (Angular Vegetation Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>15</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IRp</ows:Title>
				<ows:Abstract>Banda que correspon a la regió espectral de l'infraroig proper.</ows:Abstract>
