	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:22</ows:Identifier>
		<ows:Title>PRI (Photochemical Reflectance Index)</ows:Title>
		<ows:Abstract><![CDATA[El PRI és un índex d'eficiència fotosintètica de la vegetació útil en l'estimació del balanç de carboni en els ecosistemes mediterranis.<br/><br/>En efecte, el bosc mediterrani perennifoli presenta una estacionalitat molt baixa en índexs de vegetació com ara l'NDVI o l'EVI, malgrat tenir una gran estacionalitat de la fixació del carboni. En aquests casos, el PRI permet detectar quina part de la capacitat de fixació del carboni s'ha fet efectiva.<br/><br/>Es calcula: <img  src="Indexs_PRI.GIF"/><br/><br/>On la <img  src="Indexs_PRI_531.GIF"/> i la <img  src="Indexs_PRI_570.GIF"/> corresponen a les reflectàncies en les longituds d'ona 531 nm i 570 nm, respectivament. Aquestes longituds d'ona es poden veure lleugerament modificades en funció del sensor, l'espècie, etc. <br/><br/>El PRI està relacionat amb l'ús de la radiació, amb valors compresos entre -1 i 1, creixents quan s'incrementa l'eficiència fotosintètica.<br/><br/><b>Gamon J, Peñuelas J, Field C</b> (1992) <i>A narrow-waveband spectral index that tracks diurnal changes in photosynthetic efficiency</i>. Remote Sensing of Environment, 41, 35-44.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>PRI (Photochemical Reflectance Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>22</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Banda_570_nm</ows:Identifier>
				<ows:Title>Banda de 570 nm</ows:Title>
				<ows:Abstract>Banda de longitud d'ona 570 nm.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Banda_570_nm"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Banda_531_nm</ows:Identifier>
				<ows:Title>Banda de 531 nm</ows:Title>
				<ows:Abstract>Banda de longitud d'ona 531 nm.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Banda_531_nm"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Imatge de sortida</ows:Title>
				<ows:Abstract>Nom de la imatge de sortida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ImatgeSortida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:23</ows:Identifier>
		<ows:Title>NDSI (Normalized Difference Snow Index)</ows:Title>
		<ows:Abstract><![CDATA[Índex que permet la detecció de la coberta nival. Es calcula:<br><br><img  src="Indexs_NDSI.GIF"/><br/><br/>on <img  src="Indexs_RoV.GIF"/> i <img  src="Indexs_RoIRoc.GIF"/>corresponen a les reflectàncies en la regió espectral del verd i de l'IRoc, respectivament, ja que la neu és molt reflexiva en el visible i, en canvi, absorbent a l'infraroig d'ona curta. En el cas de dades del sensor TM s'utilitza com a IRoc la banda 5. Valors de l'NDSI superiors a 0.4 corresponen a zones amb coberta nival.<br/><br/>Diversos autors recomanen aplicar màscares en zones d'ombres i d'existència de llacs per a evitar la confusió amb àrees innivades.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>NDSI (Normalized Difference Snow Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>23</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaV</ows:Identifier>
				<ows:Title>Banda del verd</ows:Title>
				<ows:Abstract>Banda que correspon a la regió espectral del verd.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:BandaV"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIRoc</ows:Identifier>
				<ows:Title>Banda de l'IRoc</ows:Title>
				<ows:Abstract>Banda que correspon a la regió espectral de l'infraroig d'ona curta.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BandaIRoc"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Imatge de sortida</ows:Title>
				<ows:Abstract>Nom de la imatge de sortida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ImatgeSortida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:24</ows:Identifier>
		<ows:Title>BI (Brightness Index)</ows:Title>
		<ows:Abstract><![CDATA[Índex emprat en l'estudi de les condicions dels sòls (color, humitat i estructura), especialment en les regions àrides i semiàrides.  Es calcula:<br><br><img  src="Indexs_BI.GIF"/><br/><br/>on <img  src="Indexs_RoV.GIF"/>  és la reflectància a la regió espectral del vermell i <img  src="Indexs_RoIRp.GIF"/> és la reflectància a la regió espectral de l'IRp. Com que no es tracta d'un índex normalitzat, el resultat no està acotat superiorment per cap constant. Valors alts del BI indiquen una reflectància més elevada, situació que correspon a sòls secs, descoberts i de color clar.<br><br>L'ús d'aquest índex està recollit a la pàgina 81 de la tesi doctoral de <b>Sebastien Rapinel</b> (2012) <i>Contribution de la télédétection à l'évaluation des fonctions des zones humides: de l'observation à la modélisation prospective</i>, disponible a <a href="https://tel.archives-ouvertes.fr/tel-00731169/document">https://tel.archives-ouvertes.fr/tel-00731169/document</a>. També hi ha una formulació similar a <b>Escadafal R, Bacha S</b> (1995) <i>Strategy for the Dynamic Study of Desertification</i>, Proceedings of the ISSS International Symposium, Ouagadougou, Burkina Faso, 6-10 February 1995, pp. 19-34, disponible a <a href="https://horizon.documentation.ird.fr/exl-doc/pleins_textes/pleins_textes_6/colloques2/010008392.pdf">https://horizon.documentation.ird.fr/exl-doc/pleins_textes/pleins_textes_6/colloques2/010008392.pdf</a>, que utilitza una formulació (pàg. 27 del text imprès) on afegeix a la suma el quadrat de la reflectància en la banda del verd. Finalment, en el treball de <b>Marques et al.</b> (2020) <i>The use of remote sensing to detect the consequences of erosion in gypsiferous soils</i> Water Conservation Research, 8:383e392, s'utilitza una formulació similar (equació 2), però amb les bandes del verd i el vermell, segurament menys informativa per l'alta correlació habitual entre aquestes bandes.  <br><br>Nota: Se sol atribuir referències a aquest índex que són errònies o que usen en realitat altres aproximacions (combinacions lineals com la brillantor de la transformació Tasseled Cap, etc). Per tal d'evitar confusions i pèrdues de temps als usuaris del MiraMon, a continuació donem algunes de les referències que NO tenen a veure amb l'índex 24 que està implementat en aquest mòdul:  <b>Escadafal R, Belghith A, Ben Moussa H</b> (1994) <i>Indices spectraux pour la dégradation des milieux naturels en Tunisie aride</i>. 6ème Symp. Int. Mesures Physiques et Signatures en Télédétection. ISPRS-CNES <a href="https://horizon.documentation.ird.fr/exl-doc/pleins_textes/pleins_textes_5/b_fdi_20-21/26946.pdf">https://horizon.documentation.ird.fr/exl-doc/pleins_textes/pleins_textes_5/b_fdi_20-21/26946.pdf</a>, <a href=https://foodsecurity-tep.net/S2_BI">https://foodsecurity-tep.net/S2_BI</a> [aquesta pàgina conté una fórmula sense sentit i, a més, dóna una referència que tampoc no està relacionada]).]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>IB (Brightness Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>24</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IRp</ows:Title>
				<ows:Abstract>Banda que correspon a la regió espectral de l'infraroig proper.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:BandaIRp"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIRoc</ows:Identifier>
				<ows:Title>Banda de l'IRoc</ows:Title>
				<ows:Abstract>Banda que correspon a la regió espectral de l'infraroig d'ona curta.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BandaIRoc"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Imatge de sortida</ows:Title>
				<ows:Abstract>Nom de la imatge de sortida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ImatgeSortida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:25</ows:Identifier>
		<ows:Title>NDWI-Chen (Normalized Difference Water Index Chen, Huang, Jackson)</ows:Title>
		<ows:Abstract><![CDATA[Índex proposat per Chen i col·laboradors el 2005 per a determinar el contingut d'aigua en la vegetació amb dades del sensor MODIS. Es basa en l'absorció de l'aigua en l'IRoc i es calcula: <br/><br/><img src="Indexs_NDWI_Chen.gif"/><br/><br/>  on <img src="Indexs_RoIRp.gif"/> i <img src="Indexs_RoIRoc.gif"/> corresponen a la reflectància en la regió espectral centrada a 858 nm i 1640 (o 2130) nm, respectivament; formulat així, l'NDWI pren valors entre lleugerament negatius i 1 en funció del contingut d'aigua de la vegetació.<br/><br/><b>Chen D, Huang J, Jackson TJ</b> (2005) <i>Vegetation water content estimation for corn and soybeans using spectral indices derived from MODIS near- and short-wave infrared bands</i>. Remote Sensing of Environment, 98:225-236.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>NDWI-Chen (Normalized Difference Water Index Chen, Huang, Jackson)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>25</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIRoc</ows:Identifier>
				<ows:Title>Banda de l'IRoc</ows:Title>
				<ows:Abstract>Banda que correspon a la regió espectral de l'infraroig d'ona curta.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:BandaIRoc"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Imatge de sortida</ows:Title>
				<ows:Abstract>Nom de la imatge de sortida.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:ImatgeSortida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>