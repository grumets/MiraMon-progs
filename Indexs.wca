<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:12</ows:Identifier>
		<ows:Title>ARVI</ows:Title>
		<ows:Abstract><![CDATA[<b>ARVI (Atmospheriaclly Resistent Vegetation Index):</b>Índex de vegetació que no és més que un NDVI millorat que té en compte
    l'efectes de l'atmosfera. Proposen substituir el canal vermell per un
    canal roig-blau, que tindria en compte la diferent dispersió de
    l'atmosfera en aquests dos canals, de la següent manera:<br/>
    <br/><img alt="Imatge no visible des de DOS" src="ARVI.gif"/><br/>
    <br/>on <img alt="Imatge no visible des de DOS" src="ARVIn.gif"/> és la
    reflectància combinada dels dos canals blau i vermell. La constant és un
    paràmetre de calibració que depen del tipus d_atmosfera, però que
    generalment es sol prendre igual a 1.]]></ows:Abstract>
	<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
