<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
<ows:Identifier>MiraMon:Indexs:Param1:1</ows:Identifier>
<ows:Title>DVI</ows:Title>
<ows:Abstract><![CDATA[<b>(Differential Vegetation Index):</b>Diferència entre les bandes infraroig proper (IRP) i roig (R) d'un sensor.<br/><br/><img alt="Imatge no visible des de DOS" src="DVI.gif"/><br/>]]>
</ows:Abstract>
<ows:Metadata xlink:title="Title:Programa per calcular índexs de vegetació"/>
<ows:Metadata xlink:title="Abstract:Aquest programa permet calcular un conjunt predefinit d'índexs de vegetació."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>1. DVI
</ows:Abstract>
			<ows:Metadata xlink:title="Param1" />
			<LiteralData>
				<ows:AllowedValues>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
				<ows:Value>1</ows:Value>
			</ows:AllowedValues>
		</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IR</ows:Title>
				<ows:Abstract>Banda que correspon a l'infraroig proper.</ows:Abstract>
			<ows:Metadata xlink:title="Param2" />
