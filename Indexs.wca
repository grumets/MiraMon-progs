	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:16</ows:Identifier>
		<ows:Title>GEMI (Global Environment Monitoring Index)</ows:Title>
		<ows:Abstract><![CDATA[Índex proposat per imatges del sensor AVHRR de NOAA a fi i efecte de tenir un coneixement global de la vegetació a tot el planeta. És un índex no lineal que minimitza l'efecte del sòl i de l'atmosfera.<br/><br/><img  src="Indexs_GEMI.gif"/><br/><br/><img  src="Indexs_GEMIn.gif"/>]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>GEMI (Global Environment Monitoring Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>16</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IRp</ows:Title>
