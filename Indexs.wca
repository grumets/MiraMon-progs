<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:7</ows:Identifier>
		<ows:Title>SAVI</ows:Title>
		<ows:Abstract><![CDATA[<b>(Soil Adjusted Vegetation Index):</b>Índex que pretén minimitzar l'efecte del sòl sobre els índexs de
    vegetació anteriors, manifest sobretot en superfícies parcialment
    recobertes.<br/><br/><img alt="Imatge no visible des de DOS" src="SAVI.gif"/><br/>
    <br/>L = constant que depén del tipus de sòl. Un valor típic és 0.5.]]></ows:Abstract>
	<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>7. SAVI
</ows:Abstract>
			<ows:Metadata xlink:title="Param1" />
			<LiteralData>
				<ows:AllowedValues>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
				<ows:Value>7</ows:Value>
			</ows:AllowedValues>
		</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
