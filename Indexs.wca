					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:17</ows:Identifier>
		<ows:Title>NDWI-MF (Normalized Difference Water Index - McFeeters)</ows:Title>
		<ows:Abstract><![CDATA[L'NDWI el va proposar McFeeters (1996) per delinear les masses d'aigua oberta com llacs i embassaments i millorar la seva detecció en imatges de satèl·lit. Amb aquest índex les superfícies d'aigua tenen valors positius, mentre que la superfície de la terra i de la vegetació tenen valors 0 o negatius.<br/><br/><img  src="Indexs_NDWI.GIF"/><br/><br/><b>McFeeters, SK</b> (1996) <i>The use of the normalized difference water index (NDWI) in the delineation of open water features</i>.  International Journal of Remote Sensing, 17: 1425-1432.<br/><br/>Aquest índex correspon a l'<a href="https://www.termcat.cat/ca/diccionaris-en-linia/197/search/NDWI1?type=basic&condition=contains">NDWI<sup>1</sup></a> del <a href="https://www.termcat.cat/ca/diccionaris-en-linia/197">Diccionari terminològic de teledetecció</a> de Pons i Arcalís (2012).]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>NDWI-MF (Normalized Difference Water Index - McFeeters)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>17</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IRp</ows:Title>
