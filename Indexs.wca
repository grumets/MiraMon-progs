			</Output>
		</ProcessOutputs>	
</ProcessDescription>
<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:21</ows:Identifier>
		<ows:Title>PRI</ows:Title>
		<ows:Abstract><![CDATA[
      <b>(Photochemical Reflectance Index):</b>El PRI és un índex que permet estimar la RUE (Radiation-Use Efficiency) de la vegetació i el GPP (Gross Primary Productivity) en els ecosistemes mediterranis. El bosc mediterrani perennifoli té una molt baixa estacionalitat dels índexs de vegetació (NDVI i EVI) i una gran estacionalitat de l'absorció de carboni. En aquests casos aquestíndex permet detectar quina part de la capacitat d'absorció de carboni s'ha realitzat a la pràctica. El PRI es deriva de la lliure disposició d'informació pel satèl·lit MODIS.<p><img height="80" src="PRI.GIF" width="224"/></p><p>On la <span class="style7">p</span><sub>5.2</sub> correspon a la
banda 11 (526-536 nm) i la <span class="style6">p</span><sub>5.4</sub> a la banda 12 (546-556 nm) de MODIS.</p><p>Garbulsky, MF; Penuelas, J; Papale, D &amp; Filella, I (2008) Remote estimation of carbon dioxide uptake by a Mediterranean forest. GLOBAL CHANGE BIOLOGY. 14. 12: 2860-2867</p>]]></ows:Abstract>
	<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>21. PRI</ows:Abstract>
			<ows:Metadata xlink:title="Param1" />
			<LiteralData>
				<ows:AllowedValues>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
				<ows:Value>21</ows:Value>
			</ows:AllowedValues>
		</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IR</ows:Title>
				<ows:Abstract>Banda que correspon a l'infraroig proper.</ows:Abstract>
			<ows:Metadata xlink:title="Param2" />
			<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>		
