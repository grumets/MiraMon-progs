<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:18</ows:Identifier>
		<ows:Title>NDWI-2</ows:Title>
		<ows:Abstract><![CDATA[
      <b>(Normalized Difference Water Index):</b>L'índex NDWI s'ha desenvolupat de molt diverses maneres i alguns autors (Ouma &amp; Tateishi, 2006) han proposat modificacions.
L'NDWI2 usa les bandes del NIR i MIR per delimitar la línia de costa de les masses d'aigua. Es tracta d'un índex per a representacions ràpides de la línia de costa. <p><img height="80" src="NDWI_2.GIF" width="224"/></p><p>Ouma, YO; Tateishi, R. (2006). &quot;A water index for rapid mapping  of shoreline changes of five East African Rift Valley lakes: an empirical analysis using Landsat TM and ETM+ data&quot;. INTERNATIONAL JOURNAL OF REMOTE SENSING. 27: 3153-3181.</p>]]></ows:Abstract>
	<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>18. NDWI-2
</ows:Abstract>
			<ows:Metadata xlink:title="Param1" />
			<LiteralData>
				<ows:AllowedValues>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
				<ows:Value>18</ows:Value>
			</ows:AllowedValues>
		</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IR</ows:Title>
				<ows:Abstract>Banda que correspon a l'infraroig proper.</ows:Abstract>
			<ows:Metadata xlink:title="Param2" />
			<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>		
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIRM</ows:Identifier>
				<ows:Title>Banda IRM</ows:Title>
				<ows:Abstract>Banda que correspon a l'infraroig mig.</ows:Abstract>
			<ows:Metadata xlink:title="Param3" />
			<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
