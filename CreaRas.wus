<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CreaRas</ows:Identifier>
		<ows:Title>CreaRas: Creates a new raster</ows:Title>
		<ows:Metadata xlink:title="Title:Creates a new raster."/>
		<ows:Metadata xlink:title="Abstract:Creates a new raster from a pre-existing pattern file or with given characteristics that are entered manually."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxPatro</ows:Identifier>
				<ows:Title>Pattern file</ows:Title>
				<ows:Abstract>File that defines the geographical area of the map. It must be given with extension. If a pattern file is not provided, this parameter will be "NUL".</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-nod</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusDada</ows:Identifier>
				<ows:Title>Data type</ows:Title>
				<ows:Abstract>Indicates the datatype of the new image. It can be any of the data types supported by MiraMon, for example "byte", "integer-RLE", etc.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>integer-RLE</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ValorFons</ows:Identifier>
				<ows:Title>Flag value</ows:Title>
				<ows:Abstract>Value that will be used to initialize the output raster file.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MarcarValorFons</ows:Identifier>
				<ows:Title>Mark flag value</ows:Title>
				<ows:Abstract>Indicates whether the initialization value will be marked as flag value in the documentation file (1) or not (0).</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CostatCella</ows:Identifier>
				<ows:Title>Pixel Size</ows:Title>
				<ows:Abstract>Size of the cell</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Mult</ows:Identifier>
				<ows:Title>Multiple</ows:Title>
				<ows:Abstract>If PartternFile is a vector file, the program enlarges the geographical region so that the coordinates minX and minY of the new raster are multiple of Mult. In addition, in this case a minimum of one pixel will be included all around.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DescripcioNoData</ows:Identifier>
				<ows:Title>No data description</ows:Title>
				<ows:Abstract>Optional parameter which allows to assign a descriptor to the flag value in the case that MarkFlagValue is activated. The default description is NODATA.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>NODATA</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxSort</ows:Identifier>
				<ows:Title>Output file</ows:Title>
				<ows:Abstract>New output file IMG raster (or a grid within a VEC).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>