	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ConvREL:Param1:10&amp;!Param3</ows:Identifier>
		<ows:Title>Opción 10: Emancipa una capa de las series cartográficas a las que pertenece</ows:Title>
		<ows:Abstract>Emancipa una capa de las series cartográficas a las que pertenece, heredando la información de la serie. El REL de salida se saca de la capa origen.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 10</ows:Title>
