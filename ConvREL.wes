	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ConvREL:Param1:7</ows:Identifier>
		<ows:Title>Opción 7: De REL4 con metadatos versión 5.0 a versión 4.5.</ows:Title>
		<ows:Abstract>Transformar un REL4 con metadatos versión 5.0 a REL4 con metadatos versión 4.5.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 7</ows:Title>
				<ows:Abstract>Transformar un REL4 con metadatos versión 5.0 a REL4 con metadatos versión 4.5.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>7</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>7</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDirectori</ows:Identifier>
				<ows:Title>Fichero/Directorio</ows:Title>
				<ows:Abstract>Es el nombre de la capa (no del REL o el doc/dv?) o del directorio que contiene las capas a convertir.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Fichero/Directorio"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-nod</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>BACKUP</ows:Identifier>
				<ows:Title>Conservar</ows:Title>
				<ows:Abstract>Indica que debe conservarse el doc/dv? y/o guardar el REL como RE1, RE4 o re4MD5_0, según sea el tipo de fichero de origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>Ráster multibanda</ows:Title>
				<ows:Abstract>Para el caso ráster y conversiones a REL4 (opción 4) intenta generar un ráster multibanda a partir de los ficheros de nombre similar al indicado.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SERIE</ows:Identifier>
				<ows:Title>Simbolización de la serie</ows:Title>
				<ows:Abstract>Transforma también la simbolización común a una serie cartográfica. Hay que usarlo con prudencia dado que otras capas que dependan de la misma serie podrían no abrirse sin también migrarlas. Solamente aplica en la opción 4.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIMBOLITZACIO</ows:Identifier>
				<ows:Title>Impide la transformación de la simbolización</ows:Title>
				<ows:Abstract>Impide la transformación de la simbolización de un REL o la simbolización común a una serie cartográfica. Útil en algunos casos donde no sea posible la llamada interna al programa MiraMon. Solamente aplica en la opción 4.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>S</ows:Identifier>
				<ows:Title>Transforma todos los ficheros</ows:Title>
				<ows:Abstract>Transforma todos los ficheros dentro del directorio 'Directorio' y subdirectorios. En el caso de la opción 4 implica /SERIE.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDirectori</ows:Identifier>
				<ows:Title>Fichero/Directorio</ows:Title>
				<ows:Abstract>Es el nombre de la capa (no del REL o el doc/dv?) o del directorio que contiene las capas a convertir.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Fichero/Directorio"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-nod</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
