<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ConvREL:Param1:1</ows:Identifier>
		<ows:Title>Opción 1: De REL4 a DOC/DVC+REL1</ows:Title>
		<ows:Abstract>Convierte un REL4 en un conjunto de ficheros DOC/DVC y REL1.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversión de capas entre formatos 1 y 4 de MiraMon"/>
		<ows:Metadata xlink:title="Abstract:Este programa transforma las relaciones entre tablas, los metadatos y la simbolización a la versión 4/5 desde versiones anteriores. También permite el retorno a versiones anteriores con características limitadas. Además, permite la fusión de n bandas en un único ràster multibanda (de formato REL4), y su acción inversa, emancipar una o todas las bandas de un fichero multibanda (de formato REL4)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 1</ows:Title>
				<ows:Abstract>Transforma un REL4 en doc/dv? + REL1.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDirectori</ows:Identifier>
				<ows:Title>Fichero/Directorio</ows:Title>
				<ows:Abstract>Es el nombre de la capa (no del REL o el doc/dv?) o del directorio que contiene las capas a convertir.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Fichero/Directorio"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-nod</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>BACKUP</ows:Identifier>
				<ows:Title>Conservar</ows:Title>
				<ows:Abstract>Indica que debe conservarse el doc/dv? y/o guardar el REL como RE1, RE4 o re4MD5_0, según sea el tipo de fichero de origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>Ráster multibanda</ows:Title>
				<ows:Abstract>Para el caso ráster y conversiones a REL4 (opción 4) intenta generar un ráster multibanda a partir de los ficheros de nombre similar al indicado.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SERIE</ows:Identifier>
				<ows:Title>Simbolización de la serie</ows:Title>
				<ows:Abstract>Transforma también la simbolización común a una serie cartográfica. Hay que usarlo con prudencia dado que otras capas que dependan de la misma serie podrían no abrirse sin también migrarlas. Solamente aplica en la opción 4.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>S</ows:Identifier>
				<ows:Title>Transforma todos los ficheros</ows:Title>
				<ows:Abstract>Transforma todos los ficheros dentro del directorio 'Directorio' y subdirectorios. En el caso de la opción 4 implica /SERIE.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDirectori</ows:Identifier>
				<ows:Title>Fichero/Directorio</ows:Title>
				<ows:Abstract>Es el nombre de la capa (no del REL o el doc/dv?) o del directorio que contiene las capas a convertir.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Fichero/Directorio"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-nod</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ConvREL:Param1:4</ows:Identifier>
		<ows:Title>Opción 4: Transforma un doc/dv? + REL1 en un REL4 con metadatos versión 5</ows:Title>
		<ows:Abstract>Transforma un doc/dv? + REL1 en un REL4 con metadatos versión 5. La opción 4 requiere de MM32.exe versión 4.0vt o superior para migrar la simbolización.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 4</ows:Title>
				<ows:Abstract>Transforma un doc/dv? + REL1 en un REL4 con metadatos versión 5. La opción 4 REQUEREIX de MM32.exe versión 4.0vt o superior para migrar la simbolitzación.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>4</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDirectori</ows:Identifier>
				<ows:Title>Fichero/Directorio</ows:Title>
				<ows:Abstract>Es el nombre de la capa (no del REL o el doc/dv?) o del directorio que contiene las capas a convertir.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Fichero/Directorio"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-nod</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>BACKUP</ows:Identifier>
				<ows:Title>Conservar</ows:Title>
				<ows:Abstract>Indica que debe conservarse el doc/dv? y/o guardar el REL como RE1, RE4 o re4MD5_0, según sea el tipo de fichero de origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>Ráster multibanda</ows:Title>
				<ows:Abstract>Para el caso ráster y conversiones a REL4 (opción 4) intenta generar un ráster multibanda a partir de los ficheros de nombre similar al indicado.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SERIE</ows:Identifier>
				<ows:Title>Simbolización de la serie</ows:Title>
				<ows:Abstract>Transforma también la simbolización común a una serie cartográfica. Hay que usarlo con prudencia dado que otras capas que dependan de la misma serie podrían no abrirse sin también migrarlas. Solamente aplica en la opción 4.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIMBOLITZACIO</ows:Identifier>
				<ows:Title>Impide la transformación de la simbolización</ows:Title>
				<ows:Abstract>Impide la transformación de la simbolización de un REL o la simbolización común a una serie cartográfica. Útil en algunos casos donde no sea posible la llamada interna al programa MiraMon. Solamente aplica en la opción 4.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>S</ows:Identifier>
				<ows:Title>Transforma todos los ficheros</ows:Title>
				<ows:Abstract>Transforma todos los ficheros dentro del directorio 'Directorio' y subdirectorios. En el caso de la opción 4 implica /SERIE.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDirectori</ows:Identifier>
				<ows:Title>Fichero/Directorio</ows:Title>
				<ows:Abstract>Es el nombre de la capa (no del REL o el doc/dv?) o del directorio que contiene las capas a convertir.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Fichero/Directorio"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-nod</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ConvREL:Param1:5&amp;!Param3</ows:Identifier>
		<ows:Title>Opción 5: Une en un solo REL multibanda n ficheros ráster</ows:Title>
		<ows:Abstract>Une en un solo REL multibanda n ficheros ráster. El programa decide el nombre del REL de forma automática en función de los nombres de bandas a fusionar.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 5</ows:Title>
				<ows:Abstract>Une en un solo REL multibanda n ficheros ráster.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>5</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>5</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerLlista</ows:Identifier>
				<ows:Title>Fichero Lista</ows:Title>
				<ows:Abstract>Es un fichero de texto que contiene una lista de los nombres de ficheros de los rásters a fusionar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroLista"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>AFEGIR</ows:Identifier>
				<ows:Title>Añadir las bandas</ows:Title>
				<ows:Abstract>Si el fichero REL fijado en /REL= existe, esta opción añade las bandas al REL ya existente.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SOBRESCRIURE</ows:Identifier>
				<ows:Title>Sobrescribe</ows:Title>
				<ows:Abstract>En la opción de REL fijado, si éste existe, lo elimina y crea un fichero nuevo con la correspondiente fusión de bandas.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ConvREL:Param1:5&amp;Param3</ows:Identifier>
		<ows:Title>Opción 5: Une en un solo REL multibanda n ficheros ráster</ows:Title>
		<ows:Abstract>Une en un solo REL multibanda n ficheros ráster.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 5</ows:Title>
				<ows:Abstract>Une en un solo REL multibanda n ficheros ráster.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>5</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>5</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerLlista</ows:Identifier>
				<ows:Title>Fichero Lista</ows:Title>
				<ows:Abstract>Es un fichero de texto que contiene una lista de los nombres de ficheros de los rásters a fusionar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroLista"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>AFEGIR</ows:Identifier>
				<ows:Title>Añadir las bandas</ows:Title>
				<ows:Abstract>Si el fichero REL fijado en /REL= existe, esta opción añade las bandas al REL ya existente.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SOBRESCRIURE</ows:Identifier>
				<ows:Title>Sobrescribe</ows:Title>
				<ows:Abstract>En la opción de REL fijado, si éste existe, lo elimina y crea un fichero nuevo con la correspondiente fusión de bandas.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>REL</ows:Identifier>
				<ows:Title>REL</ows:Title>
				<ows:Abstract>Nombre de fichero REL multibanda fijado por el usuario. Si no se indica el programa decide el nombre de forma automática en función de los nombres de bandas a fusionar.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:REL"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ConvREL:Param1:6</ows:Identifier>
		<ows:Title>Opción 6: Emancipa todas les bandas de un REL multibanda.</ows:Title>
		<ows:Abstract>Emancipa todas les bandas de un REL multibanda.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 6</ows:Title>
				<ows:Abstract>Emancipa todas les bandas de un REL multibanda.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>6</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>6</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerREL</ows:Identifier>
				<ows:Title>Fichero REL</ows:Title>
				<ows:Abstract>Es el nombre del rel multibanda a emancipar</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroREL"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
