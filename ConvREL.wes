	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ConvREL:1:5</ows:Identifier>
		<ows:Title> ConvREL 5</ows:Title>
		<ows:Abstract>Une en un solo REL multibanda n ficheros ráster.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Une en un solo REL multibanda n ficheros ráster. </ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>5</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FicheroLista </ows:Identifier>
				<ows:Title>Fichero Lista </ows:Title>
				<ows:Abstract>Es un fichero de texto que contiene una lista de los nombres de ficheros de los rásters a fusionar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/txt</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/txt</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>AFEGIR</ows:Identifier>
				<ows:Title>Transforma todos los ficheros</ows:Title>
				<ows:Abstract>Si el fichero REL fijado en /REL= existe, esta opción añade las bandas al REL ya existente.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SOBRESCRIURE</ows:Identifier>
				<ows:Title>Sobrescribe</ows:Title>
				<ows:Abstract>En la opción de REL fijado, si éste existe, lo elimina y crea un fichero nuevo con la correspondiente fusión de bandas.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>REL</ows:Identifier>
				<ows:Title>REL</ows:Title>
				<ows:Abstract>Nombre de fichero REL multibanda fijado por el usuario. Si no se indica el programa decide el nombre de forma automática en función de los nombres de bandas a fusionar.
				</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
