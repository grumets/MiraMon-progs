	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ConvREL:1:10</ows:Identifier>
		<ows:Title> ConvREL 10</ows:Title>
		<ows:Abstract>Emancipa una capa de las series cartográficas a las que pertenece, heredando la información de la series.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Emancipa una capa de las series cartográficas a las que pertenece, heredando la información de la series.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:AllowedValues>
						<ows:Value>10</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FicheroRELOrigen</ows:Identifier>
				<ows:Title>Fichero REL Origen</ows:Title>
				<ows:Abstract>Es la dirección y el nombre del REL a emancipar de la serie cartográfica.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FicheroRELDestino</ows:Identifier>
				<ows:Title>Fichero REL Destino</ows:Title>
				<ows:Abstract>Es la dirección y el nombre de la capa emancipada de la serie. Es un parámetro optativo, en caso de no indicar ningún nombre del REL destino se sobrescribirá el REL de origen.</ows:Abstract>
