					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>10</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>10</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerRELorigen</ows:Identifier>
				<ows:Title>Fichero REL origen</ows:Title>
				<ows:Abstract>Es la dirección y el nombre del REL a emancipar de la serie cartográfica.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerRELOrigen"/>
				<ComplexData>
					<Default>
