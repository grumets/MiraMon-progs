<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:AreaSGN:Param1:2</ows:Identifier>
		<ows:Title>Option 2</ows:Title>
		<ows:Abstract>Creates  the SGN spectral signature files of all the spectral bands of an image from some training areas.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Creation of signatures and spectral statistics from training areas"/>
		<ows:Metadata xlink:title="Abstract:Creates  the SGN spectral signature files of all the spectral bands of an image from some training areas."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Creation of the spectral signatures and CSV table from a raster layer or categorical polygons.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigen</ows:Identifier>
				<ows:Title>Origin file</ows:Title>
				<ows:Abstract>Categorical IMG raster file or POL polygons file with the information of the class type associated to each pixel of the image or to each polygon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:OriginFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Llista</ows:Identifier>
				<ows:Title>File of raster layer list</ows:Title>
				<ows:Abstract>Text file with the names of different raster layers corresponding to bands of satellite images, DTM, etc...</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:List"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP</ows:Identifier>
				<ows:Title>Category field</ows:Title>
				<ows:Abstract>In the case that the input file is a polygon layer, it is the DBF table field that contains the class associated to each polygon.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REPE</ows:Identifier>
				<ows:Title>Record chosen when there is more than one index</ows:Title>
				<ows:Abstract><![CDATA[Indicates which record is chosen when there is more than one record per graphic identifier (multiple record). To know more about the values of this parameter, follow the considerations of the document of <a href="general.htm#TaulaCamp">general syntax</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_CAT</ows:Identifier>
				<ows:Title>Field with the name of the categories</ows:Title>
				<ows:Abstract>In case the input file is a polygons file and a field of numerical category is chosen, it corresponds to the field with the names of the categories.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MEDIANA_EMPAT</ows:Identifier>
				<ows:Title>Decision for the median</ows:Title>
				<ows:Abstract><![CDATA[Indicates what type of tiebreaker to make in the case of the median.<ul>
           <li>1: Alternate value.</li>           
           <li>2: Lower value.</li>           
           <li>3: Upper value.</li>           
           <li>4: Average of middle values.</li>           
           </ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_DECIM_HTML</ows:Identifier>
				<ows:Title>Decimal number HTML data</ows:Title>
				<ows:Abstract>Number of decimals of the data in the HTML file of signature graphics.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRAF_HTML_W_IMP</ows:Identifier>
				<ows:Title>Width quality resolution printing HTML graphics</ows:Title>
				<ows:Abstract>Width of quality resolution for printing the signature graphics of the HTML file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>2100</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRAF_HTML_H_IMP</ows:Identifier>
				<ows:Title>Height quality resolution printing HTML graphics</ows:Title>
				<ows:Abstract>Height of quality resolution for printing the signature graphics of the HTML file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1800</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRAF_HTML_W_VIS</ows:Identifier>
				<ows:Title>Width quality resolution printing HTML graphics</ows:Title>
				<ows:Abstract>Width of the standard resolution for on-screen display of the signature graphics of the HTML file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>700</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRAF_HTML_H_VIS</ows:Identifier>
				<ows:Title>Height quality resolution printing HTML graphics</ows:Title>
				<ows:Abstract>Height of the standard resolution for on-screen display of the signature graphics of the HTML file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>600</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OBRIR_HTML</ows:Identifier>
				<ows:Title>Open generated HTML file</ows:Title>
				<ows:Abstract>Open the HTML file directly once generated.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DIST_CSV</ows:Identifier>
				<ows:Title>Distance</ows:Title>
				<ows:Abstract><![CDATA[Distance type:<ul><li>EUC: Euclidean.</li><li>EIX: Manhattan.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>EUC</ows:Value>
						<ows:Value>EIX</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>EUC</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OBRIR_CSV</ows:Identifier>
				<ows:Title>Open generated CSV file</ows:Title>
				<ows:Abstract>Open the CSV file directly once generated.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>SGN</ows:Identifier>
				<ows:Title>Spectral signatures</ows:Title>
				<ows:Abstract>Folder of output spectral signature files.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:SGN"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
			<Output>
				<ows:Identifier>HTML</ows:Identifier>
				<ows:Title>HTML file of signature graph</ows:Title>
				<ows:Abstract>Address of the HTML file of signature graphics output.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/html</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/html</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>CSV</ows:Identifier>
				<ows:Title>CSV file of spectral statistics</ows:Title>
				<ows:Abstract>Address of the output file CSV with spectral statistics.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>