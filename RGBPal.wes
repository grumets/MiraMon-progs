				<ows:Title>Fichero Rojo</ows:Title>
				<ows:Abstract>Fichero RGB de salida de la banda del Rojo.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FicheroRSalida"/>
				<ComplexOutput>
