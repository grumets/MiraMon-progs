<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:RGBPal:Param1:1</ows:Identifier>
		<ows:Title>Opción 1</ows:Title>
		<ows:Abstract>Esta opción transforma 3 imágenes byte separadas (canales R, G y B) a un fichero IMG con paleta de colores.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Transformación de imágenes entre espacios de colores"/>
		<ows:Metadata xlink:title="Abstract:Este módulo tiene la finalidad de hacer transformaciones entre diferentes espacios de color."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Transforma 3 imágenes byte separadas (RGB) a un fichero IMG con paleta de colores.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerR</ows:Identifier>
				<ows:Title>Fichero Rojo</ows:Title>
				<ows:Abstract>Fichero RGB de la banda del Rojo.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroR"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerG</ows:Identifier>
				<ows:Title>Fichero Verde</ows:Title>
				<ows:Abstract>Fichero RGB de la banda del Verde.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroG"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerB</ows:Identifier>
				<ows:Title>Fichero Azul</ows:Title>
				<ows:Abstract>Fichero RGB de la banda del Azul.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FicheroB"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MAP_PAL</ows:Identifier>
				<ows:Title>Forzar el espacio de color a una paleta determinada</ows:Title>
				<ows:Abstract>Fuerza el espacio de color a una paleta determinada. Noten que si indican este parámetro, la paleta indicada es leída del disco. Si no se indica este parámetro el programa escribe al disco una paleta optimizada por esta imagen en concreto.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerIMG</ows:Identifier>
				<ows:Title>Fichero Imagen</ows:Title>
				<ows:Abstract>Es el nombre del fichero de 8 bits.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:FicheroIMGSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxerPAL</ows:Identifier>
				<ows:Title>Fichero Paleta</ows:Title>
				<ows:Abstract>Es el nombre del fichero de la paleta de colores DBF, PAL, P65 o P25.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:FicheroPAL"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:RGBPal:Param1:2</ows:Identifier>
		<ows:Title>Opción 2</ows:Title>
		<ows:Abstract>Esta opción transforma un fichero IMG con paleta de colores a 3 imágenes byte separadas (canales R, G y B).</ows:Abstract>
