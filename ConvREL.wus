				<ows:Identifier>FitxerRELDesti</ows:Identifier>
				<ows:Title>Destination FileREL</ows:Title>
				<ows:Abstract>Is the address and name of the layer emancipated from the series. It is an optional parameter; if no destination REL name is indicated, the origin REL is overwritten.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputFileREL"/>
				<ComplexOutput>
					<Default>
