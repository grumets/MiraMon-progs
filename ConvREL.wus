	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ConvREL:Param1:10&amp;!Param3</ows:Identifier>
		<ows:Title>Option 10: Emancipates a layer from the cartographic series to which it belongs, inheriting the series information.</ows:Title>
		<ows:Abstract>Emancipates a layer from the cartographic series to which it belongs, inheriting the series information. The output REL file is created from the source layer.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 10</ows:Title>
				<ows:Abstract>Emancipates a layer from the cartographic series to which it belongs, inheriting the series information.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>10</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>10</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerRELorigen</ows:Identifier>
				<ows:Title>Input File REL</ows:Title>
				<ows:Abstract>Is the address and name of the REL to be emanciapted from the cartographic series.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:InputFileREL"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-nod</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ConvREL:Param1:10&amp;Param3</ows:Identifier>
		<ows:Title>Option 10: Liberate cartographic series</ows:Title>
		<ows:Abstract>Liberate cartographic series</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
