<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ConvREL:1</ows:Identifier>
		<ows:Title>From REL4 to DOC/DVC+REL1 (Option 1)</ows:Title>
		<ows:Abstract>Transforms REL4 into doc/dv? + REL1.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversion of layers between MiraMon formats 1 and 4"/>
		<ows:Metadata xlink:title="Abstract: This program transforms the links between tables, metadata and symbols from older versions to the 4/5 version. It also permits the user to return to older versions of the program with more limited features.Option 4 requires MM32.exe version 4.0vt (or a later version) in order to migrate the symbols. The program also permits the fusion of n bands into a single multiband raster (in REL4 format), and the opposite action: the liberation of one or all bands of a multiband (REL4 format) file."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Transform REL4 into doc/dv? + REL1.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDirectori</ows:Identifier>
				<ows:Title>File/Directory</ows:Title>
				<ows:Abstract>Is the name of the layer (not of the REL or the doc/dv?) which one wishes to convert.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:File/Directory"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-nod</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>BACKUP</ows:Identifier>
				<ows:Title>Retain</ows:Title>
				<ows:Abstract>Indicates that it is necessary to retain the doc/dv? and/or save the REL=20 in RE1, RE4 or re4MD5_0 form, depending on the characteristics of the origin file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>Raster multiband</ows:Title>
				<ows:Abstract>For rasters and REL4 conversions (option 4)=20 the program attempts to generate a multiband raster from files with a similar name to the one that is indicated.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SERIE</ows:Identifier>
				<ows:Title>Symbols</ows:Title>
				<ows:Abstract>Also transforms common symbols to a cartographic series. This should be used with care because other layers which also depend on the same series may not open without also being migrated. Applicable only for option 4.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>S</ows:Identifier>
				<ows:Title>Transforms all the files</ows:Title>
				<ows:Abstract>Transforms all the files within the directory 'Directory' and subdirectories. If used with option 4, /SERIE is also needed.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDirectori</ows:Identifier>
				<ows:Title>File/Directory</ows:Title>
				<ows:Abstract>It is the name of the layer (not of the REL or the doc/dv?) which one wishes to convert.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:File/Directory"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-nod</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ConvREL:4</ows:Identifier>
		<ows:Title>From DOC/DVC+REL1 to REL4 (Option 4)</ows:Title>
		<ows:Abstract>Transforms doc/dv? + REL1 into REL4 with version 5 metadata.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Transform doc/dv? + REL1 into REL4 with version 5 metadata.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>4</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDirectori</ows:Identifier>
				<ows:Title>File</ows:Title>
				<ows:Abstract>Is the name of the layer (not of the REL or the doc/dv?) which one wishes to convert.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FileDirectory"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-nod</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>BACKUP</ows:Identifier>
				<ows:Title>Retain</ows:Title>
				<ows:Abstract>Indicates that it is necessary to retain the doc/dv? and/or save the REL=20 in RE1, RE4 or re4MD5_0 form, depending on the characteristics of the origin file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>Raster multibanda</ows:Title>
				<ows:Abstract>For rasters and REL4 conversions (option 4)=20 the program attempts to generate a multiband raster from files with a similar name to the one that is indicated.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SERIE</ows:Identifier>
				<ows:Title>Symbols</ows:Title>
				<ows:Abstract>Also transforms common symbols to a cartographic series. This should be used with care because other layers which also depend on the same series may not open without also being migrated. Applicable only for option 4.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIMBOLITZACIO</ows:Identifier>
				<ows:Title>Prevents the transformation of the symbolization</ows:Title>
				<ows:Abstract>SIMBOLITZACIO=0 Prevents the transformation of the symbolization of a REL or the common simbolization of a cartographic series. Useful in some cases where it is not possible to use the internal call of the MiraMon program. It only applies in option 4.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>S</ows:Identifier>
				<ows:Title>Transforms all the files</ows:Title>
				<ows:Abstract>Transforms all the files within the directory 'Directory' and subdirectories. If used with option 4, /SERIE is also needed.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDirectori</ows:Identifier>
				<ows:Title>File</ows:Title>
				<ows:Abstract>Is the name of the layer (not of the REL or the doc/dv?) which one wishes to convert.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FileDirectory"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-nod</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ConvREL:7</ows:Identifier>
		<ows:Title>From REL5 to REL4.5 (Option 7)</ows:Title>
		<ows:Abstract>Transforms a REL4 with version 5.0 metadata to REL4 with version 4.5. metadata</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>7. Transform an REL4 with version 5.0 metadata into REL4 with version 4.5 metadata.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>7</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>7</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDirectori</ows:Identifier>
				<ows:Title>File</ows:Title>
				<ows:Abstract>Is the name of the layer (not of the REL or the doc/dv?) which one wishes to convert.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FileDirectory"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-nod</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>BACKUP</ows:Identifier>
				<ows:Title>Retain</ows:Title>
				<ows:Abstract>Indicates that it is necessary to retain the doc/dv? and/or save the REL=20 in RE1, RE4 or re4MD5_0 form, depending on the characteristics of the origin file</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>Raster Multiband</ows:Title>
				<ows:Abstract>For rasters and REL4 conversions (option 4)=20 the program attempts to generate a multiband raster from files with a similar name to the one that is indicated.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SERIE</ows:Identifier>
				<ows:Title>Symbols</ows:Title>
				<ows:Abstract>Also transforms common symbols to a cartographic series. This should be used with care because other layers which also depend on the same series may not open without also being migrated. Applicable only for option 4.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIMBOLITZACIO</ows:Identifier>
				<ows:Title>Prevents the transformation of the symbolization</ows:Title>
				<ows:Abstract>SIMBOLITZACIO=0 Prevents the transformation of the symbolization of a REL or the common simbolization of a cartographic series. Useful in some cases where it is not possible to use the internal call of the MiraMon program. It only applies in option 4.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>S</ows:Identifier>
				<ows:Title>Transforms all the files</ows:Title>
				<ows:Abstract>Transforms all the files within the directory 'Directory' and subdirectories. If used with option 4, /SERIE is also needed.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDirectori</ows:Identifier>
				<ows:Title>File</ows:Title>
				<ows:Abstract>Is the name of the layer (not of the REL or the doc/dv?) which one wishes to convert.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FileDirectory"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-nod</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ConvREL:5</ows:Identifier>
		<ows:Title>Multiband REL (option 5)</ows:Title>
		<ows:Abstract>Merge n raster files in a single multiband REL..=20</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Unite n raster files in a single multiband REL.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>5</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>5</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerLlista</ows:Identifier>
				<ows:Title>FileList</ows:Title>
				<ows:Abstract>Is a text file that contains a list of the names of raster files to be fused.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FileList"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>AFEGIR</ows:Identifier>
				<ows:Title>Adds the bands</ows:Title>
				<ows:Abstract> If the REL file selected in /REL=3D exists, this option adds the bands to the existing REL.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SOBRESCRIURE</ows:Identifier>
				<ows:Title>Sobrescrive</ows:Title>
				<ows:Abstract>If a REL option has been selected, it is eliminated and a new file is created with the corresponding fusion of bands.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>REL</ows:Identifier>
				<ows:Title>REL</ows:Title>
				<ows:Abstract>Name of the multiband REL file selected by the user. If not indicated, the program decides the name automatically according to the names of the bands to be fused.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:REL"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
