<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:VecDXF:Param1:1</ows:Identifier>
		<ows:Title>VecDXF</ows:Title>
		<ows:Abstract>Aquesta opció fa la transformació directa de punts i nodes a punts, línies i arcs a polilínies obertes, polígons a polilínies tancades.</ows:Abstract>
<ows:Metadata xlink:title="Title:Conversió de fitxers vectorials de MiraMon a fitxers DXF" />
<ows:Metadata xlink:title="Abstract:Aquest programa fa la conversió de fitxers vectorials estructurats de punts, arcs, polígons o nodes (formats PNT, ARC, POL o NOD) i de fitxers no estructurats de punts, línies o polígons (format VEC) a format DXF, importable per AutoCAD (consulteu la comanda DXFIN en el manual d'AutoCAD) i per altres programes, com ara MicroStation, CorelDraw o MS-Word. També exporta la 3a dimensió si és present en els formats d'origen." />
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>1. Transformació directa:<![CDATA[<li>punts i nodes -> punts</li><li>línies i arcs -> polilínies obertes</li><li>polígons -> polilínies tancades.</li>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerVEC</ows:Identifier>
				<ows:Title>NomFitxerVEC</ows:Title>
				<ows:Abstract>És el nom del fitxer vectorial (PNT,ARC,NOD,POL,VEC) a convertir.</ows:Abstract>
						<ows:Metadata xlink:title="Param2" />
					<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-PNT</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-ARC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-NOD</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-POL</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ESCALAT</ows:Identifier>
				<ows:Title>ESCALAT</ows:Title>
				<ows:Abstract>És l'escalat aplicat a les coordenades X,Y. Per defecte val 1.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_X</ows:Identifier>
				<ows:Title>Desplaçament X</ows:Title>
				<ows:Abstract>És el desplaçament aplicat a les coordenades X. Per defecte val 0.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimals">decimal</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_Y</ows:Identifier>
				<ows:Title>Desplaçament Y</ows:Title>
				<ows:Abstract>És el desplaçament aplicat a les coordenades Y. Per defecte val 0.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_DECIMALS</ows:Identifier>
				<ows:Title>Nombre decimals</ows:Title>
				<ows:Abstract>Nombre de xifres decimals escrites a les coordenades del fitxer DXF de sortida; per defecte val 6.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>6</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>UNICAPA</ows:Identifier>
				<ows:Title>Unicapa</ows:Title>
				<ows:Abstract>Nom de la capa DXF si voleu tots els elements a la mateixa capa. Si no s'indica, l'atribut de cada element serà la seva capa.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TAULA</ows:Identifier>
				<ows:Title>Taula</ows:Title>
				<ows:Abstract>Indiquen el camp de la base de dades que s'exporta com a capa o text al DXF. Per saber més sobre els valors d'aquests paràmetres seguiu les consideracions del document de sintaxi general.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP</ows:Identifier>
				<ows:Title>Camp</ows:Title>
				<ows:Abstract>Indiquen el camp de la base de dades que s'exporta com a capa o text al DXF. Per saber més sobre els valors d'aquests paràmetres seguiu les consideracions del document de sintaxi general.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REPE</ows:Identifier>
				<ows:Title>Repe</ows:Title>
				<ows:Abstract>Indica quin registre escollit quan hi ha més d'un registre per un identificador gràfic (registre múltiple). Per saber més sobre els valors d'aquests paràmetres seguiu les consideracions del document de sintaxi general.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALCADA</ows:Identifier>
				<ows:Title>Alçada</ows:Title>
				<ows:Abstract>Indica quina de les possibles alçades s'escriu en el DXF. Per saber més sobre els valors d'aquest paràmetre seguiu les consideracions del document de sintaxi general.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFitxDXF</ows:Identifier>
				<ows:Title>NomFitxDXF</ows:Title>
				<ows:Abstract>És el nom del fitxer DXF de sortida.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
						<ComplexOutput>
							<Default>
						<Format>
							<MimeType>application/x-DXF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DXF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
							</Supported>
						</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:vecDXF:Param1:2</ows:Identifier>
		<ows:Title>VecDXF text</ows:Title>
		<ows:Abstract>Aquesta opció fa la transformació directa de punts i nodes a punts, línies i arcs a polilínies obertes, polígons a polilínies tancades.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>2. Transforma punts -> textos.</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerVEC</ows:Identifier>
				<ows:Title>NomFitxerVEC</ows:Title>
				<ows:Abstract>És el nom del fitxer vectorial (PNT,ARC,NOD,POL,VEC) a convertir.</ows:Abstract>
						<ows:Metadata xlink:title="Param2" />
					<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-PNT</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-ARC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-NOD</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-POL</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>	
				<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>AlçadaText</ows:Identifier>
				<ows:Title>Alçada Text</ows:Title>
				<ows:Abstract>És la mida del text DXF en unitats mapa</ows:Abstract>
							<ows:Metadata xlink:title="Param4" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ESCALAT</ows:Identifier>
				<ows:Title>ESCALAT</ows:Title>
				<ows:Abstract>És l'escalat aplicat a les coordenades X,Y. Per defecte val 1.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_X</ows:Identifier>
				<ows:Title>Desplaçament X</ows:Title>
				<ows:Abstract>És el desplaçament aplicat a les coordenades X. Per defecte val 0.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimals">decimal</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_Y</ows:Identifier>
				<ows:Title>Desplaçament Y</ows:Title>
				<ows:Abstract>És el desplaçament aplicat a les coordenades Y. Per defecte val 0.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_DECIMALS</ows:Identifier>
				<ows:Title>Nombre decimals</ows:Title>
				<ows:Abstract>Nombre de xifres decimals escrites a les coordenades del fitxer DXF de sortida; per defecte val 6.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>6</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>UNICAPA</ows:Identifier>
				<ows:Title>Unicapa</ows:Title>
				<ows:Abstract>Nom de la capa DXF si voleu tots els elements a la mateixa capa. Si no s'indica, l'atribut de cada element serà la seva capa.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>JOC_CARAC</ows:Identifier>
				<ows:Title>Joc caràcters</ows:Title>
				<ows:Abstract>Joc de caràcters desitjat per als textos; pot ser ANSI-1252 o OEM-850. Per defecte val ANSI-1252.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
					<ows:Value>ANSI-1252</ows:Value>
					<ows:Value>OEM-850</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>ANSI-1252</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TAULA</ows:Identifier>
				<ows:Title>Taula</ows:Title>
				<ows:Abstract>Indiquen el camp de la base de dades que s'exporta com a capa o text al DXF. Per saber més sobre els valors d'aquests paràmetres seguiu les consideracions del document de sintaxi general.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP</ows:Identifier>
				<ows:Title>Camp</ows:Title>
				<ows:Abstract>Indiquen el camp de la base de dades que s'exporta com a capa o text al DXF. Per saber més sobre els valors d'aquests paràmetres seguiu les consideracions del document de sintaxi general.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REPE</ows:Identifier>
				<ows:Title>Repe</ows:Title>
				<ows:Abstract>Indica quin registre escollit quan hi ha més d'un registre per un identificador gràfic (registre múltiple). Per saber més sobre els valors d'aquests paràmetres seguiu les consideracions del document de sintaxi general.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
				<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALCADA</ows:Identifier>
				<ows:Title>Alçada</ows:Title>
				<ows:Abstract>Indica quina de les possibles alçades s'escriu en el DXF. Per saber més sobre els valors d'aquest paràmetre seguiu les consideracions del document de sintaxi general.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFitxDXF</ows:Identifier>
				<ows:Title>NomFitxDXF</ows:Title>
				<ows:Abstract>És el nom del fitxer DXF de sortida.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
						<ComplexOutput>
							<Default>
						<Format>
							<MimeType>application/x-DXF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DXF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
							</Supported>
						</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
