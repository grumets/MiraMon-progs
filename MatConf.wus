<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MatConf:Param3</ows:Identifier>
		<ows:Title>Text</ows:Title>
		<ows:Abstract>This option constructs the 'Confusion Matrix', a two-dimensional table comparing the classified image data with the reference or ground-truth data. The output format is a text file.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Generation of confusion matrices for the evaluation of categorical thematic cartography"/>
		<ows:Metadata xlink:title="Abstract:This program creates a &apos;Confusion Matrix&apos;, a two dimensional table comparing the classified image data with reference to ground truth data. The output format may be a text file or a file in spreadsheet format (CSV)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Referencia</ows:Identifier>
				<ows:Title>Reference</ows:Title>
				<ows:Abstract>Reference is the ground truth raster.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Reference"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Test</ows:Identifier>
				<ows:Title>Test</ows:Title>
				<ows:Abstract>Corresponds to the raster file that is to be evaluated.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Test"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NCOL</ows:Identifier>
				<ows:Title>Columns number</ows:Title>
				<ows:Abstract>Asks for the numerical value for pagination or the maximum size of the report measured in number of columns (categories). This parameter is valid for both types of report.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CATEG_FIXAT</ows:Identifier>
				<ows:Title>Categories of the image</ows:Title>
				<ows:Abstract>Category tesaurus of the ground truth raster determines the number of columns of confusion matrix.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SEPARA</ows:Identifier>
				<ows:Title>Separator</ows:Title>
				<ows:Abstract>Specifies the list separator needed by the spreadsheet file (CSV).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FTXT</ows:Identifier>
				<ows:Title>Text File</ows:Title>
				<ows:Abstract>The name of the text file where the program will write the confusion matrix should be entered.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MatConf:!Param3</ows:Identifier>
		<ows:Title>CSV</ows:Title>
		<ows:Abstract>This option creates the 'Confusion Matrix'  in a  spreadsheet format (CSV).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Referencia</ows:Identifier>
				<ows:Title>Reference</ows:Title>
				<ows:Abstract>Reference is the ground truth raster.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Reference"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Test</ows:Identifier>
				<ows:Title>Test</ows:Title>
				<ows:Abstract>Corresponds to the raster file that is to be evaluated.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Test"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NCOL</ows:Identifier>
				<ows:Title>Columns number</ows:Title>
				<ows:Abstract>Asks for the numerical value for pagination or the maximum size of the report measured in number of columns (categories). This parameter is valid for both types of report.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CATEG_FIXAT</ows:Identifier>
				<ows:Title>Categories of the image</ows:Title>
				<ows:Abstract>Category tesaurus of the ground truth raster determines the number of columns of confusion matrix.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SEPARA</ows:Identifier>
				<ows:Title>Separator</ows:Title>
				<ows:Abstract>Specifies the list separator needed by the spreadsheet file (CSV).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FCSV</ows:Identifier>
				<ows:Title>CSV File</ows:Title>
				<ows:Abstract>The name of the spreadsheet file where the program will write the confusion matrix should be entered.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>