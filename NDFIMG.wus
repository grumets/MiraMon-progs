<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:NDFIMG:1</ows:Identifier>
		<ows:Title>Import from NDF raster format files (satellite images, etc) to MiraMon IMG format</ows:Title>
		<ows:Abstract><![CDATA[This program transforms data from several satellite sensors (<i>e.g.</i>, Enhanced Thematic Mapper Plus, EMT+, Thematic Mapper, TM, Multispectral Scanner System, MSS, etc) of the Landsat series in the NDF format (NLAPS Data Format) of the United States Geological Survey (USGS) as specified in the documents:]]></ows:Abstract>
		<ows:Metadata xlink:title="Title:Import from NDF raster format"/>
		<ows:Metadata xlink:title="Abstract:This program transforms data from several satellite sensors (&lt;i&gt;e.g.&lt;/i&gt;, Enhanced Thematic Mapper Plus, EMT+, Thematic Mapper, TM, Multispectral Scanner System, MSS, etc) of the Landsat series in the NDF format (NLAPS Data Format) of the United States Geological Survey (USGS) as specified in the documents: NATIONAL LAND ARCHIVE PRODUCTION SYSTEM (NLAPS). SYSTEMATIC FORMAT DESCRIPTION DOCUMENT. United States Geological Survey Format Specifications for Geometrically Corrected Landsat Level 1 Digital Data Products (July 2000). &quot;Level 1 Product Output Files. Data Format Control Book&quot;. Volume 5, Book 2. Revision 5. April 2001."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DirectoriEscena</ows:Identifier>
				<ows:Title>Scene folder</ows:Title>
				<ows:Abstract>Is the name of the source folder or directory that contains the LT?.I? files with the images, the LT?.H? files with the headers containing additional information, etc. Typically this directory is called "d:\scene1", where d:" is the CD-ROM unit from where the CD containing the NDF image is to be imported.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:SceneFolder"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CREA_DIR</ows:Identifier>
				<ows:Title>Create directory</ows:Title>
				<ows:Abstract>When set, indicates that the program should create a directory called orbit&amp;image_date within the TargetFolder, so that the resulting files will be created in: TargetFolder\orbit&amp;mage_date.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GeographicIdentifierCode</ows:Identifier>
				<ows:Title>Geographic code</ows:Title>
				<ows:Abstract>Indicates a geographic name to identify the zone, for example "Barcelona Municipal Area". This name is a complement to the horizontal extent contained in the metadata.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>DirectoriDesti</ows:Identifier>
				<ows:Title>Target folder</ows:Title>
				<ows:Abstract>Is the name of the directory which will hold the transformed images. If the optional parameter /CREA_DIR is set the program will create a directory called orbit&amp;image_date within the TargetFolder, so that the resulting files will be created in: TargetFolder\orbit&amp;image_date.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:TargetFolder"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>