<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ZebraIMG:Opcio</ows:Identifier>
		<ows:Title>ZebraIMG</ows:Title>
		<ows:Abstract><![CDATA[Este módulo permite la importación del formato ráster interno del <i>software</i> Zebra al formato propio de MiraMon. Este formato se usa principalmente para imágenes de satélite o radar en ámbitos meteorológicos.<br/>Si desea información sobre las especificaciones de este formato puede acceder a: <a href="https://www.eol.ucar.edu/software-center">https://www.eol.ucar.edu/software-center</a>]]></ows:Abstract>
		<ows:Metadata xlink:title="Title:Importación del formato ráster Zebra (rf)"/>
		<ows:Metadata xlink:title="Abstract:Este módulo permite la importación del formato ráster interno del &lt;i&gt;software&lt;/i&gt; Zebra al formato propio de MiraMon. Este formato se usa principalmente para imágenes de satélite o radar en ámbitos meteorológicos.&lt;br/&gt;Si desea información sobre las especificaciones de este formato puede acceder a: &lt;a href=&quot;https://www.eol.ucar.edu/software-center&quot;&gt;https://www.eol.ucar.edu/software-center&lt;/a&gt;"/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract><![CDATA[<li>1. Si desea que no se reproyecte el ráster original, o sea que se mantenga en el sistema de referencia del fichero RF.</li><li>2. Si desea que se reproyecte a cualquiera de los sistemas de referencia soportados por MiraMon. Hay que identificar correctamente el datum del sistema de referencia origen.</li>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigen</ows:Identifier>
				<ows:Title>Fichero origen</ows:Title>
				<ows:Abstract>Es el ráster origen (se asume extensión rf).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_ORI</ows:Identifier>
				<ows:Title>Sistema origen</ows:Title>
				<ows:Abstract>Indica el identificador del sistema de referencia del fichero RF. Su valor por defecto es aquel sistema de referencia en proyección Zebra (cilíndrica equidistante) identificado como Zebra en la tabla de equivalencias u_idofic.dbf.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Sistema destino</ows:Title>
				<ows:Abstract>Indica el identificador del sistema de referencia del fichero destino. Su valor por defecto se encuentra en la clave RefSystem= de la sección [Metrica] del fichero de configuración MiraMon.par</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDesti</ows:Identifier>
				<ows:Title>Fichero destino</ows:Title>
				<ows:Abstract>Es el ráster resultado.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroDestino"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>