<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Llista</ows:Identifier>
		<ows:Title>Creación de un fichero lista</ows:Title>
		<ows:Abstract>Este programa crea un fichero lista a partir de una lista de ficheros. Esto és útil para programas como Mosaic entre otros.</ows:Abstract>
		<ows:Metadata xlink:title="Module:llista.bat"/>
		<ows:Metadata xlink:title="Title:Creación de un fichero lista"/>
		<ows:Metadata xlink:title="Abstract:Este programa crea un fichero lista a partir de una lista de ficheros. Esto és útil para programas como Mosaic entre otros."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>La lista de ficheros se contruye a partir de nombres de fichero propuestos por la línea de comandos</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1000">
				<ows:Identifier>File</ows:Identifier>
				<ows:Title>Nombre de archivo</ows:Title>
				<ows:Abstract>Un nombre de fichero que debe incluir al fichero lista</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>*/*</MimeType>
							<Encoding>any</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>*/*</MimeType>
							<Encoding>any</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Llista</ows:Identifier>
				<ows:Title>Fichero lista</ows:Title>
				<ows:Abstract>Fichero lista que contendrá la lista de nombres de fichero</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>