<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:0</ows:Identifier>
		<ows:Title>Información (Opción 0)</ows:Title>
		<ows:Abstract>Información sobre un fichero MMZX o un MMZ.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Compresión y descompresión de ficheros MMZX/MMZ (difusión, preservación, etc; versión limitada)"/>
		<ows:Metadata xlink:title="Abstract:Programa para comprimir y descomprimir tanto ficheros MMZ (ficheros de MiraMon comprimidos) como su evolución, los ficheros MMZX."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Información sobre un fichero MMZX o un MMZ.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>Fichero MMZ</ows:Title>
				<ows:Abstract>Es el nombre del fichero comprimido (con o sin extensión) en formato MMZX, MMZ o ZIP.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroMMZ"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OBRIR_NAVEGADOR</ows:Identifier>
				<ows:Title>Abrir el navegador con la información del fichero</ows:Title>
				<ows:Abstract>Mostrar la información del fichero comprimido en el navegador de Internet (además de en pantalla).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESCOMPRIMIR_OPC</ows:Identifier>
				<ows:Title>Descomprimir ficheros OPC</ows:Title>
				<ows:Abstract>Descomprimir ficheros OPC (sólo aplica cuando el fichero a descomprimir es un MMZX).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Stdout</ows:Identifier>
				<ows:Title>Salida estándar</ows:Title>
				<ows:Abstract>Información sobre el archivo MiraMon comprimido.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Stdout"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:1</ows:Identifier>
		<ows:Title>Descomprimir (Opción 1)</ows:Title>
		<ows:Abstract>Descomprimir un fichero MMZX o un MMZ.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Descomprimir un MMZX o un MMZ.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>Fichero MMZ</ows:Title>
				<ows:Abstract>Es el nombre del fichero comprimido (con o sin extensión) en formato MMZX, MMZ o ZIP.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroMMZ"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>US</ows:Identifier>
				<ows:Title>Fundir</ows:Title>
				<ows:Abstract><![CDATA[Sintaxis simplificada según su uso. Se indican tanto al comprimir cómo al descomprimir.<ul><li>BACKUP: Para hacer backup's (copias de seguridad) de mapas o capas y restaurarlos en el mismo sitio.</li><li>INTERNET: Para hacer publicaciones en Internet.</li><li>INTERCANVI: Para  intercambiar datos con otros usuarios.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>BACKUP</ows:Value>
						<ows:Value>INTERNET</ows:Value>
						<ows:Value>INTERCANVI</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REGENERACIO</ows:Identifier>
				<ows:Title>Regeneración</ows:Title>
				<ows:Abstract><![CDATA[Este parámetro hace referencia al método de regeneración del <i>path</i> para descomprimir, ya que es en el momento de comprimir cuando se indica cómo se debe descomprimir. En descomprimir, si no se indica, se toma el valor indicado al comprimir y, si se indica, no se hace caso del criterio preestablecido al comprimir:<ul><li>IDENTICA: El <i>path</i> ha de ser idéntico al informado (valor por defecto al comprimir) (absolutos como absolutos y relativos como relativos a partir del 'directorio de destino').</li><li>IRELATIVA: <i>Path</i> relativo a la unidad del fichero a abrir (por ejemplo el MMM). En esta unidad el <i>path</i> se simplifica tanto cómo sea posible. Se aplica el criterio árbol a partir de directorio para el resto de ficheros que estén en otras unidades de disco o direcciones UNC (ejemplo de dirección UNC: \\servidor\recurso\mapa.mmm).</li><li>ARBRE: El <i>path</i> escribe completo por encima del directorio actual utilizando siempre el criterio árbol a partir de directorio (recomendado en la distribución de información por Internet).</li><li>NO_PATH: Se elimina el <i>path</i> al descomprimir, situándose todos los ficheros en el directorio de destino pero evitando coincidencias de nombres.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>IDENTICA</ows:Value>
						<ows:Value>RELATIVA</ows:Value>
						<ows:Value>ARBRE</ows:Value>
						<ows:Value>NO_PATH</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESCOMPRIMIR_OPC</ows:Identifier>
				<ows:Title>Descomprimir ficheros OPC</ows:Title>
				<ows:Abstract>Descomprimir ficheros OPC (sólo aplica cuando el fichero a descomprimir es un MMZX).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Dir</ows:Identifier>
				<ows:Title>Directorio</ows:Title>
				<ows:Abstract>Es el directorio dentro del cual y a partir del cual se descomprimirán los ficheros. Sólo se indica en la descompresión; es optativo y si no se indica, se usa el directorio de trabajo. Si el mapa se ha comprimido con la opción /US=BACKUP, no se usa.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Dir"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:2</ows:Identifier>
		<ows:Title>Comprimir directorio (Opción 2)</ows:Title>
		<ows:Abstract>Comprimir los ficheros de un directorio (y de los subdirectorios que se indica).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Comprimir los ficheros de un directorio (y de los subdirectorios si se indica).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxersDir</ows:Identifier>
				<ows:Title>Ficheros directorio a comprimir</ows:Title>
				<ows:Abstract>Directorio del cual se extraerán los ficheros a comprimir. Se permite el uso de comodines (usando '*' y '?'). No hace ninguna interpretación especial de los ficheros de MiraMon y, por lo tanto, no sigue sus vínculos.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicherosDir"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>S</ows:Identifier>
				<ows:Title>Subdirectorios</ows:Title>
				<ows:Abstract>Incluir los ficheros de los subdirectorios que pueda haber dentro del directorio.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>US</ows:Identifier>
				<ows:Title>Fundir</ows:Title>
				<ows:Abstract><![CDATA[Sintaxis simplificada según su uso. Se indican tanto al comprimir cómo al descomprimir.<ul><li>BACKUP: Para hacer backup's (copias de seguridad) de mapas o capas y restaurarlos en el mismo sitio.</li><li>INTERNET: Para hacer publicaciones en Internet.</li><li>INTERCANVI: Para  intercambiar datos con otros usuarios.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>BACKUP</ows:Value>
						<ows:Value>INTERNET</ows:Value>
						<ows:Value>INTERCANVI</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REGENERACIO</ows:Identifier>
				<ows:Title>Regeneración</ows:Title>
				<ows:Abstract><![CDATA[Este parámetro hace referencia al método de regeneración del <i>path</i> para descomprimir, ya que es en el momento de comprimir cuando se indica cómo se debe descomprimir. En descomprimir, si no se indica, se toma el valor indicado al comprimir y, si se indica, no se hace caso del criterio preestablecido al comprimir:<ul><li>IDENTICA: El <i>path</i> ha de ser idéntico al informado (valor por defecto al comprimir) (absolutos como absolutos y relativos como relativos a partir del 'directorio de destino').</li><li>IRELATIVA: <i>Path</i> relativo a la unidad del fichero a abrir (por ejemplo el MMM). En esta unidad el <i>path</i> se simplifica tanto cómo sea posible. Se aplica el criterio árbol a partir de directorio para el resto de ficheros que estén en otras unidades de disco o direcciones UNC (ejemplo de dirección UNC: \\servidor\recurso\mapa.mmm).</li><li>ARBRE: El <i>path</i> escribe completo por encima del directorio actual utilizando siempre el criterio árbol a partir de directorio (recomendado en la distribución de información por Internet).</li><li>NO_PATH: Se elimina el <i>path</i> al descomprimir, situándose todos los ficheros en el directorio de destino pero evitando coincidencias de nombres.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>IDENTICA</ows:Value>
						<ows:Value>RELATIVA</ows:Value>
						<ows:Value>ARBRE</ows:Value>
						<ows:Value>NO_PATH</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RELATIU</ows:Identifier>
				<ows:Title>Relativo</ows:Title>
				<ows:Abstract><![CDATA[Si se indica, se guardarán los <i>paths</i> en el interior del fichero como relativos; si no se indica, los <i>paths</i> serán guardados como absolutos. Cómo valor se puede indicar un directorio, y en este caso los <i>paths</i> se mantienen relativos a la posición de este directorio. También se pueden dejar en blanco y el <i>path</i> se simplificará tanto cómo sea posible en la unidad del mapa (.mmm). Las unidades o direcciones UNC diferentes a las de referencia se guardan siempre como a absolutas. (Se debe indicar este parámetro solo al comprimir.)]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ODBC</ows:Identifier>
				<ows:Title>ODBC</ows:Title>
				<ows:Abstract><![CDATA[Indica cómo se comprimirán las bases de datos enlazados vía ODBC (Indiquen este parámetro solo al comprimir). En todas las transformaciones al formato DBF, se utilizará DBF extendida siempre que se produzca una pérdida de información mediante el uso del formato DBF clásico. <ul><li>FBD_A_DBF: Convertir las bases de datos de tipo fichero (p.ej. los ficheros MDB) a DBF antes de comprimir. Si no se indica ni se indica FBD_SRV_A_DBF, se comprimen directamente los ficheros de base de datos en el formato original. En este último caso, si estas bases de datos contienen enlaces a otros ficheros, esta también será comprimida teniendo en cuenta que los vínculos se tendrán que escribir siempre con <i>path</i> relativo.</li><li>SRV_A_DBF: Convertir las bases de datos residentes en el servidor (p.ej Oracle) a DBF antes de comprimir. Si no se indica, o se ha indicado FBD_SRV_A_DBF, este tipo de base de datos no se comprimen, ni tampoco los eventuales enlaces a otros ficheros que puedan contener.</li><li>FBD_SRV_A_DBF: Convertir a DBF los dos tipos de base de datos indicados anteriormente.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>FBD_A_DBF</ows:Value>
						<ows:Value>SRV_A_DBF</ows:Value>
						<ows:Value>FBD_SRV_A_DBF</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SDE</ows:Identifier>
				<ows:Title>ArcSDE/SDO a MiraMon</ows:Title>
				<ows:Abstract><![CDATA[Indica cómo se comprimirán las bases de datos espaciales tipo ArcSDE y/o SDO (se debe indicar este parámetro sólo al comprimir). <ul><li>SDE_A_DBF: Convertir las bases de datos espaciales del ArcSDE/SDO a los formatos de MiraMon antes de comprimir. Si no se indica, este tipo de base de datos no se comprimen, sólo se incluirá el REL y/o los ficheros de conexión.</li></ ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>SDE_A_DBF</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC</ows:Identifier>
				<ows:Title>Ficheros OPC</ows:Title>
				<ows:Abstract>Incluir los ficheros OPC (sólo aplica cuando el fichero a comprimir es un MMZX).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC_THUMBNAIL</ows:Identifier>
				<ows:Title>Vista en miniatura del fichero</ows:Title>
				<ows:Abstract>Imagen en formato JPEG que se quiere usar como vista en miniatura del fichero. Este parámetro resulta ideal para garantizar que todas las hojas de una serie cartográfica presenten la misma previsualización o vista en miniatura. Por defecto, si no se indica este parámetro, se intentará generar una imagen de forma automática a partir de los ficheros abribles en MiraMon, la aplicación invocará MiraMon y generará la impresión del mapa en un pequeño JPEG automáticamente; con un resultado que generalmente será razonable pero, en algunos casos, no satisfactorio. Si se indica el parámetro pero se deja en blanco, no se pondrá ninguna imagen de vista previa (no recomendado). (Sólo aplica cuando el fichero a comprimir es un MMZX).</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAPES_LLINATGE</ows:Identifier>
				<ows:Title>Incluir las capas del linaje</ows:Title>
				<ows:Abstract>Incluir todas las capas que son fuente del linaje de la capa a comprimir (opción no recomendada).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRUP</ows:Identifier>
				<ows:Title>Grupo</ows:Title>
				<ows:Abstract>Nombre de grupo (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>NOMVAR#</ows:Identifier>
				<ows:Title>Nombre variable</ows:Title>
				<ows:Abstract><![CDATA[Nombre de la variable de <i>path</i> (solo al comprimir).]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VALORVAR#</ows:Identifier>
				<ows:Title>Valor variable</ows:Title>
				<ows:Abstract>Valor a sustituir por la variable (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCVAR#</ows:Identifier>
				<ows:Title>Descripción variable</ows:Title>
				<ows:Abstract>Descripción de la variable (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VAR#PATH#</ows:Identifier>
				<ows:Title><![CDATA[Variable <i>path</i>]]></ows:Title>
				<ows:Abstract>Posibles valores alternativos que puede tomar la variable cuando el fichero sea descomprimido (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATAACTUA</ows:Identifier>
				<ows:Title>Fecha actualización</ows:Title>
				<ows:Abstract>Fecha prevista de actualización de la capa. Formato: aaaammdd</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATACADUCA</ows:Identifier>
				<ows:Title>Fecha caducidad</ows:Title>
				<ows:Abstract>Fecha de caducidad de la capa. Formato: aaaammdd</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>UBIC#</ows:Identifier>
				<ows:Title>Ubicación</ows:Title>
				<ows:Abstract>Ubicación de la información actualizada (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCUBIC#</ows:Identifier>
				<ows:Title>Descripción ubicación</ows:Title>
				<ows:Abstract>Descripción de la ubicación de la información actualizada (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>Fichero MMZ</ows:Title>
				<ows:Abstract>Es el nombre del fichero comprimido (con o sin extensión) en formato MMZX, MMZ o ZIP.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroMMZ"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:3</ows:Identifier>
		<ows:Title>Comprimir mapa o capa (Opción 3)</ows:Title>
		<ows:Abstract>Comprimir un MMM o una capa, y todos los ficheros vinculados. Esta opción también permite certificar un MMZX/MMZ que no estaba certificado (solo aplicaciones certificadoras con licencia corporativa MiraMon Internet Map Publisher).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Comprimir un MMM o una capa, y todos sus ficheros vinculados.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMM</ows:Identifier>
				<ows:Title>Fichero MMM</ows:Title>
				<ows:Abstract>Es el fichero a comprimir (con extensión).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroMMM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/j2c</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/ecw</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-msaccess</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>US</ows:Identifier>
				<ows:Title>Modo</ows:Title>
				<ows:Abstract><![CDATA[Sintaxis simplificada según su uso. Se indican tanto al comprimir cómo al descomprimir.<ul><li>BACKUP: Para hacer backup's (copias de seguridad) de mapas o capas y restaurarlos en el mismo sitio.</li><li>INTERNET: Para hacer publicaciones en Internet.</li><li>INTERCANVI: Para  intercambiar datos con otros usuarios.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>BACKUP</ows:Value>
						<ows:Value>INTERNET</ows:Value>
						<ows:Value>INTERCANVI</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>INTERNET</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REGENERACIO</ows:Identifier>
				<ows:Title>Regeneración</ows:Title>
				<ows:Abstract><![CDATA[Este parámetro hace referencia al método de regeneración del <i>path</i> para descomprimir, ya que es en el momento de comprimir cuando se indica cómo se debe descomprimir. En descomprimir, si no se indica, se toma el valor indicado al comprimir y, si se indica, no se hace caso del criterio preestablecido al comprimir:<ul><li>IDENTICA: El <i>path</i> ha de ser idéntico al informado (valor por defecto al comprimir) (absolutos como absolutos y relativos como relativos a partir del 'directorio de destino').</li><li>IRELATIVA: <i>Path</i> relativo a la unidad del fichero a abrir (por ejemplo el MMM). En esta unidad el <i>path</i> se simplifica tanto cómo sea posible. Se aplica el criterio árbol a partir de directorio para el resto de ficheros que estén en otras unidades de disco o direcciones UNC (ejemplo de dirección UNC: \\servidor\recurso\mapa.mmm).</li><li>ARBRE: El <i>path</i> escribe completo por encima del directorio actual utilizando siempre el criterio árbol a partir de directorio (recomendado en la distribución de información por Internet).</li><li>NO_PATH: Se elimina el <i>path</i> al descomprimir, situándose todos los ficheros en el directorio de destino pero evitando coincidencias de nombres.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>IDENTICA</ows:Value>
						<ows:Value>RELATIVA</ows:Value>
						<ows:Value>ARBRE</ows:Value>
						<ows:Value>NO_PATH</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RELATIU</ows:Identifier>
				<ows:Title>Relativo</ows:Title>
				<ows:Abstract><![CDATA[Si se indica, se guardarán los <i>paths</i> en el interior del fichero como relativos; si no se indica, los <i>paths</i> serán guardados como absolutos. Cómo valor se puede indicar un directorio, y en este caso los <i>paths</i> se mantienen relativos a la posición de este directorio. También se pueden dejar en blanco y el <i>path</i> se simplificará tanto cómo sea posible en la unidad del mapa (.mmm). Las unidades o direcciones UNC diferentes a las de referencia se guardan siempre como a absolutas. (Se debe indicar este parámetro solo al comprimir.)]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ODBC</ows:Identifier>
				<ows:Title>ODBC</ows:Title>
				<ows:Abstract><![CDATA[Indica cómo se comprimirán las bases de datos enlazados vía ODBC (Indiquen este parámetro solo al comprimir). En todas las transformaciones al formato DBF, se utilizará DBF extendida siempre que se produzca una pérdida de información mediante el uso del formato DBF clásico. <ul><li>FBD_A_DBF: Convertir las bases de datos de tipo fichero (p.ej. los ficheros MDB) a DBF antes de comprimir. Si no se indica ni se indica FBD_SRV_A_DBF, se comprimen directamente los ficheros de base de datos en el formato original. En este último caso, si estas bases de datos contienen enlaces a otros ficheros, esta también será comprimida teniendo en cuenta que los vínculos se tendrán que escribir siempre con <i>path</i> relativo.</li><li>SRV_A_DBF: Convertir las bases de datos residentes en el servidor (p.ej Oracle) a DBF antes de comprimir. Si no se indica, o se ha indicado FBD_SRV_A_DBF, este tipo de base de datos no se comprimen, ni tampoco los eventuales enlaces a otros ficheros que puedan contener.</li><li>FBD_SRV_A_DBF: Convertir a DBF los dos tipos de base de datos indicados anteriormente.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>FBD_A_DBF</ows:Value>
						<ows:Value>SRV_A_DBF</ows:Value>
						<ows:Value>FBD_SRV_A_DBF</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SDE</ows:Identifier>
				<ows:Title>ArcSDE/SDO a MiraMon</ows:Title>
				<ows:Abstract><![CDATA[Indica cómo se comprimirán las bases de datos espaciales tipo ArcSDE y/o SDO (se debe indicar este parámetro sólo al comprimir). <ul><li>SDE_A_DBF: Convertir las bases de datos espaciales del ArcSDE/SDO a los formatos de MiraMon antes de comprimir. Si no se indica, este tipo de base de datos no se comprimen, sólo se incluirá el REL y/o los ficheros de conexión.</li></ ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>SDE_A_DBF</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC</ows:Identifier>
				<ows:Title>Ficheros OPC</ows:Title>
				<ows:Abstract>Incluir los ficheros OPC (sólo aplica cuando el fichero a comprimir es un MMZX).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC_THUMBNAIL</ows:Identifier>
				<ows:Title>Vista en miniatura del fichero</ows:Title>
				<ows:Abstract>Imagen en formato JPEG que se quiere usar como vista en miniatura del fichero. Este parámetro resulta ideal para garantizar que todas las hojas de una serie cartográfica presenten la misma previsualización o vista en miniatura. Por defecto, si no se indica este parámetro, se intentará generar una imagen de forma automática a partir de los ficheros abribles en MiraMon, la aplicación invocará MiraMon y generará la impresión del mapa en un pequeño JPEG automáticamente; con un resultado que generalmente será razonable pero, en algunos casos, no satisfactorio. Si se indica el parámetro pero se deja en blanco, no se pondrá ninguna imagen de vista previa (no recomendado). (Sólo aplica cuando el fichero a comprimir es un MMZX).</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAPES_LLINATGE</ows:Identifier>
				<ows:Title>Incluir las capas del linaje</ows:Title>
				<ows:Abstract>Incluir todas las capas que son fuente del linaje de la capa a comprimir (opción no recomendada).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CERTIFICAT</ows:Identifier>
				<ows:Title>Certificado</ows:Title>
				<ows:Abstract>Se debe indicar si se quiere certificar los ficheros. Si no se indica nada se sobreentiende que los ficheros no se quieren certificar. Combinado con la opción 3 permite recomprimir y certificar un MMZX o MMZ, o una capa que no estaba certificada. (Solo aplicaciones certificadoras con licencia corporativa MiraMon Internet Map Publisher.).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRUP</ows:Identifier>
				<ows:Title>Grupo</ows:Title>
				<ows:Abstract>Nombre de grupo (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>NOMVAR#</ows:Identifier>
				<ows:Title>Nombre variable</ows:Title>
				<ows:Abstract><![CDATA[Nombre de la variable de <i>path</i> (solo al comprimir).]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VALORVAR#</ows:Identifier>
				<ows:Title>Valor variable</ows:Title>
				<ows:Abstract>Valor a sustituir por la variable (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCVAR#</ows:Identifier>
				<ows:Title>Descripción variable</ows:Title>
				<ows:Abstract>Descripción de la variable (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VAR#PATH#</ows:Identifier>
				<ows:Title><![CDATA[Variable <i>path</i>]]></ows:Title>
				<ows:Abstract>Posibles valores alternativos que puede tomar la variable cuando el fichero sea descomprimido (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATAACTUA</ows:Identifier>
				<ows:Title>Fecha actualización</ows:Title>
				<ows:Abstract>Fecha prevista de actualización de la capa. Formato: aaaammdd</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATACADUCA</ows:Identifier>
				<ows:Title>Fecha caducidad</ows:Title>
				<ows:Abstract>Fecha de caducidad de la capa. Formato: aaaammdd</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>UBIC#</ows:Identifier>
				<ows:Title>Ubicación</ows:Title>
				<ows:Abstract>Ubicación de la información actualizada (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCUBIC#</ows:Identifier>
				<ows:Title>Descripción ubicación</ows:Title>
				<ows:Abstract>Descripción de la ubicación de la información actualizada (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>Fichero MMZ</ows:Title>
				<ows:Abstract>Es el nombre del fichero comprimido (con o sin extensión) en formato MMZX, MMZ o ZIP.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroMMZ"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:4</ows:Identifier>
		<ows:Title>Comprimir MSA (Opción 4)</ows:Title>
		<ows:Abstract>Comprimir una MSA. Opción no destinada a los usuarios finales del programa, sino a las personas que distribuyen una aplicación de soporte al MiraMon.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Comprimir una MSA.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>4</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerEXE</ows:Identifier>
				<ows:Title>Fichero EXE</ows:Title>
				<ows:Abstract>Es el nombre del fichero EXE de una MSA a comprimir (con extensión).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroEXE"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-exe</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-exe</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>US</ows:Identifier>
				<ows:Title>Fundir</ows:Title>
				<ows:Abstract><![CDATA[Sintaxis simplificada según su uso. Se indican tanto al comprimir cómo al descomprimir.<ul><li>BACKUP: Para hacer backup's (copias de seguridad) de mapas o capas y restaurarlos en el mismo sitio.</li><li>INTERNET: Para hacer publicaciones en Internet.</li><li>INTERCANVI: Para  intercambiar datos con otros usuarios.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>BACKUP</ows:Value>
						<ows:Value>INTERNET</ows:Value>
						<ows:Value>INTERCANVI</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REGENERACIO</ows:Identifier>
				<ows:Title>Regeneración</ows:Title>
				<ows:Abstract><![CDATA[Este parámetro hace referencia al método de regeneración del <i>path</i> para descomprimir, ya que es en el momento de comprimir cuando se indica cómo se debe descomprimir. En descomprimir, si no se indica, se toma el valor indicado al comprimir y, si se indica, no se hace caso del criterio preestablecido al comprimir:<ul><li>IDENTICA: El <i>path</i> ha de ser idéntico al informado (valor por defecto al comprimir) (absolutos como absolutos y relativos como relativos a partir del 'directorio de destino').</li><li>IRELATIVA: <i>Path</i> relativo a la unidad del fichero a abrir (por ejemplo el MMM). En esta unidad el <i>path</i> se simplifica tanto cómo sea posible. Se aplica el criterio árbol a partir de directorio para el resto de ficheros que estén en otras unidades de disco o direcciones UNC (ejemplo de dirección UNC: \\servidor\recurso\mapa.mmm).</li><li>ARBRE: El <i>path</i> escribe completo por encima del directorio actual utilizando siempre el criterio árbol a partir de directorio (recomendado en la distribución de información por Internet).</li><li>NO_PATH: Se elimina el <i>path</i> al descomprimir, situándose todos los ficheros en el directorio de destino pero evitando coincidencias de nombres.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>IDENTICA</ows:Value>
						<ows:Value>RELATIVA</ows:Value>
						<ows:Value>ARBRE</ows:Value>
						<ows:Value>NO_PATH</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RELATIU</ows:Identifier>
				<ows:Title>Relativo</ows:Title>
				<ows:Abstract><![CDATA[Si se indica, se guardarán los <i>paths</i> en el interior del fichero como relativos; si no se indica, los <i>paths</i> serán guardados como absolutos. Cómo valor se puede indicar un directorio, y en este caso los <i>paths</i> se mantienen relativos a la posición de este directorio. También se pueden dejar en blanco y el <i>path</i> se simplificará tanto cómo sea posible en la unidad del mapa (.mmm). Las unidades o direcciones UNC diferentes a las de referencia se guardan siempre como a absolutas. (Se debe indicar este parámetro solo al comprimir.)]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ODBC</ows:Identifier>
				<ows:Title>ODBC</ows:Title>
				<ows:Abstract><![CDATA[Indica cómo se comprimirán las bases de datos enlazados vía ODBC (Indiquen este parámetro solo al comprimir). En todas las transformaciones al formato DBF, se utilizará DBF extendida siempre que se produzca una pérdida de información mediante el uso del formato DBF clásico. <ul><li>FBD_A_DBF: Convertir las bases de datos de tipo fichero (p.ej. los ficheros MDB) a DBF antes de comprimir. Si no se indica ni se indica FBD_SRV_A_DBF, se comprimen directamente los ficheros de base de datos en el formato original. En este último caso, si estas bases de datos contienen enlaces a otros ficheros, esta también será comprimida teniendo en cuenta que los vínculos se tendrán que escribir siempre con <i>path</i> relativo.</li><li>SRV_A_DBF: Convertir las bases de datos residentes en el servidor (p.ej Oracle) a DBF antes de comprimir. Si no se indica, o se ha indicado FBD_SRV_A_DBF, este tipo de base de datos no se comprimen, ni tampoco los eventuales enlaces a otros ficheros que puedan contener.</li><li>FBD_SRV_A_DBF: Convertir a DBF los dos tipos de base de datos indicados anteriormente.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>FBD_A_DBF</ows:Value>
						<ows:Value>SRV_A_DBF</ows:Value>
						<ows:Value>FBD_SRV_A_DBF</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SDE</ows:Identifier>
				<ows:Title>ArcSDE/SDO a MiraMon</ows:Title>
				<ows:Abstract><![CDATA[Indica cómo se comprimirán las bases de datos espaciales tipo ArcSDE y/o SDO (se debe indicar este parámetro sólo al comprimir). <ul><li>SDE_A_DBF: Convertir las bases de datos espaciales del ArcSDE/SDO a los formatos de MiraMon antes de comprimir. Si no se indica, este tipo de base de datos no se comprimen, sólo se incluirá el REL y/o los ficheros de conexión.</li></ ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>SDE_A_DBF</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC</ows:Identifier>
				<ows:Title>Ficheros OPC</ows:Title>
				<ows:Abstract>Incluir los ficheros OPC (sólo aplica cuando el fichero a comprimir es un MMZX).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC_THUMBNAIL</ows:Identifier>
				<ows:Title>Vista en miniatura del fichero</ows:Title>
				<ows:Abstract>Imagen en formato JPEG que se quiere usar como vista en miniatura del fichero. Este parámetro resulta ideal para garantizar que todas las hojas de una serie cartográfica presenten la misma previsualización o vista en miniatura. Por defecto, si no se indica este parámetro, se intentará generar una imagen de forma automática a partir de los ficheros abribles en MiraMon, la aplicación invocará MiraMon y generará la impresión del mapa en un pequeño JPEG automáticamente; con un resultado que generalmente será razonable pero, en algunos casos, no satisfactorio. Si se indica el parámetro pero se deja en blanco, no se pondrá ninguna imagen de vista previa (no recomendado). (Sólo aplica cuando el fichero a comprimir es un MMZX).</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAPES_LLINATGE</ows:Identifier>
				<ows:Title>Incluir las capas del linaje</ows:Title>
				<ows:Abstract>Incluir todas las capas que son fuente del linaje de la capa a comprimir (opción no recomendada).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRUP</ows:Identifier>
				<ows:Title>Grupo</ows:Title>
				<ows:Abstract>Nombre de grupo (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>NOMVAR#</ows:Identifier>
				<ows:Title>Nombre variable</ows:Title>
				<ows:Abstract><![CDATA[Nombre de la variable de <i>path</i> (solo al comprimir).]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VALORVAR#</ows:Identifier>
				<ows:Title>Valor variable</ows:Title>
				<ows:Abstract>Valor a sustituir por la variable (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCVAR#</ows:Identifier>
				<ows:Title>Descripción variable</ows:Title>
				<ows:Abstract>Descripción de la variable (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VAR#PATH#</ows:Identifier>
				<ows:Title><![CDATA[Variable <i>path</i>]]></ows:Title>
				<ows:Abstract>Posibles valores alternativos que puede tomar la variable cuando el fichero sea descomprimido (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATAACTUA</ows:Identifier>
				<ows:Title>Fecha actualización</ows:Title>
				<ows:Abstract>Fecha prevista de actualización de la capa. Formato: aaaammdd</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATACADUCA</ows:Identifier>
				<ows:Title>Fecha caducidad</ows:Title>
				<ows:Abstract>Fecha de caducidad de la capa. Formato: aaaammdd</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>UBIC#</ows:Identifier>
				<ows:Title>Ubicación</ows:Title>
				<ows:Abstract>Ubicación de la información actualizada (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCUBIC#</ows:Identifier>
				<ows:Title>Descripción ubicación</ows:Title>
				<ows:Abstract>Descripción de la ubicación de la información actualizada (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>Fichero MMZ</ows:Title>
				<ows:Abstract>Es el nombre del fichero comprimido (con o sin extensión) en formato MMZX, MMZ o ZIP.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroMMZ"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:5</ows:Identifier>
		<ows:Title>Cambio cabecera (Opción 5)</ows:Title>
		<ows:Abstract>Cambio de un valor en la cabecera del fichero. Opción no destinada a los usuarios finales del programa, sino a las personas que desarrollan el MiraMon.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Cambiar un valor en la cabecera del fichero.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>5</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>5</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>Fichero MMZ</ows:Title>
				<ows:Abstract>Es el nombre del fichero comprimido (con o sin extensión) en formato MMZX, MMZ o ZIP.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroMMZ"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>IEntrada</ows:Identifier>
				<ows:Title>Índice de Entrada</ows:Title>
				<ows:Abstract>Es el índice de fichero comprimido al que se cambiará una característica indicada en la cabecera, indexado desde 0.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:IEntrada"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NouValor</ows:Identifier>
				<ows:Title>Nuevo Valor</ows:Title>
				<ows:Abstract>Nuevo valor en la cabecera del fichero MMZX/MMZ. De momento sólo se puede cambiar el parámetro OBERTURA que puede tomar los valores 1 o 0, o marcar el fichero como de la instalación con INST_MM3.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NuevoValor"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>Fichero MMZ</ows:Title>
				<ows:Abstract>Es el nombre del fichero comprimido (con o sin extensión) en formato MMZX, MMZ o ZIP.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroMMZ"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:6</ows:Identifier>
		<ows:Title>Certificatión (Opción 6)</ows:Title>
		<ows:Abstract>Crear certificados de mapas o de capas. Sobrescribe los certificados previos si existiesen.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Crear certificados de ficheros MMM o de capas específicas.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>6</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>6</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMM</ows:Identifier>
				<ows:Title>Fichero MMM</ows:Title>
				<ows:Abstract>Es el fichero a comprimir (con extensión).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroMMM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/j2c</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/ecw</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-msaccess</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMM</ows:Identifier>
				<ows:Title>Fichero MMM</ows:Title>
				<ows:Abstract>Es el fichero a comprimir (con extensión).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroMMM"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/j2c</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/ecw</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-msaccess</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:7</ows:Identifier>
		<ows:Title>Comprimir sin vinculados (Opción 7)</ows:Title>
		<ows:Abstract>Comprimir un MMM o una capa sin incluir los ficheros vinculados. Opción no destinada a los usuarios finales del programa, sino a las personas que hacen desarrollo del MiraMon.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Comprimir un MMM o una capa, pero sin incluir los ficheros vinculados.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>7</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>7</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMM</ows:Identifier>
				<ows:Title>Fichero MMM</ows:Title>
				<ows:Abstract>Es el fichero a comprimir (con extensión).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroMMM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/j2c</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/ecw</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-msaccess</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>US</ows:Identifier>
				<ows:Title>Fundir</ows:Title>
				<ows:Abstract><![CDATA[Sintaxis simplificada según su uso. Se indican tanto al comprimir cómo al descomprimir.<ul><li>BACKUP: Para hacer backup's (copias de seguridad) de mapas o capas y restaurarlos en el mismo sitio.</li><li>INTERNET: Para hacer publicaciones en Internet.</li><li>INTERCANVI: Para  intercambiar datos con otros usuarios.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>BACKUP</ows:Value>
						<ows:Value>INTERNET</ows:Value>
						<ows:Value>INTERCANVI</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REGENERACIO</ows:Identifier>
				<ows:Title>Regeneración</ows:Title>
				<ows:Abstract><![CDATA[Este parámetro hace referencia al método de regeneración del <i>path</i> para descomprimir, ya que es en el momento de comprimir cuando se indica cómo se debe descomprimir. En descomprimir, si no se indica, se toma el valor indicado al comprimir y, si se indica, no se hace caso del criterio preestablecido al comprimir:<ul><li>IDENTICA: El <i>path</i> ha de ser idéntico al informado (valor por defecto al comprimir) (absolutos como absolutos y relativos como relativos a partir del 'directorio de destino').</li><li>IRELATIVA: <i>Path</i> relativo a la unidad del fichero a abrir (por ejemplo el MMM). En esta unidad el <i>path</i> se simplifica tanto cómo sea posible. Se aplica el criterio árbol a partir de directorio para el resto de ficheros que estén en otras unidades de disco o direcciones UNC (ejemplo de dirección UNC: \\servidor\recurso\mapa.mmm).</li><li>ARBRE: El <i>path</i> escribe completo por encima del directorio actual utilizando siempre el criterio árbol a partir de directorio (recomendado en la distribución de información por Internet).</li><li>NO_PATH: Se elimina el <i>path</i> al descomprimir, situándose todos los ficheros en el directorio de destino pero evitando coincidencias de nombres.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>IDENTICA</ows:Value>
						<ows:Value>RELATIVA</ows:Value>
						<ows:Value>ARBRE</ows:Value>
						<ows:Value>NO_PATH</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RELATIU</ows:Identifier>
				<ows:Title>Relativo</ows:Title>
				<ows:Abstract><![CDATA[Si se indica, se guardarán los <i>paths</i> en el interior del fichero como relativos; si no se indica, los <i>paths</i> serán guardados como absolutos. Cómo valor se puede indicar un directorio, y en este caso los <i>paths</i> se mantienen relativos a la posición de este directorio. También se pueden dejar en blanco y el <i>path</i> se simplificará tanto cómo sea posible en la unidad del mapa (.mmm). Las unidades o direcciones UNC diferentes a las de referencia se guardan siempre como a absolutas. (Se debe indicar este parámetro solo al comprimir.)]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SDE</ows:Identifier>
				<ows:Title>ArcSDE/SDO a MiraMon</ows:Title>
				<ows:Abstract><![CDATA[Indica cómo se comprimirán las bases de datos espaciales tipo ArcSDE y/o SDO (se debe indicar este parámetro sólo al comprimir). <ul><li>SDE_A_DBF: Convertir las bases de datos espaciales del ArcSDE/SDO a los formatos de MiraMon antes de comprimir. Si no se indica, este tipo de base de datos no se comprimen, sólo se incluirá el REL y/o los ficheros de conexión.</li></ ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>SDE_A_DBF</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC</ows:Identifier>
				<ows:Title>Ficheros OPC</ows:Title>
				<ows:Abstract>Incluir los ficheros OPC (sólo aplica cuando el fichero a comprimir es un MMZX).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC_THUMBNAIL</ows:Identifier>
				<ows:Title>Vista en miniatura del fichero</ows:Title>
				<ows:Abstract>Imagen en formato JPEG que se quiere usar como vista en miniatura del fichero. Este parámetro resulta ideal para garantizar que todas las hojas de una serie cartográfica presenten la misma previsualización o vista en miniatura. Por defecto, si no se indica este parámetro, se intentará generar una imagen de forma automática a partir de los ficheros abribles en MiraMon, la aplicación invocará MiraMon y generará la impresión del mapa en un pequeño JPEG automáticamente; con un resultado que generalmente será razonable pero, en algunos casos, no satisfactorio. Si se indica el parámetro pero se deja en blanco, no se pondrá ninguna imagen de vista previa (no recomendado). (Sólo aplica cuando el fichero a comprimir es un MMZX).</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAPES_LLINATGE</ows:Identifier>
				<ows:Title>Incluir las capas del linaje</ows:Title>
				<ows:Abstract>Incluir todas las capas que son fuente del linaje de la capa a comprimir (opción no recomendada).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRUP</ows:Identifier>
				<ows:Title>Grupo</ows:Title>
				<ows:Abstract>Nombre de grupo (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>NOMVAR#</ows:Identifier>
				<ows:Title>Nombre variable</ows:Title>
				<ows:Abstract><![CDATA[Nombre de la variable de <i>path</i> (solo al comprimir).]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VALORVAR#</ows:Identifier>
				<ows:Title>Valor variable</ows:Title>
				<ows:Abstract>Valor a sustituir por la variable (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCVAR#</ows:Identifier>
				<ows:Title>Descripción variable</ows:Title>
				<ows:Abstract>Descripción de la variable (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>VAR#PATH#</ows:Identifier>
				<ows:Title><![CDATA[Variable <i>path</i>]]></ows:Title>
				<ows:Abstract>Posibles valores alternativos que puede tomar la variable cuando el fichero sea descomprimido (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATAACTUA</ows:Identifier>
				<ows:Title>Fecha actualización</ows:Title>
				<ows:Abstract>Fecha prevista de actualización de la capa. Formato: aaaammdd</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATACADUCA</ows:Identifier>
				<ows:Title>Fecha caducidad</ows:Title>
				<ows:Abstract>Fecha de caducidad de la capa. Formato: aaaammdd</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#dateTime">dateTime</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>UBIC#</ows:Identifier>
				<ows:Title>Ubicación</ows:Title>
				<ows:Abstract>Ubicación de la información actualizada (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>DESCUBIC#</ows:Identifier>
				<ows:Title>Descripción ubicación</ows:Title>
				<ows:Abstract>Descripción de la ubicación de la información actualizada (solo al comprimir).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMZ</ows:Identifier>
				<ows:Title>Fichero MMZ</ows:Title>
				<ows:Abstract>Es el nombre del fichero comprimido (con o sin extensión) en formato MMZX, MMZ o ZIP.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroMMZ"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-mmz</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/zip</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MMZ:8</ows:Identifier>
		<ows:Title>Preservación (Opción 8)</ows:Title>
		<ows:Abstract>Preservar un mapa o una capa (ya sea en algunos de los formatos propios de MiraMon, Oracle Spatial, SHP, JPG/JPEG o TIF/TIFF), y todos los ficheros vinculados comprimiéndolo en un fichero en formato MMZX.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Comprimir para preservación.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>8</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>8</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>F_Ori</ows:Identifier>
				<ows:Title>Fichero Origen</ows:Title>
				<ows:Abstract>Es el fichero a preservar (con extensión).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:F_Origen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPC_THUMBNAIL</ows:Identifier>
				<ows:Title>Vista en miniatura del fichero</ows:Title>
				<ows:Abstract>Imagen en formato JPEG que se quiere usar como vista en miniatura del fichero. Este parámetro resulta ideal para garantizar que todas las hojas de una serie cartográfica presenten la misma previsualización o vista en miniatura. Por defecto, si no se indica este parámetro, se intentará generar una imagen de forma automática a partir de los ficheros abribles en MiraMon, la aplicación invocará MiraMon y generará la impresión del mapa en un pequeño JPEG automáticamente; con un resultado que generalmente será razonable pero, en algunos casos, no satisfactorio. Si se indica el parámetro pero se deja en blanco, no se pondrá ninguna imagen de vista previa (no recomendado). (Sólo aplica cuando el fichero a comprimir es un MMZX).</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAPES_LLINATGE</ows:Identifier>
				<ows:Title>Incluir las capas del linaje</ows:Title>
				<ows:Abstract>Incluir todas las capas que son fuente del linaje de la capa a comprimir (opción no recomendada).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMZX</ows:Identifier>
				<ows:Title>Fichero MMZX</ows:Title>
				<ows:Abstract>Es el nombre del fichero comprimido (con extensión) en formato MMZX.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroMMZX"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmzx</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>