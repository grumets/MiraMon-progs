<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:RegLog:1</ows:Identifier>
		<ows:Title>MiraMon:RegLog:1</ows:Title>
		<ows:Abstract>MiraMon:RegLog:1</ows:Abstract>
		<ows:Metadata xlink:title="Title:Regresión logística"/>
		<ows:Metadata xlink:title="Abstract:Regresión logística"/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Ajust</ows:Identifier>
				<ows:Title>Opción ajuste.</ows:Title>
				<ows:Abstract>Actualmente solo puede valer 2.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Ajuste"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxMostra</ows:Identifier>
				<ows:Title>Fichero de entrada de la muestra</ows:Title>
				<ows:Abstract>Fichero de entrada correspondiente a los datos de la muestra.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FichMuestra"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-msaccess</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampModel</ows:Identifier>
				<ows:Title>Campo a modelizar (variable dependiente)</ows:Title>
				<ows:Abstract>Campo a modelizar (variable dependiente)</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:CampoModel"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Criteri</ows:Identifier>
				<ows:Title>Criterio</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>0: Todas las variables son independientes</li><li>1: Criterio Deviance</li><li>2: Criterio R<sup>2</sup> Naglekerke</li><li>3: Criterio AIC</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Criterio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Multiregistre</ows:Identifier>
				<ows:Title>Multiregistro</ows:Title>
				<ows:Abstract><![CDATA[Indica cómo tratar los datos multiregistro de entrada: <ul><li>0: Omite el punto.</li><li>1: Escoger el primero.</li><li>2: Calcular el promedio de los valores.</li><li>3: Calcular el sumatorio de los valores.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Multiregistro"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="100">
				<ows:Identifier>FitxVarIndep</ows:Identifier>
				<ows:Title>Ficheros de las variables independientes</ows:Title>
				<ows:Abstract>Ficheros de las variables independientes</ows:Abstract>
				<ows:Metadata xlink:title="Param8"/>
				<ows:Metadata xlink:title="Name:FichVarIndep"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MOSTRA_VALORS_CRITERIS</ows:Identifier>
				<ows:Abstract>Muestra por pantalla información de cada regresión.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMPY</ows:Identifier>
				<ows:Title>Campo seleccionado de las coordenadas Y</ows:Title>
				<ows:Abstract>En caso de pedir la creación de un fichero de puntos a partir de la base de datos de la muestra, es el campo seleccionado de las coordenadas Y.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MASCARA</ows:Identifier>
				<ows:Title>Fichero máscara</ows:Title>
				<ows:Abstract>Fichero máscara</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_MASC</ows:Identifier>
				<ows:Title>Campo de la base de datos escogida</ows:Title>
				<ows:Abstract><![CDATA[Cuando la máscara es un fichero estructurado, indican el campo de la base de datos escogida. Para saber más sobre los valores de estos parámetros siga las consideraciones del documento de <a href="general.htm#TaulaCamp">sintaxis general</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TAULA_MASC</ows:Identifier>
				<ows:Title>Tabla de la base de datos escogida</ows:Title>
				<ows:Abstract><![CDATA[Cuando la máscara es un fichero estructurado, indican el tabla de la base de datos escogida. Para saber más sobre los valores de estos parámetros siga las consideraciones del documento de <a href="general.htm#TaulaCamp">sintaxis general</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPER_MASC</ows:Identifier>
				<ows:Title>Operador de la proyección del campo</ows:Title>
				<ows:Abstract>Operador de la proyección del campo. Solo en caso de que el archivo máscara sea un archivo de polígonos no estructurado.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CONSIDER_NODATA</ows:Identifier>
				<ows:Title>Valor sin datos en máscara</ows:Title>
				<ows:Abstract>En el caso de un fichero máscara, considerar el valor sin datos.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMPX</ows:Identifier>
				<ows:Title>Campo de las coordenadas X</ows:Title>
				<ows:Abstract>En caso de pedir la creación de un fichero de puntos a partir de la base de datos de la muestra, es el campo seleccionado de las coordenadas X.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REFSYSTEM</ows:Identifier>
				<ows:Title>Sistema de referencia del fichero PNT de la base de datos</ows:Title>
				<ows:Abstract>En caso de que se pida crear un fichero PNT a partir de la base de datos de la muestra, es el sistema de referencia seleccionado por ese fichero.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input>
				<ows:Identifier>ATR_MASC</ows:Identifier>
				<ows:Title>Valor seleccionado del archivo máscara</ows:Title>
				<ows:Abstract>Valor seleccionado del archivo máscara. Solo en caso de que el archivo máscara sea un archivo de polígonos no estructurado.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>MDTSortida</ows:Identifier>
				<ows:Title>Fichero MDT de salida</ows:Title>
				<ows:Abstract>Fichero MDT de salida</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:MDTSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>TXTSortida</ows:Identifier>
				<ows:Title>Fichero TXT de salida</ows:Title>
				<ows:Abstract>Fichero TXT de salida</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:TXTSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-ini</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-ini</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>PNTdeBD</ows:Identifier>
				<ows:Title>Fichero PNT a partir de una base de datos</ows:Title>
				<ows:Abstract>En caso de que los datos de la muestra sea una consulta en una base de datos, se puede pedir la creación de un fichero de PNT si también están los identificadores /CAMPX y /CAMPY.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>