				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>5</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>cor</ows:Identifier>
				<ows:Title>Control</ows:Title>
				<ows:Abstract>Es el fichero que contiene los puntos de control en formato COR.</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:FichCor"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>f_i.img</ows:Identifier>
				<ows:Title>Fichero Imagen</ows:Title>
				<ows:Abstract>Es el fichero ráster a corregir (con extensión).</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:FichRasOri"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>int</ows:Identifier>
				<ows:Title>Tipo remuestreo</ows:Title>
				<ows:Abstract><![CDATA[Criterio para decidir el valor del píxel de salida (tipo de remuestreo):<ul><li>0: Vecino más cercano (mapas temáticos; preservar radiometría original).</li><li>1: Interpolación bilineal (imágenes para fotointerpretación; MDE).</li><li>2: Interpolación bicúbica (como 1; resultados suavizados pero más lento).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:Remuestreo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>2</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MDE</ows:Identifier>
				<ows:Title>Modelo Digital de Elevaciones</ows:Title>
				<ows:Abstract>Fichero ráster con el modelo digital de elevaciones de la zona.</ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:MDE"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
