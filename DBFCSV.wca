<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:DBFCSV:Param1:1</ows:Identifier>
		<ows:Title>De DBF a CSV (opció 1)</ows:Title>
		<ows:Abstract>Converteix fitxers des del format DBF (taules dBASE en format DBF clàssica o en DBF estesa) al format CSV (exportació de taules de l'Excel).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversió entre fitxers DBF i CSV"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació converteix fitxers des del format DBF (taules dBASE en format DBF clàssica o en DBF estesa) al format CSV (exportació de taules de l&apos;Excel), i a l&apos;inrevés."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Conversió de DBF a CSV.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigenDBF</ows:Identifier>
				<ows:Title>Fitxer origen</ows:Title>
				<ows:Abstract>Nom del fitxer DBF a convertir.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerOrigenDBF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SEPARA</ows:Identifier>
				<ows:Title>Separador</ows:Title>
				<ows:Abstract><![CDATA[Indica el caràcter que separa les diferents columnes del fitxer CSV. També admet els valors especials <i>TAB</i>, <i>SPA</i> i <i>CAP</i>. El valor per defecte és el punt i coma en la lectura i el tabulador en l'escriptura.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>;</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDestiCSV</ows:Identifier>
				<ows:Title>Fitxer destí</ows:Title>
				<ows:Abstract>Nom del fitxer de sortida CSV.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerDestiCSV"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>CSVWOut</ows:Identifier>
				<ows:Title>Fitxer CSVW de sortida</ows:Title>
				<ows:Abstract>Fitxer CSVW on s'emmagatzemen les metadades del contingut de les dades tabulars del fitxer CSV.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/json</MimeType>
							<Encoding>UTF-8</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/json</MimeType>
							<Encoding>UTF-8</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:DBFCSV:Param1:2</ows:Identifier>
		<ows:Title>De CSV a DBF (opció 2)</ows:Title>
		<ows:Abstract>Converteix fitxers des del format CSV (exportació de taules de l'Excel) al format DBF (taules dBASE en format DBF clàssica o en DBF extesa).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Conversió de CSV a DBF.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampIdGrafic</ows:Identifier>
				<ows:Title>Camp de l'identificador gràfic</ows:Title>
				<ows:Abstract>Val 0 si es vol afegir una columna amb el camp que conté l'identificador gràfic, si existeix, i val 1 en cas contrari.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:CampIdGrafic"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Capcalera</ows:Identifier>
				<ows:Title>Capçalera de la primera fila</ows:Title>
				<ows:Abstract>Val 1 si es vol usar la primera fila del fitxer CSV com a capçalera de la DBF (que conté els noms dels camps de la DBF).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Capçalera"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DBFClassica</ows:Identifier>
				<ows:Title>Restricció a DBF clàssica</ows:Title>
				<ows:Abstract>Val 1 si es vol restringir la conversió de CSV a una DBF no estesa (clàssica), i val 0 si no es desitja aplicar cap restricció. En tal cas, la DBF quedarà correctament marcada (si és estesa es podrà veure a "Informació | Informació de la taula" obrint la taula en el MiraDades).</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:DBFClassica"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigenCSV</ows:Identifier>
				<ows:Title>Fitxer origen</ows:Title>
				<ows:Abstract>Nom del fitxer CSV a convertir.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:FitxerOrigenCSV"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SEPARA</ows:Identifier>
				<ows:Title>Separador</ows:Title>
				<ows:Abstract><![CDATA[Indica el caràcter que separa les diferents columnes del fitxer CSV. També admet els valors especials <i>TAB</i>, <i>SPA</i> i <i>CAP</i>. El valor per defecte és el punt i coma en la lectura i el tabulador en l'escriptura.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>;</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DOBLE_QUALIF</ows:Identifier>
				<ows:Title>Doble qualificador</ows:Title>
				<ows:Abstract><![CDATA[Indica com s'han d'interpretar els dobles qualificadors (<i>""</i>). Admet els valors <i>CARACTER_NORMAL</i> i <i>QUALIF</i>. El valor per defecte és <i>CARACTER_NORMAL</i>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>CARACTER_NORMAL</ows:Value>
						<ows:Value>QUALIF</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>CARACTER_NORMAL</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALIF_TEXT</ows:Identifier>
				<ows:Title>Qualificador de text</ows:Title>
				<ows:Abstract><![CDATA[Indica el caràcter que s'utilitza com a qualificador de text. Admet els valors <i>COMETES</i>, <i>APOSTROF</i>, <i>COMETES_EXCEPTE_SI_TAB</i>, <i>APOSTROF_EXCEPTE_SI_TAB</i> i <i>CAP</i>. El valor per defecte és <i>COMETES_EXCEPTE_SI_TAB</i>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>CAP</ows:Value>
						<ows:Value>APOSTROF</ows:Value>
						<ows:Value>COMETES</ows:Value>
						<ows:Value>APOSTROF_EXCEPTE_SI_TAB</ows:Value>
						<ows:Value>COMETES_EXCEPTE_SI_TAB</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>CAP</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CSVW</ows:Identifier>
				<ows:Title>Fitxer CSVW</ows:Title>
				<ows:Abstract>Fitxer CSVW d'on es llegeixen les metadades del contingut de les dades tabulars del fitxer CSV.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/json</MimeType>
							<Encoding>UTF-8</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/json</MimeType>
							<Encoding>UTF-8</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GENERA_UTF8</ows:Identifier>
				<ows:Title>GENERA_UTF8</ows:Title>
				<ows:Abstract>Permet generar el fitxer DBF en la codificació de caràcters UTF-8.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDestiDBF</ows:Identifier>
				<ows:Title>Fitxer destí</ows:Title>
				<ows:Abstract>Nom del fitxer de sortida DBF.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:FitxerDestiDBF"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>