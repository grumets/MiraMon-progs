<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ANSIOEM:Param4</ows:Identifier>
		<ows:Title>Conversión ANSI-OEM</ows:Title>
		<ows:Abstract>Convierte ficheros de texto plano o en formato DBF entre los conjuntos de caracteres ANSI (Windows) y OEM-850 (DOS), con lo cual es posible visualizarlos y editarlos correctamente tanto desde editores Windows (como el bloc de notas) como MS-DOS (como el EDIT).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Programa para convertir entre ficheros ANSI (Windows) y OEM (MS-DOS) [Juego 850]"/>
		<ows:Metadata xlink:title="Abstract:Este programa convierte ficheros de texto plano o en formato DBF entre los conjuntos de caracteres ANSI (Windows) y OEM-850 (DOS), con lo cual es posible visualizarlos y editarlos correctamente tanto desde editores Windows (como el bloc de notas) como MS-DOS (como el EDIT). Además, y para el caso de los ficheros DBF, el programa permite marcarlos como pertenecientes a cualquiera de los dos conjuntos de caracteres."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigen</ows:Identifier>
				<ows:Title>Fichero Origen</ows:Title>
				<ows:Abstract>Es el nombre del fichero origen con extensión. Si la extensión es DBF sólo se traducirá el contenido de los campos de tipo 'C'. Las otras extensiones se tratan como ficheros de texto y se traducen enteras.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FicheroOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Mode</ows:Identifier>
				<ows:Title>Modo</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>0 ANSI -> OEM-850  (conversión de Borland).</li><li>1 ANSI -> OEM-850 (adaptación Semi-Estricta X. Pons - Recomendada).</li><li>2 ANSI -> OEM-850 (adaptación Estricta X. Pons).</li><li>3 OEM-850 -> ANSI (conversión de Borland)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Modo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Substitut</ows:Identifier>
				<ows:Title>Substituto</ows:Title>
				<ows:Abstract>Es el carácter usado para llenar los caracteres no convertibles (p.ej.: "X", "_").Válido sólo en los modos 1 y 2. Si no se indica se solicitará.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Substituto"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerResultat</ows:Identifier>
				<ows:Title>Fichero Resultado</ows:Title>
				<ows:Abstract>Es el nombre del fichero de destino. Se puede indicar sin extensión y el programa la añade.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroResultado"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ANSIOEM:!Param4</ows:Identifier>
		<ows:Title>Conversión ANSI-OEM BORLAND</ows:Title>
		<ows:Abstract>Hace una conversión tipo "Borland" entre los conjuntos de caracteres ANSI  (Windows) y OEM-850 (DOS).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigen</ows:Identifier>
				<ows:Title>Fichero Origen</ows:Title>
				<ows:Abstract>Es el nombre del fichero origen con extensión. Si la extensión es DBF sólo se traducirá el contenido de los campos de tipo 'C'. Las otras extensiones se tratan como ficheros de texto y se traducen enteras.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FicheroOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Mode</ows:Identifier>
				<ows:Title>Modo</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>0 ANSI -> OEM-850  (conversión de Borland).</li><li>1 ANSI -> OEM-850 (adaptación Semi-Estricta X. Pons - Recomendada).</li><li>2 ANSI -> OEM-850 (adaptación Estricta X. Pons).</li><li>3 OEM-850 -> ANSI (conversión de Borland)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Modo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerResultat</ows:Identifier>
				<ows:Title>Fichero Resultado</ows:Title>
				<ows:Abstract>Es el nombre del fichero de destino. Se puede indicar sin extensión y el programa la añade.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroResultado"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ANSIOEM:!Param3</ows:Identifier>
		<ows:Title>Marcar ANSI-OEM</ows:Title>
		<ows:Abstract><![CDATA[Para el caso de los ficheros DBF, el programa permite marcarlos como OEM-850 (DOS), ANSI u otros juegos de caracteres. Esto resulta especialmente útil cuando se trata de ficheros sin marcaje específico (marcados con el conjunto de caracteres 0), lo cual es habitual en archivos creados con versiones antiguas de dBASE o que provienen de <i>software</i> que genera ficheros DBF sin especificar ningún conjunto de  caracteres en concreto. Debe recordarse, no obstante, que marcar una tabla DBF como perteneciente a un cierto conjunto de caracteres NO significa convertirla, sino simplemente indicar cómo debe interpretarse.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fichero DBF</ows:Title>
				<ows:Abstract>Es el nombre del fichero origen DBF. Sólo se traducirá el contenido de los campos de tipo 'C'. Las otras extensiones se tratan como ficheros de texto y se traducen enteras.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FicheroDBF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>JocCarac</ows:Identifier>
				<ows:Title>Conjunto de  Caracteres</ows:Title>
				<ows:Abstract><![CDATA[Conjunto de caracteres con el cual se quiere marcar el fichero: <ul><li>ANSI</li><li>OEM-850</li><li>cualquier valor decimal [0,255]</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:ConjuntoCarac"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>ANSI</ows:Value>
						<ows:Value>OEM-850</ows:Value>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>255</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fichero DBF</ows:Title>
				<ows:Abstract>Es el nombre del fichero origen DBF. Sólo se traducirá el contenido de los campos de tipo 'C'. Las otras extensiones se tratan como ficheros de texto y se traducen enteras.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FicheroDBF"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>