<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Emancipa:1</ows:Identifier>
		<ows:Title>Emancipa polígonos de los arcos</ows:Title>
		<ows:Abstract>Emancipa los polígonos de los arcos.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Extracción de la base de arcos mínima para un fichero de polígonos"/>
		<ows:Metadata xlink:title="Abstract:Este programa está pensado para trabajar sobre ficheros de polígonos que sólo usan algunos arcos de la base de datos. Un reciclado selectivo (CICLAR 3) o una selección de polígonos hecha desde MiraMon (VECSELEC) generan este tipo de ficheros."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>PolOri</ows:Identifier>
				<ows:Title>Fichero de origen de tipo polígono</ows:Title>
				<ows:Abstract>Nombre del fichero de polígonos a emancipado cuando se desea un duplicado.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FicheroPolOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>PolDest</ows:Identifier>
				<ows:Title>Fichero de destino de tipo polígono</ows:Title>
				<ows:Abstract>Nombre del fichero de polígonos emancipado cuando se desea un duplicado.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroPolDestino"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>ARC_SOURCE</ows:Identifier>
				<ows:Title>Fichero de arcos emancipado</ows:Title>
				<ows:Abstract>Nombre del fichero de arcos emancipado. Si no se indica, se supone igual al FicheroPolDestino.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>