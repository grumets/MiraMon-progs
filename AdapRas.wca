<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:AdapRas:1</ows:Identifier>
		<ows:Title>AdapRas</ows:Title>
		<ows:Abstract><![CDATA[Aquesta aplicació adapta un ràster segons el patró geomètric d'un segon ràster, fins i tot quan el ràster patró té una envolupant més àmplia que el ràster a adaptar. Per a canviar el costat del píxel d'un ràster sense canviar l'origen de la malla cal utilitzar el programa <a href="CanviRes.htm">CanviRes</a>. Per a canviar l'origen de la malla del ràster (sense excedir l'envolupant del ràster original) cal utilitzar el programa <a href="DensRas.htm">DensRas</a>.]]></ows:Abstract>
		<ows:Metadata xlink:title="Title:Adaptació d&apos;un ràster a un altre ràster  (àmbit i costat de cel·la)"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació adapta un ràster segons el patró geomètric d&apos;un segon ràster, fins i tot quan el ràster patró té una envolupant més àmplia que el ràster a adaptar. Per a canviar el costat del píxel d&apos;un ràster sense canviar l&apos;origen de la malla cal utilitzar el programa &lt;a href=&quot;CanviRes.htm&quot;&gt;CanviRes&lt;/a&gt;. Per a canviar l&apos;origen de la malla del ràster (sense excedir l&apos;envolupant del ràster original) cal utilitzar el programa &lt;a href=&quot;DensRas.htm&quot;&gt;DensRas&lt;/a&gt;."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Opció única en aquesta versió del programa. El valor "1" s'ha d'incloure a la sintaxi.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RasterAAdaptar</ows:Identifier>
				<ows:Title>Ràster a adaptar</ows:Title>
				<ows:Abstract>És el nom de l'arxiu ràster a adaptar. S'assumeix que el fitxer té extensió IMG si aquesta no s'indica.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:RasterAAdaptar"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RasterPatroDeLaGeometria</ows:Identifier>
				<ows:Title>Ràster patró de la geometria</ows:Title>
				<ows:Abstract>És el nom de l'arxiu patró de la geometria. S'assumeix que el fitxer té extensió IMG si aquesta no s'indica.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:RasterPatroDeLaGeometria"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusRemostreig</ows:Identifier>
				<ows:Title>Tipus de remostreig</ows:Title>
				<ows:Abstract>Indica el tipus de remostreig: 'V' per veí més proper, 'M' per moda a 4 veïns, 'L' per a interpolació bilineal i 'C' per a bicúbica.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:TipusRemostreig"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>V</ows:Value>
						<ows:Value>M</ows:Value>
						<ows:Value>L</ows:Value>
						<ows:Value>C</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>Valor sensedades</ows:Title>
				<ows:Abstract>El valor sensedades serà igual al valor donat per la persona usuària. Si no s'indica, serà igual al del ràster d'entrada o, si no existeix, al de la taula indicada en este documento.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>RasterResultat</ows:Identifier>
				<ows:Title>Ràster resultat</ows:Title>
				<ows:Abstract>És el nom de l'arxiu resultat. S'assumeix que el fitxer té extensió IMG si aquesta no s'indica.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:RasterResultat"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>