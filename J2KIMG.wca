						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jp2</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
