	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:J2KIMG:Param1:4</ows:Identifier>
		<ows:Title>N IMG</ows:Title>
		<ows:Abstract>Genera n fitxers IMG (amb el nom derivat de PatroFitxers) a partir d'un fitxer JPEG2000 multibanda</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 4</ows:Title>
				<ows:Abstract>Genera n fitxers IMG (amb el nom derivat de PatroFitxers) a partir d'un fitxer JPEG2000 multibanda</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>4</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerJPEG2000</ows:Identifier>
				<ows:Title>Fitxer JPEG2000</ows:Title>
				<ows:Abstract>És el nom del fitxer JPEG2000 a transformar (per a les opcions 1..4) o el resultat de la transformació (opcions 5..11).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerJPEG2000"/>
				<ComplexData>
					<Default>
