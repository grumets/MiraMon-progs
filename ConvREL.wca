	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ConvREL:1:5</ows:Identifier>
		<ows:Title> ConvREL 5</ows:Title>
		<ows:Abstract>Uneix en un sol REL multibanda n fitxers ràster.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Unir en un sol REL multibanda n fitxers ràster.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>5</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerLlista</ows:Identifier>
				<ows:Title>Fitxer Llista</ows:Title>
				<ows:Abstract>És un fitxer de text que conté una llista dels noms de fitxer dels ràsters a fusionar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>AFEGIR</ows:Identifier>
				<ows:Title>Transforma tots els fitxers</ows:Title>
				<ows:Abstract>Si el fitxer REL fixat en /REL= existeix, aquesta opció afegirà les bandes al REL ja existent.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SOBRESCRIURE</ows:Identifier>
				<ows:Title>Sobrescriu</ows:Title>
				<ows:Abstract>S En l'opció de REL fixat, si aquest existeix, l'esborra i en crea un de nou amb la corresponent fusió de bandes.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>REL</ows:Identifier>
				<ows:Title>REL</ows:Title>
				<ows:Abstract>Nom de fitxer REL multibanda fixat per l'usuari. Si no s'indica, el programa decideix el nom de forma automàtica en funció dels noms de bandes a fusionar.
				</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
