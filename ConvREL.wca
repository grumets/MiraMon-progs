	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ConvREL:1:10</ows:Identifier>
		<ows:Title> ConvREL 10</ows:Title>
		<ows:Abstract>Emancipa  una capa de les sèries cartogràfiques a les quals pertany, heretant la informació de la sèrie.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Emancipa una capa de les sèries cartogràfiques a les quals pertany, heretant la informació de la sèrie.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>10</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerRELorigen</ows:Identifier>
				<ows:Title>Fitxer REL</ows:Title>
				<ows:Abstract>Origen és l'adreça i el nom del rel a emancipar de la sèrie cartogràfica.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerRELorigen"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerRELDesti</ows:Identifier>
				<ows:Title>Fitxer REL Destí</ows:Title>
				<ows:Abstract>És l'adreça i el nom del rel de la capa emancipada de la sèrie. És un paràmetre optatiu, en cas de no indicar cap nom de REL destí se sobreescriu el REL d'origen.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerRELDesti"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
