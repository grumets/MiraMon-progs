<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CalcGeo:1</ows:Identifier>
		<ows:Title>CalcGeo</ows:Title>
		<ows:Abstract>Esta aplicación permite convertir las coordenadas de un punto en un determinado sistema de referencia a las coordenadas en otro sistema de referencia.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Calculadora geodésica"/>
		<ows:Metadata xlink:title="Abstract:Esta aplicación permite convertir las coordenadas de un punto en un determinado sistema de referencia a las coordenadas en otro sistema de referencia."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>SistRefOri</ows:Identifier>
				<ows:Title>Sistema de referencia de origen</ows:Title>
				<ows:Abstract>Es el identificador del sistema de referencia origen, en el cual se conocen las coordenadas geográficas.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Sistema_Referencia_Origen"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CoordX</ows:Identifier>
				<ows:Title>Coordenada X</ows:Title>
				<ows:Abstract>Corresponde al valor de la coordenada X o a la longitud en el sistema inicial.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Coordenada_X"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CoordY</ows:Identifier>
				<ows:Title>Coordenada Y</ows:Title>
				<ows:Abstract>Corresponde al valor de la coordenada Y o a la latitud en el sistema inicial.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Coordenada_Y"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>SistRefResult</ows:Identifier>
				<ows:Title>Sistema referencia resultado</ows:Title>
				<ows:Abstract>Es el identificador del sistema de referencia de las coordenadas a calcular. Puede adoptar el valor X, y entonces el programa solicitará en tiempo de ejecución el sistema resultado, o puede dejarse en blanco y entonces el sistema final será aquél descrito en la sección [METRICA] del fichero de parámetros MiraMon.par o, en su defecto, UTM-31N-ETRS89.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Sistema_Referencia_Resultado"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Stdout</ows:Identifier>
				<ows:Title>Coordenadas X e Y resultado de la conversión</ows:Title>
				<ows:Abstract>Texto descriptivo en el que se muestran las coordenadas de entrada en el sistema de referencia inicial y las coordenadas en el sistema de referencia final.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>