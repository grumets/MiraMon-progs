<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Vec2Map:Param1:1</ows:Identifier>
		<ows:Title>Vec2Map</ows:Title>
		<ows:Abstract>Mapa HTML des de VEC</ows:Abstract>
		<ows:Metadata xlink:title="Title:Crear un mapa HTML"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació genera una plana de web amb un mapa sensible a partir d&apos;un fitxer VEC de polígons, POL o PNT i d&apos;una imatge ràster en format GIF o JPG."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 1</ows:Title>
				<ows:Abstract>Generació del mapa HTML a partir d'un fitxer VEC digitalitzat sobre JPEG o GIF sense georeferenciar.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Imatge</ows:Identifier>
				<ows:Title>Imatge</ows:Title>
				<ows:Abstract>És el nom del fitxer ràster GIF o JPG amb extensió que s'incrusta a la plana HTML (En la opció 1 se suposa que hi ha un fitxer VEC de polígons amb el mateix nom).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Imatge"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/gif</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/gif</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomSortida</ows:Identifier>
				<ows:Title>Nom sortida</ows:Title>
				<ows:Abstract>És el nom de fitxer HTML de sortida.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NomSortida"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-html</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-html</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NCols</ows:Identifier>
				<ows:Title>NCols</ows:Title>
				<ows:Abstract>És el nombre de columnes de la imatge.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NCols"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NFils</ows:Identifier>
				<ows:Title>NFils</ows:Title>
				<ows:Abstract>És el nombre de files de la imatge.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:NFils"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Vec2Map:Param1:2</ows:Identifier>
		<ows:Title>Vec2Map</ows:Title>
		<ows:Abstract>Mapa HTML des de POL</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 2</ows:Title>
				<ows:Abstract>Generació del mapa HTML a partir d'un fitxer POL i un JPEG georeferenciat.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDePoligons</ows:Identifier>
				<ows:Title>Fitxer de polígons</ows:Title>
				<ows:Abstract>És el nom del fitxer vectorial estructurat POL.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerDePoligons"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Imatge</ows:Identifier>
				<ows:Title>Imatge</ows:Title>
				<ows:Abstract>És el nom del fitxer ràster GIF o JPG amb extensió que s'incrusta a la plana HTML (En la opció 1 se suposa que hi ha un fitxer VEC de polígons amb el mateix nom).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Imatge"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/gif</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/gif</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomSortida</ows:Identifier>
				<ows:Title>Nom sortida</ows:Title>
				<ows:Abstract>És el nom de fitxer HTML de sortida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NomSortida"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-html</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-html</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TOLERANCIA</ows:Identifier>
				<ows:Title>TOLERANCIA</ows:Title>
				<ows:Abstract>Fa referència a la tolerància considerada per eliminar redundància de vèrtexs propers i així fer més lleuger el fitxer HTML. El seu valor per defecte és 3.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ID</ows:Identifier>
				<ows:Title>ID</ows:Title>
				<ows:Abstract>Fa referència a la propietat id de cada àrea sensible. Exemple: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>HREF</ows:Identifier>
				<ows:Title>HREF</ows:Title>
				<ows:Abstract>Fa referència a la propietat href de cada àrea sensible. Exemple: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TITLE</ows:Identifier>
				<ows:Title>TITLE</ows:Title>
				<ows:Abstract>Fa referència a la propietat title de cada àrea sensible. Exemple: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALT</ows:Identifier>
				<ows:Title>ALT</ows:Title>
				<ows:Abstract>Fa referència a la propietat alt de cada àrea sensible. Exemple: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ONCLICK</ows:Identifier>
				<ows:Title>ONCLICK</ows:Title>
				<ows:Abstract>Fa referència a la propietat onclick de cada àrea sensible. Exemple: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ONDBLCLICK</ows:Identifier>
				<ows:Title>ONDBLCLICK</ows:Title>
				<ows:Abstract>Fa referència a la propietat ondblclick de cada àrea sensible. Exemple: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ONMOUSEOVER</ows:Identifier>
				<ows:Title>ONMOUSEOVER</ows:Title>
				<ows:Abstract>Fa referència a la propietat onmouseover de cada àrea sensible. Exemple: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Vec2Map:Param1:3</ows:Identifier>
		<ows:Title>Vec2Map</ows:Title>
		<ows:Abstract>Mapa HTML des de PNT</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 3</ows:Title>
				<ows:Abstract>Generació del mapa HTML a partir d'un fitxer PNT.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDePunts</ows:Identifier>
				<ows:Title>Fitxer de punts</ows:Title>
				<ows:Abstract>És el nom del fitxer vectorial estructurat PNT.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerDePunts"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Imatge</ows:Identifier>
				<ows:Title>Imatge</ows:Title>
				<ows:Abstract>És el nom del fitxer ràster GIF o JPG amb extensió que s'incrusta a la plana HTML (En la opció 1 se suposa que hi ha un fitxer VEC de polígons amb el mateix nom).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Imatge"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/gif</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/gif</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomSortida</ows:Identifier>
				<ows:Title>Nom sortida</ows:Title>
				<ows:Abstract>És el nom de fitxer HTML de sortida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NomSortida"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-html</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-html</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Amplada</ows:Identifier>
				<ows:Title>Amplada</ows:Title>
				<ows:Abstract>Amplada en píxels del rectangle de l'àrea shape.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Amplada"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Alcada</ows:Identifier>
				<ows:Title>Alçada</ows:Title>
				<ows:Abstract>Alçada en píxels del rectangle de l'àrea shape.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:Alçada"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Orientacio</ows:Identifier>
				<ows:Title>Orientació</ows:Title>
				<ows:Abstract>1: NW; 2: NE; 3: SW; 4: SE; 5: C.</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:Orientació"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ID</ows:Identifier>
				<ows:Title>ID</ows:Title>
				<ows:Abstract>Fa referència a la propietat id de cada àrea sensible. Exemple: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>HREF</ows:Identifier>
				<ows:Title>HREF</ows:Title>
				<ows:Abstract>Fa referència a la propietat href de cada àrea sensible. Exemple: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TITLE</ows:Identifier>
				<ows:Title>TITLE</ows:Title>
				<ows:Abstract>Fa referència a la propietat title de cada àrea sensible. Exemple: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALT</ows:Identifier>
				<ows:Title>ALT</ows:Title>
				<ows:Abstract>Fa referència a la propietat alt de cada àrea sensible. Exemple: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ONCLICK</ows:Identifier>
				<ows:Title>ONCLICK</ows:Title>
				<ows:Abstract>Fa referència a la propietat onclick de cada àrea sensible. Exemple: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ONDBLCLICK</ows:Identifier>
				<ows:Title>ONDBLCLICK</ows:Title>
				<ows:Abstract>Fa referència a la propietat ondblclick de cada àrea sensible. Exemple: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ONMOUSEOVER</ows:Identifier>
				<ows:Title>ONMOUSEOVER</ows:Title>
				<ows:Abstract>Fa referència a la propietat onmouseover de cada àrea sensible. Exemple: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>