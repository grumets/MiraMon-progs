<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CreaMMM:1</ows:Identifier>
		<ows:Title>Crear mapa (opció 1)</ows:Title>
		<ows:Abstract>Programa per a crear un mapa de MiraMon (format MMM) de manera ràpida i en línia de comanda, on el nombre i ordre de les capes és constant però canvien els noms de les capes.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Creació automàtica de mapes i sèries cartogràfiques" />
		<ows:Metadata xlink:title="Abstract:Programa per a crear mapes de MiraMon (format MMM) de manera ràpida i en línia de comanda." />
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>1. Els noms de les capes i alguns paràmetres de visualització s'indiquen en línia de comanda.</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer "> integer</ows:DataType>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>					
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PlantillaMMM</ows:Identifier>
				<ows:Title>Plantilla MMM</ows:Title>
				<ows:Abstract>Mapa de MiraMon que serveix de plantilla per tot allò que no genera el programa. Si no es vol plantilla es pot indicar NUL (només a l'opció 1).</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Capes</ows:Identifier>
				<ows:Title>Capes</ows:Title>
				<ows:Abstract>Nom de la capa. El patró "Capa Paleta PaletaInterior" poy repetir-se tantes vegades como capes a incloure</ows:Abstract>
				<ows:Metadata xlink:title="Param4" />
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
							<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Paleta</ows:Identifier>
				<ows:Title>Paleta</ows:Title>
				<ows:Abstract>Paleta de colors, un color RGB (3 números separats per coma sense espais) o NUL si no es requereix paleta.</ows:Abstract>
				<ows:Metadata xlink:title="Param5" />
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<DefaultValue>NUL</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PaletaInterior</ows:Identifier>
				<ows:Title>Paleta per omplir interiors</ows:Title>
				<ows:Abstract>Paleta de colors per omplir l'interior de polígons, un color RGB (3 números separats per coma sense espais) o NUL si no es requereix paleta.</ows:Abstract>
				<ows:Metadata xlink:title="Param6" />
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<DefaultValue>NUL</DefaultValue>
				</LiteralData>			
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TITOL</ows:Identifier>
				<ows:Title>Titol</ows:Title>
				<ows:Abstract>És el títol del mapa. Si no s'indica, es pren del títol de la primera capa. 
				</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VERIFICA</ows:Identifier>
				<ows:Title>Verifica</ows:Title>
				<ows:Abstract>Indica que cal verificar l'existència de la capa. En l'opció 1, i en cas de haver-hi plantilla, el programa plega; si no hi ha plantilla el programa es queixa però es deixa continuar; pels fitxers de tipus VEC, el programa verifica sempre l'existència del fitxer i plega si no el troba perquè necessita llegir el fitxer de documentació per identificar-ne el tipus.
				</ows:Abstract>
					<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues><ows:Value>##blank##</ows:Value></ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NouMMM</ows:Identifier>
				<ows:Title>Nou MMM</ows:Title>
				<ows:Abstract>És el mapa de MiraMon a crear. 
				</ows:Abstract>
				<ows:Metadata xlink:title="Param2" />
						<ComplexOutput>
							<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CreaMMM:2</ows:Identifier>
		<ows:Title>Crear séries de mapes (opció 2)</ows:Title>
		<ows:Abstract>Opció pensada per treballar amb cartogràfiques on els noms de fitxers són fixos (canviant el directori o les primeres lletres del nom, per exemple per a indicar el full de què es tracta) però poden faltar algunes capes per alguns mapes de la sèrie (per exemple un full petit on no apareix cap línia elèctrica).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 2</ows:Title>
				<ows:Abstract>2. Els noms de les capes i alguns paràmetres de visualització s'indiquen en línia de comanda.</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer "> integer</ows:DataType>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>		
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PlantillaMMM</ows:Identifier>
				<ows:Title>Plantilla MMM</ows:Title>
				<ows:Abstract>Mapa de MiraMon que serveix de plantilla per tot allò que no genera el programa. Si no es vol plantilla es pot indicar NUL (només a l'opció 1).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TextABuscar</ows:Identifier>
				<ows:Title>Text a buscar</ows:Title>
				<ows:Abstract>Text a buscar dins el path del nom de la capa en el mapa plantilla. Si no desitgeu buscar res, indiqueu una cadena impossible de trobar.
				</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TextSubstituit</ows:Identifier>
				<ows:Title>Text Substituït</ows:Title>
				<ows:Abstract>Text substituït dins el path del nom de la capa en el nou mapa. 
				</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TITOL</ows:Identifier>
				<ows:Title>Titol</ows:Title>
				<ows:Abstract>És el títol del mapa. Si no s'indica, es pren del títol de la primera capa. 
				</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VERIFICA</ows:Identifier>
				<ows:Title>Verifica</ows:Title>
				<ows:Abstract>Indica que cal verificar l'existència de la capa. En l'opció 2, si la capa no existeix no s'inclou en el mapa i es continua. 
				</ows:Abstract>
				<LiteralData>
					<ows:AllowedValues>	<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType><ows:Value>##blank##</ows:Value></ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NouMMM</ows:Identifier>
				<ows:Title>Nou MMM</ows:Title>
				<ows:Abstract>És el mapa de MiraMon a crear. 
				</ows:Abstract>
				<ows:Metadata xlink:title="Param2" />
						<ComplexOutput>
							<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>	
</wps:ProcessDescriptions>
