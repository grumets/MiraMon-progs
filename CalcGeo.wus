<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CalcGeo:1</ows:Identifier>
		<ows:Title>CalcGeo</ows:Title>
		<ows:Abstract>This application allows the conversion of the coordinates of a point in a given reference system to the coordinates in another reference system.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Geodetic Calculator"/>
		<ows:Metadata xlink:title="Abstract:This application allows the conversion of the coordinates of a point in a given reference system to the coordinates in another reference system."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>SistRefOri</ows:Identifier>
				<ows:Title>Origin Reference System</ows:Title>
				<ows:Abstract>It is the origin reference system identifier, in which the geographic coordinates are known.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Origin_Reference_System"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CoordX</ows:Identifier>
				<ows:Title>X Coordinate</ows:Title>
				<ows:Abstract>Corresponds to the value of the X coordinate or to the longitude in the initial system.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:X_Coordinate"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CoordY</ows:Identifier>
				<ows:Title>Y Coordinate</ows:Title>
				<ows:Abstract>Corresponds to the value of the Y coordinate or to the latitude in the initial system.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Y_Coordinate"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>SistRefResult</ows:Identifier>
				<ows:Title>Result Reference System</ows:Title>
				<ows:Abstract>t is the identifier of the reference system of the coordinates to calculate. The X value will be adopted and then, the program will request the result system at runtime, or it can be left blank and then the final system will be the one described in the [METRICA] section of the MiraMon.par parameter file or, alternatively, UTM-31N-ETRS89.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Result_Reference_System"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Stdout</ows:Identifier>
				<ows:Title>X and Y coordinates result from the conversion</ows:Title>
				<ows:Abstract>Descriptive text showing the input coordinates in the initial reference system and the coordinates in the final reference system.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>