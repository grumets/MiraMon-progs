<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:IMGASCII:1</ows:Identifier>
		<ows:Title>IMGASCII</ows:Title>
		<ows:Abstract>This application generates an ASCII text file from a MiraMon raster format file: img+i.rel in version 4 or img+doc in previous versions.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Export to ASCII format from MiraMon raster"/>
		<ows:Metadata xlink:title="Abstract:This application generates an ASCII text file from a MiraMon raster format file: img+i.rel in version 4 or img+doc in previous versions."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract><![CDATA[Indicates the format of the ASCII file to be generated:<ul><li>1: [Values ...]</li><li>2: [X_Coordinate Y_Coordinate Raster_value ...].</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigen</ows:Identifier>
				<ows:Title>Input File</ows:Title>
				<ows:Abstract>Is the IMG file to be exported.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_DEC_VAL</ows:Identifier>
				<ows:Title>Decimal places</ows:Title>
				<ows:Abstract>Defines the number of decimal places for the raster values when these are real data. The default value is defined by the DigitsDecimals= key of the [MiraMon] section of the MiraMon.par configuration file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_DEC_POS</ows:Identifier>
				<ows:Title>Coordinates decimal places</ows:Title>
				<ows:Abstract>Defines the number of decimal places for the coordinates when this needs to be defined. The default value is defined by the DigitsDecimals= key of the [MiraMon] section of the MiraMon.par configuration file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAPCALERA</ows:Identifier>
				<ows:Title>Header</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>1 If the user wishes to export the extents (envelope and pixel side) of the input file to a header in the output file.</li><li>2 If the user wishes to export all the information in the documentation file of the input raster to a header in the output file.</li><li>3 It allows you to export IMG rasters to ASCII format, suitable for ArcView, ArcCatalog y ArcMap.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDesti</ows:Identifier>
				<ows:Title>Output File</ows:Title>
				<ows:Abstract>Is the output ASCII file. If an extension is desired this must be specified.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-ASCII</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-ASCII</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>