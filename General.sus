/*Taules_simbol_s_han_tenir_camps,    "Tables of symbolization for %s must have at least the following fields:\n\n* \"CLAUSIMBOL\" (key field to be linked) type 'C' or 'N'\n      (or \"MIN_SIMBOL\" and \"MAX_SIMBOL\" for\n      fields 'N' indicating numerical ranges)\n\n"*/
Taules_simbol_s_han_tenir_camps,    "Tables of symbolization for %s must have at least the following fields:\n\n* \"CLAUSIMBOL\" (key field to be linked) type 'C' or 'N'\n\n"
Taules_colors_han_tenir_camps,      "* \"R_COLOR\", \"G_COLOR\" and \"B_COLOR\" (intensities\n      Red,Green,Blue in the range [0,255]) type 'N'\n\n* \"DESCRIPCIO\" (description to be used in the legend) type 'C'\n      (optional)"
Taules_trames_han_tenir_camps,      "* \"TIPUSTRAMA\" (valid examples\n      \"-\",\"/\",\"|\",\"\\\",\"+\",\"X\",\"\") type 'C'\n\n* \"DESCRIPCIO\" (description to be used in the legend) type 'C'\n      (optional)"
Taules_patrons_han_tenir_camps,     "* \"FI_PATR\" (file name for each pattern, typicaly in BMP format) type 'C'\n\n* \"DESCRIPCIO\" (description to be used in the legend) type 'C'\n      (optional)"
Taules_simbols_han_tenir_camps,     "* \"FI_SIMBOL\" (file name for each symbol) type 'C'\n\n* \"DESCRIPCIO\" (description to be used in the legend) type 'C'\n      (optional)"  
Taules_fonts_han_tenir_camps,       "* \"FONT\" (Font description, for example \"/NArial/H8/B/I/C0,0,255/K255,255,0/h\") 'C' type\n\n* \"TEXT_FONT\" (example text to be used in the legend) 'C' type\n\n* \"DESCRIPCIO\" (description to be used in the legend) 'C' type"
Taules_lin_comb_han_tenir_camps,    "* \"LIN_COMBIN\" (Combined line, description, for example \"/M/KA;/H25/C0,255,255;/N3/H7.5/C255,255,255\") tipus 'C'\n\n* \"DESCRIPCIO\" (description to be used in the legend) type 'C'\n      (optional)"

