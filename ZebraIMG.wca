<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ZebraIMG:Opcio</ows:Identifier>
		<ows:Title>ZebraIMG</ows:Title>
		<ows:Abstract><![CDATA[Aquesta aplicació permet la importació del format ràster intern del <i>software</i> Zebra al format propi del MiraMon. Aquest format és usat principalment per a imatges de satèl·lit o radar en àmbits meteorològics.<br/>Si desitgeu informació sobre les especificacions d'aquest format podeu accedir a: <a href="https://www.eol.ucar.edu/software-center">https://www.eol.ucar.edu/software-center</a>]]></ows:Abstract>
		<ows:Metadata xlink:title="Title:Importació del format ràster Zebra (rf)"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació permet la importació del format ràster intern del &lt;i&gt;software&lt;/i&gt; Zebra al format propi del MiraMon. Aquest format és usat principalment per a imatges de satèl·lit o radar en àmbits meteorològics.&lt;br/&gt;Si desitgeu informació sobre les especificacions d&apos;aquest format podeu accedir a: &lt;a href=&quot;https://www.eol.ucar.edu/software-center&quot;&gt;https://www.eol.ucar.edu/software-center&lt;/a&gt;"/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract><![CDATA[<li>1. si desitgeu que no es reprojecti el ràster original, o sigui que es mantingui en el sistema de referència del fitxer RF.</li><li>2. si desitgeu que es reprojecti a qualsevol dels sistemes de referència suportats per MiraMon. Cal identificar correctament el dàtum del sistema de referència origen.</li>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigen</ows:Identifier>
				<ows:Title>Fitxer origen</ows:Title>
				<ows:Abstract>És el ràster origen (s'assumex extensió rf).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_ORI</ows:Identifier>
				<ows:Title>Sistema origen</ows:Title>
				<ows:Abstract>Indica l'identificador del sistema de referència del fitxer RF. El seu valor per defecte és aquell sistema de referència en projecció Zebra (cilíndrica equidistant) identificat com a Zebra a la taula d'equivalències u_idofic.dbf.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Sistema destí</ows:Title>
				<ows:Abstract>Indica l'identificador del sistema de referència del fitxer destí. El seu valor per defecte és el corresponent a la clau RefSystem= de la secció [Metrica] del fitxer de configuració MiraMon.par</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDesti</ows:Identifier>
				<ows:Title>Fitxer destí</ows:Title>
				<ows:Abstract>És el ràster resultat.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerDesti"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>