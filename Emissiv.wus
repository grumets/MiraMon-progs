<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Emissiv:Param01:0</ows:Identifier>
		<ows:Title>NDVI threshold method</ows:Title>
		<ows:Abstract>This option calculates the emissivity using the NDVI threshold method (Sobrino 2000).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Emissivity calculation"/>
		<ows:Metadata xlink:title="Abstract:This module calculates the emissivity from a red band and an infrared band. A mask can be added for the water (value &quot;1&quot;) and snow areas (value &quot;2&quot;)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Calculation of the emissivity by the NDVI threshold method (Sobrino 2000).</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaVermella</ows:Identifier>
				<ows:Title>Red band</ows:Title>
				<ows:Abstract>Input red band file.</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:RedBand"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaNIR</ows:Identifier>
				<ows:Title>Near infrared band (NIR)</ows:Title>
				<ows:Abstract>Input near infrared band file.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:NIRBand"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NDVIv</ows:Identifier>
				<ows:Title>NDVI vegetation</ows:Title>
				<ows:Abstract>NDVI value of a pixel covered in vegetation.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:NDVIv"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NDVIs</ows:Identifier>
				<ows:Title>NDVI bare soil</ows:Title>
				<ows:Abstract>NDVI value of bare soil pixel.</ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:NDVIs"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MASCARA</ows:Identifier>
				<ows:Title>Mask</ows:Title>
				<ows:Abstract>Water and snow mask file. This is an optional parameter and must be added "/MASCARA=" before the file location.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerEmis</ows:Identifier>
				<ows:Title>Emissivity</ows:Title>
				<ows:Abstract>Output file of the result of the emissivity calculation.</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:EmisFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Emissiv:Param01:1</ows:Identifier>
		<ows:Title>Continuous method</ows:Title>
		<ows:Abstract>This option calculates the emissivity using the continuous method (Valor and Casselles 2005).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Calculation of the emissivity by the continuous method (Valor and Casselles 2005).</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaVermella</ows:Identifier>
				<ows:Title>Red band</ows:Title>
				<ows:Abstract>Input red band file.</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:RedBand"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaNIR</ows:Identifier>
				<ows:Title>Near infrared band (NIR)</ows:Title>
				<ows:Abstract>Input near infrared band file.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:NIRBand"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>e_iv</ows:Identifier>
				<ows:Title>e_iv</ows:Title>
				<ows:Abstract>Emissivity of a pixel covered with vegetation.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:e_iv"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>e_is</ows:Identifier>
				<ows:Title>e_is</ows:Title>
				<ows:Abstract>Emissivity of a bare soil pixel.</ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:e_is"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ig</ows:Identifier>
				<ows:Title>ig</ows:Title>
				<ows:Abstract>NDVI value (to option 1) for a bare soil pixel.</ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:ig"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>iv</ows:Identifier>
				<ows:Title>iv</ows:Title>
				<ows:Abstract>NDVI value (to option 1) for a pixel covered in vegetation.</ows:Abstract>
				<ows:Metadata xlink:title="Param08"/>
				<ows:Metadata xlink:title="Name:iv"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>r4v</ows:Identifier>
				<ows:Title>r4v</ows:Title>
				<ows:Abstract>Reflectance of a pixel in the near infrared band covered with vegetation.</ows:Abstract>
				<ows:Metadata xlink:title="Param09"/>
				<ows:Metadata xlink:title="Name:r4v"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>r3v</ows:Identifier>
				<ows:Title>r3v</ows:Title>
				<ows:Abstract>Reflectance of a pixel in the red band completely covered with vegetation.</ows:Abstract>
				<ows:Metadata xlink:title="Param10"/>
				<ows:Metadata xlink:title="Name:r3v"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>r4s</ows:Identifier>
				<ows:Title>r4s</ows:Title>
				<ows:Abstract>Reflectance of a pixel in the near infrared band of bare soil.</ows:Abstract>
				<ows:Metadata xlink:title="Param11"/>
				<ows:Metadata xlink:title="Name:r4s"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>r3s</ows:Identifier>
				<ows:Title>r3s</ows:Title>
				<ows:Abstract>Reflectance of a pixel in the red band of bare soil.</ows:Abstract>
				<ows:Metadata xlink:title="Param12"/>
				<ows:Metadata xlink:title="Name:r3s"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MASCARA</ows:Identifier>
				<ows:Title>Mask</ows:Title>
				<ows:Abstract>Water and snow mask file. This is an optional parameter and must be added "/MASCARA=" before the file location.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerEmis</ows:Identifier>
				<ows:Title>Emissivity</ows:Title>
				<ows:Abstract>Output file of the result of the emissivity calculation.</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:EmisFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>