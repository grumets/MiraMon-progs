	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:BMPIMG:Param1:2&!Param5</ows:Identifier>
		<ows:Title>BMPIMG</ows:Title>
		<ows:Abstract>Importa un fitxer BMP a un fitxer IMG, d'1 bit o de 8 bits amb o sense paleta.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract><![CDATA[Importa un fitxer BMP a un fitxer IMG, en funció de les propietats del fitxer d'entrada BMP:<ul><li>Importació d'un BMP a IMG. Si el BMP és d'1 bit o de 8 bits sense paleta, cal donar només els noms del fitxer d'entrada BMP i del fitxer de sortida IMG, ja que no es genera cap fitxer DBF (paleta). Si el BMP és d'1 bit o de 8 bits amb paleta, cal donar els noms del fitxer d'entrada BMP, del fitxer DBF (paleta) i del fitxer de sortida IMG.</li><li>Importació; d'un BMP a IMG. Per a la resta dels tipus BMP, cal donar els noms del fitxer d'entrada BMP i dels fitxers de sortida que formen la combinació RGB: FitxerR, FitxerG i FitxerB.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerBMP</ows:Identifier>
				<ows:Title>Fitxer BMP</ows:Title>
				<ows:Abstract>El BMP (acrònim de bitmap "mapa de bits") és un estàndard de representació d'imatges basat en el mapa de bits.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerBMPEntrada"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fitxer DBF</ows:Title>
				<ows:Abstract>Fitxer DBF que conté la paleta de colors.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FitxerDBF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerIMG</ows:Identifier>
				<ows:Title>Fitxer IMG</ows:Title>
				<ows:Abstract>Fitxer IMG a exportar.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerIMG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:BMPIMG:Param1:2&Param5</ows:Identifier>
		<ows:Title>BMPRGB</ows:Title>
		<ows:Abstract>Importa un fitxer BMP a un fitxer IMG, com a combinació RGB.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract><![CDATA[Importa un fitxer BMP a un fitxer IMG, en funció de les propietats del fitxer d'entrada BMP:<ul><li>Importació d'un BMP a IMG. Si el BMP és d'1 bit o de 8 bits sense paleta, cal donar només els noms del fitxer d'entrada BMP i del fitxer de sortida IMG, ja que no es genera cap fitxer DBF (paleta). Si el BMP és d'1 bit o de 8 bits amb paleta, cal donar els noms del fitxer d'entrada BMP, del fitxer DBF (paleta) i del fitxer de sortida IMG.</li><li>Importació; d'un BMP a IMG. Per a la resta dels tipus BMP, cal donar els noms del fitxer d'entrada BMP i dels fitxers de sortida que formen la combinació RGB: FitxerR, FitxerG i FitxerB.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
