<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:BMPIMG:Param1:0</ows:Identifier>
		<ows:Title>BMP Info</ows:Title>
		<ows:Abstract>Es proporciona informació de la capçalera del fitxer BMP.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversió entre fitxers ràster BMP i IMG"/>
		<ows:Metadata xlink:title="Abstract:Aquest programa transforma entre el format IMG de MiraMon i el format BMP."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Proporciona informació de la capçalera del fitxer BMP.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerBMP</ows:Identifier>
				<ows:Title>Fitxer BMP</ows:Title>
				<ows:Abstract>El BMP (acrònim de bitmap "mapa de bits") és un estàndard de representació d'imatges basat en el mapa de bits.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerBMPEntrada"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>StdOut</ows:Identifier>
				<ows:Title>Estàndard de sortida</ows:Title>
				<ows:Abstract>Estàndard de sortida amb informació sobre el BMP.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:BMPIMG:Param1:1&!Param5</ows:Identifier>
		<ows:Title>IMGBMP</ows:Title>
		<ows:Abstract>Exportació d'un IMG amb paleta a BMP.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract><![CDATA[Exporta un fitxer IMG a un fitxer BMP, en funció de les propietats del fitxer d'entrada IMG:<ul><li>Exportació d'un IMG amb paleta a BMP. Si la dada d'origen és de tipus BYTE o BYTE_RLE, es genera un BMP de 8 bits (incloent-hi la paleta de colors corresponent). Si la dada d'origen és de tipus BIT, es genera un BMP d'1 bit (incloent-hi la paleta de colors corresponent). Si el tipus de dades és diferent, no es genera cap fitxer.</li><li>Exportació d'un IMG donat com a combinació RGB (FitxerR, FitxerG, i FitxerB) a BMP. Es genera un BMP de 24 bits (sense paleta de colors).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerIMG</ows:Identifier>
				<ows:Title>Fitxer IMG</ows:Title>
				<ows:Abstract>Fitxer IMG a exportar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerIMG"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fitxer DBF</ows:Title>
				<ows:Abstract>Fitxer DBF que conté la paleta de colors.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerDBF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerBMP</ows:Identifier>
				<ows:Title>Fitxer BMP</ows:Title>
				<ows:Abstract>El BMP (acrònim de bitmap "mapa de bits") és un estàndard de representació d'imatges basat en el mapa de bits.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FitxerBMPEntrada"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:BMPIMG:Param1:1&Param5</ows:Identifier>
		<ows:Title>RGBBMP</ows:Title>
		<ows:Abstract>Exportació d'un IMG donat com a combinació RGB (FitxerR, FitxerG, i FitxerB) a BMP.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract><![CDATA[Exporta un fitxer IMG a un fitxer BMP, en funció de les propietats del fitxer d'entrada IMG:<ul><li>Exportació d'un IMG amb paleta a BMP. Si la dada d'origen és de tipus BYTE o BYTE_RLE, es genera un BMP de 8 bits (incloent-hi la paleta de colors corresponent). Si la dada d'origen és de tipus BIT, es genera un BMP d'1 bit (incloent-hi la paleta de colors corresponent). Si el tipus de dades és diferent, no es genera cap fitxer.</li><li>Exportació d'un IMG donat com a combinació RGB (FitxerR, FitxerG, i FitxerB) a BMP. Es genera un BMP de 24 bits (sense paleta de colors).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerR</ows:Identifier>
				<ows:Title>Fitxer R</ows:Title>
				<ows:Abstract>Fitxer Vermell.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerR"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
