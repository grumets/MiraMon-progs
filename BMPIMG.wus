				<ows:Abstract>Fitxer Verd.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerG"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerB</ows:Identifier>
				<ows:Title>Fitxer B</ows:Title>
				<ows:Abstract>Fitxer Blau.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FitxerB"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerBMP</ows:Identifier>
				<ows:Title>Fitxer BMP</ows:Title>
				<ows:Abstract>El BMP (acrònim de bitmap "mapa de bits") és un estàndard de representació d'imatges basat en el mapa de bits.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:FitxerBMPEntrada"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
