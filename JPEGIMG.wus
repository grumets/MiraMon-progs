<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:0</ows:Identifier>
		<ows:Title>Header Information</ows:Title>
		<ows:Abstract>(Option 0) Shows Metadata</ows:Abstract>
		<ows:Metadata xlink:title="Title:Format conversion between rasters files: JPEG, IMG or BMP"/>
		<ows:Metadata xlink:title="Abstract:This program transforms between the MiraMon IMG format or the BMP format (without georeferencing), to the JPEG format with MiraMon metadata, or the JPEG format (without georeferencing)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Metadata</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>JPEG File</ows:Title>
				<ows:Abstract>Is the name of the JPEG file that we want o extract the metadadta information.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:JPEGFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Stdout</ows:Identifier>
				<ows:Title>Output standard</ows:Title>
				<ows:Abstract>Metadata information from the JPEG file.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:1&!Param5</ows:Identifier>
		<ows:Title>IMG/BMP to JPEG</ows:Title>
		<ows:Abstract>(Option 1) Converts IMG/BMP to JPEG. In this option a BMP(FileIn), or an IMG image with a grey scale palette (FileIn), or an IMG with a P25 palette (FileIn and FileP25) or an RGB combination (FileR, FileG and FileB) are converted to a single JPEG file (FileJPEG).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Conversion of IMG/BMP file to JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerIn</ows:Identifier>
				<ows:Title>Input File</ows:Title>
				<ows:Abstract>Is the name of the image that we want to transform.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:InputFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FitxerP25</ows:Identifier>
				<ows:Title>P25 file</ows:Title>
				<ows:Abstract>Is the name of the colours palette that will be used to represent the JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Name:P25File"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALITAT</ows:Identifier>
				<ows:Title>Quality</ows:Title>
				<ows:Abstract>Quality of compression, in the range [0,100], where [5,95] is the useful range but, in many cases, we use a value between 70 and 75 (by default is 75). Low values means very low quality but high compression.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>100</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRISOS</ows:Identifier>
				<ows:Title>Greys</ows:Title>
				<ows:Abstract>Creates a grey scale JPEG: converting a colour raster to grey scale (monochrome).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPTIMITZAT</ows:Identifier>
				<ows:Title>Optimise</ows:Title>
				<ows:Abstract>Optimise the Huffman table (the file will be smaller but the compression will be slower).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PROGRESSIU</ows:Identifier>
				<ows:Title>Progressive</ows:Title>
				<ows:Abstract>Creates a progressive JPEG. This type of JPG permits preview during the first phases of decompression.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DENOM_ESCALA</ows:Identifier>
				<ows:Title>Scale denominator</ows:Title>
				<ows:Abstract>Denominator of the scale at which the JPEG should be printed, or 0 if the user does not wish to specify a scale. The information about the raster cell size, together with this parameter are used to save internally in the JPEG file the output image pixel size in paper units, such as ppi (pixels per inch).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_METADADES</ows:Identifier>
				<ows:Title>No metadata</ows:Title>
				<ows:Abstract>Indicates that we don't want to create a metadata file asociaded with JPEG file based on metadata form IMG files. It's created by default. It doesn't apply when the file to transform is not an IMG.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>JPEG File</ows:Title>
				<ows:Abstract>Is the name of the JPEG file that we want o extract the metadadta information.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:JPEGFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:2&!Param5</ows:Identifier>
		<ows:Title>JPEG to IMG/BMP</ows:Title>
		<ows:Abstract>(Option 2) From JPEG to IMG/BMP: This option converts a JPEG file (FileJPEGs) to a BMP file (FileIn), or to an IMG file with a grey scale palette (FileIn), or to an IMG file with a predefined P25 palette (FileIn and FileP25), or to an IMG file with an optimised P25 palette (FileIn and FileP25), o to an RGB combination (FileR, FileG, and FileB).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Conversion of JPEG file to IMG/BMP.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>JPEG File</ows:Title>
				<ows:Abstract>Is the name of the JPEG file that we want o extract the metadadta information.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:JPEGFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FitxerP25</ows:Identifier>
				<ows:Title>P25 file</ows:Title>
				<ows:Abstract>Is the name of the colours palette that will be used to represent the JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Name:P25File"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NCOLORS</ows:Identifier>
				<ows:Title>Number of Colours</ows:Title>
				<ows:Abstract>Forces a reduction of the colour space to a limited number of colours, n. This will be the final number of colours in the palette if IMG+optimised palette is requested.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MAP_PAL</ows:Identifier>
				<ows:Title>Specific Palette</ows:Title>
				<ows:Abstract>Forces the colour space to a specific palette. Note that if this option is selected the program reads the indicated palette from disk. If this option is not selected the program writes an optimised palette for this particular image.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_SUAVIZAT</ows:Identifier>
				<ows:Title>No smoothing</ows:Title>
				<ows:Abstract>Allows not passing the smoothing filter to improve the final results.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>1PAS</ows:Identifier>
				<ows:Title>One step</ows:Title>
				<ows:Abstract>Use only one quantization pass. The result is obtained quicker but with lower quality. It requares fewer memory.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ESCALAT</ows:Identifier>
				<ows:Title>Escala</ows:Title>
				<ows:Abstract>m/n Output scale expressed as a fraction m/n, e.g: 1/8. This parameter can be useful when the image, once decompressed, would be unacceptably big.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FWORLD</ows:Identifier>
				<ows:Title>World File</ows:Title>
				<ows:Abstract>Create a world file extension indicated.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerIMGBMP</ows:Identifier>
				<ows:Title>IMG/BMP File</ows:Title>
				<ows:Abstract>Is the name of the IMG file that we want to transform to JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:3&!Param5</ows:Identifier>
		<ows:Title>IMG/BMP to JPEG Indexat</ows:Title>
		<ows:Abstract>(Option 3) Convert IMG/BMP to a indexed JPEG convert IMG/BMP to JPEG. In this option a BMP(FileIn), or an IMG image with a grey scale palette (FileIn), or an IMG with a P25 palette (FileIn and FileP25) or an RGB combination (FileR, FileG and FileB) are converted to a single Indexed JPEG file (FileJPEG).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Conversion of IMG/BMP file to indexed JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerIMGBMP</ows:Identifier>
				<ows:Title>IMG/BMP File</ows:Title>
				<ows:Abstract>Is the name of the IMG file that we want to transform to JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FitxerP25</ows:Identifier>
				<ows:Title>P25 file</ows:Title>
				<ows:Abstract>Is the name of the colours palette that will be used to represent the JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Name:P25File"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALITAT</ows:Identifier>
				<ows:Title>Quality</ows:Title>
				<ows:Abstract>Quality of compression, in the range [0,100], where [5,95] is the useful range but, in many cases, we use a value between 70 and 75 (by default is 75). Low values means very low quality but high compression.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>100</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_METADADES</ows:Identifier>
				<ows:Title>No metadata</ows:Title>
				<ows:Abstract>Indicates that we don't want to create a metadata file asociaded with JPEG file based on metadata form IMG files. It's created by default. It doesn't apply when the file to transform is not an IMG.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FWORLD</ows:Identifier>
				<ows:Title>World File</ows:Title>
				<ows:Abstract>Create a world file extension indicated.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NFIL_PAQUET</ows:Identifier>
				<ows:Title>Preview</ows:Title>
				<ows:Abstract>Number of rows of each package indexed. It is recommended that greater than 64.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUICKLOOK</ows:Identifier>
				<ows:Title>Quicklook</ows:Title>
				<ows:Abstract>Small image that shows how to preview Windows and all programs of image processing since OBrien not read JPEG indexed MiraMon. It may not be indicated in this case Windows and other programs show only the first packet of rows of the image.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>JPEG File</ows:Title>
				<ows:Abstract>Is the name of the JPEG file that we want o extract the metadadta information.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:JPEGFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:1&Param5</ows:Identifier>
		<ows:Title>IMG/BMP Multiband to JPEG</ows:Title>
		<ows:Abstract>(Option 1) From IMG/BMP to JPEG. This option converts a JPEG file (FileJPEGs) to a BMP file (FileIn), or to an IMG file with a grey scale palette (FileIn), or to an IMG file with a predefined P25 palette (FileIn and FileP25), or to an IMG file with an optimised P25 palette (FileIn and FileP25), o to an RGB combination (FileR, FileG, and FileB).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Conversion of IMG/BMP file to JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerR</ows:Identifier>
				<ows:Title>Red File</ows:Title>
				<ows:Abstract>Red band file</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerG</ows:Identifier>
				<ows:Title>Green File</ows:Title>
				<ows:Abstract>Green band file</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerB</ows:Identifier>
				<ows:Title>Blue File</ows:Title>
				<ows:Abstract>Blue band file</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALITAT</ows:Identifier>
				<ows:Title>Quality</ows:Title>
				<ows:Abstract>Quality of compression, in the range [0,100], where [5,95] is the useful range but, in many cases, we use a value between 70 and 75 (by default is 75). Low values means very low quality but high compression.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>100</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRISOS</ows:Identifier>
				<ows:Title>Greys</ows:Title>
				<ows:Abstract>Creates a grey scale JPEG: converting a colour raster to grey scale (monochrome).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPTIMITZAT</ows:Identifier>
				<ows:Title>Optimise</ows:Title>
				<ows:Abstract>Optimise the Huffman table (the file will be smaller but the compression will be slower).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PROGRESSIU</ows:Identifier>
				<ows:Title>Progressive</ows:Title>
				<ows:Abstract>Creates a progressive JPEG. This type of JPG permits preview during the first phases of decompression.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DENOM_ESCALA</ows:Identifier>
				<ows:Title>Scale denominator</ows:Title>
				<ows:Abstract>Denominator of the scale at which the JPEG should be printed, or 0 if the user does not wish to specify a scale. The information about the raster cell size, together with this parameter are used to save internally in the JPEG file the output image pixel size in paper units, such as ppi (pixels per inch).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_METADADES</ows:Identifier>
				<ows:Title>No metadata</ows:Title>
				<ows:Abstract>Indicates that we don't want to create a metadata file asociaded with JPEG file based on metadata form IMG files. It's created by default. It doesn't apply when the file to transform is not an IMG.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>JPEG File</ows:Title>
				<ows:Abstract>Is the name of the JPEG file that we want o extract the metadadta information.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:JPEGFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:2&Param5</ows:Identifier>
		<ows:Title>JPEG to IMG/BMP MultiBanda</ows:Title>
		<ows:Abstract>(Option 2) From JPEG to IMG/BMP: This option converts a JPEG file (FileJPEGs) to a BMP file (FileIn), or to an IMG file with a grey scale palette (FileIn), or to an IMG file with a predefined P25 palette (FileIn and FileP25), or to an IMG file with an optimised P25 palette (FileIn and FileP25), o to an RGB combination (FileR, FileG, and FileB).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Conversion of JPEG file to IMG/BMP.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>JPEG File</ows:Title>
				<ows:Abstract>Is the name of the JPEG file that we want o extract the metadadta information.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:JPEGFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NCOLORS</ows:Identifier>
				<ows:Title>Number of Colours</ows:Title>
				<ows:Abstract>Forces a reduction of the colour space to a limited number of colours, n. This will be the final number of colours in the palette if IMG+optimised palette is requested.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MAP_PAL</ows:Identifier>
				<ows:Title>Specific Palette</ows:Title>
				<ows:Abstract>Forces the colour space to a specific palette. Note that if this option is selected the program reads the indicated palette from disk. If this option is not selected the program writes an optimised palette for this particular image.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_SUAVIZAT</ows:Identifier>
				<ows:Title>No smoothing</ows:Title>
				<ows:Abstract>Allows not passing the smoothing filter to improve the final results.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>1PAS</ows:Identifier>
				<ows:Title>One step</ows:Title>
				<ows:Abstract>Use only one quantization pass. The result is obtained quicker but with lower quality. It requares fewer memory.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ESCALAT</ows:Identifier>
				<ows:Title>Escala</ows:Title>
				<ows:Abstract>m/n Output scale expressed as a fraction m/n, e.g: 1/8. This parameter can be useful when the image, once decompressed, would be unacceptably big.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FWORLD</ows:Identifier>
				<ows:Title>World File</ows:Title>
				<ows:Abstract>Create a world file extension indicated.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerR</ows:Identifier>
				<ows:Title>Red File</ows:Title>
				<ows:Abstract>Red band file</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxerG</ows:Identifier>
				<ows:Title>Green File</ows:Title>
				<ows:Abstract>Green band file</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxerB</ows:Identifier>
				<ows:Title>Blue File</ows:Title>
				<ows:Abstract>Blue band file</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:3&Param5</ows:Identifier>
		<ows:Title>IMG/BMP Multibanda to JPEG Indexed</ows:Title>
		<ows:Abstract>(Option 3) Convert IMG/BMP to a indexed JPEG convert IMG/BMP to JPEG. In this option a BMP(FileIn), or an IMG image with a grey scale palette (FileIn), or an IMG with a P25 palette (FileIn and FileP25) or an RGB combination (FileR, FileG and FileB) are converted to a single Indexed JPEG file (FileJPEG).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Conversion of IMG/BMP file to indexed JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerR</ows:Identifier>
				<ows:Title>Red File</ows:Title>
				<ows:Abstract>Red band file</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerG</ows:Identifier>
				<ows:Title>Green File</ows:Title>
				<ows:Abstract>Green band file</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerB</ows:Identifier>
				<ows:Title>Blue File</ows:Title>
				<ows:Abstract>Blue band file</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALITAT</ows:Identifier>
				<ows:Title>Quality</ows:Title>
				<ows:Abstract>Quality of compression, in the range [0,100], where [5,95] is the useful range but, in many cases, we use a value between 70 and 75 (by default is 75). Low values means very low quality but high compression.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>100</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_METADADES</ows:Identifier>
				<ows:Title>No metadata</ows:Title>
				<ows:Abstract>Indicates that we don't want to create a metadata file asociaded with JPEG file based on metadata form IMG files. It's created by default. It doesn't apply when the file to transform is not an IMG.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FWORLD</ows:Identifier>
				<ows:Title>World File</ows:Title>
				<ows:Abstract>Create a world file extension indicated.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NFIL_PAQUET</ows:Identifier>
				<ows:Title>Preview</ows:Title>
				<ows:Abstract>Number of rows of each package indexed. It is recommended that greater than 64.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUICKLOOK</ows:Identifier>
				<ows:Title>Quicklook</ows:Title>
				<ows:Abstract>Small image that shows how to preview Windows and all programs of image processing since OBrien not read JPEG indexed MiraMon. It may not be indicated in this case Windows and other programs show only the first packet of rows of the image.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>JPEG File</ows:Title>
				<ows:Abstract>Is the name of the JPEG file that we want o extract the metadadta information.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:JPEGFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>