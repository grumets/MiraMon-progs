		<ows:Value>52</ows:Value>
		<ows:Value>53</ows:Value>
		<ows:Value>54</ows:Value>
		<ows:Value>55</ows:Value>
		<ows:Value>56</ows:Value>
		<ows:Value>57</ows:Value>
		<ows:Value>58</ows:Value>
		<ows:Value>59</ows:Value>
		<ows:Value>60</ows:Value>
		<ows:Value>61</ows:Value>
		<ows:Value>62</ows:Value>
		<ows:Value>63</ows:Value>
		<ows:Value>64</ows:Value>
		<ows:Value>65</ows:Value>
		<ows:Value>66</ows:Value>
		<ows:Value>67</ows:Value>
		<ows:Value>68</ows:Value>
		<ows:Value>69</ows:Value>
		<ows:Value>70</ows:Value>
		<ows:Value>71</ows:Value>
		<ows:Value>72</ows:Value>
		<ows:Value>73</ows:Value>
		<ows:Value>74</ows:Value>
		<ows:Value>75</ows:Value>
		<ows:Value>76</ows:Value>
		<ows:Value>77</ows:Value>
		<ows:Value>78</ows:Value>
		<ows:Value>79</ows:Value>
		<ows:Value>80</ows:Value>
		<ows:Value>81</ows:Value>
