<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:DXFVEC:Param1:0&amp;!Param3</ows:Identifier>
		<ows:Title>DXFVEC 0</ows:Title>
		<ows:Abstract>CONTENTS INFORMATION: Shows a list of the DXF file contents. It reports the number of polylines, lines, arcs, ellipses, circles, solids, points, texts and blocks, broken down by layers. For blocks, each layer lists the names and the number of blocks with that name.</ows:Abstract>
		<ows:Metadata xlink:title="Title:DXF files import"/>
		<ows:Metadata xlink:title="Abstract:This program performs the conversion between DXF files (obtained with DXFOUT of AutoCAD, export of CorelDraw, etc.) and vector files, either topologically structured (grouped in an MMM file) or not (VEC format)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 0</ows:Title>
				<ows:Abstract>Information on the file contents</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitx1</ows:Identifier>
				<ows:Title>File 1</ows:Title>
				<ows:Abstract>DXF file whose contents will be listed.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Fitx1"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dxf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dxf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>StdOut</ows:Identifier>
				<ows:Title>Standard output</ows:Title>
				<ows:Abstract>DXF file contents information shown on screen.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:DXFVEC:Param1:0&amp;Param3</ows:Identifier>
		<ows:Title>DXFVEC 0</ows:Title>
		<ows:Abstract>CONTENTS INFORMATION: Shows a list of the DXF file contents. It reports the number of polylines, lines, arcs, ellipses, circles, solids, points, texts and blocks, broken down by layers. For blocks, each layer lists the names and the number of blocks with that name.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 0</ows:Title>
				<ows:Abstract>Information on the file contents</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitx1</ows:Identifier>
				<ows:Title>File 1</ows:Title>
				<ows:Abstract>DXF file whose contents will be listed.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Fitx1"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dxf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dxf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxText</ows:Identifier>
				<ows:Title>Text file</ows:Title>
				<ows:Abstract>Name of a text file that will keep a copy of the information shown on screen. Only available in option 0.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxText"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:DXFVEC:Param1:1</ows:Identifier>
		<ows:Title>DXFVEC 1</ows:Title>
		<ows:Abstract>DXF LINES, POLYLINES, ARCS, ELLIPSES, CIRCLES AND SOLIDS WILL BE TRANSFORMED TO VEC LINES OR POLYGONS. If the program detects that all polylines are closed, either in the DXF definition or because the extreme coordinates are identical, it documents the entities as type "polygon"; otherwise as type "line". The layer of the entity becomes the attribute in the VEC file. The number of vertices in a polyline is practically unlimited. The program uses the command-line tolerance to convert arcs, circles and ellipses to polylines. Tolerance is the maximum allowed error when translating DXF arcs, circles and ellipses to VEC polylines (maximum distance between the arc and the chord). Later DXF versions (AutoCAD 2000) allow curvatures between polyline vertices; tolerance also applies to those objects. If 0 is given, the number of vertices is limited to one per degree. Tolerance can only be given in option 1.</ows:Abstract>
		<DataInputs>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 1</ows:Title>
				<ows:Abstract>Lines, polylines, arcs, circles, ellipses and solids -> lines or polygons, depending on whether they are open</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>F_DXF</ows:Identifier>
				<ows:Title>DXF file</ows:Title>
				<ows:Abstract>Name of the DXF file to convert.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:F_DXF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dxf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dxf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusAtribut</ows:Identifier>
				<ows:Title>Type of attribute</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>1 Integer numbers, ignoring texts and rounding if needed.</li><li>2 Real numbers, ignoring texts.</li><li>3 Alphanumeric (texts and numbers) (not valid with altimetry entity filters).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:TypeofAttrib"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Filtre</ows:Identifier>
				<ows:Title>Filter</ows:Title>
				<ows:Abstract><![CDATA[Object filter:<ul><li>1 Objects from all layers.</li><li>2 Objects from a single layer.</li><li>3 Objects from several layers from a single-column equivalences file.</li><li>4 One text in any layer.</li><li>5 Several texts in all layers from an equivalences file.</li><li>6 Altimetry: the attribute is taken from the Z of the first vertex.</li><li>7 Altimetry from an equivalences file.</li><li>8 Block descriptions.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Filter"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>6</ows:Value>
						<ows:Value>7</ows:Value>
						<ows:Value>8</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_Decimals</ows:Identifier>
				<ows:Title>Number of decimals</ows:Title>
				<ows:Abstract>Number of decimal digits written in the output coordinates. Allowed values: 0 to 15; default is 6.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:N_decimal"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>6</DefaultValue>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Tolerancia</ows:Identifier>
				<ows:Title>Tolerance</ows:Title>
				<ows:Abstract>Maximum tolerated error when translating DXF arcs, circles, ellipses and vertex curvatures to VEC polylines. Only allowed in option 1. Default is 0.</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:Tolerance"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>3D</ows:Identifier>
				<ows:Title>3D</ows:Title>
				<ows:Abstract>1 means the third dimension of the DXF file should be imported. 0 means it should not. If the parameter is omitted, the program detects whether the DXF is 2D or 3D and chooses the corresponding VEC format.</ows:Abstract>
				<ows:Metadata xlink:title="Name:3D"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FITX_EQUIV</ows:Identifier>
				<ows:Title>Equivalences file</ows:Title>
				<ows:Abstract>Name of the equivalences file for entity filters 3, 5 and 7. If omitted, the file name is asked during execution.</ows:Abstract>
				<ows:Metadata xlink:title="Name:FITX_EQUIV"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAPA</ows:Identifier>
				<ows:Title>Layer</ows:Title>
				<ows:Abstract>Name of the layer to import with filter 2. If omitted, the layer name is asked during execution.</ows:Abstract>
				<ows:Metadata xlink:title="Name:CAPA"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ATRIBUT</ows:Identifier>
				<ows:Title>Attribute</ows:Title>
				<ows:Abstract>Attribute that replaces the layer name when importing with filter 2. If omitted and /CAPA is given, the same value is used; otherwise it is asked during execution.</ows:Abstract>
				<ows:Metadata xlink:title="Name:ATRIBUT"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TEXT</ows:Identifier>
				<ows:Title>Text</ows:Title>
				<ows:Abstract>Text (or block name) to import with filter 4. If omitted, it is asked during execution.</ows:Abstract>
				<ows:Metadata xlink:title="Name:TEXT"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ELIMINA_HIDDEN</ows:Identifier>
				<ows:Title>Skip HIDDEN entities</ows:Title>
				<ows:Abstract>Do not import DXF entities marked with HIDDEN style (hidden entities or AutoCAD Hidden linetype). Only applies to options 1 to 5.</ows:Abstract>
				<ows:Metadata xlink:title="Name:ELIMINA_HIDDEN"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
<Output>
				<ows:Identifier>F_VEC</ows:Identifier>
				<ows:Title>Vector file</ows:Title>
				<ows:Abstract>Usually the name of the output VEC file. It is the extraction directory when using filter 8.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:F_VEC"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:DXFVEC:Param1:2</ows:Identifier>
		<ows:Title>DXFVEC 2</ows:Title>
		<ows:Abstract>DXF POINTS WILL BE TRANSFORMED TO VEC POINTS. The layer name of the entity becomes the point attribute in the VEC file.</ows:Abstract>
		<DataInputs>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 2</ows:Title>
				<ows:Abstract>Points -> points</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>F_DXF</ows:Identifier>
				<ows:Title>DXF file</ows:Title>
				<ows:Abstract>Name of the DXF file to convert.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:F_DXF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dxf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dxf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusAtribut</ows:Identifier>
				<ows:Title>Type of attribute</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>1 Integer numbers, ignoring texts and rounding if needed.</li><li>2 Real numbers, ignoring texts.</li><li>3 Alphanumeric (texts and numbers) (not valid with altimetry entity filters).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:TypeofAttrib"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Filtre</ows:Identifier>
				<ows:Title>Filter</ows:Title>
				<ows:Abstract><![CDATA[Object filter:<ul><li>1 Objects from all layers.</li><li>2 Objects from a single layer.</li><li>3 Objects from several layers from a single-column equivalences file.</li><li>4 One text in any layer.</li><li>5 Several texts in all layers from an equivalences file.</li><li>6 Altimetry: the attribute is taken from the Z of the first vertex.</li><li>7 Altimetry from an equivalences file.</li><li>8 Block descriptions.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Filter"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>6</ows:Value>
						<ows:Value>7</ows:Value>
						<ows:Value>8</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_Decimals</ows:Identifier>
				<ows:Title>Number of decimals</ows:Title>
				<ows:Abstract>Number of decimal digits written in the output coordinates. Allowed values: 0 to 15; default is 6.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:N_decimal"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>6</DefaultValue>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>3D</ows:Identifier>
				<ows:Title>3D</ows:Title>
				<ows:Abstract>1 means the third dimension of the DXF file should be imported. 0 means it should not. If the parameter is omitted, the program detects whether the DXF is 2D or 3D and chooses the corresponding VEC format.</ows:Abstract>
				<ows:Metadata xlink:title="Name:3D"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FITX_EQUIV</ows:Identifier>
				<ows:Title>Equivalences file</ows:Title>
				<ows:Abstract>Name of the equivalences file for entity filters 3, 5 and 7. If omitted, the file name is asked during execution.</ows:Abstract>
				<ows:Metadata xlink:title="Name:FITX_EQUIV"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAPA</ows:Identifier>
				<ows:Title>Layer</ows:Title>
				<ows:Abstract>Name of the layer to import with filter 2. If omitted, the layer name is asked during execution.</ows:Abstract>
				<ows:Metadata xlink:title="Name:CAPA"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ATRIBUT</ows:Identifier>
				<ows:Title>Attribute</ows:Title>
				<ows:Abstract>Attribute that replaces the layer name when importing with filter 2. If omitted and /CAPA is given, the same value is used; otherwise it is asked during execution.</ows:Abstract>
				<ows:Metadata xlink:title="Name:ATRIBUT"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TEXT</ows:Identifier>
				<ows:Title>Text</ows:Title>
				<ows:Abstract>Text (or block name) to import with filter 4. If omitted, it is asked during execution.</ows:Abstract>
				<ows:Metadata xlink:title="Name:TEXT"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ELIMINA_HIDDEN</ows:Identifier>
				<ows:Title>Skip HIDDEN entities</ows:Title>
				<ows:Abstract>Do not import DXF entities marked with HIDDEN style (hidden entities or AutoCAD Hidden linetype). Only applies to options 1 to 5.</ows:Abstract>
				<ows:Metadata xlink:title="Name:ELIMINA_HIDDEN"/>
				<LiteralData>
