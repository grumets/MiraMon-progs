						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAPA</ows:Identifier>
				<ows:Title>Layer</ows:Title>
				<ows:Abstract>Name of the layer to import with filter 2. If omitted, the layer name is asked during execution.</ows:Abstract>
				<ows:Metadata xlink:title="Name:CAPA"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ATRIBUT</ows:Identifier>
				<ows:Title>Attribute</ows:Title>
				<ows:Abstract>Attribute that replaces the layer name when importing with filter 2. If omitted and /CAPA is given, the same value is used; otherwise it is asked during execution.</ows:Abstract>
				<ows:Metadata xlink:title="Name:ATRIBUT"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TEXT</ows:Identifier>
				<ows:Title>Text</ows:Title>
				<ows:Abstract>Text (or block name) to import with filter 4. If omitted, it is asked during execution.</ows:Abstract>
				<ows:Metadata xlink:title="Name:TEXT"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ELIMINA_HIDDEN</ows:Identifier>
				<ows:Title>Skip HIDDEN entities</ows:Title>
				<ows:Abstract>Do not import DXF entities marked with HIDDEN style (hidden entities or AutoCAD Hidden linetype). Only applies to options 1 to 5.</ows:Abstract>
				<ows:Metadata xlink:title="Name:ELIMINA_HIDDEN"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
<Output>
				<ows:Identifier>F_VEC</ows:Identifier>
				<ows:Title>Vector file</ows:Title>
				<ows:Abstract>Usually the name of the output VEC file. It is the extraction directory when using filter 8.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:F_VEC"/>
				<ComplexOutput>
