					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FITX_EQUIV</ows:Identifier>
				<ows:Title>Equivalences file</ows:Title>
				<ows:Abstract>Name of the equivalences file for entity filters 3, 5 and 7. If omitted, the file name is asked during execution.</ows:Abstract>
				<ows:Metadata xlink:title="Name:FITX_EQUIV"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAPA</ows:Identifier>
				<ows:Title>Layer</ows:Title>
				<ows:Abstract>Name of the layer to import with filter 2. If omitted, the layer name is asked during execution.</ows:Abstract>
				<ows:Metadata xlink:title="Name:CAPA"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ATRIBUT</ows:Identifier>
				<ows:Title>Attribute</ows:Title>
				<ows:Abstract>Attribute that replaces the layer name when importing with filter 2. If omitted and /CAPA is given, the same value is used; otherwise it is asked during execution.</ows:Abstract>
				<ows:Metadata xlink:title="Name:ATRIBUT"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TEXT</ows:Identifier>
				<ows:Title>Text</ows:Title>
				<ows:Abstract>Text (or block name) to import with filter 4. If omitted, it is asked during execution.</ows:Abstract>
				<ows:Metadata xlink:title="Name:TEXT"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ELIMINA_HIDDEN</ows:Identifier>
				<ows:Title>Skip HIDDEN entities</ows:Title>
				<ows:Abstract>Do not import DXF entities marked with HIDDEN style (hidden entities or AutoCAD Hidden linetype). Only applies to options 1 to 5.</ows:Abstract>
				<ows:Metadata xlink:title="Name:ELIMINA_HIDDEN"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
<Output>
				<ows:Identifier>F_VEC</ows:Identifier>
				<ows:Title>Vector file</ows:Title>
				<ows:Abstract>Usually the name of the output VEC file. It is the extraction directory when using filter 8.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:F_VEC"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:DXFVEC:Param1:6</ows:Identifier>
		<ows:Title>DXFVEC 6</ows:Title>
		<ows:Abstract>DXF LINES, POLYLINES, ARCS, ELLIPSES, CIRCLES AND SOLIDS WILL BE TRANSFORMED TO ARC OR POL FILES, AND POINTS, TEXTS AND BLOCK INSERTION POINTS WILL BE TRANSFORMED TO PNT FILES. A MiraMon Map (MMM) file will be created to group all the new layers.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 6</ows:Title>
				<ows:Abstract>Lines, polylines, arcs, circles, ellipses and solids -> ARC or POL files; points, texts and block insertion points -> PNT files. An MMM map is created.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>6</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>6</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>F_DXF</ows:Identifier>
				<ows:Title>DXF file</ows:Title>
				<ows:Abstract>Name of the DXF file to convert.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:F_DXF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dxf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dxf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PER_TIPUS_TOPO</ows:Identifier>
				<ows:Title>By topological type</ows:Title>
				<ows:Abstract>All entities are placed in a single point or arc/polygon file, ignoring the original layer distribution. If this option is absent, each original layer keeps its entities in separate topological files.</ows:Abstract>
				<ows:Metadata xlink:title="Name:PER_TIPUS_TOPO"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_DIBUIXAR_BLOCS</ows:Identifier>
				<ows:Title>Do not draw blocks</ows:Title>
				<ows:Abstract>Block entities will not be drawn. A point layer with all block insertion points is still created (by default this layer is not visible but it is queryable).</ows:Abstract>
				<ows:Metadata xlink:title="Name:NO_DIBUIXAR_BLOCS"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>D_MMM</ows:Identifier>
				<ows:Title>MMM map directory</ows:Title>
				<ows:Abstract>Directory where the MMM map and its topological files will be created.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:D_MMM"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
