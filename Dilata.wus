<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Dilata:1</ows:Identifier>
		<ows:Title>Dilata</ows:Title>
		<ows:Abstract>Performs the image processing operation and mathematical morphology known as dilation, which takes a value and replicates it in the geometric immediate surroundings.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Dilation of pixels of a selected value in raster files"/>
		<ows:Metadata xlink:title="Abstract:Performs the image processing operation and mathematical morphology known as dilation, which takes a value and replicates it in the geometric immediate surroundings."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxOrigen</ows:Identifier>
				<ows:Title>Raster file to dilate</ows:Title>
				<ows:Abstract>Raster file with one o more values that we want to dilate.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:InputFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ValorDilatar</ows:Identifier>
				<ows:Title>Value to dilate</ows:Title>
				<ows:Abstract>Value to be dilated. If you want to dilate any value other than NoData, specify X.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:ValueDilate"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusDilatacio</ows:Identifier>
				<ows:Title>Type of dilation</ows:Title>
				<ows:Abstract><![CDATA[Type of dilation:<ul> <li>1  N-S</li><li>2  E-W</li> <li>3  On cross of Malta (N-S and E-W)</li> <li>4  On cross of Malta and diagonally (all the neighbors)</li> 				<li>5  Down and to the left (S and W)</li> <li>6  Down and to the left, and both (S, W and SW)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:TypeDilation"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>6</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxSortida</ows:Identifier>
				<ows:Title>Output file</ows:Title>
				<ows:Abstract>Output file from the dilation of the requested value.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:OutputFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>