	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TIFIMG:param1:8</ows:Identifier>
		<ows:Title>IMG to TIFF (RGB)</ows:Title>
		<ows:Abstract>This option transforms IMG (RGB) files into a 24-bit color TIFF file.</ows:Abstract>
