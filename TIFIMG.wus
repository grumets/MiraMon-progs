				<ows:Identifier>FitxerTIFF</ows:Identifier>
				<ows:Title>TIFF file</ows:Title>
				<ows:Abstract>Is the name of the output TIFF file.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:TIFFfile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
