							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TIFIMG:param1:7</ows:Identifier>
		<ows:Title>IMG to TIFF (palette 8 bits)</ows:Title>
