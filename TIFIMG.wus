<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TIFIMG:param1:0</ows:Identifier>
		<ows:Title>Information TIFF</ows:Title>
		<ows:Abstract>This option shows the header information of the TIFF file.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversion between TIFF and IMG files"/>
		<ows:Metadata xlink:title="Abstract:This program allows bidirectional transformation of TIFF and IMG files."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Header information of a TIFF file.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerTIFFOri</ows:Identifier>
				<ows:Title>Input TIFF file</ows:Title>
				<ows:Abstract>TIFF file name from which you want to obtain the header information or to transform to IMG file.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:InputTIFFfFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TFW</ows:Identifier>
				<ows:Title>TFW directory</ows:Title>
				<ows:Abstract><![CDATA[It allows to indicate the directory where to look for the <i> World file </i> (*.Tfw or *.TIFW) to apply to georeference in TIFF imports IMG. If not indicated, the <i> World file </i> is searched in the TIFF directory.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DOC</ows:Identifier>
				<ows:Title>File pattern to document</ows:Title>
				<ows:Abstract><![CDATA[It allows to indicate a raster file of reference of what Inherit the documentation. Never inherit the number of rows or of columns or the range of values. In case of presence of <i> file World </i> or GeoTiff format its value prevails over of this file.]]></ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>stdout</ows:Identifier>
				<ows:Title>Standard output</ows:Title>
				<ows:Abstract>Information on the TIFF</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TIFIMG:param1:1</ows:Identifier>
		<ows:Title>TIFF to IMG (b/n 1 bit)</ows:Title>
		<ows:Abstract>This option transforms TIFF files b/n (1 bit) to IMG files (1bit).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Transformation to IMG bit.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerTIFFOri</ows:Identifier>
				<ows:Title>Input TIFF file</ows:Title>
				<ows:Abstract>TIFF file name from which you want to obtain the header information or to transform to IMG file.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:InputTIFFfFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TFW</ows:Identifier>
				<ows:Title>TFW directory</ows:Title>
				<ows:Abstract><![CDATA[It allows to indicate the directory where to look for the <i> World file </i> (*.Tfw or *.TIFW) to apply to georeference in TIFF imports IMG. If not indicated, the <i> World file </i> is searched in the TIFF directory.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DOC</ows:Identifier>
				<ows:Title>File pattern to document</ows:Title>
				<ows:Abstract><![CDATA[It allows to indicate a raster file of reference of what Inherit the documentation. Never inherit the number of rows or of columns or the range of values. In case of presence of <i> file World </i> or GeoTiff format its value prevails over of this file.]]></ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerIMGResultat</ows:Identifier>
				<ows:Title>Result IMG file</ows:Title>
				<ows:Abstract>It is the name of the IMG file transformation result.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:ResultIMGFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TIFIMG:param1:2</ows:Identifier>
		<ows:Title>TIFF to IMG (gray 8 bits)</ows:Title>
		<ows:Abstract>This option transforms gray TIFF files (8 bits) to IMG byte (8 bit) files.</ows:Abstract>
