				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:InputTIFFfFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TFW</ows:Identifier>
				<ows:Title>TFW directory</ows:Title>
				<ows:Abstract><![CDATA[It allows to indicate the directory where to look for the <i> World file </i> (*.Tfw or *.TIFW) to apply to georeference in TIFF imports IMG. If not indicated, the <i> World file </i> is searched in the TIFF directory.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DOC</ows:Identifier>
				<ows:Title>File pattern to document</ows:Title>
				<ows:Abstract><![CDATA[It allows to indicate a raster file of reference of what Inherit the documentation. Never inherit the number of rows or of columns or the range of values. In case of presence of <i> file World </i> or GeoTiff format its value prevails over of this file.]]></ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerIMGResultat</ows:Identifier>
				<ows:Title>Result IMG file</ows:Title>
				<ows:Abstract>It is the name of the IMG file transformation result.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:ResultIMGFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxerPAL</ows:Identifier>
				<ows:Title>Palette file</ows:Title>
				<ows:Abstract>It is the name of the palette file</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:PALFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
