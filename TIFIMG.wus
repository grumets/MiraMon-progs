			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Escala</ows:Identifier>
				<ows:Title>Scale</ows:Title>
				<ows:Abstract>It is the denominator of the scale in which the TIFF files will be represented. Only used in the conversion from IMG to TIFF. Default value is 100000.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Scale"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
