	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TIFIMG:param1:9</ows:Identifier>
		<ows:Title>TIFF to IMG Landsat multiband</ows:Title>
		<ows:Abstract>This option converts Landsat multiband TIFF files to an IMG file per band.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Transformation to IMG Landsat multiband</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>9</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerLLista</ows:Identifier>
				<ows:Title>TIFF list file</ows:Title>
				<ows:Abstract>The name of the file list of TIFF layers.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:ListFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Processament</ows:Identifier>
				<ows:Title>Processing</ows:Title>
				<ows:Abstract><![CDATA[ <ul><li>0 LPGS</li><li>1NLAPS</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Processing"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Radiometria</ows:Identifier>
				<ows:Title>Radiometry</ows:Title>
				<ows:Abstract><![CDATA[ <ul><li>0 Metadata.</li><li>1 Chander.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Radiometry"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>META</ows:Identifier>
				<ows:Title>META file</ows:Title>
				<ows:Abstract>Allows you to indicate the auxiliary metadata file (* .META) for Landsat images (TM, ETM + and MSS) (* .TIF) for images processed by LPGS This file will allow documenting the capture time of the image that is in some metadata files (* .TXT). this file It should only be included in conjunction with the file metadata for Landsat.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MD</ows:Identifier>
				<ows:Title>Metadata file</ows:Title>
				<ows:Abstract><![CDATA[Allows you to indicate the metadata file (* .TXT) for images Landsat (TM, ETM + and MSS) (* .TIF) for both images processed by NLAPS or by LPGS. This file will allow you to document the REL associated with the image. It is important not to rename these files, which should have the WO and MTL termination depending on whether it is processed NLAPS or LPGS <span class="short_text" id="result_box" lang="us" xml:lang="ca"><span style="" title="">respectively</span></span>.]]></ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>IDIOMATIC</ows:Identifier>
				<ows:Title>Generate filenames in the MiraMon language</ows:Title>
				<ows:Abstract>In the case of multiband importing from Landsat satellites the output file names can be generated in the MiraMon language as well as the field descriptors.</ows:Abstract>
				<ows:Metadata xlink:title="Name:IDIOMATIC"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>DirectoriResultats</ows:Identifier>
				<ows:Title>Results directory</ows:Title>
				<ows:Abstract>Is the results directory where the files will be stored.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:ResultsDirectory"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>