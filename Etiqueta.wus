<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Etiqueta:Param1</ows:Identifier>
		<ows:Title>Etiqueta</ows:Title>
		<ows:Metadata xlink:title="Title:Generation of labels within a polygon"/>
		<ows:Metadata xlink:title="Abstract:This program allows to generate points which are labels of polygons from a POL file or a VEC file with explicit polygons. The new generated labels can or can not get the preexisting attributes of the polygons and in the same order as in the original polygons. The program allows, if desired, to place a label on polygon 0 (the external polygon that envelopes the rest of polygons)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>1: Creates a PNT file where each point lies within one of the polygons in the file Polygons_File (POL). All registries and fields of the polygons table which correspond to each point are transferred to the points table.</li><li>2: Creates a PNT file where each point lies within one polygon of the polygons in the file Polygons_File (POL). The resulting table has only one register with the graphical identifier for each point (no information from the polygons table is transferred, nor are there multiple records if the polygon layer had any).</li><li>3: Creates a VEC file point-type with the labels of the polygons file Polygons_File (VEC). The attribute of each point is the attribute of its corresponding polygon.</li><li>4: As in option 3, but each polygon is checked for having only one label of the points file. All detected problems are written to the screen.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitxer_Poligons</ows:Identifier>
				<ows:Title>Polygons file</ows:Title>
				<ows:Abstract>Polygons file.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Polygons_File"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Posicio</ows:Identifier>
				<ows:Title>Position</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>    1: The label is placed at a distance Tolerance (in X) from the left boundary.</li><li>    2: The label is centered between the right and left boundaries (Tolerance only applies to the position in polygon zero, which is at a distance Tolerance (in X) to the left of the minimum X boundary of the bounding box. This is the recommended option for POL files.</li><li>   3: The label is at a distance Tolerance (in X) of the right boundary.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Position"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Tolerancia</ows:Identifier>
				<ows:Title>Tolerance</ows:Title>
				<ows:Abstract>Distance (X) to locate the label.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Tolerance"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="0">
				<ows:Identifier>p_zero</ows:Identifier>
				<ows:Title>Label polygon zero</ows:Title>
				<ows:Abstract><![CDATA[(only valid for POL files)<ul><li>     0: With no label on polygon zero (default option).</li><li>     1: With label on polygon zero.</li><li>    2: With label on polygon zero with a very negative x position, which will not be taken into account in the calculation of the label layer bounding box. It is used when this label only has an analytical function, but is not intended to be represented on maps.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:p_zero"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Fitxer_Punts</ows:Identifier>
				<ows:Title>Points file</ows:Title>
				<ows:Abstract>Generated point file.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Points_File"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>