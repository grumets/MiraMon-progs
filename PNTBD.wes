<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:PNTBD:1</ows:Identifier>
		<ows:Title>Exportación de puntos PNT a DBF con coordenadas</ows:Title>
		<ows:Abstract>Exportación de ficheros PNT a una tabla DBF con las coordenadas x,y,z de cada punto.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Exportación de puntos PNT a DBF con coordenadas"/>
		<ows:Metadata xlink:title="Abstract:Exportación de ficheros PNT a una tabla DBF con las coordenadas x,y,z de cada punto."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerPNT</ows:Identifier>
				<ows:Title>Nombre Fichero PNT</ows:Title>
				<ows:Abstract>Nombre del fichero PNT a exportar</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:NombreFicheroPNT"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFitxerDBF</ows:Identifier>
				<ows:Title>Nombre Fichero DBF</ows:Title>
				<ows:Abstract>Nombre de la tabla DBF resultado.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NombreFicheroDBF"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
