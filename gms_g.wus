<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:gms_g:1</ows:Identifier>
		<ows:Title>gms_g</ows:Title>
		<ows:Abstract><![CDATA[This application allows to convert angular measurements:</p><ul>  <li>from sexagesimal degrees (degrees, minutes, and seconds, e.g. 15° 30' 36.72") to decimal degrees (degrees and decimal fractions of a degree, e.g., 5.51020000°) and vice versa</li><li>from sexagesimal or decimal degrees to radians (e.g.: 0.2707040576 rad) and vice versa</li></ul><p>as well as between hourly magnitudes:</p><ul><li>hours and decimal fractions of an hour to hours, minutes, and seconds, and vice versa (useful for converting, for example, satellite passing hours).</li></ul>]]></ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversion between angle/hour units"/>
		<ows:Metadata xlink:title="Abstract:This application allows to convert angular measurements:&lt;/p&gt;&lt;ul&gt;  &lt;li&gt;from sexagesimal degrees (degrees, minutes, and seconds, e.g. 15° 30&apos; 36.72&quot;) to decimal degrees (degrees and decimal fractions of a degree, e.g., 5.51020000°) and vice versa&lt;/li&gt;&lt;li&gt;from sexagesimal or decimal degrees to radians (e.g.: 0.2707040576 rad) and vice versa&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;as well as between hourly magnitudes:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;hours and decimal fractions of an hour to hours, minutes, and seconds, and vice versa (useful for converting, for example, satellite passing hours).&lt;/li&gt;&lt;/ul&gt;"/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusConversio</ows:Identifier>
				<ows:Title>Conversion type</ows:Title>
				<ows:Abstract><![CDATA[indicates the format of the input and output quantities. It can adopt several possible values:<ul><li>1 : Origin in decimal degrees and result in sexagesimal degrees</li><li>2 : Origin in sexagesimal degrees and result in decimal degrees</li><li>3 : Origin in degrees (decimal or sexagesimal) and result in radians</li><li>4 : Origin in radians and result in decimal degrees</li><li>5 : Origin in radians and result in sexagesimal degrees</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:ConversionType"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>AngleAConvertir</ows:Identifier>
				<ows:Title>Angle to convert</ows:Title>
				<ows:Abstract>Is the angle to convert to the units specified in the ConversionType option</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:AngleToConvert"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>AngleAConvertir</ows:Identifier>
				<ows:Title>Angle to convert</ows:Title>
				<ows:Abstract>Is the angle to convert to the units specified in the ConversionType option</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:AngleToConvert"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>