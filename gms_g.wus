<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:gms_g:Param1:1</ows:Identifier>
		<ows:Title>Origin in decimal degrees and result in sexagesimal degrees</ows:Title>
		<ows:Abstract>Origin in decimal degrees and result in sexagesimal degrees.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversion between angle/hour units"/>
		<ows:Metadata xlink:title="Abstract:This application allows to convert angular measurements:&lt;/p&gt;&lt;ul&gt;  &lt;li&gt;from sexagesimal degrees (degrees, minutes, and seconds, e.g. 15° 30&apos; 36.72&quot;) to decimal degrees (degrees and decimal fractions of a degree, e.g., 5.51020000°) and vice versa&lt;/li&gt;&lt;li&gt;from sexagesimal or decimal degrees to radians (e.g.: 0.2707040576 rad) and vice versa&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;as well as between hourly magnitudes:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;hours and decimal fractions of an hour to hours, minutes, and seconds, and vice versa (useful for converting, for example, satellite passing hours).&lt;/li&gt;&lt;/ul&gt;"/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Conversion type</ows:Title>
				<ows:Abstract>Origin in decimal degrees and result in sexagesimal degrees</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>AngleAConvertir</ows:Identifier>
				<ows:Title>Angle to convert</ows:Title>
				<ows:Abstract>Is the angle to convert to the units specified in the ConversionType option</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:AngleToConvert"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>StdOut</ows:Identifier>
				<ows:Title>Conversion result</ows:Title>
				<ows:Abstract>Conversion result</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
