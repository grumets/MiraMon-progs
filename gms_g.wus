<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GMS_G:1</ows:Identifier>
		<ows:Title>GMS_G</ows:Title>
		<ows:Abstract>This application allows to convert angular measurements between degrees, minutes and seconds, and radians.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversion between angular units"/>
		<ows:Metadata xlink:title="Abstract:This application allows to convert angular measurements between degrees, minutes and seconds, and radians."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusConversio</ows:Identifier>
				<ows:Title>Conversion type</ows:Title>
				<ows:Abstract><![CDATA[Indicates the format of the input and output quantities. It can adopt several possible values:<li>1. Origin in degrees, result in degrees, minutes and seconds</li><li>2.  Origin in degrees, minutes and seconds, result in degrees</li><li>3. Origin in degrees, result in radians.</li><li>4. Origin in radians, result in degrees.</li><li>5. Origin in radians, result in degrees, minutes and seconds.</li>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:ConversionType"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>AngleAConvertir</ows:Identifier>
				<ows:Title>Angle to convert</ows:Title>
				<ows:Abstract>Is the angle to convert to the units specified in the ConversionType option</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:AngleToConvert"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>AngleAConvertir</ows:Identifier>
				<ows:Title>Angle to convert</ows:Title>
				<ows:Abstract>Is the angle to convert to the units specified in the ConversionType option</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:AngleToConvert"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>