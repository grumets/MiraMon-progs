	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:j2kimg:Param1:8</ows:Identifier>
		<ows:Title>JPEG2000 MULTI</ows:Title>
		<ows:Abstract>Genera un fichero JPEG2000 multibanda a partir de n ficheros IMG los nombres de los cuales se dan en un fichero llista.
</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcion</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>8. JPEG2000 multibanda</ows:Abstract>
			<ows:Metadata xlink:title="Param1" />
		<LiteralData>
			<ows:AllowedValues><ows:Value>8</ows:Value></ows:AllowedValues>
		</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NombreFicheroLlista</ows:Identifier>
				<ows:Title>Nombre Fichero Llista</ows:Title>
				<ows:Abstract>Es el nombre del fichero con la llista de los n ficheros IMG para generar el fichero JPEG2000. 
</ows:Abstract>
			<ows:Metadata xlink:title="Param2" />
		<LiteralData>
			<ows:AllowedValues>anyUri</ows:AllowedValues>
		</LiteralData>
			</Input>				
		</DataInputs>
		<ProcessOutputs>	
	      	<Output>
				<ows:Identifier>NombreFicherJPEG</ows:Identifier>
				<ows:Title>Nom Ficher JPEG2000</ows:Title>
				<ows:Abstract>El nombre del fichero JPEG2000.
				</ows:Abstract>
					<ows:Metadata xlink:title="Param3" />
				<ComplexOutput>
					<Default>
						<Format>
						<MimeType>application/x-JPEG2000</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Default>
