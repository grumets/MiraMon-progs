							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALITAT_J2K</ows:Identifier>
				<ows:Title>Calidad JPEG2000</ows:Title>
				<ows:Abstract>Calidad de compresión de un fichero JPG2000, en un rango supraunitario (el valor 1 representa una compresión sin pérdida). El valor por defecto es 20. Los valores altos indican menos calidad pero más compresión.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
