				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>PatroFitxers</ows:Identifier>
				<ows:Title>Patrón Ficheros</ows:Title>
				<ows:Abstract>Es el patrón de los nombres de los ficheros IMG resultados de la transformación de un fichero JPEG2000 multibanda.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:PatronFicheros"/>
				<ComplexOutput>
