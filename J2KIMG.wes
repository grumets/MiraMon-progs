	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:J2KIMG:Param1:5</ows:Identifier>
		<ows:Title>JPEG2000 a partir de un fichero JPEG</ows:Title>
		<ows:Abstract>Genera un fichero JPEG2000 a partir de un fichero JPEG.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
