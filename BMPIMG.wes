<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:BMPIMG:Param1:0</ows:Identifier>
		<ows:Title>BMP Info</ows:Title>
		<ows:Abstract>Se proporciona información de la cabecera del fichero BMP.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversión entre ficheros ràster BMP y IMG"/>
		<ows:Metadata xlink:title="Abstract:Este programa transforma entre el formato IMG de MiraMon y el formato BMP."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Proporciona información de la cabecera del fichero BMP.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerBMP</ows:Identifier>
				<ows:Title>Fichero BMP</ows:Title>
				<ows:Abstract>El BMP (acrónimo de bitmap "mapa de bits") es un estándard de representación de imágenes basado en el mapa de bits.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroBMPEntrada"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>StdOut</ows:Identifier>
				<ows:Title>Estándar de salida</ows:Title>
				<ows:Abstract>Estándar de salida con información sobre el BMP.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:BMPIMG:Param1:1&!Param5</ows:Identifier>
		<ows:Title>IMGBMP</ows:Title>
		<ows:Abstract>Exporta un fichero IMG a un fichero BMP con paleta.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract><![CDATA[Exporta un fichero IMG a un fichero BMP, en función de las propiedades del fichero de entrada IMG:<ul><li>Exportación de un IMG con paleta a BMP. Si el dato de origen es de tipo BYTE o BYTE_RLE, se genera un BMP de 8 bits ( incluyendo la paleta de colores correspondiente). Si el dato de origen es de tipo BIT, se genera un BMP de 1 bit (incluyendo la paleta de colores correspondiente). Si el tipo de datos es diferente, no se genera ningún fichero.</li><li>Exportación de un IMG de combinación RGB (FicheroR, FicheroG, i FicheroB) a BMP. Se genera un BMP de 24 bits ( sin paleta de colores).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerIMG</ows:Identifier>
				<ows:Title>Fichero IMG</ows:Title>
				<ows:Abstract>Fichero IMG a exportar.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroIMG"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fichero DBF</ows:Title>
				<ows:Abstract>Fichero DBF que contiene la paleta de colores.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroDBF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerBMP</ows:Identifier>
				<ows:Title>Fichero BMP</ows:Title>
				<ows:Abstract>El BMP (acrónimo de bitmap "mapa de bits") es un estándard de representación de imágenes basado en el mapa de bits.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FicheroBMPEntrada"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:BMPIMG:Param1:1&Param5</ows:Identifier>
		<ows:Title>RGBBMP</ows:Title>
		<ows:Abstract>Exportación de un IMG dado como combinación RGB.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract><![CDATA[Exporta un fichero IMG a un fichero BMP, en función de las propiedades del fichero de entrada IMG:<ul><li>Exportación de un IMG con paleta a BMP. Si el dato de origen es de tipo BYTE o BYTE_RLE, se genera un BMP de 8 bits ( incluyendo la paleta de colores correspondiente). Si el dato de origen es de tipo BIT, se genera un BMP de 1 bit (incluyendo la paleta de colores correspondiente). Si el tipo de datos es diferente, no se genera ningún fichero.</li><li>Exportación de un IMG de combinación RGB (FicheroR, FicheroG, i FicheroB) a BMP. Se genera un BMP de 24 bits ( sin paleta de colores).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerR</ows:Identifier>
				<ows:Title>Fichero R</ows:Title>
				<ows:Abstract>Fichero Rojo.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroR"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerG</ows:Identifier>
				<ows:Title>Fichero G</ows:Title>
				<ows:Abstract>Fichero Verde.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroG"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerB</ows:Identifier>
				<ows:Title>Fichero B</ows:Title>
				<ows:Abstract>Fichero Azul.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FicheroB"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerBMP</ows:Identifier>
				<ows:Title>Fichero BMP</ows:Title>
				<ows:Abstract>El BMP (acrónimo de bitmap "mapa de bits") es un estándard de representación de imágenes basado en el mapa de bits.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:FicheroBMPEntrada"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:BMPIMG:Param1:2&!Param5</ows:Identifier>
		<ows:Title>BMPIMG</ows:Title>
		<ows:Abstract>Importa un fichero BMP a un fichero IMG,de 1 bit o de 8 bits con o sin paleta.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract><![CDATA[Importa un fichero BMP a un fichero IMG, en función de las propiedades del fichero de entrada BMP:<ul><li>Importación de un BMP a IMG. Si el BMP es de 1 bit o de 8 bits sin paleta, hace falta dar solo los nombres de los ficheros de entrada BMP y del fichero de salida IMG, ya que no se genera ningún fichero DBF (paleta). Si el BMP es de 1 bit o de 8 bits con paleta, hace falta dar los nombres del fichero de entrada BMP, del fichero DBF (paleta) i del fichero de salida IMG.</li><li>Importación; de un BMP a IMG. Para el resto de tipus BMP,  hace falta dar los nombres del fichero de entrada BMP y  de los ficheros de salida que forman la combinación RGB: FcheroR, FicheroG i FicheroB.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerBMP</ows:Identifier>
				<ows:Title>Fichero BMP</ows:Title>
				<ows:Abstract>El BMP (acrónimo de bitmap "mapa de bits") es un estándard de representación de imágenes basado en el mapa de bits.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroBMPEntrada"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FitxerDBF</ows:Identifier>
				<ows:Title>Fichero DBF</ows:Title>
				<ows:Abstract>Fichero DBF que contiene la paleta de colores.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FicheroDBF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerIMG</ows:Identifier>
				<ows:Title>Fichero IMG</ows:Title>
				<ows:Abstract>Fichero IMG a exportar.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroIMG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:BMPIMG:Param1:2&Param5</ows:Identifier>
		<ows:Title>BMPRGB</ows:Title>
		<ows:Abstract>Importa un fichero BMP a un fichero IMG,como combinación RGB.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract><![CDATA[Importa un fichero BMP a un fichero IMG, en función de las propiedades del fichero de entrada BMP:<ul><li>Importación de un BMP a IMG. Si el BMP es de 1 bit o de 8 bits sin paleta, hace falta dar solo los nombres de los ficheros de entrada BMP y del fichero de salida IMG, ya que no se genera ningún fichero DBF (paleta). Si el BMP es de 1 bit o de 8 bits con paleta, hace falta dar los nombres del fichero de entrada BMP, del fichero DBF (paleta) i del fichero de salida IMG.</li><li>Importación; de un BMP a IMG. Para el resto de tipus BMP,  hace falta dar los nombres del fichero de entrada BMP y  de los ficheros de salida que forman la combinación RGB: FcheroR, FicheroG i FicheroB.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerBMP</ows:Identifier>
				<ows:Title>Fichero BMP</ows:Title>
				<ows:Abstract>El BMP (acrónimo de bitmap "mapa de bits") es un estándard de representación de imágenes basado en el mapa de bits.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroBMPEntrada"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerR</ows:Identifier>
				<ows:Title>Fichero R</ows:Title>
				<ows:Abstract>Fichero Rojo.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroR"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxerG</ows:Identifier>
				<ows:Title>Fichero G</ows:Title>
				<ows:Abstract>Fichero Verde.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FicheroG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxerB</ows:Identifier>
				<ows:Title>Fichero B</ows:Title>
				<ows:Abstract>Fichero Azul.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:FicheroB"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>