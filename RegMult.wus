<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:RegMult:1</ows:Identifier>
		<ows:Title>Multiple regression + residual interpolation</ows:Title>
		<ows:Abstract>This module makes it possible to construct a predictive model of a Y spatial variable according to other (xn). independent spatial variables. </ows:Abstract>
		<ows:Metadata xlink:title="Title:Multiple regression + residual interpolation"/>
		<ows:Metadata xlink:title="Abstract: This module makes it possible to construct a predictive model of a Y spatial variable according to other (xn). independent spatial variables. "/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Multiple regression method:<![CDATA[<li>1: least squares fitting</li><li>2: least squares fitting with with residual interpolation</li>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Interpol</ows:Identifier>
				<ows:Title>Interpol</ows:Title>
				<ows:Abstract>Residual interpolation method:<![CDATA[<ul> If option is 1, there is not interpolation and you should indicate: <li>0: none.</li> If option is 2, indicate the type of residual interpolation once the regression has been carried out.<li>1: <k>spline</k>.</li><li>2: Inverse Distance Weighted</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:Interpol"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigen</ows:Identifier>
				<ows:Title>Origin File</ows:Title>
				<ows:Abstract>Vectorial file (PNT) or Database (DBF, MDB, ACCBD, DSN) with input data.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:OriginFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-msaccess</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Var_depe</ows:Identifier>
				<ows:Title>Dependent variable</ows:Title>
				<ows:Abstract>Field of the point file or Database which contains dependent variable to be modeled.</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:Depe_var"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>estadistic</ows:Identifier>
				<ows:Title>statistical</ows:Title>
				<ows:Abstract><![CDATA[statistical: statistical criteria to be used to choose the optimum regression.<ul><li>1: Cp of Mallows.</li><li>2: Adjusted coefficient of determination (adjusted R2)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:statistical"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>significacio</ows:Identifier>
				<ows:Title>significance</ows:Title>
				<ows:Abstract>Level of significance of the adjustment test (default value = 0.05)</ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:significance"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0.05</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>multireg</ows:Identifier>
				<ows:Title>Multireg</ows:Title>
				<ows:Abstract>Indicates how to treat the multi-register input data (default value = 1)<![CDATA[<ul><li>0: omit the point.</li><li>1: choose the first</li><li>2: calculate the mean value</li><li>3: calculate the sum.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:multireg"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Tipus_mostreig</ows:Identifier>
				<ows:Title>Type Sample</ows:Title>
				<ows:Abstract>Sampling option, i.e. how the adjustment points and the test points are distributed.<![CDATA[<ul><li>1: predefined</li><li>2: random with fixed seed (reproducible selection of adjustment points).</li><li>3: random with variable seed (selection of adjustment points not).</li><li>4: cross validation.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param08"/>
				<ows:Metadata xlink:title="Name:type_sample"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>valor_mostreig</ows:Identifier>
				<ows:Title>Value Sample</ows:Title>
				<ows:Abstract>If value_sample is 1, i.e. predefined sample, this parameter indicates the field that decides which points are adjustment points (value _A_ in the field) and which are test points (value _T_ in the field). If the sampling is random, type_sample 2 or 3, this indicates the percentage of adjustment points, the rest up to 100% determine the percentage of test points. Si type_sample 4, this parameter has no meaning and should indicate 0.</ows:Abstract>
				<ows:Metadata xlink:title="Param09"/>
				<ows:Metadata xlink:title="Name:value_sample"/>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxersVariablesIndependents</ows:Identifier>
				<ows:Title>Independent Variable Files</ows:Title>
				<ows:Abstract>File or IMG raster files corresponding to the independent variables proposed. They should all have the same pixel size and geographical area.</ows:Abstract>
				<ows:Metadata xlink:title="Param12"/>
				<ows:Metadata xlink:title="Name:IndependentVariableFiles"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PESOS</ows:Identifier>
				<ows:Title>Points weight field</ows:Title>
				<ows:Abstract>Field of the point file or Database which define the weitght of each point to interpolate</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MASCARA</ows:Identifier>
				<ows:Title>MASCARA</ows:Title>
				<ows:Abstract>Name of the file which determines on which regions of the resulting raster the regression and the interpolation should be carried out. If non-existent, the whole defined area will be covered.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPER_MASC</ows:Identifier>
				<ows:Title>Operator</ows:Title>
				<ows:Abstract>Equality (EQ) or inequality (NO_EQ) operator, which determines which polygons should be included in the regression when the mask is not the universal polygon.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>EQ</ows:Value>
						<ows:Value>NO_EQ</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ATR_MASC</ows:Identifier>
				<ows:Title>Attribute Masc</ows:Title>
				<ows:Abstract>Attribute which determines which polygons should be included in the regression when the mask is not the universal polygon.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_MASC</ows:Identifier>
				<ows:Title>Masc Field</ows:Title>
				<ows:Abstract>Alphanumeric text which indicates the field that decides the regions in which to calculate the result and where to assign NODATA, depending on whether the content is valid and verifies or not the selection defined by /OPER_MASC and /ATR_MASC. See general syntax for further information..</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REPE_MASC</ows:Identifier>
				<ows:Title>Multiple Register</ows:Title>
				<ows:Abstract>Index which, when the mask is a structured file with multiple regression, indicates which register determines the attribute of the polygon. This index is numbered from 1 starting with the first register corresponding to a given graphic indicator, or from _1 if numbering starts from the last one.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>EXPONENT</ows:Identifier>
				<ows:Title>Exponent</ows:Title>
				<ows:Abstract>Exponent which indicates the degree of inverse dependence in relation to distance, for example, default value 2 indicates the inverse square distance.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TENSIO</ows:Identifier>
				<ows:Title>Tension</ows:Title>
				<ows:Abstract>Modulates the smoothness of the <![CDATA[<k>spline</k>]]> function. It is a decimal value >= 0 with a default value of 50.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>50</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>APLAN</ows:Identifier>
				<ows:Title>Deviation</ows:Title>
				<ows:Abstract>Level of deviation or tolerance with respect to the exact interpolation in the adjustment points. It is a decimal value >= 0 with a default value of 50.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MIN_VALOR_INTP</ows:Identifier>
				<ows:Title>Minimal Threshold</ows:Title>
				<ows:Abstract>Inferior saturation value to avoid extreme values out of range in the residual interpolation raster. Inoperative unless selected.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MAX_VALOR_INTP</ows:Identifier>
				<ows:Title>Maximum Threshold</ows:Title>
				<ows:Abstract>Superior saturation value to avoid extreme values out of range in the residual interpolation raster. It must be greater or equal to the /MIN_VALOR_INTP. Inoperative unless selected.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MIN_VALOR_REG</ows:Identifier>
				<ows:Title>Inferior saturation</ows:Title>
				<ows:Abstract>Inferior saturation value to avoid extreme values out of range in the result raster. Inoperative unless selected.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MAX_VALOR_REG</ows:Identifier>
				<ows:Title>Superior saturation</ows:Title>
				<ows:Abstract>Superior saturation value to avoid extreme values out of range in the result raster.. It must be greater or equal to the /MIN_VALOR_REG. Inoperative unless selected.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>COND#_FIELD</ows:Identifier>
				<ows:Title>Field of Condition #</ows:Title>
				<ows:Abstract>Field name of # condition of selection. It may be made up to 100 simple queries and 100 field names (COND#_CAMP) starting at index 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>COND#_OP</ows:Identifier>
				<ows:Title>Operation of condition #</ows:Title>
				<ows:Abstract>Opertation of # condition of selection. It may be made up to 100 simple queries and 100 operations (COND#_OP) starting at index 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>EQ</ows:Value>
						<ows:Value>NO_EQ</ows:Value>
						<ows:Value>LT</ows:Value>
						<ows:Value>GT</ows:Value>
						<ows:Value>LT_EQ</ows:Value>
						<ows:Value>GT_EQ</ows:Value>
						<ows:Value>INTERVAL</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>COND#_VALOR</ows:Identifier>
				<ows:Title>Value of condition #</ows:Title>
				<ows:Abstract>Value of # condition of selection. It may be made up to 100 simple queries and 100 values (COND#_VALOR) starting at index 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="99">
				<ows:Identifier>COND#_NEXE</ows:Identifier>
				<ows:Title>Nexus linking of condition #</ows:Title>
				<ows:Abstract>Nexus use to linking for the successive selections. In this case to linking between condition # and condition #+1. It may be made up to 100 simple queries and 99 nexus (COND#_NEXE) starting at index 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>AND</ows:Value>
						<ows:Value>OR</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="99">
				<ows:Identifier>COND#_PRIOR</ows:Identifier>
				<ows:Title>Priority of nexus linking of condition #</ows:Title>
				<ows:Abstract>Priority of nexus use to linking for the successive selections. In this case to linking between condition # and condition #+1. It may be made up to 100 simple queries and 99 priorities (COND#_PRIOR) starting at index 1. This is an optional parameter. If it is not indicated the priority is just the order.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>1</ows:MinimumValue>
							<ows:MaximumValue>99</ows:MaximumValue>
						</ows:Range>
						<ows:Value/>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerResultat</ows:Identifier>
				<ows:Title>Result File</ows:Title>
				<ows:Abstract>IMG raster file of the modelization, whether it be regression+interpolation or only regression.</ows:Abstract>
				<ows:Metadata xlink:title="Param10"/>
				<ows:Metadata xlink:title="Name:ResultFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxerInforme</ows:Identifier>
				<ows:Title>Information File</ows:Title>
				<ows:Abstract>Text file containing information about the results of the regression.</ows:Abstract>
				<ows:Metadata xlink:title="Param11"/>
				<ows:Metadata xlink:title="Name:InformationFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
