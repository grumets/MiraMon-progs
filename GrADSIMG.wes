<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GrADSIMG:param1</ows:Identifier>
		<ows:Title>GrADSIMG</ows:Title>
		<ows:Abstract>Esta aplicación permite la importación del formato raster del software GrADS. GrADS responde a las iniciales de Grid Analysis and Display System y es un entorno común en el ámbito meteorológico.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importación del formato ráster GrADS"/>
		<ows:Metadata xlink:title="Abstract:Esta aplicación permite la importación del formato raster del software GrADS. GrADS responde a las iniciales de Grid Analysis and Display System y es un entorno común en el ámbito meteorológico."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>1 si desea que no se reproyecte el ráster original, es decir que se mantenga en el sistema de referencia del fichero GrADS.</li><li>2 si desea que se reproyecte a cualquiera de los sistemas de referencia soportados por MiraMon. Hay que identificar correctamente el datum del sistema de referencia origen.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigen</ows:Identifier>
				<ows:Title>Fichero Origen</ows:Title>
				<ows:Abstract>Es el fichero que desea importar (con extensión).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_ORI</ows:Identifier>
				<ows:Title>Sistema de referencia original.</ows:Title>
				<ows:Abstract>Indica el identificador del sistema de referencia del fichero GrADS. Su valor por defecto es lat/long-ED50.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Sistema de referencia destino</ows:Title>
				<ows:Abstract>Indica el identificador del sistema de referencia del fichero destino. Su valor por defecto se halla en la clave RefSystem= de la sección [Metrica] del fichero de configuración MiraMon.par</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>DirectoriDesti</ows:Identifier>
				<ows:Title>Directorio Destino</ows:Title>
				<ows:Abstract>Es el directorio donde se crearán todas las bandas IMG resultado de la importación.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:DirectorioDestino"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>