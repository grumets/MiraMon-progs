	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:16</ows:Identifier>
		<ows:Title><![CDATA[GEMI (<i>global environment monitoring index</i>, índice de seguimiento global del medio ambiente)]]></ows:Title>
		<ows:Abstract><![CDATA[<p>Índice propuesto para imágenes del sensor AVHRR de NOAA con la finalidad de obtener un conocimiento global de la vegetación en todo el planeta. Es un índice no lineal que minimiza el efecto del suelo y de la atmósfera.<br><center>GEMI= &#951; · (1 - 0.25·&#951;) - (&#961;<sub>R</sub> - 0.125) · (1 - &#961;<sub>R</sub>)</center><br>donde:<br><center>&#951;= [2· (&#961;<sup>2</sup><sub>IRc</sub> - &#961;<sup>2</sup><sub>R</sub>) + 1.5 · &#961;<sub>IRc</sub> + 0.5· &#961;<sub>R</sub>] · (&#961;<sub>IRc</sub> + &#961;<sub>R</sub> + 0.5)</center><br>donde <br>&#961;<sub>IRc</sub> es la reflectancia en la región espectral del infrarrojo cercano<br>&#961;<sub>R</sub> es la reflectancia en la región espectral del rojo.</p>]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract><![CDATA[GEMI (<i>global environment monitoring index</i>, índice de seguimiento global del medio ambiente)]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>16</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IRc</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del infrarrojo cercano.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:BandaIRc"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaR</ows:Identifier>
				<ows:Title>Banda R</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del rojo.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BandaR"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Imagen de salida</ows:Title>
				<ows:Abstract>Nombre de la imagen de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ImagenSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
