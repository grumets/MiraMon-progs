						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaR</ows:Identifier>
				<ows:Title>Banda R</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del rojo.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BandaR"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>a</ows:Identifier>
				<ows:Title>a</ows:Title>
				<ows:Abstract>Parámetro "a" de las ecuaciones. Si no se dan los parámetros, el programa también funciona interactivamente, pero hay que pasarle siempre los nombres de las imágenes (tanto de entrada como de salida) y el índice a calcular.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:a"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>b</ows:Identifier>
				<ows:Title>b</ows:Title>
				<ows:Abstract>Parámetro "b" de las ecuaciones. Si no se dan los parámetros, el programa también funciona interactivamente, pero hay que pasarle siempre los nombres de las imágenes (tanto de entrada como de salida) y el índice a calcular.</ows:Abstract>
