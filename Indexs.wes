				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Imágen de salida</ows:Title>
				<ows:Abstract>Nombre de la imágen de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:ImagenSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:20</ows:Identifier>
		<ows:Title>AFRI2.1 (Aerosol Free Vegetation Index 2.1)</ows:Title>
		<ows:Abstract><![CDATA[El AFRI2.1 se desarrolla a partir del NDVI y usa las bandas del infrarrojo de onda corta IRoc, de 2.1 µm, en lugar de la del rojo para reducir los efectos de los aerosoles. Se propone con la banda de MODIS <span class="style7">p</span><sub>2.1</sub>) y la banda del infrarojo cercano, IRp. <br/><br/><img src="Indexs_AFRI_2.1.GIF"/><br/><br/> La ventaja del AFRI se basa en la capacidad de las bandas del IRoc de penetrar en la columna atmosférica, incluso con la presencia de humo y sulfatos. Por lo tanto estos índices tienen una funcionalidad para la evaluación de la vegetación en presencia de humo, polución antrópicas o erupciones volcánicas. Se debe tener en cuenta que en condiciones de cielos claros con baja influencia atmosférica estos índices se encuentran altamente correlacionados con el NDVI <br/><br/><b>Karnieli A,  Kaufman YJ, Remer L,  Wald A</b> (2001) <i>AFRI  Aerosol free vegetation index</i>. Remote Sensing of Environment, 77(1):10-21.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>AFRI2.1 (Aerosol Free Vegetation Index 2.1)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>20</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IRp</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del infrarojo cercano.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:BandaIRp"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Banda_7_MODIS</ows:Identifier>
				<ows:Title>Banda 7 del sensor MODIS</ows:Title>
				<ows:Abstract>Banda que corresponde al canal 7 del sensor MODIS.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Banda_7_MODIS"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Imágen de salida</ows:Title>
				<ows:Abstract>Nombre de la imágen de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ImagenSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:21</ows:Identifier>
		<ows:Title>AFRI1.6 (Aerosol Free Vegetation Index 1.6)</ows:Title>
		<ows:Abstract><![CDATA[El AFRI1.6 se desarrolla a partir del NDVI y usa las bandas del infrarrojo de onda corta IRoc, de 1.6 µm, en lugar de la del rojo para reducir los efectos de los aerosoles. Se propone con la banda de MODIS <span class="style7">p</span><sub>1.6</sub>) y la banda del infrarojo cercano, IRp. <br/><br/><img src="Indexs_AFRI_1.6.GIF"/><br/><br/> La ventaja del AFRI se basa en la capacidad de las bandas del IRoc de penetrar en la columna atmosférica, incluso con la presencia de humo y sulfatos. Por lo tanto estos índices tienen una funcionalidad par la evaluación de la vegetación en presencia de humo, polución antrópicas o erupciones volcánicas. Hay que tener en cuenta que en condiciones de cielos claros con baja influencia atmosférica estos índices se encuentran altamente correlacionados con el NDVI <br/><br/><b>Karnieli A,  Kaufman YJ, Remer L,  Wald A</b> (2001) <i>AFRI  Aerosol free vegetation index</i>. Remote Sensing of Environment, 77(1):10-21.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>AFRI1.6 (Aerosol Free Vegetation Index 1.6)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>21</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IRp</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del infrarojo cercano.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:BandaIRp"/>
				<ComplexData>
