	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:11</ows:Identifier>
		<ows:Title>TWVI (Two-axis adjusted Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[Estudiando la complejidad de la línea de los suelos, se propone un índice que mejora en algunos aspectos del PVI y del SAVI, sobre todo cuando la distancia D entre un píxel de suelo sin vegetación hasta la línea de los suelos es grande:<br/><br/><img  src="Indexs_TWVI.gif"/><br/><br/>donde <img  src="Indexs_TWVIn.gif"/>]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>TWVI (Two-axis adjusted Vegetation Index)</ows:Title>
