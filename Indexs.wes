	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:19</ows:Identifier>
		<ows:Title>EVI  (Enhanced Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[El EVI obtiene respuesta de las variaciones estructurales del dosel vegetal incluyendo el índice de área foliar (LAI), tipo y arquitectura del dosel y etc. EVI fue desarrollado para optimizar la señal de la vegetación con sensibilidad mejorada para altas densidades de biomasa. Esta optimización se logra al separar la señal proveniente de la vegetación de la influencia atmosférica.<br><br><img  src="Indexs_EVI.GIF"/><br/><br/>El EVI es un NDVI mejorado con un factor de corrección del suelo L=1, dos coeficientes C1=6 y C2=7.5 que intentan corregir efectos de dispersión atmosférica y un factor de ganancia (<i>gain factor</i>) G=2.5 para los datos del sensor MODIS.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>EVI (Enhanced Vegetation Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>19</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IRp</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del infrarojo cercano.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:BandaIRp"/>
				<ComplexData>
					<Default>
