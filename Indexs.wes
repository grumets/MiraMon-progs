	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:7</ows:Identifier>
		<ows:Title>SAVI (Soil Adjusted Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[Índice que pretende minimizar el efecto del suelo sobre los índices de vegetación anteriores, especialmente manifiesto en superficies parcialmente recubiertas.<br/><br/><img alt="Imagen no visible desde DOS" src="SAVI.gif"/><br/><br/>L = constante que depende del tipo de suelo. Un valor típico es 0.5.]]></ows:Abstract>
