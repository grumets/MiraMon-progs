	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:15</ows:Identifier>
		<ows:Title>AVI (Angular Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[El AVI (Plummer et al. 1994) se propuso para el sensor ATSR-2, y pretende utilizar la disponibilidad del canal verde para normalizar los efectos del suelos y de la atmósfera, manteniendo la sensibilidad a las propiedades de la vegetación. El índice se basa en un concepto geométrico del ángulo definido entre las bandas verde, rojo e infrarrojo próximo, que caracteriza a la absorción de la clorofila.<br/><br/><img alt="Imagen no visible desde DOS" src="AVI.gif"/><br/><br/>Las<img alt="Imagen no visible desde DOS" src="Lambda.gif"/>corresponden a los centros de cada una de las bandas.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>AVI (Angular Vegetation Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>15</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IR</ows:Title>
