	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:7</ows:Identifier>
		<ows:Title>SAVI (Soil Adjusted Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[Índice que pretende minimizar el efecto del suelo sobre los índices de vegetación anteriores, especialmente manifiesto en superficies parcialmente recubiertas.<br/><br/><img  src="Indexs_SAVI.gif"/><br/><br/>"L" es una constante que depende de la cobertura de vegetación y que puede tomar un valor comprendido entre 0 y 1. A menudo se utiliza L=0 para densidades de vegetación muy altas, L=0.5 para densidades intermedias y L=1 para densidades de vegetación muy bajas.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>SAVI (Soil Adjusted Vegetation Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>7</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IRp</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del infrarojo cercano.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:BandaIRp"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaR</ows:Identifier>
				<ows:Title>Banda R</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del rojo.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BandaR"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>L</ows:Identifier>
				<ows:Title>L</ows:Title>
				<ows:Abstract>Parámetro "L" de las ecuaciones. Si no se dan los parámetros, el programa también funciona interactivamente, pero hay que pasarle siempre los nombres de las imágenes (tanto de entrada como de salida) y el índice a calcular.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:L"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Imágen de salida</ows:Title>
				<ows:Abstract>Nombre de la imágen de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ImagenSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
