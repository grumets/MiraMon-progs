	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:22</ows:Identifier>
		<ows:Title>PRI (Photochemical Reflectance Index)</ows:Title>
		<ows:Abstract><![CDATA[El PRI es un índice de eficiencia fotosintética de la vegetación útil en la estimación del balance de carbono en los ecosistemas mediterráneos.<br/><br/>En efecto, el bosque mediterráneo perennifolio presenta una estacionalidad muy baja en índices de vegetación como el NDVI o el EVI, a pesar de tener una gran estacionalidad de la fijación del carbono. En estos casos, el PRI permite detectar qué parte de la capacidad de fijación del carbono se ha hecho efectiva. Se calcula:   .<br/><br/><img  src="Indexs_PRI.GIF"/><br/><br/>donde la <img  src="Indexs_PRI_531.GIF"/> y la <img  src="Indexs_PRI_570.GIF"/> corresponden a las reflectancias en las longitudes de onda 531 nm y 570 nm, respectivamente. Estas longitudes de onda pueden verse ligeramente modificadas en función del sensor, la especie, etc.<br><br>El PRI está relacionado con el uso de la radiación, con valores comprendidos entre ?1 y 1, crecientes cuando se incrementa la eficiencia fotosintética. <br><br><b>Gamon J, Peñuelas J, Field C</b> (1992) <i>A narrow-waveband spectral index that tracks diurnal changes in photosynthetic efficiency</i>. Remote Sensing of Environment, 41, 35-44.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>PRI (Photochemical Reflectance Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>22</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Banda_570_nm</ows:Identifier>
				<ows:Title>Banda de 570 nm</ows:Title>
				<ows:Abstract>Banda de longitud de onda 570 nm.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Banda_570_nm"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Banda_531_nm</ows:Identifier>
				<ows:Title>Banda de 531 nm</ows:Title>
				<ows:Abstract>Banda de longitud de onda 531 nm.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Banda_531_nm"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Imágen de salida</ows:Title>
				<ows:Abstract>Nombre de la imágen de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ImagenSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:23</ows:Identifier>
		<ows:Title>NDSI (Normalized Difference Snow Index)</ows:Title>
		<ows:Abstract><![CDATA[Índice que permite la detección de la cubierta nivoso. Se calcula:  <br><br><img src="Indexs_NDSI.GIF"/><br/><br/>donde <img src="Indexs_RoV.GIF"/> y <img src="Indexs_RoIRoc.GIF"/> corresponden a las reflectancias en la región espectral del verde y del IRoc, respectivamente, ya que la nieve es muy reflexiva en el visible y, en cambio, absorbente en el infrarrojo de onda corta. En el caso de datos del sensor TM se utiliza como IRoc la banda 5. Valores del NDSI superiores a 0.4 corresponden a zonas con cubierta nival.<br/><br/>Varios autores recomiendan aplicar máscaras en zonas de sombras y existencia de lagos para evitar la confusión con áreas innivadas.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>NDSI (Normalized Difference Snow Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>23</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaV</ows:Identifier>
				<ows:Title>Banda del verde</ows:Title>
				<ows:Abstract>Banda que corresponde al verde.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:BandaV"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIRoc</ows:Identifier>
				<ows:Title>Banda del IRoc</ows:Title>
				<ows:Abstract>Banda que corresponde al infrarrojo medio.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BandaIRoc"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Imágen de salida</ows:Title>
				<ows:Abstract>Nombre de la imágen de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ImagenSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:24</ows:Identifier>
		<ows:Title>BI (Brightness Index)</ows:Title>
		<ows:Abstract><![CDATA[Índice empleado en el estudio de las condiciones de los suelos (color, humedad y estructura), especialmente en las regiones áridas y semiáridas.<br><br>Se calcula:<br><br><img src="Indexs_BI.GIF"/><br><br>donde <img  src="Indexs_RoR.GIF"/> es la reflectancia en la región espectral del rojo y <img src="Indexs_RoIRp.GIF"/> es la reflectancia en la región espectral del infrarrojo cercano.<br><br>Al no tratarse de un índice normalizado, el resultado no está acotado superiormente por ninguna constante. Valores altos del BI indican una mayor reflectancia, situación que corresponde a suelos secos, descubiertos y de color claro.<br><br>El uso de este índice está recogido en la página 81 de la tesis doctoral de <b>Sebastien Rapinel</b> (2012) <i>Contribution de la télédétection à l'évaluation des fonctions des zones humides: de l'observation à la modélisation prospective</i>, disponible en <a href="https://tel.archives-ouvertes.fr/tel-00731169/document">https://tel.archives-ouvertes.fr/tel-00731169/document</a>. También existe una formulació similar en <b>Escadafal R, Bacha S</b> (1995) <i>Strategy for the Dynamic Study of Desertification</i>, Proceedings of the ISSS International Symposium, Ouagadougou, Burkina Faso, 6-10 February 1995, pp. 19-34, disponible en  <a href="https://horizon.documentation.ird.fr/exl-doc/pleins_textes/pleins_textes_6/colloques2/010008392.pdf">https://horizon.documentation.ird.fr/exl-doc/pleins_textes/pleins_textes_6/colloques2/010008392.pdf</a>, que utiliza una formulación (pág. 27 del texto impreso) donde añade a la suma el cuadrado de la reflectancia en la banda del verde. Por último, en el trabajo de <b>Marques et al.</b> (2020) <i>The use of remote sensing to detect the consequences of erosion in gypsiferous soils</i> Water Conservation Research, 8:383e392, se utiliza una formulación similar (ecuación 2), pero con las bandas del verde y rojo, seguramente menos informativa por la alta correlación habitual entre estas bandas.  <br><br>Nota: Se suele atribuir referencias a este índice que son erróneas o que usan en realidad otras aproximaciones (combinaciones lineales como el brillo de la transformación Tasseled Cap, etc). Para evitar confusiones y pérdidas de tiempo a los usuarios de MiraMon, a continuación se facilita una referencia que NO tiene relación con el índice 24 que está implementado en esta aplicación:<br><br><b>Escadafal R, Belghith A, Ben Moussa H</b> (1994) <i>Indices spectraux pour la dégradation des milieux naturels en Tunisie aride</i>. 6ème Symp. Int. Mesures Physiques et Signatures en Télédétection. ISPRS-CNES <a href="https://horizon.documentation.ird.fr/exl-doc/pleins_textes/pleins_textes_5/b_fdi_20-21/26946.pdf">https://horizon.documentation.ird.fr/exl-doc/pleins_textes/pleins_textes_5/b_fdi_20-21/26946.pdf</a>.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>IB (Brightness Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>24</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IRp</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del infrarojo cercano.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:BandaIRp"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaR</ows:Identifier>
				<ows:Title>Banda R</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del rojo.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BandaR"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Imágen de salida</ows:Title>
				<ows:Abstract>Nombre de la imágen de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ImagenSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:25</ows:Identifier>
		<ows:Title>NDWI-Chen (Normalized Difference Water Index Chen, Huang, Jackson)</ows:Title>
		<ows:Abstract><![CDATA[Índice propuesto por Chen y colaboradores en 2005 para determinar el contenido de agua en la vegetación con datos del sensor MODIS. Se basa en la absorción del agua en el IRoc y se calcula:  <br/><br/><img src="Indexs_NDWI_Chen.gif"/><br/><br/> donde <img src= "Indexs_RoIRp.gif"/> y <img src="Indexs_RoIRoc.gif"/> corresponden a la reflectancia en la región espectral centrada en 858 nm y 1640 (o 2130) nm, respectivamente; formulado así, el NDWI toma valores entre ligeramente negativos y 1 en función del contenido de agua de la vegetación.<br/><br/><b>Chen D, Huang J, Jackson TJ</b> (2005) <i>Vegetation water content estimation for corn and soybeans using spectral indices derived from MODIS near- and short-wave infrared bands</i>. Remote Sensing of Environment, 98:225-236. Este índice corresponde al explicado en la entrada NDWI<sup>2</sup> de la obra de Pons y Arcalís (2012).]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>NDWI-Chen (Normalized Difference Water Index Chen, Huang, Jackson)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>25</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IRp</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del infrarojo cercano.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:BandaIRp"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIRoc</ows:Identifier>
				<ows:Title>Banda del IRoc</ows:Title>
				<ows:Abstract>Banda que corresponde al infrarrojo medio.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BandaIRoc"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Imágen de salida</ows:Title>
				<ows:Abstract>Nombre de la imágen de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ImagenSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>