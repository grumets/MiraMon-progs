<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:1</ows:Identifier>
		<ows:Title>DVI (Differential Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[Diferencia entre la reflectancia en la banda del infrarrojo cercano (IRp) y del rojo (R) de un sensor.<br/><br/><img src="Indexs_DVI.gif"/><br/>]]></ows:Abstract>
		<ows:Metadata xlink:title="Title:Programa para calcular índices de vegetación y otros índices de interés en teledetección"/>
		<ows:Metadata xlink:title="Abstract:Este programa permite calcular un conjunto predefinido de índices de vegetación y otros índices de interés en teledetección a partir de un conjunto predefinido. En caso de que el índice de interés no esté disponible en este programa, se puede calcular a través de la aplicación &lt;a href=&quot;CalcIMG.htm&quot;&gt;CalcImg&lt;/a&gt;. También se puede utilizar &lt;a href=&quot;CalcIMG.htm&quot;&gt;CalcImg&lt;/a&gt; para reescalar los valores de salida."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>DVI (Differential Vegetation Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IRp</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del infrarojo cercano.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:BandaIRp"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaR</ows:Identifier>
				<ows:Title>Banda R</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del rojo.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BandaR"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Imágen de salida</ows:Title>
				<ows:Abstract>Nombre de la imágen de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ImagenSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:2</ows:Identifier>
		<ows:Title>RVI (Ratio Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[Cociente simple entre la reflectancia en la banda del infrarrojo próximo y del rojo que se ha usado para estimaciones de biomasa e índice de área foliar (LAI) desde 1969.<br/><br/><img src="Indexs_RVI.gif"/>]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>RVI (Ratio Vegetation Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IRp</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del infrarojo cercano.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:BandaIRp"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaR</ows:Identifier>
				<ows:Title>Banda R</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del rojo.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BandaR"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Imágen de salida</ows:Title>
				<ows:Abstract>Nombre de la imágen de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ImagenSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:3</ows:Identifier>
		<ows:Title>NDVI (Normalized Difference Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[El índice de vegetación NDVI ha sido el más usado en teledetección de vegetación durante las dos últimas décadas. Fue utilizado por primera vez por Kriegler <i>et al.</i> (<b>Kriegler FJ, Malila WA, Nalepka RF i Richardson W</b> (1969) <i>Preprocessing transformations and their effects on multispectral recognition</i>. Proceedings of the Sixth International Symposium on Remote Sensing of Environment, p. 97-131) y desarrollado por Rouse <i>et al.</i> <b>(Rouse JW, Haas, RH, Schell, JA i Deering, DW</b> (1973) <i>Monitoring Vegetation Systems in the Great Plains with ERTS</i>. Third ERTS Symposium, NASA SP-351, I:309-317 (1973)) a partir del análisis de datos de Landsat-MSS. Se encontró que, aunque el cociente simple (RVI) podía ser usado como una medida relativa de verdor, la localización y desviaciones cíclicas podían introducir un importante error. De esta manera se define el índice de vegetación de diferencia normalizada como:<br/><br/><img src="Indexs_NDVI.gif"/><br/><br/>Un aspecto interesante de este índice frente al cociente simple es que toma valores entre -1 y 1, lo cual facilita notablemente su interpretación. Este índice se ha usado para estimar gran número de variables: el índice de área foliar (LAI), el flujo neto de CO<sub>2</sub>, la radiación fotosintéticamente activa absorbida por la planta (APAR), la productividad neta de la vegetación, el contenido de clorofila, la dinámica fenológica, la evapotranspiración potencial, la cantidad de lluvia recibida por la cubierta vegetal, etc. Las aplicaciones más habituales son: para el seguimiento de las condiciones de la cubierta vegetal a escala global, estudios de deforestación, desertización, detección de incendios, caracterización de biomas a escala global y prevención de sequía y riesgo de incendios forestales a partir del análisis de series multitemporales.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>NDVI (Normalized Difference Vegetation Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IRp</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del infrarojo cercano.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:BandaIRp"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaR</ows:Identifier>
				<ows:Title>Banda R</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del rojo.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BandaR"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Imágen de salida</ows:Title>
				<ows:Abstract>Nombre de la imágen de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ImagenSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:4</ows:Identifier>
		<ows:Title>TVI (Transformed Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[Transformación del NDVI que evita trabajar con valores negativos.<br/><br/><img  src="Indexs_TVI.gif"/>]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>TVI (Transformed Vegetation Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IRp</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del infrarojo cercano.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:BandaIRp"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaR</ows:Identifier>
				<ows:Title>Banda R</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del rojo.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BandaR"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Imágen de salida</ows:Title>
				<ows:Abstract>Nombre de la imágen de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ImagenSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:5</ows:Identifier>
		<ows:Title>PVI (Perpendicular Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[Índice de vegetación basado en el hecho que la reflectancia en el IRp y el rojo varían conjuntamente, y en sentido contrario, con el aumento de la densidad de la vegetación, y que estas variaciones conllevan que un punto situado sobre la línea de base del suelo en el que se incremente la cantidad de vegetación se separe de la línea en sentido ascendente y hacia la izquierda. <br/><br/><img  src="Indexs_PVI.gif"/><br/><br/>donde "S" indica que las reflectancias corresponden al suelo y V a la vegetación, respectivamente, y "a" y "b" son pendiente y ordenada en el origen de la línea de suelo, respectivamente.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>PVI (Perpendicular Vegetation Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>5</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IRp</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del infrarojo cercano.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:BandaIRp"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaR</ows:Identifier>
				<ows:Title>Banda R</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del rojo.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BandaR"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>a</ows:Identifier>
				<ows:Title>a</ows:Title>
				<ows:Abstract>Parámetro "a" de las ecuaciones. Si no se dan los parámetros, el programa también funciona interactivamente, pero hay que pasarle siempre los nombres de las imágenes (tanto de entrada como de salida) y el índice a calcular.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:a"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>b</ows:Identifier>
				<ows:Title>b</ows:Title>
				<ows:Abstract>Parámetro "b" de las ecuaciones. Si no se dan los parámetros, el programa también funciona interactivamente, pero hay que pasarle siempre los nombres de las imágenes (tanto de entrada como de salida) y el índice a calcular.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:b"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeSortida</ows:Identifier>
				<ows:Title>Imágen de salida</ows:Title>
				<ows:Abstract>Nombre de la imágen de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ImagenSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:6</ows:Identifier>
		<ows:Title>WDVI (Weighted Difference Vegetation Index)</ows:Title>
		<ows:Abstract><![CDATA[Índice de vegetación que modula la respuesta del NDII (véase Pons y Arcalís, 2012, para detalles).<br/><br/><img src="Indexs_WDVI.gif"/><br/><br/ >donde "a" es la pendiente de la línea de base del suelo. El resultado puede tomar valores muy diversos, y, por tanto, es difícil establecer unos márgenes concretos, si bien como aproximación puede decirse que valores del WDVI negativos corresponden a zonas de agua, valores en torno a cero corresponden a suelo desnudo y valores positivos corresponden a vegetación activa, con mayor vigor de la vegetación cuanto mayor es el valor obtenido.<br/><br/>Este índice corresponde a l'<a href="https://www.termcat.cat/ca/diccionaris-en-linia/197/search/WDVI?type=basic&condition=match">WDVI</a> del <a href="https://www.termcat.cat/ca/diccionaris-en-linia/197">Diccionari terminològic de teledetecció</a> de Pons y Arcalís (2012).]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>WDVI (Weighted Difference Vegetation Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>6</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IRp</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del infrarojo cercano.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:BandaIRp"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
