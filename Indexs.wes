	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:15</ows:Identifier>
		<ows:Title><![CDATA[AVI (<i>angular vegetation index</i>, índice de vegetación angular)]]></ows:Title>
		<ows:Abstract><![CDATA[<p>Índice de vegetación basado en el ángulo definido entre las reflectancias a 555 nm, 670 nm y 870 nm correspondientes a las regiones espectrales del verde, el rojo y el IRc, respectivamente, del sensor IRR del instrumento ATSR- 2 del ERS-2, que caracteriza la absorción de la clorofila, para normalizar los efectos de los suelos y de la atmósfera y mantener la sensibilidad con las propiedades de la vegetación.<br><center>AVI= 2 · (&#960; - (a<sub>1</sub> + a<sub>2</sub>)) / &#960;</center><br>donde:<br><center>a<sub>1</sub>= tan<sup>-1</sup> [((&#955;<sub>IRc</sub> - &#955;<sub>R</sub>) / &#955;<sub>R</sub>) / (&#961;<sub>IRc</sub> - &#961;<sub>R</sub>)]</center><br><center>a<sub>2</sub>= tan<sup>-1</sup> [((&#955;<sub>R</sub> - &#955;<sub>V</sub>) / &#955;<sub>R</sub>) / (&#961;<sub>V</sub> - &#961;<sub>R</sub>)]</center><br>donde:<br>&#955;<sub>V</sub>, &#955;<sub>R</sub> y &#955;<sub>IRc</sub> corresponden a los centros de las regiones espectrales del verde, el rojo y el infrarrojo cercano, respectivamente, que se obtienen de los metadatos<br>&#961;<sub>V</sub>, &#961;<sub>R</sub> y &#961;<sub>IRc</sub> corresponden a las reflectancias en las regiones espectrales del verde, el rojo y el infrarrojo cercano, respectivamente.<br>La función tan<sup>-1</sup> devuelve el ángulo en radianes. Según los autores, los datos resultan escalados entre 0 y 1.</p><p><ul><font size="-1"><b>Plummer, S. E., North, P. R. and Briggs, S. A.</b> (1994) <i>The angular vegetation index: an atmospherically resistant index for the second along track scanning radiometer (ATSR-2)</i>. Proceedings of the Sixth International Symposium Physical Measurements and Signatures in Remote Sensing, p. 717-722, Val d'Isère, France.</font></ul></p>]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract><![CDATA[AVI (<i>angular vegetation index</i>, índice de vegetación angular)]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>15</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaIR</ows:Identifier>
				<ows:Title>Banda IRc</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del infrarrojo cercano.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:BandaIRc"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaR</ows:Identifier>
				<ows:Title>Banda R</ows:Title>
				<ows:Abstract>Banda que corresponde a la región espectral del rojo.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BandaR"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BandaV</ows:Identifier>
				<ows:Title>Banda del verde</ows:Title>
				<ows:Abstract>Banda que corresponde al verde.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:BandaV"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
