	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Indexs:Param1:16</ows:Identifier>
		<ows:Title>GEMI (Global Environment Monitoring Index)</ows:Title>
		<ows:Abstract><![CDATA[Índice propuesto para imágenes del sensor AVHRR de NOAA con la finalidad de obtener un conocimiento global de la vegetación en todo el planeta. Es un índice no lineal que minimiza el efecto del suelo y de la atmósfera.<br/><br/><img  src="Indexs_GEMI.gif"/><br/><br/>donde<img  src="Indexs_GEMIn.gif"/>]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>GEMI (Global Environment Monitoring Index)</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>16</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
