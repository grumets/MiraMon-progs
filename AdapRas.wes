<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:AdapRas:1</ows:Identifier>
		<ows:Title>AdapRas</ows:Title>
		<ows:Abstract><![CDATA[Este programa adapta un ráster según el patrón geométrico de un segundo ráster, incluso cuando el ráster patrón tiene una envolvente más amplia que el ráster a adaptar. Para cambiar el lado del píxel de un ráster sin cambiar el origen de la malla es necesario utilizar el programa <a href="CanviRes.htm">CanviRes</a>. Para cambiar el origen de la malla del ráster (sin exceder el envolvente del ráster original) es necesario utilizar el programa <a href="DensRas.htm">DensRas</a>.]]></ows:Abstract>
		<ows:Metadata xlink:title="Title:Adaptación de rásters"/>
		<ows:Metadata xlink:title="Abstract:Este programa adapta un ráster según el patrón geométrico de un segundo ráster, incluso cuando el ráster patrón tiene una envolvente más amplia que el ráster a adaptar. Para cambiar el lado del píxel de un ráster sin cambiar el origen de la malla es necesario utilizar el programa &lt;a href=&quot;CanviRes.htm&quot;&gt;CanviRes&lt;/a&gt;. Para cambiar el origen de la malla del ráster (sin exceder el envolvente del ráster original) es necesario utilizar el programa &lt;a href=&quot;DensRas.htm&quot;&gt;DensRas&lt;/a&gt;."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Opción única en esta versión del programa. El valor "1" debe ser incluido en la sintaxis.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RasterAAdaptar</ows:Identifier>
				<ows:Title>Ráster a adaptar</ows:Title>
				<ows:Abstract>Es el nombre del archivo ráster a adaptar. Se asume que el fichero tiene extensión IMG si esta no se indica.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:RasterAAdaptar"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RasterPatroDeLaGeometria</ows:Identifier>
				<ows:Title>Ráster patrón de la geometría</ows:Title>
				<ows:Abstract>Es el nombre del archivo patrón de la geometría. Se asume que el fichero tiene extensión IMG si esta no se indica.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:RasterPatronDeLaGeometria"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusRemostreig</ows:Identifier>
				<ows:Title>Tipo de remuestreo</ows:Title>
				<ows:Abstract>Indica el tipo de remuestreo: 'V' para el vecino más cercano, 'M' para moda a 4 vecinos, 'L' para interpolación bilineal y 'C' para bicúbica.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:TipoRemuestreo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>V</ows:Value>
						<ows:Value>M</ows:Value>
						<ows:Value>L</ows:Value>
						<ows:Value>C</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>Valor sindatos</ows:Title>
				<ows:Abstract>El valor sindatos será igual al valor dado por la persona usuaria. Si no se indica, será igual al del ráster de entrada o, en su defecto, al de la tabla indicada en este documento.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>RasterResultat</ows:Identifier>
				<ows:Title>Ráster resultado</ows:Title>
				<ows:Abstract>Es el nombre de el archivo resultado. Se asume que el fichero tiene extensión IMG si esta no se indica.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:RasterResultado"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>