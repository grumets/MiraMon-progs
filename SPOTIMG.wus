<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SPOTIMG:1</ows:Identifier>
		<ows:Title>SPOTIMG</ows:Title>
		<ows:Abstract>This program reeds data from SPOT series satellites (Satellite Pour l'Observation de la Terre) in DIMAP format (Digital Image Map, consult http://www.spotimage.fr/html/_167_224_232_235_.php).</ows:Abstract>
<ows:Metadata xlink:title="Title:Transform DIMAP raster format (SPOT satellite images) to MiraMon IMG format"/>
<ows:Metadata xlink:title="Abstract:This program reeds data from SPOT series satellites (Satellite Pour l'Observation de la Terre) in DIMAP format (Digital Image Map, consult http://www.spotimage.fr/html/_167_224_232_235_.php)."/>
		<DataInputs>
		<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Option</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>1. Unic Option</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
			<LiteralData>
				<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:Value>1</ows:Value>
				</ows:AllowedValues>
			</LiteralData>				
		</Input>
		<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TIFFileName</ows:Identifier>
				<ows:Title>TIF File Name</ows:Title>
				<ows:Abstract>Is the name and path of the TIF file that contains the image. Usually this file is called "imagery.tif".</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
			<ComplexData>
				<Default>
					<Format>
								<MimeType>application/x-TIF</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
				</Default>
				<Supported>
					<Format>
								<MimeType>application/x-TIF</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
				</Supported>
			</ComplexData>	
		</Input>
		<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DIMFileName</ows:Identifier>
				<ows:Title>DIM File Name</ows:Title>
				<ows:Abstract>Is the name and path of the XML metadata file in DIMAP 1.1 format. Usually this file is callet "metadata.dim".</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
			<ComplexData>
				<Default>
					<Format>
								<MimeType>application/x-DIM</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
				</Default>
				<Supported>
					<Format>
								<MimeType>application/x-DIM</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
				</Supported>
			</ComplexData>	
		</Input>
		</DataInputs>
			<ProcessOutputs>	
	      	<Output>
				<ows:Identifier>G_OutputFileName</ows:Identifier>
				<ows:Title>G_OutputFileName</ows:Title>
				<ows:Abstract>G_OutputFileName is the name and path of the output IMG file that contains the green spectral band (the band with the second position in the TIF).
				</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ComplexOutput>
					<Default>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Default>
					<Supported>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>R_OutputFileName</ows:Identifier>
				<ows:Title>R_OutputFileName</ows:Title>
				<ows:Abstract>R_OutputFileName is the name and path of the output IMG file that contains the red spectral band (the band with the third position in the TIF).
				</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ComplexOutput>
					<Default>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Default>
					<Supported>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>IRp_OutputFileName</ows:Identifier>
				<ows:Title>IRp Output File Name</ows:Title>
				<ows:Abstract>IRp_OutputFileName is the name and path of the output IMG file that contains the near infrared spectral band (the band with the first position in the TIF).
				</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ComplexOutput>
					<Default>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Default>
					<Supported>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>IRm_OutputFileName</ows:Identifier>
				<ows:Title>IRm Output File Name</ows:Title>
				<ows:Abstract>IRm_OutputFileName is the name and path of the output IMG file that contains the middle infrared spectral band (the band with the forth position in the TIF).
				</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ComplexOutput>
					<Default>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Default>
					<Supported>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs> 
	</ProcessDescription>
</wps:ProcessDescriptions>
