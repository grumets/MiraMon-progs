<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SPOTIMG:1</ows:Identifier>
		<ows:Title>SPOTIMG</ows:Title>
		<ows:Abstract><![CDATA[This program reeds data from SPOT series satellites (<i>Satellite Pour l'Observation de la Terre</i>) in DIMAP format (Digital Image Map, consult <a href="http://www.spotimage.fr/html/_167_224_232_235_.php">http://www.spotimage.fr/html/_167_224_232_235_.php</a>).]]></ows:Abstract>
		<ows:Metadata xlink:title="Title:Transform DIMAP raster format (SPOT satellite images) to MiraMon IMG format"/>
		<ows:Metadata xlink:title="Abstract:This program reeds data from SPOT series satellites (&lt;i&gt;Satellite Pour l&apos;Observation de la Terre&lt;/i&gt;) in DIMAP format (Digital Image Map, consult &lt;a href=&quot;http://www.spotimage.fr/html/_167_224_232_235_.php&quot;&gt;http://www.spotimage.fr/html/_167_224_232_235_.php&lt;/a&gt;)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Transform DIMAP raster format (SPOT satellite images) to MiraMon IMG format</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerTIF</ows:Identifier>
				<ows:Title>TIF file name</ows:Title>
				<ows:Abstract>Is the name and path of the TIF file that contains the image. Usually this file is called "imagery.tif".</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:TIFFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDIM</ows:Identifier>
				<ows:Title>DIM file name</ows:Title>
				<ows:Abstract>Is the name and path of the XML metadata file in DIMAP 1.1 format. Usually this file is callet "metadata.dim".</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:DIMFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-DIM</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DIM</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxSortG</ows:Identifier>
				<ows:Title>Green band output file name</ows:Title>
				<ows:Abstract>This is the name and path of the output IMG file that contains the green spectral band (the band with the second position in the TIF).</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:OutFileG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxSortR</ows:Identifier>
				<ows:Title>Red band output file name</ows:Title>
				<ows:Abstract>It is the name and path of the output IMG file that contains the red spectral band (the band with the third position in the TIF).</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:OutFileR"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxSortIRoc</ows:Identifier>
				<ows:Title>Shortwave infrared band output file name</ows:Title>
				<ows:Abstract>It is the name and path of the output IMG file that contains the shortwave infrared spectral band (the band with the forth position in the TIF).</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:OutFileSWIR"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxSortIRp</ows:Identifier>
				<ows:Title>Near infrared band output file name</ows:Title>
				<ows:Abstract>It is the name and path of the output IMG file that contains the near infrared spectral band (the band with the first position in the TIF).</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:OutFileNIR"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>