<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CorRad:1</ows:Identifier>
		<ows:Title>CorRad</ows:Title>
		<ows:Abstract>CorRad</ows:Abstract>
		<ows:Metadata xlink:title="Title:Radiometric correction of remote sensing images."/>
		<ows:Metadata xlink:title="Abstract:This program allows the radiometric correction of remote sensing images captured in the visible and infrared (not thermic) spectral regions."/>
		<DataInputs>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>1: Manual correction from the DEM.</li><li>2: Automatic correction from the DEM.</li><li>3: Manual correction and from the model of illuminations and shadows.</li><li>4: Automatic correction and based on the model of illuminations and shadows.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxOrigen</ows:Identifier>
				<ows:Title>Image to correct</ows:Title>
				<ows:Abstract>Radiometrically corrected image (can be part of a multiband raster).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:OrigFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MDE/MDI</ows:Identifier>
				<ows:Title>Digital Elevation Model / Digital Illumination Model</ows:Title>
				<ows:Abstract>Digital Model of Elevations for options 1 and 2, Digital Illumination Model for options 3 and 4</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:DEM/DIM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxSortida</ows:Identifier>
				<ows:Title>Output file</ows:Title>
				<ows:Abstract>Folder where the files resulting from the radiometric correction will be written, or the file resulting from the radiometric correction for the monoband case.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:OutputFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerRAD</ows:Identifier>
				<ows:Title>RAD file</ows:Title>
				<ows:Abstract>RAD text file (INI format) with the necessary parameters that depend on the sensor and the band: S0, tau0, tau0_ret, TempK1, TempK2. It is highly recommended to use the m_atmos.rad file that is distributed with the program, except if you want to correct images from a sensor that is not identified in this file.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:RADFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-rad</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-rad</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerK1/PIA</ows:Identifier>
				<ows:Title>K1/PIA file</ows:Title>
				<ows:Abstract>File with Kl values, dark object detection for manual correction, or polygon file with reference radiometric values for automatic correction.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:K1/PIAFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-rad</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-rad</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REF_SUP_100</ows:Identifier>
				<ows:Title>Reflectances greater than 100%</ows:Title>
				<ows:Abstract>Parameter that is indicated by the singular case in which it is allowed to exceed 100% of reflectances, and therefore we want to avoid marking this case as NoData (background value).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>Multiband</ows:Title>
				<ows:Abstract>To correct in a single execution of the program all the bands of a multiband raster and generate as a result a multiband raster with the corresponding corrected bands.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TOLER_RAD</ows:Identifier>
				<ows:Title>TOLER_RAD</ows:Title>
				<ows:Abstract>Indicates a multiplicative factor to the tolerances (difference in the reference value and the value adjusted by the automatic model) defined by default. The default tolerances are around 2%, they are different for each side (consult the article Pons et al. 2014). A tolerance factor greater than 1 implies a less strict comparison between the reference radiometric values and the model values, but may imply an increase in the uncertainty in the result. It is advisable to increase this value when the automatic model does not find enough polygons for the adjustment. A (positive) value lower than 1 implies a more faithful correction to the reference values, but then the result will be generated with fewer polygons.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefix original files</ows:Title>
				<ows:Abstract>Prefix added to the original file names to determine the corrected file names for the multiband case. If not specified, no prefix is added, unless the input and output images are in the same directory, in which case an "r_" prefix is added.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CONSERVAR_MDT</ows:Identifier>
				<ows:Title>Keep DTM</ows:Title>
				<ows:Abstract>In options 1 and 2, this parameter allows you to save the lighting model and the shadow model (and can be reused in options 3 and 4).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MDE_PER_TAU0</ows:Identifier>
				<ows:Title>MDE_PER_TAU0</ows:Title>
				<ows:Abstract>Digital Elevation Model file used by the Tau0 parameter (only for options 3 and 4 and in case the /TAU0_ALT parameter is also requested).</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>INCID_SUP_90</ows:Identifier>
				<ows:Title>Angles of incidence greater than 90%</ows:Title>
				<ows:Abstract>Parameter that is indicated by the singular case in which it is allowed to exceed incidence angles greater than 90° and which is equivalent to defining a theoretical Lambertian angle of 180°. If not specified, pixels with incidence angles >90° are marked as NoData.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>LIMIT_LAMBERT</ows:Identifier>
				<ows:Title>Lambertian limit angle</ows:Title>
				<ows:Abstract>Lambertian limit angle, if not indicated the default value is 70</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>70</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TAU0_ALT</ows:Identifier>
				<ows:Title>TAU0_ALT</ows:Title>
				<ows:Abstract>It indicates that the Tau0 parameter is a height-dependent function. In options 3 and 4, it is necessary to indicate the MDE from the parameter /MDE_PER_TAU0=</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>