;==========================================================================
; Fichero de parámetros del programa MiraMon
;==========================================================================
;==========================================================================
; Este fichero debe estar en el Disco y Directorio indicados en la casilla
; "Directorio de Trabajo" de las "Propiedades del programa" (para acceder
; seleccione el icono del programa y ejecute "Alt+Retorno" o bien ejecute
; "Fichero/Propiedades" en el menú del Administrador de Programas).

; En este fichero los comentarios son líneas que empiezan con un
; punto y coma (;).
;==========================================================================



;==========================================================================
[MiraMon]
;==========================================================================
; SECCIÓN PRINCIPAL
;==========================================================================

; MiraMon Corporativo: 
;cfg_corporativa=
;msg_queixa_grup=
;info_grup=
;path_log=

; Aspecto de la ventana al iniciar el programa: 0=Normal 1=Maximizada
MaxIni=1

; Color de fondo en el área cliente inicial
; Este parámetro se puede cambiar durante la sesión mediante la opción
; correspondiente del menú "Visualización".
; 41=Blanco      -> (R,G,B) = (255,255,255)
; 42=Gris claro  -> (R,G,B) = (192,192,192)
; 43=Gris        -> (R,G,B) = (128,128,128)
; 44=Gris oscuro -> (R,G,B) = ( 64, 64, 64)
; 45=Negro       -> (R,G,B) = (  0,  0,  0)
ColorFonsInit=41

; Directorio donde, por defecto, se buscarán los mapas, imágenes y
; vectores a visualizar
ImgDir=C:\mapas

; Directorios donde MiraMon explora los ficheros que definen las colecciones favoritas
CollecDir1=C:\mapas\ColeccionesFavoritas
;CollecDir2=
;CollecDir3=
;...

; Página HTML que se muestra como alternativa a las páginas del Diario de Versiones, Foro de usuarios (FUM) y
; Twiter de MiraMon. Típicamente sirve para mostrar en ella información corporativa (últimas novedades en la intranet
; de una administración, indicaciones para los alumnos en un aula, etc).
; PaginaHTM_AlternativaPresentacio=

; Directorio donde, por defecto, se buscarán las paletas de color
PalDir=Paletas

; Extensión usada, por defecto, al buscar las paletas de color:
;       0=*.PAL         Paletas de    64 niveles para cada componente RGB
;       1=*.P25         Paletas de   256 niveles para cada componente RGB
;       2=*.P65         Paletas de 65536 niveles para cada componente RGB
; Esta extensión aparecerá como segunda opción en el desplegable de exploración
; de ficheros, siempre después de las tablas de simbolización de la versión 4.
PalExt=1

; Directorio donde, por defecto, se buscarán los símbolos (EMF y WMF)
SimbolDir=Simbolos

; Directorio donde, por defecto, se buscarán los patrones
PatroDir=Patrones

; Directorio donde, por defecto, se buscarán las plantillas de impresión y
; de exportación de metadatos.
PlantillaDir=Planti

; Plantillas de usuario para la impresión. Se asume que están en el 
; directorio "PlantillaDir=". 
;PlantillaVerticUsuari=Vert_Usuario.mmm
;PlantillaHoritzUsuari=Hori_Usuario.mmm
PlantillaVerticUsuari=
PlantillaHoritzUsuari=

; Número de dígitos decimales con que las coordenadas mapa serán impresas
; en pantalla. Debe estar dentro del rango [0,15]. Valor por defecto: 2
DigitsDecimals=2

; Número de dígitos decimales con los que las coordenadas en long/latitud 
; serán mostradas en pantalla. Debe estar dentro del rango [0,15]. Valor por defecto: 4
;DigitsDecimalsLonLat=4

; Número de dígitos decimales en las consultas por localización de rásters 
; de tipo float y en las estadísticas de las consultas por atributos
; Debe estar dentro del rango [0,15]. Valor por defecto: 4
;DigitsDecimalsConsultEstad=4

; Estado del Visualizador de Coordenadas: 0=No visible 1=Visible
; Este parámetro se puede cambiar durante la sesión mediante la opción
; "MostrarCoordenadas" del menú "Información" o con la tecla F6.
MostrarCoordenades=0

; Posición y dimensión del Visualizador de Coordenadas:
;   XCaixaCoord, YCaixaCoord * son las coordenadas del vértice
;                            superior izquierdo de la caja, respecto
;                            al vértice superior izquierdo de la pantalla.
;   AmpleCaixaCoord          * es la anchura de la caja de coordenadas.
; Los 3 valores se dan en píxels de pantalla.
;YCajaCoord=448 ->Win 3.x; 640x480
XCaixaCoord=100
YCaixaCoord=425
AmpleCaixaCoord=550

; Visualización de coordenadas del mapa en diferentes ventanas informativas. 
; 1: mostrar (valor por defecto); 0: no mostrar
;MostrarCoordMapa=1;

; Visualización de coordenadas en longitud/latitud en diferentes ventanas informativas.
; 1: mostrar (valor por defecto); 0: no mostrar
;MostrarCoordLonLat=1

; Orden en que se visualizan las coordenadas en longitud/latitud en diferentes ventanas informativas.
; 0: mostrar en orden Longitud Latitud (valor por defecto)
; 1: mostrar en orden Latitud Longitud
;OrdreMostrarCoordLongLat=0

; Formato de las coordenadas en longitud/latitud, 
; 1: mostrar en grados minutos segundos (° ' ''); 0: mostrar en grados (°)
;FormatLonLatGMS=1

; Estado de la leyenda: 0: No visible; 1: Visible
;MostrarLlegenda=0

; Estado de la Barra de Zoom: 0=No visible 1=Visible (valor por defecto)
; Este parámetro se puede cambiar durante la sesión mediante la opción "Visualización | Entorno"
; y desde el mismo menú "Zoom".
;MostrarBarraZoom=0

; Posición de la Barra de Zoom:
; XBarraZoom, YBarraZoom son las coordenadas del vértice superior izquierdo de 
; la caja, en píxeles de pantalla
; Valores por defecto: XBarraZoom=0 e YBarraZoom=128
;XBarraZoom=100
;YBarraZoom=428

; Estado de la Barra de botones: 0=No visible 1=Visible
; Este parámetro se puede cambiar durante la sesión mediante la opción
; "Mostrar barra de botones" del menú "Ayuda".
MostrarBarraBotons=1

; Con el siguiente parámetro se controla la aparición del índice de color
; numérico correspondiente a cada categoría en la ventana que muestra la
; leyenda: 0=No (valor por defecto) 1=Sí
; Equivale al antiguo MostrarAtributLlegenda
MostrarIndColLleg=0

; Radio de representación de los vectores punto, en píxels de pantalla.
; Este valor debe ser>=0
RadiPnt=1

; Mostrar índice del enlace con los campos relacionales en la leyenda
;MostrarIndEnllacCat=0;				

; Opciones por defecto al abrir el primer fichero de polígonos.
; PolTransparent indica si queremos pintar el interior,
; 0=No  1=Sí
PolTransparent=1

; Cuando un fichero contiene valores de fondo (flag values), puede reservar la última
; entrada de la paleta como color para los píxels o entidades marcados con
; este valor de fondo.
; 0=No  1=Sí
UsarUltimColorPaletaComFlagValue=0

; Radio para dibujar las entidades de tipo punto que no tengan registro en la
; base de datos o que tengan vacío (en blanco) el campo que indexa el radio.
; Este valor debe ser >=0
RadiObjectesSenseAtribut=1

; Ancho para dibujar las entidades de tipo línea/arco que no tengan
; registro en la base de datos o que tengan vacío (en blanco) el campo que
; indexa el grosor.
; Este valor debe ser >=0
GruixObjectesSenseAtribut=1.0

; Color para dibujar las entidades que no tengan registro en la
; base de datos o que tengan vacío (en blanco) el campo que indexa el color.
; Hay que indicar un valor (R,G,B). Recuerde que cada componente R,G,B debe estar
; dentro del rango [0, 255].
ColorObjectesSenseAtribut=(0,0,0)

; Cuando un fichero pertenece a una serie cartográfica y se guarda un mapa, se puede
; optar por mantener los vinculos de visualización y leyenda generales de la
; serie o por guardar las características actuales de visualización y leyenda.
; 0=No mantener el vínculo con las series cartográficas  1=Mantenerlo
MantenirSeriesCartografiquesEnMMM=1

; Antes de mostrar la caja resultado de una consulta por localización en vectores,
; muestra una cajita que permite continuar buscando o cancelar: 0=No  1=Sí
; Este parámetro se puede cambiar durante la sesión a través del menú
; "Información"
PreInfoBox=0

; Posición, ancho y alto inicial de la caja resultante de una consulta por localización en vectores.
; Este parámetro se puede cambiar durante la sesión a través de los ángulos o de los bordes de la propia caja.
; Los 4 valores (X,Y,Ancho,Alto) se dan en píxels de pantalla. Si se pide un tamaño
; demasiado grande para la resolución de la pantalla se adaptan los valores a la resolución de la pantalla.
MidaCaixaConLoc=50,77,547,604

; Color (R,G,B) con que se destacan los elementos seleccionados. Si se indica
; (-1,-1,-1) el color lo determina MiraMon para una óptima visualización.
; Si se indica cualquier otra combinación [0, 255] para las componentes RGB
; se obtendrá este color como color constante para las selecciones; por
; ejemplo, para obtener las selecciones en rojo indique:
; ColorSeleccio=(255,0,0)
; para obtener las selecciones en blanco indique:
; ColorSeleccio=(255,255,255)
; Este parámetro se puede cambiar durante la sesión a través del menú
; "Visualización"
ColorSeleccio=(-1,-1,-1)

; Después de efectuar una consulta por localización, puede ser conveniente
; redibujar toda la pantalla para evitar artefactos de solape de polígonos
; que tapen puntos, etc. Si se indica 0 (valor por defecto), el redibujado
; no se efectuará (opción más rápida, pero que visualmente puede presentar
; el problema comentado y entonces debe forzarse un redibujado a través del
; botón con el pincel de la barra de botones o a través de "Visualización | Redibujado";
; si se indica 1, se efectúa un redibujado completo cada vez que se cierra la caja
; de consulta por localización.
;RedibuixaDespresDeConsultaLocalit=1

; Indica si en la caja de diseño de impresión se redibujará de forma automática (opción 1)
; o bien se hará a petición del usuario a través del botón correspondiente o de F5 (opción 0,
; por defecto y comportamiento clásico).
;RedibAutomPrevisImpr=1

; La siguiente variable determina cuáles de las siguientes informaciones queremos
; que sean visibles cuando realizamos consultas por localización sobre vectores
; estructurados. La variable "ParamInfoConsultaLocalitz" está formada por una
; o más de las siguientes informaciones:
;    Titol           : Título descriptivo del fichero que estamos consultando
;    NomFitxer       : Nombre del fichero que estamos consultando (también se muestra
;                      el "path" completo) 
;    TipusFitxer     : Tipo de fichero (puntos, polígonos, etc)
;    Visualitzacio   : Aspectos de visualización (color, etc)
;    Posicio_XY      : Posición X,Y de la consulta; ubicación en los
;                      vectores (vértice final o intermedio, punto interior, etc)
;    LongitudArcs    : Longitud de líneas y arcos
;    PeriAreaPoligs  : Perímetro y área de polígonos
;    AltresGeomTopol : Otra información geométrica y topológica (número de
;                      polígonos elementales, nodos ini/fi de los arcos, etc)
;    InfoBasesDades  : Información sobre la base de datos (número de elementos
;                      gráficos y de registros, etc)
;    BaseDadesAlfan  : Información contenida en los campos de la base de datos
;                      alfanumérica
; Durante la ejecución del programa se pueden cambiar estas especificaciones
; a través del botón "+ / - Información..." de la caja de consulta por
; localización.
; La variable se forma simplemente escribiendo las inform. deseadas, p.ej.:
; ParamInfoConsultaLocalitz=Titol Posicio_XY BaseDadesAlfan
ParamInfoConsultaLocalitz=Titol NomFitxer Posicio_XY LongitudArcs PeriAreaPoligs BaseDadesAlfan

; Cómo mostrar los enlaces rotos por NODATA
; si 1: mostrar en blanco (valor por defecto)
; si 2: mostrar el campo con el enlace roto
;ComMostrarEnllacosTrencatsPerNODATA=1

; Quién gestiona los zooms ráster: MiraMon o Windows
; Este parámetro se puede cambiar durante la sesión a través del menú "Zoom".
; Nota: Esta clave es puramente de gestión informática de los rásters en el zoom y
; no debe ser confundida con la clave ModeGestioZoom de la sección [METRICA].
GestZoom=MiraMon

; Avisa acústicamente si no puede redibujar
; Este parámetro se puede cambiar durante la sesión a través del menú
; "Visualización | Especial"
; 0=No  1=Sí
AvisaErrorRed=0

; Ignorar los cambios en los atributos de los ficheros.
; Esta opción es útil en Windows 3.1x cuando se accede a datos
; de un servidor de red, ya que a veces se obtienen falsos avisos
; de imposibilidad de leer los atributos. Por otra parte, si se activa
; esta opción, MiraMon no detectará si se ha producido algún cambio
; en los ficheros gráficos o en las tablas de las bases de datos durante
; la sesión de trabajo (por ejemplo porque otro usuario ha modificado
; un DBF o porque estamos reconstruyendo la topología) y esto puede provocar
; que el programa funcione incorrectamente.
; En Windows 9x y NT esta opción debe estar a 0 para garantizar un óptimo
; funcionamiento del programa (es decir, detectará cualquier cambio en los
; ficheros en que usted esté trabajando).
; Este parámetro se puede cambiar durante la sesión a través del menú
; "Visualización | Especial"
; 0=No  1=Sí
IgnorarCanvisAtributsHoraDataMida=0

; Informa o pregunta respeto a la recarga de ficheros cuando se detecta que han sufrido cambios en los atributos, hora, fecha y/o tamaño.
; Por defecto se recomienda un valor 1, que informa o pregunta explícitamente al usuario sobre los cambios.
; Si se desea que no avise, pero que por prudencia siempre recargue, indíquese un valor 0.
; Si se desea que no avise, pero que sólo recargue cuando los cambios son de tamaño, indíquese un valor 2. Esta opción sólo debe ser
; indicada por usuarios expertos.
; InformaRecarregaFitxersModif=0
InformaRecarregaFitxersModif=1

; Juego de caracteres para los ficheros de texto llano (TXT, REL, DVC, etc).
; Este parámetro se puede cambiar durante la sesión a través del menú
; "Información"
; 1252=Windows ANSI (EE.UU. y Europa Occidental)
;  850=DOS OEM-850  (MS-DOS Multilenguaje o "Latin I")
JocCaracTXTPerDefecte=1252

; Juego de caracteres para los campos de tipo carácter de los ficheros de
; bases de datos (DBF) cuando el propio DBF no especifica juego de caracteres
; o bien el especificado no está soportado por MiraMon.
; Este parámetro se puede cambiar durante la sesión a través del menú
; "Información"
; 1252=Windows ANSI (EE.UU. y Europa Occidental)
;  850=DOS OEM-850  (MS-DOS Multilenguaje o "Latin I")
JocCaracDBFPerDefecte=850

; Cuando durante la digitalización copiamos un objeto podemos escoger que ya quede
; dibujado en el color final, o que quede resaltado en el color de selección
; 0=No  1=Sí, quiero resaltar el objeto
; Este parámetro se puede cambiar durante la sesión a través del menú
; "Edición"
MarcaObjecteCopiat=1

; En caso de duda, a la hora de digitalizar polígonos explícitos, se decidirá si
; se añade un nuevo polígono, se define un agujero en un polígono preexistente, o
; se pregunta cada vez cuál de las dos opciones se quiere, que es la opción por defecto (0).
; 0=Pregunta 1=Añade polígono  2=Define agujero
; DefineixForatCreaPoligonOPregunta=2

; Posición inicial, ancho y alto de la caja de la leyenda.
; Los 4 valores (X,Y,Ancho,Alto) se dan en píxels de pantalla.
PosicioDimensioLlegenda=476,9,152,456

; Permite ignorar la existencia de la clave "MostrarLlegenda=" en los mapas,
; haciendo que la leyenda siempre sea visible (valor 1). El valor por defecto es 0.
; IgnorarMostrarLlegenda=1
IgnorarMostrarLlegenda=0

; Número de pasos de digitalización/edición entre copias de seguridad.
; Este parámetro también gobierna el equilibrio entre tiempo dedicado a hacer copias
; de seguridad y velocidad al efectuar una operación de deshacer (Ctrl+Z). Ejemplos:
; Si se indica 0 no se realiza ninguna copia de seguridad y, por tanto, tampoco se
; permite deshacer. Si se indica 1 (no recomendado) se realiza un copia de seguridad
; en cada operación de digitalización/edición, y la velocidad de deshacer es máxima.
; El valor por defecto es 20. Un valor más elevado hace que el proceso de digitalización/edición
; sea sensiblemente más ágil si la capa que se está editando es muy voluminosa (en la
; parte gráfica y/o en su base de datos) o está en un recurso informático de acceso
; lento, pero, a cambio, efectúan menos copias de seguridad y las operaciones de
; deshacer son más lentas porque deben regenerar una situación más compleja.
NPassosEntreCopiesEnDigit=20

; Mostrar la barra de herramientas de digitalización al iniciar la digitalización. 0=No  1=Sí (valor por defecto)
; MostrarBarraEinesDigit=0
MostrarBarraEinesDigit=1

; Conexión continua al digitalizar. 0=No  1=Sí (valor por defecto)
; F3Continu=0
F3Continu=1

; Colores por defecto para informar que se ha efectuado una conexión en modo F3Continu:
ColorVertexFinal_F3Continu=(255,0,0)
ColorVertexIntermedi_F3Continu=(255,255,0)
ColorVertexNou_F3Continu=(0,255,255)

; Radio y grosor por defecto para informar que se ha efectuado una conexión en modo F3Continu:
Radi_F3Continu=7
Gruix_F3Continu=2

; Exageración por defecto de radios de puntos y grosores de líneas al imprimir
ExageraRadi_i_Gruix=3

; Para decidir si quiero confirmación antes de salir de MiraMon
; 0=No  1=Sí
ConfirmacioSortirMiraMon=0

; Permite controlar cada cuantos minutos el Director avisa que una
; sesión de MiraMon no responde. Si usted trabaja con ficheros que
; resulten ser de procesamiento muy lento con su ordenador y recibe
; demasiado a menudo mensajes advirtiendo que tal sesión de MiraMon
; no responde, incremente este valor. El valor mínimo es 1.
MinutsCicleTestDirector=60

; Permite controlar si un objeto seleccionado interactivamente o por atributos
; debe ser ocultado (apagado) cuando se muestra a una escala a la cual la capa no
; se muestra. 0=No  1=Sí (valor por defecto)
;EscalaApagaObjectesSeleccionats=0

; Base de Datos Documental por defecto
;BDDocumental=dirección y nombre del fichero de la BD

; Permite controlar si, en referencia al campo ID_GRAFIC, se hará análisis exhaustivo de su contenido
; y coherencia (opción 2, comportamiento habitual hasta enero-2013 pero que enlentece muy 
; considerablemente la apertura de capas con grandes tablas principales), o si se hará un análisis rápido
; (opción 1, que es la actual opción por defecto, y que sólo comprueba la presencia de registro múltiple
; o de registros adicionales con índices negativos o superiores al número de objetos). La inmensa mayoría
; de las capas tienen un campo ID_GRAFIC correcto (ordenado de forma ascendente, etc) y, por tanto, este
; esfuerzo es habitualmente innecesario, excepto para poder comprobar capas que presenten comportamientos
; extraños. Se puede cambiar temporalmente el comportamiento dentro de una sesión a través de
; "Visualización | Especial | Test exhaustivo del campo IdGráfico durante la apertura de capas".
;TestIdGr=2

; La leyenda mostrará las capas que fueron declaradas no visibles, que no son visibles debido
; a una escala en que se definieron no visibles o, simplemente, debido al hecho que no están
; en el campo del mapa. El valor por defecto (0) oculta estas capas durante la impresión.
ImprLlegMostraCapesNoVisib=0

; Abrir la caja clásica de Windows o la caja moderna (que permite imprimir a un fichero sin tener
; que redefinir el puerto de impresión) al pulsar el botón "Impresora..." de la caja de diseño
; de impresión. El valor por defecto (1) muestra la caja moderna.
; CaixaModernaTriaImpressora=0
CaixaModernaTriaImpressora=1

; Mostrar, en la barra de botones, el botón que permite la publicación/exportación de datos vectoriales 
; "abiertos" en la sesión de MiraMon a varios formatos.
; 0: no muestra el botón especial de publicación (valor per defecto) 
; 1: muestra el botón especial de publicación
;BarraBotonsEspecial=1

; Generar una tabla única siguiendo todas las tablas enlazadas a la tabla principal de la capa.
; Será usada para realizar las consultas en MiraMon de forma más rápida.
; 1: Usar la tabla única (valor por defecto).
; 0: No usar la tabla única.
UsarTaulaUnica=1


; En las conexiones a bases de datos, mediante las librerías ODBC, es necesario determinar el tipo de cursor que se puede usar para esa base de datos.
; El tipo de cursor tiene implicaciones en cómo se recuperan los datos de la base. A veces, en algunas bases de datos no se puede determinar el tipo de cursor; cuando esto ocurre se
; genera un aviso de cursor desconocido, en el que se dice que no se ha podido determinar el tipo de cursor y que se utilizará el cursor de tipo simple.
; Se ha observado que en determinados tipos de bases de datos esto ocurre a menudo, pero el cursor simple funciona correctamente. Esta variable permite controlar si se desea mostrar o no este aviso.
; 1: Mostrar aviso cursor desconocido (valor per defecto)
; 0: No mostrar el aviso
AvisaErrorODBCCursorDesconegut=1

; Preferencia en el uso de librerías para el acceso a archivos abribles tanto vía librerías internas de MiraMon como vía GDAL/OGR
; 0: Un fichero que se pueda abrir vía MiraMon y vía GDAL/OGR se abrirá vía librerías internas de MiraMon (valor por defecto).
; 1: Un fichero que se pueda abrir vía MiraMon (o abrir la aplicación de importación correspondiente) y vía GDAL/OGR se abrirá vía GDAL/OGR.
; 2: Un fichero que no se puede abrir vía MiraMon, pero para el cual existe la aplicación de importación correspondiente, abrirá dicha aplicación de importación.
; Rásters:
;ObreJPEGVia=1
;ObreTIFFVia=1
;ObreBMPVia=1
;ObreJ2KVia=1

; Vectores:
;ObreSHPVia=1
;ObreDXFVia=1
;ObreGPXVia=1
;ObreKMLVia=1
;ObreGMLVia=1
;ObreDGNVia=1
ObreGeoJSONVia=1

;Tablas:
ObreCSVVia=1

; Preferencia en la importación de la simbolización de OGR/GDAL
; CAP: No importa ninguna simbolización y aplica una simbolización sencilla por defecto (líneas negras, etc).
; SLD: Importa la simbolización de la tabla layer_styles en el caso de geopackage (valor por defecto)
; GDAL [no implementado en octubre de 2025]: Importa la simbolización usando las librerías propias de GDAL para todos los casos disponibles en GDAL
; GDAL_SLD [no implementado en octubre de 2025]: Importa la simbolización usando las librerías propias de GDAL y después se enriquece con la SLD de la tabla layer_styles
; SLD_GDAL [no implementado en octubre de 2025]: Importa la simbolización de la tabla layer_styles y después se enriquece usando las librerías propias de GDAL
;SmbGDAL=CAP
SmbGDAL=SLD

;==========================================================================
[METRICA]
;==========================================================================
; SECCIÓN PARA ASPECTOS DE MÉTRICA, PROYECCIONES CARTOGRÁFICAS, ETC
;==========================================================================

; Sistema de referencia y unidades por defecto en las correcciones geométricas 
; y conversiones de formato (importaciones).
;RefSystem=UTM-31N-UB/ICC
RefSystem=UTM-30N-ETRS89

; Cuando el sistema de referencia es de tipo "Cartográfico" y está descrito en 
; las tablas de geodesia, las unidades se leen de dichas tablas. Esta es la
; situación normal. Sin embargo, en los demás casos (por ejemplo cuando el sistema
; es "Local") pueden especificarse.
RefUnits=m

; Sistema de referencia y unidades por defecto cuando se digitaliza 
; SIN ninguna capa cargada otra que la que se está digitalizando.
RefSystemScreen=plane
RefUnitsScreen=pixels

; Transformación al vuelo del sistema de referencia. El valor por defecto es 1 (sí).
; Si no desea utilizarlo indique 0.
;TransformacioGeometriaAlVol=0

; Conversores de longitudes y de áreas.
; Si no quiere usarlos indique 0 o comente la línea con un punto y coma
ConversorLong=0.001
UnitLong=km
ConversorArea=0.0001
UnitArea=ha
;ConversorArea=1E-6
;UnitArea=km²

; Mantener la vista actual al abrir una nueva capa o mapa. Este parámetro,
; que por defecto vale 0 (falso), actua inhibiendo la lectura de la sección
; [VISTA] de los mapas y evitando el zoom al ámbito total de la nueva capa al abrir una capa nueva.
; El parámetro sólo actúa cuando ya hay alguna capa cargada.
; Su valor puede modificarse también desde el menú "Visualización | Especial".
; MantenirVistaActualEnObrirNovaCapa=1
MantenirVistaActualEnObrirNovaCapa=0

; Permite que, al realizar un zoom a selección, los objetos seleccionados se centren en la pantalla (valor 1)
; en vez de mostrarlos ajustados al ángulo superior izquierdo (valor 0). Valor per defecto: 1
; CentraSeleccio=0
CentraSeleccio=1

; Permite que, al realizar un zoom a selección, se dé "aire" alrededor de los objetos seleccionados
; en vez de mostrarlos ajustados a los costados superior e izquierdo.
; El valor por defecto es 1 (sin aire) y puede ser disminuido hasta 0.5 (se usa sólo la mitad central de la pantalla).
; PercentPantallaSeleccio=.8
PercentPantallaSeleccio=1

; Cómo se gestiona el Zoom del programa:
;  Modo Vista general (opción 0 y por defecto): El zoom se gestiona en base a la vista general de todas las capas.
:  Modo Ráster de referencia (opción 1): El zoom se gestiona en base a uno de los rásters abiertos, que por defecto es el
;	primero, con independencia de la existencia de otras capas rásters o vectores.
;  Modo Automático (opción 2): Conmuta entre los modos anteriores, aplicando el modo Ráster de referencia si todos
;	los rásters abiertos tienen el mismo costado de píxel, y aplicando el modo Vista general en caso contrario.
ModeGestioZoom=0

; ¿Desea barra de estado visible? 0: no; 1 sí (opción por defecto)
BarraEstatVisible=1

; ¿Desea barras de desplazamiento en la ventana de visualización? 0: no; 1 sí (opción por defecto)
MostrarBarresFinestraPintar=1

;==========================================================================
[GPS]
;==========================================================================
; SECCIÓN PARA EL SEGUIMIENTO GPS
;==========================================================================

; Porcentaje del centro de la pantalla que no necesita recentrado del
; último punto de la ruta GPS.
;	Un valor del 100% sólo recentra cuando la ruta sale de la pantalla.
;	Un valor del   0% recentra a cada refresco enviado por GPSMM.
PercentPantallaNOCentratGPS=80

; Radio del círculo que se dibuja alrededor del último punto leido del GPS
RadiSeguimentGPS=500

; Tipo de unidades de RadiSeguimentGPS: 0=UNITATS_PIXELS, 1=UNITATS_MAPA (cartesianas), 2=UNITATS_MAPA (geodésicas)
TipusUnitatsRadiSeguimentGPS=2


;==========================================================================
[Hardware]
;==========================================================================
; SECCIÓN PARA CONFIGURACIÓN DE HARDWARE
;==========================================================================

; Tiempo, en segundos, que el programa espera entre un clic del ratón y un arrastre para
; considerar que se está haciendo un cambio dinámico al modo desplazamiento (pan).
; El valor por defecto es 0.2. Puede indicar cualquier valor positivo hasta 1.
; Indique -1 si desea inactivar el cambio dinámico al modo desplazamiento.
;TempsArrossegamentDinamicSegons =- 1

; El siguiente parámetro permite activar o desactivar el arrastre dinámico durante
; la digitalización ya que algunas personas tienden a "arrastrar" el ratón entre
; clics y activan demasiado frecuentemente el arrastre dinámico.
; 0 = No 1 = Sí (valor por defecto)
;ActivaArrossegamentDinamicDurantDigitalitzacio = 0 

; Anchura de la pantalla, en mm. Necesario para el cálculo de la escala.
;X_mm_Pantalla=260
X_mm_Pantalla=304.8
; PolzadesDiagonalPantalla=15

; Algunas tarjetas gráficas o impresoras fracasan al intentar dibujar
; objetos muy complejos (por ejemplo líneas de 20000 vértices).
; El problema puede empeorar en el caso de los polígonos y en el caso de
; líneas engruesadas. El problema también es dependiente de la escala
; y del detalle del dispositivo de salida (normalmente a escala más detallada
; o en un dispositivo de más resolución, más probabilidad de problemas) y
; de la 'cantidad' de objeto visualizado o impreso: la vista general de un
; objeto es el caso con más probabilidad de problemas, especialmente en
; pantallas o en impresoras de alta resolución o en papeles de gran formato
; Los parámetros 'MaxVertexsTargetaGraficaEx' y 'MaxVertexsImpressoraEx' permiten definir cuál
; es este valor límite para su equipo. Si un objeto lo sobrepasa, MiraMon
; lo simplificará con un algoritmo inteligente que normalmente no causa
; efectos estéticos indeseados. Si su pantalla o su
; impresora no dejan dibujar un cierto objeto, reduzca el valor
; de este parámetro hasta conseguir que lo pueda dibujar.
; Un valor entre 10000 y 15000 suele ser adecuado para la mayoría de
; dispositivos, però puede realizar empíricamente un ajuste más fino ya que
; estos parámetros pueden ser cambiados desde los menús de MiraMon
; (ello también es útil cuando se selecciona una impresora diferente a la
; impresora por defecto).
; Los parámetros 'MaxVertexsTargetaGraficaEx' y 'MaxVertexsImpressoraEx'
; substituyen, en noviembre del 2011, los antiguos parámetros 'MaxVertexsTargetaGrafica' y 'MaxVertexsImpressora'.
MaxVertexsTargetaGraficaEx=1048576
;MaxVertexsTargetaGrafica=32767
MaxVertexsImpressoraEx=1048576
;MaxVertexsImpressora=32767

; A partir de las versiones Vista y 7 de Windows, el sistema operativo puede desactivar
; el dibujado de una aplicación en cuanto le parece que la aplicación "No responde". Esto provoca
; que en capas muy complejas a partir de un cierto elemento ya no se dibuje en la pantalla y,
; lo que es peor, que una vez termina el intento de dibujar, MiraMon reciba una nueva
; instrucción de redibujado por parte del sistema operativo, lo que genera un bucle
; a veces eterno de redibujados incompletos que sólo se detiene pulsando la tecla mayúscula y,
; a continuación, haciendo un zoom que permita trabajar sobre un nivel de complejidad menor
; (menos objetos). Los parámetros N_Objectes_PntNod_EvitaNoRespon y N_Objectes_ArcPol_EvitaNoRespon, permiten
; para puntos y nodos, y para arcos y polígonos respectivamente, desactivar éste
; comportamiento de Windows para capas complejas. Los valores por defecto han sido ajustados
; para procesadores habituales de finales del año 2012, pero si tiene ordenadores sustancialmente
; más antiguos y observa este comportamiento, convendrá que disminuya los valores hasta que
; no observe el problema.
N_Objectes_PntNod_EvitaNoRespon=50000
N_Objectes_ArcPol_EvitaNoRespon=10000

; Resulta interesante que el programa pueda interrumpir el dibujado para hacer una consulta,
; un nuevo zoom, etc, no sólo pulsar la tecla Mayús., sino también a partir de una acción del ratón.
; Sin embargo, durante los primeros objetos de un bucle de dibujado el programa no puede "escuchar"
; si el usuario ha hecho clic con el botón izquierdo del ratón (o si lo hecho con la rueda de zoom)
; porque si el clic era el segundo punto de un zoom o la indicación de final de un desplazamiento (pan),
; el evento ocurre tan rápido que termina detectando el clic mientras todavía dibuja los primeros
; objetos y detendría siempre el dibujado posterior a un zoom o un desplazamiento, lo cual
; sería un efecto indeseado de poder interrumpir el dibujado con un clic del ratón. Por este
; motivo es necesario indicar cuántos objetos es necesario permitir dibujar antes de
; considerar que el hecho de que el botón del ratón esté pulsado no es el final de una operación de
; zoom o de desplazamiento, sino una petición de detener el dibujado a partir de una acción del ratón
; que la inicia.
; Los valores por defecto son: 1000 para puntos y nodos, y 500 para arcos y polígonos, pero estos
; valores pueden tener que hacerse más altos en ordenadores o redes muy rápidos y, viceversa, tener
; que hacerse más bajos en ordenadores o redes relativamente lentos. Si usted observa que fácilmente quedan
; objetos sin redibujar tras un zoom por ventana, debe incrementar el valor, mientras que
; si necesita hacer pulsaciones muy largas para que el programa le haga caso en la instrucción de no
; dibujar, deberá decrementar el valor.
; Si se indica -1 el sistema asume que NO se desea poder interrumpir nunca el dibujado con un
; clic de ratón (pero puede hacerlo, si lo desea, pulsando la tecla Mayús.).
;N_PntNod_SenseAturarRedib_x_clic=-1
;N_ArcPol_SenseAturarRedib_x_clic=-1

; Asimismo, y dado que el cálculo de simplificación es complejo y puede
; llegar a provocar un redibujado demasiado lento, usted puede hacer que
; MiraMon no dibuje los objetos que alcanzan este nivel de complejidad
; estableciendo el parámetro 'DibuixaObjectesComplexos' en 0.
; De esta manera, puede trabajar con polígonos de, por ejemplo, 50000
; vértices, sin redibujarlos en las vistas que obliguen a un número
; de vértices superior a 'MaxVertexsTargetaGraficaOImpressora', y así obtener
; redibujados más rápidos. En el momento de imprimir, simplemente active
; de nuevo "Visualización | Especial | Dibujar objetos complejos".
; Los valores posibles son:
;   0=No dibujar objetos complejos
;   1=Sí, dibujar objetos complejos
DibuixaObjectesComplexos=1

; La siguiente opción permite generar la impresión en el ordenador antes de enviarla a la impresora,
; lo que resulta especialmente útil al imprimir documentos complejos (con transparencias,
; semitransparencias, etc) en impresoras de gran formato (plóters).
; Los valores posibles son:
;   0=Envía la impresión directamente a la impresora, excepto en el caso de semitransparencies no de textos (valor por defecto).
;   1=Genera la impresión en el ordenador antes de enviarla a la impresora, excepto en el caso de semitransparencias de textos y
;     de etiquetas dinámicas.
;   2=Como 1, pero la impresión se guarda en un fichero temporal antes de ser transferida a la impresora.
;     Se ha visto que este modo es necesario en la impresora HP 9600.
; GenerarImpressioAOrdinadorAbansDEnviarAImpressora=1
GenerarImpressioAOrdinadorAbansDEnviarAImpressora=0

; La siguiente opción es útil cuando los drivers de un dispositivo de impresión
; no pueden imprimir rásters de más de 1 Mbyte o el resultado es una
; imagen corrompida. NO recomendamos la opción 0.
; 0=No  1=Sí
ImprimirRastersEnPaquetsPetits=1

; Tamaño máximo de los paquetes de impresión de rásters en X y en Y
; El valor por defecto es 768; una especificación mayor hace la impresión más rápida, pero
; algunos plóters tienen problemas, especialmente cuando la impresión se prepara "en la impresora"
; y no "en el ordenador".
MaximPaquetX_a_Impressora=768
MaximPaquetY_a_Impressora=768

; La siguiente opción es útil cuando los drivers de un dispositivo de impresión
; no pueden imprimir transparencias; la impresión se efectua automáticamente en baldosas
; para las capas que tienen algún nivel de transparencia, cosa que hace que
; muchos drivers de impresora puedan entonces generar un resultado correcto.
; Indique el número de píxeles del lado de la baldosa en la impresión.
; El valor por defecto es 512; si no se desea impresión por baldosas
; indique 2147483648.
; MUY IMPORTANTE: Si a pesar de usar un valor pequeño no se imprime, indique al driver que desea
; preparar la impresión "en el ordenador" y no "en la impresora".
PixelsPerRajolaImpressioTransp=512. 

; Máximo número de vistas WMS salvadas para acelerar el redibujado WMS. Estas vistas se almacenan en el directorio temporal 
; y MiraMon gestiona el borrado cada vez que se cierra el programa o al día siguiente si la sesión ha acabado repentinamente. : Si se indica 0 no se almacena ninguna vista pero el resultado es que cada redibujado hace una solicitud a los servidores,
; locales o remotos, cosa que es sensiblemente más lenta que si aprovechamos que anteriormente ya habíamos pedido la misma
; vista. El valor por defecto es 350.
;MaxNVistesWMSSalvades=350

; Indica si las peticiones a servicios WMS se quieren hacer ajustadas al tamaño de la ventana (valor 0) o bien simulando un servicio
; WMTS, haciéndolas de forma teselada (valor 1, valor por defecto). Usar el WMS de forma teselada, hace que la primera petición
; sea más lenta, pero optimiza los desplazamientos laterales, ya que la información ya se ha solicitado previamente y se aprovechan
; las peticiones anteriores y sólo se solicita las teselas para las zonas no visitadas. En cambio, si se usa un WMS no teselado,
; para cada vista se realiza una nueva petición y descarga, exceptuando el caso en que se visite una zona dos veces (pero esta
; zona debe coincidir totalmente en ámbito y resolución, cosa poco probable).
WMS_Tessellat=0

; Indica si se desea usar IE para descargar ficheros de Internet en las peticiones OGC, o bien WinInet
; Si vale 1 significa que se desea usar IE, que parece ser más rápido pero permite controlar menos aspectos que el otro método
; Si vale 0 significa que se desea usar la función Wininet, método habitual y valor por defecto
;UsaIEPerPeticionsOGC=0

; Indica el User Agent a utilizar cuando se establece una conexión a Internet. 
; El primer parámetro va relacionado con el navegador Web y los otros con la versión de Windows que tenemos y también
; se pueden añadir otros parámetros relacionados con la aplicación desde la que se está iniciando la conexión a Internet.
; Si no se indica nada se usará el valor por defecto "Mozilla/5.0 (compatible; Windows NT 6.1; Win64; x64; rv:74.0)"
; Según la documentación del Mozilla Developer: The User-Agent request header is a characteristic string that lets servers and network peers identify the application, 
; operating system, vendor, and/or version of the requesting user agent.
; Syntax:
; User-Agent: <product> / <product-version> <comment>
; Common format for web browsers:
; User-Agent: Mozilla/5.0 (<system-information>) <platform> (<platform-details>) <extensions>
; Directives:
; <product> A product identifier — its name or development codename.
; <product-version> Version number of the product.
; <comment> Zero or more comments containing more details; sub-product information, for example. 
;InternetUserAgent=Mozilla/5.0 (compatible; Windows NT 6.1; Win64; x64; rv:74.0)


; Gestión de la memoria en ficheros de tipo IMG,TIFF
; Valores posibles:
;	0=Automático  1=Mantener visualización preparada en memoria  2=Mantener visualización preparada en disco temporal
;	3=Generar cada visualización a partir del fichero original
; El valor por defecto es 0
; GestioMemoriaIMG=3
GestioMemoriaIMG=0

; Gestión de la memoria en ficheros de tipo RGB->24bits
; Valores posibles:
;	0=Automático  1=Mantener visualización preparada en memoria  2=Mantener visualización preparada en disco temporal
;	3=Generar cada visualización a partir del fichero original
; El valor por defecto es 0
; GestioMemoriaRGB24=3
GestioMemoriaRGB24=0

; Gestión de la memoria en ficheros de tipo JPEG
; Valores posibles:
;	0=Automático  1=Mantener visualización preparada en memoria  2=Mantener visualización preparada en disco temporal
; El valor por defecto es 0
; GestioMemoriaJPEG=1
GestioMemoriaJPEG=0

; Gestión de la memoria en ficheros de tipo JPEG2000
; Valores posibles:
;	0=Automático  1=Mantener visualización preparada en memoria  2=Mantener visualización preparada en disco temporal
;	3=Generar cada visualización a partir del fichero original
; El valor por defecto es 0
; GestioMemoriaJPEG2000=3
GestioMemoriaJPEG2000=0

; Gestión de la memoria en ficheros de tipo BMP
; Valores posibles:
;	0=Automático  1=Mantener visualización preparada en memoria  2=Mantener visualización preparada en disco temporal
;	3=Generar cada visualización a partir del fichero original
; El valor por defecto es 0
; GestioMemoriaBMP=3
GestioMemoriaBMP=0

; Gestión de la memoria en ficheros de tipo SID
; Valores posibles:
;	0=Automático  1=Mantener visualización preparada en memoria  2=Mantener visualización preparada en disco temporal
;	3=Generar cada visualización a partir del fichero original
; El valor por defecto es 0
; GestioMemoriaSID=3
GestioMemoriaSID=0

; Gestión de la memoria en ficheros de tipo ECW
; Valores posibles:
;	0=Automático  1=Mantener visualización preparada en memoria
;	3=Generar cada visualización a partir del fichero original
; El valor por defecto es 0
; GestioMemoriaECW=3
GestioMemoriaECW=0

; Gestión de la memoria en ficheros ráster leídos con librerias GDAL
;     0=Automático;
;     3=Generar cada visualización a partir del fichero original
GestioMemoriaRasterGDAL=3

; Gestión de la memoria en ficheros vectoriales de tipo PNT, ARC, NOD, POL, SHP y DXF.
; Valores posibles:
;	0=Automático  1=Mantener visualización preparada en memoria
;	3=Generar cada visualización a partir del fichero original
; El valor por defecto es 0
; GestioMemoriaVectorsTipics=1
GestioMemoriaVectorsTipics=0

; Gestión de la memoria en ficheros vectoriales leídos con librerías GDAL/OGR
;     0=Automático
;     3=Generar cada visualización a partir del fichero original
GestioMemoriaVectorGDAL=3

; Gestión de la memoria en tablas DBF (clásicas y extendidas)
; Valores posibles:
; 0=Automático  1=Cargar en memoria
; 3=Gestionar a partir del fichero original
; El valor por defecto es 0
; GestioMemoriaTaules=1
GestioMemoriaTaules=0

; Tiempo máximo de espera (en segundos) antes de visualizar ficheros ECWP.
; El protocolo ECWP (ecwp://) permite el acceso a ficheros ECW remotos que,
; en determinadas circunstancias, pueden tardar mucho en llegar
; a su máxima resolución. A pesar de esto, es posible que
; una imagen con una calidad razonable ya pueda ser visualizada transcurrido
; un tiempo prudencial. Dado que la descarga del fragmento
; de fichero continúa en segundo plano, el usuario puede pedir 
; un redibujado (F5 o el botón/menú correspondiente) para mejorar la definición de la imagen
; mostrada.
; El valor por defecto es 7
;TempsEsperaRespostaECWP=7


