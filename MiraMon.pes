;==========================================================================
[MSA]
;==========================================================================
; SECCIÓN PARA LA CONFIGURACIÓN DEL COMPORTAMIENTO DE LAS APLICACIONES DE SOPORTE A MiraMon (MSA)
;==========================================================================

; Generación de campos con distancias y áreas elipsoidales: 0=No 1=Sí (defecto)
CampsAmbMesuresEllipsoidals=1

; Versión del REL/DOC/DVC al crear ficheros nuevos: 1=REL1/DOC/DV?, 4=REL4, 4+DOC=REL4 y DOC
; 4 es la opción por defecto
VersioEnCrearREL=4

; Estilo de linaje usado para los ficheros nuevos o modificados:
;   0/ El linaje se representa en forma de árbol dentro del REL de la capa
;      resultado (se importa el linaje de las capas anteriores durante la creación
;      de la capa y no crea vínculos a las capas anteriores). (Introducido en 2015.)
;   1/ Listado de procesos simple sin mencionar formalmente las fuentes de datos
;      (aunque las fuentes pueden aparecer citadas en el texto de la historia de
;      cada proceso). (Era el único estilo disponible antes de 01-12-2013.)
;   2/ El linaje se hereda de los REL de las capas originales en forma de árbol.
;      (Introducido el 01-12-2013, pero como otro número de opción. Se ha cambiado al evidenciarse que
;      este estilo genera una cadena de vínculos entre capas que el usuario rompe a menudo, 
;      sin quererlo, por ejemplo borrando capas intermedias que ya no necesita. Por ello, se
;      considera que si el usuario desea estos vínculos, es mejor que los establezca
;      manualmente con el gestor de metadatos [GeM+]).Valor por defecto.
;
;EstilLlinatge=2

; Indica que se desea abrir el fichero resultado de la ejecución de una MSA de manera automática desde la 
; sesión de MiraMon de la que se ha iniciado la MSA. Valor por defecto: 1 (0 indica que no se quiere abrir).
;ObrirResultatMSAaMiraMon=0


;==========================================================================
[ORGANISME]
;==========================================================================
; ORGANISMO POR DEFECTO
;==========================================================================
; Organismo por defecto de este usuario de MiraMon. Esta sección es creada por
; el programa de instalación de MiraMon (Inst_MM9.exe en la versión 9 de MiraMon). 
; Puede obtener una descripción detallada de las claves que describen un organismo 
; en el manual de MiraMon
;==========================================================================

;IndividualName=
;PositionName=
;OrganisationName=CREAF
;n_onlineResource=2

;[ORGANISME:ONLINE_RESOURCE_1]
;linkage=http://www.creaf.cat
;function=2

;[ORGANISME:ONLINE_RESOURCE_2]
;linkage=https://www.miramon.cat
;function=2


;===========================================================================
[CONFIG_METADATA]
;===========================================================================
; CONFIGURAR VISUALIZACIÓN DE CLAVES OBLIGATORIAS EN EL GESTOR DE METADATOS
;===========================================================================
; La clave ObligatorietatNegreta indica al Gestor de Metadatos que se desea mostrar
; los metadatos obligatorios en negrita.
; Valores posibles:
; 0 -> No indicar los metadatos obligatorios en negrita
; 1 -> Sí indicar los metadatos obligatorios en negrita (valor por defecto)
;ObligatorietatNegreta=1

; La clave TipusObligatorietatEx indica 'quién' determina qué metadatos son obligatorios en el Gestor de Metadatos 
; (por ejemplo para mostrarlos en negrita si es necesario).
; Valores posibles:
; -1 -> Obligatoriedad definida de forma automática según el formato (REL o XML) y los estándares (ISO 19115-19139 o la directiva INSPIRE) (valor por defecto)
; 0 -> Obligatoriedad definida por el Gestor de Metadatos (basada en los estándares) 
; 1 -> Obligatoriedad definida por el usuario
; 2 -> Obligatoriedad definida por la ISO 1915-19139
; 3 -> Obligatoriedad definida por la directiva INSPIRE
; 4 -> Obligatorietat definida por los parámetreos de la IDEC
;TipusObligatorietatEx=-1

; En caso que TipusObligatorietat=1 (usuario), ubicación y nombre de la plantilla
; de texto que define la obligatoriedad de cada entrada de metadatos.
; Por defecto, se utiliza la plantilla interna de MiraMon para los estándares ISO y GeM+.
; Esta plantilla se puede crear desde el propio GeM+ al exportar las características
; de obligatoriedad desde la pestaña Configuración.
; PlantillaObligatoriUsu=c:\MiraMon\Plantill\PlantillaObligatorioUsu.txt
;PlantillaObligatoriUsu=

; La clave IdiomaMostrar indica cuál es el idioma de los metadatos multiidiomáticos
; que se desea visualizar al abrir una capa en MiraMon y en el propio Gestor de
; Metadatos como valor en primer término.
; Por defecto se inicializa con el idioma en el que está instalado MiraMon, pero
; en el Gestor de Metadatos se puede modificar (para aquella sesión del Gestor).
; La clave IdiomaMostrar permite forzar un idioma por encima de este comportamiento
; siempre y cuando la capa tenga los metadatos en el idioma solicitado.
; Valores posibles:
; cat -> catalán
; spa -> castellano
; eng -> inglés
; alt -> el otro idioma en que se pueden documentar los metadatos
; Recuerde que si no indica nada se adopta el idioma del MiraMon si coincide con
; uno de los idiomas de la base.
IdiomaMostrar=spa

; La clave DesarProcesEdicioMD indica al Gestor de Metadatos que al guardar los
; metadatos después de su edición desde el GeM+ se desea crear (o actualizar) 
; un proceso de linaje de edición de metadatos.
; Valores posibles:
; 0 -> No guardar (ni actualizar) los procesos de edición de metadatos en el linaje (valor por defecto)
; 1 -> Guardar (o actualizar) los procesos de edición de metadatos en el linaje
DesarProcesEdicioMD=0

; Color que se desea como color de fondo de la interfaz del GeM+
; Si no se indica nada se usará el color por defecto de Windows
ColorFons=(225, 234, 247)

; Color en que se pintarán los bordes de los recursos de la interfaz del GeM+
; Si no se indica nada se usará el color por defecto de Windows
ColorVores=(122,153,177)


; Algunas visualizaciones o exportaciones de los metadatos en HTML incorporan
;o pueden incorporar un mapa de situación elaborado a partir de la envolvente de la capa y de mapas generales extraídos de servicios WMS

; Tamaño máximo que tendrá el cuadrado donde se mostrará la imagen de situación en las visualizaciones en HTML de los metadatos
; Valor por defecto 300
MidaSituacioHTML=300

; Plantillas de peticiones a capas en formato WMS que se usarán para construir la imagen de situación en las visualizaciones en HTML de los metadatos
; Se comenzará por la primera y si esta falla se usará la siguiente y así sucesivamente
; Se trata de peticiones a servicios WMS con todos los parámetros establecidos a excepción de BBOX, HEIGHT y WIDTH
; No hay ningún valor por defecto
PeticioCapaWMS1=https://maps.heigit.org/osm-wms/service?SERVICE=WMS&VERSION=1.1.1&REQUEST=GetMap&SRS=EPSG:3857&LAYERS=osm_auto:all&FORMAT=image/jpeg&STYLES=default
PeticioCapaWMS2=https://ows.terrestris.de/osm/service?VERSION=1.1.1&REQUEST=GetMap&SRS=EPSG:4326&SERVICE=WMS&LAYERS=TOPO-OSM-WMS&FORMAT=image/jpeg&STYLES=default
PeticioCapaWMS3=https://ows.mundialis.de/osm/service?VERSION=1.1.1&REQUEST=GetMap&SRS=EPSG:4326&SERVICE=WMS&LAYERS=OSM-WMS&FORMAT=image/jpeg&STYLES=default
PeticioCapaWMS4=https://ows.terrestris.de/osm/service?VERSION=1.1.1&REQUEST=GetMap&SRS=EPSG:3857&SERVICE=WMS&LAYERS=OSM-WMS&FORMAT=image/jpeg&STYLES=default
PeticioCapaWMS5=https://ows.mundialis.de/osm/service?VERSION=1.1.1&REQUEST=GetMap&SRS=EPSG:3857&SERVICE=WMS&LAYERS=OSM-WMS&FORMAT=image/jpeg&STYLES=default
PeticioCapaWMS6=https://ows.terrestris.de/osm/service?VERSION=1.1.1&REQUEST=GetMap&SRS=EPSG:3857&SERVICE=WMS&LAYERS=TOPO-WMS&FORMAT=image/jpeg&STYLES=default
PeticioCapaWMS7=https://ows.mundialis.de/osm/service?VERSION=1.1.1&REQUEST=GetMap&SRS=EPSG:3857&SERVICE=WMS&LAYERS=TOPO-WMS&FORMAT=image/jpeg&STYLES=default

; La capa asociada a los metadatos, en caso que exista, se abrirá con el programa registrado en Windows.
; Si esta variable vale 0, siempre se abrirá con MiraMon o se dejará el botón inactivo
; si no hay ninguno de los programas nombrados disponibles.
; Valor por defecto 1
UsarProgramaRegistrat=1

;===========================================================================
[GEODATABASE]
;===========================================================================
;===========================================================================
; CONFIGURACIÓN DE ASPECTOS RELACIONADOS CON LAS GEODATABASES: SDE, SDO,...
;===========================================================================
; La clave RefrescLlistaCapesSDO indica a MiraMon que se desea mostrar
; el botón de refresco de la lista de capas del SDO. Es una acción que puede tardar
; mucho y que puede interesar desactivarla para algunos usuarios
; Valores posibles:
; 0: No, no permite refrescar las capas.
; 1: Sí, permite refrescar las capas.
;RefrescLlistaCapesSDO=0
RefrescLlistaCapesSDO=1