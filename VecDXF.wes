<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:VecDXF:Param1:1</ows:Identifier>
		<ows:Title>VecDXF</ows:Title>
		<ows:Abstract>Esta opción realiza la transformación directa de puntos y nodos a puntos, líneas y arcos a polilíneas abiertas, polígonos a polilíneas cerradas.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Exportación de capas vectoriales MiraMon a ficheros DXF"/>
		<ows:Metadata xlink:title="Abstract:Esta aplicación realiza la conversión de ficheros vectoriales estructurados de puntos, arcos, polígonos o nodos (formatos PNT, ARC, POL o NOD) y de ficheros no estructurados de puntos, líneas o polígonos (formato VEC) a formato DXF, importable por AutoCAD (consulte el comando DXFIN en el manual de AutoCAD) y por otros programas, como MicroStation, CorelDraw o MS-Word. También exporta la 3ª dimensión si está presente en los formatos de origen."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 1</ows:Title>
				<ows:Abstract>Transformación directa. De puntos y nodos a puntos. De líneas y arcos a polilíneas abiertas. De polígonos a polilíneas cerradas.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerVEC</ows:Identifier>
				<ows:Title>Nombre fichero vectorial</ows:Title>
				<ows:Abstract>Es el nombre del fichero vectorial (PNT,ARC,NOD,POL,VEC) a convertir.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NombreFichVec"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-PNT</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-ARC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-NOD</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-POL</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ESCALAT</ows:Identifier>
				<ows:Title>ESCALAT</ows:Title>
				<ows:Abstract>Es el escalado aplicado a las coordenadas X,Y. Por defecto vale 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_X</ows:Identifier>
				<ows:Title>Desplazamiento X</ows:Title>
				<ows:Abstract>Es el desplazamiento aplicado a las coordenadas X. Por defecto vale 0.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_Y</ows:Identifier>
				<ows:Title>Desplazamiento Y</ows:Title>
				<ows:Abstract>Es el desplazamiento aplicado a las coordenadas Y. Por defecto vale 0.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_DECIMALS</ows:Identifier>
				<ows:Title>Número de decimales</ows:Title>
				<ows:Abstract>Número de cifras decimales escritas en las coordenadas del fichero DXF de salida; por defecto vale 6.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>6</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>UNICAPA</ows:Identifier>
				<ows:Title>Unicapa</ows:Title>
				<ows:Abstract>Nombre de la capa DXF si desea todos los elementos en la misma capa. Si no se indica, el atributo de cada elemento será su capa.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TAULA</ows:Identifier>
				<ows:Title>Tabla</ows:Title>
				<ows:Abstract><![CDATA[/TAULA= y /CAMP= indique el campo de la base de datos que se exporta como capa o texto a formato DXF. Para saber más sobre los valores de estos parámetros siga las consideraciones del documento de <a href="general.htm#Repe">sintaxis general</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP</ows:Identifier>
				<ows:Title>Campo</ows:Title>
				<ows:Abstract><![CDATA[/TAULA= y /CAMP= indique el campo de la base de datos que se exporta como capa o texto a formato DXF. Para saber más sobre los valores de estos parámetros siga las consideraciones del documento de <a href="general.htm#Repe">sintaxis general</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CONSIDER_NODATA</ows:Identifier>
				<ows:Title>Valores sindatos</ows:Title>
				<ows:Abstract>Incluye valores sindatos en la consulta. Solo tiene efecto si hay una selección por atributos.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REPE</ows:Identifier>
				<ows:Title>Repe</ows:Title>
				<ows:Abstract><![CDATA[Indica qué registro es escogido cuando hay más de un registro para un identificador gráfico (registro múltiple). Para saber más sobre los valores de este parámetro siga las consideraciones del documento de <a href="general.htm#Repe">sintaxis general</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALCADA</ows:Identifier>
				<ows:Title>Altura</ows:Title>
				<ows:Abstract><![CDATA[Indica cuál de las posibles alturas se escribe en el DXF. Para saber más sobre los valores de este parámetro siga las consideraciones del documento de <a href="general.htm#Repe">sintaxis general</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFitxDXF</ows:Identifier>
				<ows:Title>Nombre fichero DXF</ows:Title>
				<ows:Abstract>Es el nombre del fichero DXF de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NombreFichDXF"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-DXF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DXF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:VecDXF:Param1:2</ows:Identifier>
		<ows:Title>VecDXF text</ows:Title>
		<ows:Abstract>Esta opción transforma puntos en textos DXF (el atributo se convierte en el texto).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 2</ows:Title>
				<ows:Abstract>Transforma puntos a textos.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerVEC</ows:Identifier>
				<ows:Title>Nombre fichero vectorial</ows:Title>
				<ows:Abstract>Es el nombre del fichero vectorial (PNT,ARC,NOD,POL,VEC) a convertir.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:NombreFichVec"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-PNT</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-ARC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-NOD</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-POL</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>AlçadaText</ows:Identifier>
				<ows:Title>Altura texto</ows:Title>
				<ows:Abstract>Es el tamaño del texto DXF en unidades mapa.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:AlturaTexto"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ESCALAT</ows:Identifier>
				<ows:Title>ESCALAT</ows:Title>
				<ows:Abstract>Es el escalado aplicado a las coordenadas X,Y. Por defecto vale 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_X</ows:Identifier>
				<ows:Title>Desplazamiento X</ows:Title>
				<ows:Abstract>Es el desplazamiento aplicado a las coordenadas X. Por defecto vale 0.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_Y</ows:Identifier>
				<ows:Title>Desplazamiento Y</ows:Title>
				<ows:Abstract>Es el desplazamiento aplicado a las coordenadas Y. Por defecto vale 0.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_DECIMALS</ows:Identifier>
				<ows:Title>Número de decimales</ows:Title>
				<ows:Abstract>Número de cifras decimales escritas en las coordenadas del fichero DXF de salida; por defecto vale 6.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>6</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>UNICAPA</ows:Identifier>
				<ows:Title>Unicapa</ows:Title>
				<ows:Abstract>Nombre de la capa DXF si desea todos los elementos en la misma capa. Si no se indica, el atributo de cada elemento será su capa.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>JOC_CARAC</ows:Identifier>
				<ows:Title>Juego de caracteres</ows:Title>
				<ows:Abstract>Juego de caracteres deseado para los textos; puede ser ANSI-1252 o OEM-850. Por defecto vale ANSI-1252.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>ANSI-1252</ows:Value>
						<ows:Value>OEM-850</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>ANSI-1252</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TAULA</ows:Identifier>
				<ows:Title>Tabla</ows:Title>
				<ows:Abstract><![CDATA[/TAULA= y /CAMP= indique el campo de la base de datos que se exporta como capa o texto a formato DXF. Para saber más sobre los valores de estos parámetros siga las consideraciones del documento de <a href="general.htm#Repe">sintaxis general</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP</ows:Identifier>
				<ows:Title>Campo</ows:Title>
				<ows:Abstract><![CDATA[/TAULA= y /CAMP= indique el campo de la base de datos que se exporta como capa o texto a formato DXF. Para saber más sobre los valores de estos parámetros siga las consideraciones del documento de <a href="general.htm#Repe">sintaxis general</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CONSIDER_NODATA</ows:Identifier>
				<ows:Title>Valores sindatos</ows:Title>
				<ows:Abstract>Incluye valores sindatos en la consulta. Solo tiene efecto si hay una selección por atributos.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REPE</ows:Identifier>
				<ows:Title>Repe</ows:Title>
				<ows:Abstract><![CDATA[Indica qué registro es escogido cuando hay más de un registro para un identificador gráfico (registro múltiple). Para saber más sobre los valores de este parámetro siga las consideraciones del documento de <a href="general.htm#Repe">sintaxis general</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALCADA</ows:Identifier>
				<ows:Title>Altura</ows:Title>
				<ows:Abstract><![CDATA[Indica cuál de las posibles alturas se escribe en el DXF. Para saber más sobre los valores de este parámetro siga las consideraciones del documento de <a href="general.htm#Repe">sintaxis general</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFitxDXF</ows:Identifier>
				<ows:Title>Nombre fichero DXF</ows:Title>
				<ows:Abstract>Es el nombre del fichero DXF de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NombreFichDXF"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-DXF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DXF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>