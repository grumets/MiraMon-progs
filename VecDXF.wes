<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:vecDXF:Param1:1</ows:Identifier>
		<ows:Title>VecDXF</ows:Title>
		<ows:Abstract>Esta opción hace la transformación directa de puntos i nodos a puntos, línias y arcos a polilinias abiertas, polígonos a polilinias cerradas.</ows:Abstract>
<ows:Metadata xlink:title="Title:Exportación de capes vectoriales MiraMon a ficheros DXF" />
<ows:Metadata xlink:title="Abstract:Esta aplicación realiza la conversión de ficheros vectoriales estructurados de puntos, arcos, polígonos o nodos (formatos PNT, ARC, POL o NOD) y de ficheros no estructurados de puntos, líneas o polígonos (formato VEC) a formato DXF, importable por AutoCAD (consulte el comando DXFIN en el manual de AutoCAD) y por otros programas, como por ejemplo MicroStation, CorelDraw o MS-Word. También exporta la 3a dimensión si está presente en los formatos de origen." />
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcion</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>1. Transformación directa:<![CDATA[<li>Puntos y nodos -> puntos</li><li>Líneas y arcos -> polilíneas abiertas</li><li>polígonos -> polilíneas cerradas</li>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NombreFichVec</ows:Identifier>
				<ows:Title>Nombre Fichero Vectorial</ows:Title>
				<ows:Abstract>Es el nombre del fichero vectorial (PNT,ARC,NOD,POL,VEC) a convertir.</ows:Abstract>
						<ows:Metadata xlink:title="Param2" />
					<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-PNT</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-ARC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-NOD</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-POL</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ESCALAT</ows:Identifier>
				<ows:Title>ESCALAT</ows:Title>
				<ows:Abstract>Es el escalado aplicado a las coordenadas x,y. Por defecto vale 1.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_X</ows:Identifier>
				<ows:Title>Desplazamiento X</ows:Title>
				<ows:Abstract>Es el desplazamiento aplicado a las coordenadas x. Por defecto vale 0.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimals">decimal</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_Y</ows:Identifier>
				<ows:Title>Desplazamiento Y</ows:Title>
				<ows:Abstract>Es el desplazamiento aplicado a las coordenadas y. Por defecto vale 0.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_DECIMALS</ows:Identifier>
				<ows:Title>Numero de decimales</ows:Title>
				<ows:Abstract>Número de cifras decimales escritas en las coordenadas del fichero DXF de salida; por defecto vale 6.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>6</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>UNICAPA</ows:Identifier>
				<ows:Title>Unicapa</ows:Title>
				<ows:Abstract>Nombre de la capa DXF si desea todos los elementos en la misma capa. Si no se indica, el atributo de cada elemento será su capa.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TAULA</ows:Identifier>
				<ows:Title>Tabla</ows:Title>
				<ows:Abstract>Indique el campo de la base de datos que se exporta como capa o texto a formato DXF. Para saber más sobre los valores de estos parámetros siga las consideraciones del documento de sintaxis general.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP</ows:Identifier>
				<ows:Title>Campo</ows:Title>
				<ows:Abstract>Indique el campo de la base de datos que se exporta como capa o texto a formato DXF. Para saber más sobre los valores de estos parámetros siga las consideraciones del documento de sintaxis general.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REPE</ows:Identifier>
				<ows:Title>Repe</ows:Title>
				<ows:Abstract>Indica qué registro es escogido cuando hay más de un registro para un identificador gráfico (registro múltiple). Para saber más sobre los valores de este parámetro siga las consideraciones del documento de sintaxis general.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALCADA</ows:Identifier>
				<ows:Title>Altura</ows:Title>
				<ows:Abstract>Indica cual de las posibles alturas se escribe en el DXF. Para saber más sobre los valores de este parámetro siga las consideraciones del documento de sintaxis general.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFichDXF</ows:Identifier>
				<ows:Title>Nombre Fichero DXF</ows:Title>
				<ows:Abstract>Es el nombre del fichero DXF de salida.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
						<ComplexOutput>
							<Default>
						<Format>
							<MimeType>application/x-DXF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DXF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
							</Supported>
						</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:vecDXF:Param1:2</ows:Identifier>
		<ows:Title>VecDXF texto</ows:Title>
		<ows:Abstract>Esta opción hace la transformación directa de puntosa textos.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcion</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>2. Transforma puntos -> textos.</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NombreFichVec</ows:Identifier>
				<ows:Title>Nombre Fichero Vectoial</ows:Title>
				<ows:Abstract>Es el nombre del fichero vectorial (PNT,ARC,NOD,POL,VEC) a convertir.</ows:Abstract>
						<ows:Metadata xlink:title="Param2" />
					<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-PNT</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-ARC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-NOD</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-POL</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>	
				<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>AlturaTexto</ows:Identifier>
				<ows:Title>Altura Texto</ows:Title>
				<ows:Abstract>Es el tamaño del texto DXF en unidades mapa.</ows:Abstract>
							<ows:Metadata xlink:title="Param4" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ESCALAT</ows:Identifier>
				<ows:Title>ESCALAT</ows:Title>
				<ows:Abstract>Es el escalado aplicado a las coordenadas x,y. Por defecto vale 1.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_X</ows:Identifier>
				<ows:Title>Desplazamiento X</ows:Title>
				<ows:Abstract>Es el desplazamiento aplicado a las coordenadas x. Por defecto vale 0.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimals">decimal</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_Y</ows:Identifier>
				<ows:Title>Desplazamiento Y</ows:Title>
				<ows:Abstract>Es el desplazamiento aplicado a las coordenadas y. Por defecto vale 0.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_DECIMALS</ows:Identifier>
				<ows:Title>Numero decimales</ows:Title>
				<ows:Abstract>Número de cifras decimales escritas en las coordenadas del fichero DXF de salida; por defecto vale 6.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>6</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>UNICAPA</ows:Identifier>
				<ows:Title>Unicapa</ows:Title>
				<ows:Abstract>Nombre de la capa DXF si desea todos los elementos en la misma capa. Si no se indica, el atributo de cada elemento será su capa.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>JOC_CARAC</ows:Identifier>
				<ows:Title>Juego de caracteres</ows:Title>
				<ows:Abstract>Juego de caracteres deseado para los textos; puede ser ANSI-1252 o OEM-850. Por defecto vale ANSI-1252.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
					<ows:Value>ANSI-1252</ows:Value>
					<ows:Value>OEM-850</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>ANSI-1252</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TAULA</ows:Identifier>
				<ows:Title>Tabla</ows:Title>
				<ows:Abstract>Indique el campo de la base de datos que se exporta como capa o texto a formato DXF. Para saber más sobre los valores de estos parámetros siga las consideraciones del documento de sintaxis general.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP</ows:Identifier>
				<ows:Title>Campo</ows:Title>
				<ows:Abstract>Indique el campo de la base de datos que se exporta como capa o texto a formato DXF. Para saber más sobre los valores de estos parámetros siga las consideraciones del documento de sintaxis general.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REPE</ows:Identifier>
				<ows:Title>Repe</ows:Title>
				<ows:Abstract>Indica qué registro es escogido cuando hay más de un registro para un identificador gráfico (registro múltiple). Para saber más sobre los valores de este parámetro siga las consideraciones del documento de sintaxis general.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
				<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALCADA</ows:Identifier>
				<ows:Title>Altura</ows:Title>
				<ows:Abstract>Indica cual de las posibles alturas se escribe en el DXF. Para saber más sobre los valores de este parámetro siga las consideraciones del documento de sintaxis general.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NombreFichDXF</ows:Identifier>
				<ows:Title>Nombre Fichero DXF</ows:Title>
				<ows:Abstract>Es el nombre del fichero DXF de salida.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
						<ComplexOutput>
							<Default>
						<Format>
							<MimeType>application/x-DXF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DXF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
							</Supported>
						</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
