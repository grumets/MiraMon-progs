<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CalcImg:1</ows:Identifier>
		<ows:Title>CalcImg</ows:Title>
		<ows:Abstract>This program allows performing reclassifications and mathematical and logical operations, simultaneously, on layers of any type (rasters, structured vectors and unstructured vectors), in any number and in any directory. The logical operations return 1 in the true case and 0 in the false case.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Layers and fields Calculator/Reclassifier:
  Mathematical and Logical Analysis"/>
		<ows:Metadata xlink:title="Abstract:This program allows performing reclassifications and mathematical and logical operations, simultaneously, on layers of any type (raster, structured vectors and unstructured vectors), in any number and in any directory. The logical operations return 1 in the true case and 0 in the false case."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerParametres</ows:Identifier>
				<ows:Title>Parameters file</ows:Title>
				<ows:Abstract>Calculations are made according to parameters specified in the  _PARCLMM.MMC file in the MiraMon directory or in the operating system  temporary directory when the MiraMon directory is read-only (the typical  situation when MiraMon is installed in a server).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:ParametersFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmc</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmc</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerParametres</ows:Identifier>
				<ows:Title>Parameters file</ows:Title>
				<ows:Abstract>Calculations are made according to parameters specified in the  _PARCLMM.MMC file in the MiraMon directory or in the operating system  temporary directory when the MiraMon directory is read-only (the typical  situation when MiraMon is installed in a server).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:ParametersFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmc</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmc</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>