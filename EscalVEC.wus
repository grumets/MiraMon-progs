<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:EscalVEC:param1:1</ows:Identifier>
		<ows:Title>EscalVEC 1</ows:Title>
		<ows:Abstract> General scaling</ows:Abstract>
	<ows:Metadata xlink:title="Title:Scaling and displacement of vector VEC files"/>
<ows:Metadata xlink:title="Abstract:This program performs a change of scale and/or a shift of vector files in non-structured VEC format. It also changes map coordinates to paper coordinates as a prior step for exporting the some drawing packages."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Option</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>1. General scaling. X and Y displacements (XDisplac and YDisplac) are applied after the scaling. Units is the new documented units (Indicate 'x' for leave previous units).</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>InpFile</ows:Identifier>
				<ows:Title>Input File</ows:Title>
				<ows:Abstract>Is the input file name to be scaled and/or shifted.
</ows:Abstract>
			<ows:Metadata xlink:title="Param2" />
			<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-VEC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
					<MimeType>application/x-VEC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Scaling</ows:Identifier>
				<ows:Title>Scaling factor</ows:Title>
				<ows:Abstract>Scale is the dividend of the final scale: (for ex.: 50000)
</ows:Abstract>
			<ows:Metadata xlink:title="Param4" />
	<LiteralData>
		<ows:AllowedValues>
		<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
		<ows:AnyValue/>
		</ows:AllowedValues>
	</LiteralData>
			</Input>			
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Units</ows:Identifier>
				<ows:Title>Units</ows:Title>
				<ows:Abstract>New units:<![CDATA[
        <ul><li>mm (mil·límetres)</li>
        <li>cm (centímetres)</li>
        <li>pz o inch (polzades)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param5" />
				<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
						<ows:Value>mm</ows:Value>
						<ows:Value>cm</ows:Value>
						<ows:Value>pz</ows:Value>
						<ows:Value>inch</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>XDisplac</ows:Identifier>
				<ows:Title>X Displacement</ows:Title>
				<ows:Abstract>X Displacement</ows:Abstract>
				<ows:Metadata xlink:title="Param6" />
				<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
						<ows:AnyValue/>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
					<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>XDisplac</ows:Identifier>
				<ows:Title>Y Displacement</ows:Title>
				<ows:Abstract>Y Displacement</ows:Abstract>
				<ows:Metadata xlink:title="Param7" />
				<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
						<ows:AnyValue/>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Precision</ows:Identifier>
				<ows:Title>Precision</ows:Title>
				<ows:Abstract>Is the number of decimal digits written in the output file; it is 3 by default.</ows:Abstract>
			<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
						<ows:AnyValue/>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
	<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ESCALAT_Z</ows:Identifier>
				<ows:Title>ESCALAT Z</ows:Title>
				<ows:Abstract>Is the Z scale factor when the file is a 3D VEC. 
</ows:Abstract>
	<LiteralData>
		<ows:AllowedValues>
		<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
		<ows:AnyValue/>
		</ows:AllowedValues>
	</LiteralData>
			</Input>				
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DESPLAC_Z</ows:Identifier>
				<ows:Title>DESPLAC Z</ows:Title>
				<ows:Abstract>Is the Z displacements when the file is a 3D VEC.
</ows:Abstract>
	<LiteralData>
		<ows:AllowedValues>
		<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
		<ows:AnyValue/>
		</ows:AllowedValues>
	</LiteralData>
			</Input>						
</DataInputs>
	<ProcessOutputs>	
		<Output>
				<ows:Identifier>OutFile</ows:Identifier>
				<ows:Title>Output File</ows:Title>
				<ows:Abstract>Is the output file name.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
				<ComplexOutput>
					<Default>
							<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:EscalVEC:param1:2</ows:Identifier>
		<ows:Title>EscalVEC 2</ows:Title>
		<ows:Abstract>Change of scale</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Option</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>2. Change of scale.
</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>InpFile</ows:Identifier>
				<ows:Title>Input File</ows:Title>
				<ows:Abstract>Is the input file name to be scaled and/or shifted.
</ows:Abstract>
			<ows:Metadata xlink:title="Param2" />
			<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-VEC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
					<MimeType>application/x-VEC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Scale</ows:Identifier>
				<ows:Title>Scale</ows:Title>
				<ows:Abstract>Scale is the dividend of the final scale: (for ex.: 50000) 
</ows:Abstract>
			<ows:Metadata xlink:title="Param4" />
	<LiteralData>
		<ows:AllowedValues>
		<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
		<ows:AnyValue/>
		</ows:AllowedValues>
	</LiteralData>
			</Input>			
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Units</ows:Identifier>
				<ows:Title>Units</ows:Title>
				<ows:Abstract>New units:<![CDATA[
        <ul><li>mm (mil·límetres)</li>
        <li>cm (centímetres)</li>
        <li>pz o inch (polzades)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param5" />
				<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
						<ows:Value>mm</ows:Value>
						<ows:Value>cm</ows:Value>
						<ows:Value>pz</ows:Value>
						<ows:Value>inch</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Xmin</ows:Identifier>
				<ows:Title>X min</ows:Title>
				<ows:Abstract>Xmin and Ymin are the coordinates that will be located at the new point 0,0. You can use numbers or use some of the extreme coordinates of the file, writing for example, 'Xmin Ymin'</ows:Abstract>
				<ows:Metadata xlink:title="Param6" />
			<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
					<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Ymin</ows:Identifier>
				<ows:Title>Y min</ows:Title>
				<ows:Abstract>Ymin and Xmin are the coordinates that will be located at the new point 0,0. You can use numbers or use some of the extreme coordinates of the file, writing for example, 'Xmin Ymin'</ows:Abstract>
				<ows:Metadata xlink:title="Param7" />
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Precision</ows:Identifier>
				<ows:Title>Precision</ows:Title>
				<ows:Abstract>Is the number of decimal digits written in the output file; it is 3 by default.</ows:Abstract>
			<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
						<ows:AnyValue/>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
	<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ESCALAT_Z</ows:Identifier>
				<ows:Title>ESCALAT Z</ows:Title>
				<ows:Abstract>Is the Z scale factor when the file is a 3D VEC.
</ows:Abstract>
	<LiteralData>
		<ows:AllowedValues>
		<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
		<ows:AnyValue/>
		</ows:AllowedValues>
	</LiteralData>
			</Input>				
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DESPLAC_Z</ows:Identifier>
				<ows:Title>DESPLAC Z</ows:Title>
				<ows:Abstract>Is the Z displacements when the file is a 3D VEC.
</ows:Abstract>
	<LiteralData>
		<ows:AllowedValues>
		<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
		<ows:AnyValue/>
		</ows:AllowedValues>
	</LiteralData>
			</Input>						
</DataInputs>
	<ProcessOutputs>	
		<Output>
				<ows:Identifier>OutFile</ows:Identifier>
				<ows:Title>Output File</ows:Title>
				<ows:Abstract>Is the output file name. 
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
				<ComplexOutput>
					<Default>
							<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
