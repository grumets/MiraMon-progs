<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:IsoMM:1</ows:Identifier>
		<ows:Title>IsoMM</ows:Title>
		<ows:Abstract>Este modulo realiza una clasificacion no supervisada de una imagen inspirada en el metodo clàsico IsoData de  duda i Hart: 
Duda, RO, PE Hart (1973) "Pattern Classification and Scene Analysis" John Wiley and Sons, New York, [cap. 6, "Unsupervised Learning and Clustering", pp. 226-227] </ows:Abstract>
		<ows:Metadata xlink:title="Title:Classificació no supervisada d'imatges"/>
		<ows:Metadata xlink:title="Abstract:Este modulo realiza una clasificacion no supervisada de una imagen inspirada en el metodo clàsico IsoData de  duda i Hart: 
Duda, RO, PE Hart (1973) Pattern Classification and Scene Analysis John Wiley and Sons, New York, cap. 6, Unsupervised Learning and Clustering, pp. 226-227"/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NBandas</ows:Identifier>
				<ows:Title>Numero de  Bandas</ows:Title>
				<ows:Abstract>Número de bandas de la imagen a utilitzar (máximo 250).</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:NumBandas"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Lista</ows:Identifier>
				<ows:Title>Lista</ows:Title>
				<ows:Abstract>Fichero de texto donde hay los nombres de las diferentes bandas (con path si no somos en el mismo directorio; con extensión o asumirá IMG).</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:Lista"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NClusterInicialDiagonal</ows:Identifier>
				<ows:Title>Numero Cluster Inicial Diagonal</ows:Title>
				<ows:Abstract>Numero de centros de cluster inicial en la diagonal multivariante que utilitzaremos en la clasificación.</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:NClusterInicialDiagonal"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NClusterInicialAleatori</ows:Identifier>
				<ows:Title>NClusterInicialAleatorio</ows:Title>
				<ows:Abstract>Número de centros de cluster inicial aleatóriamente repartidos en el espacio multivariante, que utilitzaremos en la clasificación.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:NClusterInicialAleatorio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NClusterInicialMostreig</ows:Identifier>
				<ows:Title>NClusterInicialMostreo</ows:Title>
				<ows:Abstract>Distáncia mínima, en unidades terreno, entre las muestras que se usarán como centros de cluster iniciales (por ejemplo "D1000.5"), o número de estas muestras (p. ej. "N300"). Indique "D0" o "N0" si no quiere.</ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:NClusterInicialMuestreo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>LlindarConvergencia</ows:Identifier>
				<ows:Title>Umbral Convergencia</ows:Title>
				<ows:Abstract>Cuando el % de píxeles que canvian de cluster entre dos iteraciones queda por debajo de este umbral el proceso finaliza.</ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:UmbralConvergencia"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MaxIter</ows:Identifier>
				<ows:Title>Máximo Iteraciones</ows:Title>
				<ows:Abstract>Máximo numero de iteraciones que el programa realizará si no se alcanza antes el umbral de convergéncia.</ows:Abstract>
				<ows:Metadata xlink:title="Param08"/>
				<ows:Metadata xlink:title="Name:MaxIter"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MinCluster</ows:Identifier>
				<ows:Title>Minimo Cluster</ows:Title>
				<ows:Abstract>Mínimo numero de píxeles que han de formar un cluster.</ows:Abstract>
				<ows:Metadata xlink:title="Param09"/>
				<ows:Metadata xlink:title="Name:MinCluster"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MinSimil</ows:Identifier>
				<ows:Title>Minima similitud</ows:Title>
				<ows:Abstract>Mínima similitud entre clases (por banda, >=0, nombre real). Notar que solo esta implementado en las clases que provienen del criterio 3 (NClusterInicialMuestreo)</ows:Abstract>
				<ows:Metadata xlink:title="Param10"/>
				<ows:Metadata xlink:title="Name:MinSimil"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>NO DATA</ows:Title>
				<ows:Abstract>Valor de fondo a ignorar:<![CDATA[<ul><li>0 en general (usa NODATA, si hay).</li><li>1 si existe un fondo 0 pero no está correctamente documentado com a NODATA.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param11"/>
				<ows:Metadata xlink:title="Name:NODATA"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NDesvStd</ows:Identifier>
				<ows:Title>Numero Desviaciones Standard</ows:Title>
				<ows:Abstract>Numero de desviaciones estàndard que se sumaran y restaran al valor medio para a calcular donde se dispondran los centros de classe iniciales en la diagonal multivariante; si se da el valor zero se cogerà el rango de valores de toda la imagen.</ows:Abstract>
				<ows:Metadata xlink:title="Param12"/>
				<ows:Metadata xlink:title="Name:NDesvStd"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TDist</ows:Identifier>
				<ows:Title>Tipo de distáncia</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>1 (Euclidiana)</li><li>2 (Manhatan)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param13"/>
				<ows:Metadata xlink:title="Name:TDist"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MaxBandesNODATA</ows:Identifier>
				<ows:Title>Maximo numero de Bandas NODATA</ows:Title>
				<ows:Abstract>0,1,2,... MAX</ows:Abstract>
				<ows:Metadata xlink:title="Param14"/>
				<ows:Metadata xlink:title="Name:MaxBandasNODATA"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FITXER_SIGNATURES</ows:Identifier>
				<ows:Title>Ficheros firmas espectrales</ows:Title>
				<ows:Abstract>Fichero lista de firmas espectrals como criterio opcional de ubicación de categorias iniciales.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Resultat</ows:Identifier>
				<ows:Title>Resultado</ows:Title>
				<ows:Abstract>Nombre de la imagen de salida (sin extensión).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Resultado"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
