<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TOA</ows:Identifier>
		<ows:Title>TOA: TOA Apparent Reflectivity</ows:Title>
		<ows:Abstract>Allows to calculate the apparent reflectivity TOA (Top Of Atmosphere) in remote sensing images captured in the visible spectral region and the apparent temperature of brightness in images of the thermal spectrum.</ows:Abstract>
		<ows:Metadata xlink:title="Title:TOA Apparent Reflectivity."/>
		<ows:Metadata xlink:title="Abstract:This application allows to calculate the TOA apparent reflectivity (Top Of Atmosphere) in remote sensing images captured in the visible spectral region and the apparent brightness temperature images in the thermal spectrum."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerEntrada</ows:Identifier>
				<ows:Title>Image to correct</ows:Title>
				<ows:Abstract>Image to correct (may be part of a multiband raster).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:InputFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Unitats</ows:Identifier>
				<ows:Title>Thermal units</ows:Title>
				<ows:Abstract>Units in which the temperature for images of the thermal infrared spectrum are expressed</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Units"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerRAD</ows:Identifier>
				<ows:Title>RAD file</ows:Title>
				<ows:Abstract>RAD file that contains the parameters required for correction S0, K1, K2; and optionally tau0</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:RADFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-rad</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-rad</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>Multiband</ows:Title>
				<ows:Abstract>Optional parameter to correct all the bands of a multiband raster in a single execution of the program and generate a multiband raster with the corresponding bands corrected</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefix</ows:Title>
				<ows:Abstract>Prefix that is added to the names of the original files to determine the names of the corrected files for the multiband case. If no prefix is indicated, remains the same output name, except that the input and output images are in the same folder (in this case, the prefix "t_" is added to the output name).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>"t_"</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Sortida</ows:Identifier>
				<ows:Title>Output file or folder</ows:Title>
				<ows:Abstract>Result that can be a file for executions of a single band or a folder where the output files are written for multiband executions.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Output"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>