<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:IMGPNT</ows:Identifier>
		<ows:Title>Create a PNT file from a raster monoband or multiband.</ows:Title>
		<ows:Abstract>This application allows to obtain a points file from a monoband or multiband raster file, so that the value of each cell in the raster will be saved in a field in the database table of the points file.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Creation or updating of PNT files from a monoband or multiband raster"/>
		<ows:Metadata xlink:title="Abstract:This application allows to obtain a points file from a monoband or multiband raster file, so that the value of each cell in the raster will be saved in a field in the database table of the points file."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>In this case, it only can be 1.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerIMG</ows:Identifier>
				<ows:Title>Input raster file</ows:Title>
				<ows:Abstract>Input raster file that it can be monoband o multiband.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:IMGFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerPNT</ows:Identifier>
				<ows:Title>Output points file</ows:Title>
				<ows:Abstract>Points file (that it can exist) where the values of each point of one or all the bands of the input file are stored.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:PNTFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Multibanda</ows:Identifier>
				<ows:Title>Multiband</ows:Title>
				<ows:Abstract>Parameter that indicates if you want to store the value of all the bands of the input file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Afegir</ows:Identifier>
				<ows:Title>Add to the pre-existing points file.</ows:Title>
				<ows:Abstract>Parameter that indicates if you want to store the new points in the existing output file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="50">
				<ows:Identifier>COND#_OP</ows:Identifier>
				<ows:Title>Conditions or operator</ows:Title>
				<ows:Abstract>Selecting the logical operator acting on /COND_CAMP(field) to filter the pixels to transform into points.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>EQ</ows:Value>
						<ows:Value>NO_EQ</ows:Value>
						<ows:Value>EQ_SUBCADENA</ows:Value>
						<ows:Value>NO_EQ_SUBCADENA</ows:Value>
						<ows:Value>LT_EQ</ows:Value>
						<ows:Value>GT_EQ</ows:Value>
						<ows:Value>INTERVAL</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="50">
				<ows:Identifier>COND#_CAMP</ows:Identifier>
				<ows:Title>Fields of the condition</ows:Title>
				<ows:Abstract>Selection of the field on which they will apply the /COND_OP</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="50">
				<ows:Identifier>COND#_VALOR</ows:Identifier>
				<ows:Title>Value of the condition</ows:Title>
				<ows:Abstract>Value of /COND_CAMP on which it will apply the /COND_OP. It must be between quotes if it has spaces.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="50">
				<ows:Identifier>COND#_NEXE</ows:Identifier>
				<ows:Title>Nexus between conditions</ows:Title>
				<ows:Abstract>Nexus between conditions # y #+1. It can be AND o OR.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>OR</ows:Value>
						<ows:Value>AND</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerPNT</ows:Identifier>
				<ows:Title>Output points file</ows:Title>
				<ows:Abstract>Points file (that it can exist) where the values of each point of one or all the bands of the input file are stored.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:PNTFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>