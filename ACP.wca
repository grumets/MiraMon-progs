<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ACP:Param5:0</ows:Identifier>
		<ows:Title>ACP a partir de variables no estandarditzades (Opció 0)</ows:Title>
		<ows:Abstract>Calcula les components principals en base a variables no estandarditzades (utilitza la matriu de variàncies - covariàncies).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Anàlisi de components principals"/>
		<ows:Metadata xlink:title="Abstract:Aquest programa permet fer una Anàlisi de Components Principals (ACP) sobre imatges ràster, basat en la matriu de variàncies-covariàncies o la de correlacions mitjançant el càlcul dels valors propis i vectors propis."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>LlistaImg</ows:Identifier>
				<ows:Title>Llista d'imatges</ows:Title>
				<ows:Abstract>Fitxer de text (típicament amb extensió lst o txt) que conté una llista de les imatges originals, disposades en línies successives i amb extensió IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:LlistaImg"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NumeroCP</ows:Identifier>
				<ows:Title>Nombre d'imatges</ows:Title>
				<ows:Abstract>Nombre d'imatges (components principals) a crear.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NumeroCP"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>En base a variables no estandarditzades (utilitzar matriu de variàncies - covariàncies).</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Prefix</ows:Identifier>
				<ows:Title>Prefix</ows:Title>
				<ows:Abstract>Prefix dels fitxers de sortida (components principals).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>TXTSortida</ows:Identifier>
				<ows:Title>Fitxer de text de sortida</ows:Title>
				<ows:Abstract>Nom del fitxer ASCII a crear on es donaran les matrius de variàncies - covariàncies i de correlacions, i els valors i vectors propis per a totes les components. Aquest fitxer pot ser importat directament a Excel i formatat fent "Dades | Text en columnes".</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:TXTSortida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>CarpetaSortida</ows:Identifier>
				<ows:Title>Carpeta de sortida</ows:Title>
				<ows:Abstract>Directori on es guardaran les imatges de les components principals.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:CarpetaSortida"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ACP:Param5:1</ows:Identifier>
		<ows:Title>ACP a partir de variables estandarditzades (Opció 1)</ows:Title>
		<ows:Abstract>Calcula les components principals en base a variables estandarditzades (utilitza matriu de correlacions).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>LlistaImg</ows:Identifier>
				<ows:Title>Llista d'imatges</ows:Title>
				<ows:Abstract>Fitxer de text (típicament amb extensió lst o txt) que conté una llista de les imatges originals, disposades en línies successives i amb extensió IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:LlistaImg"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NumeroCP</ows:Identifier>
				<ows:Title>Nombre d'imatges</ows:Title>
				<ows:Abstract>Nombre d'imatges (components principals) a crear.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NumeroCP"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>En base a variables estandarditzades (utilitza matriu de correlacions).</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Prefix</ows:Identifier>
				<ows:Title>Prefix</ows:Title>
				<ows:Abstract>Prefix dels fitxers de sortida (components principals).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>TXTSortida</ows:Identifier>
				<ows:Title>Fitxer de text de sortida</ows:Title>
				<ows:Abstract>Nom del fitxer ASCII a crear on es donaran les matrius de variàncies - covariàncies i de correlacions, i els valors i vectors propis per a totes les components. Aquest fitxer pot ser importat directament a Excel i formatat fent "Dades | Text en columnes".</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:TXTSortida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>CarpetaSortida</ows:Identifier>
				<ows:Title>Carpeta de sortida</ows:Title>
				<ows:Abstract>Directori on es guardaran les imatges de les components principals.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:CarpetaSortida"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>