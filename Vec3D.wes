<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Vec3d:1</ows:Identifier>
		<ows:Title>Vec3d</ows:Title>
		<ows:Abstract>Aquest programa incorpora la tercera dimensió a fitxers vectorials no estructurats i a fitxers PNT o ARC a partir d'un Model Digital d'Elevacions (MDE) de la zona. Els fitxers POL i NOD adquireixen la tercera dimensió quan els ARC's vinculats són ARC's 3D.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Incorporación de la 3a dimensión a ficheros vectoriales"/>
		<ows:Metadata xlink:title="Abstract:Este programa incorpora la tercera dimensión a ficheros vectoriales no estructurados y a ficheros PNT o ARC a partir de un Modelo Digital de Elevaciones (MDE) de la zona. Los ficheros POL y NOD adquieren la tercera dimensión cuando los ARC vinculados son ARC 3D."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract><![CDATA[<li>1. Incorpora información 3D a los vértices preexistentes.</li><li>2. Enriquece con nuevos vértices y incorpora información 3D (sólo ficheros de arcos).</li>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMDE</ows:Identifier>
				<ows:Title>Fichero MDE</ows:Title>
				<ows:Abstract>Es el nombre del fichero MDE ráster.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOri</ows:Identifier>
				<ows:Title>Fichero Origen</ows:Title>
				<ows:Abstract>Es el nombre del fichero vectorial 2D o 3D de entrada (*.VEC, *.PNT, *.ARC).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-PNT</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-ARC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ModeInterpol</ows:Identifier>
				<ows:Title>Modo Interpolació</ows:Title>
				<ows:Abstract><![CDATA[Es el criterio de interpolación de los valores del ráster <ul><li>0: Vecino más próximo. No interpolar; escoger el más próximo.</li><li>1: Interpolación bilineal (4 vecinos).</li><li>2: Interpolación bicúbica (16 vecinos).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>N_DECIMALS</ows:Identifier>
				<ows:Title>Numero de decimales</ows:Title>
				<ows:Abstract>Es el número de decimales escritos en el fichero de salida; por defecto vale 6. Solamente se aplica cuando el FicheroDest es de tipo VEC.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>6</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDes</ows:Identifier>
				<ows:Title>Fichero Destino</ows:Title>
				<ows:Abstract>es el nombre del fichero vectorial 3D de salida. Puede ser igual al de origen y debe tener el mismo formato que el de entrada.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-PNT</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-ARC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>