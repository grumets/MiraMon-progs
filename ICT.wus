<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ICT:1</ows:Identifier>
		<ows:Title>Calculation of the Terrestrial Connectivity Index</ows:Title>
		<ows:Abstract>Calculation of the Terrestrial Connectivity Index.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Calculation of the Terrestrial Connectivity Index"/>
		<ows:Metadata xlink:title="Abstract:Generates a BAT/PS1 for the calculation of the Terrestrial Connectivity Index"/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxBAT</ows:Identifier>
				<ows:Title>BAT/PS1 file that allows TCI raster to be created</ows:Title>
				<ows:Abstract>BAT/PS1 file that allows TCI raster to be created.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:BATFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-bat</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-bat</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Dist</ows:Identifier>
				<ows:Title>Separation distance between focal points</ows:Title>
				<ows:Abstract>Separation distance between samples or focal points used for TCI calculation; this distance is expressed in the Horizontal Reference System units of the original files (impedances, etc.).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Distance"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Radi</ows:Identifier>
				<ows:Title>Radius of the area explored around each focal point</ows:Title>
				<ows:Abstract>Radius of the area explored around each sample or focal point; this value is expressed in the same units as Distance.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Radius"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxImped</ows:Identifier>
				<ows:Title>Impedance file</ows:Title>
				<ows:Abstract>Impedance raster file name.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:ImpedFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxAfin</ows:Identifier>
				<ows:Title>Affinity file</ows:Title>
				<ows:Abstract>Affinity raster file name.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:AfinFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FilaIni</ows:Identifier>
				<ows:Title>Initial row</ows:Title>
				<ows:Abstract><![CDATA[Initial row (included) of affinity and impedance rasters in which it is desired the TCI calculation to be prepared, numbered from 0 (top row). If the whole raster is desired to be done, enter -1 and -1. Making the program generate the BAT/PS1 so that the calculation is done only in one band (the one defined between the initial and final row) of the raster is practical when you want to parallelize the process to speed it up, starting the BAT/PS1 of each track in a different order session and / or on a different computer. In the end, all you need to do is join all the tiles together with the <a href="Mosaic.htm">Mosaic</a> tool.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:InitRow"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>-1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FilaFin</ows:Identifier>
				<ows:Title>Final row</ows:Title>
				<ows:Abstract><![CDATA[Final row (included) of affinity and impedance rasters in which it is desired the TCI calculation to be prepared, numbered from 0 (top row). If the whole raster is desired to be done, enter -1 and -1. Making the program generate the BAT/PS1 so that the calculation is done only in one band (the one defined between the initial and final row) of the raster is practical when you want to parallelize the process to speed it up, starting the BAT/PS1 of each track in a different order session and / or on a different computer. In the end, all you need to do is join all the tiles together with the <a href="Mosaic.htm">Mosaic</a> tool.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:FinRow"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>-1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NFaixa</ows:Identifier>
				<ows:Title>Strip numerator</ows:Title>
				<ows:Abstract>Strip numerator that will be added to the generated BAT/PS1 file name and the output file name resulting from the BAT/PS1 run (it is suggested adding 1, 2, etc. to each run). This parameter is not used when InitRow and FinRow are -1, so it is possible to put any value in it (it is suggested 0, which implies that the final file will not have the numerator "_0" pasted into its name).</ows:Abstract>
				<ows:Metadata xlink:title="Param8"/>
				<ows:Metadata xlink:title="Name:StripNum"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxICT</ows:Identifier>
				<ows:Title>Output file of the Terrestrial Connectivity Index</ows:Title>
				<ows:Abstract>Desired name for the raster file that results from the execution of the BATFile file. The name of this file does not need to indicate the value of StripNum as the program is responsible for setting it automatically.</ows:Abstract>
				<ows:Metadata xlink:title="Param9"/>
				<ows:Metadata xlink:title="Name:ICTFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>UNITS_M2</ows:Identifier>
				<ows:Title>M2Units</ows:Title>
				<ows:Abstract>Indicates that results should be provided in log (m²) instead of log (ha).</ows:Abstract>
				<ows:Metadata xlink:title="Name:UNITS_M2"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CREA_AUX</ows:Identifier>
				<ows:Title>Create auxiliary files</ows:Title>
				<ows:Abstract>Indicates that two additional files will be generated, one with points centered on each focal point and one with polygons delimiting the area analyzed in each focal point, with the same name as ICTFile but adding the suffixes "_Sample" and "_ Zones", respectively.</ows:Abstract>
				<ows:Metadata xlink:title="Name:CREA_AUX"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>