				<ows:Metadata xlink:title="Name:TEXT"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ELIMINA_HIDDEN</ows:Identifier>
				<ows:Title>Elimina entidades HIDDEN</ows:Title>
				<ows:Abstract>No importa las entidades del DXF marcadas con estilo HIDDEN (entidades ocultas o con tipo de línea Hidden de AutoCAD). Solo se aplica a las opciones 1 a 5.</ows:Abstract>
				<ows:Metadata xlink:title="Name:ELIMINA_HIDDEN"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
