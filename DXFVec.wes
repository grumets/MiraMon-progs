<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:DXFVEC:Param1:0&amp;!Param3</ows:Identifier>
		<ows:Title>DXFVEC 0</ows:Title>
		<ows:Abstract>INFORMACIÓN DE CONTENIDOS: Muestra una relación del contenido del fichero DXF. Indica el número de polilíneas, líneas, arcos, círculos, elipses, sólidos, puntos, textos y bloques, desglosado por capas. En el caso de los bloques, para cada capa se detallan los nombres y el número de bloques con este nombre.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importación de ficheros DXF"/>
		<ows:Metadata xlink:title="Abstract:Este programa hace la conversión de ficheros DXF (obtenidos con comando DXFOUT de AutoCAD, exportación de CorelDraw, etc) a ficheros vectoriales, pudiendo ser estos estructurados topológicamente (agrupados en un fichero MMM) o no (formato VEC)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 0</ows:Title>
				<ows:Abstract>Información del contenido del fichero</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitx1</ows:Identifier>
				<ows:Title>Fichero 1</ows:Title>
				<ows:Abstract>Fichero DXF del que se mostrará el contenido.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Fich1"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dxf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dxf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>StdOut</ows:Identifier>
				<ows:Title>Salida estándar</ows:Title>
				<ows:Abstract>Información del contenido del fichero DXF mostrada por pantalla.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:DXFVEC:Param1:0&amp;Param3</ows:Identifier>
		<ows:Title>DXFVEC 0</ows:Title>
		<ows:Abstract>INFORMACIÓN DE CONTENIDOS: Muestra una relación del contenido del fichero DXF. Indica el número de polilíneas, líneas, arcos, círculos, elipses, sólidos, puntos, textos y bloques, desglosado por capas. En el caso de los bloques, para cada capa se detallan los nombres y el número de bloques con este nombre.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 0</ows:Title>
				<ows:Abstract>Información del contenido del fichero</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitx1</ows:Identifier>
				<ows:Title>Fichero 1</ows:Title>
				<ows:Abstract>Fichero DXF del que se mostrará el contenido.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Fich1"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dxf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dxf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxText</ows:Identifier>
				<ows:Title>Fichero Texto</ows:Title>
				<ows:Abstract>Nombre de un fichero de texto que contendrá una copia de la información que sale por pantalla. Sólo se puede indicar en la opción 0.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FichTexto"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:DXFVEC:Param1:1</ows:Identifier>
		<ows:Title>DXFVEC 1</ows:Title>
		<ows:Abstract>LAS LÍNEAS, POLILÍNEAS, ARCOS, CÍRCULOS, ELIPSES Y SÓLIDOS DXF SERÁN TRANSFORMADOS EN LÍNEAS o POLÍGONOS VEC. Si el programa detecta que todas las polilíneas son cerradas, bien en su definición en el fichero DXF, o bien porque detecta que las coordenadas extremas son idénticas, documentará las entidades como de tipo "polygon"; en caso contrario las documentará como de tipo "line". La capa en que se encuentra la entidad pasa a ser el atributo en el fichero VEC. El número de vértices en una polilínea es prácticamente ilimitado. El programa toma el parámetro tolerancia de la línea de comandos para traducir los arcos, círculos y elipses a polilíneas. La tolerancia es el máximo error permitido en la traducción de arcos, círculos y elipses DXF a polilíneas VEC (distancia máxima entre el arco y la cuerda). Las últimas versiones del formato DXF (AutoCAD 2000) permiten definir curvaturas entre los vértices de un objeto polilínea. La tolerancia también se aplica para estos objetos. Si se indica 0 se limita el número de vértices a un vértice por grado. La tolerancia sólo se indica en la opción 1.</ows:Abstract>
		<DataInputs>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 1</ows:Title>
				<ows:Abstract>Líneas, polilíneas, arcos, círculos, elipses y sólidos -> líneas o polígonos, según si están abiertos</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>F_DXF</ows:Identifier>
				<ows:Title>Fichero DXF</ows:Title>
				<ows:Abstract>Nombre del fichero DXF a convertir.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:F_DXF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dxf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dxf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusAtribut</ows:Identifier>
				<ows:Title>Tipo Atributo</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>1 Números enteros ignorando textos y redondeando si es necesario.</li><li>2 Números reales, ignorando textos.</li><li>3 Alfanumérico (textos y números) (no válido en los filtros de entidades de altimetría).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:TipoAtributo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Filtre</ows:Identifier>
				<ows:Title>Filtro</ows:Title>
				<ows:Abstract><![CDATA[Filtro de objetos:<ul><li>1 Objetos de todas las capas.</li><li>2 Objetos de una sola capa.</li><li>3 Objetos de diversas capas a partir de un fichero de equivalencias en columna única.</li><li>4 Un texto en cualquier capa.</li><li>5 Diversos textos en todas las capas a partir de un fichero de equivalencias.</li><li>6 Altimetría: el atributo se deducirá de la Z del primer vértice.</li><li>7 Altimetría a partir de un fichero de equivalencias.</li><li>8 Descripciones de bloques.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Filtro"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>6</ows:Value>
						<ows:Value>7</ows:Value>
						<ows:Value>8</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_Decimals</ows:Identifier>
				<ows:Title>Número de decimales</ows:Title>
				<ows:Abstract>Número de cifras decimales escritas en las coordenadas del fichero de salida. Valores admitidos: 0 a 15; por defecto vale 6.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:N_Decimales"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>6</DefaultValue>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Tolerancia</ows:Identifier>
				<ows:Title>Tolerancia</ows:Title>
				<ows:Abstract>Máximo error tolerado en la traducción de arcos, círculos, elipses y curvaturas entre vértices DXF a polilíneas VEC. Sólo se puede indicar en la opción 1. El valor por defecto es 0.</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:Tolerancia"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>3D</ows:Identifier>
				<ows:Title>3D</ows:Title>
				<ows:Abstract>1 indica que se desea importar la tercera dimensión del fichero DXF. 0 indica que no se desea importar. Si el parámetro no se indica, el programa determina si se trata de un fichero DXF 2D o 3D y escoge el formato VEC correspondiente.</ows:Abstract>
				<ows:Metadata xlink:title="Name:3D"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FITX_EQUIV</ows:Identifier>
				<ows:Title>Fichero Equivalencias</ows:Title>
				<ows:Abstract>Nombre del fichero de equivalencias en los filtros de entidades 3, 5 y 7. Si no se indica se preguntará el nombre del fichero durante la ejecución.</ows:Abstract>
				<ows:Metadata xlink:title="Name:FITX_EQUIV"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAPA</ows:Identifier>
				<ows:Title>Capa</ows:Title>
				<ows:Abstract>Nombre de la capa a importar con el filtro 2. Si no se indica se preguntará el nombre de la capa durante la ejecución.</ows:Abstract>
				<ows:Metadata xlink:title="Name:CAPA"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ATRIBUT</ows:Identifier>
				<ows:Title>Atributo</ows:Title>
				<ows:Abstract>Atributo que sustituye el nombre de la capa a importar con el filtro 2. Si no se indica y se ha indicado /CAPA, se toma el mismo valor; en caso contrario se preguntará durante la ejecución.</ows:Abstract>
				<ows:Metadata xlink:title="Name:ATRIBUT"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TEXT</ows:Identifier>
				<ows:Title>Texto</ows:Title>
				<ows:Abstract>Texto (o nombre de bloque) a importar con el filtro 4. Si no se indica se preguntará durante la ejecución.</ows:Abstract>
				<ows:Metadata xlink:title="Name:TEXT"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ELIMINA_HIDDEN</ows:Identifier>
				<ows:Title>Elimina entidades HIDDEN</ows:Title>
				<ows:Abstract>No importa las entidades del DXF marcadas con estilo HIDDEN (entidades ocultas o con tipo de línea Hidden de AutoCAD). Solo se aplica a las opciones 1 a 5.</ows:Abstract>
				<ows:Metadata xlink:title="Name:ELIMINA_HIDDEN"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
<Output>
				<ows:Identifier>F_VEC</ows:Identifier>
				<ows:Title>Fichero Vectorial</ows:Title>
				<ows:Abstract>Normalmente es el nombre del fichero VEC de salida. Es el directorio de extracción cuando se usa el filtro 8.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:F_VEC"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:DXFVEC:Param1:2</ows:Identifier>
		<ows:Title>DXFVEC 2</ows:Title>
		<ows:Abstract>LOS PUNTOS DXF SERÁN TRANSFORMADOS EN PUNTOS VEC. El nombre de la capa donde se encuentra la entidad pasa a ser el atributo del punto en el fichero VEC.</ows:Abstract>
		<DataInputs>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 2</ows:Title>
				<ows:Abstract>Puntos -> puntos</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>F_DXF</ows:Identifier>
				<ows:Title>Fichero DXF</ows:Title>
				<ows:Abstract>Nombre del fichero DXF a convertir.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:F_DXF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dxf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dxf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusAtribut</ows:Identifier>
				<ows:Title>Tipo Atributo</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>1 Números enteros ignorando textos y redondeando si es necesario.</li><li>2 Números reales, ignorando textos.</li><li>3 Alfanumérico (textos y números) (no válido en los filtros de entidades de altimetría).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:TipoAtributo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Filtre</ows:Identifier>
				<ows:Title>Filtro</ows:Title>
				<ows:Abstract><![CDATA[Filtro de objetos:<ul><li>1 Objetos de todas las capas.</li><li>2 Objetos de una sola capa.</li><li>3 Objetos de diversas capas a partir de un fichero de equivalencias en columna única.</li><li>4 Un texto en cualquier capa.</li><li>5 Diversos textos en todas las capas a partir de un fichero de equivalencias.</li><li>6 Altimetría: el atributo se deducirá de la Z del primer vértice.</li><li>7 Altimetría a partir de un fichero de equivalencias.</li><li>8 Descripciones de bloques.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Filtro"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>6</ows:Value>
						<ows:Value>7</ows:Value>
						<ows:Value>8</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_Decimals</ows:Identifier>
				<ows:Title>Número de decimales</ows:Title>
				<ows:Abstract>Número de cifras decimales escritas en las coordenadas del fichero de salida. Valores admitidos: 0 a 15; por defecto vale 6.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:N_Decimales"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>6</DefaultValue>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>3D</ows:Identifier>
				<ows:Title>3D</ows:Title>
				<ows:Abstract>1 indica que se desea importar la tercera dimensión del fichero DXF. 0 indica que no se desea importar. Si el parámetro no se indica, el programa determina si se trata de un fichero DXF 2D o 3D y escoge el formato VEC correspondiente.</ows:Abstract>
				<ows:Metadata xlink:title="Name:3D"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FITX_EQUIV</ows:Identifier>
				<ows:Title>Fichero Equivalencias</ows:Title>
