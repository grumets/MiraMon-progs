				<ows:Metadata xlink:title="Name:FITX_EQUIV"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAPA</ows:Identifier>
				<ows:Title>Capa</ows:Title>
				<ows:Abstract>Nombre de la capa a importar con el filtro 2. Si no se indica se preguntará el nombre de la capa durante la ejecución.</ows:Abstract>
