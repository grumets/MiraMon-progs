<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:InsolDia:1</ows:Identifier>
		<ows:Title>InsolDia</ows:Title>
		<ows:Abstract>Given a digital elevation model (DEM), this program calculates the incident solar radiation at each point during a particular day of the year. In addition to solar irradiance and atmospheric transmittance, the program takes into account the position of the Sun in user-defined time limits (one hour, for example), the incidence angles, the projected shadows and the distance from the Earth to the Sun..</ows:Abstract>
		<ows:Metadata xlink:title="Title:Program for computing the solar radiation during one day"/>
		<ows:Metadata xlink:title="Abstract:Given a digital elevation model (DEM), this program calculates the incident solar radiation at each point during a particular day of the year. In addition to solar irradiance and atmospheric transmittance, the program takes into account the position of the Sun in user-defined time limits (one hour, for example), the incidence angles, the projected shadows and the distance from the Earth to the Sun."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MDE</ows:Identifier>
				<ows:Title>Digital Elevation Model</ows:Title>
				<ows:Abstract>Digital Elevation Model in IMG raster format</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:DEM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>directori_ombra</ows:Identifier>
				<ows:Metadata xlink:title="Param2"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>dia</ows:Identifier>
				<ows:Title>Day</ows:Title>
				<ows:Abstract>Numerical parameters (day, month, year) that set the day for which the solar radiation calculation is carried out</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:day"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>6</ows:Value>
						<ows:Value>7</ows:Value>
						<ows:Value>8</ows:Value>
						<ows:Value>9</ows:Value>
						<ows:Value>10</ows:Value>
						<ows:Value>11</ows:Value>
						<ows:Value>12</ows:Value>
						<ows:Value>13</ows:Value>
						<ows:Value>14</ows:Value>
						<ows:Value>15</ows:Value>
						<ows:Value>16</ows:Value>
						<ows:Value>17</ows:Value>
						<ows:Value>18</ows:Value>
						<ows:Value>19</ows:Value>
						<ows:Value>20</ows:Value>
						<ows:Value>21</ows:Value>
						<ows:Value>22</ows:Value>
						<ows:Value>23</ows:Value>
						<ows:Value>24</ows:Value>
						<ows:Value>25</ows:Value>
						<ows:Value>26</ows:Value>
						<ows:Value>27</ows:Value>
						<ows:Value>28</ows:Value>
						<ows:Value>29</ows:Value>
						<ows:Value>30</ows:Value>
						<ows:Value>31</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>mes</ows:Identifier>
				<ows:Title>month</ows:Title>
				<ows:Abstract>Numerical parameters (day, month, year) that set the day for which the solar radiation calculation is carried out</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:month"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>6</ows:Value>
						<ows:Value>7</ows:Value>
						<ows:Value>8</ows:Value>
						<ows:Value>9</ows:Value>
						<ows:Value>10</ows:Value>
						<ows:Value>11</ows:Value>
						<ows:Value>12</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>any</ows:Identifier>
				<ows:Title>Year</ows:Title>
				<ows:Abstract>Numerical parameters (day, month, year) that set the day for which the solar radiation calculation is carried out</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:year"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>irradiancia_exoatm</ows:Identifier>
				<ows:Title>irradiancia_exoatm</ows:Title>
				<ows:Abstract>Estimated value of solar irradiance that reaches the outside of the Earth's atmosphere; 1366 is suggested</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:exoatmospheric_irradiance"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>tau</ows:Identifier>
				<ows:Title>Constant of extinction</ows:Title>
				<ows:Abstract>Constant of extinction; 0.288 is suggested</ows:Abstract>
				<ows:Metadata xlink:title="Param8"/>
				<ows:Metadata xlink:title="Name:tau"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>increment_horari</ows:Identifier>
				<ows:Title>Hourly increase</ows:Title>
				<ows:Abstract>Increase in hourly units that is applied to the new solar position from the starting position and successively, to determine a new instantaneous calculation of potential radiation that represents the defined interval on average. It is positive from noon to sunset, or negative from noon to sunrise. By default, 1 is suggested.</ows:Abstract>
				<ows:Metadata xlink:title="Param9"/>
				<ows:Metadata xlink:title="Name:hourly_increase"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>INSTANT</ows:Identifier>
				<ows:Title>Instantaneous Calculation</ows:Title>
				<ows:Abstract>Restricts the calculation, which by default is daily accumulated, to only an instantaneous calculation. The value must be indicated as local solar time.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#time">time</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>INICI</ows:Identifier>
				<ows:Title>Start interval</ows:Title>
				<ows:Abstract>Allow defining a time interval (within the specified day) for the accumulated calculation of solar radiation. Values are reported as local solar time.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#time">time</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FINAL</ows:Identifier>
				<ows:Title>End interval</ows:Title>
				<ows:Abstract>Allow defining a time interval (within the specified day) for the accumulated calculation of solar radiation. Values are reported as local solar time.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#time">time</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>IRRAD_SPECTRAL</ows:Identifier>
				<ows:Title>Spectral irradiance</ows:Title>
				<ows:Abstract>Indicates that the solar irradiance provided is spectral and therefore the units of the output raster will be documented in 10 kJ / (m2·µm). If not specified, the units of the output raster will be documented in 10 kJ/m2.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>fitxer_sortida</ows:Identifier>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>