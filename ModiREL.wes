	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ModiREL:Param1:6</ows:Identifier>
		<ows:Title>6. Lee el valor de una clave, y si no encuentra la clave o está vacía devuelve el valor por defecto</ows:Title>
		<ows:Abstract>Lee el valor de una clave; si ésta está vacía o no es localizada, devuelve el valor por defecto. Muestra en la pantalla el valor leído, a menos que se indique /TXT=, caso el cual se envía a un fichero de texto.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Lee el valor de una clave y, si no encuentra la clave o está vacía, devuelve el valor por defecto. Muestra en la pantalla el valor leído, a menos que se indique /TXT=, caso el cual se envía a un fichero de texto.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>6</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>6</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxINI</ows:Identifier>
				<ows:Title>Fichero INI</ows:Title>
				<ows:Abstract>Fichero INI</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FichINI"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-ini</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-ini</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Seccio</ows:Identifier>
				<ows:Title>Sección</ows:Title>
				<ows:Abstract>Sección</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Seccion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Clau</ows:Identifier>
				<ows:Title>Clave</ows:Title>
				<ows:Abstract>Clave</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Clave"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ValorDefecte</ows:Identifier>
				<ows:Title>Valor predeterminado</ows:Title>
				<ows:Abstract>Valor predeterminado que devuelve si no se encuentra una clave, o está vacía.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:ValorDefecto"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TXT</ows:Identifier>
				<ows:Title>Fichero TXT salida</ows:Title>
				<ows:Abstract>Fichero TXT de salida donde se guardará el resultado de la operación en lugar de mostrarlo por pantalla. Solo se usa por la opción 6.</ows:Abstract>
				<ows:Metadata xlink:title="Name:TXT"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxINI</ows:Identifier>
				<ows:Title>Fichero INI</ows:Title>
				<ows:Abstract>Fichero INI</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
