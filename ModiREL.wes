					<Supported>
						<Format>
							<MimeType>application/x-ini</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerComandes</ows:Identifier>
				<ows:Title>NombreFicheroComandos</ows:Title>
				<ows:Abstract>Fichero que incluye los comandos a ejecutar.</ows:Abstract>
