<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ArcInfMM:Param1</ows:Identifier>
		<ows:Title>MM-ArcInf</ows:Title>
		<ows:Abstract>Miramon a ArcInfo. Permite pasar de una familia de ficheros vectoriales estructurados de MiraMon al formato "export/interchange file" (E00) de Arc/Info.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversión de fitxeros vectoriales entre MiraMon y ArcGIS/ArcInfo (Export/interchange file)"/>
		<ows:Metadata xlink:title="Abstract:Este programa permite pasar de una familia de ficheros vectoriales estructurados de MiraMon al formato export/interchange file (E00) de ArcInfo (actualmente ArcGIS) y viceversa. El formato export también puede ser leído por ArcView."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerTopMM</ows:Identifier>
				<ows:Title>Fichero topológico de origen</ows:Title>
				<ows:Abstract>Es un fichero de puntos, arcos o polígonos (con extensión PNT, ARC o POL).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FichTopMM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Escalat</ows:Identifier>
				<ows:Title>Escalado</ows:Title>
				<ows:Abstract>Factor de escala</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Escalado"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DesplaX</ows:Identifier>
				<ows:Title>Desplazamiento X</ows:Title>
				<ows:Abstract>Factor de desplazamiento X</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:DesplazX"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DesplaY</ows:Identifier>
				<ows:Title>Desplazamiento Y</ows:Title>
				<ows:Abstract>Factor de desplazamiento Y</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:DesplazY"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>a</ows:Identifier>
				<ows:Title>Tipo de precisión (en las coordenadas)</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>1: ArcInfo de doble precisión. Es la opción por defecto.</li><li>2: ArcInfo de precisión simple, como algunas versiones de PC-Arc/Info.</li><li>Note que en las conversiones Arc/Info-MM (E00 como origen), el parámetro 'a' no debe ponerse, porque MiraMon siempre trabaja con coordenadas en doble precisión.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerE00</ows:Identifier>
				<ows:Title>Fichero E00</ows:Title>
				<ows:Abstract>Es un fichero de exportación de Arc/Info (con extensión).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FichE00"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ArcInfMM:!Param1</ows:Identifier>
		<ows:Title>ArcInf-MM</ows:Title>
		<ows:Abstract>ArcInfo a Miramon: Permite pasar de una familia de ficheros  export/"interchange file" (E00) de Arc/Info a vectoriales estructurados de MiraMon.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerE00</ows:Identifier>
				<ows:Title>Fichero E00</ows:Title>
				<ows:Abstract>Es un fichero de exportación de Arc/Info (con extensión).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FichE00"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Escalat</ows:Identifier>
				<ows:Title>Escalado</ows:Title>
				<ows:Abstract>Factor de escala</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Escalado"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DesplaX</ows:Identifier>
				<ows:Title>Desplazamiento X</ows:Title>
				<ows:Abstract>Factor de desplazamiento X</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:DesplazX"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DesplaY</ows:Identifier>
				<ows:Title>Desplazamiento Y</ows:Title>
				<ows:Abstract>Factor de desplazamiento Y</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:DesplazY"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMM</ows:Identifier>
				<ows:Title>Fichero de Salida</ows:Title>
				<ows:Abstract>Es un fichero de puntos, arcos o polígonos o un ráster (PNT, ARC, POL o IMG).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitchMM"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>