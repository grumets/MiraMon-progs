<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:IsoMM:1</ows:Identifier>
		<ows:Title>IsoMM</ows:Title>
		<ows:Abstract><![CDATA[Aquesta aplicació realitza una classificació no supervisada d'una imatge inspirat en el mètode clàssic IsoData de Duda i Hart:Duda, RO, PE Hart (1973) "<b>Pattern Classification and Scene Analysis</b>", John Wiley and Sons, New York, [cap. 6, "<i>Unsupervised Learning and Clustering</i>", pp. 226-227].]]></ows:Abstract>
		<ows:Metadata xlink:title="Title:Classificació no supervisada"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació realitza una classificació no supervisada d&apos;una imatge inspirat en el mètode clàssic IsoData de Duda i Hart:Duda, RO, PE Hart (1973) &quot;&lt;b&gt;Pattern Classification and Scene Analysis&lt;/b&gt;&quot;, John Wiley and Sons, New York, [cap. 6, &quot;&lt;i&gt;Unsupervised Learning and Clustering&lt;/i&gt;&quot;, pp. 226-227]."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NBandes</ows:Identifier>
				<ows:Title>Nombre de bandes</ows:Title>
				<ows:Abstract>Nombre de bandes de la imatge a utilitzar (màxim 250).</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:NumBandes"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Llista</ows:Identifier>
				<ows:Title>Llista</ows:Title>
				<ows:Abstract><![CDATA[Fitxer de text on hi ha els noms de les diferents bandes (amb ruta o <i>path</i> [pot ser relativa] si no estan al mateix directori; amb extensió o s'assumirà .img).]]></ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:Llista"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerClass</ows:Identifier>
				<ows:Title>Fitxer resultat</ows:Title>
				<ows:Abstract>Fitxer resultat de la classificació.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:FitxerClass"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NClusterInicialDiagonal</ows:Identifier>
				<ows:Title>Nombre de centres de clúster inicial a la diagonal</ows:Title>
				<ows:Abstract>Nombre de centres de clúster inicial a la diagonal multivariant que seran utilitzats en la classificació.</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:NClusterInicialDiagonal"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NClusterInicialAleatori</ows:Identifier>
				<ows:Title>Nombre de centres de clúster inicial aleatori</ows:Title>
				<ows:Abstract>Nombre de centres de clúster inicial aleatòriament repartits en l'espai multivariant, que seran utilitzats en la classificació.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:NClusterInicialAleatori"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NClusterInicialMostreig</ows:Identifier>
				<ows:Title>Nombre de centres de clúster inicial mostreig</ows:Title>
				<ows:Abstract>Distància mínima, en unitats terreny, entre les mostres que s'usaran com a centres de clúster inicials (per exemple "D1000.5"), o nombre d'aquestes mostres (p. ex. "N300"). Cal indicar "D0" o "N0" si no es vol fer ús d'aquest criteri..</ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:NClusterInicialMostreig"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>LlindarConvergencia</ows:Identifier>
				<ows:Title>Llindar de convergència</ows:Title>
				<ows:Abstract>Quan el % de píxels que canvien de clúster entre dues iteracions queda per sota d'aquest llindar de convergència, el procés finalitza.</ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:LlindarConvergencia"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MaxIter</ows:Identifier>
				<ows:Title>Màxim iteracions</ows:Title>
				<ows:Abstract>Nombre d'iteracions que realitzarà l'aplicació si no s'assoleix abans el llindar de convergència.</ows:Abstract>
				<ows:Metadata xlink:title="Param08"/>
				<ows:Metadata xlink:title="Name:MaxIter"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MinCluster</ows:Identifier>
				<ows:Title>Mínim clúster</ows:Title>
				<ows:Abstract>Mínim nombre de píxels que han de formar un clúster.</ows:Abstract>
				<ows:Metadata xlink:title="Param09"/>
				<ows:Metadata xlink:title="Name:MinCluster"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MinSimil</ows:Identifier>
				<ows:Title>Mínima similitud</ows:Title>
				<ows:Abstract>Mínima similitud entre classes (per banda, >=0, nombre real). Nota: només està implementat en les classes que provinguin del criteri 3 (NClusterInicialMostreig).</ows:Abstract>
				<ows:Metadata xlink:title="Param10"/>
				<ows:Metadata xlink:title="Name:MinSimil"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>Sensedades</ows:Title>
				<ows:Abstract><![CDATA[Valor de fons a ignorar:<ul><li>0 en general (usa sensedades, si està definit).</li><li>1 si existeix un valor de fons 0, però no està correctament documentat com a sensedades.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param11"/>
				<ows:Metadata xlink:title="Name:NODATA"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NDesvStd</ows:Identifier>
				<ows:Title>Nombre desviacions estàndard</ows:Title>
				<ows:Abstract>Nombre de desviacions estàndard que se sumaran i restaran al valor mitjà per a calcular on es disposaran els centres de classe inicials en la diagonal multivariant; si es proporciona un  valor zero s'agafarà el rang de valors de tota la imatge.</ows:Abstract>
				<ows:Metadata xlink:title="Param12"/>
				<ows:Metadata xlink:title="Name:NDesvStd"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TDist</ows:Identifier>
				<ows:Title>Tipus de distància</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>1 (Euclidiana)</li><li>2 (Eixample)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param13"/>
				<ows:Metadata xlink:title="Name:TDist"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MaxBandesNODATA</ows:Identifier>
				<ows:Title>Màxim nombre de bandes sensedades</ows:Title>
				<ows:Abstract>Màxim nombre de bandes amb sensedades: 0,1,2,... MAX.</ows:Abstract>
				<ows:Metadata xlink:title="Param14"/>
				<ows:Metadata xlink:title="Name:MaxBandesNODATA"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FITXER_SIGNATURES</ows:Identifier>
				<ows:Title>Fitxer signatures espectrals</ows:Title>
				<ows:Abstract>Fitxer llista de signatures espectrals com a criteri opcional d'ubicació de categories inicials.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_PROCES</ows:Identifier>
				<ows:Title>Nombre de nuclis de processador a utilitzar</ows:Title>
				<ows:Abstract>Es pot indicar un nombre  concret de processadors o "MAX" (per utilitzar tots els processadors) o "SUB_MAX" (per utilitzar tots els processadors menys un).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DISC</ows:Identifier>
				<ows:Title>Forçar a no carregar les imatges a classificar en memòria</ows:Title>
				<ows:Abstract>Útil per a ordinadors amb molt poca memòria en relació a la grandària dels fitxers a classificar. En general no cal aplicar-lo ja que si l'aplicació es queda sense memòria commuta automàticament a aquest mode.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Resultat</ows:Identifier>
				<ows:Title>Resultat</ows:Title>
				<ows:Abstract>Nom de la imatge de sortida (sense extensió).</ows:Abstract>
				<ows:Metadata xlink:title="Param15"/>
				<ows:Metadata xlink:title="Name:Resultat"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>