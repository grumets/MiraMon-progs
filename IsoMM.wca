<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:IsoMM:1</ows:Identifier>
		<ows:Title>IsoMM</ows:Title>
		<ows:Abstract>Aquest mòdul realitza una classificació no supervisada d'una imatge inspirat en el mètode clàssic IsoData de Duda i Hart: Duda, RO, PE Hart (1973) "Pattern Classification and Scene Analysis" John Wiley and Sons, New York, [cap. 6, "Unsupervised Learning and Clustering", pp. 226-227].</ows:Abstract>
		<ows:Metadata xlink:title="Title:Classificació no supervisada d'imatges"/>
		<ows:Metadata xlink:title="Abstract:Aquest mòdul realitza una classificació no supervisada d'una imatge inspirat en el mètode clàssic IsoData de Duda i Hart:Duda, RO, PE Hart (1973) Pattern Classification and Scene Analysis, John Wiley and Sons, New York, [cap. 6, Unsupervised Learning and Clustering, pp. 226-227]"/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NBandes</ows:Identifier>
				<ows:Title>Nombre Bandes</ows:Title>
				<ows:Abstract>Nombre de bandes de la imatge a utilitzar (màxim 250).</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:NumBandes"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Llista</ows:Identifier>
				<ows:Title>Llista</ows:Title>
				<ows:Abstract>Fitxer de text on hi ha el noms de les diferents bandes (amb path si no som al mateix directori; amb extensió o s'assumirà IMG).</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:Llista"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NClusterInicialDiagonal</ows:Identifier>
				<ows:Title>Nombre Cluster Inicial Diagonal</ows:Title>
				<ows:Abstract>Nombre de centres de cluster inicial a la diagonal multivariant que utilitzarem en la classificació.</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:NClusterInicialDiagonal"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NClusterInicialAleatori</ows:Identifier>
				<ows:Title>NClusterInicialAleatori</ows:Title>
				<ows:Abstract>Nombre de centres de cluster inicial aleatòriament repartits en l'espai multivariant, que utilitzarem en la classificació.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:NClusterInicialAleatori"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NClusterInicialMostreig</ows:Identifier>
				<ows:Title>NClusterInicialMostreig</ows:Title>
				<ows:Abstract> Distància mínima, en unitats terreny, entre les mostres que s'usaran com a centres de cluster inicials (per exemple "D1000.5"), o nombre d'aquestes mostres (p. ex. "N300"). Indiqueu "D0" o "N0" si no en voleu.</ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:NClusterInicialMostreig"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>LlindarConvergencia</ows:Identifier>
				<ows:Title>Llindar Convergencia</ows:Title>
				<ows:Abstract> Quan el % de píxels que canvien de cluster entre dues iteracions queda per sota d'aquest llindar de convergència el procés finalitzar.</ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:LlindarConvergencia"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MaxIter</ows:Identifier>
				<ows:Title>Màxim Iteracions</ows:Title>
				<ows:Abstract>Màxim nombre d'iteracions. Nombre d'iteracions que realitzarà el programa si no s'assoleix abans el llindar de convergència.</ows:Abstract>
				<ows:Metadata xlink:title="Param08"/>
				<ows:Metadata xlink:title="Name:MaxIter"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MinCluster</ows:Identifier>
				<ows:Title>Minim Cluster</ows:Title>
				<ows:Abstract>Mínim nombre de píxels que han de formar un cluster.</ows:Abstract>
				<ows:Metadata xlink:title="Param09"/>
				<ows:Metadata xlink:title="Name:MinCluster"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MinSimil</ows:Identifier>
				<ows:Title>Minima similitud</ows:Title>
				<ows:Abstract>Mínima similitud entre classes (per banda, >=0, nombre real). Noteu que només està implementat en les classes que provinguin del criteri 3 (NClusterInicialMostreig)</ows:Abstract>
				<ows:Metadata xlink:title="Param10"/>
				<ows:Metadata xlink:title="Name:MinSimil"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>NO DATA</ows:Title>
				<ows:Abstract>Valor de fons a ignorar:<![CDATA[<ul><li>0 en general (usa sensedades, si n'hi ha).</li><li>1 si existeix un fons 0 però no està correctament documentat com a sensedades.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param11"/>
				<ows:Metadata xlink:title="Name:NODATA"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NDesvStd</ows:Identifier>
				<ows:Title>Nombre Desviacions Standard</ows:Title>
				<ows:Abstract>Nombre de desviacions estàndard que se sumaran i restaran al valor mitjà per a calcular on es disposaran els centres de classe inicials en la diagonal multivariant; si es dóna valor zero s'agafarà el rang de valors de tota la imatge.</ows:Abstract>
				<ows:Metadata xlink:title="Param12"/>
				<ows:Metadata xlink:title="Name:NDesvStd"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TDist</ows:Identifier>
				<ows:Title>Tpus de distància</ows:Title>
				<ows:Abstract>Tipus de distància:<![CDATA[<ul><li>1 (Euclidiana)</li><li>2 (Eixample)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param13"/>
				<ows:Metadata xlink:title="Name:TDist"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MaxBandesNODATA</ows:Identifier>
				<ows:Title>MaxBandes sensedades</ows:Title>
				<ows:Abstract>0,1,2,... MAX</ows:Abstract>
				<ows:Metadata xlink:title="Param14"/>
				<ows:Metadata xlink:title="Name:MaxBandesNODATA"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FITXER_SIGNATURES</ows:Identifier>
				<ows:Title>Fitxer signatures espectrals</ows:Title>
				<ows:Abstract>Fitxer llista de signatures espectrals com a criteri opcional d'ubicació de categories inicials.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Resultat</ows:Identifier>
				<ows:Title>Resultat</ows:Title>
				<ows:Abstract>Nom de la imatge de sortida (sense extensió).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Resultat"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
