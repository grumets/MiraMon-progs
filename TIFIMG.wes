	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TIFIMG:param1:9</ows:Identifier>
		<ows:Title>TIFF a IMG multibanda Landsat</ows:Title>
		<ows:Abstract>Esta opción transforma  ficheros TIFF multibanda Landsat a un  fichero IMG por banda.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Transformación a IMG multibanda Landsat</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcion"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>9</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerLLista</ows:Identifier>
				<ows:Title>Fichero lista</ows:Title>
				<ows:Abstract>Es el nombre del fichero lista de capas TIFF.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroLista"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Processament</ows:Identifier>
				<ows:Title>Procesamiento</ows:Title>
				<ows:Abstract><![CDATA[ <ul><li>0 LPGS</li><li>1NLAPS</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Procesamiento"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Radiometria</ows:Identifier>
				<ows:Title>Radiometria</ows:Title>
				<ows:Abstract><![CDATA[ <ul><li>0 Metadatos.</li><li>1 Chander.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Radiometria"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>META</ows:Identifier>
				<ows:Title>Fichero META</ows:Title>
				<ows:Abstract>Permite indicar el fichero de metadatos auxiliar (* .META) para imágenes Landsat (TM, ETM + y MSS) (* .TIF) para imágenes procesadas por LPGS. Este fichero permitirá documentar la hora de captación de la imagen que está en algunos ficheros de metadatos (* .TXT). este fichero sólo se deberá incluir de manera conjunta con el fichero de metadatos para Landsat.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MD</ows:Identifier>
				<ows:Title>Fichero metadatos</ows:Title>
				<ows:Abstract><![CDATA[Permite indicar el fichero de metadatos (* .TXT) para imágenes Landsat (TM, ETM + y MSS) (* .TIF) tanto para imágenes procesadas por NLAPS o por LPGS. Este fichero permitirá documentar el REL asociado a la imagen. Es importante no cambiar el nombre a estos archivos, que deben tener la terminación WO y MTL según el procesado sea NLAPS o LPGS <span class="short_text" id="result_box" lang="es" xml:lang="ca"><span style="" title="">respectivamente</span>.]]></ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>IDIOMATIC</ows:Identifier>
				<ows:Title>Generar nombres de ficheros en el idioma de MiraMon</ows:Title>
				<ows:Abstract>En el caso de la importación multibanda de los satélites Landsat los nombres de los archivos de salida se pueden generar en el idioma de MiraMon así como los descriptores de los campos.</ows:Abstract>
				<ows:Metadata xlink:title="Name:IDIOMATIC"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>DirectoriResultats</ows:Identifier>
				<ows:Title>Directorio resultados</ows:Title>
				<ows:Abstract>Es el directorio donde se guardarán los ficheros resultados.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:DirectorioResultados"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>