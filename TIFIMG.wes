	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TIFIMG:Param6&amp;Param1:4</ows:Identifier>
		<ows:Title>TIFF a IMG Multibanda</ows:Title>
		<ows:Abstract>Esta opción transforma ficheros TIFF multibanda a un fichero IMG por banda.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Transformación a IMG Multibanda</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerTIFFOri</ows:Identifier>
				<ows:Title>Fichero TIFF entrada</ows:Title>
				<ows:Abstract>Es el nombre del fichero TIFF del cual se quiere obtener la información de cabecera o transformarlo a IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroTIFFOri"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>PREFIJO</ows:Title>
				<ows:Abstract>Es el prefijo del fichero resultado.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>BANDES</ows:Identifier>
				<ows:Title>BANDAS</ows:Title>
				<ows:Abstract>En caso que no se desee convertir todas las bandas, se ha de indicar los índices de las bandas (enteros) que se quieren convertir, separados por comes.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TFW</ows:Identifier>
				<ows:Title>Directorio TFW</ows:Title>
				<ows:Abstract><![CDATA[Permite indicar el directorio donde buscar el <i>fichero World</i> (*.Tfw o *.TIFW) a aplicar para georreferenciar en las importaciones de TIFF a IMG. Si no se indica, se busca el <i>fichero World</i> en el directorio del TIFF.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DOC</ows:Identifier>
				<ows:Title>Fichero patrón para documentar</ows:Title>
				<ows:Abstract><![CDATA[Permite indicar un fichero ráster de referencia de lo que hereda la documentación. No se hereda nunca el número de filas ni de columnas ni el rango de valores. En caso de presencia de <i>fichero World</i> o formato GeoTiff sus valores prevalecen sobre los de este archivo.]]></ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>DirectoriResultats</ows:Identifier>
				<ows:Title>Directorio resultados</ows:Title>
				<ows:Abstract>Es el directorio donde se guardarán los ficheros resultados.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:DirectorioResultados"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
