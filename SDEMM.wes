	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SDEMM:Param1:1</ows:Identifier>
		<ows:Title>Importació </ows:Title>
		<ows:Abstract>La opción 3 del programa no realiza ninguna importación más bien genera un REL de capa.Este REL puede ser modificado para que el usuari pueda introducir descripciones de los campos o cualquier otro metadato referente a la capa ArcSDE.</ows:Abstract>
		<DataInputs>
		<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcion</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>3. Genera REL</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
			<LiteralData>
				<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:Value>3</ows:Value>
				</ows:AllowedValues>
			</LiteralData>				
		</Input>
		<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>servidor</ows:Identifier>
				<ows:Title>Servidor</ows:Title>
				<ows:Abstract>Es el nombre del servidor donde está almacenada la capa a importar. Por ejemplo 158.109.57.114.</ows:Abstract>
				<ows:Metadata xlink:title="Param2" />
		<LiteralData>
				<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
				<ows:AnyValue/>
				</ows:AllowedValues>
			</LiteralData>					
		</Input>
		<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>instancia</ows:Identifier>
				<ows:Title>Instancia</ows:Title>
				<ows:Abstract>Es la instancia donde está la capa a importar. Por ejemplo 5153.</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
			<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
				<ows:AnyValue/>
			</LiteralData>			
		</Input>
		<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Base De Datos</ows:Identifier>
				<ows:Title>BaseDeDatos</ows:Title>
				<ows:Abstract>Es el nombre de la base de datos del servidor donde está almacenada la capa a importar. Por ejemplo SDE_RefDatabase. Un asterisco ('*') indica que se obtendrá información de todas las bases de datos. Es la opción por defecto en gestores Oracle.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
			<ComplexData>
				<Default>
					<Format>
								<MimeType>application/x-SDE</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
				</Default>
				<Supported>
					<Format>
								<MimeType>application/x-SDE</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
				</Supported>
			</ComplexData>	
		</Input>
		<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>usuario</ows:Identifier>
				<ows:Title>Usuario</ows:Title>
				<ows:Abstract>Es el nombre del usuario en el servidor e instancia actuales.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
			<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
				<ows:AnyValue/>
			</LiteralData>			
		</Input>
		<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>contraseña</ows:Identifier>
				<ows:Title>Contraseña</ows:Title>
				<ows:Abstract>Es la contraseña del usuario 'usuario' en el servidor e instancia actuales. Un asterisco '*' indica que sólo se pide la contraseña una vez.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
			<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
				<ows:AnyValue/>
			</LiteralData>			
		</Input>
		<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>capaSDE</ows:Identifier>
				<ows:Title>capa SDE</ows:Title>
				<ows:Abstract>Es el nombre de la capa a importar de la base de datos ArcSDE.</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
			<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
				<ows:AnyValue/>
			</LiteralData>	
		</Input>
		<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ID_ENTITAT</ows:Identifier>
				<ows:Title>ID Entitat</ows:Title>
				<ows:Abstract>Indica el nom del camp de la capaSDE que farà d'identificador d'entitat. Si indiqueu aquest paràmetre, la taula principal contindrà dos camps i la secundària contindrà tants camps com la capaSDE (excepte el camp que conté la informació espacial (Shape).</ows:Abstract>
			<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
				<ows:AnyValue/>
			</LiteralData>	
		</Input>
		</DataInputs>
			<ProcessOutputs>	
	      	<Output>
				<ows:Identifier> RelDeCapa</ows:Identifier>
				<ows:Title> RelDeCapa</ows:Title>
				<ows:Abstract>Es el nombre del REL de capa que se genera y que vincula con la capaSDE.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param8" />
				<ComplexOutput>
					<Default>
						<Format>
						<MimeType>application/x-rel</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Default>
					<Supported>
						<Format>
						<MimeType>application/x-rel</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs> 
	</ProcessDescription>
</wps:ProcessDescriptions>
