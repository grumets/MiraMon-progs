			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>YMIN</ows:Identifier>
				<ows:Title>Y mínimo</ows:Title>
				<ows:Abstract>Coordenada Y mínima del envolvente (/YMIN=).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>YMAX</ows:Identifier>
				<ows:Title>Y máximo</ows:Title>
				<ows:Abstract>Coordenada Y máxima del envolvente (/YMAX=).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>CapaRaster</ows:Identifier>
				<ows:Title>Capa ráster</ows:Title>
				<ows:Abstract>(sin extensión) es el fichero de salida ráster MiraMon (IMG). Si se pone asterisco '*' el fichero se generará en el temporal y se eliminará cuando ya no se necesite.</ows:Abstract>
				<ows:Metadata xlink:title="Param9"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SDEMM:6</ows:Identifier>
		<ows:Title>Opción 5</ows:Title>
		<ows:Abstract>Generación de un REL de capa de un ráster ArcSDE.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 5</ows:Title>
				<ows:Abstract>Generación de un REL de capa de un ráster ArcSDE.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>5</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>5</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Servidor</ows:Identifier>
				<ows:Title>Servidor</ows:Title>
				<ows:Abstract>Es el nombre del servidor donde está almacenada la capa a importar. Por ejemplo 158.109.57.114.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Servidor"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Instancia</ows:Identifier>
				<ows:Title>Instancia</ows:Title>
				<ows:Abstract>Es la instancia donde está la capa a importar. Por ejemplo 5153.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Instancia"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BaseDeDades</ows:Identifier>
				<ows:Title>Base De Datos</ows:Title>
				<ows:Abstract>Es el nombre de la base de datos del servidor donde está almacenada la capa a importar. Por ejemplo SDE_RefDatabase. Un asterisco ('*') indica que se obtendrá información de todas las bases de datos. Es la opción por defecto en gestores Oracle.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:BaseDeDatos"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Usuari</ows:Identifier>
				<ows:Title>Usuari</ows:Title>
				<ows:Abstract>Usuario es el nombre del usuario en el servidor e instancia actuales.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Usuario"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Contrasenya</ows:Identifier>
				<ows:Title>Contraseña</ows:Title>
				<ows:Abstract>Es la contraseña del usuario 'usuario' en el servidor e instancia actuales. Un asterisco '*' indica que sólo se pide la contraseña una vez.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:Contrasenya"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CapaSDE</ows:Identifier>
				<ows:Title>capa SDE</ows:Title>
				<ows:Abstract>Es el nombre de la capa a importar de la base de datos ArcSDE.</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:CapaSDE"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RasterId</ows:Identifier>
				<ows:Title>ID ráster</ows:Title>
				<ows:Abstract>Identificador numérico del ráster dentro de la capa ArcSDE.</ows:Abstract>
				<ows:Metadata xlink:title="Param9"/>
				<ows:Metadata xlink:title="Name:RasterId"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ID_ENTITAT</ows:Identifier>
				<ows:Title>ID Entidat</ows:Title>
				<ows:Abstract>Indica el nombre del campo de la capaSDE que hará de identificador de entidad. Si se indica este parámetro, la tabla principal contendrá dos camps y la secundaria contendrá tantos campos como la capaSDE (excepto el campo que contiene la información espacial (Shape).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CLAU_COD</ows:Identifier>
				<ows:Title>Clave codificada</ows:Title>
				<ows:Abstract>CLAU_COD indica que la contraseña está codificada.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>RelDeCapa</ows:Identifier>
				<ows:Title>RelDeCapa</ows:Title>
				<ows:Abstract>Es el nombre del REL de capa que se genera y que vincula con la capaSDE.</ows:Abstract>
				<ows:Metadata xlink:title="Param8"/>
				<ows:Metadata xlink:title="Name:RelDeCapa"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>