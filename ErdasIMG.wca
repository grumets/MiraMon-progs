<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ErdasIMG:Param1:0</ows:Identifier>
		<ows:Title>Informació de capçalera</ows:Title>
		<ows:Abstract>Presenta de manera ordenada la informació de capçalera del fitxer Erdas.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversió entre fitxers LAN o GIS (Erdas) i IMG"/>
		<ows:Metadata xlink:title="Abstract:El programa permet prendre diversos fitxers IMG i posar-los en un sol fitxer Erdas de tipus LAN o GIS o bé extreure, en forma de fitxers IMG, totes les bandes contingudes en un fitxer LAN. Els fitxers GIS només contenen una banda i solen ser fitxers de tipus temàtic, no imatges radiomètriques."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 0</ows:Title>
				<ows:Abstract>Informació de la capçalera del fitxer Erdas.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitxer_Erdas.LAN</ows:Identifier>
				<ows:Title>Fitxer Erdas</ows:Title>
				<ows:Abstract>És nom del fitxer en format Erdas (AMB extensió LAN o GIS).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Fitxer_Erdas"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-gis</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>StdOut</ows:Identifier>
				<ows:Title>Estandard de sortida</ows:Title>
				<ows:Abstract>Informació del fitxer Erdas.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ErdasIMG:Param1:1&amp;!Param4</ows:Identifier>
		<ows:Title>Conversió Erdas -> IMG</ows:Title>
		<ows:Abstract>Conversió de fitxers Erdas de tipus LAN o GIS a fitxers IMG. Per als fitxers LAN, el nombre de fitxers IMG dependrà del nombre de bandes que contingui el fitxer ERDAS. Executeu aquesta aplicació amb l’opció 0 per obtenir aquesta informació. Per als fitxers GIS, si no es troba cap fitxer TRL, no s’escriurà cap paleta (el nom `Fitxer_P25` s’ignora).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 1</ows:Title>
				<ows:Abstract>Conversió Erdas -> IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitxer_Erdas.LAN</ows:Identifier>
				<ows:Title>Fitxer Erdas</ows:Title>
				<ows:Abstract>És nom del fitxer en format Erdas (AMB extensió LAN o GIS).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Fitxer_Erdas"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-gis</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Fitxer_IMG_#</ows:Identifier>
				<ows:Title>Fitxer IMG</ows:Title>
				<ows:Abstract>Són els noms de fitxers ràster IMG. Calen tants Fitxer_IMG com bandes té l'origen LAN.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Fitxer_IMG_#"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ErdasIMG:Param1:1&amp;Param4</ows:Identifier>
		<ows:Title>Conversió Erdas -> IMG (amb paleta P25)</ows:Title>
		<ows:Abstract>Conversió de fitxers Erdas GIS a IMG, amb fitxer P25 de sortida explícit.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 1</ows:Title>
				<ows:Abstract>Conversió Erdas -> IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitxer_Erdas.LAN</ows:Identifier>
				<ows:Title>Fitxer Erdas</ows:Title>
				<ows:Abstract>És nom del fitxer en format Erdas (AMB extensió LAN o GIS).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Fitxer_Erdas"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-gis</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Fitxer_IMG</ows:Identifier>
				<ows:Title>Fitxer IMG</ows:Title>
				<ows:Abstract>Es el nom del fitxer ràster IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Fitxer_IMG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>Fitxer_P25</ows:Identifier>
				<ows:Title>Fitxer P25</ows:Title>
				<ows:Abstract>És el nom de la paleta de colors en format P25. Per defecte és el nom del Fitxer_IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Fitxer_P25"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-p25</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-p25</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ErdasIMG:Param1:2&amp;!Param4</ows:Identifier>
		<ows:Title>Conversió IMG -> Erdas</ows:Title>
		<ows:Abstract>Conversió de fitxers IMG a un fitxer Erdas de tipus LAN o GIS.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 2</ows:Title>
				<ows:Abstract>Conversió IMG -> Erdas.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1000">
				<ows:Identifier>Fitxer_IMG_#</ows:Identifier>
				<ows:Title>Fitxer IMG</ows:Title>
				<ows:Abstract>Són els noms de fitxers ràster IMG. Calen tants Fitxer_IMG com bandes té l'origen LAN.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Fitxer_IMG_#"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Fitxer_Erdas.LAN</ows:Identifier>
				<ows:Title>Fitxer Erdas</ows:Title>
				<ows:Abstract>És nom del fitxer en format Erdas (AMB extensió LAN o GIS).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Fitxer_Erdas"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-gis</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ErdasIMG:Param1:2&amp;Param4</ows:Identifier>
		<ows:Title>Conversió IMG -> Erdas (amb paleta P25)</ows:Title>
		<ows:Abstract>Conversió de fitxers IMG a fitxer Erdas GIS, amb fitxer P25 d'entrada explícit.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 2</ows:Title>
				<ows:Abstract>Conversió IMG -> Erdas.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitxer_IMG</ows:Identifier>
				<ows:Title>Fitxer IMG</ows:Title>
				<ows:Abstract>Es el nom del fitxer ràster IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Fitxer_IMG"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitxer_P25</ows:Identifier>
				<ows:Title>Fitxer P25</ows:Title>
				<ows:Abstract>És el nom de la paleta de colors en format P25. Per defecte és el nom del Fitxer_IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Fitxer_P25"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-p25</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-p25</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Fitxer_Erdas.LAN</ows:Identifier>
				<ows:Title>Fitxer Erdas</ows:Title>
				<ows:Abstract>És nom del fitxer en format Erdas (AMB extensió LAN o GIS).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Fitxer_Erdas"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-gis</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>