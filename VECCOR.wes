<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:veccor:Param1:1</ows:Identifier>
		<ows:Title>VECCOR 2D</ows:Title>
		<ows:Abstract>Esta opción hace la transformación de ficheros VEC de puntos al formato COR, sin incorporar las alturas.</ows:Abstract>
<ows:Metadata xlink:title="Title:Transformación de ficheros VEC de puntos a COR usados por CorrGeom" />
<ows:Metadata xlink:title="Abstract:Este programa hace la transformación de ficheros VEC de puntos a formato de trabajo del programa CORRGEOM." />
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Modo</ows:Identifier>
				<ows:Title>Modo</ows:Title>
				<ows:Abstract>1. Paso de formato VEC a formato COR</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NombreFicheroVEC</ows:Identifier>
				<ows:Title>Nombre Fichero VEC</ows:Title>
				<ows:Abstract>Fichero origen que contiene los puntos de control en formato VEC.</ows:Abstract>
						<ows:Metadata xlink:title="Param2" />
					<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>	
			</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NombreFicheroCOR</ows:Identifier>
				<ows:Title>Nombre Fichero COR</ows:Title>
				<ows:Abstract>Fichero destino que contiene los puntos de control en formato COR.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
						<ComplexOutput>
							<Default>
						<Format>
							<MimeType>application/x-COR</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-COR</MimeType>
							<Encoding>Text</Encoding>
						</Format>
							</Supported>
						</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:veccor:Param1:2</ows:Identifier>
		<ows:Title>VECCOR 3D</ows:Title>
		<ows:Abstract>Esta opción hace la transformación de ficheros VEC de puntos al formato COR incorporando las alturas que seran extraidas del modelo digital de elevaciones (MDE).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Modo</ows:Identifier>
				<ows:Title>Modo</ows:Title>
				<ows:Abstract>2. Paso de formato VEC a formato COR con alturas que serán extraídas del modelo digital de elevaciones (MDE).</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NombreFicheroVEC</ows:Identifier>
				<ows:Title>Nombre Fichero VEC</ows:Title>
				<ows:Abstract>Fichero origen que contiene los puntos de control en formato VEC.</ows:Abstract>
						<ows:Metadata xlink:title="Param2" />
					<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NombreFicheroMDE</ows:Identifier>
				<ows:Title>NombreFicheroMDE</ows:Title>
				<ows:Abstract>Fichero IMG que contiene el Modelo Digital de Elevaciones de la zona de interés (solo opción 2).</ows:Abstract>
						<ows:Metadata xlink:title="Param4" />
					<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-IMG</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>
	<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ModeInterpol</ows:Identifier>
				<ows:Title>Mode Interpolación</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>0: Vecino más próximo</li><li>11: Interpolación bilineal</li><li>2: Interpolación bicúbica.</li></ul>]]> 
</ows:Abstract>
				<ows:Metadata xlink:title="Param5" />
				<LiteralData>
					<ows:AllowedValues>                                                                                            
					<ows:Value>0</ows:Value>
					<ows:Value>1</ows:Value>
					<ows:Value>2</ows:Value>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					</ows:AllowedValues>
				</LiteralData>
			</Input>				
	<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>UNITATSXY</ows:Identifier>
				<ows:Title>Unitats XY</ows:Title>
				<ows:Abstract>Unitadades del atributo del fichero VEC, que corresponde a las coordenadas en el sistema de referencia horizontal destino, típicamente m (solo opción 2).
</ows:Abstract>
				<LiteralData>
					<ows:AllowedValues>
					<ows:Value>mm</ows:Value>
					<ows:Value>dm</ows:Value>
					<ows:Value>cm</ows:Value>
					<ows:Value>m</ows:Value>
					<ows:Value>km</ows:Value>
					<ows:Value>graus</ows:Value>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					</ows:AllowedValues>
				</LiteralData>
			</Input>				
			</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Nombre Fichero COR</ows:Identifier>
				<ows:Title>NomFitxerCOR</ows:Title>
				<ows:Abstract>Fichero destino que contiene los puntos de control en formato COR.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
						<ComplexOutput>
							<Default>
						<Format>
							<MimeType>application/x-COR</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-COR</MimeType>
							<Encoding>Text</Encoding>
						</Format>
							</Supported>
						</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
