<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:vecDXF:Param1:1</ows:Identifier>
		<ows:Title>VecDXF</ows:Title>
		<ows:Abstract>This option transforms points and nodes to points, lines and arcs to open polylines, polygons to polylines closed.</ows:Abstract>
<ows:Metadata xlink:title="Title:VEC to DXF file conversion" />
<ows:Metadata xlink:title="Abstract:This program performs the conversion from vector ASCII files containing points, lines or polygons (VEC format) to a DXF AutoCAD format (see the DXFIN command in the AutoCAD manual), also importable by other programs, such as CorelDraw or MS-Word. Also it exports the 3rt dimension when it is present in the input formats." />
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Option</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>1. Direct transformation:<![CDATA[<li>points -> points.</li><li>lines and arcs -> open polylines.</li><li>polygons ->closed polylines.</li>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>VECFileName</ows:Identifier>
				<ows:Title>VEC File Name</ows:Title>
				<ows:Abstract>VEC File Name (PNT,ARC,NOD,POL,VEC) to convert.</ows:Abstract>
						<ows:Metadata xlink:title="Param2" />
					<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-PNT</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-ARC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-NOD</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-POL</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ESCALAT</ows:Identifier>
				<ows:Title>ESCALAT</ows:Title>
				<ows:Abstract>Scaling factor to the X, Y coordinates. Defaults to 1.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_X</ows:Identifier>
				<ows:Title>Displacement X</ows:Title>
				<ows:Abstract>Displacement is applied to the coordinates X.  Defaults value equal to 0.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimals">decimal</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_Y</ows:Identifier>
				<ows:Title>Displacement Y</ows:Title>
				<ows:Abstract>Displacement is applied to the coordinates Y.  Defaults value equal to 0.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_DECIMALS</ows:Identifier>
				<ows:Title>N_Decimal</ows:Title>
				<ows:Abstract>Is the number of decimal figures written in the coordinates of the output file; its default value is 6.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>6</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>UNICAPA</ows:Identifier>
				<ows:Title>Unicapa</ows:Title>
				<ows:Abstract>DXF layer name if you want all the elements in the same layer. If not specified, the attribute of each element is its coat.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TAULA</ows:Identifier>
				<ows:Title>Table</ows:Title>
				<ows:Abstract>Set database field to be exported as a layer or text in a DXF format. To learn more about the values of these parameters follow the consiterations in general syntax.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP</ows:Identifier>
				<ows:Title>Field</ows:Title>
				<ows:Abstract>Set database field to be exported as a layer or text in a DXF format. To learn more about the values of these parameters follow the consiterations in general syntax.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REPE</ows:Identifier>
				<ows:Title>Repe</ows:Title>
				<ows:Abstract>Indicates which record is used when there are more than one record for a graphic identifier (multiple record). For more information on the values of this parameter refer to the document general syntax.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALCADA</ows:Identifier>
				<ows:Title>Heights</ows:Title>
				<ows:Abstract>Sets which of the possible heights are used in the DXF. To learn more about the values of this parameter follow the consiterations in general syntax.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>DXFFileName</ows:Identifier>
				<ows:Title>DXF File Name</ows:Title>
				<ows:Abstract>Is the name of the DXF output file.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
						<ComplexOutput>
							<Default>
						<Format>
							<MimeType>application/x-DXF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DXF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
							</Supported>
						</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:vecDXF:Param1:2</ows:Identifier>
		<ows:Title>VecDXF text</ows:Title>
		<ows:Abstract>Aquesta opció fa la transformació directa de punts i nodes a punts, línies i arcs a polilínies obertes, polígons a polilínies tancades.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Option</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>2. Transforma punts -> textos.</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerVEC</ows:Identifier>
				<ows:Title>NomFitxerVEC</ows:Title>
				<ows:Abstract>És el nom del fitxer vectorial (PNT,ARC,NOD,POL,VEC) a convertir.</ows:Abstract>
						<ows:Metadata xlink:title="Param2" />
					<ComplexData>
						<Default>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-VEC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-PNT</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-ARC</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-NOD</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
							<Format>
								<MimeType>application/x-POL</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Supported>
					</ComplexData>
			</Input>	
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>AlçadaText</ows:Identifier>
				<ows:Title>Alçada Text</ows:Title>
				<ows:Abstract>És la mida del text DXF en unitats mapa</ows:Abstract>
							<ows:Metadata xlink:title="Param4" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ESCALAT</ows:Identifier>
				<ows:Title>ESCALAT</ows:Title>
				<ows:Abstract>Scaling factor to the X, Y coordinates. Defaults to 1.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_X</ows:Identifier>
				<ows:Title>Displacement X</ows:Title>
				<ows:Abstract>Displacement is applied to the coordinates X.  Defaults value equal to 0.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimals">decimal</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESPLAC_Y</ows:Identifier>
				<ows:Title>Displacement Y</ows:Title>
				<ows:Abstract>Displacement is applied to the coordinates Y.  Defaults value equal to 0.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_DECIMALS</ows:Identifier>
				<ows:Title>N_Decimal</ows:Title>
				<ows:Abstract>Is the number of decimal figures written in the coordinates of the output file; its default value is 6.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>6</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>UNICAPA</ows:Identifier>
				<ows:Title>Unicapa</ows:Title>
				<ows:Abstract>DXF layer name if you want all the elements in the same layer. If not specified, the attribute of each element is its coat.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>JOC_CARAC</ows:Identifier>
				<ows:Title>Character set</ows:Title>
				<ows:Abstract>Character set desired texts; can be OEM or ANSI-1252-850. Defaults to ANSI-1252.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
					<ows:Value>ANSI-1252</ows:Value>
					<ows:Value>OEM-850</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>ANSI-1252</DefaultValue>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TAULA</ows:Identifier>
				<ows:Title>Table</ows:Title>
				<ows:Abstract>Set database field to be exported as a layer or text in a DXF format. To learn more about the values of these parameters follow the consiterations in general syntax.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP</ows:Identifier>
				<ows:Title>Field</ows:Title>
				<ows:Abstract>Set database field to be exported as a layer or text in a DXF format. To learn more about the values of these parameters follow the consiterations in general syntax.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REPE</ows:Identifier>
				<ows:Title>Repe</ows:Title>
				<ows:Abstract>Indicates which record is used when there are more than one record for a graphic identifier (multiple record). For more information on the values of this parameter refer to the document general syntax.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALCADA</ows:Identifier>
				<ows:Title>Heights</ows:Title>
				<ows:Abstract>Sets which of the possible heights are used in the DXF. To learn more about the values of this parameter follow the consiterations in general syntax.</ows:Abstract>
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>	
			</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>DXFFile Name</ows:Identifier>
				<ows:Title>DXF File Name</ows:Title>
				<ows:Abstract>Is the name of the DXF output name.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
						<ComplexOutput>
							<Default>
						<Format>
							<MimeType>application/x-DXF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DXF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
							</Supported>
						</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
