<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:RasSelec:1</ows:Identifier>
		<ows:Metadata xlink:title="Title:Selecció d&apos;un subconjunt de cel·les en ràsters"/>
		<ows:Metadata xlink:title="Abstract:Selecció d&apos;un subconjunt de cel·les d&apos;un ràster monobanda o multibanda."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxOri</ows:Identifier>
				<ows:Title>Fitxer origen</ows:Title>
				<ows:Abstract>Fitxer origen per a fer la selecció.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FitxerOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RETALL_SEL</ows:Identifier>
				<ows:Title>Retallar per selecció</ows:Title>
				<ows:Abstract>Retallar el fitxer de sortida ajustat a la selecció.</ows:Abstract>
				<ows:Metadata xlink:title="Name:RETALL_SEL"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefix multibanda</ows:Title>
				<ows:Abstract>Prefix als fitxers de sortida en cas de multibanda.</ows:Abstract>
				<ows:Metadata xlink:title="Name:PREFIX"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MASC_NODATA</ows:Identifier>
				<ows:Title>Marcar 0 com a valor sensedades</ows:Title>
				<ows:Abstract>En el cas que se seleccioni la sortida com a format màscara, es marca el 0 com a valor sensedades.</ows:Abstract>
				<ows:Metadata xlink:title="Name:MASC_NODATA"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>Sortida multibanda</ows:Title>
				<ows:Abstract>En cas que el fitxer origen sigui multibanda, s'assigna que la sortida sigui també multibanda.</ows:Abstract>
				<ows:Metadata xlink:title="Name:MULTIBANDA"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="50">
				<ows:Identifier>COND#_OP</ows:Identifier>
				<ows:Title>Condició o operador</ows:Title>
				<ows:Abstract>Selecció de l'operador lògic que actuarà sobre /COND_CAMP(banda) per filtrar les cel·les del fitxer origen. Per a més detalls d'aquest i els següents paràmetres optatius, vegeu l'apartat "Selecció d'objectes gràfics per atributs de la base de dades" a "Aspectes de sintaxi d'algunes Aplicacions de Suport a MiraMon (MSA)".</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>EQ</ows:Value>
						<ows:Value>NO_EQ</ows:Value>
						<ows:Value>EQ_SUBCADENA</ows:Value>
						<ows:Value>NO_EQ_SUBCADENA</ows:Value>
						<ows:Value>LT_EQ</ows:Value>
						<ows:Value>GT_EQ</ows:Value>
						<ows:Value>INTERVAL</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="50">
				<ows:Identifier>COND#_CAMP</ows:Identifier>
				<ows:Title>Bandes de la condició</ows:Title>
				<ows:Abstract>Selecció de la banda sobre la qual s'aplicarà la /COND_OP.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="50">
				<ows:Identifier>COND#_VALOR</ows:Identifier>
				<ows:Title>Valor de la condició</ows:Title>
				<ows:Abstract>Valor del /COND_CAMP sobre el qual s'aplicarà la /COND_OP. Calen cometes si porta espais.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="50">
				<ows:Identifier>COND#_NEXE</ows:Identifier>
				<ows:Title>Nexe entre condicions</ows:Title>
				<ows:Abstract>Nexe entre les condicions # i #+1. Pot ser AND (i) o OR (o).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>OR</ows:Value>
						<ows:Value>AND</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>BANDA</ows:Identifier>
				<ows:Title>Banda</ows:Title>
				<ows:Abstract>En cas d'un fitxer llegit via GDAL, és la banda de referència a la qual es vol aplicar la selecció. En cas que no s'indiqui la banda, s'usarà la primera banda de referència. En cas de seleccionar sortida multibanda, s'escriuran totes les bandes del mateix subconjunt de dades que tinguin el mateix pas de malla que la banda de referència.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SDS</ows:Identifier>
				<ows:Title>Subconjunt de dades</ows:Title>
				<ows:Abstract>En cas d'un fitxer llegit via GDAL, és el subconjunt de dades del fitxer d'entrada sobre el qual es vol aplicar la selecció.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MASC</ows:Identifier>
				<ows:Title>Fitxer destí com a màscara</ows:Title>
				<ows:Abstract>Es desarà el fitxer de sortida com a màscara, és a dir, que les cel·les que compleixin les condicions de la selecció tindran el valor 1, mentre que les cel·les que no les compleixin tindran el valor 0. El fitxer de sortida es desarà en format byte comprimit i indexat.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxOut</ows:Identifier>
				<ows:Title>Fitxer o directori de sortida</ows:Title>
				<ows:Abstract>Fitxer de sortida en cas de monobanda o directori de sortida en cas de multibanda.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerSortida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>