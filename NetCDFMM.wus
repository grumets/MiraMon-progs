<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:NDFIMG:1</ows:Identifier>
		<ows:Title>Import NetCDF format files</ows:Title>
		<ows:Abstract>This module allows certain NetCDF formats to be imported into MiraMon structured vector point files PNT. NetCDF stands for Network Common Data Form and is a format commonly used by meteorologists. Its great flexibility and adaptability makes it suitable for various types of data: point observations, time series, satellite or radar images etc.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Import NetCDF format files"/>
		<ows:Metadata xlink:title="Abstract:This module allows certain NetCDF formats to be imported into MiraMon structured vector point files PNT. NetCDF stands for Network Common Data Form and is a format commonly used by meteorologists. Its great flexibility and adaptability makes it suitable for various types of data: point observations, time series, satellite or radar images etc."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract><![CDATA[Option can be:<li>1.1 if you do not wish to reproject the points, that is to keep them in the same reference system as for the CDF file.</li><li>2 if you wish to reproject the points to one of the other reference systems supported by MiraMon. It is necessary to correctly identify the datum of the original reference system.</li>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerCDF</ows:Identifier>
				<ows:Title>CDF file</ows:Title>
				<ows:Abstract>Is the CDF to be imported (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-netcdf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-netcdf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NDecimals</ows:Identifier>
				<ows:Title>Decimal Number</ows:Title>
				<ows:Abstract>Will be the number of decimal places used to write numerical fields in the database.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:DecimalN"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_ORI</ows:Identifier>
				<ows:Title>Reference System</ows:Title>
				<ows:Abstract>Indicates the identifier of the reference system of the NetCDF file. The default value is lat/long-ED50.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Reference System</ows:Title>
				<ows:Abstract>Indicates the identifier of the reference system for the output file. The default value corresponds to the key RefSystem= in the [Metrica] section of the MiraMon.par configuration file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDesti</ows:Identifier>
				<ows:Title>Output File</ows:Title>
				<ows:Abstract>Is the resulting PNT file.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>