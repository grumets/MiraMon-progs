<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:NDFIMG:1</ows:Identifier>
		<ows:Title>Import NetCDF format files</ows:Title>
		<ows:Abstract>This application allows certain NetCDF formats to be imported into MiraMon structured vector point files, PNT, which will be 3D in general. During the import it is also possible to change the projection and/or reference system (datum, etc).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Import NetCDF vector format"/>
		<ows:Metadata xlink:title="Abstract:This application allows certain NetCDF formats to be imported into MiraMon structured vector point files, PNT, which will be 3D in general. During the import it is also possible to change the projection and/or reference system (datum, etc)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract><![CDATA[<li>1 to not reproject the points, that is to keep them in the same reference system as for the CDF file.</li><li>2 to reproject the points to one of the other reference systems supported by MiraMon. It is necessary to correctly identify the datum of the original reference system.</li>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerCDF</ows:Identifier>
				<ows:Title>CDF file</ows:Title>
				<ows:Abstract>Is the CDF to be imported (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:CDFFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-netcdf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-netcdf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NDecimals</ows:Identifier>
				<ows:Title>Decimal number</ows:Title>
				<ows:Abstract>It is the number of decimal digits with which the numeric fields of real numbers in the database will be written.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:DecimalN"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_ORI</ows:Identifier>
				<ows:Title>Reference system</ows:Title>
				<ows:Abstract>Indicates the identifier of the reference system of the NetCDF file. The default value is lat/long-ED50.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Reference System</ows:Title>
				<ows:Abstract>Indicates the identifier of the reference system for the output file. The default value corresponds to the key RefSystem= in the [Metrica] section of the MiraMon.par configuration file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDesti</ows:Identifier>
				<ows:Title>Output file</ows:Title>
				<ows:Abstract>Is the resulting PNT file.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>