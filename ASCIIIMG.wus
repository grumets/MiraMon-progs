<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ASCIIIMG:!Param05</ows:Identifier>
		<ows:Title>AsciiIMG ESRI</ows:Title>
		<ows:Abstract>This option interprets the header of the ESRI ASCII format to transform it the file.</ows:Abstract>
		<ows:Metadata xlink:title="Title:ASCII to MiraMon raster file conversion"/>
		<ows:Metadata xlink:title="Abstract: This program converts raster files from several ASCII formats to MiraMon (IMG format)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>reg</ows:Identifier>
				<ows:Title>Register size or delimiter</ows:Title>
				<ows:Abstract><![CDATA[Treatment:<ul><li>-1 (and less than 6 parameters) ESRI ASCII raster format</li> 				<li>0  When values are separated by a delimiter </li> 				<li>n  The cell width (in characters) for Fixed Record format</li> 				<li>-n (and 6 o more parameters) when it is a n columns structured ASCII file, the n indicates the number of column to import</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:reg"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FOri</ows:Identifier>
				<ows:Title>Input file</ows:Title>
				<ows:Abstract>Input raster ASCII file</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:FOri"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusDada</ows:Identifier>
				<ows:Title>Data Type</ows:Title>
				<ows:Abstract><![CDATA[DataType: output data type<ul><li>bit (integer [0,1], 1 bit/cell)</li><li>byte (integer [0,255], 1 byte/cell)</li><li>integer (integer [-32768, 32767], 2 bytes/cell)</li><li>uinteger (integer [0, 65535], 2 bytes/cell)</li><li>long (integer [-2147483648, 2147483647], 4 bytes/cell)</li><li>real (floating point numbers ±3.4E±32, 4 bytes/cell)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:DataType"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>bit</ows:Value>
						<ows:Value>byte</ows:Value>
						<ows:Value>byte-RLE</ows:Value>
						<ows:Value>integer</ows:Value>
						<ows:Value>integer-RLE</ows:Value>
						<ows:Value>uinteger</ows:Value>
						<ows:Value>uinteger-RLE</ows:Value>
						<ows:Value>long</ows:Value>
						<ows:Value>long-RLE</ows:Value>
						<ows:Value>real</ows:Value>
						<ows:Value>real-RLE</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SisRef</ows:Identifier>
				<ows:Title>Reference System</ows:Title>
				<ows:Abstract>Name of the Reference System used by the cartographic projection.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:RefSys"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>plane</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RefUnit</ows:Identifier>
				<ows:Title>Reference Unit</ows:Title>
				<ows:Abstract>Units of the Reference System.</ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:RefUnit"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>pixel</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FDest</ows:Identifier>
				<ows:Title>IMG file</ows:Title>
				<ows:Abstract>IMG output file</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:FDest"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ASCIIIMG:!Param10</ows:Identifier>
		<ows:Title>AsciiIMG NO ENV</ows:Title>
		<ows:Abstract>In this option the number of  columns, rows and number of lines that conforms the header of the ASCII file must be write manually.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>reg</ows:Identifier>
				<ows:Title>Register size or delimiter</ows:Title>
				<ows:Abstract><![CDATA[Treatment:<ul><li>-1 (and less than 6 parameters) ESRI ASCII raster format</li> 				<li>0  When values are separated by a delimiter </li> 				<li>n  The cell width (in characters) for Fixed Record format</li> 				<li>-n (and 6 o more parameters) when it is a n columns structured ASCII file, the n indicates the number of column to import</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:reg"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FOri</ows:Identifier>
				<ows:Title>Input file</ows:Title>
				<ows:Abstract>Input raster ASCII file</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:FOri"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ncol</ows:Identifier>
				<ows:Title>Number of columns.</ows:Title>
				<ows:Abstract>Number of columns of the ASCII file.</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:ncol"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>nfil</ows:Identifier>
				<ows:Title>Number of rows.</ows:Title>
				<ows:Abstract>Number of rows of the ASCII file.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:nfil"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>nlin</ows:Identifier>
				<ows:Title>lines to skip</ows:Title>
				<ows:Abstract>Number of header text lines to skip of the ASCII file.</ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:nlin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusDada</ows:Identifier>
				<ows:Title>Data Type</ows:Title>
				<ows:Abstract><![CDATA[DataType: output data type<ul><li>bit (integer [0,1], 1 bit/cell)</li><li>byte (integer [0,255], 1 byte/cell)</li><li>integer (integer [-32768, 32767], 2 bytes/cell)</li><li>uinteger (integer [0, 65535], 2 bytes/cell)</li><li>long (integer [-2147483648, 2147483647], 4 bytes/cell)</li><li>real (floating point numbers ±3.4E±32, 4 bytes/cell)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:DataType"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>bit</ows:Value>
						<ows:Value>byte</ows:Value>
						<ows:Value>byte-RLE</ows:Value>
						<ows:Value>integer</ows:Value>
						<ows:Value>integer-RLE</ows:Value>
						<ows:Value>uinteger</ows:Value>
						<ows:Value>uinteger-RLE</ows:Value>
						<ows:Value>long</ows:Value>
						<ows:Value>long-RLE</ows:Value>
						<ows:Value>real</ows:Value>
						<ows:Value>real-RLE</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ValorFons</ows:Identifier>
				<ows:Title>Flag Value</ows:Title>
				<ows:Abstract>Image flag value or "none" if not required.</ows:Abstract>
				<ows:Metadata xlink:title="Param08"/>
				<ows:Metadata xlink:title="Name:FlagValue"/>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DefValFons</ows:Identifier>
				<ows:Title>Flag Definition</ows:Title>
				<ows:Abstract>Image flag value's definition or "none" if there is no flag value.</ows:Abstract>
				<ows:Metadata xlink:title="Param09"/>
				<ows:Metadata xlink:title="Name:FlagDef"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FDest</ows:Identifier>
				<ows:Title>IMG file</ows:Title>
				<ows:Abstract>IMG output file</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:FDest"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ASCIIIMG:Param10</ows:Identifier>
		<ows:Title>AsciiIMG ENV</ows:Title>
		<ows:Abstract>In this option the number of  columns, rows and number of lines that conforms the header of the ASCII file must be write manually. Moreover, the user have to write the extension of the file.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>reg</ows:Identifier>
				<ows:Title>Register size or delimiter</ows:Title>
				<ows:Abstract><![CDATA[Treatment:<ul><li>-1 (and less than 6 parameters) ESRI ASCII raster format</li> 				<li>0  When values are separated by a delimiter </li> 				<li>n  The cell width (in characters) for Fixed Record format</li> 				<li>-n (and 6 o more parameters) when it is a n columns structured ASCII file, the n indicates the number of column to import</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:reg"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FOri</ows:Identifier>
				<ows:Title>Input file</ows:Title>
				<ows:Abstract>Input raster ASCII file</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:FOri"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ncol</ows:Identifier>
				<ows:Title>Number of columns.</ows:Title>
				<ows:Abstract>Number of columns of the ASCII file.</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:ncol"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>nfil</ows:Identifier>
				<ows:Title>Number of rows.</ows:Title>
				<ows:Abstract>Number of rows of the ASCII file.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:nfil"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>nlin</ows:Identifier>
				<ows:Title>lines to skip</ows:Title>
				<ows:Abstract>Number of header text lines to skip of the ASCII file.</ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:nlin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TipusDada</ows:Identifier>
				<ows:Title>Data Type</ows:Title>
				<ows:Abstract><![CDATA[DataType: output data type<ul><li>bit (integer [0,1], 1 bit/cell)</li><li>byte (integer [0,255], 1 byte/cell)</li><li>integer (integer [-32768, 32767], 2 bytes/cell)</li><li>uinteger (integer [0, 65535], 2 bytes/cell)</li><li>long (integer [-2147483648, 2147483647], 4 bytes/cell)</li><li>real (floating point numbers ±3.4E±32, 4 bytes/cell)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:DataType"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>bit</ows:Value>
						<ows:Value>byte</ows:Value>
						<ows:Value>byte-RLE</ows:Value>
						<ows:Value>integer</ows:Value>
						<ows:Value>integer-RLE</ows:Value>
						<ows:Value>uinteger</ows:Value>
						<ows:Value>uinteger-RLE</ows:Value>
						<ows:Value>long</ows:Value>
						<ows:Value>long-RLE</ows:Value>
						<ows:Value>real</ows:Value>
						<ows:Value>real-RLE</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ValorFons</ows:Identifier>
				<ows:Title>Flag Value</ows:Title>
				<ows:Abstract>Image flag value or "none" if not required.</ows:Abstract>
				<ows:Metadata xlink:title="Param08"/>
				<ows:Metadata xlink:title="Name:FlagValue"/>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DefValFons</ows:Identifier>
				<ows:Title>Flag Definition</ows:Title>
				<ows:Abstract>Image flag value's definition or "none" if there is no flag value.</ows:Abstract>
				<ows:Metadata xlink:title="Param09"/>
				<ows:Metadata xlink:title="Name:FlagDef"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>minx</ows:Identifier>
				<ows:Title>X min</ows:Title>
				<ows:Abstract>X min Image envelopment.</ows:Abstract>
				<ows:Metadata xlink:title="Param10"/>
				<ows:Metadata xlink:title="Name:minx"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>maxx</ows:Identifier>
				<ows:Title>X max</ows:Title>
				<ows:Abstract>X max Image envelopment</ows:Abstract>
				<ows:Metadata xlink:title="Param11"/>
				<ows:Metadata xlink:title="Name:maxx"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>miny</ows:Identifier>
				<ows:Title>Y min</ows:Title>
				<ows:Abstract>Y min Image envelopment.</ows:Abstract>
				<ows:Metadata xlink:title="Param12"/>
				<ows:Metadata xlink:title="Name:miny"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>maxy</ows:Identifier>
				<ows:Title>Y max</ows:Title>
				<ows:Abstract>Y max Image envelopment.</ows:Abstract>
				<ows:Metadata xlink:title="Param13"/>
				<ows:Metadata xlink:title="Name:maxy"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>SisRef</ows:Identifier>
				<ows:Title>Reference System</ows:Title>
				<ows:Abstract>Name of the Reference System used by the cartographic projection.</ows:Abstract>
				<ows:Metadata xlink:title="Param14"/>
				<ows:Metadata xlink:title="Name:RefSys"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>plane</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RefUnit</ows:Identifier>
				<ows:Title>Reference Unit</ows:Title>
				<ows:Abstract>Units of the Reference System.</ows:Abstract>
				<ows:Metadata xlink:title="Param15"/>
				<ows:Metadata xlink:title="Name:RefUnit"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>pixel</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FDest</ows:Identifier>
				<ows:Title>IMG file</ows:Title>
				<ows:Abstract>IMG output file</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:FDest"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>