					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NDecimals</ows:Identifier>
				<ows:Title>Decimals Number</ows:Title>
				<ows:Abstract>Number of decimals of the field, select 0 if it is not numerical.</ows:Abstract>
				<ows:Metadata xlink:title="Param8"/>
				<ows:Metadata xlink:title="Name:NDecimals"/>
