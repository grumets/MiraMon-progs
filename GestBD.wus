	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestBD:param1:27</ows:Identifier>
		<ows:Title>PAS_DE_ESTESA_A_CLASSICA (27)</ows:Title>
		<ows:Abstract>Converts a MiraMon extended DBF to classical DBF format (dBASE III, dBASE III+ o dBASE IV).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Converts an extended DBF file to classical DBF file.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>27</ows:Value>
