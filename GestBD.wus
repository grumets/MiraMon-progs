				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:DBFFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomCampRMS</ows:Identifier>
				<ows:Title>RMS Field Name</ows:Title>
				<ows:Abstract>Name of the field in the DBF table of which the RMS is calculated.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:RMSFieldName"/>
