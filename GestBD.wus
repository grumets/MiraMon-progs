	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GestBD:param1:28</ows:Identifier>
		<ows:Title>MOSTRA_RMS_DE_CAMP (28)</ows:Title>
		<ows:Abstract>Calculates the RMS of a field in a DBF and displays it on the screen.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
