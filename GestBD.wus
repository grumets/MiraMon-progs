							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDBFClassica</ows:Identifier>
				<ows:Title>Classical DBF File</ows:Title>
				<ows:Abstract>DBF file in classical format (dBASE III, dBASE III+ or dBASE IV).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:ClassicalDBFFile"/>
				<ComplexOutput>
					<Default>
