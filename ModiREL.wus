	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ModiREL:Param1:5</ows:Identifier>
		<ows:Title>5. Run multiple commands within the CommandFileName file on an INI file</ows:Title>
		<ows:Abstract>Carries out multiple commands within the CommandFileName file on an INI file</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Runs multiple commands within the CommandFileName file on an INI file</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>5</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>5</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxINI</ows:Identifier>
				<ows:Title>INI File</ows:Title>
				<ows:Abstract>INI File</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:INIFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-ini</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-ini</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerComandes</ows:Identifier>
				<ows:Title>CommandFileName</ows:Title>
				<ows:Abstract>File that includes the commands to be executed</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:CommandFileName"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxINI</ows:Identifier>
				<ows:Title>INI File</ows:Title>
				<ows:Abstract>INI File</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:INIFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-ini</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-ini</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ModiREL:Param1:6</ows:Identifier>
		<ows:Title>6. Reads the value of a key, and if the key is not found or is empty, returns the default value</ows:Title>
		<ows:Abstract>Reads the value of a key; if it is empty or it is not found, returns the default value. Displays the read value on the screen, unless /TXT= is specified, in which case it is sent to a text file.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Reads the value of a key and if the key is not found or is empty, returns the default value. Displays the read value on the screen, unless /TXT= is specified, in which case it is sent to a text file.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>6</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>6</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxINI</ows:Identifier>
				<ows:Title>INI File</ows:Title>
				<ows:Abstract>INI File</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:INIFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-ini</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-ini</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Seccio</ows:Identifier>
				<ows:Title>Section</ows:Title>
				<ows:Abstract>Section</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Section"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Clau</ows:Identifier>
				<ows:Title>Key</ows:Title>
				<ows:Abstract>Key</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Key"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ValorDefecte</ows:Identifier>
				<ows:Title>Default value</ows:Title>
				<ows:Abstract>Default value returned if a key is not found, or is empty</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:DefaultValue"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TXT</ows:Identifier>
				<ows:Title>Output TXT file</ows:Title>
				<ows:Abstract>Output TXT file where the result of the operation will be saved instead of being displayed on the screen. If the file already exists, the new result will be written at the end of the file (typically after the previous result; if a separator is desired between them, this must be indicated with the /SEPAR parameter). Only used for option 6.</ows:Abstract>
				<ows:Metadata xlink:title="Name:TXT"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SEPARA</ows:Identifier>
				<ows:Title>Separator character after the reported value</ows:Title>
				<ows:Abstract>If you use the /TXT= option, it is possible to force the appearance of a character after the written result. For example, if /SEPARA=; is indicated, the resulting values of successive executions will appear consecutively, on the same line, separated by a semicolon. If you want to indicate a blank space as a separator, you must write "/SEPARA= " (with the quotes). In case of indicate a tab as a separator /SEPARA=TAB must be written. In case of a return as a separator, /SEPARA=RET must be written (which will write a conventional return in DOS and Windows: \r\n).</ows:Abstract>
				<ows:Metadata xlink:title="Name:SEPARA"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
