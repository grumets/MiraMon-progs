	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SDEMM:5</ows:Identifier>
		<ows:Title>Option 4</ows:Title>
		<ows:Abstract>Import of an SDE raster to MiraMon raster format. Level and envelope may be specified. Downloading the maximum resolution level is not recommended.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 4</ows:Title>
				<ows:Abstract>Import of an SDE raster to MiraMon raster format. Level and envelope may be specified. Downloading the maximum resolution level is not recommended.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>4</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Servidor</ows:Identifier>
				<ows:Title>Server</ows:Title>
				<ows:Abstract>Server is the name of the server where the layer you wish to import is stored. For example, 158.109.57.114.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Server"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Instancia</ows:Identifier>
				<ows:Title>Instance</ows:Title>
				<ows:Abstract>Is the instance where the layer you wish to import is located. For example, 5153.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Instance"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BaseDeDades</ows:Identifier>
				<ows:Title>DataBase</ows:Title>
				<ows:Abstract>DataBase is the name of the database in the server where the layer you wish to import is stored. For example, SDE_RefDatabase. If you type an asterisk ('*'), you will obtain information regarding all the databases. It is necessary to type an asterisk on Oracle managers.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Database"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Usuari</ows:Identifier>
				<ows:Title>User</ows:Title>
				<ows:Abstract>Is the username for this server and this instance.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:User"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Contrasenya</ows:Identifier>
				<ows:Title>Password</ows:Title>
				<ows:Abstract>Is the user password for this server and this instance. If you type an asterisk '*', the program asks for it when it needs it (only once).</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:Password"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CapaSDE</ows:Identifier>
				<ows:Title>SDE Layer</ows:Title>
				<ows:Abstract>SDELayer is the name of the layer that you wish to import from the ArcSDE database.</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:SDELayer"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RasterId</ows:Identifier>
				<ows:Title>Raster ID</ows:Title>
				<ows:Abstract>Numeric identifier of the raster within the ArcSDE layer.</ows:Abstract>
				<ows:Metadata xlink:title="Param8"/>
				<ows:Metadata xlink:title="Name:RasterId"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ID_ENTITAT</ows:Identifier>
				<ows:Title>ID Entity</ows:Title>
				<ows:Abstract>Indicates the field name of the SDElayer which will act as identifier for the entity. If you select this parameter, the main table will contain two fields and the secondary one will contain as many fields as the SDElayer (except the field which contains the spatial information (Shape).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CLAU_COD</ows:Identifier>
				<ows:Title>Encoded key</ows:Title>
				<ows:Abstract>Indica que la contrasenya està codificada.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NIVELL</ows:Identifier>
				<ows:Title>Level</ows:Title>
				<ows:Abstract>Raster resolution level to import (/NIVELL=). Defaults to 0 if omitted.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>XMIN</ows:Identifier>
				<ows:Title>Minimum X</ows:Title>
				<ows:Abstract>Minimum X coordinate of the envelope (/XMIN=).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>XMAX</ows:Identifier>
				<ows:Title>Maximum X</ows:Title>
				<ows:Abstract>Maximum X coordinate of the envelope (/XMAX=).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>YMIN</ows:Identifier>
				<ows:Title>Minimum Y</ows:Title>
				<ows:Abstract>Minimum Y coordinate of the envelope (/YMIN=).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>YMAX</ows:Identifier>
				<ows:Title>Maximum Y</ows:Title>
				<ows:Abstract>Maximum Y coordinate of the envelope (/YMAX=).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>CapaRaster</ows:Identifier>
				<ows:Title>Raster layer</ows:Title>
				<ows:Abstract>(no extension) is the MiraMon raster output file (IMG). Asterisk '*' creates a temporary file removed when no longer needed.</ows:Abstract>
				<ows:Metadata xlink:title="Param9"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SDEMM:6</ows:Identifier>
		<ows:Title>Option 5</ows:Title>
		<ows:Abstract>Generation of a layer REL for an ArcSDE raster.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 5</ows:Title>
				<ows:Abstract>Generation of a layer REL for an ArcSDE raster.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>5</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>5</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Servidor</ows:Identifier>
				<ows:Title>Server</ows:Title>
				<ows:Abstract>Server is the name of the server where the layer you wish to import is stored. For example, 158.109.57.114.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Server"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Instancia</ows:Identifier>
				<ows:Title>Instance</ows:Title>
				<ows:Abstract>Is the instance where the layer you wish to import is located. For example, 5153.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Instance"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>BaseDeDades</ows:Identifier>
				<ows:Title>DataBase</ows:Title>
				<ows:Abstract>DataBase is the name of the database in the server where the layer you wish to import is stored. For example, SDE_RefDatabase. If you type an asterisk ('*'), you will obtain information regarding all the databases. It is necessary to type an asterisk on Oracle managers.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Database"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Usuari</ows:Identifier>
				<ows:Title>User</ows:Title>
				<ows:Abstract>Is the username for this server and this instance.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:User"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Contrasenya</ows:Identifier>
				<ows:Title>Password</ows:Title>
				<ows:Abstract>Is the user password for this server and this instance. If you type an asterisk '*', the program asks for it when it needs it (only once).</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:Password"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CapaSDE</ows:Identifier>
				<ows:Title>SDE Layer</ows:Title>
				<ows:Abstract>SDELayer is the name of the layer that you wish to import from the ArcSDE database.</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:SDELayer"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RasterId</ows:Identifier>
				<ows:Title>Raster ID</ows:Title>
				<ows:Abstract>Numeric identifier of the raster within the ArcSDE layer.</ows:Abstract>
				<ows:Metadata xlink:title="Param9"/>
				<ows:Metadata xlink:title="Name:RasterId"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ID_ENTITAT</ows:Identifier>
				<ows:Title>ID Entity</ows:Title>
				<ows:Abstract>Indicates the field name of the SDElayer which will act as identifier for the entity. If you select this parameter, the main table will contain two fields and the secondary one will contain as many fields as the SDElayer (except the field which contains the spatial information (Shape).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CLAU_COD</ows:Identifier>
				<ows:Title>Encoded key</ows:Title>
				<ows:Abstract>Indica que la contrasenya està codificada.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>RelDeCapa</ows:Identifier>
				<ows:Title>LayerCapa</ows:Title>
				<ows:Abstract>És el nom del REL de capa que es genera i que vincula amb la capa capaSDE.</ows:Abstract>
				<ows:Metadata xlink:title="Param8"/>
				<ows:Metadata xlink:title="Name:LayerCapa"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>