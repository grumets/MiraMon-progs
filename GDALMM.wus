<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GDALMM:0</ows:Identifier>
		<ows:Title>Information</ows:Title>
		<ows:Abstract>Provides information about the file in a format importable via GDAL.</ows:Abstract>
		<ows:Metadata xlink:title="Title:File importing using GDAL"/>
		<ows:Metadata xlink:title="Abstract:Imports vector or raster files in any format compatible with GDAL into the MiraMon format. The user has the option to choose whether to import only specific layers or all layers contained in the file. An output directory can be specified, or, if the file contains a single layer of a single type, an output filename can be provided with the corresponding extension: pnt, arc, pol, or img."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>opcio</ows:Identifier>
				<ows:Title>0</ows:Title>
				<ows:Abstract>Provides information about a file via GDAL.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:0"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerEntrada</ows:Identifier>
				<ows:Title>File in a format that GDAL can import.</ows:Title>
				<ows:Abstract>File in a format that GDAL can import.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:InputFile"/>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GDALMM:1:fitxer</ows:Identifier>
		<ows:Title>File importation</ows:Title>
		<ows:Abstract>Importa un fitxer via GDAL sempre i quan el fitxer d'entrada contingui només una sola capa d'un sol tipus.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>opcio</ows:Identifier>
				<ows:Title>1</ows:Title>
				<ows:Abstract>Imports a file into MiraMon via GDAL.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:1"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerEntrada</ows:Identifier>
				<ows:Title>File in a format that GDAL can import.</ows:Title>
				<ows:Abstract>File in a format that GDAL can import.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:InputFile"/>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerSortida</ows:Identifier>
				<ows:Title>File in MiraMon format</ows:Title>
				<ows:Abstract>File in MiraMon format.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GDALMM:1:directori</ows:Identifier>
		<ows:Title>Importació a directori</ows:Title>
		<ows:Abstract>Importació a directori</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>opcio</ows:Identifier>
				<ows:Title>1</ows:Title>
				<ows:Abstract>Imports a file into MiraMon via GDAL.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:1"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerEntrada</ows:Identifier>
				<ows:Title>File in a format that GDAL can import.</ows:Title>
				<ows:Abstract>File in a format that GDAL can import.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:InputFile"/>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DirectoriSortida</ows:Identifier>
				<ows:Title>Output folder</ows:Title>
				<ows:Abstract>Output folder</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputFolder"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>