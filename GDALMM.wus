<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GDALMM:0</ows:Identifier>
		<ows:Title>Information</ows:Title>
		<ows:Abstract>Provides information about the file in a format importable via OGR/GDAL.</ows:Abstract>
		<ows:Metadata xlink:title="Title:File importing using GDAL"/>
		<ows:Metadata xlink:title="Abstract:Imports vector or raster files in any format compatible with GDAL into the MiraMon format. The user has the option to choose whether to import only specific layers or all layers contained in the file. An output directory can be specified, or, if the file contains a single layer of a single type, an output filename can be provided with the corresponding extension: pnt, arc, pol, or img."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Provides information about a file via GDAL.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerEntrada</ows:Identifier>
				<ows:Title>OGR/GDAL file to import</ows:Title>
				<ows:Abstract>File to import using OGR/GDAL libraries.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:InputFile"/>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GDALMM:1</ows:Identifier>
		<ows:Title>Importing a file using OGR/GDAL libraries.</ows:Title>
		<ows:Abstract>Imports a subset of layers from a OGR/GDAL-compatible file.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Imports a file into MiraMon via GDAL.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerEntrada</ows:Identifier>
				<ows:Title>OGR/GDAL file to import</ows:Title>
				<ows:Abstract>File to import using OGR/GDAL libraries.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:InputFile"/>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FitxLListaCapes</ows:Identifier>
				<ows:Title>Layer list file</ows:Title>
				<ows:Abstract>File containing a list of layers (in the case of a vector file) or subdatasets (in the case of a raster file) to be imported. If this file is not specified, all layers or subdatasets found in the source file will be imported.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:LayerListFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>DirectoriSortida</ows:Identifier>
				<ows:Title>Output folder</ows:Title>
				<ows:Abstract>Output file (in case one layer is found) or output directory (in case more than one layer or subsets are found) where the files imported in MiraMon format from the source file using the OGR/GDAL libraries will be saved.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputFoldOrFile"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>