<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CREATOP:Param1:T</ows:Identifier>
		<ows:Title>Creatop Punts</ows:Title>
		<ows:Abstract>Estructuració topològica d'un fitxer de punts.</ows:Abstract>
<ows:Metadata xlink:title="Title:Estructuració topològica simplificada" />
<ows:Metadata xlink:title="Abstract:Aquest programa integra i facilita l'ús dels programes d'estructuració topològica VECPNT, LINARC, CICLAR, ATRIPOL i TESTTOP. Cal ser conscient de les seves limitacions."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>T</ows:Identifier>
				<ows:Title>Punts</ows:Title>
				<ows:Abstract>Indica que volem fer un fitxer de punts</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
		<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
						<ows:Value>T</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerVEC</ows:Identifier>
				<ows:Title>Nom del Fitxer Vectorial</ows:Title>
				<ows:Abstract>Fitxer VEC o PNT a convertir. 
				</ows:Abstract>
<ows:Metadata xlink:title="Param2" />
		<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
		</ComplexData>
		</Input>
		<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Tolerancia</ows:Identifier>
				<ows:Title>Tolerància</ows:Title>
				<ows:Abstract>Valor de la tolerància. Si no s'indica s'assumeix una tolerància igual a 0.001. </ows:Abstract>
		<LiteralData>
			<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integrer">integrer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
	</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFitxerVEC</ows:Identifier>
				<ows:Title>Nom del Fitxer Vectorial</ows:Title>
				<ows:Abstract>Fitxer VEC o PNT a convertit
				</ows:Abstract>
				<ows:Metadata xlink:title="Param2" />
						<ComplexOutput>
						<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CREATOP:Param1:A</ows:Identifier>
		<ows:Title>Creatop Arcs</ows:Title>
		<ows:Abstract>Estructuració topològica d'un fitxer d'arcs</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>A</ows:Identifier>
				<ows:Title>Arcs</ows:Title>
				<ows:Abstract>Indica que volem fer un fitxer de línies</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
		<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
						<ows:Value>A</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerVEC</ows:Identifier>
				<ows:Title>Nom del Fitxer Vectorial</ows:Title>
				<ows:Abstract>Fitxer VEC o ARC a convertir. 
				</ows:Abstract>
<ows:Metadata xlink:title="Param2" />
		<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
		</ComplexData>
		</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Tolerancia</ows:Identifier>
				<ows:Title>Tolerància</ows:Title>
				<ows:Abstract>Valor de la tolerància. Si no s'indica s'assumeix una tolerància igual a 0.001.</ows:Abstract>
		<LiteralData>
			<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integrer">integrer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
	</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFitxerVEC</ows:Identifier>
				<ows:Title>Nom del Fitxer Vectorial</ows:Title>
				<ows:Abstract>Fitxer VEC o ARC a convertit
				</ows:Abstract>
				<ows:Metadata xlink:title="Param2" />
						<ComplexOutput>
						<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-nod</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>	
<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CREATOP:Param1:P</ows:Identifier>
		<ows:Title>Creatop Polígons</ows:Title>
		<ows:Abstract>Estructuració topològica d'un fitxer Polígons.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>P</ows:Identifier>
				<ows:Title>Polígons</ows:Title>
				<ows:Abstract>Indica que volem fer un fitxer de polígons</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
		<LiteralData>
					<ows:AllowedValues>
<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
						<ows:Value>P</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>x</ows:Identifier>
				<ows:Title>Tipus d'estructuració</ows:Title>
				<ows:Abstract>Si no s'indica es fa l'estructuració a partir del fitxer de línies. Si s'indica 1 es suposa la existència d'un fitxer d'arcs vàlid i es fa servir com a punt de partida per construir polígons. Si s'indica 2 s'assumeix que el fitxer de polígons és vàlid i només es reetiqueten els polígons.</ows:Abstract>
					<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:Value>1</ows:Value>
					<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>			
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomFitxerVEC</ows:Identifier>
				<ows:Title>Nom del Fitxer Vectorial</ows:Title>
				<ows:Abstract>Fitxer VEC o POL a convertir. 
				</ows:Abstract>
<ows:Metadata xlink:title="Param2" />
		<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
		</ComplexData>
		</Input>
		<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier> NomFitxerEtiquetes</ows:Identifier>
				<ows:Title> Nom Fitxer Etiquetes</ows:Title>
				<ows:Abstract>Fitxer VEC o PNT d'etiquetes (punts). 
				</ows:Abstract>
<ows:Metadata xlink:title="Param3" />
		<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
		</ComplexData>
		</Input>
		<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Tolerancia</ows:Identifier>
				<ows:Title>Tolerància</ows:Title>
				<ows:Abstract>Valor de la tolerància. Si no s'indica s'assumeix una tolerància igual a 0.001.</ows:Abstract>
		<LiteralData>
			<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integrer">integrer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
	</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NomFitxerVEC</ows:Identifier>
				<ows:Title>Nom del Fitxer Vectorial</ows:Title>
				<ows:Abstract>Fitxer VEC o POL a convertit
				</ows:Abstract>
				<ows:Metadata xlink:title="Param2" />
						<ComplexOutput>
						<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>		
</wps:ProcessDescriptions>
