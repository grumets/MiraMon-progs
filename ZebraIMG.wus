<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ZebraIMG:Opcio</ows:Identifier>
		<ows:Title>ZebraIMG</ows:Title>
		<ows:Abstract><![CDATA[This module allows the import of files in the internal raster format of the Zebra <i>software</i> to the format of MiraMon. This format is used principally for satellite and radar images in the meteorological field.<br/>For more information on the specifications of this format go to: <a href="https://www.eol.ucar.edu/software-center">https://www.eol.ucar.edu/software-center</a>]]></ows:Abstract>
		<ows:Metadata xlink:title="Title:Import Zebra (rf) format raster files"/>
		<ows:Metadata xlink:title="Abstract:This module allows the import of files in the internal raster format of the Zebra &lt;i&gt;software&lt;/i&gt; to the format of MiraMon. This format is used principally for satellite and radar images in the meteorological field.&lt;br/&gt;For more information on the specifications of this format go to: &lt;a href=&quot;https://www.eol.ucar.edu/software-center&quot;&gt;https://www.eol.ucar.edu/software-center&lt;/a&gt;"/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract><![CDATA[<li>1. If the user does not wish to reproject the original raster, or that the original reference system of the RF file is kept.</li><li>2. If the user wishes to reproject to one of the other reference systems supported by MiraMon. It is necessary to correctly identify the datum of the original reference system.</li>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigen</ows:Identifier>
				<ows:Title>Input File</ows:Title>
				<ows:Abstract>Is the file to be imported (assumed to have extension rf).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:InputFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_ORI</ows:Identifier>
				<ows:Title>Reference system</ows:Title>
				<ows:Abstract>Indicates the identifier of the reference system of the RF file. The default value is that of the reference system of the Zebra projection (cylindrical equidistant) identified as Zebra in the equivalences table u_idofic.dbf.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Output Reference System</ows:Title>
				<ows:Abstract>indicates the identifier of the reference system of the output file. The default value corresponds to the RefSystem= key in the [Metrica] section of the MiraMon.par configuration file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDesti</ows:Identifier>
				<ows:Title>Output File</ows:Title>
				<ows:Abstract>It is the raster output file.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>