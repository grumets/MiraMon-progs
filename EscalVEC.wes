<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:EscalVEC:param1:1</ows:Identifier>
		<ows:Title>EscalVEC 1</ows:Title>
		<ows:Abstract>Escalado general</ows:Abstract>
	<ows:Metadata xlink:title="Title:Escalado y desplazamiento de entidades vectoriales"/>
<ows:Metadata xlink:title="Abstract:Realiza el escalado o el cambio de escala de ficheros vectoriales en formato VEC. También permite cambiar coordenadas mapa a coordenadas papel como paso anterior a la exportación hacia algunos paquetes de dibujo."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcion</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>1. Escalado general. El desplazamiento en X y en Y (DesplazX y DesplazY) se aplica después del Escalado. Unidades permite escribir en el DOC las nuevas unidades (puede ser x para dejar las previas)</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FicheroOri</ows:Identifier>
				<ows:Title>Fichero Origen</ows:Title>
				<ows:Abstract>Es el nombre del fichero de entrada a reescalar.
</ows:Abstract>
			<ows:Metadata xlink:title="Param2" />
			<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-VEC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
					<MimeType>application/x-VEC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Escalado</ows:Identifier>
				<ows:Title>Escalado</ows:Title>
				<ows:Abstract>Unidades que permiten escribir al doc las nuevas unidades (puede ser x para dejar las previas). 
</ows:Abstract>
			<ows:Metadata xlink:title="Param4" />
	<LiteralData>
		<ows:AllowedValues>
		<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
		<ows:AnyValue/>
		</ows:AllowedValues>
	</LiteralData>
			</Input>			
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Unidades</ows:Identifier>
				<ows:Title>Unidades</ows:Title>
				<ows:Abstract>Son las nuevas unidades:<![CDATA[<ul><li>mm (mil·límetros)</li><li>cm (centímetros)</li><li>pz o inch (pulgas)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param5" />
				<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
						<ows:Value>mm</ows:Value>
						<ows:Value>cm</ows:Value>
						<ows:Value>pz</ows:Value>
						<ows:Value>inch</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DesplaçX</ows:Identifier>
				<ows:Title>Desplazamiento X</ows:Title>
				<ows:Abstract>Desplazamiento X</ows:Abstract>
				<ows:Metadata xlink:title="Param6" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AllowedValues>
						<ows:AnyValue/>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DesplaçY</ows:Identifier>
				<ows:Title>Desplazamiento Y</ows:Title>
				<ows:Abstract>Desplazamiento Y</ows:Abstract>
				<ows:Metadata xlink:title="Param7" />
				<LiteralData>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AllowedValues>
						<ows:AnyValue/>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Precision</ows:Identifier>
				<ows:Title>Precisión</ows:Title>
				<ows:Abstract>Es el número de decimales escritos en el fichero de salida; por defecto vale 3.</ows:Abstract>
			<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
						<ows:AnyValue/>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ESCALAT_Z</ows:Identifier>
				<ows:Title>ESCALAT_Z</ows:Title>
				<ows:Abstract>Es el escalado en Z cuando el fichero es un VEC 3D. 
</ows:Abstract>
	<LiteralData>
	<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
		<ows:AllowedValues>
		<ows:AnyValue/>
		</ows:AllowedValues>
	</LiteralData>
			</Input>				
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DESPLAC_Z</ows:Identifier>
				<ows:Title>DESPLAC_Z</ows:Title>
				<ows:Abstract>Es el desplazamiento en Z cuando el fichero és un VEC 3D
</ows:Abstract>
	<LiteralData>
	<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
		<ows:AllowedValues>
		<ows:AnyValue/>
		</ows:AllowedValues>
	</LiteralData>
			</Input>						
</DataInputs>
	<ProcessOutputs>	
		<Output>
				<ows:Identifier>FicheroDest</ows:Identifier>
				<ows:Title>Fichero destino</ows:Title>
				<ows:Abstract>Es el nombre del fichero de salida reescalado.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
				<ComplexOutput>
					<Default>
							<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:EscalVEC:param1:2</ows:Identifier>
		<ows:Title>EscalVEC 2</ows:Title>
		<ows:Abstract>Cambio de escala.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcion</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>2. Cambio de escala.
</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FicheroOri</ows:Identifier>
				<ows:Title>Fichero Origen</ows:Title>
				<ows:Abstract>Es el nombre del fichero de entrada a reescalar.
</ows:Abstract>
			<ows:Metadata xlink:title="Param2" />
			<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-VEC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
					<MimeType>application/x-VEC</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Escala</ows:Identifier>
				<ows:Title>Escala</ows:Title>
				<ows:Abstract>És el denominador de la nova escala: (p.ex.: 50000) 
</ows:Abstract>
			<ows:Metadata xlink:title="Param4" />
	<LiteralData>
		<ows:AllowedValues>
		<ows:AnyValue/>
		</ows:AllowedValues>
	</LiteralData>
			</Input>			
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Unidades</ows:Identifier>
				<ows:Title>Unidades</ows:Title>
				<ows:Abstract>Son las nuevas unidades:<![CDATA[<ul><li>mm (mil·límetros)</li><li>cm (centímetros)</li><li>pz o inch (pulgas)</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param5" />
				<LiteralData>
					<ows:AllowedValues>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
						<ows:Value>mm</ows:Value>
						<ows:Value>cm</ows:Value>
						<ows:Value>pz</ows:Value>
						<ows:Value>inch</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Xmin</ows:Identifier>
				<ows:Title>X minima</ows:Title>
				<ows:Abstract>>Xmin.Xmin e Ymin son las coordenadas actuales que pasarán a tener situación 0,0. Puede usar números o utilizar alguna de las coordenadas extremas del fichero escribiendo, por ejemplo, 'Xmin Ymin' o bien 'Xmin Ymax'.</ows:Abstract>
				<ows:Metadata xlink:title="Param6" />
			<LiteralData>
						<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Ymin</ows:Identifier>
				<ows:Title>Y minima</ows:Title>
				<ows:Abstract> Ymin. Ymin e Xmin son las coordenadas actuales que pasarán a tener situación 0,0. Puede usar números o utilizar alguna de las coordenadas extremas del fichero escribiendo, por ejemplo, 'Xmin Ymin' o bien 'Xmin Ymax'.</ows:Abstract>
				<ows:Metadata xlink:title="Param7" />
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Precision</ows:Identifier>
				<ows:Title>Precisión</ows:Title>
				<ows:Abstract>Es el número de decimales escritos en el fichero de salida; por defecto vale 3.</ows:Abstract>
			<LiteralData>
			<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:AnyValue/>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ESCALAT_Z</ows:Identifier>
				<ows:Title>ESCALAT_Z</ows:Title>
				<ows:Abstract>Es el escalado en Z cuando el fichero es un VEC 3D.
</ows:Abstract>
	<LiteralData>
	<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
		<ows:AllowedValues>
		<ows:AnyValue/>
		</ows:AllowedValues>
	</LiteralData>
			</Input>				
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DESPLAC_Z</ows:Identifier>
				<ows:Title>DESPLAC_Z</ows:Title>
				<ows:Abstract>Es el desplazamiento en Z cuando el fichero és un VEC 3D.
</ows:Abstract>
	<LiteralData>
	<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#decimal">decimal</ows:DataType>
		<ows:AllowedValues>
		<ows:AnyValue/>
		</ows:AllowedValues>
	</LiteralData>
			</Input>						
</DataInputs>
	<ProcessOutputs>	
		<Output>
				<ows:Identifier>FicheroDest</ows:Identifier>
				<ows:Title>Fichero Destino</ows:Title>
				<ows:Abstract>Es el nombre del fichero de salida reescalado. 
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
				<ComplexOutput>
					<Default>
							<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
