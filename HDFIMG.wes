<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:HDFIMG:Param1</ows:Identifier>
		<ows:Title>HDFIMG</ows:Title>
		<ows:Abstract>Permitte pedir información del fichero</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importación del formato ráster HDF"/>
		<ows:Metadata xlink:title="Abstract:Este programa permite importar ficheros de formato HDF4 al formato ráster IMG de MiraMon."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Información HDF</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerHDF</ows:Identifier>
				<ows:Title>FicheroHDF</ows:Title>
				<ows:Abstract>Es el fichero HDF a informar o importar (con extensión).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroHDF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-HDF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-HDF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>CarpetaSortida</ows:Identifier>
				<ows:Title>Carpeta Salida</ows:Title>
				<ows:Abstract>Es la carpeta, típicamente preexistente, donde se generará la nueva carpeta de salida con los ficheros producto de la importación (REL+IMG multibanda) para la opción 2 o de la petición de información (TXT) para la opción 1. Dicha nueva carpeta sigue el esquema de nombres detallado en la ayuda de la aplicación según el producto.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:CarpetaSalida"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:HDFIMG:Param2</ows:Identifier>
		<ows:Title>HDFIMG</ows:Title>
		<ows:Abstract>Permite importar ficheros de formato HDF4 al formato ráster IMG de MiraMon.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Importación HDF</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerHDF</ows:Identifier>
				<ows:Title>FicheroHDF</ows:Title>
				<ows:Abstract>Es el fichero HDF a informar o importar (con extensión).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroHDF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-HDF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-HDF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>CarpetaSortida</ows:Identifier>
				<ows:Title>Carpeta Salida</ows:Title>
				<ows:Abstract>Es la carpeta, típicamente preexistente, donde se generará la nueva carpeta de salida con los ficheros producto de la importación (REL+IMG multibanda) para la opción 2 o de la petición de información (TXT) para la opción 1. Dicha nueva carpeta sigue el esquema de nombres detallado en la ayuda de la aplicación según el producto.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:CarpetaSalida"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>