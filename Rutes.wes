<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Rutes:Param1:1</ows:Identifier>
		<ows:Title>Mínima distancia</ows:Title>
		<ows:Abstract>Esta opción calcula la distancia mínima acumulada.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Análisis de redes y determinación de la ruta óptima"/>
		<ows:Metadata xlink:title="Abstract:Este programa determina las rutas óptimas entre un conjunto de localizaciones origen y un conjunto de posibles localizaciones destino. La ruta óptima entre un par de localizaciones origen-destino será aquella que minimice el desplazamiento para ir del origen al destino, ya sea en tiempo, distancia o por un campo numérico definido por el usuario que represente cualquier otra variable que pondere el coste del desplazamiento."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 1</ows:Title>
				<ows:Abstract>Por mínima distancia acumulada.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerArcs</ows:Identifier>
				<ows:Title>Fichero arcos</ows:Title>
				<ows:Abstract>Es el nombre del fichero estructurado de arcos que contiene la red de caminos.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroArcos"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampTipusNode</ows:Identifier>
				<ows:Title>Campo tipo nodo</ows:Title>
				<ows:Abstract>Es el campo alfanumérico de la base de datos del fichero de nodos de FicheroArcos que indica si un nodo es origen (valor "O"), destino (valor "D"), o ambos casos a la vez (valor "A").</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:CampoTipoNodo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DistànciaMàxima</ows:Identifier>
				<ows:Title>Distancia máxima</ows:Title>
				<ows:Abstract>Representa el umbral máximo (en metros) para que las rutas que lo superen en longitud acumulada sean descartadas.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:DistanciaMaxima"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_LONG</ows:Identifier>
				<ows:Title>CAMP LONG</ows:Title>
				<ows:Abstract>Indica el campo de la base de datos de FicheroArcos que contiene las longitudes de cada arco utilizadas en vez de los valores topológicos que figuran por defecto en la base de datos.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_VINCULAR</ows:Identifier>
				<ows:Title>NO_VINCULAR</ows:Title>
				<ows:Abstract>Este parámetro elimina el comportamiento por defecto de vincular la tabla DBF resultado a la base de datos asociada del fichero de nodos origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>BDResultats</ows:Identifier>
				<ows:Title>BD resultados</ows:Title>
				<ows:Abstract>Es el nombre del fichero DBF que establece las relaciones entre nodos origen y destino y recoge los valores acumulados de distancia y/o tiempo.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BDResultados"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Rutes:Param1:2</ows:Identifier>
		<ows:Title>Tiempo acumulado</ows:Title>
		<ows:Abstract>Esta opción calcula el mínimo tiempo acumulado.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 2</ows:Title>
				<ows:Abstract>Por mínimo tiempo acumulado.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerArcs</ows:Identifier>
				<ows:Title>Fichero arcos</ows:Title>
				<ows:Abstract>Es el nombre del fichero estructurado de arcos que contiene la red de caminos.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroArcos"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampTipusNode</ows:Identifier>
				<ows:Title>Campo tipo nodo</ows:Title>
				<ows:Abstract>Es el campo alfanumérico de la base de datos del fichero de nodos de FicheroArcos que indica si un nodo es origen (valor "O"), destino (valor "D"), o ambos casos a la vez (valor "A").</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:CampoTipoNodo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TempsMàxim</ows:Identifier>
				<ows:Title>Tiempo máximo</ows:Title>
				<ows:Abstract>Representa el umbral máximo (en las mismas unidades temporales del CampoTiempo) para que las rutas que superen este tiempo de recorrido sean descartadas,</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:TiempoMaximo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampTemps</ows:Identifier>
				<ows:Title>Campo tiempo</ows:Title>
				<ows:Abstract>Es el campo de la base de datos de FicheroArcos que contiene los tiempos de recorrido asociados a cada arco. Los valores deben definirse en segundos, minutos o en horas.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:CampoTiempo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_VINCULAR</ows:Identifier>
				<ows:Title>NO_VINCULAR</ows:Title>
				<ows:Abstract>Este parámetro elimina el comportamiento por defecto de vincular la tabla DBF resultado a la base de datos asociada del fichero de nodos origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>BDResultats</ows:Identifier>
				<ows:Title>BD resultados</ows:Title>
				<ows:Abstract>Es el nombre del fichero DBF que establece las relaciones entre nodos origen y destino y recoge los valores acumulados de distancia y/o tiempo.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BDResultados"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Rutes:Param1:3</ows:Identifier>
		<ows:Title>Mínimo tiempo (longitud/velocidad)</ows:Title>
		<ows:Abstract>Esta opción calcula el mínimo tiempo acumulado a partir de longitud y velocidad de cada arco.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 3</ows:Title>
				<ows:Abstract>Por mínimo tiempo acumulado, cada tramo se obtiene como cociente entre longitud y velocidad.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerArcs</ows:Identifier>
				<ows:Title>Fichero arcos</ows:Title>
				<ows:Abstract>Es el nombre del fichero estructurado de arcos que contiene la red de caminos.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroArcos"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampTipusNode</ows:Identifier>
				<ows:Title>Campo tipo nodo</ows:Title>
				<ows:Abstract>Es el campo alfanumérico de la base de datos del fichero de nodos de FicheroArcos que indica si un nodo es origen (valor "O"), destino (valor "D"), o ambos casos a la vez (valor "A").</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:CampoTipoNodo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DistànciaMàxima</ows:Identifier>
				<ows:Title>Distancia máxima</ows:Title>
				<ows:Abstract>Representa el umbral máximo (en metros) para que las rutas que lo superen en longitud acumulada sean descartadas.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:DistanciaMaxima"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampVelocitat</ows:Identifier>
				<ows:Title>Campo velocidad</ows:Title>
				<ows:Abstract>Es el campo de la base de datos de FicheroArcos que contiene las velocidades asociadas a cada arco, necesarias para calcular el tiempo de recorrido de cada ruta. Las unidades de tiempo deben definirse en segundos, minutos o en horas.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:CampoVelocidad"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_LONG</ows:Identifier>
				<ows:Title>CAMP LONG</ows:Title>
				<ows:Abstract>Indica el campo de la base de datos de FicheroArcos que contiene las longitudes de cada arco utilizadas en vez de los valores topológicos que figuran por defecto en la base de datos.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MAX_TEMPS</ows:Identifier>
				<ows:Title>MAX_TEMPS</ows:Title>
				<ows:Abstract>Si se especifica, representa el umbral máximo (en las mismas unidades temporales que CampoVelocidad) para que las rutas que lo superen en tiempo de recorrido sean descartadas.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_VINCULAR</ows:Identifier>
				<ows:Title>NO_VINCULAR</ows:Title>
				<ows:Abstract>Este parámetro elimina el comportamiento por defecto de vincular la tabla DBF resultado a la base de datos asociada del fichero de nodos origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>BDResultats</ows:Identifier>
				<ows:Title>BD resultados</ows:Title>
				<ows:Abstract>Es el nombre del fichero DBF que establece las relaciones entre nodos origen y destino y recoge los valores acumulados de distancia y/o tiempo.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BDResultados"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Rutes:Param1:4</ows:Identifier>
		<ows:Title>Mínimo coste acumulado</ows:Title>
		<ows:Abstract>Esta opción calcula el mínimo coste acumulado según un campo de esfuerzo de desplazamiento.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción 4</ows:Title>
				<ows:Abstract>Por mínimo coste acumulado, el coste queda definido por el usuario por un campo que mide el esfuerzo del desplazamiento.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>4</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerArcs</ows:Identifier>
				<ows:Title>Fichero arcos</ows:Title>
				<ows:Abstract>Es el nombre del fichero estructurado de arcos que contiene la red de caminos.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroArcos"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampTipusNode</ows:Identifier>
				<ows:Title>Campo tipo nodo</ows:Title>
				<ows:Abstract>Es el campo alfanumérico de la base de datos del fichero de nodos de FicheroArcos que indica si un nodo es origen (valor "O"), destino (valor "D"), o ambos casos a la vez (valor "A").</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:CampoTipoNodo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CostMàxim</ows:Identifier>
				<ows:Title>Coste máximo</ows:Title>
				<ows:Abstract>Representa el umbral máximo para que las rutas que superen este coste acumulado sean descartadas.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:CosteMaximo"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampCost</ows:Identifier>
				<ows:Title>Campo coste</ows:Title>
				<ows:Abstract>Es el campo de la base de datos de FicheroArcos que se utilizará para calcular el coste de cada ruta. No es necesario que el campo tenga una unidad de medida asociada.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:CampoCoste"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_VINCULAR</ows:Identifier>
				<ows:Title>NO_VINCULAR</ows:Title>
				<ows:Abstract>Este parámetro elimina el comportamiento por defecto de vincular la tabla DBF resultado a la base de datos asociada del fichero de nodos origen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>BDResultats</ows:Identifier>
				<ows:Title>BD resultados</ows:Title>
				<ows:Abstract>Es el nombre del fichero DBF que establece las relaciones entre nodos origen y destino y recoge los valores acumulados de distancia y/o tiempo.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BDResultados"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>