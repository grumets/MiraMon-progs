<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:EstdCamp</ows:Identifier>
		<ows:Title>Statistics of a table field or database query</ows:Title>
		<ows:Abstract>This module does statistical calculations on a table field. This can be any physical table or query such as the associated with a graphic layer from its corresponding REL file, and it can also be an individual DBF table or a table or SQL query via ODBC of a MDB, Oracle, etc, database.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Statistics of a table field or database query"/>
		<ows:Metadata xlink:title="Abstract:This module does statistical calculations on a table field. This can be any physical table or query such as the associated with a graphic layer from its corresponding REL file, and it can also be an individual DBF table or a table or SQL query via ODBC of a MDB, Oracle, etc, database."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigen</ows:Identifier>
				<ows:Title>Input File</ows:Title>
				<ows:Abstract>File REL, DBF, DSN or MDB from which we will define the statistics of one of its fields.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:InputFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-msaccess</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampImplicat</ows:Identifier>
				<ows:Title>Field Consulted</ows:Title>
				<ows:Abstract>IThis shows the name of the field (or index for a rel versions previous to version 4) in which the statistical calculation is made.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FieldConsulted"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">String</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Tractament</ows:Identifier>
				<ows:Title>Treatment</ows:Title>
				<ows:Abstract><![CDATA[This shows the type of treatement that is done to the field consulted:</li><li>C for a categorical treatement.</li><li>N for a quantitative treatement.</li><li>X default treatment.</li><li>M treatment documented in metadata.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Treatment"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">String</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>N</ows:Value>
						<ows:Value>C</ows:Value>
						<ows:Value>M</ows:Value>
						<ows:Value>X</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>X</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_REG_TOTALS</ows:Identifier>
				<ows:Title>Entire number of records</ows:Title>
				<ows:Abstract>This indicates that you want to know the entire number of records (it includes empty, white and NODATA records).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_REG_DADES</ows:Identifier>
				<ows:Title>Number of records</ows:Title>
				<ows:Abstract>This indicates that you want to know the number of records with data (it does not include empty, white and NODATA records).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MODA</ows:Identifier>
				<ows:Title>Moda</ows:Title>
				<ows:Abstract>This indicates that you want to calculate the mode for a categorical field.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PRCNT_MODA</ows:Identifier>
				<ows:Title>Percentage of occurrence </ows:Title>
				<ows:Abstract>This indicates that you want to know the percentage of occurrence of the modal value in a categorical treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>I_SHAN</ows:Identifier>
				<ows:Title>Shannon index</ows:Title>
				<ows:Abstract>This indicates that you want to know the Shannon's index calculations in a categorical treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MITJANA</ows:Identifier>
				<ows:Title>Medium</ows:Title>
				<ows:Abstract>This indicates that you want to calculate de medium in a quantitative treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESV_STD</ows:Identifier>
				<ows:Title>Standard deviation</ows:Title>
				<ows:Abstract> This indicates that you want to calculate the standard deviation in a quantitative treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VAR</ows:Identifier>
				<ows:Title>Variance</ows:Title>
				<ows:Abstract>This indicates that you want to calculate the variance in a quantitative treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SUMA</ows:Identifier>
				<ows:Title>Suma</ows:Title>
				<ows:Abstract>This indicates that you want to know the sum of all the values in a quantitative treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MIN</ows:Identifier>
				<ows:Title>Minimum value</ows:Title>
				<ows:Abstract>This indicates that you want to know the minimum value of a quantitative treatment, or the first value in alphabetical ascending order for the categorical treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MAX</ows:Identifier>
				<ows:Title>Maximum value</ows:Title>
				<ows:Abstract>This indicates that you want to know the maximum value of a quantitative treatment, or the last value in alphabetical ascending order for the categorical treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PRCNT_GRUP</ows:Identifier>
				<ows:Title>PGroup percentage</ows:Title>
				<ows:Abstract>This indicates that you want to know the number of values of an element of the projection in relation to the total values. In this calculation NODATA are not included.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PRCNT_GRUP_NODATA</ows:Identifier>
				<ows:Title>Percentage all</ows:Title>
				<ows:Abstract>This indicates that you want to know the percentage of the value from all the values of the projection. In this calculation NODATA are included.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RANG</ows:Identifier>
				<ows:Title>Range</ows:Title>
				<ows:Abstract>This indicates that you want to know the range in a quantitative treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MEDIANA</ows:Identifier>
				<ows:Title>Median</ows:Title>
				<ows:Abstract>This indicates that you want to know the median in a quantitative treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESV_MEDIANA</ows:Identifier>
				<ows:Title>Average absolute deviation about the median</ows:Title>
				<ows:Abstract>This indicates that you want to know the average absolute deviation about the median in a quantitative treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>1Q</ows:Identifier>
				<ows:Title>First quartile</ows:Title>
				<ows:Abstract>This indicates that you want to know the first quartile in a quantitative treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>3Q</ows:Identifier>
				<ows:Title>Third quartile</ows:Title>
				<ows:Abstract>This indicates that you want to know the third quartile in a quantitative treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PERCENTIL</ows:Identifier>
				<ows:Title>Percentile</ows:Title>
				<ows:Abstract>This indicates that you want to know the indicated percentile in a quantitative treatment. The percentile must be a value between 0 and 100.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PERC_SIM</ows:Identifier>
				<ows:Title>Symmetric percentile</ows:Title>
				<ows:Abstract>This indicates that you want to know the indicated symmetric percentile in a quantitative treatment. The percentile must be a value between 0 and 100.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MEDIANA_EMPAT</ows:Identifier>
				<ows:Title>Decision for the median</ows:Title>
				<ows:Abstract><![CDATA[This inticates the decision for the median: <li> 1 to choose alternate value. </li> <li> 2 to choose lower value. </li> <li> 3 to choose higher value. </ Li > <li> 4 to choose average of the central values. </li> </ul> It will only be applied if the median, the mean of the absolute deviations from the median, the 1st or 3rd quartile or percentiles are selected.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SQL</ows:Identifier>
				<ows:Title>SQL</ows:Title>
				<ows:Abstract>When the input file is MDB or DSN (via ODBC), this indicates the sentence in SQL language from which the different statistics will be calculated.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TABLE</ows:Identifier>
				<ows:Title>Table</ows:Title>
				<ows:Abstract>When the input file is MDB or DSN (via ODBC), this indicates the table of the corresponding data base to which the field, on which the statistical calculations will be done, belongs.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RELACIO_1_A_1</ows:Identifier>
				<ows:Title>Non-multiple relation</ows:Title>
				<ows:Abstract>This forces a non-multiple relation between the main table and the associated table. In its absence this limitation disappears and the multiple relation 1 to N is accepted.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TOTS_REG_PRAL</ows:Identifier>
				<ows:Title>ALL registers</ows:Title>
				<ows:Abstract> In the relations of the main table with the associated table, this indicates that the records that have no correspondence must also be included. In its absence there will only be those records that have correspondence across the established relations.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>AMB_ID_GRAFIC_0</ows:Identifier>
				<ows:Title>Graphic identifier</ows:Title>
				<ows:Abstract>In the case of a base of a polygon vector, this indicates the exceptional case of considering the attributes of the universal polygon or zero graphic identifier. Its absence implies excluding the records of the zero polygon zero in the statistical calculations.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>COND#_CAMP</ows:Identifier>
				<ows:Title>Field of Condition #</ows:Title>
				<ows:Abstract>Field name of # condition of selection. It may be made up to 100 simple queries and 100 field names starting at index 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>COND#_OP</ows:Identifier>
				<ows:Title>Operation of condition #</ows:Title>
				<ows:Abstract>Opertation of # condition of selection. It may be made up to 100 simple queries and 100 operations (COND#_OP) starting at index 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>EQ</ows:Value>
						<ows:Value>NO_EQ</ows:Value>
						<ows:Value>LT</ows:Value>
						<ows:Value>GT</ows:Value>
						<ows:Value>LT_EQ</ows:Value>
						<ows:Value>GT_EQ</ows:Value>
						<ows:Value>INTERVAL</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>COND#_VALOR</ows:Identifier>
				<ows:Title>Value of condition #</ows:Title>
				<ows:Abstract>Value of # condition of selection. It may be made up to 100 simple queries and 100 values (COND#_VALOR) starting at index 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="99">
				<ows:Identifier>COND#_NEXE</ows:Identifier>
				<ows:Title>Nexus linking of condition #</ows:Title>
				<ows:Abstract>Nexus use to linking for the successive selections. In this case to linking between condition # and condition #+1. It may be made up to 100 simple queries and 99 nexus (COND#_NEXE) starting at index 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>AND</ows:Value>
						<ows:Value>OR</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="99">
				<ows:Identifier>COND#_PRIOR</ows:Identifier>
				<ows:Title>Priority of nexus linking of condition #</ows:Title>
				<ows:Abstract>Priority of nexus use to linking for the successive selections. In this case to linking between condition # and condition #+1. It may be made up to 100 simple queries and 99 priorities (COND#_PRIOR) starting at index 1. This is an optional parameter. If it is not indicated the priority is just the order.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>1</ows:MinimumValue>
							<ows:MaximumValue>99</ows:MaximumValue>
						</ows:Range>
						<ows:Value/>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Stdout</ows:Identifier>
				<ows:Title>Standard out</ows:Title>
				<ows:Abstract>The result consists of a list with the descriptors and values of the chosen statistics that will be visualized directly in the results window of the graphic version of the application (WEstdCam) or in the command window of the console. The results can be copied from the results window of WEstdCam into the clipboard by means of the options of the mouse's secondary menu (right button).</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
