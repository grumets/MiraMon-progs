<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:EstdCamp</ows:Identifier>
		<ows:Title>Statistics of a table field or database query</ows:Title>
		<ows:Abstract>This module does statistical calculations on a table field. This can be any physical table or query such as the associated with a graphic layer from its corresponding REL file, and it can also be an individual DBF table or a table or SQL query via ODBC of a MDB, Oracle, etc, database.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Statistics of a table field or database query"/>
		<ows:Metadata xlink:title="Abstract:This module does statistical calculations on a table field. This can be any physical table or query such as the associated with a graphic layer from its corresponding REL file, and it can also be an individual DBF table or a table or SQL query via ODBC of a MDB, Oracle, etc, database."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigen</ows:Identifier>
				<ows:Title>Input file</ows:Title>
				<ows:Abstract>REL, DBF, DSN or MDB file from which the statistics of one of its fields will be defined.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:InputFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-rel</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/octet-stream</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-msaccess</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampImplicat</ows:Identifier>
				<ows:Title>Implied field</ows:Title>
				<ows:Abstract>Indicates the name of the field when there is no .rel from the table or when the .rel is from a version equal to or later than 4 (or for versions of .rel prior to 4, the index numbered from 0 must be indicated) on which statistical calculations are performed.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FieldConsulted"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Tractament</ows:Identifier>
				<ows:Title>Treatment</ows:Title>
				<ows:Abstract><![CDATA[Type of treatment that is done to the consulted field:</li><li>C for a categorical treatment.</li><li>N for a quantitative treatment.</li><li>X means treatment by default (quantitative treatment for numerical fields and categorical for the rest).</li><li>for the treatment documented in metadata (or by default as X if nothing is indicated).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Treatment"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>N</ows:Value>
						<ows:Value>C</ows:Value>
						<ows:Value>M</ows:Value>
						<ows:Value>X</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>X</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_REG_TOTALS</ows:Identifier>
				<ows:Title>Entire number of records</ows:Title>
				<ows:Abstract>This indicates that the entire number of records will be shown (it includes empty, white and NoData records).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_REG_DADES</ows:Identifier>
				<ows:Title>Number of records</ows:Title>
				<ows:Abstract>This indicates that the number of records with data will be shown (it does not include empty, white and NoData records).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MODA</ows:Identifier>
				<ows:Title>Mode</ows:Title>
				<ows:Abstract>This indicates that the mode will be calculated for a categorical field.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PRCNT_MODA</ows:Identifier>
				<ows:Title>Percentage of occurrence</ows:Title>
				<ows:Abstract>This indicates that the percentage of occurrence of the modal value will be calculated in a categorical treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>I_SHAN</ows:Identifier>
				<ows:Title>Shannon index</ows:Title>
				<ows:Abstract>This indicates that the Shannon's index calculations will be done in a categorical treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MITJANA</ows:Identifier>
				<ows:Title>Medium</ows:Title>
				<ows:Abstract>This indicates that the medium will be calculated in a quantitative treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESV_STD</ows:Identifier>
				<ows:Title>Standard deviation</ows:Title>
				<ows:Abstract>This indicates that the standard deviation will be calculated in a quantitative treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VAR</ows:Identifier>
				<ows:Title>Variance</ows:Title>
				<ows:Abstract>This indicates that you want to calculate the variance in a quantitative treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SUMA</ows:Identifier>
				<ows:Title>Sum</ows:Title>
				<ows:Abstract>This indicates that the sum of all the values will be calculated in a quantitative treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MIN</ows:Identifier>
				<ows:Title>Minimum value</ows:Title>
				<ows:Abstract>This indicates that the minimum value of a quantitative treatment, or the first value in alphabetical ascending order for the categorical treatment will be shown.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MAX</ows:Identifier>
				<ows:Title>Maximum value</ows:Title>
				<ows:Abstract>This indicates that the maximum value of a quantitative treatment, or the last value in alphabetical ascending order for the categorical treatment will be shown.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PRCNT_GRUP</ows:Identifier>
				<ows:Title>Number of values of an element</ows:Title>
				<ows:Abstract><![CDATA[This indicates that the number of values of an element of the projection (<i>select distinct</i>) in relation to the total values will be calculated. In this calculation NoData are not included.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PRCNT_GRUP_NODATA</ows:Identifier>
				<ows:Title>Percentage of the value from the total values</ows:Title>
				<ows:Abstract>This indicates that the percentage of the value from the total values of the projection will be calculated. In this calculation NoData are included.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RANG</ows:Identifier>
				<ows:Title>Range</ows:Title>
				<ows:Abstract>This indicates that you want to know the range in a quantitative treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MEDIANA</ows:Identifier>
				<ows:Title>Median</ows:Title>
				<ows:Abstract>This indicates that you want to know the median in a quantitative treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DESV_MEDIANA</ows:Identifier>
				<ows:Title>Average absolute deviation about the median</ows:Title>
				<ows:Abstract>This indicates that you want to know the average absolute deviation about the median in a quantitative treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>1Q</ows:Identifier>
				<ows:Title>First quartile</ows:Title>
				<ows:Abstract>This indicates that you want to know the first quartile in a quantitative treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>3Q</ows:Identifier>
				<ows:Title>Third quartile</ows:Title>
				<ows:Abstract>This indicates that you want to know the third quartile in a quantitative treatment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PERCENTIL</ows:Identifier>
				<ows:Title>Percentile</ows:Title>
				<ows:Abstract>This indicates that you want to know the indicated percentile in a quantitative treatment. The percentile must be a value between 0 and 100.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PERC_SIM</ows:Identifier>
				<ows:Title>Symmetric percentile</ows:Title>
				<ows:Abstract>This indicates that you want to know the indicated symmetric percentile in a quantitative treatment. The percentile must be a value between 0 and 100.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MEDIANA_EMPAT</ows:Identifier>
				<ows:Title>Decision for the median</ows:Title>
				<ows:Abstract><![CDATA[If the calculation of the median has been requested, indicate the type of tiebreaker to be used for its calculation, in case of having an even number of values. The criterion will also be applied when the mean of the absolutes deviations with respect to the median must be calculated (since it requires calculating the median), or some quartile or percentile (in which tie situations can occur). The calculation options are:<ul><li> 1 to choose alternate value. </li> <li> 2 to choose lower value. </li> <li> 3 to choose upper value. </ Li > <li> 4 to choose average of the central values. </li> </ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SQL</ows:Identifier>
				<ows:Title>SQL</ows:Title>
				<ows:Abstract>When the input file is an MDB or DSN (via ODBC), this indicates the sentence in SQL language from which the different statistics will be calculated.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TAULA</ows:Identifier>
				<ows:Title>Table</ows:Title>
				<ows:Abstract>When the input file is an MDB or DSN (via ODBC), this indicates the table of the corresponding data base to which the field, on which the statistical calculations will be done, belongs.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RELACIO_1_A_1</ows:Identifier>
				<ows:Title>Non-multiple relation</ows:Title>
				<ows:Abstract>This forces a non-multiple relation between the main table and the associated table. In its absence this limitation disappears and the multiple relation 1 to N is accepted.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TOTS_REG_PRAL</ows:Identifier>
				<ows:Title>All registers</ows:Title>
				<ows:Abstract>In the relations of the main table with the associated table, this indicates that the records of the main table that have no correspondence in the associated table or tables must also be included. In its absence there will only be those records that have correspondence across the established relations.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>AMB_ID_GRAFIC_0</ows:Identifier>
				<ows:Title>Graphic identifier</ows:Title>
				<ows:Abstract>In the case of a base of a polygon vector, this indicates the exceptional case of considering the attributes of the universal polygon or zero graphic identifier. Its absence implies excluding the records of the zero polygon in the statistical calculations.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>COND#_CAMP</ows:Identifier>
				<ows:Title>Field of condition #</ows:Title>
				<ows:Abstract>Field name of # condition of selection. It may be made up to 100 simple queries and 100 field names (COND#_CAMP) starting at index 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>COND#_OP</ows:Identifier>
				<ows:Title>Operator of condition #</ows:Title>
				<ows:Abstract>Operator to use in the # condition of selection. It may be made up to 100 simple queries and 100 operations (COND#_OP) starting at index 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>EQ</ows:Value>
						<ows:Value>NO_EQ</ows:Value>
						<ows:Value>LT</ows:Value>
						<ows:Value>GT</ows:Value>
						<ows:Value>LT_EQ</ows:Value>
						<ows:Value>GT_EQ</ows:Value>
						<ows:Value>INTERVAL</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>COND#_VALOR</ows:Identifier>
				<ows:Title>Value of condition #</ows:Title>
				<ows:Abstract>Value to use in the # condition of selection. It may be made up to 100 simple queries and 100 values (COND#_VALOR) starting at index 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="99">
				<ows:Identifier>COND#_NEXE</ows:Identifier>
				<ows:Title>Nexus linking of condition #</ows:Title>
				<ows:Abstract>Nexus to use to link the successive selections. In this case to link condition # and condition #+1. It may be made up to 100 simple queries and 99 nexus (COND#_NEXE) starting at index 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>AND</ows:Value>
						<ows:Value>OR</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="99">
				<ows:Identifier>COND#_PRIOR</ows:Identifier>
				<ows:Title>Priority of nexus linking of condition #</ows:Title>
				<ows:Abstract>Priority of nexus to use to linking for the successive selections. In this case to linking between condition # and condition #+1. It may be made up to 100 simple queries and 99 priorities (COND#_PRIOR) starting at index 1. This is an optional parameter. If it is not indicated the priority is just the order.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>1</ows:MinimumValue>
							<ows:MaximumValue>99</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>INI</ows:Identifier>
				<ows:Title>Temporary output text file</ows:Title>
				<ows:Abstract>Temporary text file in which all the descriptors and values of the selected statistics are written to be displayed directly in the results window of the graphical version of the application (wEstdCam) or in the command line window. The results obtained can be copied to the clipboard, from the results window itself, from the different menu options  of the right mouse button.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>