<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:KMLMM:1</ows:Identifier>
		<ows:Title>Import from KML to MM</ows:Title>
		<ows:Abstract>Converts a GoogleEarth KML file into MiraMon Maps which contain layers in MiraMon structured format (PNT, ARC/NOD and POL).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Import and export between KML and MiraMon format"/>
		<ows:Metadata xlink:title="Abstract:This application converts a GoogleEarth KML file into MiraMon Maps which contain layers in MiraMon structured format (PNT, ARC/NOD and POL)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Importation to MiraMon format (without topological structuring).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMM</ows:Identifier>
				<ows:Title>MM File</ows:Title>
				<ows:Abstract>MiraMon map (.mmm) or vector (.pol, .arc, .pnt or .vec) file.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:MMFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerKML</ows:Identifier>
				<ows:Title>KMLFile</ows:Title>
				<ows:Abstract>Is the name of the KML file, with .kml extension.</ows:Abstract>
				<ows:Metadata xlink:title="Name:KMLFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/vnd.google-earth.kml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/vnd.google-earth.kml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>ReferenceSystem</ows:Title>
				<ows:Abstract>Identifier of the reference system in which you wish to reproject the layers. Its default value is 'lat/long-WGS84'.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:KMLMM:2</ows:Identifier>
		<ows:Title>Export from MM to KML</ows:Title>
		<ows:Abstract>Convert a MiraMon Map file or a MiraMon vector file (PNT, ARC, POL or VEC) to a KML file.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMM</ows:Identifier>
				<ows:Title>MMMFile</ows:Title>
				<ows:Abstract>Is the name, with .mmm extension, of the output file. The program creates a directory with the same name as the map, and the same level where it saves the map layers using the following nomenclature: PNT_KMLMM, ARC_KMLMM and POL_KMLMM.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-MMM</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-MMM</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMM</ows:Identifier>
				<ows:Title>MM File</ows:Title>
				<ows:Abstract>MiraMon map (.mmm) or vector (.pol, .arc, .pnt or .vec) file.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:MMFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerKML</ows:Identifier>
				<ows:Title>KMLFile</ows:Title>
				<ows:Abstract>Is the name of the KML file, with .kml extension.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:KMLFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/vnd.google-earth.kml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/vnd.google-earth.kml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>