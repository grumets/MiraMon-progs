<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:KMLMM:1</ows:Identifier>
		<ows:Title>KMLMM</ows:Title>
		<ows:Abstract>This program converts a GoogleEarth KML file into MiraMon Maps which contain layers in MiraMon structured format (PNT, ARC/NOD and POL). </ows:Abstract>
<ows:Metadata xlink:title="Title:Conversion of KML files to MiraMon Maps"/>
<ows:Metadata xlink:title="Abstract:This program converts a GoogleEarth KML file into MiraMon Maps which contain layers in MiraMon structured format (PNT, ARC/NOD and POL)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Option</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>1. Importation to MiraMon format (without topological structuring).</ows:Abstract>
			<ows:Metadata xlink:title="Param1" />
		<LiteralData>
			<ows:AllowedValues><ows:Value>1</ows:Value></ows:AllowedValues>
		</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>KMLfile</ows:Identifier>
				<ows:Title>KML file</ows:Title>
				<ows:Abstract>Is the name of the KML file to be imported, with .kml extension.
</ows:Abstract>
			<ows:Metadata xlink:title="Param2" />
		<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-KML</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
					<MimeType>application/x-KML</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>				
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Reference Systems</ows:Title>
				<ows:Abstract>Identifier of the reference system in which you wish to reproject the layers. Its default value is 'lat/long-WGS84'.
</ows:Abstract>
		<LiteralData>
			<ows:AnyValue/>
		</LiteralData>
			</Input>				
		</DataInputs>
		<ProcessOutputs>	
	      	<Output>
				<ows:Identifier>FitxerMMM</ows:Identifier>
				<ows:Title>Fitxer MMM</ows:Title>
				<ows:Abstract>Is the name, with .mmm extension, of the output file. The program creates a directory with the same name as the map, and the same level where it saves the map layers using the following nomenclature: PNT_KMLMM, ARC_KMLMM and POL_KMLMM.
				</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
						<MimeType>application/x-MMM</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Default>
					<Supported>
						<Format>
						<MimeType>application/x-MMM</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
