<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
		<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:IdrMM:1</ows:Identifier>
		<ows:Title>IdrMM</ows:Title>
		<ows:Abstract>Esta aplicación transforma archivos rAster entre MiraMon e Idrisi-32.</ows:Abstract>
<ows:Metadata xlink:title="Title:Transformación de archivos rAster entre los formatos Idrisi-32 y MiraMon."/>
<ows:Metadata xlink:title="Abstract:Esta aplicación transforma archivos rAster entre MiraMon e Idrisi-32."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcion</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract><![CDATA[<li>1: Exportación de MiraMon (ArchivoOrigen ) a Idrisi-32 (FitxerDestino). Los parámetros opcionales de esta opción son: <ul><li>/LONG_SHORT</li><li>/LONG_REAL</li></ul>2: Importación desde Idrisi-32 (ArchivoOrigen) a MiraMon (ArchivoDestino). Este caso no tiene parámetros opcionales.</li><li>3: Exportación de imágenes JPEG (ArchivoOrigen) a archivos RGB de Idrisi-32 (ArchivoDestino). Si la imagen origen está georreferenciada (J.rel), se genera un RST georreferenciado. Este caso no tiene parámetros opcionales.</li>]]>
</ows:Abstract>
			<ows:Metadata xlink:title="Param1" />
			<LiteralData>
				<ows:AllowedValues>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
				<ows:Value>1</ows:Value>
				<ows:Value>2</ows:Value>
				<ows:Value>3</ows:Value>
				</ows:AllowedValues>
			</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ArchivoOrigen</ows:Identifier>
				<ows:Title>Archivo Origen</ows:Title>
				<ows:Abstract>Es el fichero a importar
</ows:Abstract>
			<ows:Metadata xlink:title="Param2" />
			<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
					<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>		
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>LONG_SHORT</ows:Identifier>
				<ows:Title>Datos tipos integer</ows:Title>
				<ows:Abstract>Realiza una exportación de datos de origen tipo long a datos en destino tipo integer.
</ows:Abstract>
				<LiteralData>
				<ows:AllowedValues>
<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>	
				<ows:Value>##blank##</ows:Value></ows:AllowedValues>
			</LiteralData>
			</Input>	
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>LONG_REAL</ows:Identifier>
				<ows:Title>Datos tipos real</ows:Title>
				<ows:Abstract>Realiza una exportación de datos origen tipo long a datos  destino tipo real.
</ows:Abstract>
			<LiteralData>
				<ows:AllowedValues>
<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
				<ows:Value>##blank##</ows:Value></ows:AllowedValues>
			</LiteralData>
			</Input>		
		</DataInputs>
		<ProcessOutputs>	
			<Output>
				<ows:Identifier>ArchivoDestino</ows:Identifier>
				<ows:Title>ArchivoDestino</ows:Title>
				<ows:Abstract>Es el fichero a importar
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
				<ComplexOutput>
					<Default>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Default>
					<Supported>
						<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
