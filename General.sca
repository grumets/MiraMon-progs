/*Taules_simbol_s_han_tenir_camps,    "Les taules de simbolització per a %s han de tenir com a mínim els següents camps:\n\n* \"CLAUSIMBOL\" (camp clau d'enllaç) tipus 'C' o 'N'\n      (o bé \"MIN_SIMBOL\" i \"MAX_SIMBOL\" per a\n      camps 'N' que indiquin interval numèric)\n\n"*/
Taules_simbol_s_han_tenir_camps,    "Les taules de simbolització per a %s han de tenir com a mínim els següents camps:\n\n* \"CLAUSIMBOL\" (camp clau d'enllaç) tipus 'C' o 'N'\n\n"
Taules_colors_han_tenir_camps,      "* \"R_COLOR\", \"G_COLOR\" i \"B_COLOR\" (intensitats\n      Red,Green,Blue en l'interval [0,255]) tipus 'N'\n\n* \"DESCRIPCIO\" (descripció a usar a la llegenda) tipus 'C'\n      (optatiu)"
Taules_trames_han_tenir_camps,      "* \"TIPUSTRAMA\" (exemples vàlids\n      \"-\",\"/\",\"|\",\"\\\",\"+\",\"X\",\"\") tipus 'C'\n\n* \"DESCRIPCIO\" (descripció a usar a la llegenda) tipus 'C'\n      (optatiu)"
Taules_patrons_han_tenir_camps,     "* \"FI_PATR\" (nom del fitxer de cada patró, típicament en format BMP) tipus 'C'\n\n* \"DESCRIPCIO\" (descripció a usar a la llegenda) tipus 'C'\n      (optatiu)"
Taules_simbols_han_tenir_camps,     "* \"FI_SIMBOL\" (nom del fitxer de cada símbol) tipus 'C'\n\n* \"DESCRIPCIO\" (descripció a usar a la llegenda) tipus 'C'\n      (optatiu)"
Taules_fonts_han_tenir_camps,       "* \"FONT\" (Descripció de la font, per exemple \"/NArial/H8/B/I/C0,0,255/K255,255,0/h\") tipus 'C'\n\n* \"TEXT_FONT\" (text tipus a usar a la llegenda) tipus 'C'\n\n* \"DESCRIPCIO\" (descripció a usar a la llegenda) tipus 'C'"
Taules_lin_comb_han_tenir_camps,    "* \"LIN_COMBIN\" (Descripció de la línia combinada, per exemple \"/M/KA;/H25/C0,255,255;/N3/H7.5/C255,255,255\") tipus 'C'\n\n* \"DESCRIPCIO\" (descripció a usar a la llegenda) tipus 'C'\n      (optatiu)"

