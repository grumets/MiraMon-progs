<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Ombrejat:Param1:1</ows:Identifier>
		<ows:Title>Generating shadowed image (JPG)</ows:Title>
		<ows:Abstract>This module generates a shadowed images in JPEG format.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Generating shadowed images"/>
		<ows:Metadata xlink:title="Abstract:This module is a tool to obtain shadowed images (through light gradation) according to the relief and the position of the Sun. The localization of the Sun is determined by the elevation angles (in degrees) with respect to the horizon and the azimuth in relation to the North in clockwise sense (with 0¼ indicating the North). Specification of these angles will be required when generating the model derivations of DEM (Digital Elevation Model). These model derivations are the Digital Illumination Model, which calculates the cosine of the angle of incidence, and the Digital Shadow Model which determines the solar elevation angle from which each point of the terrain gets direct light from the Sun. These models can be pre-calculated with the corresponding applications: Illum and Ombra. In any of the cases, from the DEM, the application can generate temporarily the necessary model derivations and delete them when finished, or keep them for later usage. It has to be born in mind that the calculation of the Shadow Model can become a long process that needs large memory resources, and therefore, it is possible to not use this model. Without it, an acceptable result will be generated, although of a lower quality than when this factor is taken into consideration."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>The output is in JPEG format</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>>FitxerOrigen</ows:Identifier>
				<ows:Title>Original File</ows:Title>
				<ows:Abstract>Is the layer to be shadowed and it can be a raster in IMG format or a structured vector of polygons.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:OriginalFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Qualitat</ows:Identifier>
				<ows:Title>Quality</ows:Title>
				<ows:Abstract>Quality is a value between 5 (minimum quality and maximum degree of compression) and 95 (maximum quality an minimum degree of compression).</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Quality"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>95</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MinimaIlluminacio</ows:Identifier>
				<ows:Title>Minimum Illumination</ows:Title>
				<ows:Abstract>Corresponds to the minimum percentage to which a colour can be darkened in the HSI space. Lower values will be saturated. If an excessively low percentage is allowed, the darkened colours cannot be differentiated. A recommended generic value is 5%, but it will have to be adjusted according to each case.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:MinimumIllumination"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>5</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MaximaIlluminacio</ows:Identifier>
				<ows:Title>Maximum Illumination</ows:Title>
				<ows:Abstract>Corresponds to the maximum percentage of illumination of a colour in the  HSI space. Higher values will be saturated.  If an excessively high percentage is allowed, light colors  cannot be differentiated. A recommended generic value is 95%, but it will have to be adjusted according to each case.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:MaximumIllumination"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>95</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>IncrementIlluminacio</ows:Identifier>
				<ows:Title>Illumination Increase</ows:Title>
				<ows:Abstract>Corresponds to the level of constant increase of illumination of the entire image, to counteract globally the variable diminution of illumination due to the application of the Shadow Model and the Illumination Model. A recommended generic value is 50%, but it will have to be adjusted according to each case.</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:IlluminationIncrease"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MDE</ows:Identifier>
				<ows:Title>Digital Elevation Model</ows:Title>
				<ows:Abstract>Digital Elevation Models from which model derivations will be generated.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ILLUM_ORI</ows:Identifier>
				<ows:Title>Original Illuminations</ows:Title>
				<ows:Abstract>Digital Illumination Model previously generated.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ILLUM_DEST</ows:Identifier>
				<ows:Title>Illuminations Destini</ows:Title>
				<ows:Abstract>Names where the generated Digital Illumination Model will be kept. If it is not indicated a temporary directory will be generated and it will be deleted when finished.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OMBRA_ORI</ows:Identifier>
				<ows:Title>Original Shadow</ows:Title>
				<ows:Abstract>Digital Shadowed Model previously generated (whenever the parameter /NO_OMBRES is not activated).</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OMBRA_DEST</ows:Identifier>
				<ows:Title>shadow Destiny</ows:Title>
				<ows:Abstract>Names where the generated Digital model of shadows will be kept. If it is not indicated a temporary directory will be generated and it will be deleted when finished (whenever the parameter /NO_OMBRES is not activated).</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PAL</ows:Identifier>
				<ows:Title>Palette</ows:Title>
				<ows:Abstract>Name of the palette (p25, pal, p65) or table of symbolization (dbf) that determines the assignation of the colours of the original layer that has to be shadowed.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ELEV</ows:Identifier>
				<ows:Title>Elevation</ows:Title>
				<ows:Abstract>Angle, in degrees, of the elevation of the sun with respect to the horizon, necessary when the model derivations of DEM have to be generated.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MES_BANDA</ows:Identifier>
				<ows:Title>Add Bands</ows:Title>
				<ows:Abstract>Indicates the addition of the resulting JPG channels as bands of the original raster (it is not valid if the original file is a POL).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_OMBRES</ows:Identifier>
				<ows:Title>No shadows</ows:Title>
				<ows:Abstract>Parameter that indicates that the shadowed model cannot be used to darken to the minimum illumination the zones that do not receive direct light from the projected shadows.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>AZIMUT</ows:Identifier>
				<ows:Title>Azimut</ows:Title>
				<ows:Abstract>Angulo, en grados, respeto al Norte y en sentido horario de posición solar, necessario cuando hace falta generar los modelos derivados del MDE.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PERCENT_FOSC</ows:Identifier>
				<ows:Title>Percent obscuration</ows:Title>
				<ows:Abstract>Additional shrinkage (in percentage) of shaded areas, this obscuration is not saturated and by default 25%.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>ImatgeResultat</ows:Identifier>
				<ows:Title>Resulting Image</ows:Title>
				<ows:Abstract>Is the resulting shadowed model in raster JPG.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:ResultingImage"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Ombrejat:Param1:3</ows:Identifier>
		<ows:Title>Generating shadowed images (RGB)</ows:Title>
		<ows:Abstract>This module generates a shadowed images in RGB format.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>The output is in RGB format. So, 3 IMG files are created</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>>FitxerOrigen</ows:Identifier>
				<ows:Title>Original File</ows:Title>
				<ows:Abstract>Is the layer to be shadowed and it can be a raster in IMG format or a structured vector of polygons.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:OriginalFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Qualitat</ows:Identifier>
				<ows:Title>Quality</ows:Title>
				<ows:Abstract>Quality is a value between 5 (minimum quality and maximum degree of compression) and 95 (maximum quality an minimum degree of compression).</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Quality"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>95</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MinimaIlluminacio</ows:Identifier>
				<ows:Title>Minimum Illumination</ows:Title>
				<ows:Abstract>Corresponds to the minimum percentage to which a colour can be darkened in the HSI space. Lower values will be saturated. If an excessively low percentage is allowed, the darkened colours cannot be differentiated. A recommended generic value is 5%, but it will have to be adjusted according to each case.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:MinimumIllumination"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>5</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MaximaIlluminacio</ows:Identifier>
				<ows:Title>Maximum Illumination</ows:Title>
				<ows:Abstract>Corresponds to the maximum percentage of illumination of a colour in the  HSI space. Higher values will be saturated.  If an excessively high percentage is allowed, light colors  cannot be differentiated. A recommended generic value is 95%, but it will have to be adjusted according to each case.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:MaximumIllumination"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>95</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>IncrementIlluminacio</ows:Identifier>
				<ows:Title>Illumination Increase</ows:Title>
				<ows:Abstract>Corresponds to the level of constant increase of illumination of the entire image, to counteract globally the variable diminution of illumination due to the application of the Shadow Model and the Illumination Model. A recommended generic value is 50%, but it will have to be adjusted according to each case.</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:IlluminationIncrease"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MDE</ows:Identifier>
				<ows:Title>Digital Elevation Model</ows:Title>
				<ows:Abstract>Digital Elevation Models from which model derivations will be generated.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ILLUM_ORI</ows:Identifier>
				<ows:Title>Original Illuminations</ows:Title>
				<ows:Abstract>Digital Illumination Model previously generated.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ILLUM_DEST</ows:Identifier>
				<ows:Title>Illuminations Destini</ows:Title>
				<ows:Abstract>Names where the generated Digital Illumination Model will be kept. If it is not indicated a temporary directory will be generated and it will be deleted when finished.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OMBRA_ORI</ows:Identifier>
				<ows:Title>Original Shadow</ows:Title>
				<ows:Abstract>Digital Shadowed Model previously generated (whenever the parameter /NO_OMBRES is not activated).</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OMBRA_DEST</ows:Identifier>
				<ows:Title>shadow Destiny</ows:Title>
				<ows:Abstract>Names where the generated Digital model of shadows will be kept. If it is not indicated a temporary directory will be generated and it will be deleted when finished (whenever the parameter /NO_OMBRES is not activated).</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PAL</ows:Identifier>
				<ows:Title>Palette</ows:Title>
				<ows:Abstract>Name of the palette (p25, pal, p65) or table of symbolization (dbf) that determines the assignation of the colours of the original layer that has to be shadowed.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ELEV</ows:Identifier>
				<ows:Title>Elevation</ows:Title>
				<ows:Abstract>Angle, in degrees, of the elevation of the sun with respect to the horizon, necessary when the model derivations of DEM have to be generated.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MES_BANDA</ows:Identifier>
				<ows:Title>Add Bands</ows:Title>
				<ows:Abstract>Indicates the addition of the resulting JPG channels as bands of the original raster (it is not valid if the original file is a POL).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_OMBRES</ows:Identifier>
				<ows:Title>No shadows</ows:Title>
				<ows:Abstract>Parameter that indicates that the shadowed model cannot be used to darken to the minimum illumination the zones that do not receive direct light from the projected shadows.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>AZIMUT</ows:Identifier>
				<ows:Title>Azimut</ows:Title>
				<ows:Abstract>Angulo, en grados, respeto al Norte y en sentido horario de posición solar, necessario cuando hace falta generar los modelos derivados del MDE.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PERCENT_FOSC</ows:Identifier>
				<ows:Title>Percent obscuration</ows:Title>
				<ows:Abstract>Additional shrinkage (in percentage) of shaded areas, this obscuration is not saturated and by default 25%.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>CanalRResultat</ows:Identifier>
				<ows:Title>Red Output</ows:Title>
				<ows:Abstract>Is the red file in RGB output.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:RedOutput"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>CanalGResultat</ows:Identifier>
				<ows:Title>Green Output</ows:Title>
				<ows:Abstract>Is the green file in RGB output.</ows:Abstract>
				<ows:Metadata xlink:title="Param8"/>
				<ows:Metadata xlink:title="Name:GreenOutput"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>CanalBResultat</ows:Identifier>
				<ows:Title>Blue Output</ows:Title>
				<ows:Abstract>Is the blue file in RGB output.</ows:Abstract>
				<ows:Metadata xlink:title="Param9"/>
				<ows:Metadata xlink:title="Name:BlueOutput"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
