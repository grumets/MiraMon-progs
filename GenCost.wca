<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GenCost:Param1:1</ows:Identifier>
		<ows:Title>Aplicació del model d'anàlisi de tipus node</ows:Title>
		<ows:Abstract>La distància entre dues cel·les es calcula del centre d'una al centre de l'adjacent, i el cost té en compte la fricció de totes dues.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Anàlisi de costos mínims de desplaçament sobre un model de fricció"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació crea un ràster de costos a partir d&apos;un model de friccions (resistència al pas) i d&apos;un ràster d&apos;entitats diana a les quals es vol arribar."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 1</ows:Title>
				<ows:Abstract>La distància entre dues cel·les es calcula del centre d'una al centre de l'adjacent, i el cost té en compte la fricció de totes dues.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDianes</ows:Identifier>
				<ows:Title>Fitxer dianes</ows:Title>
				<ows:Abstract>Fitxer ràster amb la posició de les cel·les diana.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerDianes"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerFriccions</ows:Identifier>
				<ows:Title>Fitxer friccions</ows:Title>
				<ows:Abstract>Fitxer ràster amb els valors de fricció de cada cel·la.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerFriccions"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>OpcióDiana</ows:Identifier>
				<ows:Title>Opció diana</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>0: Càlcul dels costos fins l'extrem de la diana.</li><li>1: Càlcul dels costos fins al centre de la diana.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:OpcióDiana"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerCostos</ows:Identifier>
				<ows:Title>Fitxer costos</ows:Title>
				<ows:Abstract>Fitxer ràster resultat amb el valor de costos de cada cel·la.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FitxerCostos"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:GenCost:Param1:2</ows:Identifier>
		<ows:Title>Aplicació del model d'anàlisi de tipus cel·la</ows:Title>
		<ows:Abstract>La distància es calcula de l'extrem oposat a la cel·la adjacent fins a l'extrem més proper, sense tenir en compte la fricció d'aquesta cel·la.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 2</ows:Title>
				<ows:Abstract>La distància es calcula de l'extrem oposat a la cel·la adjacent fins a l'extrem més proper, sense tenir en compte la fricció d'aquesta cel·la.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
