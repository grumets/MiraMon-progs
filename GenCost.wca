<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Gencost:1</ows:Identifier>
		<ows:Title>Gencost</ows:Title>
		<ows:Abstract>Aquest mòdul crea un ràster de costos a partir d'un model de friccions (resistència al pas) i d'un ràster d'entitats diana a les quals es vol arribar.</ows:Abstract>
<ows:Metadata xlink:title="Title:Anàlisi de costos mínims de desplaçament sobre un model de fricció."/>
<ows:Metadata xlink:title="Abstract:Aquest mòdul crea un ràster de costos a partir d'un model de friccions (resistència al pas) i d'un ràster d'entitats diana a les quals es vol arribar."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract><![CDATA[<li>1. Model d'anàlisi cel·la.</li><li>2. Model d'anàlisi node.</li>]]> 
</ows:Abstract>
			<ows:Metadata xlink:title="Param1" />
				<LiteralData>
				<ows:AllowedValues>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDianes</ows:Identifier>
				<ows:Title>FitxerDianes</ows:Title>
				<ows:Abstract>Fitxer ràster amb la posició de les cel·les diana.
</ows:Abstract>
			<ows:Metadata xlink:title="Param2" />
			<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-img</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
					<MimeType>application/x-img</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>		
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerFriccions</ows:Identifier>
				<ows:Title>FitxerFriccions</ows:Title>
				<ows:Abstract>Fitxer ràster amb els valors de fricció de cada cel·la.
</ows:Abstract>
			<ows:Metadata xlink:title="Param3" />
	<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-img</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
					<MimeType>application/x-img</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>OpcióDiana </ows:Identifier>
				<ows:Title>Opció Diana </ows:Title>
				<ows:Abstract><![CDATA[<ul><li>0: Càlcul dels costos fins l'extrem de la diana.</li><li>1: Càlcul dels costos fins al centre de la diana.</li></ul>]]> 
</ows:Abstract>
			<ows:Metadata xlink:title="Param5" />
	<LiteralData>
				<ows:AllowedValues>
				<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
				<ows:Value>0</ows:Value>
				<ows:Value>1</ows:Value>
				</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
	<ProcessOutputs>	
		<Output>
				<ows:Identifier> FitxerCostos</ows:Identifier>
				<ows:Title> Fitxer Costos</ows:Title>
				<ows:Abstract>Fitxer ràster resultat amb el valor de costos de cada cel·la.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param4" />
				<ComplexOutput>
					<Default>
							<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
	</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
