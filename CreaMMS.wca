	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CreaMMS:1</ows:Identifier>
		<ows:Title>Capa de punts (opció 1)</ows:Title>
		<ows:Abstract>Prepara una capa de punts per ser visualitzada.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Preparació de capes per a la seva publicació al WMS del MiraMon"/>
		<ows:Metadata xlink:title="Abstract:Prepara nivells de zoom per al servidor de mapes (punts, ràster, vector). Detall d&apos;origen i paràmetres: plantilla d&apos;ajuda."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 1</ows:Title>
				<ows:Abstract>Prepara una capa de punts per ser visualitzada.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Directori</ows:Identifier>
				<ows:Title>Directori</ows:Title>
				<ows:Abstract>Directori del nivell de zoom.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Directori"/>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerLST</ows:Identifier>
				<ows:Title>Fitxer LST</ows:Title>
				<ows:Abstract>Llista de tessel·les generades.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerLST"/>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>costat</ows:Identifier>
				<ows:Title>Costat</ows:Title>
				<ows:Abstract>Mida de píxel del ràster.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:costat"/>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerPNT</ows:Identifier>
				<ows:Title>Fitxer PNT</ows:Title>
				<ows:Abstract>PNT origen.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:FitxerPNT"/>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TRACTAMENT</ows:Identifier>
				<ows:Title>Tractament</ows:Title>
				<ows:Abstract>S o T (símbols o textos).</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VALOR_CONSTANT</ows:Identifier>
				<ows:Title>Valor constant</ows:Title>
				<ows:Abstract>Símbol o font; no amb /CAMP.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP</ows:Identifier>
				<ows:Title>Camp</ows:Title>
				<ows:Abstract>Camp BD4; no amb /VALOR_CONSTANT.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TAULA_SIMBOLS</ows:Identifier>
				<ows:Title>Taula símbols</ows:Title>
				<ows:Abstract>dbf simbolització si no /VALOR_CONSTANT.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_TEXT_MOSTRAR</ows:Identifier>
				<ows:Title>Camp text</ows:Title>
				<ows:Abstract>Textos si tractament T.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
