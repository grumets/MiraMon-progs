<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:RasTop:1</ows:Identifier>
		<ows:Title>Vectorització de ràsters categòrics</ows:Title>
		<ows:Abstract>Aquest programa realitza la vectorització d'un o diversos fitxers ràster amb contingut categòric (mapes de cobertes del sòl, d'unitats geològiques, etc) a un fitxer topològic de polígons.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Vectorització de ràsters categòrics"/>
		<ows:Metadata xlink:title="Abstract:Aquest programa realitza la vectorització d&apos;un o diversos fitxers ràster amb contingut categòric (mapes de cobertes del sòl, d&apos;unitats geològiques, etc) a un fitxer topològic de polígons."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="100">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Opció única en aquesta versió del programa. El valor "1" s'ha d'incloure a la sintaxi.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="100">
				<ows:Identifier>FitxerRas</ows:Identifier>
				<ows:Title>Nom del fitxer ràster</ows:Title>
				<ows:Abstract>És el primer dels fitxers ràster a vectoritzar. Es pot indicar més d'un fitxer ràster. En aquest cas, cal que tots siguin del mateix àmbit i resolució.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerRas"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>Multibanda</ows:Title>
				<ows:Abstract>Quan el fitxer FitxerRas1 és multibanda es prenen en consideració totes les bandes. Totes elles han de ser del mateix àmbit i resolució.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TOTS_VALORS_VALIDS</ows:Identifier>
				<ows:Title>Tots els valors</ows:Title>
				<ows:Abstract>Vectoritza tots els valors diferents de sensedades com únic atribut 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GENERALITZAR</ows:Identifier>
				<ows:Title>Generalitzar</ows:Title>
				<ows:Abstract>Desactiva (0) o activa (1) la capacitat de generalització de vores.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_CICLAR_POLIGONS</ows:Identifier>
				<ows:Title>No ciclar polígons</ows:Title>
				<ows:Abstract>El resultat del RasTop és un fitxer d'arcs que són les vores dels polígons de les zones vectoritzades.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_AGRUPAR_POLIGONS_PER_NODES</ows:Identifier>
				<ows:Title>No agrupar polígons per nodes</ows:Title>
				<ows:Abstract>S'evita l'agrupació de polígons amb un mateix atribut i que es toquen per un node.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerTop</ows:Identifier>
				<ows:Title>Nom del fitxer topològic</ows:Title>
				<ows:Abstract>És el fitxer topològic de polígons resultat de la vectorització.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerTop"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>