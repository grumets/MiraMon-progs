<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CICLAR:Param1:1</ows:Identifier>
		<ows:Title>Option 1</ows:Title>
		<ows:Abstract>Cycles all arcs present in the file.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Creating polygons with topology"/>
		<ows:Metadata xlink:title="Abstract:This program works on a family of topologically structured files containing arcs (ARC) and nodes (NOD) to produce a family of topologically structured files containing polygons (POL)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Total cycling.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerArcOrigen</ows:Identifier>
				<ows:Title>Input Arc file</ows:Title>
				<ows:Abstract>Structured ARC File.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:InputARCfile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>IGNORAR</ows:Identifier>
				<ows:Title>Discards ciclable arcs</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>ENDNODES: Before processing the processable arcs are selected, discarding the arcs without end nodes.</li><li>/HALTERS: Like ENDNODES, but also discarding those arcs with the same polygon on both sides If these are not indicated the program does not tolerate the presence of end nodes nor halters in the arcs database.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>ENDNODES</ows:Value>
						<ows:Value>HALTERS</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerPolDesti</ows:Identifier>
				<ows:Title>Output polygon file</ows:Title>
				<ows:Abstract>The program generates a POL file.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputPOLFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CICLAR:Param1:2</ows:Identifier>
		<ows:Title>Option 2</ows:Title>
		<ows:Abstract>Is based on a logical (L) field of the database. If it says 'TRUE', the arc is cyclable, and if it says 'FALSE' the arc is ignored during the cycling process. If the database contains only one logical field, this one will be used, and if there are several, it will be asked which field should be used. This is useful to exclude certain arcs from the process of cycling.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Process selectively as a function of the logical field in the database indicated by /TAULA_ARC=n and /CAMP_ARC=m or by a selection.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerArcOrigen</ows:Identifier>
				<ows:Title>Input Arc file</ows:Title>
				<ows:Abstract>Structured ARC File.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:InputARCfile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>IGNORAR</ows:Identifier>
				<ows:Title>Discards ciclable arcs</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>ENDNODES: Before processing the processable arcs are selected, discarding the arcs without end nodes.</li><li>/HALTERS: Like ENDNODES, but also discarding those arcs with the same polygon on both sides If these are not indicated the program does not tolerate the presence of end nodes nor halters in the arcs database.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>ENDNODES</ows:Value>
						<ows:Value>HALTERS</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TAULA_ARC</ows:Identifier>
				<ows:Title>Index of the table that contain the logical field</ows:Title>
				<ows:Abstract>Logical Field selection of the table in arc format. Is indicated with /TAULA_ARC=n and /CAMP_ARC=m or with a selection.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_ARC</ows:Identifier>
				<ows:Title>Index of the field that is the logical field.</ows:Title>
				<ows:Abstract>Logical Field selection of the table in arc format. Is indicated with /TAULA_ARC=n and /CAMP_ARC=m or with a selection.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>COND#_CAMP</ows:Identifier>
				<ows:Title>Field of condition #</ows:Title>
				<ows:Abstract>Field name of # condition of selection. It may be made up to 100 simple queries and 100 field names (COND#_CAMP) starting at index 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>COND#_OP</ows:Identifier>
				<ows:Title>Operation of condition #</ows:Title>
				<ows:Abstract>Opertation of # condition of selection. It may be made up to 100 simple queries and 100 operations (COND#_OP) starting at index 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>EQ</ows:Value>
						<ows:Value>NO_EQ</ows:Value>
						<ows:Value>LT</ows:Value>
						<ows:Value>GT</ows:Value>
						<ows:Value>LT_EQ</ows:Value>
						<ows:Value>GT_EQ</ows:Value>
						<ows:Value>INTERVAL</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="100">
				<ows:Identifier>COND#_VALOR</ows:Identifier>
				<ows:Title>Value of condition #</ows:Title>
				<ows:Abstract>Value of # condition of selection. It may be made up to 100 simple queries and 100 values (COND#_VALOR) starting at index 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="99">
				<ows:Identifier>COND#_NEXE</ows:Identifier>
				<ows:Title>Nexus linking of condition #</ows:Title>
				<ows:Abstract>Nexus use to linking for the successive selections. In this case to linking between condition # and condition #+1. It may be made up to 100 simple queries and 99 nexus (COND#_NEXE) starting at index 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>AND</ows:Value>
						<ows:Value>OR</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="99">
				<ows:Identifier>COND#_PRIOR</ows:Identifier>
				<ows:Title>Priority of nexus linking of condition #</ows:Title>
				<ows:Abstract>Priority of nexus use to linking for the successive selections. In this case to linking between condition # and condition #+1. It may be made up to 100 simple queries and 99 priorities (COND#_PRIOR) starting at index 1. This is an optional parameter. If it is not indicated the priority is just the order.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>1</ows:MinimumValue>
							<ows:MaximumValue>99</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerPolDesti</ows:Identifier>
				<ows:Title>Output polygon file</ows:Title>
				<ows:Abstract>The program generates a POL file.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputPOLFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CICLAR:Param1:3</ows:Identifier>
		<ows:Title>Option 3</ows:Title>
		<ows:Abstract><![CDATA[Performs a recycling from a polygon file, already totally cycled and in which thematic attributes have been included f.ex. <a href="atritop.htm">ATRITOP</a>. The idea is to build new, more general, polygons from the arcs that have different attribute on both sides. <p><ul>Example:</ul><ul>We have a file of municipalities. Its database has a field that informs about which county each municipality belongs to. CICLAR 3 can generate the polygon file corresponding to these countries, in which only the arcs defining the country borders are used (those that have a different county -attribute- on each side of the arc).</ul><p> The selection criteria is taken from a database field or from all field that are not geometrical-topologic. Only those arcs having a different field value on both sides in the old polygon file are considered as cyclable.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Polygon recycling by arcs having the same attributes in both sides. It can be done considering all non geometrical-topological fields or a database field in the InputPOLfile (any field of any database table).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerPolOrigen</ows:Identifier>
				<ows:Title>The Input POL file</ows:Title>
				<ows:Abstract>Structured POL File.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:InputPOLfile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TAULA</ows:Identifier>
				<ows:Title>Selects a  database table</ows:Title>
				<ows:Abstract><![CDATA[/TAULA= and /CAMP= set database field of the selection criteria (options 3 and 4) or set database field to be exported in a VEC format (option 8). To learn more about the values of these parameters follow the considerations in <a href="general.htm#TaulaCamp">general syntax</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP</ows:Identifier>
				<ows:Title>Selects a  database field</ows:Title>
				<ows:Abstract><![CDATA[/TAULA= and /CAMP= set database field of the selection criteria (options 3 and 4) or set database field to be exported in a VEC format (option 8). To learn more about the values of these parameters follow the considerations in <a href="general.htm#TaulaCamp">general syntax</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_AREA</ows:Identifier>
				<ows:Title>Field name that will contain the Field area</ows:Title>
				<ows:Abstract>It is the field name that contains or will contain the partial area of each record of the resulting polygons when they present multiple record. This field will contain the area covered by each record before the polygon fusion. In case that the field do not exists, the program will create it.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_AREA_TPERCENT</ows:Identifier>
				<ows:Title>Field name that will contain the Field Percentage Cover</ows:Title>
				<ows:Abstract>Added to partial area, if you indicated this parameter you are requesting a generation of a field with cover percentage for each record in the possible multiple records of the main table of attributes.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerPolDesti</ows:Identifier>
				<ows:Title>Output polygon file</ows:Title>
				<ows:Abstract>The program generates a POL file.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputPOLFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CICLAR:Param1:4</ows:Identifier>
		<ows:Title>Option 4</ows:Title>
		<ows:Abstract>Generates some groups of polygons from a polygon file, already totally cycled, from a thematic pre existent attribute. A group of polygons file is a file that agglutinates in a single entity (a single polygon) all polygons having a common property (equal attribute). For example, in a map of countries, it would be desirable that all locations and islands that belong to the same country form a unique entity. This means that when consulting by location a polygon of a country, such as Canada, you obtain also a highlighting of all of its islands. This query gives us area and perimeter as a result of sum of elemental polygon contributions. The selection criteria is taken from a database field or from all field that are not geometrical-topologic.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Select groups of polygons as a function of the database field in the INPUT_POLYGON_FILE FILE (any field of any database table).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerPolOrigen</ows:Identifier>
				<ows:Title>The Input POL file</ows:Title>
				<ows:Abstract>Structured POL File.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:InputPOLfile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TAULA</ows:Identifier>
				<ows:Title>Selects a  database table</ows:Title>
				<ows:Abstract><![CDATA[/TAULA= and /CAMP= set database field of the selection criteria (options 3 and 4) or set database field to be exported in a VEC format (option 8). To learn more about the values of these parameters follow the considerations in <a href="general.htm#TaulaCamp">general syntax</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP</ows:Identifier>
				<ows:Title>Selects a  database field</ows:Title>
				<ows:Abstract><![CDATA[/TAULA= and /CAMP= set database field of the selection criteria (options 3 and 4) or set database field to be exported in a VEC format (option 8). To learn more about the values of these parameters follow the considerations in <a href="general.htm#TaulaCamp">general syntax</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_AREA</ows:Identifier>
				<ows:Title>Field name that will contain the Field area</ows:Title>
				<ows:Abstract>It is the field name that contains or will contain the partial area of each record of the resulting polygons when they present multiple record. This field will contain the area covered by each record before the polygon fusion. In case that the field do not exists, the program will create it.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_AREA_TPERCENT</ows:Identifier>
				<ows:Title>Field name that will contain the Field Percentage Cover</ows:Title>
				<ows:Abstract>Added to partial area, if you indicated this parameter you are requesting a generation of a field with cover percentage for each record in the possible multiple records of the main table of attributes.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerPolDesti</ows:Identifier>
				<ows:Title>Output polygon file</ows:Title>
				<ows:Abstract>The program generates a POL file.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputPOLFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CICLAR:Param1:5</ows:Identifier>
		<ows:Title>Option 5</ows:Title>
		<ows:Abstract><![CDATA[Performs a recycling from a polygon file already totally cycled. It groups in a single polygon, more general, those polygons that are connected by a node and share the same attributes. 
<p><ul>Example:</ul><ul>Imagine a raster file presenting linear elements with width similar to the pixel size crossing the raster in diagonal (roads or rivers). If this layer is vectorized to get polygons, these lines will usually become sequences of square polygons of one pixel in size and interconnected by their nodes. This mode groups all these polygons in a single one that better represents the entities.</ul><p>The selection criteria is taken from a database field or from all fields that are not geometrical-topologic. Only those arcs having a different field value on both sides in the original polygon file are considered as cyclable.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Polygon recycling of polygons sharing a node and having the same attributes both sides. It can be done considering all non geometrical-topologic fields or a database field in the InputPOLfile (any field of any database table).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>5</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerPolOrigen</ows:Identifier>
				<ows:Title>The Input POL file</ows:Title>
				<ows:Abstract>Structured POL File.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:InputPOLfile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TAULA</ows:Identifier>
				<ows:Title>Selects a  database table</ows:Title>
				<ows:Abstract><![CDATA[/TAULA= and /CAMP= set database field of the selection criteria (options 3 and 4) or set database field to be exported in a VEC format (option 8). To learn more about the values of these parameters follow the considerations in <a href="general.htm#TaulaCamp">general syntax</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP</ows:Identifier>
				<ows:Title>Selects a  database field</ows:Title>
				<ows:Abstract><![CDATA[/TAULA= and /CAMP= set database field of the selection criteria (options 3 and 4) or set database field to be exported in a VEC format (option 8). To learn more about the values of these parameters follow the considerations in <a href="general.htm#TaulaCamp">general syntax</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_AREA</ows:Identifier>
				<ows:Title>Field name that will contain the Field area</ows:Title>
				<ows:Abstract>It is the field name that contains or will contain the partial area of each record of the resulting polygons when they present multiple record. This field will contain the area covered by each record before the polygon fusion. In case that the field do not exists, the program will create it.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_AREA_TPERCENT</ows:Identifier>
				<ows:Title>Field name that will contain the Field Percentage Cover</ows:Title>
				<ows:Abstract>Added to partial area, if you indicated this parameter you are requesting a generation of a field with cover percentage for each record in the possible multiple records of the main table of attributes.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>IGNORAR</ows:Identifier>
				<ows:Title>Discards ciclable arcs</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>ENDNODES: Before processing the processable arcs are selected, discarding the arcs without end nodes.</li><li>/HALTERS: Like ENDNODES, but also discarding those arcs with the same polygon on both sides If these are not indicated the program does not tolerate the presence of end nodes nor halters in the arcs database.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>ENDNODES</ows:Value>
						<ows:Value>HALTERS</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerPolDesti</ows:Identifier>
				<ows:Title>Output polygon file</ows:Title>
				<ows:Abstract>The program generates a POL file.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputPOLFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CICLAR:Param1:6</ows:Identifier>
		<ows:Title>Option 6</ows:Title>
		<ows:Abstract>Generates a non-topological groups of polygons file (overlapping of polygons is allowed). It selects all arcs with the same attribute and cycles them totally.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Obtain groups of non-topological polygons as a function of a database field in the InputARCfile indicated by /TAULA_ARC=n and /CAMP_ARC=m. The value of this field is converted into a polygon attribute in the database. Since groups of polygons of this type can often produce overlap it is possible to indicate a numerical field for determining the order in which the polygons are drawn using another database field indicated by /TAULA_ORD=n /CAMP_ORD=m. By default the order is that in which the first arc of each attribute appears. This has the effect that the polygons formed by arcs whose attributes were digitised first fall underneath those that were digitised later.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>6</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerArcOrigen</ows:Identifier>
				<ows:Title>Input Arc file</ows:Title>
				<ows:Abstract>Structured ARC File.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:InputARCfile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TAULA_ARC</ows:Identifier>
				<ows:Title>Index of the table that contain the logical field</ows:Title>
				<ows:Abstract>Logical Field selection of the table in arc format. Is indicated with /TAULA_ARC=n and /CAMP_ARC=m or with a selection.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_ARC</ows:Identifier>
				<ows:Title>Index of the field that is the logical field.</ows:Title>
				<ows:Abstract>Logical Field selection of the table in arc format. Is indicated with /TAULA_ARC=n and /CAMP_ARC=m or with a selection.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TAULA_ORD</ows:Identifier>
				<ows:Title>Index of the table that contain table order</ows:Title>
				<ows:Abstract>Defines the order of the process</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_ORD</ows:Identifier>
				<ows:Title>Index of the field that contain Field order</ows:Title>
				<ows:Abstract>Defines the order of the process</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>IGNORAR</ows:Identifier>
				<ows:Title>Discards ciclable arcs</ows:Title>
				<ows:Abstract><![CDATA[<ul><li>ENDNODES: Before processing the processable arcs are selected, discarding the arcs without end nodes.</li><li>/HALTERS: Like ENDNODES, but also discarding those arcs with the same polygon on both sides If these are not indicated the program does not tolerate the presence of end nodes nor halters in the arcs database.</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>ENDNODES</ows:Value>
						<ows:Value>HALTERS</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>UN_POL_PER_ATRIBUT</ows:Identifier>
				<ows:Title>One polygon</ows:Title>
				<ows:Abstract>Generates one MacroPoligon for all of those Polygons which shares the attribute</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FITXER_ORDRE_GRUP</ows:Identifier>
				<ows:Title>INI file that indicates the superposition order.</ows:Title>
				<ows:Abstract>Since groups of polygons of this type can often produce overlap t is possible to indicate the order in which the polygons are drawn using the parameter /FITXER_ORDRE_GRUP. This has the effect that the polygons formed by arcs whose attributes were digitised first fall underneath those that were digitised later.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-ini</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-ini</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerPolDesti</ows:Identifier>
				<ows:Title>Output polygon file</ows:Title>
				<ows:Abstract>The program generates a POL file.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputPOLFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CICLAR:Param1:7</ows:Identifier>
		<ows:Title>Option 7</ows:Title>
		<ows:Abstract>Converts polygons from a VEC file to a POL file (overlapping of polygons is allowed). The VEC attribute is imported as well. When two or more polygons both have the same attribute and appear consecutively inside the VEC file, these polygons became a group in the POL file.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Convert polygons from a VEC file to a POL file (groups of non-topological polygons).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>7</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerVecOrigen</ows:Identifier>
				<ows:Title>VEC File</ows:Title>
				<ows:Abstract>Non Structured VEC file.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:VecOriginFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerPolDesti</ows:Identifier>
				<ows:Title>Output polygon file</ows:Title>
				<ows:Abstract>The program generates a POL file.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputPOLFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CICLAR:Param1:8</ows:Identifier>
		<ows:Title>Option 8</ows:Title>
		<ows:Abstract>Converts polygons from a POL file to a VEC file. Each group of polygons are splitter in theirs elemental polygons. You can select one database field to keep it as VEC objects attributes.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Convert polygons from a POL file to a VEC file.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>8</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerPolOrigen</ows:Identifier>
				<ows:Title>The Input POL file</ows:Title>
				<ows:Abstract>Structured POL File.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:InputPOLfile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>precisio</ows:Identifier>
				<ows:Title>Precision</ows:Title>
				<ows:Abstract>Precision</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Precision"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TAULA</ows:Identifier>
				<ows:Title>Selects a  database table</ows:Title>
				<ows:Abstract><![CDATA[/TAULA= and /CAMP= set database field of the selection criteria (options 3 and 4) or set database field to be exported in a VEC format (option 8). To learn more about the values of these parameters follow the considerations in <a href="general.htm#TaulaCamp">general syntax</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP</ows:Identifier>
				<ows:Title>Selects a  database field</ows:Title>
				<ows:Abstract><![CDATA[/TAULA= and /CAMP= set database field of the selection criteria (options 3 and 4) or set database field to be exported in a VEC format (option 8). To learn more about the values of these parameters follow the considerations in <a href="general.htm#TaulaCamp">general syntax</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SI_EN_BLANC</ows:Identifier>
				<ows:Title>Blank attribute</ows:Title>
				<ows:Abstract>Sets the VEC exportation behaviour when the attribute do not exist in the database (blank field). Can be "CONSTANT" to write a constant value, "ID_GRAFIC" to write graphic identificator or "IGNORAR" to ignore vectors without attribute (default value).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>CONSTANT</ows:Value>
						<ows:Value>ID_GRAFIC</ows:Value>
						<ows:Value>IGNORAR</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>IGNORAR</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ATRIBUT_CONSTANT</ows:Identifier>
				<ows:Title>Constant value</ows:Title>
				<ows:Abstract>Sets a constant that is going to be write as object attribute when exporting to VEC format. If it is used in combination with /TAULA=, /CAMP= and /SI_EN_BLANC=CONSTANT is the attribute that is going to be used when there is no data (blank field). If you don't indicate /TAULA=, /CAMP= or /ATRIBUT_CONSTANT= the vec format exportation is done using graphic identificator as attribute.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALCADA</ows:Identifier>
				<ows:Title>Sets the heights</ows:Title>
				<ows:Abstract><![CDATA[Sets which of the possible heights are used in the VEC. To learn more about the values of this parameter follow the considerations in <a href="general.htm#Alcada">general syntax</a>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>AJUST_ENV</ows:Identifier>
				<ows:Title>Adjusting envelope</ows:Title>
				<ows:Abstract>Adjusting envelope</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerVecDesti</ows:Identifier>
				<ows:Title>Output VEC File</ows:Title>
				<ows:Abstract>Poligon VEC file.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutputVecFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>