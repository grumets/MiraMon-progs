<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Filtres:1</ows:Identifier>
		<ows:Title>Filtres</ows:Title>
		<ows:Abstract>Esta aplicación genera un raster a partir de la aplicación de un determinado filtro no selectivo sobre el raster original. Cada píxel del ráster original se sustituye en el ráster destino por el resultado del cálculo definido según el filtro; en este cálculo participan los píxeles de su entorno en una determinada ventana cuadrada de lado impar definido por el usuario.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Filtrado indiscriminado de valores de rásters"/>
		<ows:Metadata xlink:title="Abstract:Esta aplicación genera un ráster a partir de la aplicación de un determinado filtro no selectivo sobre el raster original. Cada píxel del ráster original se sustituye en el ráster destino por el resultado del cálculo definido según el filtro; en este cálculo participan los píxeles de su entorno en una determinada ventana cuadrada de lado impar definido por el usuario."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract><![CDATA[<li>1 para un filtro de moda</li><li>2 de media</li><li>3 de desviación estándar</li><li>4 de variabilidad</li><li>5 de mínimo</li><li>6 de máximo</li><li>7 laplaciano 3x3</li><li>8 matriz predefinida</li><li>9 matriz de usuario</li><li>10 mediana.</li>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>6</ows:Value>
						<ows:Value>7</ows:Value>
						<ows:Value>8</ows:Value>
						<ows:Value>9</ows:Value>
						<ows:Value>10</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigen</ows:Identifier>
				<ows:Title>Fichero Origen</ows:Title>
				<ows:Abstract>Es el ráster origen.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FinConvol</ows:Identifier>
				<ows:Title>Ventana Convolución</ows:Title>
				<ows:Abstract>Es el lado de la ventana de convolución (número impar).</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:VenConvol"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA_MAJORITARI</ows:Identifier>
				<ows:Title>Asigna sindatos</ows:Title>
				<ows:Abstract>Asigna sindatos cuando la muestra de los valores válidos en la ventana de convolución definida es minoritaria.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NOMES_SOBRE_NODATA</ows:Identifier>
				<ows:Title>Solo sindatos</ows:Title>
				<ows:Abstract>Aplica el filtro solo sobre los píxeles sindatos.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RECLASS_NODATA</ows:Identifier>
				<ows:Title>Reclasifica sindatos</ows:Title>
				<ows:Abstract>Valor válido al cuál se asignarán las zonas sindatos para después aplicar el filtro correspondiente en ellas tal como se aplica en las zonas de valors válidos.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RLE</ows:Identifier>
				<ows:Title>Comprimir e indexar</ows:Title>
				<ows:Abstract>El ráster resultado se comprimirá e indexará.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PESOS</ows:Identifier>
				<ows:Title>Pesos</ows:Title>
				<ows:Abstract>Secuencia en orden fila, columna de los elementos de la matriz de pesos, es decir, los valores numéricos separados por un carácter _. Si un elemento no está definido y por tanto no hace falta aplicarlo, se marcará con un carácter x, aunque en la mayoría de casos es equivalente a un peso cero.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NORMALITZAR</ows:Identifier>
				<ows:Title>Normalitzar</ows:Title>
				<ows:Abstract>Implica que sobre todos los elementos de la matriz de pesos se aplicará un factor divisor adicional, de manera que la suma de pesos sea 1.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DIVISOR</ows:Identifier>
				<ows:Title>Divisor</ows:Title>
				<ows:Abstract>Factor constante que divide a todos los elementos de la matriz para obtener los pesos definitivos. Es útil para no tener que definir pesos con decimales (como en el caso de decimales periódicos, donde es más preciso indicar la fracción que no el número en sí).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>F_PESOS</ows:Identifier>
				<ows:Title>Archivo de pesos</ows:Title>
				<ows:Abstract>Archivo de pesos donde se fijan todos los parámetros de la matriz de pesos a aplicar anteriormente descritos (además de un título descriptivo según el idioma de trabajo).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDestí</ows:Identifier>
				<ows:Title>Fichero Destino</ows:Title>
				<ows:Abstract>Es el ráster resultado.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroDestino"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>