<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:VrtPunt:1</ows:Identifier>
		<ows:Title>Creació d'un fitxer de punts a partir de vèrtexs de línies o polígons</ows:Title>
		<ows:Abstract>Aquesta aplicació crea un fitxer de punts a partir de l'extracció dels vèrtexs dels fitxers de línies o polígons donats.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Creació d&apos;un fitxer de punts a partir de vèrtexs de línies o polígons"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació crea un fitxer de punts a partir de l&apos;extracció dels vèrtexs dels fitxers de línies o polígons donats."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>F_file_in</ows:Identifier>
				<ows:Title>Fitxer de línies o polígons</ows:Title>
				<ows:Abstract>Nom del fitxer de línies o polígons a convertir en fitxer de punts.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FitxerEntrada"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>F_file_out</ows:Identifier>
				<ows:Title>Fitxer de punts</ows:Title>
				<ows:Abstract>Nom de fitxer VEC de punts de sortida.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerSortida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>