<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:IMGIMG:1</ows:Identifier>
		<ows:Title>IMGIMG</ows:Title>
		<ows:Abstract><![CDATA[El programa serveix per a comprimir/descomprimir fitxers ràster i per a efectuar conversions entre formats IMG. Per a compressió/descompressió entre formats IMG i JPEG, cal utilitzar <a href="JPEGIMG.htm">JPEGIMG</a>. Per a la descompressió de formats JPEG2000 (.jp2 o .j2c) cal usar <a href="J2KIMG.htm">J2KIMG</a>.]]></ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversió i compressió/descompressió de fitxers IMG"/>
		<ows:Metadata xlink:title="Abstract:El programa serveix per a comprimir/descomprimir fitxers ràster i per a efectuar conversions entre formats IMG. Per a compressió/descompressió entre formats IMG i JPEG, cal utilitzar &lt;a href=&quot;JPEGIMG.htm&quot;&gt;JPEGIMG&lt;/a&gt;. Per a la descompressió de formats JPEG2000 (.jp2 o .j2c) cal usar &lt;a href=&quot;J2KIMG.htm&quot;&gt;J2KIMG&lt;/a&gt;."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract><![CDATA[Opció indica com serà la conversió, i pot ser: <ul><li><i>RLE</i> per a comprimir.</li><li><i>UNRLE</i> per a descomprimir.</li><li>Un format fix com:<i> bit, byte, byte-RLE, integer, integer-RLE, uinteger, uinteger-RLE, long, long-RLE, real, real-RLE, double, double-RLE, bit-vell.</i></li><li><i>MINMAX</i> per calcular el mínim i el màxim real de la imatge i documentar-lo sobre la imatge origen.</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>RLE</ows:Value>
						<ows:Value>UNRLE</ows:Value>
						<ows:Value>bit</ows:Value>
						<ows:Value>byte</ows:Value>
						<ows:Value>byte-RLE</ows:Value>
						<ows:Value>uinteger</ows:Value>
						<ows:Value>uinteger-RLE</ows:Value>
						<ows:Value>integer</ows:Value>
						<ows:Value>integer-RLE</ows:Value>
						<ows:Value>long</ows:Value>
						<ows:Value>long-RLE</ows:Value>
						<ows:Value>real</ows:Value>
						<ows:Value>real-RLE</ows:Value>
						<ows:Value>double</ows:Value>
						<ows:Value>double-RLE</ows:Value>
						<ows:Value>bit-vell</ows:Value>
						<ows:Value>MINMAX</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigen</ows:Identifier>
				<ows:Title>Fitxer origen</ows:Title>
				<ows:Abstract>És el fitxer a convertir.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>Multibanda</ows:Title>
				<ows:Abstract>Només aplica a ràsters multibanda, i indica que es desitja convertir totes les bandes.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RLE_INDEX</ows:Identifier>
				<ows:Title>RLE indexat</ows:Title>
				<ows:Abstract>Quan el resultat és un ràster comprimit indica que s'afegirà al final del fitxer un llistat de posicions d'inici de línia.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_EXTRA</ows:Identifier>
				<ows:Title>No extracomprimit</ows:Title>
				<ows:Abstract>Aquest paràmetre habitualment molt poc recomanable, genera un format comprimit RLE de menor raó de compressió que l'extracomprimit usat normalment.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MES_BANDA</ows:Identifier>
				<ows:Title>Una banda</ows:Title>
				<ows:Abstract><![CDATA[Nom del fitxer resultat a afegir al ràster original multibanda, quan només es desitja la conversió d'una sola banda. Habitualment es dona sense <i>path</i> i sense extensió i s'ubicarà al mateix directori que la resta de bandes, però podria ser un nom de fitxer amb <i>path</i> qualsevol.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Desti</ows:Identifier>
				<ows:Title>Destí</ows:Title>
				<ows:Abstract>És el fitxer resultat pel cas monobanda, o és el directori resultat pel cas multibanda quan es desitja convertir totes les bandes. Si no s'indica, es realitza la conversió sobre el propi fitxer original.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Desti"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>