<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:KMLMM:1</ows:Identifier>
		<ows:Title>Importació de KML a MM</ows:Title>
		<ows:Abstract>Converteix un fitxer KML de GoogleEarth a Mapes del MiraMon que contenen capes en format estructurat del MiraMon (PNT, ARC/NOD i POL).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversió de fitxers KML a Mapes del MiraMon"/>
		<ows:Metadata xlink:title="Abstract:Aquest programa converteix un fitxer KML de GoogleEarth a Mapes del MiraMon que contenen capes en format estructurat del MiraMon (PNT, ARC/NOD i POL)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Importació al format del MiraMon (sense estructuració topològica).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMM</ows:Identifier>
				<ows:Title>Fitxer MM</ows:Title>
				<ows:Abstract>Fitxer de mapa (.mmm) o vectorial (,pol, .arc, .pnt o .vec) del MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerMM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerKML</ows:Identifier>
				<ows:Title>FitxerKML</ows:Title>
				<ows:Abstract>És el nom del fitxer KML, amb extensió .kml.</ows:Abstract>
				<ows:Metadata xlink:title="Name:FitxerKML"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/vnd.google-earth.kml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/vnd.google-earth.kml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>SistemaReferència</ows:Title>
				<ows:Abstract>Identificador del sistema de referència en què es vol reprojectar les capes. Per defecte val 'lat/long-WGS84'.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:KMLMM:2</ows:Identifier>
		<ows:Title>Exportació de MM a KML</ows:Title>
		<ows:Abstract>Converteix un fitxer de Mapa del MiraMon o un fitxer vectorial de MiraMon (PNT, ARC, POL o VEC) a un fitxer KML.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMMM</ows:Identifier>
				<ows:Title>FitxerMMM</ows:Title>
				<ows:Abstract>És el nom, amb extensió .mmm, del fitxer de sortida. El programa crearà un directori amb el mateix nom del mapa, i al mateix nivell on desarà les capes del mapa, les quals seguiran la següent nomenclatura: PNT_KMLMM, ARC_KMLMM i POL_KMLMM.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-MMM</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-MMM</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMM</ows:Identifier>
				<ows:Title>Fitxer MM</ows:Title>
				<ows:Abstract>Fitxer de mapa (.mmm) o vectorial (,pol, .arc, .pnt o .vec) del MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerMM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerKML</ows:Identifier>
				<ows:Title>FitxerKML</ows:Title>
				<ows:Abstract>És el nom del fitxer KML, amb extensió .kml.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerKML"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/vnd.google-earth.kml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/vnd.google-earth.kml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>