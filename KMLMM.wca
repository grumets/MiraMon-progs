<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:KMLMM:Param1:0</ows:Identifier>
		<ows:Title>Opció 0: Informació del contingut del fitxer KML</ows:Title>
		<ows:Abstract>INFORMACIÓ DE CONTINGUTS: Mostra una relació del contingut del fitxer KML o KMZ. Indica el nombre d'objectes KML de tipus 'Point', 'LineString' i 'Polygon'.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importació i exportació entre el format KML i el MiraMon"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació importa i exporta entre el format KML de GoogleEarth i el MiraMon."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 0</ows:Title>
				<ows:Abstract>Informació del contingut del fitxer</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerKML</ows:Identifier>
				<ows:Title>Fitxer KML</ows:Title>
				<ows:Abstract>Fitxer KML o KMZ amb extensió .kml o .kmz</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerKML"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/vnd.google-earth.kml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/vnd.google-earth.kml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>StdOut</ows:Identifier>
				<ows:Title>Estàndard de sortida</ows:Title>
				<ows:Abstract>Informació del contingut del fitxer KML mostrada per pantalla.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:KMLMM:Param1:1</ows:Identifier>
		<ows:Title>Opció 1: Importació al format del MiraMon (sense estructuració topològica).</ows:Title>
		<ows:Abstract>Aquest programa converteix un fitxer KML de GoogleEarth a Mapes del MiraMon que contenen capes en format estructurat del MiraMon (PNT, ARC/NOD i POL).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 1</ows:Title>
				<ows:Abstract>Importació al format del MiraMon (sense estructuració topològica).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerKML</ows:Identifier>
				<ows:Title>Fitxer KML</ows:Title>
				<ows:Abstract>Fitxer KML o KMZ amb extensió .kml o .kmz</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerKML"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/vnd.google-earth.kml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/vnd.google-earth.kml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Sistema de Referència</ows:Title>
				<ows:Abstract>Identificador del sistema de referència en què es vol reprojectar les capes. Per defecte val 'lat/long-WGS84'.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>lat/long-WGS84</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerMMM</ows:Identifier>
				<ows:Title>Fitxer MMM</ows:Title>
				<ows:Abstract>És el nom, amb extensió .mmm, del fitxer de sortida. El programa crearà un directori amb el mateix nom del mapa, i al mateix nivell on desarà les capes del mapa, les quals seguiran la següent nomenclatura: PNT_KMLMM, ARC_KMLMM i POL_KMLMM.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerMMM"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:KMLMM:Param1:2</ows:Identifier>
		<ows:Title>Opció 2: Exportació de MM a KML</ows:Title>
		<ows:Abstract>Converteix un fitxer de Mapa del MiraMon o un fitxer vectorial de MiraMon (PNT, ARC, POL o VEC) a un fitxer KML.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció 2</ows:Title>
				<ows:Abstract>Exportació de MiraMon a KML</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opció"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMM</ows:Identifier>
				<ows:Title>Fitxer MM</ows:Title>
				<ows:Abstract>Fitxer de mapa (.mmm) o vectorial (,pol, .arc, .pnt o .vec) del MiraMon.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerMM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerKML</ows:Identifier>
				<ows:Title>Fitxer KML</ows:Title>
				<ows:Abstract>Fitxer KML o KMZ amb extensió .kml o .kmz</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerKML"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/vnd.google-earth.kml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/vnd.google-earth.kml+xml</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>