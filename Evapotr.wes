<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:EvapoTr:Param1:ET_THORN_1948</ows:Identifier>
		<ows:Title>Cálculo de la evapotranspiración potencial con la fórmula de Thornthwaite</ows:Title>
		<ows:Abstract>Este programa calcula la evapotranspiración potencial con la fórmula de Thornthwaite.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Cálculo de la evapotranspiración."/>
		<ows:Metadata xlink:title="Abstract:Este programa calcula la evapotranspiración."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Cálculo de la evapotranspiración potencial con la fórmula de Thornthwaite 1948.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>ET_THORN_1948</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>ET_THORN_1948</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>LlistaTXT</ows:Identifier>
				<ows:Title>Lista de ficheros IMG</ows:Title>
				<ows:Abstract>Lista de ficheros IMG en formato TXT o LST que corresponden a las capas de temperatura de los 12 meses del año. Debe haber exactamente 12 ficheros IMG en la lista para poder calcular la evapotranspiración potencial. En caso contrario, el programa dará error.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:ListaTXT"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefijo de los ficheros de salida</ows:Title>
				<ows:Abstract>Prefijo que se concatenará con los ficheros de entrada para escribir los ficheros de salida. En caso de no asignar ningún prefijo, los ficheros de salida tendrán el mismo nombre que los de entrada.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>DirSortida</ows:Identifier>
				<ows:Title>Directorio de salida</ows:Title>
				<ows:Abstract>Directorio de salida donde se escribirán los ficheros resultantes de la ejecución del programa.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:DirectorioSalida"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>