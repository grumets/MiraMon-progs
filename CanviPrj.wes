						<ows:Value>Conic_Equidistant_4S_21S-Normal-Sphere</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>int</ows:Identifier>
				<ows:Title>Tipo interpolación</ows:Title>
				<ows:Abstract><![CDATA[Criterio para decidir el valor del píxel de salida (Interpolación):<ul><li>x: Preguntar interactivamente.</li><li>0: Vecino más próximo (adecuado para mapas temáticos puesto que preserva la radiometría original).</li><li>1: Interpolación bilineal (adecuado para imágenes para fotointerpretación, modelos digitales de elevación, etc).</li><li>2: Interpolación bicúbica (como 1 pero con resultados suavizados; proceso de cálculo más lento).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:int"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>x</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>xMin</ows:Identifier>
				<ows:Title>X mínima</ows:Title>
				<ows:Abstract>Coordenada X mínima de la envolvente del ráster de salida.  Se debe indicar  'x' si se desea que el programa la calcule.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:xMín"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>xMax</ows:Identifier>
				<ows:Title>X máxima</ows:Title>
				<ows:Abstract>Coordenada X máxima de la envolvente del ráster de salida. Se debe indicar  'x' si se desea que el programa la calcule.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:xMáx"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>yMin</ows:Identifier>
				<ows:Title>Y mínima</ows:Title>
				<ows:Abstract>Coordenada Y mínima de la envolvente del ráster de salida. Se debe indicar  'x' si se desea que el programa la calcule.</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:yMín"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>yMax</ows:Identifier>
				<ows:Title>Y máxima</ows:Title>
				<ows:Abstract>Coordenada Y máxima de la envolvente del ráster de salida. Se debe indicar  'x' si se desea que el programa la calcule.</ows:Abstract>
				<ows:Metadata xlink:title="Param8"/>
				<ows:Metadata xlink:title="Name:yMáx"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>res</ows:Identifier>
				<ows:Title>Resolución de la imagen de salida</ows:Title>
				<ows:Abstract>Resolución de la imagen de salida, en unidades mapa. Si se indica 'x' se usa la resolución de entrada.</ows:Abstract>
				<ows:Metadata xlink:title="Param9"/>
				<ows:Metadata xlink:title="Name:res"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>x</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>v_f</ows:Identifier>
				<ows:Title>Valor fondo</ows:Title>
				<ows:Abstract>Valor de fondo cuando el fichero a corregir (f_i) no tiene datos para píxeles de salida. Debe indicarse 'x' si se desea el valor por defecto.</ows:Abstract>
				<ows:Metadata xlink:title="Param10"/>
				<ows:Metadata xlink:title="Name:v_f"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>x</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATUM_ESTRICTE</ows:Identifier>
				<ows:Title>Dátum estricto</ows:Title>
				<ows:Abstract>Realiza el cambio de dátum entre dátums de un mismo grupo (por defecto no se realiza).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>f_s</ows:Identifier>
				<ows:Title>Fichero de salida ráster</ows:Title>
				<ows:Abstract>Fichero de salida ráster.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroSalidaIMG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CanviPrj:!Param4</ows:Identifier>
		<ows:Title>CanviPrj Vectores Estructurados</ows:Title>
		<ows:Abstract>Permite hacer la transformación de vectores estructurados de puntos (PNT), de arcos (ARC) y polígonos (POL). Para transformar ficheros de nodos (NOD) hay que transformar el fichero de arcos asociado.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>f_v_est</ows:Identifier>
				<ows:Title>Fichero de entrada estructurado</ows:Title>
				<ows:Abstract>Fichero vectorial estructurado de entrada (con extensión), de tipo punto (f_i.PNT), arco (f_i.ARC) o polígono (f_i.POL).</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FicheroVecEstruc"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
