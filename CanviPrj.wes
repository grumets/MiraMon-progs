			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>precisio</ows:Identifier>
				<ows:Title>Precisión</ows:Title>
				<ows:Abstract>Numero de cifras decimales en las coordenadas de la imagen de salida (por defecto 3) (solo para a ficheros VEC).</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:f_i.precision"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DATUM_ESTRICTE</ows:Identifier>
				<ows:Title>Dátum estricto</ows:Title>
				<ows:Abstract>Realiza el cambio de dátum entre dátums de un mismo grupo (por defecto no se realiza).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>f_s_vec</ows:Identifier>
				<ows:Title>Fichero de salida VEC</ows:Title>
				<ows:Abstract>Fichero de salida no estructurado.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroSalidaVec"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>