						<ows:Value>Azimuthal_Equidistant-0-90-WGS84</ows:Value>
						<ows:Value>LambertAzimEqualA-0-90-WGS84-Ellipsoide</ows:Value>
						<ows:Value>Lambert_Azimuthal_Equal_Area-1052-ETRS89</ows:Value>
						<ows:Value>Lambert_Azimuthal_Equal_Area-9-48-ETRS89</ows:Value>
						<ows:Value>LambertAzimEqualA-0-90-WGS84-Esfera</ows:Value>
						<ows:Value>LambertAzimEqualA-1052-ETRS89-Esfera</ows:Value>
