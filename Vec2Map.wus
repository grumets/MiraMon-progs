<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Vec2Map:Param1:1</ows:Identifier>
		<ows:Title>Vec2Map</ows:Title>
		<ows:Abstract>HTML map from VEC</ows:Abstract>
		<ows:Metadata xlink:title="Title:Create an HTML map"/>
		<ows:Metadata xlink:title="Abstract:This application generates a web page with a responsive map from a VEC polygon, POL or PNT file and a GIF or JPG raster image."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 1</ows:Title>
				<ows:Abstract>HTML map generation from a VEC file digitized on a non-georeferenced JPEG or GIF.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Imatge</ows:Identifier>
				<ows:Title>Imatge</ows:Title>
				<ows:Abstract>Name of the GIF or JPG raster file embedded in the HTML page (for option 1 a VEC polygon file with the same basename is assumed).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Imatge"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/gif</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/gif</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomSortida</ows:Identifier>
				<ows:Title>Output name</ows:Title>
				<ows:Abstract>Name of the output HTML file.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:NomSortida"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-html</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-html</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NCols</ows:Identifier>
				<ows:Title>NCols</ows:Title>
				<ows:Abstract>Number of image columns.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NCols"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NFils</ows:Identifier>
				<ows:Title>NFils</ows:Title>
				<ows:Abstract>Number of image rows.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:NFils"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Vec2Map:Param1:2</ows:Identifier>
		<ows:Title>Vec2Map</ows:Title>
		<ows:Abstract>HTML map from POL</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 2</ows:Title>
				<ows:Abstract>HTML map generation from a POL file and a georeferenced JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDePoligons</ows:Identifier>
				<ows:Title>Polygon file</ows:Title>
				<ows:Abstract>Name of the structured POL vector file.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerDePoligons"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Imatge</ows:Identifier>
				<ows:Title>Imatge</ows:Title>
				<ows:Abstract>Name of the GIF or JPG raster file embedded in the HTML page (for option 1 a VEC polygon file with the same basename is assumed).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Imatge"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/gif</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/gif</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomSortida</ows:Identifier>
				<ows:Title>Output name</ows:Title>
				<ows:Abstract>Name of the output HTML file.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NomSortida"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-html</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-html</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TOLERANCIA</ows:Identifier>
				<ows:Title>TOLERANCIA</ows:Title>
				<ows:Abstract>Tolerance used to remove redundant nearby vertices and lighten the HTML file. Default value is 3.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ID</ows:Identifier>
				<ows:Title>ID</ows:Title>
				<ows:Abstract>Refers to the id property of each sensitive area. Example: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>HREF</ows:Identifier>
				<ows:Title>HREF</ows:Title>
				<ows:Abstract>Refers to the href property of each sensitive area. Example: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TITLE</ows:Identifier>
				<ows:Title>TITLE</ows:Title>
				<ows:Abstract>Refers to the title property of each sensitive area. Example: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALT</ows:Identifier>
				<ows:Title>ALT</ows:Title>
				<ows:Abstract>Refers to the alt property of each sensitive area. Example: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ONCLICK</ows:Identifier>
				<ows:Title>ONCLICK</ows:Title>
				<ows:Abstract>Refers to the onclick property of each sensitive area. Example: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ONDBLCLICK</ows:Identifier>
				<ows:Title>ONDBLCLICK</ows:Title>
				<ows:Abstract>Refers to the ondblclick property of each sensitive area. Example: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ONMOUSEOVER</ows:Identifier>
				<ows:Title>ONMOUSEOVER</ows:Title>
				<ows:Abstract>Refers to the onmouseover property of each sensitive area. Example: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Vec2Map:Param1:3</ows:Identifier>
		<ows:Title>Vec2Map</ows:Title>
		<ows:Abstract>HTML map from PNT</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 3</ows:Title>
				<ows:Abstract>HTML map generation from a PNT file.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerDePunts</ows:Identifier>
				<ows:Title>Points file</ows:Title>
				<ows:Abstract>Name of the structured PNT vector file.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:PointsFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Imatge</ows:Identifier>
				<ows:Title>Imatge</ows:Title>
				<ows:Abstract>Name of the GIF or JPG raster file embedded in the HTML page (for option 1 a VEC polygon file with the same basename is assumed).</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Imatge"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/gif</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/gif</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>NomSortida</ows:Identifier>
				<ows:Title>Output name</ows:Title>
				<ows:Abstract>Name of the output HTML file.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NomSortida"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-html</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-html</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Amplada</ows:Identifier>
				<ows:Title>Width</ows:Title>
				<ows:Abstract>Width in pixels of the area shape rectangle.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Width"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Alcada</ows:Identifier>
				<ows:Title>Height</ows:Title>
				<ows:Abstract>Height in pixels of the area shape rectangle.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:Height"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Orientacio</ows:Identifier>
				<ows:Title>Orientation</ows:Title>
				<ows:Abstract>1: NW; 2: NE; 3: SW; 4: SE; 5: C.</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:Orientation"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ID</ows:Identifier>
				<ows:Title>ID</ows:Title>
				<ows:Abstract>Refers to the id property of each sensitive area. Example: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>HREF</ows:Identifier>
				<ows:Title>HREF</ows:Title>
				<ows:Abstract>Refers to the href property of each sensitive area. Example: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TITLE</ows:Identifier>
				<ows:Title>TITLE</ows:Title>
				<ows:Abstract>Refers to the title property of each sensitive area. Example: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ALT</ows:Identifier>
				<ows:Title>ALT</ows:Title>
				<ows:Abstract>Refers to the alt property of each sensitive area. Example: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ONCLICK</ows:Identifier>
				<ows:Title>ONCLICK</ows:Title>
				<ows:Abstract>Refers to the onclick property of each sensitive area. Example: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ONDBLCLICK</ows:Identifier>
				<ows:Title>ONDBLCLICK</ows:Title>
				<ows:Abstract>Refers to the ondblclick property of each sensitive area. Example: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ONMOUSEOVER</ows:Identifier>
				<ows:Title>ONMOUSEOVER</ows:Title>
				<ows:Abstract>Refers to the onmouseover property of each sensitive area. Example: "ESTACIO`ALIES_TAULA1`ESPECIES`ALIES_TAULA2`COD_FOREST"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>