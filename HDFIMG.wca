<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:HDFIMG:Param1</ows:Identifier>
		<ows:Title>HDFIMG</ows:Title>
		<ows:Abstract>Aquest programa permet importar fitxers de format HDF4 al format ràster IMG del MiraMon.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Programa per importar fitxers de format HDF4 a IMG"/>
		<ows:Metadata xlink:title="Abstract:Aquest programa permet importar fitxers de format HDF4 al format ràster IMG del MiraMon."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract><![CDATA[<li>1. Informació HDF</li><li>2. Importació HDF</li>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerHDF</ows:Identifier>
				<ows:Title>Fitxer HDF</ows:Title>
				<ows:Abstract>És el fitxer HDF a informar o importar (amb extensió). </ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerHDF"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-HDF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-HDF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>CarpetaSortida</ows:Identifier>
				<ows:Title>Carpeta Sortida</ows:Title>
				<ows:Abstract>És la carpeta, típicament preexistent, on es generarà la nova carpeta de sortida amb els fitxers producte de la importació (REL + IMG multibanda) per a l'opció 2 o de la petició d'informació (TXT) per a l'opció 1. Aquesta nova carpeta segueix l'esquema de noms detallat en l'ajuda del mòdul segons el producte. 
				</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:CarpetaSortida"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyUri">anyUri</ows:DataType>
				</LiteralOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
