<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:SubsTXT</ows:Identifier>
		<ows:Title>SubsTXT</ows:Title>
		<ows:Abstract>This program replaces text strings inside text files. The output file is the same as the input file (it is overwritten). Replacement is case-sensitive, but this behaviour can be disabled with /INSENSIBLE.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Text replacement inside a file"/>
		<ows:Metadata xlink:title="Abstract:This program replaces text strings inside text files. The output file is the same as the input file (it is overwritten). Replacement is case-sensitive, but this behaviour can be disabled with /INSENSIBLE."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitxer</ows:Identifier>
				<ows:Title>File</ows:Title>
				<ows:Abstract>Text file where replacements are performed.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:File"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-txt</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-txt</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Cadena1</ows:Identifier>
				<ows:Title>String1</ows:Title>
				<ows:Abstract>Text string to search for.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:String1"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Cadena2</ows:Identifier>
				<ows:Title>String2</ows:Title>
				<ows:Abstract>If /CADENA2_FITXER is not on the command line, this is the replacement string for String1. If String2 is omitted, an empty string is assumed and String1 is removed from the file.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:String2"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CADENA2_FITXER</ows:Identifier>
				<ows:Title>String2 from file</ows:Title>
				<ows:Abstract>If this flag is present, String2 is a file name containing the replacement text.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NOMES_TEXT</ows:Identifier>
				<ows:Title>Text only</ows:Title>
				<ows:Abstract>Apply replacement only to the given text string (up to 2041 characters).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ANSI</ows:Identifier>
				<ows:Title>ANSI</ows:Title>
				<ows:Abstract>The text file is ANSI-1252. If omitted, OEM850 is assumed.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DIERESI_ES_COMETES</ows:Identifier>
				<ows:Title>Umlaut means quotes</ows:Title>
				<ows:Abstract>Use umlaut instead of quotes in String1 and/or String2 when this flag is set.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SEQ_ESCAPAMENT</ows:Identifier>
				<ows:Title>Escape sequences</ows:Title>
				<ows:Abstract>String1 and/or String2 may use C-style escape sequences for control characters. For example, to convert UNIX returns to Windows returns it must be used SubsTXT File "\n" "\r\n" /SEQ_ESCAPAMENT and to convert tabs to spaces it must be used SubsTXT File "\t" " " /SEQ_ESCAPAMENT</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>INSENSIBLE</ows:Identifier>
				<ows:Title>Case insensitive</ows:Title>
				<ows:Abstract><![CDATA[Replacement applies regardless of upper or lower case. This version does not recognize equivalence in accented letters (à will not be considered equal to À); if this functionality is needed, write to <a href="mailto:suport@miramon.uab.cat">suport@miramon.uab.cat</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OCUR</ows:Identifier>
				<ows:Title>Maximum occurrences</ows:Title>
				<ows:Abstract>Maximum number of replacements to perform (for example 1 for only the first match).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>