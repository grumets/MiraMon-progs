<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CorrGeom:Param01:1&amp;Param06</ows:Identifier>
		<ows:Title>First degree polynomial fit (raster case)</ows:Title>
		<ows:Abstract>This method does not consider height information (elevation). Typically it is used to correct raster data with little distortion, such as scanned images and maps that were previously corrected (like orthophotos or topographic maps) or satellite images in areas with little marked relief, limited extent, and a relatively large pixel size in relation to the altitude of the satellite. If the objective is to obtain cartography with high geometric quality then the application of these methods to scanned aerial photographs or relatively detailed and extensive satellite images (like SPOT or Landsat-TM) is only appropriate in regions with flat relief.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Geometric correction of raster and vector files"/>
		<ows:Metadata xlink:title="Abstract:This program allows the geometric correction of rasters (IMG and JPG: satellite images aerial photographs, scanned maps...) or vector layers (VEC, PNT, ARC and their derivatives POL and NOD) using a series of n known control points."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>First degree polynomial fit (raster case).</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>cor</ows:Identifier>
				<ows:Title>Control</ows:Title>
				<ows:Abstract>Name of the file containing ground control points in COR format.</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:CorFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>f_i.img</ows:Identifier>
				<ows:Title>Image file</ows:Title>
				<ows:Abstract>The raster file to be corrected (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:InRasFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>int</ows:Identifier>
				<ows:Title>Resampling Type</ows:Title>
				<ows:Abstract><![CDATA[Criterion for deciding the output pixel value (resampling type):<ul><li>0: Nearest neighbour (thematic maps; conserve the original radiometric signal).</li><li>1: Bilinear interpolation (images for photointerpretations; DEMs).</li><li>2: I Bicubic interpolation (as 1; smoothed results but slower).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:resampling"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>2</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>xMin_pol</ows:Identifier>
				<ows:Title>X minimum</ows:Title>
				<ows:Abstract>The X minimum output raster bounding coordinates. Type 'x x x x' if you want the program to calculate them (the entire input raster will be corrected).</ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:xMin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>x</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>xMax_pol</ows:Identifier>
				<ows:Title>X maximum</ows:Title>
				<ows:Abstract>The X maximum output raster bounding coordinates. Type 'x x x x' if you want the program to calculate them (the entire input raster will be corrected).</ows:Abstract>
				<ows:Metadata xlink:title="Param08"/>
				<ows:Metadata xlink:title="Name:xMax"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>x</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>yMin_pol</ows:Identifier>
				<ows:Title>Y minimum</ows:Title>
				<ows:Abstract>The Y minimum output raster bounding coordinates. Type 'x x x x' if you want the program to calculate them (the entire input raster will be corrected).</ows:Abstract>
				<ows:Metadata xlink:title="Param09"/>
				<ows:Metadata xlink:title="Name:yMin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>x</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>yMax_pol</ows:Identifier>
				<ows:Title>Y maximum</ows:Title>
				<ows:Abstract>The Y maximum output raster bounding coordinates. Type 'x x x x' if you want the program to calculate them (the entire input raster will be corrected).</ows:Abstract>
				<ows:Metadata xlink:title="Param10"/>
				<ows:Metadata xlink:title="Name:yMax"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>x</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>res</ows:Identifier>
				<ows:Title>Output resolution</ows:Title>
				<ows:Abstract>Resolution of the output image in map units.</ows:Abstract>
				<ows:Metadata xlink:title="Param11"/>
				<ows:Metadata xlink:title="Name:res"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1.0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>NODATA</ows:Title>
				<ows:Abstract>NODATA value for the corrected image. If the user is completely sure that there will be no NODATA (after checking the geometry of the transformation, the extent, the range of the DEM...) then it is possible to give the value "NONE".</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PALETA</ows:Identifier>
				<ows:Title>Paleta</ows:Title>
				<ows:Abstract>Palette (p25, pal, p65) or symbol table (dbf) that determines which colour index is closest to the NODATA index for the corrected image.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pal</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pal</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-p25</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-p65</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>MULTIBANDA</ows:Title>
				<ows:Abstract>To simultaneously correct multiband raster images and to generate corresponding corrected bands.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefix</ows:Title>
				<ows:Abstract>For multiband images, the prefix to add to the original files when creating the corrected files. By default the prefix is c_.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Output reference system</ows:Title>
				<ows:Abstract>Identifier of the projection system of the output file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>cor_s</ows:Identifier>
				<ows:Title>Control error</ows:Title>
				<ows:Abstract>Name of the COR file that will contain the equations and the errors of the fit and the test points. The user may select NUL for automatic corrections where this file is not wanted.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:ErrCorFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>f_s_ras</ows:Identifier>
				<ows:Title>Output raster file</ows:Title>
				<ows:Abstract>Name of the output corrected file (without extension) or the name of the directory of the corrected files in the case of multiband images.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:OutRasFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CorrGeom:Param01:1&amp;!Param06</ows:Identifier>
		<ows:Title>First degree polynomial fit (vectorial case)</ows:Title>
		<ows:Abstract>This method does not consider height information (elevation). Typically it is used to correct vector data with little distortion.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>First degree polynomial fit (raster case).</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>cor</ows:Identifier>
				<ows:Title>Control</ows:Title>
				<ows:Abstract>Name of the file containing ground control points in COR format.</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:CorFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>f_i.vectorial</ows:Identifier>
				<ows:Title>Vectorial file to be corrected</ows:Title>
				<ows:Abstract>The vectorial file to be corrected (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:InVecFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_DECIMALS</ows:Identifier>
				<ows:Title>Number decimals</ows:Title>
				<ows:Abstract>Number of the coordinates of the vector output. Only for VEC files.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Output reference system</ows:Title>
				<ows:Abstract>Identifier of the projection system of the output file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>cor_s</ows:Identifier>
				<ows:Title>Control error</ows:Title>
				<ows:Abstract>Name of the COR file that will contain the equations and the errors of the fit and the test points. The user may select NUL for automatic corrections where this file is not wanted.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:ErrCorFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>f_s_vec</ows:Identifier>
				<ows:Title>Output vector file</ows:Title>
				<ows:Abstract>Name of the output corrected file (without extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:OutVecFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CorrGeom:Param01:2&amp;Param06</ows:Identifier>
		<ows:Title>Second degree polynomial fit (raster case)</ows:Title>
		<ows:Abstract>This method does not consider height information (elevation). Typically it is used to correct raster data with little distortion, such as scanned images and maps that were previously corrected (like orthophotos or topographic maps) or satellite images in areas with little marked relief, limited extent, and a relatively large pixel size in relation to the altitude of the satellite. If the objective is to obtain cartography with high geometric quality then the application of these methods to scanned aerial photographs or relatively detailed and extensive satellite images (like SPOT or Landsat-TM) is only appropriate in regions with flat relief.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Second degree polynomial fit (raster case).</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>cor</ows:Identifier>
				<ows:Title>Control</ows:Title>
				<ows:Abstract>Name of the file containing ground control points in COR format.</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:CorFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>f_i.img</ows:Identifier>
				<ows:Title>Image file</ows:Title>
				<ows:Abstract>The raster file to be corrected (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:InRasFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>int</ows:Identifier>
				<ows:Title>Resampling Type</ows:Title>
				<ows:Abstract><![CDATA[Criterion for deciding the output pixel value (resampling type):<ul><li>0: Nearest neighbour (thematic maps; conserve the original radiometric signal).</li><li>1: Bilinear interpolation (images for photointerpretations; DEMs).</li><li>2: I Bicubic interpolation (as 1; smoothed results but slower).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:resampling"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>2</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>xMin_pol</ows:Identifier>
				<ows:Title>X minimum</ows:Title>
				<ows:Abstract>The X minimum output raster bounding coordinates. Type 'x x x x' if you want the program to calculate them (the entire input raster will be corrected).</ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:xMin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>x</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>xMax_pol</ows:Identifier>
				<ows:Title>X maximum</ows:Title>
				<ows:Abstract>The X maximum output raster bounding coordinates. Type 'x x x x' if you want the program to calculate them (the entire input raster will be corrected).</ows:Abstract>
				<ows:Metadata xlink:title="Param08"/>
				<ows:Metadata xlink:title="Name:xMax"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>x</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>yMin_pol</ows:Identifier>
				<ows:Title>Y minimum</ows:Title>
				<ows:Abstract>The Y minimum output raster bounding coordinates. Type 'x x x x' if you want the program to calculate them (the entire input raster will be corrected).</ows:Abstract>
				<ows:Metadata xlink:title="Param09"/>
				<ows:Metadata xlink:title="Name:yMin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>x</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>yMax_pol</ows:Identifier>
				<ows:Title>Y maximum</ows:Title>
				<ows:Abstract>The Y maximum output raster bounding coordinates. Type 'x x x x' if you want the program to calculate them (the entire input raster will be corrected).</ows:Abstract>
				<ows:Metadata xlink:title="Param10"/>
				<ows:Metadata xlink:title="Name:yMax"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>x</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>res</ows:Identifier>
				<ows:Title>Output resolution</ows:Title>
				<ows:Abstract>Resolution of the output image in map units.</ows:Abstract>
				<ows:Metadata xlink:title="Param11"/>
				<ows:Metadata xlink:title="Name:res"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1.0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>NODATA</ows:Title>
				<ows:Abstract>NODATA value for the corrected image. If the user is completely sure that there will be no NODATA (after checking the geometry of the transformation, the extent, the range of the DEM...) then it is possible to give the value "NONE".</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PALETA</ows:Identifier>
				<ows:Title>Paleta</ows:Title>
				<ows:Abstract>Palette (p25, pal, p65) or symbol table (dbf) that determines which colour index is closest to the NODATA index for the corrected image.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pal</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pal</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-p25</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-p65</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>MULTIBANDA</ows:Title>
				<ows:Abstract>To simultaneously correct multiband raster images and to generate corresponding corrected bands.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefix</ows:Title>
				<ows:Abstract>For multiband images, the prefix to add to the original files when creating the corrected files. By default the prefix is c_.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Output reference system</ows:Title>
				<ows:Abstract>Identifier of the projection system of the output file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>cor_s</ows:Identifier>
				<ows:Title>Control error</ows:Title>
				<ows:Abstract>Name of the COR file that will contain the equations and the errors of the fit and the test points. The user may select NUL for automatic corrections where this file is not wanted.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:ErrCorFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>f_s_ras</ows:Identifier>
				<ows:Title>Output raster file</ows:Title>
				<ows:Abstract>Name of the output corrected file (without extension) or the name of the directory of the corrected files in the case of multiband images.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:OutRasFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CorrGeom:Param01:2&amp;!Param06</ows:Identifier>
		<ows:Title>Second degree polynomial fit (vectorial case)</ows:Title>
		<ows:Abstract>This method does not consider height information (elevation). Typically it is used to correct vector data with little distortion.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Second degree polynomial fit (raster case).</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>cor</ows:Identifier>
				<ows:Title>Control</ows:Title>
				<ows:Abstract>Name of the file containing ground control points in COR format.</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:CorFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>f_i.vectorial</ows:Identifier>
				<ows:Title>Vectorial file to be corrected</ows:Title>
				<ows:Abstract>The vectorial file to be corrected (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:InVecFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_DECIMALS</ows:Identifier>
				<ows:Title>Number decimals</ows:Title>
				<ows:Abstract>Number of the coordinates of the vector output. Only for VEC files.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Output reference system</ows:Title>
				<ows:Abstract>Identifier of the projection system of the output file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>cor_s</ows:Identifier>
				<ows:Title>Control error</ows:Title>
				<ows:Abstract>Name of the COR file that will contain the equations and the errors of the fit and the test points. The user may select NUL for automatic corrections where this file is not wanted.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:ErrCorFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>f_s_vec</ows:Identifier>
				<ows:Title>Output vector file</ows:Title>
				<ows:Abstract>Name of the output corrected file (without extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:OutVecFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CorrGeom:Param01:3</ows:Identifier>
		<ows:Title>Polynomial fit with Z for the columns and first order polynomial without Z for the rows</ows:Title>
		<ows:Abstract><![CDATA[With this method the fit of the columns is made using a polynomial that simultaneously takes into account X, Y and Z. As for the rows, the fit can be made in three different ways: considering that there is no pitching movement of the sensor during the acquisition of the image, considering that the pitch is constant or considering that the pitch varies linearly. For more details see:<li> PALÀ, V. &amp; X. PONS (1995) "Incorporation of relief into geometric corrections based on polynomials" Photogrammetric Engineering &amp; Remote Sensing, 61(7):935-944.</li>]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Polynomial fit with Z for the columns and first order polynomial without Z for the rows.</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>cor</ows:Identifier>
				<ows:Title>Control</ows:Title>
				<ows:Abstract>Name of the file containing ground control points in COR format.</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:CorFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>f_i.img</ows:Identifier>
				<ows:Title>Image file</ows:Title>
				<ows:Abstract>The raster file to be corrected (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:InRasFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>int</ows:Identifier>
				<ows:Title>Resampling Type</ows:Title>
				<ows:Abstract><![CDATA[Criterion for deciding the output pixel value (resampling type):<ul><li>0: Nearest neighbour (thematic maps; conserve the original radiometric signal).</li><li>1: Bilinear interpolation (images for photointerpretations; DEMs).</li><li>2: I Bicubic interpolation (as 1; smoothed results but slower).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:resampling"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>2</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MDE</ows:Identifier>
				<ows:Title>Digital Elevation Model</ows:Title>
				<ows:Abstract>Raster file with the DEM of the region.</ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:DEM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>NODATA</ows:Title>
				<ows:Abstract>NODATA value for the corrected image. If the user is completely sure that there will be no NODATA (after checking the geometry of the transformation, the extent, the range of the DEM...) then it is possible to give the value "NONE".</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PALETA</ows:Identifier>
				<ows:Title>Paleta</ows:Title>
				<ows:Abstract>Palette (p25, pal, p65) or symbol table (dbf) that determines which colour index is closest to the NODATA index for the corrected image.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pal</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pal</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-p25</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-p65</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>MULTIBANDA</ows:Title>
				<ows:Abstract>To simultaneously correct multiband raster images and to generate corresponding corrected bands.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefix</ows:Title>
				<ows:Abstract>For multiband images, the prefix to add to the original files when creating the corrected files. By default the prefix is c_.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MDE_MULTIBANDA</ows:Identifier>
				<ows:Title>Multiband Digital Elevation Model</ows:Title>
				<ows:Abstract>For simultaneously correcting multiband rasters having different pixel sizes and for which there are DEMs for each cell size.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>cor_s</ows:Identifier>
				<ows:Title>Control error</ows:Title>
				<ows:Abstract>Name of the COR file that will contain the equations and the errors of the fit and the test points. The user may select NUL for automatic corrections where this file is not wanted.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:ErrCorFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>f_s_ras</ows:Identifier>
				<ows:Title>Output raster file</ows:Title>
				<ows:Abstract>Name of the output corrected file (without extension) or the name of the directory of the corrected files in the case of multiband images.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:OutRasFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CorrGeom:Param01:4</ows:Identifier>
		<ows:Title>As for 3 but with a constant pitch and Z for the rows</ows:Title>
		<ows:Abstract><![CDATA[With this method the fit of the columns is made using a polynomial that simultaneously takes into account X, Y and Z. As for the rows, the fit can be made in three different ways: considering that there is no pitching movement of the sensor during the acquisition of the image, considering that the pitch is constant or considering that the pitch varies linearly. For more details see:<li> PALÀ, V. &amp; X. PONS (1995) "Incorporation of relief into geometric corrections based on polynomials" Photogrammetric Engineering &amp; Remote Sensing, 61(7):935-944.</li>]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>As for 3 but with a constant pitch and Z for the rows.</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>cor</ows:Identifier>
				<ows:Title>Control</ows:Title>
				<ows:Abstract>Name of the file containing ground control points in COR format.</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:CorFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>f_i.img</ows:Identifier>
				<ows:Title>Image file</ows:Title>
				<ows:Abstract>The raster file to be corrected (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:InRasFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>int</ows:Identifier>
				<ows:Title>Resampling Type</ows:Title>
				<ows:Abstract><![CDATA[Criterion for deciding the output pixel value (resampling type):<ul><li>0: Nearest neighbour (thematic maps; conserve the original radiometric signal).</li><li>1: Bilinear interpolation (images for photointerpretations; DEMs).</li><li>2: I Bicubic interpolation (as 1; smoothed results but slower).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:resampling"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>2</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MDE</ows:Identifier>
				<ows:Title>Digital Elevation Model</ows:Title>
				<ows:Abstract>Raster file with the DEM of the region.</ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:DEM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>NODATA</ows:Title>
				<ows:Abstract>NODATA value for the corrected image. If the user is completely sure that there will be no NODATA (after checking the geometry of the transformation, the extent, the range of the DEM...) then it is possible to give the value "NONE".</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PALETA</ows:Identifier>
				<ows:Title>Paleta</ows:Title>
				<ows:Abstract>Palette (p25, pal, p65) or symbol table (dbf) that determines which colour index is closest to the NODATA index for the corrected image.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pal</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pal</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-p25</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-p65</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>MULTIBANDA</ows:Title>
				<ows:Abstract>To simultaneously correct multiband raster images and to generate corresponding corrected bands.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefix</ows:Title>
				<ows:Abstract>For multiband images, the prefix to add to the original files when creating the corrected files. By default the prefix is c_.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MDE_MULTIBANDA</ows:Identifier>
				<ows:Title>Multiband Digital Elevation Model</ows:Title>
				<ows:Abstract>For simultaneously correcting multiband rasters having different pixel sizes and for which there are DEMs for each cell size.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>cor_s</ows:Identifier>
				<ows:Title>Control error</ows:Title>
				<ows:Abstract>Name of the COR file that will contain the equations and the errors of the fit and the test points. The user may select NUL for automatic corrections where this file is not wanted.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:ErrCorFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>f_s_ras</ows:Identifier>
				<ows:Title>Output raster file</ows:Title>
				<ows:Abstract>Name of the output corrected file (without extension) or the name of the directory of the corrected files in the case of multiband images.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:OutRasFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CorrGeom:Param01:5</ows:Identifier>
		<ows:Title>As for 3 but with a variable pitch and Z for the rows</ows:Title>
		<ows:Abstract><![CDATA[With this method the fit of the columns is made using a polynomial that simultaneously takes into account X, Y and Z. As for the rows, the fit can be made in three different ways: considering that there is no pitching movement of the sensor during the acquisition of the image, considering that the pitch is constant or considering that the pitch varies linearly. For more details see:<li>PALÀ, V. &amp; X. PONS (1995) "Incorporation of relief into geometric corrections based on polynomials" Photogrammetric Engineering &amp; Remote Sensing, 61(7):935-944.</li>]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>As for 3 but with a variable pitch and Z for the rows.</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>5</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>cor</ows:Identifier>
				<ows:Title>Control</ows:Title>
				<ows:Abstract>Name of the file containing ground control points in COR format.</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:CorFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>f_i.img</ows:Identifier>
				<ows:Title>Image file</ows:Title>
				<ows:Abstract>The raster file to be corrected (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:InRasFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>int</ows:Identifier>
				<ows:Title>Resampling Type</ows:Title>
				<ows:Abstract><![CDATA[Criterion for deciding the output pixel value (resampling type):<ul><li>0: Nearest neighbour (thematic maps; conserve the original radiometric signal).</li><li>1: Bilinear interpolation (images for photointerpretations; DEMs).</li><li>2: I Bicubic interpolation (as 1; smoothed results but slower).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:resampling"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>2</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MDE</ows:Identifier>
				<ows:Title>Digital Elevation Model</ows:Title>
				<ows:Abstract>Raster file with the DEM of the region.</ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:DEM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>NODATA</ows:Title>
				<ows:Abstract>NODATA value for the corrected image. If the user is completely sure that there will be no NODATA (after checking the geometry of the transformation, the extent, the range of the DEM...) then it is possible to give the value "NONE".</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PALETA</ows:Identifier>
				<ows:Title>Paleta</ows:Title>
				<ows:Abstract>Palette (p25, pal, p65) or symbol table (dbf) that determines which colour index is closest to the NODATA index for the corrected image.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pal</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pal</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-p25</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-p65</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>MULTIBANDA</ows:Title>
				<ows:Abstract>To simultaneously correct multiband raster images and to generate corresponding corrected bands.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefix</ows:Title>
				<ows:Abstract>For multiband images, the prefix to add to the original files when creating the corrected files. By default the prefix is c_.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MDE_MULTIBANDA</ows:Identifier>
				<ows:Title>Multiband Digital Elevation Model</ows:Title>
				<ows:Abstract>For simultaneously correcting multiband rasters having different pixel sizes and for which there are DEMs for each cell size.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>cor_s</ows:Identifier>
				<ows:Title>Control error</ows:Title>
				<ows:Abstract>Name of the COR file that will contain the equations and the errors of the fit and the test points. The user may select NUL for automatic corrections where this file is not wanted.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:ErrCorFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>f_s_ras</ows:Identifier>
				<ows:Title>Output raster file</ows:Title>
				<ows:Abstract>Name of the output corrected file (without extension) or the name of the directory of the corrected files in the case of multiband images.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:OutRasFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CorrGeom:Param01:6</ows:Identifier>
		<ows:Title>Colinearity equations fit</ows:Title>
		<ows:Abstract><![CDATA[The parameters used in the colinearity equations are: position (Xc, Yc, Zc) and attitude (omega, fi, kappa) of the camera or sensor, the camera focal length (f) and the coordinates of the principal point (x_pp, y_pp) of the image. The user may decide which of these parameters to estimate by fitting and which are fixed. For those which are to be estimated it is useful to give some approximate values which will help the program converge more rapidly. In some cases, if the initial parameter is completely unknown or the approximation is very poor, the algorithm may not converge or unsatisfactory solutions may be produced. If all the parameters are known and fixed then the transformation is performed without using control points and using the test points just to evaluate the error of the fit. These are the initial values of the flight parameters in the first iteration:<ul><li>Roll: omega = 0</li><li>Pitch: fi = 0</li><li>Yaw: kappa = Various values are tried and the one that gives the smallest RMS in the first iterations is used.</li><li>Xc = Average of the X coordinates of the control points (in the reference system).</li><li>Yc = Average of the Y coordinates of the control points (in the reference system).</li><li>ZZc = Average Zc + flight altitude, approx. 2000-3000 m</li></ul>When the principal point (x_pp, y_pp) has to be fit the program takes as initial values:<ul><li>x_pp = Average of the x coordinates (in original units) of the control points or the middle of the raster.</li><li>y_pp = Average of the y coordinates (in original units) of the control points or the middle of the raster</li></ul>THowever, sometimes these averages can be quite distant from the real principal point and in these cases the program may not converge (eg if only a fragment from the edge of an aerial photograph is scanned). The program allows the user to change the value for another estimated by eye at the intersection of the lines joining the fiducial points. Remember to use always the same measurement system, consistent with the original reference units.<br/>For fitting the focal length it is necessary to choose some initial value close to the real value, typically between 15 and 35 mm for digital cameras and between 50 and 250 mm for analogical cameras.<br/>In addition it is necessary to know the number of points per inch (ppp, ppi or dpi) of the scanned image (1 inch = 25.4 mm). For analogue photos common values are between 400 and 200 dpi. For digital photos refer to the manufacturer's technical specifications (for example the AA497-AMDC 28.0 camera with 2024 columns x 2041 rows and a sensor size of 18x18 mm gives a resolution of 2811-2835 dpi).]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Colinearity equations fit.</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>6</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>cor</ows:Identifier>
				<ows:Title>Control</ows:Title>
				<ows:Abstract>Name of the file containing ground control points in COR format.</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:CorFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>f_i.img</ows:Identifier>
				<ows:Title>Image file</ows:Title>
				<ows:Abstract>The raster file to be corrected (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:InRasFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>int</ows:Identifier>
				<ows:Title>Resampling Type</ows:Title>
				<ows:Abstract><![CDATA[Criterion for deciding the output pixel value (resampling type):<ul><li>0: Nearest neighbour (thematic maps; conserve the original radiometric signal).</li><li>1: Bilinear interpolation (images for photointerpretations; DEMs).</li><li>2: I Bicubic interpolation (as 1; smoothed results but slower).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:resampling"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>2</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>MDE</ows:Identifier>
				<ows:Title>Digital Elevation Model</ows:Title>
				<ows:Abstract>Raster file with the DEM of the region.</ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:DEM"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>dpi</ows:Identifier>
				<ows:Title>Resolution</ows:Title>
				<ows:Abstract>For scanned images or digital photos, the resolution in dots per inch (dpi).</ows:Abstract>
				<ows:Metadata xlink:title="Param08"/>
				<ows:Metadata xlink:title="Name:Resolution"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>iter</ows:Identifier>
				<ows:Title>Iterations</ows:Title>
				<ows:Abstract>Maximum number of iterations when using the colinearity equations (sugg. 20).</ows:Abstract>
				<ows:Metadata xlink:title="Param09"/>
				<ows:Metadata xlink:title="Name:Iterations"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>op_posicio</ows:Identifier>
				<ows:Title>Position Options</ows:Title>
				<ows:Abstract>Option (posiction) that define whether the parameters used in the colinearity equations are fixed and known (3), estimated (2) or unknown (0). The value (1) is for the special case where only the flight altitude is estimated but not the X, Y position of the plane.</ows:Abstract>
				<ows:Metadata xlink:title="Param10"/>
				<ows:Metadata xlink:title="Name:PositOpt"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>op_actitud</ows:Identifier>
				<ows:Title>Attitude options</ows:Title>
				<ows:Abstract>Options (attitude) that define whether the parameters used in the colinearity equations are fixed and known (3), estimated (2) or unknown (0). The value (1) is for the special case where only the flight altitude is estimated but not the X, Y position of the plane.</ows:Abstract>
				<ows:Metadata xlink:title="Param11"/>
				<ows:Metadata xlink:title="Name:AttitOpt"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>op_focal</ows:Identifier>
				<ows:Title>Focal option</ows:Title>
				<ows:Abstract>Option (focal) that define whether the parameters used in the colinearity equations are fixed and known (3), estimated (2) or unknown (0). The value (1) is for the special case where only the flight altitude is estimated but not the X, Y position of the plane.</ows:Abstract>
				<ows:Metadata xlink:title="Param12"/>
				<ows:Metadata xlink:title="Name:FocalOpt"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>op_ppral</ows:Identifier>
				<ows:Title>Principal point options</ows:Title>
				<ows:Abstract>Option (principal point) that define whether the parameters used in the colinearity equations are fixed and known (3), estimated (2) or unknown (0). The value (1) is for the special case where only the flight altitude is estimated but not the X, Y position of the plane.</ows:Abstract>
				<ows:Metadata xlink:title="Param13"/>
				<ows:Metadata xlink:title="Name:PrincPtOpt"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>XCAM</ows:Identifier>
				<ows:Title>X camera</ows:Title>
				<ows:Abstract>X coordinate of the camera or sensor in the output reference system. They may be known positions or estimated values. If only /ZCAM is given then this indicates that only the plane altitude is estimated.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>YCAM</ows:Identifier>
				<ows:Title>Y camera</ows:Title>
				<ows:Abstract>Y coordinate of the camera or sensor in the output reference system. They may be known positions or estimated values. If only /ZCAM is given then this indicates that only the plane altitude is estimated.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ZCAM</ows:Identifier>
				<ows:Title>Z camera</ows:Title>
				<ows:Abstract>Z coordinate of the camera or sensor in the output reference system. They may be known positions or estimated values. If only /ZCAM is given then this indicates that only the plane altitude is estimated.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>WCAM</ows:Identifier>
				<ows:Title>Omega</ows:Title>
				<ows:Abstract>Indicate in degrees the omega attitude angle of the sensor, whether fixed or estimated.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FCAM</ows:Identifier>
				<ows:Title>Phi</ows:Title>
				<ows:Abstract>Indicate in degrees the "phi" attitude angle of the sensor, whether fixed or estimated..</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>KCAM</ows:Identifier>
				<ows:Title>Kappa</ows:Title>
				<ows:Abstract>Indicate in degrees the "kappa" attitude angle of the sensor, whether fixed or estimated.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FOCAL</ows:Identifier>
				<ows:Title>Focal</ows:Title>
				<ows:Abstract>Indicates in milimetres the known or estimated focal length of the camera.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ANALOG</ows:Identifier>
				<ows:Title>Analogic camera</ows:Title>
				<ows:Abstract>If the focal length of the camera is unknown, knowing whether it is digital or analog (this case) helps to take an initial value that converges more quickly to the adjusted value.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DIGITAL</ows:Identifier>
				<ows:Title>Digital cámera</ows:Title>
				<ows:Abstract>If the focal length of the camera is unknown it can be useful to know whether the camera is digital or analogue when selecting an initial value that is more likely to produce a rapid convergence to the fit value.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>XPP</ows:Identifier>
				<ows:Title>XPP</ows:Title>
				<ows:Abstract>X coordinate or approximate initial values of the principal point in the original coordinates.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>YPP</ows:Identifier>
				<ows:Title>YPP</ows:Title>
				<ows:Abstract>Y coordinate or approximate initial values of the principal point in the original coordinates.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PMPCONTROL</ows:Identifier>
				<ows:Title>Estimated control points</ows:Title>
				<ows:Abstract>If the location of the principal point is unknown, then the initial values can be estimated as the average of either the control points or the central point of the raster to be corrected.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PMRASTER</ows:Identifier>
				<ows:Title>Average point raster</ows:Title>
				<ows:Abstract>Average raster point</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>NODATA</ows:Title>
				<ows:Abstract>NODATA value for the corrected image. If the user is completely sure that there will be no NODATA (after checking the geometry of the transformation, the extent, the range of the DEM...) then it is possible to give the value "NONE".</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PALETA</ows:Identifier>
				<ows:Title>Paleta</ows:Title>
				<ows:Abstract>Palette (p25, pal, p65) or symbol table (dbf) that determines which colour index is closest to the NODATA index for the corrected image.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pal</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pal</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-p25</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-p65</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>MULTIBANDA</ows:Title>
				<ows:Abstract>To simultaneously correct multiband raster images and to generate corresponding corrected bands.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefix</ows:Title>
				<ows:Abstract>For multiband images, the prefix to add to the original files when creating the corrected files. By default the prefix is c_.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MDE_MULTIBANDA</ows:Identifier>
				<ows:Title>Multiband Digital Elevation Model</ows:Title>
				<ows:Abstract>For simultaneously correcting multiband rasters having different pixel sizes and for which there are DEMs for each cell size.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>cor_s</ows:Identifier>
				<ows:Title>Control error</ows:Title>
				<ows:Abstract>Name of the COR file that will contain the equations and the errors of the fit and the test points. The user may select NUL for automatic corrections where this file is not wanted.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:ErrCorFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-cor</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>f_s_ras</ows:Identifier>
				<ows:Title>Output raster file</ows:Title>
				<ows:Abstract>Name of the output corrected file (without extension) or the name of the directory of the corrected files in the case of multiband images.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:OutRasFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CorrGeom:Param01:7&amp;Param06</ows:Identifier>
		<ows:Title>Geometric Transformations (raster case)</ows:Title>
		<ows:Abstract><![CDATA[These types of transformations follow a different philosophy from the previous ones: instead of adjusting the transformation using control points, we want to specify the transformation parameters ourselves because we know them a priori. For instance, we may have scanned a document rotated 90º to fit better into the scanner once rotated; in this case, it will be easier to indicate that we want to apply a 90º rotation to return it to its original position and view it in a "natural" way (perhaps before placing control points for fine-tuning the geometry). A second example would be having a dataset where the horizontal reference system units are in km, and we want to convert them to meters, which requires applying a scaling factor of 1000. <br>The types of operations offered are translations, scalings, shears, rotations, perspectives, and mirrors. For affine transformations (all except perspective), a transformation origin can be specified, and for perspective, an envelope over which to act can be specified. The possibility of choosing this is provided so that if we want to modify a vector layer over an already modified raster, we can use the raster's envelope to perfectly overlay the transformed vector layer onto the modified raster. <br>It is possible to perform a sequence of transformations and/or a perspective one after the other on a raster or vector, with the sole restriction that only one perspective can be used.]]></ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Geometric Transformations (raster case).</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>7</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>f_i.img</ows:Identifier>
				<ows:Title>Image file</ows:Title>
				<ows:Abstract>The raster file to be corrected (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:InRasFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>int</ows:Identifier>
				<ows:Title>Resampling Type</ows:Title>
				<ows:Abstract><![CDATA[Criterion for deciding the output pixel value (resampling type):<ul><li>0: Nearest neighbour (thematic maps; conserve the original radiometric signal).</li><li>1: Bilinear interpolation (images for photointerpretations; DEMs).</li><li>2: I Bicubic interpolation (as 1; smoothed results but slower).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:resampling"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>2</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>T</ows:Identifier>
				<ows:Title>Translation</ows:Title>
				<ows:Abstract>Indicate translation</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:T"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Tx</ows:Identifier>
				<ows:Title>X value</ows:Title>
				<ows:Abstract>X value of the translation.</ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:Tx"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Ty</ows:Identifier>
				<ows:Title>Y Value</ows:Title>
				<ows:Abstract>Y Value of the translation</ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:Ty"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>E</ows:Identifier>
				<ows:Title>Scaling</ows:Title>
				<ows:Abstract>Indicate scaling geometric transformation.</ows:Abstract>
				<ows:Metadata xlink:title="Param08"/>
				<ows:Metadata xlink:title="Name:E"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Ex</ows:Identifier>
				<ows:Title>X value</ows:Title>
				<ows:Abstract>X value</ows:Abstract>
				<ows:Metadata xlink:title="Param09"/>
				<ows:Metadata xlink:title="Name:Ex"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Ey</ows:Identifier>
				<ows:Title>Y value</ows:Title>
				<ows:Abstract>Y value</ows:Abstract>
				<ows:Metadata xlink:title="Param10"/>
				<ows:Metadata xlink:title="Name:Ey"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>I</ows:Identifier>
				<ows:Title>Inclination</ows:Title>
				<ows:Abstract>Indicate an inclination geometric transformation.</ows:Abstract>
				<ows:Metadata xlink:title="Param11"/>
				<ows:Metadata xlink:title="Name:I"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Id</ows:Identifier>
				<ows:Title>Inclination axis</ows:Title>
				<ows:Abstract>Indicate the axis the inclination.</ows:Abstract>
				<ows:Metadata xlink:title="Param12"/>
				<ows:Metadata xlink:title="Name:Id"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>x</ows:Value>
						<ows:Value>y</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Ir</ows:Identifier>
				<ows:Title>Indicate inclination reason.</ows:Title>
				<ows:Abstract>Inclination reason.</ows:Abstract>
				<ows:Metadata xlink:title="Param13"/>
				<ows:Metadata xlink:title="Name:Ir"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>R</ows:Identifier>
				<ows:Title>Rotation</ows:Title>
				<ows:Abstract>Indicate Rotation.</ows:Abstract>
				<ows:Metadata xlink:title="Param14"/>
				<ows:Metadata xlink:title="Name:R"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>g</ows:Identifier>
				<ows:Title>Degrees</ows:Title>
				<ows:Abstract>Degrees</ows:Abstract>
				<ows:Metadata xlink:title="Param15"/>
				<ows:Metadata xlink:title="Name:g"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>P</ows:Identifier>
				<ows:Title>Perspective</ows:Title>
				<ows:Abstract>Indicate prespective</ows:Abstract>
				<ows:Metadata xlink:title="Param16"/>
				<ows:Metadata xlink:title="Name:P"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Pr</ows:Identifier>
				<ows:Title>Perspective reason</ows:Title>
				<ows:Abstract>Indicate perspective reason.</ows:Abstract>
				<ows:Metadata xlink:title="Param17"/>
				<ows:Metadata xlink:title="Name:Pr"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>1</ows:MaximumValue>
							<ows:Spacing></ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>M</ows:Identifier>
				<ows:Title>Mirror</ows:Title>
				<ows:Abstract>Indicate mirror.</ows:Abstract>
				<ows:Metadata xlink:title="Param18"/>
				<ows:Metadata xlink:title="Name:M"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Md</ows:Identifier>
				<ows:Title>Mirror direction</ows:Title>
				<ows:Abstract>Indicate mirror direction. If we want to make a mirror with respect to the horizontal axis we must use the value 'x' (or 'X'). If we want to make a mirror with respect to the vertical axis we must use the value 'y' (or 'Y').</ows:Abstract>
				<ows:Metadata xlink:title="Param19"/>
				<ows:Metadata xlink:title="Name:Md"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>x</ows:Value>
						<ows:Value>y</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>NODATA</ows:Title>
				<ows:Abstract>NODATA value for the corrected image. If the user is completely sure that there will be no NODATA (after checking the geometry of the transformation, the extent, the range of the DEM...) then it is possible to give the value "NONE".</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PALETA</ows:Identifier>
				<ows:Title>Paleta</ows:Title>
				<ows:Abstract>Palette (p25, pal, p65) or symbol table (dbf) that determines which colour index is closest to the NODATA index for the corrected image.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pal</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pal</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-p25</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-p65</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>MULTIBANDA</ows:Title>
				<ows:Abstract>To simultaneously correct multiband raster images and to generate corresponding corrected bands.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefix</ows:Title>
				<ows:Abstract>For multiband images, the prefix to add to the original files when creating the corrected files. By default the prefix is c_.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MDE_MULTIBANDA</ows:Identifier>
				<ows:Title>Multiband Digital Elevation Model</ows:Title>
				<ows:Abstract>For simultaneously correcting multiband rasters having different pixel sizes and for which there are DEMs for each cell size.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>YORI</ows:Identifier>
				<ows:Title>Transformation origin on the Y axis</ows:Title>
				<ows:Abstract>Indicates the origin on the Y axis of the transformation if there is any.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>XMAX</ows:Identifier>
				<ows:Title>Màximum X of the area to apply transformation.</ows:Title>
				<ows:Abstract>Maximum X coordinate of the area in which you want to apply the transformation. It is only useful when a perspective is applied because in transformations without perspective /XORI, /YORI is used.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>XORI</ows:Identifier>
				<ows:Title>Transformation origin on the X axis</ows:Title>
				<ows:Abstract>Indicates the origin on the X axis of the transformation if there is any.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>YMIN</ows:Identifier>
				<ows:Title>Minimum Y of the area to apply transformation.</ows:Title>
				<ows:Abstract>Minimum Y coordinate of the area in which you want to apply the transformation. It is only useful when a perspective is applied because in transformations without perspective /XORI, /YORI is used.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>XMIN</ows:Identifier>
				<ows:Title>Minimum X of the area to apply transformation.</ows:Title>
				<ows:Abstract>Minimum X coordinate of the area in which you want to apply the transformation. It is only useful when a perspective is applied because in transformations without perspective /XORI, /YORI is used.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>YMAX</ows:Identifier>
				<ows:Title>Màximum Y of the area to apply transformation.</ows:Title>
				<ows:Abstract>Maximum Y coordinate of the area in which you want to apply the transformation. It is only useful when a perspective is applied because in transformations without perspective /XORI, /YORI is used.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>f_s_ras</ows:Identifier>
				<ows:Title>Output raster file</ows:Title>
				<ows:Abstract>Name of the output corrected file (without extension) or the name of the directory of the corrected files in the case of multiband images.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:OutRasFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CorrGeom:Param01:7&amp;!Param06</ows:Identifier>
		<ows:Title>Geometric Transformations (vectorial case)</ows:Title>
		<ows:Abstract>These types of transformations follow a different philosophy from the previous ones: instead of adjusting the transformation using control points, we want to specify the transformation parameters ourselves because we know them a priori. An example would be having an old vector dataset from software that stored coordinates with single precision (such as PC-Arc/Info) and, for this reason, truncated the most significant digit when it was constant for the entire layer (for example, in Catalonia in UTM-31N, it was common to omit the 4 from the Y coordinate, so a coordinate like 4619254.734 was written as 619254.734, maintaining decimetric precision); in this case, we can recover the original coordinates by specifying a translation transformation of magnitude 4000000. Finally, a third example would be having a dataset where the horizontal reference system units are in km, and we want to convert them to meters, which requires applying a scaling factor of 1000.  The types of operations offered are translations, scalings, shears, rotations, perspectives, and mirrors. For affine transformations (all except perspective), a transformation origin can be specified, and for perspective, an envelope over which to act can be specified. The possibility of choosing this is provided so that if we want to modify a vector layer over an already modified raster, we can use the raster's envelope to perfectly overlay the transformed vector layer onto the modified raster.  It is possible to perform a sequence of transformations and/or a perspective one after the other on a raster or vector, with the sole restriction that only one perspective can be used.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Geometric Transformations (raster case).</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>7</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>f_i.vectorial</ows:Identifier>
				<ows:Title>Vectorial file to be corrected</ows:Title>
				<ows:Abstract>The vectorial file to be corrected (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:InVecFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>T</ows:Identifier>
				<ows:Title>Translation</ows:Title>
				<ows:Abstract>Indicate translation</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:T"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Tx</ows:Identifier>
				<ows:Title>X value</ows:Title>
				<ows:Abstract>X value of the translation.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:Tx"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Ty</ows:Identifier>
				<ows:Title>Y Value</ows:Title>
				<ows:Abstract>Y Value of the translation</ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:Ty"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>E</ows:Identifier>
				<ows:Title>Scaling</ows:Title>
				<ows:Abstract>Indicate scaling geometric transformation.</ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:E"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Ex</ows:Identifier>
				<ows:Title>X value</ows:Title>
				<ows:Abstract>X value</ows:Abstract>
				<ows:Metadata xlink:title="Param08"/>
				<ows:Metadata xlink:title="Name:Ex"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Ey</ows:Identifier>
				<ows:Title>Y value</ows:Title>
				<ows:Abstract>Y value</ows:Abstract>
				<ows:Metadata xlink:title="Param09"/>
				<ows:Metadata xlink:title="Name:Ey"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>I</ows:Identifier>
				<ows:Title>Inclination</ows:Title>
				<ows:Abstract>Indicate an inclination geometric transformation.</ows:Abstract>
				<ows:Metadata xlink:title="Param10"/>
				<ows:Metadata xlink:title="Name:I"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Id</ows:Identifier>
				<ows:Title>Inclination axis</ows:Title>
				<ows:Abstract>Indicate the axis the inclination.</ows:Abstract>
				<ows:Metadata xlink:title="Param11"/>
				<ows:Metadata xlink:title="Name:Id"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>x</ows:Value>
						<ows:Value>y</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Ir</ows:Identifier>
				<ows:Title>Indicate inclination reason.</ows:Title>
				<ows:Abstract>Inclination reason.</ows:Abstract>
				<ows:Metadata xlink:title="Param12"/>
				<ows:Metadata xlink:title="Name:Ir"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>R</ows:Identifier>
				<ows:Title>Rotation</ows:Title>
				<ows:Abstract>Indicate Rotation.</ows:Abstract>
				<ows:Metadata xlink:title="Param13"/>
				<ows:Metadata xlink:title="Name:R"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>g</ows:Identifier>
				<ows:Title>Degrees</ows:Title>
				<ows:Abstract>Degrees</ows:Abstract>
				<ows:Metadata xlink:title="Param14"/>
				<ows:Metadata xlink:title="Name:g"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>P</ows:Identifier>
				<ows:Title>Perspective</ows:Title>
				<ows:Abstract>Indicate prespective</ows:Abstract>
				<ows:Metadata xlink:title="Param15"/>
				<ows:Metadata xlink:title="Name:P"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Pr</ows:Identifier>
				<ows:Title>Perspective reason</ows:Title>
				<ows:Abstract>Indicate perspective reason.</ows:Abstract>
				<ows:Metadata xlink:title="Param16"/>
				<ows:Metadata xlink:title="Name:Pr"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>1</ows:MaximumValue>
							<ows:Spacing></ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>M</ows:Identifier>
				<ows:Title>Mirror</ows:Title>
				<ows:Abstract>Indicate mirror.</ows:Abstract>
				<ows:Metadata xlink:title="Param17"/>
