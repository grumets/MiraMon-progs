			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MDE_MULTIBANDA</ows:Identifier>
				<ows:Title>Multibanda Digital Elevation Model</ows:Title>
				<ows:Abstract>For simultaneously correcting multiband rasters having different pixel sizes and for which there are DEMs for each cell size.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>f_s</ows:Identifier>
				<ows:Title>Output file</ows:Title>
				<ows:Abstract>Name of the output corrected file (without extension) or the name of the directory of the corrected files in the case of multiband images.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:OutFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-ARC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-ARC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-PNT</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-VEC</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CorrGeom:Param1:8</ows:Identifier>
		<ows:Title>Adjustment based on reference points</ows:Title>
		<ows:Abstract>
			<![CDATA[In this case, the geometric correction is made from two rasters that, when paired, provide the origin position of each pixel of the destination image (therefore, 
					 they typically have the same dimensions as this one) and together they form, therefore, a mesh of reference.<br>
					 The procedure is based on the following: For each pixel center of the desired output raster (rectified, corrected, georeferenced, depending on what the coordinates are used for), 
					 the program searches for the values of this position in the reference rasters (one for the axis of the X and the other by the Y axis), which ends up providing the specific pixel 
					 in the image to be corrected that is closest to the coordinates of the reference rasters. The value in the source raster will be assigned to this output raster pixel when the rescan 
					 method is nearest neighbor, or it will be interpolated from neighbors in the other available rescan methods. By default, the output file will have the same envelope, pixel side, 
					 and reference system as the XY reference rasters.<br>
					 <br><img src="CorrGeomAjPtsRefer.png" alt="Adjustment based on reference points." width="800"><br>
					]]>
		</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>Adjustment based on reference points.</ows:Abstract>
				<ows:Metadata xlink:title="Param01"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer ">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>8</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>f_i.img</ows:Identifier>
				<ows:Title>Raster File</ows:Title>
				<ows:Abstract>The raster file to be corrected (with extension).</ows:Abstract>
				<ows:Metadata xlink:title="Param02"/>
				<ows:Metadata xlink:title="Name:InRast"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>f_x</ows:Identifier>
				<ows:Title>X coordinate file</ows:Title>
				<ows:Abstract>It is the name of the raster file (with extension) with X coordinates where the value is searched for in the source file.</ows:Abstract>
				<ows:Metadata xlink:title="Param04"/>
				<ows:Metadata xlink:title="Name:XCoorFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>f_y</ows:Identifier>
				<ows:Title>Y coordinate file</ows:Title>
				<ows:Abstract>It is the name of the raster file (with extension) with Y coordinates where the value is searched for in the source file.</ows:Abstract>
				<ows:Metadata xlink:title="Param05"/>
				<ows:Metadata xlink:title="Name:YCoorFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>int</ows:Identifier>
				<ows:Title>Resampling Type</ows:Title>
				<ows:Abstract> Criterion for deciding the output pixel value (resampling type):<![CDATA[<ul><li>0: Nearest neighbour (thematic maps; conserve the original radiometric signal).</li><li>1: Bilinear interpolation (images for photointerpretations; DEMs).</li><li>2: I Bicubic interpolation (as 1; smoothed results but slower).</li></ul>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param06"/>
				<ows:Metadata xlink:title="Name:resampling"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RetXMin</ows:Identifier>
				<ows:Title>X Minimum to trim</ows:Title>
				<ows:Abstract>The minimum X coordinate of the scope of the destination file is indicated. If 'x' is indicated, the minimum X of the X and Y coordinate file will be chosen.</ows:Abstract>
				<ows:Metadata xlink:title="Param07"/>
				<ows:Metadata xlink:title="Name:XMinTrim"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RetXMax</ows:Identifier>
				<ows:Title>X Maximum to trim</ows:Title>
				<ows:Abstract>The maximum X coordinate of the scope of the destination file is indicated. If 'x' is indicated, the minimum X of the X and Y coordinate file will be chosen.</ows:Abstract>
				<ows:Metadata xlink:title="Param08"/>
				<ows:Metadata xlink:title="Name:XMaxTrim"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RetYMin</ows:Identifier>
				<ows:Title>Y Minimum to trim</ows:Title>
				<ows:Abstract>The minimum Y coordinate of the scope of the destination file is indicated. If 'x' is indicated, the minimum X of the X and Y coordinate file will be chosen.</ows:Abstract>
				<ows:Metadata xlink:title="Param09"/>
				<ows:Metadata xlink:title="Name:YMinTrim"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RetYMax</ows:Identifier>
				<ows:Title>X Maximum to trim</ows:Title>
				<ows:Abstract>The maximum Y coordinate of the scope of the destination file is indicated. If 'x' is indicated, the minimum X of the X and Y coordinate file will be chosen.</ows:Abstract>
				<ows:Metadata xlink:title="Param10"/>
				<ows:Metadata xlink:title="Name:YMaxTrim"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#float">float</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>MULTIBANDA</ows:Title>
				<ows:Abstract>To simultaneously correct multiband raster images and to generate corresponding corrected bands.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Prefix</ows:Title>
				<ows:Abstract>For multiband images, the prefix to add to the original files when creating the corrected files. By default the prefix is c_.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NODATA</ows:Identifier>
				<ows:Title>NODATA</ows:Title>
				<ows:Abstract>NODATA value for the corrected image. If the user is completely sure that there will be no NODATA (after checking the geometry of the transformation, the extent, the range of the DEM...) then it is possible to give the value "NONE".</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PALETA</ows:Identifier>
				<ows:Title>Paleta</ows:Title>
				<ows:Abstract>Palette (p25, pal, p65) or symbol table (dbf) that determines which colour index is closest to the NODATA index for the corrected image.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pal</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pal</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-p25</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-p65</MimeType>
							<Encoding>Text</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Text</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Output reference system</ows:Title>
				<ows:Abstract>Identifier of the projection system of the output file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>f_s</ows:Identifier>
				<ows:Title>Output file</ows:Title>
				<ows:Abstract>It is the name of the corrected file (without extension) or the name of the directory of the corrected files for the multiband case.</ows:Abstract>
				<ows:Metadata xlink:title="Param03"/>
				<ows:Metadata xlink:title="Name:OutFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
