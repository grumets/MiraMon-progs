<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:KMLMM:1</ows:Identifier>
		<ows:Title>KMLMM</ows:Title>
		<ows:Abstract>Este programa convierte un archivo KML de GoogleEarth a Mapas de MiraMon que contienen capas en formato estructurado de MiraMon (PNT, ARC/NOD i POL).</ows:Abstract>
<ows:Metadata xlink:title="Title:Conversión de archivos KML a Mapas de MiraMon"/>
<ows:Metadata xlink:title="Abstract:Este programa convierte un archivo KML de GoogleEarth a Mapas de MiraMon que contienen capas en formato estructurado de MiraMon (PNT, ARC/NOD i POL). "/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcion</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>1. Importación al formato de  MiraMon (sin estructuración topológica).</ows:Abstract>
			<ows:Metadata xlink:title="Param1" />
		<LiteralData>
			<ows:AllowedValues><ows:Value>1</ows:Value></ows:AllowedValues>
		</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FicheroKML</ows:Identifier>
				<ows:Title>Fichero KML</ows:Title>
				<ows:Abstract>Es el nombre del archivo KML a importar, con extensión .kml.
</ows:Abstract>
			<ows:Metadata xlink:title="Param2" />
		<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-KML</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
					<MimeType>application/x-KML</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>				
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Sistema de Referencia</ows:Title>
				<ows:Abstract>IIdentificador del sistema de referencia en el que es desea reproyectar las capas. Por defecto vale 'lat/long-WGS84'.
</ows:Abstract>
		<LiteralData>
			<ows:AnyValue/>
		</LiteralData>
			</Input>				
		</DataInputs>
		<ProcessOutputs>	
	      	<Output>
				<ows:Identifier>ArchivoMMM</ows:Identifier>
				<ows:Title>Archivo MMM</ows:Title>
				<ows:Abstract>Es el nombre, con extensión .mmm, del archivo de salida. El programa crea un directorio con el mismo nombre del mapa, y en el mismo nivel donde guarda las capas del mapa siguiendo la siguiente nomenclatura: PNT_KMLMM, ARC_KMLMM y POL_KMLMM.
				</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
						<MimeType>application/x-MMM</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Default>
					<Supported>
						<Format>
						<MimeType>application/x-MMM</MimeType>
						<Encoding>text</Encoding>
					</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
