<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ErdasIMG:Param1:0</ows:Identifier>
		<ows:Title>Header information</ows:Title>
		<ows:Abstract>Shows information about the Erdas file header in an ordered way.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversion between LAN or GIS (Erdas) files and IMG"/>
		<ows:Metadata xlink:title="Abstract:This program allows putting several IMG files into one Erdas file of type LAN or GIS. On the other hand, it can also extract all the image bands contained on a LAN file and save them into different IMG files. GIS files only have one band and they are usually thematic files, not radiometric images."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 0</ows:Title>
				<ows:Abstract>Information about the Erdas file header.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>0</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitxer_Erdas.LAN</ows:Identifier>
				<ows:Title>Erdas file</ows:Title>
				<ows:Abstract>Is the name of the Erdas file and must be given with extension (LAN or GIS).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:File_Erdas"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-gis</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>StdOut</ows:Identifier>
				<ows:Title>Standard output</ows:Title>
				<ows:Abstract>Information of the Erdas file.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>text</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ErdasIMG:Param1:1&amp;!Param4</ows:Identifier>
		<ows:Title>Conversion Erdas -> IMG</ows:Title>
		<ows:Abstract>Converts Erdas files of LAN or GIS type into IMG files. For LAN files, the number of IMG files will depend on the number of bands contained in the ERDAS file. Run this application with option 0 to obtain this information. For GIS files, if no TRL file is found, no palette will be written (the Fitxer_P25 name is ignored).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 1</ows:Title>
				<ows:Abstract>Conversion Erdas -> IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitxer_Erdas.LAN</ows:Identifier>
				<ows:Title>Erdas file</ows:Title>
				<ows:Abstract>Is the name of the Erdas file and must be given with extension (LAN or GIS).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:File_Erdas"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-gis</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Fitxer_IMG_#</ows:Identifier>
				<ows:Title>IMG file</ows:Title>
				<ows:Abstract>Are the names of the IMG raster files. As many Fitxer_IMG as the LAN source has bands are required.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:File_IMG_#"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ErdasIMG:Param1:1&amp;Param4</ows:Identifier>
		<ows:Title>Conversion Erdas -> IMG (with P25 palette)</ows:Title>
		<ows:Abstract>Converts GIS Erdas files into IMG, with an explicit output P25 file.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 1</ows:Title>
				<ows:Abstract>Conversion Erdas -> IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitxer_Erdas.LAN</ows:Identifier>
				<ows:Title>Erdas file</ows:Title>
				<ows:Abstract>Is the name of the Erdas file and must be given with extension (LAN or GIS).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:File_Erdas"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-gis</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Fitxer_IMG</ows:Identifier>
				<ows:Title>IMG file</ows:Title>
				<ows:Abstract>Is the name of the IMG raster file.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:File_IMG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>Fitxer_P25</ows:Identifier>
				<ows:Title>P25 file</ows:Title>
				<ows:Abstract>Is the name of the color palette file in P25 format. By default is the name of IMG_File.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:File_P25"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-p25</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-p25</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ErdasIMG:Param1:2&amp;!Param4</ows:Identifier>
		<ows:Title>Conversion IMG -> Erdas</ows:Title>
		<ows:Abstract>Puts several IMG files into one Erdas file of LAN or GIS type.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 2</ows:Title>
				<ows:Abstract>Conversion IMG -> Erdas.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1000">
				<ows:Identifier>Fitxer_IMG_#</ows:Identifier>
				<ows:Title>IMG file</ows:Title>
				<ows:Abstract>Are the names of the IMG raster files. As many Fitxer_IMG as the LAN source has bands are required.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:File_IMG_#"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Fitxer_Erdas.LAN</ows:Identifier>
				<ows:Title>Erdas file</ows:Title>
				<ows:Abstract>Is the name of the Erdas file and must be given with extension (LAN or GIS).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:File_Erdas"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-gis</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ErdasIMG:Param1:2&amp;Param4</ows:Identifier>
		<ows:Title>Conversion IMG -> Erdas (with P25 palette)</ows:Title>
		<ows:Abstract>Converts IMG files into a GIS Erdas file, with an explicit input P25 file.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 2</ows:Title>
				<ows:Abstract>Conversion IMG -> Erdas.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitxer_IMG</ows:Identifier>
				<ows:Title>IMG file</ows:Title>
				<ows:Abstract>Is the name of the IMG raster file.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:File_IMG"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitxer_P25</ows:Identifier>
				<ows:Title>P25 file</ows:Title>
				<ows:Abstract>Is the name of the color palette file in P25 format. By default is the name of IMG_File.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:File_P25"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-p25</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-p25</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Fitxer_Erdas.LAN</ows:Identifier>
				<ows:Title>Erdas file</ows:Title>
				<ows:Abstract>Is the name of the Erdas file and must be given with extension (LAN or GIS).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:File_Erdas"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-lan</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-gis</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>