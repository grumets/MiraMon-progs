<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ErdasIMG:param1:0</ows:Identifier>
		<ows:Title>ErdasIMG:Conversión entre ficheros LAN o GIS (Erdas) y IMG</ows:Title>
		<ows:Abstract>El programa permite tomar la información de cabecera del fichero Erdas y la presenta de una manera ordenada.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversion between LAN or GIS (Erdas) files and IMG"/>
		<ows:Metadata xlink:title="Abstract:This program allows putting several IMG files into one Erdas file of type LAN or GIS. On the other hand, it can also extract all the image bands contained on a LAN file and save them into different IMG files. GIS files only have one band and they are usually thematic files, not radiometric images."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Option</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>0. Information about the Erdas file header.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcion</ows:Identifier>
				<ows:Metadata xlink:title="Param1"/>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Metadata xlink:title="Param1"/>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fichero_Erdas.LAN</ows:Identifier>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-LAN</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-LAN</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Erdas_File</ows:Identifier>
				<ows:Title>Erdas File</ows:Title>
				<ows:Abstract>Is the name of the Erdas file and must be given with extension (LAN o GIS).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-LAN</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-LAN</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>StdOut</ows:Identifier>
				<ows:Title>Estandard de salida</ows:Title>
				<ows:Abstract>Temporal file that does not appear in the sintax line.Shows information of the Erdas file.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-Dislay</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-Dislay</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ErdasIMG:param1:1</ows:Identifier>
		<ows:Title>ErdasIMG:Conversión entre ficheros LAN o GIS (Erdas) y IMG</ows:Title>
		<ows:Abstract>El programa permite tomar ficheros de Erdas de tipo LAN o GIS y convertirlos en IMG</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Metadata xlink:title="Param1"/>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Option</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>0. Information about the Erdas file header.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcion</ows:Identifier>
				<ows:Metadata xlink:title="Param1"/>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fichero_Erdas.LAN</ows:Identifier>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-LAN</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-LAN</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Erdas_File</ows:Identifier>
				<ows:Title>Erdas File</ows:Title>
				<ows:Abstract>Is the name of the Erdas file and must be given with extension (LAN o GIS).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-LAN</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-LAN</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Fichero_P25</ows:Identifier>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-25</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-25</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>P25_File</ows:Identifier>
				<ows:Title>P25_File</ows:Title>
				<ows:Abstract>Is the name of the color palette file in P25 format. By default is the neme of IMG_File.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-25</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-25</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Fichero_IMG_#</ows:Identifier>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>IMG_File_x</ows:Identifier>
				<ows:Title>IMG file</ows:Title>
				<ows:Abstract>Are the names of the IMG raster files.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:ErdasIMG:param1:2</ows:Identifier>
		<ows:Title>ErdasIMG:Conversión entre ficheros LAN o GIS (Erdas) y IMG</ows:Title>
		<ows:Abstract>El programa permite tomar distintos ficheros IMG y poner-los en un solo fichero ERDASS de tipo LAN o GIS.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Metadata xlink:title="Param1"/>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Option</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>0. Information about the Erdas file header.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcion</ows:Identifier>
				<ows:Metadata xlink:title="Param1"/>
			</Input>
			<Input minOccurs="1" maxOccurs="10">
				<ows:Identifier>Fichero_IMG_#</ows:Identifier>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="10">
				<ows:Identifier>IMG_File_x</ows:Identifier>
				<ows:Title>IMG file</ows:Title>
				<ows:Abstract>Are the names of the IMG raster files.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>Ficher_P25</ows:Identifier>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-25</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-25</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>P25_File</ows:Identifier>
				<ows:Title>P25_File</ows:Title>
				<ows:Abstract>Is the name of the color palette file in P25 format. By default is the neme of IMG_File.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-25</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-25</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Erdas_File.LAN</ows:Identifier>
				<ows:Title>Erdas File.LAN</ows:Title>
				<ows:Abstract>Erdas_File is the name of the Erdas file and must be given with extension (LAN o GIS).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-GIS</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-LAN</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-GIS</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>Fichero_Erdas.LAN</ows:Identifier>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-LAN</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-LAN</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
