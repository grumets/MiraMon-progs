<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:MDTIso:1</ows:Identifier>
		<ows:Title>MDTIso</ows:Title>
		<ows:Abstract>Este módulo permite generar isolíneas (también llamadas curvas de nivel [especialmente en topografía] e isopletas) a partir de un modelo digital del terreno (MDT) (por ejemplo elevación, pluviometría, evapotranspiración, contaminación, etc).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Generación de isolíneas a partir de un MDT."/>
		<ows:Metadata xlink:title="Abstract:Este módulo permite generar isolíneas (también llamadas curvas de nivel [especialmente en topografía] e isopletas) a partir de un modelo digital del terreno (MDT) (por ejemplo elevación, pluviometría, evapotranspiración, contaminación, etc)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerMDT</ows:Identifier>
				<ows:Title>Fichero MDT</ows:Title>
				<ows:Abstract>Ráster que contiene el Modelo Digital del Terreno en formato IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:FicheroMDT"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Equidistancia</ows:Identifier>
				<ows:Title>Equidistancia</ows:Title>
				<ows:Abstract>Diferencia (distancia) del valor Z entre dos isolíneas vecinas con diferente valor.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:Equidistancia"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>EQUID_MESTRA</ows:Identifier>
				<ows:Title>Equidistancia entre curvas maestras</ows:Title>
				<ows:Abstract>Equidistancia entre curvas maestras.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ZMIN</ows:Identifier>
				<ows:Title>Z mínima</ows:Title>
				<ows:Abstract>Valor mínimo Z de las isolíneas.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ZMAX</ows:Identifier>
				<ows:Title>Z máxima</ows:Title>
				<ows:Abstract>Valor máximo Z de las isolíneas.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ZBASE</ows:Identifier>
				<ows:Title>Z base</ows:Title>
				<ows:Abstract>Valor origen de Z.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DENSIFICACIO</ows:Identifier>
				<ows:Title>Densificación</ows:Title>
				<ows:Abstract>Valor correspondiente a la densificación del MDT. Este valor debe ser un número entero e impar entre 1 y 9.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>5</ows:Value>
						<ows:Value>7</ows:Value>
						<ows:Value>9</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MIGPIXEL</ows:Identifier>
				<ows:Title>Límite de la búsqueda</ows:Title>
				<ows:Abstract>Parámetro que implica que se limite la búsqueda de vértices de isolíneas hasta una distancia de medio píxel de los bordes del MDT.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GENERALITZACIO</ows:Identifier>
				<ows:Title>Generalización</ows:Title>
				<ows:Abstract>Parámetro que implica la generalización de las isolíneas generadas.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ZINCREM</ows:Identifier>
				<ows:Title>Tolerancia Z</ows:Title>
				<ows:Abstract>Tolerancia del valor Z del píxel del MDT en caso  que este valor corresponda al valor Z de una de las isolíneas. Es un valor positivo o negativo en partes por mil de la equidistancia.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PROBL</ows:Identifier>
				<ows:Title>Fichero de puntos extremos</ows:Title>
				<ows:Abstract>Fichero de puntos donde se guardan los extremos de las isolíneas que no se ha logrado generar satisfactoriamente, en caso que los haya.</ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerSortida</ows:Identifier>
				<ows:Title>Fichero de salida</ows:Title>
				<ows:Abstract>Vector de arcos que contendrá las isolíneas generadas a partir del MDT en formato ARC.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroSalida"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>