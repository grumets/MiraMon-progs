;==========================================================================
; Fitxer de paràmetres del programa MiraMon
;==========================================================================
;==========================================================================
; Aquest fitxer ha de ser al Disc i Directori indicats en la casella
; "Directori de Treball" de les "Propietats del programa" (per accedir-hi
; seleccioneu la icona del programa i executeu "Alt+Retorn" o bé executeu
; "Fitxer/Propietats" en el menú de l'Administrador de Programes).

; En aquest fitxer els comentaris són línies que comencen amb un
; punt i coma (;).
;==========================================================================



;==========================================================================
[MiraMon]
;==========================================================================
; SECCIÓ PRINCIPAL
;==========================================================================

; MiraMon Corporatiu: 
;cfg_corporativa=
;msg_queixa_grup=
;info_grup=
;path_log=


; Aspecte de la finestra en iniciar el programa: 0=Normal 1=Maximitzada
MaxIni=1

; Color de fons en l'àrea client inicial
; Aquest paràmetre es pot canviar durant la sessió mitjançant l'opció
; corresponent del menú "Visualització".
; 41 = Blanc     -> (R,G,B) = (255,255,255)
; 42 = Gris clar -> (R,G,B) = (192,192,192)
; 43 = Gris      -> (R,G,B) = (128,128,128)
; 44 = Gris fosc -> (R,G,B) = ( 64, 64, 64)
; 45 = Negre     -> (R,G,B) = (  0,  0,  0)
ColorFonsInit=41

; Directori on, per defecte, es buscaran els mapes, imatges i vectors a
; visualitzar
ImgDir=C:\mapes

; Directoris on el MiraMon explora els fitxers que defineixen les col·leccions de mapes preferits
CollecDir1=C:\mapes\ColleccionsPreferides
;CollecDir2=
;CollecDir3=
;...

; Pàgina HTML que es mostra com a alternativa a les pàgines del Diari de Versions, Fòrum d'usuaris (FUM) i
; Twiter del MiraMon. Típicament serveix per a mostrar-hi informació corporativa (darreres novetats en la intranet
; d’una administració, indicacions per als alumnes en una aula, etc).
;PaginaHTM_AlternativaPresentacio=

; Directori on, per defecte, es buscaran les paletes de color
PalDir=Paletes

; Extensió usada, per defecte, en buscar les paletes de color:
;       0=*.PAL         Paletes de    64 nivells per a cada component RGB
;       1=*.P25         Paletes de   256 nivells per a cada component RGB
;       2=*.P65         Paletes de 65536 nivells per a cada component RGB
; Aquesta extensió apareixerà com a segona opció en el desplegable d'exploració
; de fitxers, sempre després de les taules de simbolització de la versió 4.
PalExt=1

; Directori on, per defecte, es buscaran els símbols (EMF i WMF)
SimbolDir=Simbols

; Directori on, per defecte, es buscaran els patrons
PatroDir=Patrons


; Plantilles d'usuari per a la impressió. S'assumeix que són al
; directori indicat a "PlantillaDir=".
PlantillaDir=Plantill
; PlantillaVerticUsuari=Vert_Usuari.mmm
; PlantillaHoritzUsuari=Hori_Usuari.mmm
PlantillaVerticUsuari=
PlantillaHoritzUsuari=

; Nombre de dígits decimals amb què les coordenades mapa seran impreses
; en pantalla. Ha de ser dintre el rang [0,15]. Valor per defecte: 2
DigitsDecimals=2

; Nombre de dígits decimals amb què les coordenades en long/latitud seran impreses
; en pantalla. Ha de ser dintre el rang [0,15]. Valor per defecte: 4
;DigitsDecimalsLonLat=4

; Nombre de digits decimals en les consultes per localització de ràsters float i en les
; estadístiques de les consultes per atributs.
; Ha de ser dintre el rang [0,15]. Valor per defecte: 4
;DigitsDecimalsConsultEstad=4

; Estat del Visualitzador de Coordenades: 0=No visible 1=Visible
; Aquest paràmetre es pot canviar durant la sessió mitjançant l'opció
; "MostrarCoordenades" del menú "Informació" o amb la tecla F6.
MostrarCoordenades=0

; Posició i dimensió del Visualitzador de Coordenades:
;   XCaixaCoord, YCaixaCoord * són les coordenades del vèrtex
;                            superior esquerre de la caixa, respecte
;                            al vèrtex superior esquerre de la pantalla.
;   AmpleCaixaCoord          * és l'amplada de la caixa de coordenades.
; Els 3 valors es donen en píxels de pantalla.
;YCaixaCoord=448 ->Win 3.x; 640x480
XCaixaCoord=100
YCaixaCoord=425
AmpleCaixaCoord=550

; Visualització de coordenades del mapa en diferents finestres informatives. 
; 1: mostrar (valor per defecte); 0: no mostrar
;MostrarCoordMapa=1;

; Visualització de coordenades en longitud/latitud en diferents finestres informatives.
; 1: mostrar (valor per defecte); 0: no mostrar
;MostrarCoordLonLat=1

; Ordre en què es visualitzen les coordenades en longitud/latitud en diferents finestres informatives.
; 0: mostrar en ordre Longitud Latitud (valor per defecte)
; 1: mostrar en ordre Latitud Longitud
;OrdreMostrarCoordLongLat=0

; Format de les coordenades en longitud/latitud, 
; 1: mostrar en graus minuts segons (° ' ''); 0: mostrar en graus (°)
;FormatLonLatGMS=1

; Estat de la llegenda: 0: No visible; 1: Visible
;MostrarLlegenda=0

; Estat de la Barra de Zoom: 0=No visible 1=Visible (valor per defecte)
; Aquest paràmetre es pot canviar durant la sessió mitjançant "Visualització | Entorn" i 
; des del mateix menú "Zoom".
;MostrarBarraZoom=0

; Posició de la Barra de Zoom:
; XBarraZoom, YBarraZoom són les coordenades del vèrtex superior esquerre de
; la caixa, en píxels de pantalla
; Valors per defecte: XBarraZoom=0 i YBarraZoom=128
;XBarraZoom=100
;YBarraZoom=428

; Estat de la Barra de botons: 0=No visible 1=Visible
; Aquest paràmetre es pot canviar durant la sessió mitjançant l'opció
; "Mostrar barra de botons" del menú "Ajuda".
MostrarBarraBotons=1

; Amb el següent paràmetre controlem l'aparició de l'índex de color
; numèric corresponent a cada categoria en la finestra que mostra la
; llegenda: 0=No (valor per defecte) 1=Sí
; Equival a l'antic MostrarAtributLlegenda
MostrarIndColLleg=0

; Radi de representació dels vectors punts, en píxels de pantalla.
; Aquest valor ha de ser>=0
RadiPnt=1

; Mostrar índex d'enllaç amb camps relacionals a la llegenda
;MostrarIndEnllacCat=0;				

; Opcions per defecte en obrir el primer fitxer de polígons.
; PolTransparent indica si voldrem pintar l'interior,
; 0=No  1=Sí
PolTransparent=1

; Quan un fitxer conté valors de fons (flag values), podeu reservar l'última
; entrada de la paleta com a color per als píxels o entitats marcats amb
; aquell valor de fons.
; 0=No  1=Sí
UsarUltimColorPaletaComFlagValue=0

; Radi per a dibuixar les entitats de tipus punt que no tinguin registre a la
; base de dades o que tinguin buit (en blanc) el camp que indexa el radi.
; Aquest valor ha de ser >=0
RadiObjectesSenseAtribut=1

; Amplada per a dibuixar les entitats de tipus línia/arc que no tinguin
; registre a la base de dades o que tinguin buit (en blanc) el camp que
; indexa el el gruix.
; Aquest valor ha de ser >=0
GruixObjectesSenseAtribut=1.0

; Color per a dibuixar les entitats que no tinguin registre a la
; base de dades o que tinguin buit (en blanc) el camp que indexa el color.
; Cal indicar un valor (R,G,B). Recordeu que cada component R,G,B ha de ser
; dintre el rang [0, 255].
ColorObjectesSenseAtribut=(0,0,0)

; Quan un fitxer pertany a una sèrie cartogràfica i es desa un mapa, es pot
; optar per mantenir els lligams de visualització i llegenda generals de la
; sèrie o per desar les característiques actuals de visualització i llegenda.
; 0=No mantenir el lligam amb les sèries cartogràfiques  1=Mantenir-lo
MantenirSeriesCartografiquesEnMMM=1

; Abans de mostrar la caixa resultant d'una consulta per localització en vectors,
; mostra una caixeta que permet continuar buscant o cancel·lar: 0=No  1=Sí
; Aquest paràmetre es pot canviar durant la sessió a través del menú
; "Informació"
PreInfoBox=0

; Posició, ample i alt inicial de la caixa resultant d'una consulta 
; per localització en vectors. Aquest paràmetre es pot canviar durant la sessió 
; a través dels angles o de les vores de la pròpia caixa. Els 4 valors (X,Y,Ample,Alt) es donen 
; en píxels de pantalla. Si es demana una mida massa gran per la resolució de la 
; pantalla els valors són adaptats a la resolució permesa.
MidaCaixaConLoc=50,77,547,604

; Color (R,G,B) amb què es destaquen els elements seleccionats. Si indiqueu
; (-1,-1,-1) el color el determina el MiraMon per a una òptima visualització.
; Si indiqueu qualsevol altra combinació [0, 255] per a les components RGB
; obtindreu aquest color com a color constant per a les seleccions; per
; exemple, per a obtenir les seleccions en vermell indiqueu:
; ColorSeleccio= (255,0,0)

;per a obtenir les seleccions en blanc indiqueu:
; ColorSeleccio= (255,255,255)
; Aquest paràmetre es pot canviar durant la sessió a través del menú
; "Visualització"
ColorSeleccio=(-1,-1,-1)

; Després d'efectuar una consulta per localització pot ser convenient
; redibuixar tota la pantalla per evitar artefactes d'ensolapament de
; polígons que tapin punts, etc. Si indiqueu 0 (valor per defecte), el
; redibuixat no es farà (opció més ràpida, però que visualment pot presentar
; el problema comentat i aleshores heu de forçar un redibuixat a través del
; botó amb el pinzell de la barra de botons o amb "Visualització | Redibuixat";
; si indiqueu 1, s'efectua un redibuixat complet cada cop que es tanca la caixa
; de consulta per localització.
;RedibuixaDespresDeConsultaLocalit=1

; Indica si en la caixa de disseny d'impressió es redibuixarà de forma automàtica (opció 1)
; o bé ho farà a petició de l'usuari a través del botó corresponent o de F5 (opció 0,per defecte i 
; comportament clàssic).
;RedibAutomPrevisImpr=1

; La següent variable determina quines de les següents informacions volem
; que siguin visibles quan realitzem consultes per localització sobre vectors
; estructurats. La variable "ParamInfoConsultaLocalitz" està formada per una
; o més de les següents informacions:
;    Titol           : Títol descriptiu del fitxer que estem consultant
;    NomFitxer       : Nom del fitxer que estem consultant (també es mostra
;                      el "path" complet) 
;    TipusFitxer     : Tipus de fitxer (punts, polígons, etc)
;    Visualitzacio   : Aspectes de visualització (color, etc)
;    Posicio_XY      : Posició X,Y de la consulta; ubicació en els
;                      vectors (vèrtex final o intermedi, punt interior, etc)
;    LongitudArcs    : Longitud de línies i arcs
;    PeriAreaPoligs  : Perímetre i àrea de polígons
;    AltresGeomTopol : Altra informació geomètrica i topològica (nombre de
;                      polígons elementals, nodes ini/fi dels arcs, etc)
;    InfoBasesDades  : Informació sobre la base de dades (nombre d'elements
;                      gràfics i de registres, etc)
;    BaseDadesAlfan  : Informació continguda als camps de la base de dades
;                      alfanumèrica
; Durant l'execució del programa es poden canviar aquestes especificacions
; a través del botó "+ / - Informació..." de la caixa de consulta per
; localització.
; La variable es forma simplement escrivint les inform. desitjades, p.ex.:
; ParamInfoConsultaLocalitz=Titol Posicio_XY BaseDadesAlfan
ParamInfoConsultaLocalitz=Titol NomFitxer Posicio_XY LongitudArcs PeriAreaPoligs BaseDadesAlfan

; Com mostrar els enllaços trencats per NODATA
; si 1: mostrar en blanc (valor per defecte)
; si 2: mostrar el camp amb l'enllaç trencat
;ComMostrarEnllacosTrencatsPerNODATA=1
    					
; Qui gestiona els zooms ràster: el MiraMon o el Windows
; Aquest paràmetre es pot canviar durant la sessió a través del menú "Zoom".
; Nota: Aquesta clau és purament de gestió informàtica dels ràsters en el zoom i
; no s'ha de confondre amb la clau ModeGestioZoom de la secció [METRICA].
GestZoom=MiraMon

; Avisa acústicament si no pot redibuixar
; Aquest paràmetre es pot canviar durant la sessió a través del menú
; "Visualització | Especial"
; 0=No  1=Sí
AvisaErrorRed=0

; Ignorar els canvis en els atributs dels fitxers.
; Aquesta opció és útil en Windows 3.1x quan s'accedeix a dades
; d'un servidor de xarxa, ja que de vegades s'obtenen falsos avisos
; d'impossibilitat de llegir els atributs. Tanmateix, si s'activa
; aquesta opció, el MiraMon no detectarà si s'ha produït algun canvi
; en els fitxers gràfics o en les taules de les bases de dades durant
; la sessió de treball (per exemple perquè un altre usuari ha modificat
; un DBF o perquè estem reconstruint la topologia) i això pot provocar
; que el programa funcioni incorrectament.
; En Windows 9x i NT aquesta opció ha d'estar a 0 per garantir un òptim
; funcionament del programa (és a dir, detectarà qualsevol canvi en els
; fitxers en què esteu treballant).
; Aquest paràmetre es pot canviar durant la sessió a través del menú
; "Visualització | Especial"
; 0=No  1=Sí
IgnorarCanvisAtributsHoraDataMida=0

; Informa o pregunta respecte a la recàrrega de fitxers quan es detecta que han sofert canvis en els atribut, hora, data i/o mida.
; Per defecte es recomana un valor 1, que informa o pregunta explícitament a l'usuari sobre els canvis.
; Si es desitja que no avisi, però que per prudència sempre recarregui, indiqueu un valor 0.
; Si es desitja que no avisi, però que només recarregui quan els canvis són de mida, indiqueu un valor 2. Aquesta opció només ha de ser
; indicada per usuaris experts.
; InformaRecarregaFitxersModif=0
InformaRecarregaFitxersModif=1

; Joc de caràcters per als fitxers de text pla (TXT, REL, DVC, etc).
; Aquest paràmetre es pot canviar durant la sessió a través del menú
; "Informació"
; 1252=Windows ANSI (EE.UU. i Europa Occidental)
;  850=DOS OEM-850  (MS-DOS Multillenguatge o "Latin I")
JocCaracTXTPerDefecte=1252

; Joc de caràcters per als camps de tipus caràcter dels fitxers de
; bases de dades (DBF) quan el propi DBF no especifica joc de caràcters
; o bé l'especificat no és suportat pel MiraMon.
; Aquest paràmetre es pot canviar durant la sessió a través del menú
; "Informació"
; 1252=Windows ANSI (EE.UU. i Europa Occidental)
;  850=DOS OEM-850  (MS-DOS Multillenguatge o "Latin I")
JocCaracDBFPerDefecte=850

; Quan durant la digitalització copiem un objecte podem triar que ja quedi
; dibuixat en el color final, o que quedi ressaltat en el color de selecció
; 0=No  1=Sí, vull ressaltar l'objecte
; Aquest paràmetre es pot canviar durant la sessió a través del menú
; "Edició"
MarcaObjecteCopiat=1

; En digitalitzar polígons explícits, en cas de dubte, es decidirà si
; s'afegeix un nou polígon, es defineix un forat a un polígon preexistent, o si
; es pregunta cada vegada quina de les dues opcions es vol, que és la opció per defecte (0).
; 0=Pregunta 1=Afegeix polígon  2=Defineix forat
;DefineixForatCreaPoligonOPregunta=2

; Posició inicial, amplada i alçada de la caixa de la llegenda.
; Els 4 valors (X,Y,Ample,Alt) es donen en píxels de pantalla.
PosicioDimensioLlegenda=476,9,152,456

; Permet ignorar l'existència de la clau "MostrarLlegenda=" en els mapes,
; fent que la llegenda sempre sigui visible (valor 1). El valor per defecte és 0.
; IgnorarMostrarLlegenda=1
IgnorarMostrarLlegenda=0

; Nombre de passos de digitalització/edició entre còpies de seguretat. 
; Aquest paràmetre també governa l'equilibri entre temps dedicat a fer còpies
; de seguretat i velocitat en efectuar una operació de desfer (Ctrl+Z). Exemples:
; Si s'indica 0 no es realitza mai cap còpia de seguretat i, per tant, tampoc no
; es permet desfer. Si s'indica 1 (no recomanat) es realitza un còpia de seguretat
; a cada operació de digitialització/edició, i la velocitat de desfer és màxima.
; El valor per defecte és 20. Un valor més elevat fa que el procés de digitalització/edició 
; sigui sensiblement més àgil si la capa que s'està editant és molt voluminosa (en
; la part gràfica i/o en la seva base de dades) o està en una recurs informàtic d'accés
; lent, però, a canvi, s'efectuen menys còpies de seguretat i les operacions de desfer
; són més lentes perquè han de regenerar una situació més complexa.
NPassosEntreCopiesEnDigit=20

; Mostrar la barra d'eines de digitalització en iniciar la digitalització. 0=No  1=Sí (valor per defecte)
; MostrarBarraEinesDigit=0
MostrarBarraEinesDigit=1

; Connexió contínua en digitalitzar. 0=No 1=Sí(valor per defecte) 
; F3Continu=0
F3Continu=1

; Colors per defecte per informar que s'ha efectuat una connexió en mode F3Continu:
ColorVertexFinal_F3Continu=(255,0,0)
ColorVertexIntermedi_F3Continu=(255,255,0)
ColorVertexNou_F3Continu=(0,255,255)

; Radi i gruix per defecte per informar que s'ha efectuat una connexió en mode F3Continu:
Radi_F3Continu=7
Gruix_F3Continu=2

; Exageració per defecte de radis de punts i gruixos de línies en imprimir
ExageraRadi_i_Gruix=3

; Per a decidir si vull confirmacio abans de sortir del MiraMon
; 0=No  1=Sí
ConfirmacioSortirMiraMon=0

; Permet controlar cada quants minuts el Director avisa que una
; sessió del MiraMon no respon. Si treballeu amb fitxers que resulten
; ser de processament molt lent amb el vostre ordinador i rebeu massa
; sovint missatges advertint que tal sessió del MiraMon no respon,
; incrementeu aquest valor. El valor mínim és 1.
MinutsCicleTestDirector=60

; Permet controlar si un objecte seleccionat interactivament o per atributs
; ha de ser amagat (apagat) quan es mostra a una escala a la qual la capa no
; es mostra. 0=No  1=Sí (valor per defecte)
;EscalaApagaObjectesSeleccionats=0

; Base de Dades Documental per defecte
;BDDocumental=adreça i nom 

; Permet controlar si, en referència al camp ID_GRAFIC, es farà anàlisi exhaustiva del seu
; contingut i coherència (opció 2, comportament habitual fins a gener-2013 però que enlenteix
; molt considerablement l'obertura de capes amb grans taules principals), o si es farà una anàlisi ràpida
; (opció 1, que és l'actual opció per defecte, i que només comprova la presència de registre múltiple
; o de registres addicionals amb índexs negatius o superiors al nombre d'objectes). La immensa majoria
; de les capes tenen un camp ID_GRAFIC correcte (ordenat de forma ascendent, etc) i, per tant, aquest
; esforç és habitualment innecessari, excepte per a poder comprovar capes que presentin comportaments
; estranys. Es pot canviar temporalment el comportament dintre d'una sessió a través de
; "Visualització | Especial | Test exhaustiu camp IdGràfic durant l'obertura de capes".
;TestIdGr=2

; La llegenda mostrarà les capes que s'han declarat no visibles, o que no són visibles degut
; a que són a una escala en què s'ha especificat que no ho siguin o, simplement, degut al fet que
; no són al camp del mapa. El valor per defecte (0) amaga aquestes capes durant la impressió.
ImprLlegMostraCapesNoVisib=0

; Obrir la caixa clàssica del Windows o la caixa moderna (que permet imprimir a un fitxer sense haver
; de redefinir el port d'impressió) en prémer el botó "Impressora..." de la caixa de disseny
; d'impressió. El valor per defecte (1) mostra la caixa moderna.
;CaixaModernaTriaImpressora=0
CaixaModernaTriaImpressora=1

; Mostrar, a la barra de botons, el botó que permet la publicació/exportació de dades vectorials 
; "obertes" en la sessió del MiraMon a diversos formats.
; 0: no mostra el botó especial de publicació (valor per defecte) 
; 1: mostra el botó especial de publicació
;BarraBotonsEspecial=1

; Generar una taula única reseguint totes les taules enllaçades a la taula principal de la capa.
; Serà usada per fer les consultes al MiraMon de manera més ràpida.
; 1: Usar la taula única (valor per defecte).
; 0: No usar la taula única.
UsarTaulaUnica=1

; En les connexions a bases de dades, mitjançant les llibreries ODBC, cal determinar el tipus de cursor que es pot usar per aquella base de dades.
; El tipus de cursor té implicacions en com es recuperen les dades de la base. A vegades, en algunes bases de dades no es pot determinar el tipus de cursor; quan això passa es 
; genera un avís de cursor desconegut, en el qual es diu que no s'ha pogut determinar el tipus de cursor i que s'usarà el cursor de tipus simple. 
; S'ha observat que en determinats tipus de bases de dades això passa sovint, però l'ús del cursor simple és satisfactori. Aquesta variable permet controlar si es vol mostrar o no aquest avís.
; 1: Mostrar avís cursor desconegut (valor per defecte)
; 0: No mostrar l'avís
AvisaErrorODBCCursorDesconegut=1 

; Preferència en l'ús de llibreries per a l'accés a fitxers obribles tant via llibreries internes del MiraMon com via GDAL/OGR
; 0: Un fitxer que es pugui obrir via MiraMon i via GDAL/OGR s'obrirà via llibreries internes del MiraMon (valor per defecte).
; 1: Un fitxer que es pugui obrir via MiraMon (o obrir l'aplicació d'importació corresponent) i via GDAL/OGR s'obrirà via GDAL/OGR.
; 2: Un fitxer que no es pot obrir via MiraMon, però per al qual hi ha l'aplicació d'importació corresponent, obrirà aquesta aplicació d'importació.
; Ràsters:
;ObreJPEGVia=1
;ObreTIFFVia=1
;ObreBMPVia=1
;ObreJ2KVia=1

; Vectors:
;ObreSHPVia=1
;ObreDXFVia=1
;ObreGPXVia=1
;ObreKMLVia=1
;ObreGMLVia=1
;ObreDGNVia=1
ObreGeoJSONVia=1

;Taules:
ObreCSVVia=1

; Preferència en la importació de la simbolització de OGR/GDAL
; SLD: Importa la simbolització de la layer_style en el cas de geopackage (el valor per defecte)
; GDAL [no implementat a octubre del 2025]: Importa la simbolització usant les llibreries pròpies de GDAL per a tots els casos disponibles a GDAL
; GDAL_SLD [no implementat a octubre del 2025]: Importa la simbolització usant les llibreries pròpies de GDAL i després s'enriqueix amb la SLD
; SLD_GDAL [no implementat a octubre del 2025]: Importa la simbolització de la layer_style i després s'enriqueix usant les llibreries pròpies de GDAL
;SmbGDAL=
SmbGDAL=SLD

;==========================================================================
[METRICA]
;==========================================================================
; SECCIÓ PER A ASPECTES DE MÈTRICA, PROJECCIONS CARTOGRÀFIQUES, ETC
;==========================================================================

; Sistema de referència i unitats per defecte en les correccions geomètriques 
; i conversions de format (importacions).
;RefSystem=UTM-31N-UB/ICC
RefSystem=UTM-31N-ETRS89

; Quan el sistema de referència és de tipus "Cartogràfic" i està descrit en 
; les taules de geodèsia, les unitats es llegeixen d'aquestes taules. Aquesta és la
; situació normal. Tanmateix, en la resta dels casos (per exemple quan el sistema
; és "Local") poden especificar-se.
RefUnits=m

; Sistema de referència i unitats per defecte quan es digitalitza 
; SENSE cap capa carregada altra que la que estem digitalitzant.
RefSystemScreen=plane
RefUnitsScreen=pixels

; Transformació  al vol del sistema de referència. El valor per defecte és 1 (sí).
; Si no en voleu usar indiqueu 0.
;TransformacioGeometriaAlVol=0

; Conversors de longituds i d'àrees des de les unitats indicades a la clau "RefUnits"
; Si no en voleu usar indiqueu 0 o comenteu la línia amb un punt i coma.

ConversorLong=0.001
UnitLong=km
ConversorArea=0.0001
UnitArea=ha
;ConversorArea=1E-6
;UnitArea=km²

; Mantenir la vista actual en obrir una nova capa o mapa. Aquest paràmetre,
; que per defecte val 0 (fals), actua inhibint la lectura de la secció
; [VISTA] dels mapes i evitant el zoom a l'àmbit total de la nova capa en obrir-ne una de nova.
; El paràmetre només actua quan ja hi ha alguna capa carregada.
; El seu valor pot modificar-se també des del menú "Visualització | Especial".
; MantenirVistaActualEnObrirNovaCapa=1
MantenirVistaActualEnObrirNovaCapa=0

; Permet que, quan es fa un zoom a selecció, els objectes seleccionats se centrin a la pantalla (valor 1)
; en comptes de mostrar-los ajustats a l'angle superior esquerre (valor 0). Valor per defecte: 1
; CentraSeleccio=0
CentraSeleccio=1

; Permet que, quan es fa un zoom a selecció, es doni "aire" al voltant dels objectes seleccionats
; en comptes de mostrar-los ajustats als costats superior i esquerre.
; El valor per defecte és 1 (sense aire) i es pot disminuir fins a 0.5 (s'usa només la meitat central de la pantalla).
; PercentPantallaSeleccio=.8
PercentPantallaSeleccio=1

; Com es gestiona el Zoom del programa:
;  Mode Vista general (opció 0 i per defecte): El zoom es gestiona en base a la vista general de totes les capes.
:  Mode Ràster de referència (opció 1): El zoom es gestiona en base a un dels ràsters oberts, que per defecte és el
;	primer, amb independència de l'existència d'altres capes ràsters o vectors.
;  Mode Automàtic (opció 2): Commuta entre els modes anteriors, aplicant el mode Ràster de referència si tots
;	els ràsters oberts tenen el mateix costat de píxel, i aplicant el mode Vista general en cas contrari.
ModeGestioZoom=0

; Es desitja barra d'estat visible? 0: no; 1 sí (opció per defecte)
BarraEstatVisible=1

; Es desitja barres de desplaçament a la finestra de visualització? 0: no; 1 sí (opció per defecte)
MostrarBarresFinestraPintar=1

;==========================================================================
[GPS]
;==========================================================================
; SECCIÓ PER AL SEGUIMENT GPS
;==========================================================================

; Percentatge del centre de la pantalla que no necessita recentrat del
; darrer punt de la ruta GPS.
;	Un valor del 100% només recentra quan la ruta surt de la pantalla.
;	Un valor del   0% recentra a cada refresc enviat per GPSMM.
PercentPantallaNOCentratGPS=80

; Radi del cercle que es dibuixa al voltant del darrer punt llegit del GPS
RadiSeguimentGPS=500

; Tipus d'unitats de RadiSeguimentGPS: 0=UNITATS_PIXELS, 1=UNITATS_MAPA (cartesianes), 2=UNITATS_MAPA (geodèsiques)
TipusUnitatsRadiSeguimentGPS=2

;==========================================================================
[Hardware]
;==========================================================================
; SECCIÓ PER A CONFIGURACIÓ DE HARDWARE
;==========================================================================

; Temps, en segons, que el programa espera entre un clic del ratolí i un arrossegament per 
; considerar que s'està fent un canvi dinàmic a mode desplaçament (pan).
; El valor per defecte és 0.2. Podeu indicar qualsevol valor positiu fins a 1.
; Indiqueu -1 si voleu inactivar el canvi dinàmic a desplaçament.
;TempsArrossegamentDinamicSegons=-1

; El següent paràmetre permet activar o desactivar l'arrossegament dinàmic durant 
; la digitalització ja que algunes persones tendeixen a "arrossegar" el ratolí entre 
; clics i activen massa freqüentment l'arrossegament dinàmic. 
; 0=No  1=Sí (valor per defecte)
;ActivaArrossegamentDinamicDurantDigitalitzacio=0

; Amplada de la pantalla, en mm. Necessari per al càlcul de l'escala.
;X_mm_Pantalla=260
X_mm_Pantalla=304.8
;PolzadesDiagonalPantalla=15

; Algunes targetes gràfiques o impressores fracassen en intentar dibuxar
; objectes molt complexos (per exemple línies de 20000 vèrtexs).
; El problema pot empitjorar en el cas dels polígons i en el cas de
; línies regruixides. El problema també es dependent de l'escala
; i del detall del dispositiu de sortida (normalment a escala més detallada
; o en un dispositiu de més resolució, més probabilitat de problemes) i
; de la 'quantitat' d'objecte visualitzat o imprès: la vista general d'un
; objecte és el cas amb més probabilitat de problemes, especialment en
; pantalles o en impressores d'alta resolució o en papers de gran format
; Els paràmetres 'MaxVertexsTargetaGraficaEx' i 'MaxVertexsImpressoraEx' permeten definir quin és
; aquest valor límit per al vostre equip. Si un objecte el depassa, el MiraMon
; el simplificarà amb un algorisme intel·ligent que normalment no causa
; efectes estètics indesitjables. Si al vostra pantalla o la vostra
; impressora no reïxen a dibuixar un cert objecte, baixeu el valor
; d'aquest paràmetre fins aconseguir que el pugui dibuixar.
; Un valor entre 10000 i 15000 sol ser adequat per a la majoria de
; dispositius, però podeu fer empíricament un ajust més fi ja que
; aquests paràmetres poden ser canviats des dels menús del MiraMon
; (això també és útil quan seleccioneu una impressora diferent de la
; impressora per defecte).
; Els paràmetres 'MaxVertexsTargetaGraficaEx' i 'MaxVertexsImpressoraEx'
; substitueixen, al novembre del 2011, els antics paràmetres ''MaxVertexsTargetaGrafica' i 'MaxVertexsImpressora'.

MaxVertexsTargetaGraficaEx=1048576
;MaxVertexsTargetaGrafica=32767
MaxVertexsImpressoraEx=1048576
;MaxVertexsImpressora=32767

; A partir de les versions Vista i 7 del Windows, el sistema operatiu pot desactivar
; el dibuixat d'una aplicació quan li sembla que l'aplicació "No respon". Això provoca
; que en capes molt complexes a partir d'un cert element ja no es dibuixi a la pantalla i,
; el que és pitjor, que un cop acaba l'intent de dibuixar, el MiraMon rebi una nova
; instrucció de redibuixat per part del sistema operatiu, la qual cosa genera un bucle
; a voltes etern de redibuixats incomplets que només s'atura prement la tecla majúscula i,
; a continuació, fent un zoom que permeti treballar sobre un nivell de complexitat menor
; (menys objectes). Els paràmetres N_Objectes_PntNod_EvitaNoRespon i N_Objectes_ArcPol_EvitaNoRespon
; permeten, per a punts i nodes, i per a arcs i polígons, respectivament, desactivar aquest
; comportament del Windows per a capes complexes. Els valors per defecte han estat ajustats
; per a processadors habituals a finals de l'any 2012, però si teniu ordinadors substancialment
; més antics i observeu aquest comportament, convindrà que disminuïu els valors fins que
; no observeu el problema.
N_Objectes_PntNod_EvitaNoRespon=50000
N_Objectes_ArcPol_EvitaNoRespon=10000

; Resulta interessant que el programa pugui interrompre el dibuixat per a fer una consulta,
; un nou zoom, etc, no només prement la tecla Maj., sinó també a partir d'una acció del ratolí.
; Tanmateix, durant els primers objectes d'un bucle de dibuixat el programa no pot "escoltar"
; si l'usuari ha fet clic amb el botó esquerre del ratolí (o si ho fet amb la roda  de zoom)
; perquè si el clic era el segon punt d'un zoom o la indicació de final d'un desplaçament (pan),
; l'esdeveniment passa tan ràpid que acaba detectant el clic mentre encara dibuixa els primers
; objectes i aturaria sempre el dibuixat posterior a un zoom o un desplaçament, la qual cosa
; fóra un efecte indesitjat de poder interrompre el dibuixat amb un clic del ratolí. Per aquest
; motiu és necessari indicar quants objectes cal permetre dibuixar abans de
; considerar que el fet que el botó del ratolí estigui premut no és el final d'una operació de
; zoom o de desplaçament, sinó una petició d'aturar el dibuixat a partir d'una acció del ratolí
; que la inicia.
; Els valors per defecte són: 1000 per a punts i nodes, i 500 per a arcs i polígons, però aquests
; valors poden haver-se de fer més alts en ordinadors o xarxes molt ràpids i, viceversa, haver
; de fer-se més curts en ordinadors o xarxes relativament lents. Si observeu que fàcilment queden
; objectes sense redibuixar després d'un zoom per finestra, heu d'incrementar el valor, mentre que
; si heu de fer polsacions molt llargues perquè el programa us faci cas en la instrucció de no
; dibuixar, cal que decrementeu el valor.
; Si indiqueu -1 el programa assumeix que NO desitgeu poder interrompre mai el dibuixat amb un
; clic de ratolí (però podreu fer-ho, si ho desitgeu, prement la tecla Maj.).
;N_PntNod_SenseAturarRedib_x_clic=-1
;N_ArcPol_SenseAturarRedib_x_clic=-1

; Tanmateix, i com que el càlcul de simplificació és complex i pot
; arribar a provocar un redibuixat massa lent, podeu fer que el MiraMon
; no dibuixi els objectes que assoleixen aquest nivell de complexitat
; establint el paràmetre 'DibuixaObjectesComplexos' a 0.
; D'aquesta manera, podeu treballar amb polígons de, per exemple, 50000
; vèrtexs, sense redibuixar-los en les vistes que obliguin a un nombre
; de vèrtexs superior a 'MaxVertexsTargetaGraficaOImpressora' i així obtenir
; redibuixats més ràpids. En el moment d'imprimir, simplement activeu
; de nou "Visualització | Especial | Dibuixar objectes complexos".
; Els valors possibles són:
;   0=No dibuixar objectes complexos
;   1=Sí, dibuixar objectes complexos
DibuixaObjectesComplexos=1

; La següent opció permet generar la impressió a l'ordinador abans d'enviar-la a la impressora,
; cosa que resulta especialment útil en imprimir documents complexos (amb transparències,
; semitransparències, etc) en impressores de gran format (plòters).
; Els valors possibles són:
;   0=Envia la impressió directament a la impressora, excepte en el cas de semitransparències no de textos (valor per defecte).
;   1=Genera la impressió a l'ordinador abans d'enviar-la a la impressora, excepte en el cas de semitransparències de textos i
;     d'etiquetes dinàmiques.
;   2=Com 1, però la impressió es desa en un fitxer temporal abans de ser transferida a la impressora.
;     S'ha vist que aquest mode és necessari en la impressora HP 9600.
; GenerarImpressioAOrdinadorAbansDEnviarAImpressora=1
GenerarImpressioAOrdinadorAbansDEnviarAImpressora=0

; La següent opció és útil quan els drivers d'un dispositiu d'impressió
; no poden imprimir ràsters de més d'1 Mbyte o el resultat és una
; imatge corrompuda. NO recomanem l'opció 0.
; 0=No  1=Sí
ImprimirRastersEnPaquetsPetits=1

; Grandària màxima del paquets d'impressió de ràsters en X i en Y
; El valor per defecte és 768; una especificació més gran fa la impressió més ràpida, però
; alguns plòters tenen problemes, especialment quan la impressió es prepara "a la impressora"
; i no "a l'ordinador".
MaximPaquetX_a_Impressora=768
MaximPaquetY_a_Impressora=768

; La següent opció és útil quan els drivers d'un dispositiu d'impressió
; no poden imprimir transparències; la impressió es fa automàticament en rajoles
; per a les capes que tenen algun nivell de transparència, cosa que fa que
; molts drivers d'impressora puguin aleshores generar un resultat correcte.
; Indiqueu el nombre de píxels del costat de la rajola en la impressió.
; El valor per defecte és 512; si no voleu que es faci aquesta impressió per rajoles
; indiqueu 2147483648.
; MOLT IMPORTANT: Si malgrat usar un valor petit no s'imprimeix, indiqueu al driver que desitgeu
; preparar la impressió "a l'ordinador" i no "a la impressora".
PixelsPerRajolaImpressioTransp=512

; Màxim nombre de vistes WMS salvades per tal d'accelerar el redibuixat WMS. Aquestes vistes es desen al directori temporal
; i el MiraMon en gestiona l'esborrat cada cop que es tanca el programa o a l'endemà si la sessió ha acabat sobtadament.
: Si indiqueu 0 no se salva cap vista però el resultat és que cada redibuixat fa una sol·licitud als servidors, locals o
; remots, cosa que és sensiblement més lenta que si aprofitem que anteriorment ja havíem demanat la mateixa vista.
; El valor per defecte és 350.
;MaxNVistesWMSSalvades=350

; Indica si  les peticions a serveis WMS es volen fer ajustades a la mida de la finestra (valor 0) o bé simulant un servei
; WMTS,i fer-les de forma tessel·lada (valor 1; valor per defecte). Usar el WMS de forma tessel·lada, fa que la primera petició
; sigui més lenta, però optimitza els desplaçaments laterals, ja que la informació ja s'ha sol·licitat prèviament i s'aprofiten
; les peticions anteriors i només se sol·licita les tessel·les per les zones no visitades. En canvi, si s'usa un WMS no tessel·lat
; per cada vista es realitza una nova petició i descàrrega, exceptuant el cas que es visiti una zona dues vegades (però aquesta
; zona ha de coincidir totalment en àmbit i resolució, cosa poc probable).
;WMS_Tessellat=0

; Indica si es vol usar IE per descarregar fitxers d'Internet en les peticions OGC, o bé WinInet? 
; Si val 1 vol dir que es vol usar IE, que sembla ser més ràpid però permet controlar menys aspectes que l'altre mètode
; Si val 0 vol dir que es vol usar la funció WinInet, mètode habitual i valor per defecte
;UsaIEPerPeticionsOGC=0


; Indica el User Agent a usar en obrir una connexió a Internet. 
; El primer paràmetre va relacionat amb el navegador Web i els altres paràmetres amb la versió de Windows que tenim i també 
; es poden afegir altres paràmetres com l'aplicació des d'on s'inicia la connexió a Internet.
; Si no s'indica res s'usarà el valor per defecte "Mozilla/5.0 (compatible; Windows NT 6.1; Win64; x64; rv:74.0)"
; Segons la documentació del Mozilla Developer: The User-Agent request header is a characteristic string that lets servers and network peers identify the application, 
; operating system, vendor, and/or version of the requesting user agent.
; Syntax:
; User-Agent: <product> / <product-version> <comment>
; Common format for web browsers:
; User-Agent: Mozilla/5.0 (<system-information>) <platform> (<platform-details>) <extensions>
; Directives:
; <product> A product identifier — its name or development codename.
; <product-version> Version number of the product.
; <comment> Zero or more comments containing more details; sub-product information, for example. 
;InternetUserAgent=Mozilla/5.0 (compatible; Windows NT 6.1; Win64; x64; rv:74.0)


; Gestió de la memòria en fitxers de tipus IMG,TIFF
; Valors possibles:
;	0=Automàtic  1=Mantenir visualització preparada en memòria  2=Mantenir visualització preparada en disc temporal
;	3=Generar cada visualització a partir del fitxer original
; El valor per defecte és 0
; GestioMemoriaIMG=3
GestioMemoriaIMG=0

; Gestió de la memòria en fitxers de tipus RGB->24bits
; Valors possibles:
;	0=Automàtic  1=Mantenir visualització preparada en memòria  2=Mantenir visualització preparada en disc temporal
;	3=Generar cada visualització a partir del fitxer original
; El valor per defecte és 0
; GestioMemoriaRGB24=3
GestioMemoriaRGB24=0

; Gestió de la memòria en fitxers de tipus JPEG
; Valors possibles:
;	0=Automàtic  1=Mantenir visualització preparada en memòria  2=Mantenir visualització preparada en disc temporal
; El valor per defecte és 0
; GestioMemoriaJPEG=1
GestioMemoriaJPEG=0

; Gestió de la memòria en fitxers de tipus JPEG2000
; Valors possibles:
;	0=Automàtic  1=Mantenir visualització preparada en memòria  2=Mantenir visualització preparada en disc temporal
;	3=Generar cada visualització a partir del fitxer original
; El valor per defecte és 0
; GestioMemoriaJPEG2000=3
GestioMemoriaJPEG2000=0

; Gestió de la memòria en fitxers de tipus BMP
; Valors possibles:
;	0=Automàtic  1=Mantenir visualització preparada en memòria  2=Mantenir visualització preparada en disc temporal
;	3=Generar cada visualització a partir del fitxer original
; El valor per defecte és 0
; GestioMemoriaBMP=3
GestioMemoriaBMP=0

; Gestió de la memòria en fitxers de tipus SID
; Valors possibles:
;	0=Automàtic  1=Mantenir visualització preparada en memòria  2=Mantenir visualització preparada en disc temporal
;	3=Generar cada visualització a partir del fitxer original
; El valor per defecte és 0
; GestioMemoriaSID=3
GestioMemoriaSID=0

; Gestió de la memòria en fitxers de tipus ECW
; Valors possibles:
;	0=Automàtic  1=Mantenir visualització preparada en memòria
;	3=Generar cada visualització a partir del fitxer original
; El valor per defecte és 0
; GestioMemoriaECW=3
GestioMemoriaECW=0

; Gestió de la memòria en fitxers ràster llegits amb llibreries GDAL
;     0=Automàtic;
;     3=Generar cada visualització a partir del fitxer original
GestioMemoriaRasterGDAL=3

; Gestió de la memòria en fitxers vectorials de tipus PNT, ARC, NOD, POL, SHP i DXF.
; Valors possibles:
;	0=Automàtic  1=Mantenir visualització preparada en memòria
;	3=Generar cada visualització a partir del fitxer original
; El valor per defecte és 0
; GestioMemoriaVectorsTipics=1
GestioMemoriaVectorsTipics=0

; Gestió de la memòria en fitxers vectorials llegits amb llibreries GDAL/OGR
;     0=Automàtic
;     3=Generar cada visualització a partir del fitxer original
GestioMemoriaVectorGDAL=3

; Gestió de la memòria en taules DBF (clàssiques i esteses)
; Valors possibles:
; 0=Automàtic  1=Carregar en memòria
; 3=Gestionar a partir del fitxer original
; El valor per defecte és 0
; GestioMemoriaTaules=1
GestioMemoriaTaules=0


; Temps màxim d'espera (en segons) per visualitzar fitxers ECWP.
; El protocol ECWP (ecwp://) permet l'accés a fitxers ECW remots que,
; en determinades circumstàncies, poden tardar molt a arribar
; en la seva màxima resolució. Malgrat això, és possible que
; una imatge amb una qualitat raonable ja pugui ser visualitzada transcorregut
; un temps prudencial. Donat que la descàrrega del fragment
; de fitxer continua en segon pla, l'usuari pot demanar 
; un redibuixat (F5 o el botó/menú corresponent) per millorar la definició de la imatge
; mostrada.
; El valor per defecte és 7
;TempsEsperaRespostaECWP=7


