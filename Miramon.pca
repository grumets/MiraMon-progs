LastBatName=C:\MiraMon\Tasca.BAT
LastPSName=C:\MiraMon\Tasca.PS1


;==========================================================================
[Adreces_Internet]
;==========================================================================
; SECCIÓ PER A ADRECES d'INTERNET usades pel programa per obtenir recursos,...
;==========================================================================
; Adreça del correu electrònic de suport del MiraMon.
; El valor per defecte és suport@miramon.uab.cat
; AdrecaElectronicaSuport=suport@miramon.uab.cat

; Adreça del correu electrònic del contacte del MiraMon.
; El valor per defecte és contacte@miramon.uab.cat
; AdrecaElectronicaContacte=contacte@miramon.uab.cat

; Adreça de la web del MiraMon
; El valor per defecte és https://www.miramon.cat
; URLWebMiraMon=https://www.miramon.cat

; Adreça de la web del Fòrum d'usuaris del MiraMon
; El valor per defecte és https://www.miramon.cat/FUM
; URLWebFUM=https://www.miramon.cat/FUM

; Adreça web base d'on pengen diversos recursos necessaris pel funcionament 
; d'algunes opcions del programa, com ara les col·leccions preferides i
; les DLL's.
; El valor per defecte és https://www.miramon.cat/mmupdate
; URLBaseDescarreguesRecursos=https://www.miramon.cat/mmupdate

; Adreça de base de la web on es troba l'ajuda del programa per a ser descarregada
; El valor per defecte és https://www.miramon.cat/ajuda
; URLBaseWebAjuda=https://www.miramon.cat/ajuda

; Adreça de base de la web on es troben alguns recursos de tipus icona usats pel GeM+
; El valor per defecte és https://www.miramon.cat/md/GeMPlus
; URLBaseRecursosGeMPlus=https://www.miramon.cat/md/GeMPlus

; Adreça de base de la web on es troben els recursos OGC propis del programa
; és a dir, "schemas" i col·leccions de serveis OGC
; El valor per defecte és https://www.miramon.cat/ogc
; URLBaseOGCMM=https://www.miramon.cat/ogc


;==========================================================================
[Xarxa]
;==========================================================================
; SECCIÓ PER A INSTAL·LACIONS EN XARXA
;==========================================================================

; Temps suggerit a l'usuari per esperar que la xarxa respongui a les
; verificacions de llicència quan hi ha un error (en segons). Aquest
; valor apareix en el missatge:
;   "No access to network license. Please wait about 'x' seconds and retry."
; Aquest valor és irrellevant si instal·leu MM_NET en el "login script" o similar.
; L'administrador de la xarxa haurà d'ajustar aquesta variable seguint
; el següent protocol:
;   1/ Inicieu el MiraMon i, quan aparegui la caixa de presentació
;      del programa, espereu 10 segons abans d'acceptar.
;   2/ Si el programa s'inicia sense problemes, repetiu la prova
;      amb menys temps, per exemple 5 segons, fins que obtingueu
;      un missatge com l'anterior ("No access...").
;   3/ Torneu a augmentar el temps (p.ex. 7 segons) fins que no
;      tingueu problemes.
; Ajusteu la variable a un valor final una mica superior al que
; hagueu obtingut per aquest sistema d'assaig i error.
; Aquest valor és especialment important sota Windows 3.1x, ja que
; degut a les característiques de multitasca no preemptiva del
; sistema, de vegades resulta necessari indicar a l'usuari que esperi
; alguns segons per deixar que s'estableixin les connexions de xarxa;
; sota Windows 9x i NT aquest valor no hauria de ser mai suggerit a
; l'usuari ja que ajustant convenientment MaxReintents_1_Xarxa i
; MaxReintents_2_Xarxa el procés d'establiment de les connexions es
; pot fer totalment en segon pla gràcies a la multitasca real d'aquests
; sistemes operatius.
TempsEsperaRespostaXarxa=10

; Nombre de reintents en una xarxa abans d'assumir que hi ha un error
; real en la connexió amb el servidor.
; Aques paràmetre NO té efecte sota Windows 3.1x i HA DE VALER 1
; El valor per defecte previ a agost-2001 era 100, però l'increment
; de velocitat de les CPU ha fet aconsellable augmentar-lo.
MaxReintents_1_Xarxa=10000

; Nombre de reintents en una xarxa abans d'assumir que hi ha un error
; real en la verificació de la llicència amb el servidor.
; Aques paràmetre NO té efecte sota Windows 3.1x i HA DE VALER 1
MaxReintents_2_Xarxa=1000


;==========================================================================
[MENUS]
;==========================================================================
; SECCIÓ PER A MENUS PERSONALITZATS
;==========================================================================

; La clau "Suprimir" indica quines entrades del Menu desitgeu eliminar.
; Noteu que l'opció "Menú complet" no suprimeix res, mentre que l'opció
; "Menú Bàsic" suprimeix moltes entrades. Heu de referir-vos a cada entrada
; del menú utilitzant el codi numèric publicat al fitxer MM32.DST, que pot
; ser editat fent servir qualsevol editor de text.
; També noteu que les supressions són jeràrquiques; per tant, per suprimir
; tot un menú desplegable només cal que suprimiu l'entrada corresponent.
; Podeu crear les vostres configuracions de menú personalitzades. Les que
; hi ha a aquest fitxer són només exemples.

; La clau "MenusValids" indica els números (#) de les seccions MENU_# que
; voleu mostrar. La clau "MenuInicial" indica la configuració de menú per
; defecte quan s'inicia el MiraMon.

; La clau "Titol" és el títol de cada menú personalitzat.

; La clau "Insertar" permet que els usuaris afegeixin entrades per a
; llançar les seves aplicacions favorites. Les seccions APLIC_0, APLIC_1, etc
; permeten specificar el títol de les noves entrades, el codi del Menu després
; del qual es vol afegir l'entrada (utilitzeu un signe menys '-' per a indicar
; 'abans' i no 'després' del codi), la línia de comanda i, si cal, un separador.

MenusValids=0 1 2 5 3 4
MenuInicial=0

[MENU_0]
Titol=Menú Comp&let
Suprimir=
; Afegeixo dues aplicacions externes al final del menú Eines
Insertar=APLIC_0 APLIC_1

[MENU_1]
Titol=Menú &Avançat
; ·$· Provisional
Suprimir=20213 20267 20268 20360 20373
Insertar=APLIC_0 APLIC_1

[MENU_2]
Titol=Menú Inter&medi
; ·$· Provisional
Suprimir=20213 20267 20268 20312 20360 20373 20372

[MENU_3]
Titol=Menú &Bàsic
Suprimir=20204 20205 20206 20208 20210 20211 20213 20223 20233 20235 20236 20238 20265 20269 20273 20274 20294 20360 20299 20302 20305 20308 20309 20310 20311 20352 20312 20372 20373 20700

[MENU_4]
Titol=Menú de &Digitalització
Suprimir=20213 20223 20236 20267 20268 20360 20301 20302 20305 20352 20312 20372 20373 

[MENU_5]
;Titol=Menú &Internet/CD
Titol=Menú Lector Universal de Mapes del M&iraMon
;Suprimir=20204 20205 20206 20208 20210 20211 20213 20223 20233 20235 20236 20238 20265 20269 20273 20274 20360 20299 20302 20305 20311 20352 20312 20372 20373
Suprimir=20223 20236 20238 20273 20302 20305 20312 20373

[APLIC_0]
Titol=C&alculadora científica del Windows
IdMenu=20421
LiniaComanda=calc.exe
Separador=-1

[APLIC_1]
Titol=&Bloc de notes
IdMenu=20421
LiniaComanda=notepad.exe

;==========================================================================
[MSA]
;==========================================================================
; SECCIÓ PER A CONFIGURACIÓ DEL COMPORTAMENT DE LES APLICACIONS DE SUPORT AL MiraMon (MSA)
;==========================================================================

; Generació de camps amb distàncies i àrees el·lipsoidals: 0=No 1=Sí (defecte)
CampsAmbMesuresEllipsoidals=1

; Versió del REL/DOC/DVC en crear fitxers nous: 1=REL1/DOC/DV?, 4=REL4, 4+DOC=REL4 i DOC
; 4 és l'opció per defecte
VersioEnCrearREL=4

; Estil de llinatge usat per als fitxers nous o modificats: 
;    0/ El llinatge es representa de forma arbrada dins del REL de la capa 
;       resultat (s'importa el llinatge de les capes anteriors durant la creació 
;       de la capa i no crea vincles a les capes anteriors). (Introduït el 2015.)
;    1/ Llistat de processos simple sense mencionar formalment les fonts de dades 
;       (tot i que les fonts poden aparèixer citades en el text de la història de
;       cada procés). (Era l'únic estil disponible abans de 01-12-2013.)
;    2/ El llinatge s'hereta dels REL de les capes originals de forma arbrada. 
;       (Introduït el 01-12-2013 però com un altre número d'opció. S'ha canviat en evidenciar-se que
;       aquest estil genera una cadena de vincles entre capes que l'usuari sovint trenca,
;       sense voler-ho, per exemple esborrant capes intermèdies que ja no necessita. Per això es
;       considera que si l'usuari vol aquests vincles és millor que els estableixi
;       manualment amb el gestor de metadades [GeM+]). Valor per defecte.
;
;EstilLlinatge=2

; Indica que es vol obrir el fitxer resultat de l'execució d'una MSA de manera automàtica des de la sessió
; del MiraMon des d'on s'ha cridat la MSA. Valor per defecte: 1. (0 indica que no es vol obrir)
;ObrirResultatMSAaMiraMon=0

;==========================================================================
[ORGANISME]
;==========================================================================
; ORGANISME PER DEFECTE
;==========================================================================
; Organisme per defecte d'aquest usuari del MiraMon. Aquesta secció és creada pel
; programa d'instal·lació del MiraMon (Inst_MM9.exe a la versió 9 del MiraMon). Podeu
; obtenir una descripció detallada de les claus que descriuen un organisme al 
; manual del MiraMon
;==========================================================================

;IndividualName=
;PositionName=
;OrganisationName=CREAF
;n_onlineResource=2

;[ORGANISME:ONLINE_RESOURCE_1]
;linkage=http://www.creaf.cat
;function=2

;[ORGANISME:ONLINE_RESOURCE_2]
;linkage=https://www.miramon.cat
;function=2


;===========================================================================
[CONFIG_METADATA]
;===========================================================================
;===========================================================================
; CONFIGURAR VISUALITZACIÓ DE CLAUS OBLIGATÒRIES AL GESTOR DE METADADES
;===========================================================================
; La clau ObligatorietatNegreta indica al Gestor de Metadades que es vol mostrar
; les metadades obligatòries en negreta.
; Valors possibles:
; 0 -> No indicar les metadades obligatòries en negreta
; 1 -> Sí indicar les metadades obligatòries en negreta (valor per defecte)
;ObligatorietatNegreta=1

; La clau TipusObligatorietatEx indica 'qui' determina quines metadades són obligatòries al Gestor de Metadades (GeM+)
; (per exemple per mostrar-les en negreta si s'escau).
; Valors possibles:
; -1 -> Obligatorietat definida de forma automàtica segons el format (REL o XML) i els estàndards (ISO 19115-19139 o la directiva INSPIRE)  (valor per defecte)
; 0 -> Obligatorietat definida pel Gestor de Metadades (basada en els estàndards)
; 1 -> Obligatorietat definida per l'usuari
; 2 -> Obligatorietat definida per la ISO 1915-19139
; 3 -> Obligatorietat definida per la directiva INSPIRE
; 4 -> Obligatorietat definida per els paràmetres de l'IDEC
;TipusObligatorietatEx=-1

; En cas que TipusObligatorietat=1 (usuari), ubicació i nom de la plantilla de text
; que defineix l'obligatorietat de cada entrada de metadades.
; Per defecte, s'utilitza la plantilla interna del MiraMon per als estàndard ISO i GeM+.
; Aquesta plantilla es pot crear des del propi GeM+ en exportar les característiques
; d'obligatorietat des de la pestanya Configuració.
; PlantillaObligatoriUsu=c:\MiraMon\Plantill\PlantillaObligatoriUsu.txt
;PlantillaObligatoriUsu=

; La clau IdiomaMostrar indica quin és l'idioma de les metadades multiidiomàtiques
; que es vol visualitzar en obrir una capa al MiraMon i al propi Gestor de Metadades
; com a valor en primer terme.
; Per defecte s'inicialitza amb l'idioma en què està instal·lat el MiraMon,
; però en el Gestor de Metadades es pot modificar (per a aquella sessió del Gestor).
; La clau IdiomaMostrar permet forçar un idioma per damunt d'aquest comportament
; sempre i quan la capa tingui les metadades en l'idioma sol·licitat.
; Valors possibles:
; cat -> català
; spa -> castellà
; eng -> anglès
; alt -> l'altre idioma en què es poden documentar les metadades
; Recordeu que si no indiqueu res s'adopta l'idioma del MiraMon si coincideix amb
; un dels idiomes de la base.
IdiomaMostrar=cat

; La clau DesarProcesEdicioMD indica al Gestor de Metadades que en desar les
; metadades després de la seva edició des del GeM+ es vol crear (o actualitzar) 
; un procés de llinatge d'edició de metadades.
; Valors possibles:
; 0 -> No desar (ni actualitzar) els processos d'edició de metadades al llinatge (valor per defecte)
; 1 -> Desar (o actualitzar) els processos d'edició de metadades al llinatge
DesarProcesEdicioMD=0

; Color que es desitja com a color de fons de la interfície del GeM+
; Si no s'indica res s'usarà el color per defecte del Windows
ColorFons=(225, 234, 247)

; Color en que es pintaran les vores dels recursos de la interfície del GeM+
; Si no s'indica res s'usarà el color per defecte del Windows
ColorVores=(122,153,177)


; Algunes visualitzacions/exportacions de les metadades en HTML incorporen 
; o poden incorporar un mapa de situació elaborat a partir de l'envolupant de la capa i de mapes generals extrets de serveis WMS

; Mida màxima que tindrà el quadrat on es mostrarà la imatge de situació en les visualitzacions en HTML de les metadades
; Valor per defecte 300
MidaSituacioHTML=300

; Plantilles de peticions a capes en format WMS que s'usaran per construir la imatge de situació en les visualitzacions en HTML de les metadades
; Es començarà per la primera i si aquesta falla s'usarà la següent i així successivament
; Es tracta de peticions a serveis WMS amb tots els paràmetres establerts a excepció de BBOX, HEIGHT i WIDTH
; No hi ha cap valor per defecte
PeticioCapaWMS1=https://maps.heigit.org/osm-wms/service?SERVICE=WMS&VERSION=1.1.1&REQUEST=GetMap&SRS=EPSG:3857&LAYERS=osm_auto:all&FORMAT=image/jpeg&STYLES=default
PeticioCapaWMS2=https://ows.terrestris.de/osm/service?VERSION=1.1.1&REQUEST=GetMap&SRS=EPSG:4326&SERVICE=WMS&LAYERS=TOPO-OSM-WMS&FORMAT=image/jpeg&STYLES=default
PeticioCapaWMS3=https://ows.mundialis.de/osm/service?VERSION=1.1.1&REQUEST=GetMap&SRS=EPSG:4326&SERVICE=WMS&LAYERS=OSM-WMS&FORMAT=image/jpeg&STYLES=default
PeticioCapaWMS4=https://ows.terrestris.de/osm/service?VERSION=1.1.1&REQUEST=GetMap&SRS=EPSG:3857&SERVICE=WMS&LAYERS=OSM-WMS&FORMAT=image/jpeg&STYLES=default
PeticioCapaWMS5=https://ows.mundialis.de/osm/service?VERSION=1.1.1&REQUEST=GetMap&SRS=EPSG:3857&SERVICE=WMS&LAYERS=OSM-WMS&FORMAT=image/jpeg&STYLES=default
PeticioCapaWMS6=https://ows.terrestris.de/osm/service?VERSION=1.1.1&REQUEST=GetMap&SRS=EPSG:3857&SERVICE=WMS&LAYERS=TOPO-WMS&FORMAT=image/jpeg&STYLES=default
PeticioCapaWMS7=https://ows.mundialis.de/osm/service?VERSION=1.1.1&REQUEST=GetMap&SRS=EPSG:3857&SERVICE=WMS&LAYERS=TOPO-WMS&FORMAT=image/jpeg&STYLES=default

; La capa associada a les metadades, en cas que n'hi hagi, s'obrirà amb el programa registrat en el Windows.
; Si aquesta variable val 0, sempre s'obrirà amb el MiraMon o deixarà el botó innactiu 
; si no hi ha cap dels programes esmentats disponibles.
; Valor per defecte 1
UsarProgramaRegistrat=1

;===========================================================================
[GEODATABASE]
;===========================================================================
;===========================================================================
; CONFIGURACIÓ D'ASPECTES RELACIONATS AMB GEODATABASES: SDE, SDO,...
;===========================================================================
; La clau RefrescLlistaCapesSDO indica al MiraMon que es vol mostrar
; el botó de refresc de la llista de capes de l'SDO. És una acció que pot tardar
; molt i que pot interessar amagar a alguns usuaris.
; Valors possibles:
; 0: No, no permetre refrescar les capes.
; 1: Sí, permetre refrescar les capes.
;RefrescLlistaCapesSDO=0
RefrescLlistaCapesSDO=1