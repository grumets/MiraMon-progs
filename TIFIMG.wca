						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerPAL</ows:Identifier>
				<ows:Title>Fitxer paleta</ows:Title>
				<ows:Abstract>És el nom de la paleta</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
