		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TIFIMG:param1:3</ows:Identifier>
		<ows:Title>TIFF a IMG (paleta 8 bits)</ows:Title>
		<ows:Abstract>Aquesta opció transforma  fitxers TIFF amb paleta (8 bits) a un  fitxer IMG byte i paleta.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Transformació a IMG amb paleta.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerTIFFOri</ows:Identifier>
				<ows:Title>Fitxer TIFF entrada</ows:Title>
				<ows:Abstract>És el nom del fitxer TIFF del qual se'n vol obtenir la informació de capçalera o transformar-lo a IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerTIFFOri"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TFW</ows:Identifier>
				<ows:Title>Directori TFW</ows:Title>
				<ows:Abstract><![CDATA[Permet indicar el directori on buscar el <i>fitxer World</i> (*.TFW o *.TIFW) a aplicar per georeferènciar en les importacions de TIFF a IMG. Si no s'indica, es busca el <i>fitxer World</i> en el directori del TIFF.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DOC</ows:Identifier>
				<ows:Title>Fitxer patró per documentar</ows:Title>
				<ows:Abstract><![CDATA[Permet indicar un fitxer ràster de referència del que s'hereta la documentació. No s'hereta mai el nombre de files ni de columnes ni el rang de valors. En cas de presència de <i>fitxer World</i> o format GeoTiff els seus valor prevalen sobre els d'aquest fitxer.]]></ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_COMPRIMIR</ows:Identifier>
				<ows:Title>Generar fitxers IMG sense compressió</ows:Title>
				<ows:Abstract>En el cas de voler obtenir fitxers IMG importats sense compressió, cal establir aquest paràmetre modificador. Per defecte, totes les importacions TIFIMG es comprimeixen en format 'RLE extracomprimit indexat'.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>IDIOMA</ows:Identifier>
				<ows:Title>Generar noms de fitxers i els descriptors en l'idioma desitjat</ows:Title>
				<ows:Abstract>Si per exemple, es considera /IDIOMA=SPA /IDIOMATIC (afegint  el modificador /IDIOMATIC), es generaria una sortida amb els noms dels fitxers i els descriptors en castellà. La resta de metadades estaria en castellà. Alternativament, si per exemple, es considera /IDIOMA=ENG (sense afegir el modificador /IDIOMATIC), es generaria una sortida amb els noms en anglès i els descriptors en anglès, però les metadades en castellà.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>CAT</ows:Value>
						<ows:Value>ENG</ows:Value>
						<ows:Value>SPA</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerIMGResultat</ows:Identifier>
				<ows:Title>Fitxer IMG resultat</ows:Title>
				<ows:Abstract>És el nom del fitxer IMG resultat de transformació.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerIMGRes"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxerPAL</ows:Identifier>
				<ows:Title>Fitxer paleta</ows:Title>
				<ows:Abstract>És el nom de la paleta</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FitxerPAL"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-dbf</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TIFIMG:param1:4</ows:Identifier>
		<ows:Title>TIFF a IMG Multibanda</ows:Title>
		<ows:Abstract>Aquesta opció transforma  fitxers TIFF multibanda (RGB) a un  fitxer IMG per banda.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Transformació a IMG Multibanda</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerTIFFOri</ows:Identifier>
				<ows:Title>Fitxer TIFF entrada</ows:Title>
				<ows:Abstract>És el nom del fitxer TIFF del qual se'n vol obtenir la informació de capçalera o transformar-lo a IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerTIFFOri"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TFW</ows:Identifier>
				<ows:Title>Directori TFW</ows:Title>
				<ows:Abstract><![CDATA[Permet indicar el directori on buscar el <i>fitxer World</i> (*.TFW o *.TIFW) a aplicar per georeferènciar en les importacions de TIFF a IMG. Si no s'indica, es busca el <i>fitxer World</i> en el directori del TIFF.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DOC</ows:Identifier>
				<ows:Title>Fitxer patró per documentar</ows:Title>
				<ows:Abstract><![CDATA[Permet indicar un fitxer ràster de referència del que s'hereta la documentació. No s'hereta mai el nombre de files ni de columnes ni el rang de valors. En cas de presència de <i>fitxer World</i> o format GeoTiff els seus valor prevalen sobre els d'aquest fitxer.]]></ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_COMPRIMIR</ows:Identifier>
				<ows:Title>Generar fitxers IMG sense compressió</ows:Title>
				<ows:Abstract>En el cas de voler obtenir fitxers IMG importats sense compressió, cal establir aquest paràmetre modificador. Per defecte, totes les importacions TIFIMG es comprimeixen en format 'RLE extracomprimit indexat'.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>IDIOMA</ows:Identifier>
				<ows:Title>Generar noms de fitxers i els descriptors en l'idioma desitjat</ows:Title>
				<ows:Abstract>Si per exemple, es considera /IDIOMA=SPA /IDIOMATIC (afegint  el modificador /IDIOMATIC), es generaria una sortida amb els noms dels fitxers i els descriptors en castellà. La resta de metadades estaria en castellà. Alternativament, si per exemple, es considera /IDIOMA=ENG (sense afegir el modificador /IDIOMATIC), es generaria una sortida amb els noms en anglès i els descriptors en anglès, però les metadades en castellà.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>CAT</ows:Value>
						<ows:Value>ENG</ows:Value>
						<ows:Value>SPA</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerIMG_R</ows:Identifier>
				<ows:Title>Fitxer IMG vermell</ows:Title>
				<ows:Abstract>És el nom del fitxer IMG vermell resultat de transformació.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerIMG_R"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxerIMG_G</ows:Identifier>
				<ows:Title>Fitxer IMG verd</ows:Title>
				<ows:Abstract>És el nom del fitxer IMG verd resultat de transformació.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:FitxerIMG_G"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxerIMG_B</ows:Identifier>
				<ows:Title>Fitxer IMG blau</ows:Title>
				<ows:Abstract>És el nom del fitxer IMG blau resultat de transformació.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:FitxerIMG_B"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TIFIMG:param1:5</ows:Identifier>
		<ows:Title>IMG a TIFF (b/n 1 bit)</ows:Title>
		<ows:Abstract>Aquesta opció transforma fitxers IMG (1bit) a un fitxer TIFF b/n (1 bit).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Transformació a TIFF bit</ows:Abstract>
