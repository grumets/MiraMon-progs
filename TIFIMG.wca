<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TIFIMG:param1:0</ows:Identifier>
		<ows:Title>Informació TIFF</ows:Title>
		<ows:Abstract>Aquesta opció mostra la informació de la capçalera d'un fitxer TIFF.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversió entre formats TIFF i IMG"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació permet transformar bidireccionalment fitxers TIFF i IMG."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Informació de la capçalera d'un fitxer TIFF.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerTIFFOri</ows:Identifier>
				<ows:Title>Fitxer TIFF entrada</ows:Title>
				<ows:Abstract>És el nom del fitxer TIFF del qual se'n vol obtenir la informació de capçalera o transformar-lo a IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerTIFFOri"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TFW</ows:Identifier>
				<ows:Title>Directori TFW</ows:Title>
				<ows:Abstract><![CDATA[Permet indicar el directori on buscar el <i>fitxer World</i> (*.TFW o *.TIFW) a aplicar per georeferènciar en les importacions de TIFF a IMG. Si no s'indica, es busca el <i>fitxer World</i> en el directori del TIFF.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DOC</ows:Identifier>
				<ows:Title>Fitxer patró per documentar</ows:Title>
				<ows:Abstract><![CDATA[Permet indicar un fitxer ràster de referència del que s'hereta la documentació. No s'hereta mai el nombre de files ni de columnes ni el rang de valors. En cas de presència de <i>fitxer World</i> o format GeoTiff els seus valor prevalen sobre els d'aquest fitxer.]]></ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>stdout</ows:Identifier>
				<ows:Title>Estàndard de sortida</ows:Title>
				<ows:Abstract>Informació sobre el TIFF</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TIFIMG:param1:1</ows:Identifier>
		<ows:Title>TIFF a IMG (b/n 1 bit)</ows:Title>
		<ows:Abstract>Aquesta opció transforma fitxers TIFF b/n (1 bit) a fitxer IMG (1bit) .</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Transformació a IMG bit.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerTIFFOri</ows:Identifier>
				<ows:Title>Fitxer TIFF entrada</ows:Title>
				<ows:Abstract>És el nom del fitxer TIFF del qual se'n vol obtenir la informació de capçalera o transformar-lo a IMG.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FitxerTIFFOri"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/tiff</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TFW</ows:Identifier>
				<ows:Title>Directori TFW</ows:Title>
				<ows:Abstract><![CDATA[Permet indicar el directori on buscar el <i>fitxer World</i> (*.TFW o *.TIFW) a aplicar per georeferènciar en les importacions de TIFF a IMG. Si no s'indica, es busca el <i>fitxer World</i> en el directori del TIFF.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DOC</ows:Identifier>
				<ows:Title>Fitxer patró per documentar</ows:Title>
				<ows:Abstract><![CDATA[Permet indicar un fitxer ràster de referència del que s'hereta la documentació. No s'hereta mai el nombre de files ni de columnes ni el rang de valors. En cas de presència de <i>fitxer World</i> o format GeoTiff els seus valor prevalen sobre els d'aquest fitxer.]]></ows:Abstract>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_COMPRIMIR</ows:Identifier>
				<ows:Title>Generar fitxers IMG sense compressió</ows:Title>
				<ows:Abstract>En el cas de voler obtenir fitxers IMG importats sense compressió, cal establir aquest paràmetre modificador. Per defecte, totes les importacions TIFIMG es comprimeixen en format 'RLE extracomprimit indexat'.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>IDIOMA</ows:Identifier>
				<ows:Title>Generar noms de fitxers i els descriptors en l'idioma desitjat</ows:Title>
				<ows:Abstract>Si per exemple, es considera /IDIOMA=SPA /IDIOMATIC (afegint  el modificador /IDIOMATIC), es generaria una sortida amb els noms dels fitxers i els descriptors en castellà. La resta de metadades estaria en castellà. Alternativament, si per exemple, es considera /IDIOMA=ENG (sense afegir el modificador /IDIOMATIC), es generaria una sortida amb els noms en anglès i els descriptors en anglès, però les metadades en castellà.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>CAT</ows:Value>
						<ows:Value>ENG</ows:Value>
						<ows:Value>SPA</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerIMGResultat</ows:Identifier>
				<ows:Title>Fitxer IMG resultat</ows:Title>
				<ows:Abstract>És el nom del fitxer IMG resultat de transformació.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FitxerIMGRes"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:TIFIMG:param1:2</ows:Identifier>
		<ows:Title>TIFF a IMG (gris 8 bits)</ows:Title>
		<ows:Abstract>Aquesta opció transforma  fitxers TIFF gris o MDT (8 bits) a fitxers IMG byte (8 bit).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract>Transformació a IMG byte.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opcio"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerTIFFOri</ows:Identifier>
