<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:NDFIMG:1</ows:Identifier>
		<ows:Title>Importació del format NetCDF</ows:Title>
		<ows:Abstract>Aquest mòdul permet la importació de certs formats NetCDF al format vectorial estructurat de punts de MiraMon PNT. NetCDF respon a les inicials de Network Common Data Form i és un format habitual en àmbits meteorològics. La seva gran flexibilitat i adaptabilitat el fa adequat per a diferents tipus de dades: observacions puntuals, sèries temporals, imatges de satèl·lit o de radar, etc.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importació del format NetCDF"/>
		<ows:Metadata xlink:title="Abstract:Aquest mòdul permet la importació de certs formats NetCDF al format vectorial estructurat de punts de MiraMon PNT. NetCDF respon a les inicials de Network Common Data Form i és un format habitual en àmbits meteorològics. La seva gran flexibilitat i adaptabilitat el fa adequat per a diferents tipus de dades: observacions puntuals, sèries temporals, imatges de satèl·lit o de radar, etc."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opcio</ows:Title>
				<ows:Abstract>Opcio pot ser: <![CDATA[<li>1. si desitgeu que no es reprojectin els punts, o sigui que es mantinguin en el sistema de referència del fitxer CDF.</li><li>2. si desitgeu que es reprojecti a qualsevol dels sistemes de referència suportats per MiraMon. Cal identificar correctament el datum del sistema de referència origen.</li>]]>
</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<LiteralData>
					<ows:AllowedValues>
					<ows:Value>1</ows:Value>
					<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Fitxer_CDF</ows:Identifier>
				<ows:Title>Fitxer CDF</ows:Title>
				<ows:Abstract>És el fitxer CDF a importar (amb extensió).</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-CDF</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
					<MimeType>application/x-CDF</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>N_decimals</ows:Identifier>
				<ows:Title>Numero de decimals</ows:Title>
				<ows:Abstract>Serà el nombre de dígits decimals amb que s'escriuran els camps numèrics reals en la base de dades.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_ORI</ows:Identifier>
				<ows:Title>Sistema de referencia</ows:Title>
				<ows:Abstract>Indica l'identificador del sistema de referència del fitxer NetCDF. El seu valor per defecte és lat/long-ED50.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>SIST_DEST</ows:Identifier>
				<ows:Title>Sistema de referencia</ows:Title>
				<ows:Abstract>Indica l'identificador del sistema de referència del fitxer destí. El seu valor per defecte és el corresponent a la clau RefSystem= de la secció [Metrica] del fitxer de configuració MiraMon.par.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
			<ProcessOutputs>
				<Output>
					<ows:Identifier>Fitxer_Desti</ows:Identifier>
					<ows:Title>Fitxer Desti</ows:Title>
					<ows:Abstract>és el fitxer PNT resultat.
					</ows:Abstract>
					<ows:Metadata xlink:title="Param3"/>
					<ComplexOutput>
						<Default>
							<Format>
								<MimeType>application/x-pnt</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Default>
						<Supported>
							<Format>
								<MimeType>application/x-pnt</MimeType>
								<Encoding>Binary</Encoding>
							</Format>
						</Supported>
					</ComplexOutput>
				</Output>
			</ProcessOutputs>
		</ProcessDescription>
</wps:ProcessDescriptions>
