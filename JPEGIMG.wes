<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:0</ows:Identifier>
		<ows:Title>Información de cabaçera</ows:Title>
		<ows:Abstract>(Opció 0) Muestra Metadatos</ows:Abstract>
		<ows:Metadata xlink:title="Title:Conversión entre ficheros ráster JPEG y IMG o BMP"/>
		<ows:Metadata xlink:title="Abstract:Este programa transforma entre el formato IMG de MiraMon o el formato BMP (sin georeferencia), al formato JPEG con metadatos de MiraMon o al formato JPEG (sin georeferencia)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Metadatos</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>0</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>Fichero JPEG</ows:Title>
				<ows:Abstract>Es el nombre del fichero JPEG  del que se quiere obtener información de los metadatos.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroJPEG"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>Stdout</ows:Identifier>
				<ows:Title>Estándar de salida</ows:Title>
				<ows:Abstract>Información de los metadatos del fichero JPEG.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-display</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:1&amp;!Param5</ows:Identifier>
		<ows:Title>IMG/BMP a JPEG</ows:Title>
		<ows:Abstract>(Opción 1)  Paso de IMG/BMP a JPEG. En esta opción se transforma un BMP (FicheroIn), un IMG con paleta de grises (FicheroIn), un IMG con paleta P25 (FicheroIn y FicheroP25) o una combinación RGB (FicheroR, FicheroG y FicheroB) a un único fichero JPEG (FicheroJPEG).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Conversión de fichero IMG/BMP a JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerIn</ows:Identifier>
				<ows:Title>Fichero entrada</ows:Title>
				<ows:Abstract>Es el nombre del fichero imagen que queremos trasnformar.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroIn"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/bmp</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FitxerP25</ows:Identifier>
				<ows:Title>Fichero P25</ows:Title>
				<ows:Abstract>És el nombre de la paleta que se utilitzara para representar el JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Name:FicheroP25"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALITAT</ows:Identifier>
				<ows:Title>Qualidad</ows:Title>
				<ows:Abstract>Calidad de compresión en un rango [0,100], donde [5,95] es el rango útil aunque en muchos casos introduciremos un valor entre 70 y 75 (por defecto es 75). Los valores bajos indican poca calidad pero mucha compresión.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>100</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRISOS</ows:Identifier>
				<ows:Title>Grises</ows:Title>
				<ows:Abstract>Crea un JPEG en escala de grisos: converteix un ràster color a escala de grisos (monocrom).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPTIMITZAT</ows:Identifier>
				<ows:Title>Optimitzat</ows:Title>
				<ows:Abstract>Optimiza la tabla de Huffman (el fichero será más pequeño pero la compresión será más lenta).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PROGRESSIU</ows:Identifier>
				<ows:Title>Progressivo</ows:Title>
				<ows:Abstract>Crea un JPEG progresivo. Este tipo de JPG permite previsualización en las primeras fases de la descompresión.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DENOM_ESCALA</ows:Identifier>
				<ows:Title>Denominador de escala</ows:Title>
				<ows:Abstract>Denominador de la escala a la que desea imprimir el JPEG o 0 si no quiere indicarlo. La información sobre el tamaño de celda del ráster mas este parámetro sirven para guardar internamente en el JPEG el tamaño del pixel de la imagen de salida en unidades papel, como los ppp (píxels por pulgada).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_METADADES</ows:Identifier>
				<ows:Title>No metadades</ows:Title>
				<ows:Abstract>Indica que no se desea crear un fichero de metadatos asociado al fichero JPEG en base a los metadatos de los ficheros IMG. Por defecto se crea. No aplica si el fichero a transformar no es un IMG.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>Fichero JPEG</ows:Title>
				<ows:Abstract>Es el nombre del fichero JPEG  del que se quiere obtener información de los metadatos.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroJPEG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:2&amp;!Param5</ows:Identifier>
		<ows:Title>JPEG a IMG/BMP</ows:Title>
		<ows:Abstract>(Opción 2) Paso de JPEG a IMG/BMP: En esta opción se transforma un JPEG (FicheroJPEGs) a BMP (FicheroIn), a un IMG con paleta de grises (FicheroIn), a un IMG con paleta P25 predefinida (FicheroIn y FicheroP25), a un IMG con paleta P25 optimizada (FicheroIn y FicheroP25), o a una combinación RGB (FicheroR, FicheroG, y FicheroB).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Conversión de fichero JPEG a IMG/BMP.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>Fichero JPEG</ows:Title>
				<ows:Abstract>Es el nombre del fichero JPEG  del que se quiere obtener información de los metadatos.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroJPEG"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FitxerP25</ows:Identifier>
				<ows:Title>Fichero P25</ows:Title>
				<ows:Abstract>És el nombre de la paleta que se utilitzara para representar el JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Name:FicheroP25"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NCOLORS</ows:Identifier>
				<ows:Title>Nombre de colors</ows:Title>
				<ows:Abstract>Fuerza una reducción del espacio de colores a un número de colores limitado a n. Éste será el número final de colores en la paleta si solicita IMG+paleta optimizada.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MAP_PAL</ows:Identifier>
				<ows:Title>Paleta determinada</ows:Title>
				<ows:Abstract>Fuerza el espacio de color en una paleta determinada. Note que si indica este parámetro, la paleta indicada es leída del disco. Si no se indica este parámetro el programa escribe en disco una paleta optimizada para esta imagen en concreto.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_SUAVIZAT</ows:Identifier>
				<ows:Title>No suavitzat</ows:Title>
				<ows:Abstract>Permite no hacer el paso de suavizado de mediciones que mejora el resultado final.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>1PAS</ows:Identifier>
				<ows:Title>Un sol pas</ows:Title>
				<ows:Abstract>Usar un solo paso de cuantización. El resultado se obtiene más rápidamente pero tiene más baja calidad. Requiere menos memoria.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ESCALAT</ows:Identifier>
				<ows:Title>Escala</ows:Title>
				<ows:Abstract>m/n Escalado de salida expresado en una fracción m/n, p.ej: 1/8. Este parámetro resulta útil cuando la imagen, una vez descomprimida, resultaría inaceptablemente grande.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FWORLD</ows:Identifier>
				<ows:Title>Fitxer World</ows:Title>
				<ows:Abstract>Genera un fichero world de la extensión indicada.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerIMGBMP</ows:Identifier>
				<ows:Title>Fichero IMG/BMP</ows:Title>
				<ows:Abstract>Es el nombre del fichero IMG que queremos trasnformar a JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:3&amp;!Param5</ows:Identifier>
		<ows:Title>IMG/BMP a JPEG Indexat</ows:Title>
		<ows:Abstract>(Opción 3)Paso de IMG/BMP a JPEG Indexado. En esta opción se transforma un BMP (FitxerIn), un IMG con paleta de grises (FicherIn), un IMG con paleta P25 (FitxerIn i FitxerP25) o una combinación RGB (FicheroR, FicheroG i FicheroB) a un unico fichero JPEG Indexado (FicheroJPEG).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Conversión de fichero IMG/BMP a JPEG indexado.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerIMGBMP</ows:Identifier>
				<ows:Title>Fichero IMG/BMP</ows:Title>
				<ows:Abstract>Es el nombre del fichero IMG que queremos trasnformar a JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FitxerP25</ows:Identifier>
				<ows:Title>Fichero P25</ows:Title>
				<ows:Abstract>És el nombre de la paleta que se utilitzara para representar el JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Name:FicheroP25"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALITAT</ows:Identifier>
				<ows:Title>Qualidad</ows:Title>
				<ows:Abstract>Calidad de compresión en un rango [0,100], donde [5,95] es el rango útil aunque en muchos casos introduciremos un valor entre 70 y 75 (por defecto es 75). Los valores bajos indican poca calidad pero mucha compresión.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>100</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_METADADES</ows:Identifier>
				<ows:Title>No metadades</ows:Title>
				<ows:Abstract>Indica que no se desea crear un fichero de metadatos asociado al fichero JPEG en base a los metadatos de los ficheros IMG. Por defecto se crea. No aplica si el fichero a transformar no es un IMG.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FWORLD</ows:Identifier>
				<ows:Title>Fitxer World</ows:Title>
				<ows:Abstract>Genera un fichero world de la extensión indicada.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NFIL_PAQUET</ows:Identifier>
				<ows:Title>Previsualitzación</ows:Title>
				<ows:Abstract>Nombre de filas de cada paquet indexado. Se recomienda que sea superior a 64.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUICKLOOK</ows:Identifier>
				<ows:Title>Quicklook</ows:Title>
				<ows:Abstract>Imagen pequeña que Windows ensenya como a previsualitzación y que todos los programas de processamiento de imagenes obrirán dado que no saben leer el formato JPEG indexado de MiraMon. Puede no indicarse y en este caso Windows y los otros programas muestraran solo el primer paquete de filas de la imagen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>Fichero JPEG</ows:Title>
				<ows:Abstract>Es el nombre del fichero JPEG  del que se quiere obtener información de los metadatos.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:FicheroJPEG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:1&amp;Param5</ows:Identifier>
		<ows:Title>IMG/BMP Multibanda a JPEG</ows:Title>
		<ows:Abstract>(Opción 1) Paso de IMG/BMP a JPEG. En esta opción se transforma un BMP (FicheroIn), un IMG con paleta de grises (FicheroIn), un IMG con paleta P25 (FicheroIn y FicheroP25) o una combinación RGB (FicheroR, FicheroG i FicheroB) a un unico fichero JPEG (FicheroJPEG).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Conversión de fichero IMG/BMP a JPEG.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerR</ows:Identifier>
				<ows:Title>Fichero Vermell</ows:Title>
				<ows:Abstract>Fichero de la banda del rojo</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerG</ows:Identifier>
				<ows:Title>Fichero Verde</ows:Title>
				<ows:Abstract>Fichero de la banda del verde</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerB</ows:Identifier>
				<ows:Title>Fichero Blau</ows:Title>
				<ows:Abstract>Fichero de la banda del azul</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALITAT</ows:Identifier>
				<ows:Title>Qualidad</ows:Title>
				<ows:Abstract>Calidad de compresión en un rango [0,100], donde [5,95] es el rango útil aunque en muchos casos introduciremos un valor entre 70 y 75 (por defecto es 75). Los valores bajos indican poca calidad pero mucha compresión.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>100</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRISOS</ows:Identifier>
				<ows:Title>Grises</ows:Title>
				<ows:Abstract>Crea un JPEG en escala de grisos: converteix un ràster color a escala de grisos (monocrom).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OPTIMITZAT</ows:Identifier>
				<ows:Title>Optimitzat</ows:Title>
				<ows:Abstract>Optimiza la tabla de Huffman (el fichero será más pequeño pero la compresión será más lenta).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PROGRESSIU</ows:Identifier>
				<ows:Title>Progressivo</ows:Title>
				<ows:Abstract>Crea un JPEG progresivo. Este tipo de JPG permite previsualización en las primeras fases de la descompresión.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DENOM_ESCALA</ows:Identifier>
				<ows:Title>Denominador de escala</ows:Title>
				<ows:Abstract>Denominador de la escala a la que desea imprimir el JPEG o 0 si no quiere indicarlo. La información sobre el tamaño de celda del ráster mas este parámetro sirven para guardar internamente en el JPEG el tamaño del pixel de la imagen de salida en unidades papel, como los ppp (píxels por pulgada).</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_METADADES</ows:Identifier>
				<ows:Title>No metadades</ows:Title>
				<ows:Abstract>Indica que no se desea crear un fichero de metadatos asociado al fichero JPEG en base a los metadatos de los ficheros IMG. Por defecto se crea. No aplica si el fichero a transformar no es un IMG.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>Fichero JPEG</ows:Title>
				<ows:Abstract>Es el nombre del fichero JPEG  del que se quiere obtener información de los metadatos.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroJPEG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:2&amp;Param5</ows:Identifier>
		<ows:Title>JPEG a IMG/BMP MultiBanda</ows:Title>
		<ows:Abstract>(Opción 2)Paso de JPEG a IMG/BMP: En esta opción se transforma un JPEG (FicheroJPEGs) a BMP (FicheroIn), a un IMG con paleta de grises (FicheroIn), a un IMG con paleta P25 predefinida (FicheroIn y FicheroP25), a un IMG con paleta P25 optimizada (FicheroIn y FicheroP25), o a una combinación RGB (FicheroR, FicheroG, y FicheroB).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Conversión de fichero JPEG a IMG/BMP.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>Fichero JPEG</ows:Title>
				<ows:Abstract>Es el nombre del fichero JPEG  del que se quiere obtener información de los metadatos.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroJPEG"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NCOLORS</ows:Identifier>
				<ows:Title>Nombre de colors</ows:Title>
				<ows:Abstract>Fuerza una reducción del espacio de colores a un número de colores limitado a n. Éste será el número final de colores en la paleta si solicita IMG+paleta optimizada.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MAP_PAL</ows:Identifier>
				<ows:Title>Paleta determinada</ows:Title>
				<ows:Abstract>Fuerza el espacio de color en una paleta determinada. Note que si indica este parámetro, la paleta indicada es leída del disco. Si no se indica este parámetro el programa escribe en disco una paleta optimizada para esta imagen en concreto.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_SUAVIZAT</ows:Identifier>
				<ows:Title>No suavitzat</ows:Title>
				<ows:Abstract>Permite no hacer el paso de suavizado de mediciones que mejora el resultado final.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>1PAS</ows:Identifier>
				<ows:Title>Un sol pas</ows:Title>
				<ows:Abstract>Usar un solo paso de cuantización. El resultado se obtiene más rápidamente pero tiene más baja calidad. Requiere menos memoria.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>ESCALAT</ows:Identifier>
				<ows:Title>Escala</ows:Title>
				<ows:Abstract>m/n Escalado de salida expresado en una fracción m/n, p.ej: 1/8. Este parámetro resulta útil cuando la imagen, una vez descomprimida, resultaría inaceptablemente grande.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FWORLD</ows:Identifier>
				<ows:Title>Fitxer World</ows:Title>
				<ows:Abstract>Genera un fichero world de la extensión indicada.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerR</ows:Identifier>
				<ows:Title>Fichero Vermell</ows:Title>
				<ows:Abstract>Fichero de la banda del rojo</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxerG</ows:Identifier>
				<ows:Title>Fichero Verde</ows:Title>
				<ows:Abstract>Fichero de la banda del verde</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>FitxerB</ows:Identifier>
				<ows:Title>Fichero Blau</ows:Title>
				<ows:Abstract>Fichero de la banda del azul</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:3&amp;Param5</ows:Identifier>
		<ows:Title>IMG/BMP Multibanda JPEG Indexado</ows:Title>
		<ows:Abstract>(Opció 3) Paso de IMG/BMP a JPEG Indexado. Es esta opción se transforma un BMP (FicheroIn), un IMG con paleta de grises (FicheroIn), un IMG con paleta P25 (FicheroIn y FicheroP25) o una combinación RGB (FicheroR, FicheroG i FicheroB) a un unic fichero JPEG Indexado (FicheroJPEG).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Conversión de fichero IMG/BMP a JPEG indexado.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerR</ows:Identifier>
				<ows:Title>Fichero Vermell</ows:Title>
				<ows:Abstract>Fichero de la banda del rojo</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerG</ows:Identifier>
				<ows:Title>Fichero Verde</ows:Title>
				<ows:Abstract>Fichero de la banda del verde</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerB</ows:Identifier>
				<ows:Title>Fichero Blau</ows:Title>
				<ows:Abstract>Fichero de la banda del azul</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-BMP</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUALITAT</ows:Identifier>
				<ows:Title>Qualidad</ows:Title>
				<ows:Abstract>Calidad de compresión en un rango [0,100], donde [5,95] es el rango útil aunque en muchos casos introduciremos un valor entre 70 y 75 (por defecto es 75). Los valores bajos indican poca calidad pero mucha compresión.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Range>
							<ows:MinimumValue>0</ows:MinimumValue>
							<ows:MaximumValue>100</ows:MaximumValue>
							<ows:Spacing>1</ows:Spacing>
						</ows:Range>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_METADADES</ows:Identifier>
				<ows:Title>No metadades</ows:Title>
				<ows:Abstract>Indica que no se desea crear un fichero de metadatos asociado al fichero JPEG en base a los metadatos de los ficheros IMG. Por defecto se crea. No aplica si el fichero a transformar no es un IMG.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>FWORLD</ows:Identifier>
				<ows:Title>Fitxer World</ows:Title>
				<ows:Abstract>Genera un fichero world de la extensión indicada.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NFIL_PAQUET</ows:Identifier>
				<ows:Title>Previsualitzación</ows:Title>
				<ows:Abstract>Nombre de filas de cada paquet indexado. Se recomienda que sea superior a 64.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>QUICKLOOK</ows:Identifier>
				<ows:Title>Quicklook</ows:Title>
				<ows:Abstract>Imagen pequeña que Windows ensenya como a previsualitzación y que todos los programas de processamiento de imagenes obrirán dado que no saben leer el formato JPEG indexado de MiraMon. Puede no indicarse y en este caso Windows y los otros programas muestraran solo el primer paquete de filas de la imagen.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerJPEG</ows:Identifier>
				<ows:Title>Fichero JPEG</ows:Title>
				<ows:Abstract>Es el nombre del fichero JPEG  del que se quiere obtener información de los metadatos.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroJPEG"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>image/jpeg</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>