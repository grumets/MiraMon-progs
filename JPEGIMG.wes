		<ows:Value>27</ows:Value>
		<ows:Value>28</ows:Value>
		<ows:Value>29</ows:Value>
		<ows:Value>30</ows:Value>
		<ows:Value>31</ows:Value>
		<ows:Value>32</ows:Value>
		<ows:Value>33</ows:Value>
		<ows:Value>34</ows:Value>
		<ows:Value>35</ows:Value>
		<ows:Value>36</ows:Value>
		<ows:Value>37</ows:Value>
		<ows:Value>38</ows:Value>
		<ows:Value>39</ows:Value>
		<ows:Value>40</ows:Value>
		<ows:Value>41</ows:Value>
		<ows:Value>42</ows:Value>
		<ows:Value>43</ows:Value>
		<ows:Value>44</ows:Value>
