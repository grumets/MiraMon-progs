		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:JPEGIMG:Param1:3&amp;Param5</ows:Identifier>
		<ows:Title>IMG/BMP Multibanda JPEG Indexado </ows:Title>
		<ows:Abstract>(Opció 3) Paso de IMG/BMP a JPEG Indexado. Es esta opción se transforma un BMP (FicheroIn), un IMG con paleta de grises (FicheroIn), un IMG con paleta P25 (FicheroIn y FicheroP25) o una combinación RGB (FicheroR, FicheroG i FicheroB) a un unic fichero JPEG Indexado (FicheroJPEG).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcion</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>3. IMG/BMP a JPEG Indexado.</ows:Abstract>
			<ows:Metadata xlink:title="Param1" />
		<LiteralData>
			<ows:AllowedValues><ows:Value>3</ows:Value></ows:AllowedValues>
		</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FicheroR</ows:Identifier>
				<ows:Title>Fitxer Rojo</ows:Title>
				<ows:Abstract>Fichero de la banda del rojo</ows:Abstract>
			<ows:Metadata xlink:title="Param3" />
		<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-BMP</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
						<MimeType>application/x-BMP</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
			<ows:Identifier>FicheroG</ows:Identifier>
				<ows:Title>Fitxer Verde</ows:Title>
				<ows:Abstract>Fichero de la banda del verde</ows:Abstract>
			<ows:Metadata xlink:title="Param4" />
		<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-BMP</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
						<MimeType>application/x-BMP</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>		
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FicheroB</ows:Identifier>
				<ows:Title>Fitxer Azul</ows:Title>
				<ows:Abstract>Fichero de la banda del azul</ows:Abstract>
			<ows:Metadata xlink:title="Param5" />
		<ComplexData>
				<Default>
					<Format>
						<MimeType>application/x-BMP</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Default>
				<Supported>
					<Format>
						<MimeType>application/x-BMP</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
					<Format>
						<MimeType>application/x-IMG</MimeType>
						<Encoding>Binary</Encoding>
					</Format>
				</Supported>
			</ComplexData>
			</Input>		
			<Input minOccurs="0" maxOccurs="1">
			<ows:Identifier>Calidad</ows:Identifier>
				<ows:Title>Calidad</ows:Title>
				<ows:Abstract>Calidad de compressión en un rang [0,100], donde [5,95] es el rango útil aunque en muchos casos introduciremos un valor entre 70 y 75 (por defecto es 75). Los valores bajos indican muy poca calidad pero mucha compressión.</ows:Abstract>
