<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Rutes:Param1:1</ows:Identifier>
		<ows:Title>Minimum distance</ows:Title>
		<ows:Abstract>This option calculates the minimum accumulated distance.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Network analysis and determination of the optimal route"/>
		<ows:Metadata xlink:title="Abstract:This program determines the optimal routes between a set of origin locations and a set of potential destination locations. The optimal route between an origin-destination pair is the one that minimizes the travel required to go from the origin to the destination—whether in terms of distance, time, or a user-defined numeric field representing any other variable that weights the cost of travel."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 1</ows:Title>
				<ows:Abstract>By minimum cumulative distance.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerArcs</ows:Identifier>
				<ows:Title>Arcs file</ows:Title>
				<ows:Abstract>It is the name of the structured arc file containing the path network.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:ArcsFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampTipusNode</ows:Identifier>
				<ows:Title>Node-type field</ows:Title>
				<ows:Abstract>It is the alphanumeric field in the ArcsFile node file database that indicates whether a node is a start node (value "O"), an end node (value "D"), or both (value "A").</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Node-typeField"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DistànciaMàxima</ows:Identifier>
				<ows:Title>Maximum distance</ows:Title>
				<ows:Abstract>It represents the maximum threshold (in meters) for discarding routes that exceed this cumulative length.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:MaximumDistance"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_LONG</ows:Identifier>
				<ows:Title>CAMP LONG</ows:Title>
				<ows:Abstract>Specify the field in the FitxerArcs database that will contain the lengths of each arc, which will be used instead of the topological values ??present by default in the database.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_VINCULAR</ows:Identifier>
				<ows:Title>NO_VINCULAR</ows:Title>
				<ows:Abstract>This parameter eliminates the default behavior of linking the resulting DBF table to the database associated with the source node file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>BDResultats</ows:Identifier>
				<ows:Title>DB results</ows:Title>
				<ows:Abstract>It is the name of the DBF file that will establish the relationships between origin and destination nodes and store the accumulated distance and/or time values.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:DBResults"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Rutes:Param1:2</ows:Identifier>
		<ows:Title>Accumulated time</ows:Title>
		<ows:Abstract>This option calculates the minimum accumulated time.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 2</ows:Title>
				<ows:Abstract>For the shortest accumulated time.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerArcs</ows:Identifier>
				<ows:Title>Arcs file</ows:Title>
				<ows:Abstract>It is the name of the structured arc file containing the path network.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:ArcsFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampTipusNode</ows:Identifier>
				<ows:Title>Node-type field</ows:Title>
				<ows:Abstract>It is the alphanumeric field in the ArcsFile node file database that indicates whether a node is a start node (value "O"), an end node (value "D"), or both (value "A").</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Node-typeField"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TempsMàxim</ows:Identifier>
				<ows:Title>Maximum time</ows:Title>
				<ows:Abstract>It represents the maximum threshold (in the same time units as TimeField) used to discard routes that exceed this travel time,</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:MaximumTime"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampTemps</ows:Identifier>
				<ows:Title>Time field</ows:Title>
				<ows:Abstract>It is the field in the ArcsFile database that contains the travel times associated with each arc. The values must be defined in seconds, minutes, or hours.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:TimeField"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_VINCULAR</ows:Identifier>
				<ows:Title>NO_VINCULAR</ows:Title>
				<ows:Abstract>This parameter eliminates the default behavior of linking the resulting DBF table to the database associated with the source node file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>BDResultats</ows:Identifier>
				<ows:Title>DB results</ows:Title>
				<ows:Abstract>It is the name of the DBF file that will establish the relationships between origin and destination nodes and store the accumulated distance and/or time values.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:DBResults"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Rutes:Param1:3</ows:Identifier>
		<ows:Title>Minimum time (distance/speed)</ows:Title>
		<ows:Abstract>Aquesta opció calcula el mínim temps acumulat a partir de longitud i velocitat de cada arc.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 3</ows:Title>
				<ows:Abstract>For the minimum accumulated time, each segment is obtained as the quotient of length and speed.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerArcs</ows:Identifier>
				<ows:Title>Arcs file</ows:Title>
				<ows:Abstract>It is the name of the structured arc file containing the path network.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:ArcsFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampTipusNode</ows:Identifier>
				<ows:Title>Node-type field</ows:Title>
				<ows:Abstract>It is the alphanumeric field in the ArcsFile node file database that indicates whether a node is a start node (value "O"), an end node (value "D"), or both (value "A").</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Node-typeField"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DistànciaMàxima</ows:Identifier>
				<ows:Title>Maximum distance</ows:Title>
				<ows:Abstract>It represents the maximum threshold (in meters) for discarding routes that exceed this cumulative length.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:MaximumDistance"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampVelocitat</ows:Identifier>
				<ows:Title>Speed field</ows:Title>
				<ows:Abstract>This is the field in the ArcsFile database containing the speeds associated with each arc, which are necessary to calculate the travel time for each route. The associated time units must be defined in seconds, minutes, or hours.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:SpeedField"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_LONG</ows:Identifier>
				<ows:Title>CAMP LONG</ows:Title>
				<ows:Abstract>Specify the field in the FitxerArcs database that will contain the lengths of each arc, which will be used instead of the topological values ??present by default in the database.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MAX_TEMPS</ows:Identifier>
				<ows:Title>MAX_TEMPS</ows:Title>
				<ows:Abstract>If specified, it represents the maximum threshold (in the same time units as the SpeedField) used to discard routes that exceed this travel time.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_VINCULAR</ows:Identifier>
				<ows:Title>NO_VINCULAR</ows:Title>
				<ows:Abstract>This parameter eliminates the default behavior of linking the resulting DBF table to the database associated with the source node file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>BDResultats</ows:Identifier>
				<ows:Title>DB results</ows:Title>
				<ows:Abstract>It is the name of the DBF file that will establish the relationships between origin and destination nodes and store the accumulated distance and/or time values.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:DBResults"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Rutes:Param1:4</ows:Identifier>
		<ows:Title>Minimum accumulated cost</ows:Title>
		<ows:Abstract>This option calculates the minimum accumulated cost based on a travel effort field.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 4</ows:Title>
				<ows:Abstract>For minimum accumulated cost, the cost is defined by the user via a field that measures the effort of movement.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>4</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerArcs</ows:Identifier>
				<ows:Title>Arcs file</ows:Title>
				<ows:Abstract>It is the name of the structured arc file containing the path network.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:ArcsFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampTipusNode</ows:Identifier>
				<ows:Title>Node-type field</ows:Title>
				<ows:Abstract>It is the alphanumeric field in the ArcsFile node file database that indicates whether a node is a start node (value "O"), an end node (value "D"), or both (value "A").</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Node-typeField"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CostMàxim</ows:Identifier>
				<ows:Title>Maximum cost</ows:Title>
				<ows:Abstract>It represents the maximum threshold for discarding routes that exceed this cost.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:MaximumCost"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampCost</ows:Identifier>
				<ows:Title>Cost field</ows:Title>
				<ows:Abstract>This is the ArcsFile database field that will be used to calculate the cost of each route. The field does not need to have an associated unit of measurement.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:CostField"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_VINCULAR</ows:Identifier>
				<ows:Title>NO_VINCULAR</ows:Title>
				<ows:Abstract>This parameter eliminates the default behavior of linking the resulting DBF table to the database associated with the source node file.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>BDResultats</ows:Identifier>
				<ows:Title>DB results</ows:Title>
				<ows:Abstract>It is the name of the DBF file that will establish the relationships between origin and destination nodes and store the accumulated distance and/or time values.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:DBResults"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>