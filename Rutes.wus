<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Rutes:Param1:1</ows:Identifier>
		<ows:Title>Minimum distance</ows:Title>
		<ows:Abstract>This option computes the minimum accumulated distance.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Network analysis and optimal route determination"/>
		<ows:Metadata xlink:title="Abstract:This program determines the optimum routes between a set of origin locations and a set of possible destination locations. The optimum route between a pair of origin-destination locations is the one that minimizes movement from the origin to the destination, whether in terms of distance, time, or a user-defined numeric field representing any other variable that weights the cost of movement."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 1</ows:Title>
				<ows:Abstract>For minimum accumulated distance.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerArcs</ows:Identifier>
				<ows:Title>Arc file</ows:Title>
				<ows:Abstract>It is the name of the structured arc file that contains the path network.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FileArcs"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampTipusNode</ows:Identifier>
				<ows:Title>Node type field</ows:Title>
				<ows:Abstract>It is the alphanumeric field in the node database of the node file of FitxerArcs that indicates whether a node is origin (value "O"), destination (value "D"), or both at the same time, origin and destination (value "A").</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NodeTypeField"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DistànciaMàxima</ows:Identifier>
				<ows:Title>Maximum distance</ows:Title>
				<ows:Abstract>It represents the maximum threshold (in meters) so that routes that exceed this accumulated length are discarded.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:MaximumDistance"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_LONG</ows:Identifier>
				<ows:Title>CAMP LONG</ows:Title>
				<ows:Abstract>It indicates the database field of FitxerArcs that will contain the length of each arc, used instead of the topological values that appear by default in the database.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_VINCULAR</ows:Identifier>
				<ows:Title>NO_VINCULAR</ows:Title>
				<ows:Abstract>This parameter removes the default behavior of linking the resulting DBF table to the associated database of the origin node file.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>BDResultats</ows:Identifier>
				<ows:Title>Results DB</ows:Title>
				<ows:Abstract>It is the name of the DBF file that establishes the relationships between origin and destination nodes and collects the accumulated distance and/or time values.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BDResults"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Rutes:Param1:2</ows:Identifier>
		<ows:Title>Accumulated time</ows:Title>
		<ows:Abstract>This option computes the minimum accumulated time.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 2</ows:Title>
				<ows:Abstract>For minimum accumulated time.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerArcs</ows:Identifier>
				<ows:Title>Arc file</ows:Title>
				<ows:Abstract>It is the name of the structured arc file that contains the path network.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FileArcs"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampTipusNode</ows:Identifier>
				<ows:Title>Node type field</ows:Title>
				<ows:Abstract>It is the alphanumeric field in the node database of the node file of FitxerArcs that indicates whether a node is origin (value "O"), destination (value "D"), or both at the same time, origin and destination (value "A").</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NodeTypeField"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>TempsMàxim</ows:Identifier>
				<ows:Title>Maximum time</ows:Title>
				<ows:Abstract>It represents the maximum threshold (in the same time units as CampTemps) so that routes that exceed this travel time are discarded.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:MaximumTime"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampTemps</ows:Identifier>
				<ows:Title>Time field</ows:Title>
				<ows:Abstract>It is the database field of FileArcs that contains the travel times associated with each arc. Values must be defined in seconds, minutes or hours.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:FieldTime"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_VINCULAR</ows:Identifier>
				<ows:Title>NO_VINCULAR</ows:Title>
				<ows:Abstract>This parameter removes the default behavior of linking the resulting DBF table to the associated database of the origin node file.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>BDResultats</ows:Identifier>
				<ows:Title>Results DB</ows:Title>
				<ows:Abstract>It is the name of the DBF file that establishes the relationships between origin and destination nodes and collects the accumulated distance and/or time values.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BDResults"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Rutes:Param1:3</ows:Identifier>
		<ows:Title>Minimum time (length/speed)</ows:Title>
		<ows:Abstract>This option computes minimum accumulated time from arc length and speed.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 3</ows:Title>
				<ows:Abstract>For minimum accumulated time; each segment is obtained as the quotient between length and speed.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>3</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerArcs</ows:Identifier>
				<ows:Title>Arc file</ows:Title>
				<ows:Abstract>It is the name of the structured arc file that contains the path network.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FileArcs"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampTipusNode</ows:Identifier>
				<ows:Title>Node type field</ows:Title>
				<ows:Abstract>It is the alphanumeric field in the node database of the node file of FitxerArcs that indicates whether a node is origin (value "O"), destination (value "D"), or both at the same time, origin and destination (value "A").</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NodeTypeField"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>DistànciaMàxima</ows:Identifier>
				<ows:Title>Maximum distance</ows:Title>
				<ows:Abstract>It represents the maximum threshold (in meters) so that routes that exceed this accumulated length are discarded.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:MaximumDistance"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampVelocitat</ows:Identifier>
				<ows:Title>Speed field</ows:Title>
				<ows:Abstract>Is the database field of FileArcs that contains the speeds associated with each arc, needed to compute the travel time of each route. The associated time units must be defined in seconds, minutes or hours.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:SpeedField"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_LONG</ows:Identifier>
				<ows:Title>CAMP LONG</ows:Title>
				<ows:Abstract>It indicates the database field of FitxerArcs that will contain the length of each arc, used instead of the topological values that appear by default in the database.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MAX_TEMPS</ows:Identifier>
				<ows:Title>MAX_TEMPS</ows:Title>
				<ows:Abstract>If specified, it represents the maximum threshold (in the same time units as CampVelocitat) so that routes that exceed this travel time are discarded.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#positiveInteger">positiveInteger</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_VINCULAR</ows:Identifier>
				<ows:Title>NO_VINCULAR</ows:Title>
				<ows:Abstract>This parameter removes the default behavior of linking the resulting DBF table to the associated database of the origin node file.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>BDResultats</ows:Identifier>
				<ows:Title>Results DB</ows:Title>
				<ows:Abstract>It is the name of the DBF file that establishes the relationships between origin and destination nodes and collects the accumulated distance and/or time values.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BDResults"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:Rutes:Param1:4</ows:Identifier>
		<ows:Title>Minimum accumulated cost</ows:Title>
		<ows:Abstract>This option computes the minimum accumulated cost according to a movement effort field.</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option 4</ows:Title>
				<ows:Abstract>For minimum accumulated cost; the cost is defined by the user through a field that measures movement effort.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Option"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>4</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerArcs</ows:Identifier>
				<ows:Title>Arc file</ows:Title>
				<ows:Abstract>It is the name of the structured arc file that contains the path network.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FileArcs"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampTipusNode</ows:Identifier>
				<ows:Title>Node type field</ows:Title>
				<ows:Abstract>It is the alphanumeric field in the node database of the node file of FitxerArcs that indicates whether a node is origin (value "O"), destination (value "D"), or both at the same time, origin and destination (value "A").</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:NodeTypeField"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CostMàxim</ows:Identifier>
				<ows:Title>Maximum cost</ows:Title>
				<ows:Abstract>It represents the maximum threshold so that routes that exceed this cost are discarded.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:MaximumCost"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>CampCost</ows:Identifier>
				<ows:Title>Cost field</ows:Title>
				<ows:Abstract>It is the database field of FitxerArcs that will be used to compute the cost of each route. The field does not need to have any associated unit of measurement.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:CostField"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>NO_VINCULAR</ows:Identifier>
				<ows:Title>NO_VINCULAR</ows:Title>
				<ows:Abstract>This parameter removes the default behavior of linking the resulting DBF table to the associated database of the origin node file.</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>BDResultats</ows:Identifier>
				<ows:Title>Results DB</ows:Title>
				<ows:Abstract>It is the name of the DBF file that establishes the relationships between origin and destination nodes and collects the accumulated distance and/or time values.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:BDResults"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-DBF</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>