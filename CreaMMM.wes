<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 https://schemas.opengis.net/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CreaMMM:1</ows:Identifier>
		<ows:Title>Crear mapa (opción 1)</ows:Title>
		<ows:Abstract>Programa para crear mapas de MiraMon (formato MMM) de manera rápida y desde línea de comandos, donde el nombre y orden de las capas es constante pero cambian los nombres de las capas.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Creación automática de mapas de MiraMon" />
		<ows:Metadata xlink:title="Abstract:Programa para crear mapas de MiraMon (formato MMM) de manera rápida y desde línea de comandos." />
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>1. Los nombres de las capas y algunos parámetros de visualización se indican en línea de comando.</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer "> integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>		
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PlantillaMMM</ows:Identifier>
				<ows:Title>Plantilla MMM</ows:Title>
				<ows:Abstract>Mapa de MiraMon que sirve como plantilla para todo lo que no genera el programa. Si no se desea plantilla puede indicarse NUL (sólo en la opción 1).</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
				<ows:Metadata xlink:title="FillInValue:NUL"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Capa</ows:Identifier>
				<ows:Title>Capa</ows:Title>
				<ows:Abstract>Nombre de la capa. El patrón "Capa Paleta PaletaInterior" puede repetirse tantas veces como capas a incluir</ows:Abstract>
				<ows:Metadata xlink:title="Param4" />
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
							<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Paleta</ows:Identifier>
				<ows:Title>Paleta</ows:Title>
				<ows:Abstract>Paleta de colores, un color RGB (3 números separados por coma sin espacios) o NUL si no se requiere paleta.</ows:Abstract>
				<ows:Metadata xlink:title="Param5" />
				<ows:Metadata xlink:title="FillInValue:NUL"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue></ows:AnyValue>
					<DefaultValue>NUL</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PaletaInterior</ows:Identifier>
				<ows:Title>Paleta para interior</ows:Title>
				<ows:Abstract>Paleta de colores para el relleno interior de polígonos, un color RGB (3 números separados por coma sin espacios) o NUL si no se requiere paleta.</ows:Abstract>
				<ows:Metadata xlink:title="Param6" />
				<ows:Metadata xlink:title="FillInValue:NUL"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue />
					<DefaultValue>NUL</DefaultValue>
				</LiteralData>			
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TITOL</ows:Identifier>
				<ows:Title>Titulo</ows:Title>
				<ows:Abstract>Es el título del mapa. Si no se indica, se toma del título de la primera capa.
				</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VERIFICA</ows:Identifier>
				<ows:Title>Verifica</ows:Title>
				<ows:Abstract>Indica que hay que verificar la existencia de la capa. En la opción 1, y en caso de haber plantilla, el programa se para; si no hay plantilla el programa se queja pero se permite continuar; para los ficheros de tipo VEC, el programa verifica siempre la existencia del fichero y para si no lo encuentra porque necesita leer el fichero de documentación para identificar su tipo.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues><ows:Value>##blank##</ows:Value></ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NouMMM</ows:Identifier>
				<ows:Title>Nuevo MMM</ows:Title>
				<ows:Abstract>Es el mapa de MiraMon a crear.</ows:Abstract>
				<ows:Metadata xlink:title="Param2" />
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CreaMMM:2</ows:Identifier>
		<ows:Title>Crear series de mapas (opción 2)</ows:Title>
		<ows:Abstract>Opción pensada para trabajar con series cartográficas donde los nombres de ficheros son fijos (cambiando el directorio o las primeras letras del nombre, por ejemplo para indicar la hoja de que se trata) pero en las que pueden faltar algunas capas para algunos mapas de la serie (por ejemplo una hoja pequeña en la que no aparece ninguna línea eléctrica).</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>2. Los nombres de las capas se indican en la plantilla y solamente se cambia TextoABuscar por el TextoSubstituido en los paths de las capas.</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer ">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>		
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PlantillaMMM</ows:Identifier>
				<ows:Title>Plantilla MMM</ows:Title>
				<ows:Abstract>Mapa de MiraMon que sirve como plantilla para todo lo que no genera el programa.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TextABuscar</ows:Identifier>
				<ows:Title>Texto A Buscar</ows:Title>
				<ows:Abstract>Texto a buscar en el path del nombre de la capa en el mapa plantilla. Si no desea buscar nada, indique una cadena imposible de encontrar.
				</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TextSubstituit</ows:Identifier>
				<ows:Title>Texto Substituido</ows:Title>
				<ows:Abstract>Texto substituido en el path del nombre de la capa en el nuevo mapa.
				</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TITOL</ows:Identifier>
				<ows:Title>Titulo</ows:Title>
				<ows:Abstract>Es el título del mapa. Si no se indica, se toma del título de la primera capa.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VERIFICA</ows:Identifier>
				<ows:Title>Verifica</ows:Title>
				<ows:Abstract>Indica que hay que verificar la existencia de la capa. En la opción 2, si la capa no existe no se incluye en el mapa y se continúa.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NouMMM</ows:Identifier>
				<ows:Title>Nuevo MMM</ows:Title>
				<ows:Abstract>Es el mapa de MiraMon a crear.</ows:Abstract>
				<ows:Metadata xlink:title="Param2" />
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>	
</wps:ProcessDescriptions>
