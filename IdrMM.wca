<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:IdrMM:1</ows:Identifier>
		<ows:Title>IdrMM</ows:Title>
		<ows:Abstract>Aquesta aplicació transforma fitxers ràster entre el MiraMon i l'Idrisi-32.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Importació i exportació entre formats ràster de l&apos;Idrisi i del MiraMon"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació transforma fitxers ràster entre el MiraMon i l&apos;Idrisi-32."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opció</ows:Title>
				<ows:Abstract><![CDATA[<li>1. Exportació del MiraMon (FitxerOrigen ) a l'Idrisi-32 (FitxerDestí ). Els paràmetres opcionals d'aquesta opció són:<ul><li>/LONG_SHORT</li><li>/LONG_REAL</li></ul> 2. Importació des de l'Idrisi-32 (FitxerOrigen ) al MiraMon (FitxerDestí ). Aquest cas no té paràmetres opcionals.</li><li>3. Exportació d'imatges JPEG (FitxerOrigen ) a fitxers RGB d'Idrisi-32 (FitxerDestí ). Si la imatge origen és georeferenciada (J.rel), es genera un RST també georeferenciat. Aquest cas no té paràmetres opcionals.</li>]]></ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Option</ows:Identifier>
				<ows:Metadata xlink:title="Param1"/>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcion</ows:Identifier>
				<ows:Metadata xlink:title="Param1"/>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ArchivoOrigen</ows:Identifier>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>OriginFile</ows:Identifier>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigen</ows:Identifier>
				<ows:Title>Fitxer Origen</ows:Title>
				<ows:Abstract>Es el fitxer a importar</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>LONG_SHORT</ows:Identifier>
				<ows:Title>Dades tipus integer</ows:Title>
				<ows:Abstract>Realitza una exportació de dades origen tipus long a dades destí tipus integer.</ows:Abstract>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>LONG_REAL</ows:Identifier>
				<ows:Title>Dades tipus real</ows:Title>
				<ows:Abstract>Realitza una exportació de dades origen tipus long a dades destí tipus real.</ows:Abstract>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxerDestí</ows:Identifier>
				<ows:Title>FitxerDestí</ows:Title>
				<ows:Abstract>Es el fitxer a importat</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>DestinationFile</ows:Identifier>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>ArchivoDestino</ows:Identifier>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-IMG</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>