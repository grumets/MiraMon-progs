<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:RasSelec:1</ows:Identifier>
		<ows:Metadata xlink:title="Title:Selection of a subset of raster cells"/>
		<ows:Metadata xlink:title="Abstract:Select from a subset of cells from a monoband or multiband raster."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxOri</ows:Identifier>
				<ows:Title>Input file</ows:Title>
				<ows:Abstract>Input file for selection</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:InputFile"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>RETALL_SEL</ows:Identifier>
				<ows:Title>Clip to selection</ows:Title>
				<ows:Abstract>Clip output raster to selection.</ows:Abstract>
				<ows:Metadata xlink:title="Name:RETALL_SEL"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PREFIX</ows:Identifier>
				<ows:Title>Multibanda prefix</ows:Title>
				<ows:Abstract>Prefix in the output files in case of multiband.</ows:Abstract>
				<ows:Metadata xlink:title="Name:PREFIX"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MASC_NODATA</ows:Identifier>
				<ows:Title>Set 0 as NoData</ows:Title>
				<ows:Abstract>In case the output is selected as mask format, 0 is marked as a value without data.</ows:Abstract>
				<ows:Metadata xlink:title="Name:MASC_NODATA"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MULTIBANDA</ows:Identifier>
				<ows:Title>Multiband output</ows:Title>
				<ows:Abstract>In case you want multiband output.</ows:Abstract>
				<ows:Metadata xlink:title="Name:MULTIBAND"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="50">
				<ows:Identifier>COND#_OP</ows:Identifier>
				<ows:Title>Conditions or operator</ows:Title>
				<ows:Abstract>Selecting the logical operator acting on /COND_CAMP(band) to filter the pixels to filter the cells of the source file. For more details on this and the following optional parameters, see "Selecting graphic objects by database attributes" in "Syntax aspects of some MiraMon Support applications (MSA)"</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>EQ</ows:Value>
						<ows:Value>NO_EQ</ows:Value>
						<ows:Value>EQ_SUBCADENA</ows:Value>
						<ows:Value>NO_EQ_SUBCADENA</ows:Value>
						<ows:Value>LT_EQ</ows:Value>
						<ows:Value>GT_EQ</ows:Value>
						<ows:Value>INTERVAL</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="50">
				<ows:Identifier>COND#_CAMP</ows:Identifier>
				<ows:Title>Bands of the condition</ows:Title>
				<ows:Abstract>Selection of the field on which they will apply the /COND_OP</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="50">
				<ows:Identifier>COND#_VALOR</ows:Identifier>
				<ows:Title>Value of the condition</ows:Title>
				<ows:Abstract>Value of /COND_CAMP on which it will apply the /COND_OP. It must be between quotes if it has spaces.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="50">
				<ows:Identifier>COND#_NEXE</ows:Identifier>
				<ows:Title>Nexus between conditions</ows:Title>
				<ows:Abstract>Nexus between conditions # y #+1. It can be AND o OR.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>OR</ows:Value>
						<ows:Value>AND</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>FitxOut</ows:Identifier>
				<ows:Title>Output file or directory</ows:Title>
				<ows:Abstract>Output file in case of monoband or output directory in case of multiband.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:OutputFile"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>