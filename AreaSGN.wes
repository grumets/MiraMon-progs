<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="es-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:AreaSGN:Param1:2</ows:Identifier>
		<ows:Title>Opción 2</ows:Title>
		<ows:Abstract>Crea los ficheros de signaturas espectrales SGN de todas las bandas espectrales de una imagen a partir de unas áreas de entrenamiento.</ows:Abstract>
		<ows:Metadata xlink:title="Title:Creación de signaturas y estadísticas espectrales a partir de áreas de entrenamiento"/>
		<ows:Metadata xlink:title="Abstract:Crea los ficheros de signaturas espectrales SGN de todas las bandas espectrales de una imagen a partir de unas áreas de entrenamiento."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Opción</ows:Title>
				<ows:Abstract>Creación de las signaturas espectrales y tabla CSV a partir de una capa ráster o de polígonos categóricos.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:Opción"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>FitxerOrigen</ows:Identifier>
				<ows:Title>Fichero origen</ows:Title>
				<ows:Abstract>Fichero ráster categórico IMG o de polígonos POL con la información del tipo de clase asociado a cada píxel de la imagen o a cada polígono.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:FicheroOrigen"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Llista</ows:Identifier>
				<ows:Title>Fichero lista de capas ráster</ows:Title>
				<ows:Abstract>Fichero de texto donde se incluyen los nombres de las diferentes capas ráster correspondientes a bandas de imágenes satélite, MDT, etc...</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Lista"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/plain</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-lst</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP</ows:Identifier>
				<ows:Title>Campo de categoría</ows:Title>
				<ows:Abstract>En el caso que el fichero origen sea una capa de polígonos, es el campo de tabla DBF que contiene la categoría asociada a cada polígono.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>REPE</ows:Identifier>
				<ows:Title>Registro elegido cuando hay más de un índice</ows:Title>
				<ows:Abstract><![CDATA[Indica qué registro es elegido cuando hay más de un registro por identificador gráfico (registro múltiple). Para saber más sobre los valores de este parámetro, seguid las consideraciones del documento de <a href="general.htm#TaulaCamp">sintaxi general</a>.]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>CAMP_CAT</ows:Identifier>
				<ows:Title>Campo con el nombre de las categorías</ows:Title>
				<ows:Abstract>En el caso de que el fichero sea de polígonos y se elija un campo de categoría numérico, corresponde al campo con los nombres de las categorías.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>MEDIANA_EMPAT</ows:Identifier>
				<ows:Title>Desempate de los cuantiles</ows:Title>
				<ows:Abstract><![CDATA[Indica que tipo de desempate hacer en el caso de los cuartiles (media, primer cuartil, tercer cuartil, etc...).<ul>           <li>1: Valor alternado.</li>           <li>2: Valor inferior.</li>           <li>3: Valor superior.</li>           <li>4: Promedio de los valores centrales.</li>           </ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>1</ows:Value>
						<ows:Value>2</ows:Value>
						<ows:Value>3</ows:Value>
						<ows:Value>4</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>1</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>N_DECIM_HTML</ows:Identifier>
				<ows:Title>Número decimales datos HTML</ows:Title>
				<ows:Abstract>Número de decimales de los datos del fichero HTML de gráficos de signaturas.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>3</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRAF_HTML_W_IMP</ows:Identifier>
				<ows:Title>Ancho resolución calidad impresión gráficos HTML</ows:Title>
				<ows:Abstract>Ancho de la resolución de calidad para impresión de los gráficos de signaturas del fichero HTML.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>2100</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRAF_HTML_H_IMP</ows:Identifier>
				<ows:Title>Altura resolución calidad impresión gráficos HTML</ows:Title>
				<ows:Abstract>Altura de la resolución de calidad para impresión de los gráficos de signaturas del fichero HTML.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>1800</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRAF_HTML_W_VIS</ows:Identifier>
				<ows:Title>Ancho resolución estándar visualización gráficos HTML</ows:Title>
				<ows:Abstract>Ancho de la resolución estándar para la visualización en pantalla de los gráficos de signaturas del fichero HTML.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>700</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>GRAF_HTML_H_VIS</ows:Identifier>
				<ows:Title>Altura resolución estándar visualización gráficos HTML</ows:Title>
				<ows:Abstract>Altura de la resolución estándar para la visualización en pantalla de los gráficos de signaturas del fichero HTML.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
					<ows:AnyValue/>
					<DefaultValue>600</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OBRIR_HTML</ows:Identifier>
				<ows:Title>Abrir fichero HTML generado</ows:Title>
				<ows:Abstract>Abrir directamente el fichero HTML una vez generado.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>DIST_CSV</ows:Identifier>
				<ows:Title>Distancia</ows:Title>
				<ows:Abstract><![CDATA[Tipo de distancia:<ul><li>EUC: Euclidiana.</li><li>EIX: Ensanche (o Manhattan).</li></ul>]]></ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>EUC</ows:Value>
						<ows:Value>EIX</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>EUC</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>OBRIR_CSV</ows:Identifier>
				<ows:Title>Abrir fichero CSV generado</ows:Title>
				<ows:Abstract>Abrir directamente el fichero CSV una vez generado.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>##blank##</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>SGN</ows:Identifier>
				<ows:Title>Signaturas espectrales</ows:Title>
				<ows:Abstract>Directorio de los ficheros de signaturas espectrales de salida.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:SGN"/>
				<LiteralOutput>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#anyURI">anyURI</ows:DataType>
				</LiteralOutput>
			</Output>
			<Output>
				<ows:Identifier>HTML</ows:Identifier>
				<ows:Title>Fichero HTML de gráfico de signaturas</ows:Title>
				<ows:Abstract>Dirección del fichero HTML de salida de gráficos de signaturas.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/html</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/html</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
			<Output>
				<ows:Identifier>CSV</ows:Identifier>
				<ows:Title>Fichero CSV de estadísticas espectrales</ows:Title>
				<ows:Abstract>Dirección del fichero CSV de salida con estadísticas espectrales.</ows:Abstract>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>text/csv</MimeType>
							<Encoding>ascii</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>