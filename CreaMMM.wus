<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="en-US">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CreaMMM:1</ows:Identifier>
		<ows:Title>Create a map (option 1)</ows:Title>
		<ows:Abstract>This program creates MiraMon maps (MMM format) rapidly from the command line, where the name and the order of the layers is constant but the names of the layers change</ows:Abstract>
		<ows:Metadata xlink:title="Title:Maps and cartographic series automatic creation" />
		<ows:Metadata xlink:title="Abstract:This program creates MiraMon maps (MMM format) rapidly from the command line. An existing map may be used as a template." />
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>1. The names of the layers and some of the display parameters are entered in the command line.</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer "> integer</ows:DataType>
						<ows:Value>1</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
				<DefaultValue>1</DefaultValue>
			</Input>		
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PlantillaMMM</ows:Identifier>
				<ows:Title>Template MMM</ows:Title>
				<ows:Abstract>The MiraMon map that will serve as a template for all that is not generated by the program. If a template is not wanted the user can enter NUL (only option 1).</ows:Abstract>
				<ows:Metadata xlink:title="Param3" />
				<ows:Metadata xlink:title="FillInValue:NUL"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Capa</ows:Identifier>
				<ows:Title>Layers</ows:Title>
				<ows:Abstract>Name of the layer. The pattern "Capa Paleta PaletaInterior" can be repeated as many times as layers to be included in the map.</ows:Abstract>
				<ows:Metadata xlink:title="Param4" />
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-arc</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pnt</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-pol</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
							<Format>
							<MimeType>application/x-vec</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Paleta</ows:Identifier>
				<ows:Title>Palette</ows:Title>
				<ows:Abstract>Colour palette, an RGB colours (3 numbers separated by coma without spaces) or NUL if there is no palette.</ows:Abstract>
				<ows:Metadata xlink:title="Param5" />
				<ows:Metadata xlink:title="FillInValue:NUL"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<DefaultValue>NUL</DefaultValue>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PaletaInterior</ows:Identifier>
				<ows:Title>Palette for interior</ows:Title>
				<ows:Abstract>Colour palette for the interior of polygons, an RGB color (3 numbers separated by coma without spaces).
				</ows:Abstract>
				<ows:Metadata xlink:title="Param6" />
				<ows:Metadata xlink:title="FillInValue:NUL"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<DefaultValue>NUL</DefaultValue>
				</LiteralData>			
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TITOL</ows:Identifier>
				<ows:Title>Title</ows:Title>
				<ows:Abstract>The title of the map. If not entered the first layer is used.
				</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VERIFICA</ows:Identifier>
				<ows:Title>Verify</ows:Title>
				<ows:Abstract>Indicates that it is necessary to verify the existence of the layer. In option 1, and where a template exists, the program stops. If there is no template the program emits a message but allows the process to continue. For VEC type files, the program always verifies the existence of the file and stops if it doesn't find it because it needs to read the documentation file to identify the file type.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues><ows:Value>##blank##</ows:Value></ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NouMMM</ows:Identifier>
				<ows:Title>New MMM</ows:Title>
				<ows:Abstract>Is the MiraMon map to be created.</ows:Abstract>
				<ows:Metadata xlink:title="Param2" />
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:CreaMMM:2</ows:Identifier>
		<ows:Title>Create series of maps (option 2)</ows:Title>
		<ows:Abstract>Option thought to work map series where the file names are fixed (changing only the directory or the first few letters of the name, for example, to indicate which sheet is which) but for which some layers of some sheets of the series may be missing (for example a small sheet containing no electricity power lines)</ows:Abstract>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Opcio</ows:Identifier>
				<ows:Title>Option</ows:Title>
				<ows:Abstract>2. The names of the layers are taken from the template and only the SearchText is changed for the SubstituteText in the layers' paths.</ows:Abstract>
				<ows:Metadata xlink:title="Param1" />
				<LiteralData>
					<ows:AllowedValues>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#integer">integer</ows:DataType>
						<ows:Value>2</ows:Value>
					</ows:AllowedValues>
					<DefaultValue>2</DefaultValue>
				</LiteralData>
			</Input>		
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>PlantillaMMM</ows:Identifier>
				<ows:Title>Map Template (MMM)</ows:Title>
				<ows:Abstract>MiraMon map that will serve as a template for all that is not generated by the program.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TextABuscar</ows:Identifier>
				<ows:Title>Search Text</ows:Title>
				<ows:Abstract>Text to be searched for inside the path name of the layer in the template map. If you don't want to search enter a character string which can't be found.
				</ows:Abstract>
				<LiteralData>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TextSubstituit</ows:Identifier>
				<ows:Title>Substitute Text</ows:Title>
				<ows:Abstract>Text to substitute the SearchText in the path name of the layer in the new map.
				</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>TITOL</ows:Identifier>
				<ows:Title>Title</ows:Title>
				<ows:Abstract>The title of the map. If not entered the first layer is used.</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="0" maxOccurs="1">
				<ows:Identifier>VERIFICA</ows:Identifier>
				<ows:Title>Verifica</ows:Title>
				<ows:Abstract>Indicates that it is necessary to verify the existence of the layer. In option 2, if the layer does not exist it will not be included in the map and the program continues
				</ows:Abstract>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues><ows:Value>##blank##</ows:Value></ows:AllowedValues>
					<DefaultValue>##blank##</DefaultValue>
				</LiteralData>
			</Input>
		</DataInputs>	
		<ProcessOutputs>
			<Output>
				<ows:Identifier>NouMMM</ows:Identifier>
				<ows:Title>New map (MMM)</ows:Title>
				<ows:Abstract>Is the MiraMon map to be created.
				</ows:Abstract>
				<ows:Metadata xlink:title="Param2" />
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-mmm</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>	
</wps:ProcessDescriptions>
