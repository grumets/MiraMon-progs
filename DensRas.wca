<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:DensRas</ows:Identifier>
		<ows:Title>DensRas:Densificació i desdensificació (remostreig) de ràsters</ows:Title>
		<ows:Abstract>Aquesta aplicació canvia el costat de la cel·la d'un ràster (el densifica o desdensifica, segons el cas), sense excedir l'envolupant del ràster original, i permetent, si cal, un canvi d'origen de malla. El procediment actua mitjançant un dels següents quatre mètodes de remostreig: veí més proper, moda de 4 veïns, interpolació bilineal o interpolació bicúbica. En aquestes dues darreres opcions (interpolació bilineal i interpolació bicúbica), quan el valor resultat del remostreig és un valor fora del rang de valors  del ràster original (inferior al valor mínim o superior al valor màxim del ràster original), es permet que la persona usuària seleccioni si es desitja saturar el valor remostrejat al valor mínim del ràster original (o màxim segons correspongui) o bé assignar sensedades. Per altra banda, el programa fa un tractament curós del valor del sensedades (no el considera en el remostreig: per exemple, si un dels 4 veïns a la posició d'una cel·la en el nou ràster és un sensedades i el criteri és la moda, aquesta moda es calcularà considerant només els 3 veïns amb dades).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Densificació i desdensificació (remostreig) de ràsters"/>
		<ows:Metadata xlink:title="Abstract:Aquesta aplicació canvia el costat de la cel·la d&apos;un ràster (el densifica o desdensifica, segons el cas), sense excedir l&apos;envolupant del ràster original, i permetent, si cal, un canvi d&apos;origen de malla. El procediment actua mitjançant un dels següents quatre mètodes de remostreig: veí més proper, moda de 4 veïns, interpolació bilineal o interpolació bicúbica. En aquestes dues darreres opcions (interpolació bilineal i interpolació bicúbica), quan el valor resultat del remostreig és un valor fora del rang de valors  del ràster original (inferior al valor mínim o superior al valor màxim del ràster original), es permet que la persona usuària seleccioni si es desitja saturar el valor remostrejat al valor mínim del ràster original (o màxim segons correspongui) o bé assignar sensedades. Per altra banda, el programa fa un tractament curós del valor del sensedades (no el considera en el remostreig: per exemple, si un dels 4 veïns a la posició d&apos;una cel·la en el nou ràster és un sensedades i el criteri és la moda, aquesta moda es calcularà considerant només els 3 veïns amb dades)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RasterOriginal</ows:Identifier>
				<ows:Title>Ràster original</ows:Title>
				<ows:Abstract>Nom del ràster original a densificar.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:RasterOriginal"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Xmin</ows:Identifier>
				<ows:Title>X mínima</ows:Title>
				<ows:Abstract>Defineix la X mínima de l'àmbit del ràster densificat.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:Xmin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Xmax</ows:Identifier>
				<ows:Title>X màxima</ows:Title>
				<ows:Abstract>Defineix l'X màxima de l'àmbit del ràster densificat.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:Xmax"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Ymin</ows:Identifier>
				<ows:Title>Y mínima</ows:Title>
				<ows:Abstract>Defineix l'Y mínima de l'àmbit del ràster densificat.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:Ymin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Ymax</ows:Identifier>
				<ows:Title>Y màxima</ows:Title>
				<ows:Abstract>Defineix l'Y màxima de l'àmbit del ràster densificat.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:Ymax"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Cpix</ows:Identifier>
				<ows:Title>Costat de la cel·la</ows:Title>
				<ows:Abstract><![CDATA[Costat de la cel·la o píxel del ràster densificat. Si Xmax no correspon a un valor enter <i>n</i> tal que Xmax=Xmin+n*Cpix, Xmax serà adaptada convenientment. Anàlogament per a Ymax.]]></ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:CPix"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Remostreig</ows:Identifier>
				<ows:Title>Tipus de remostreig</ows:Title>
				<ows:Abstract>Indica el tipus de remostreig: 'V' per veí més proper, 'M' per moda de 4 veïns, 'L' per a interpolació bilineal i 'C' per a interpolació bicúbica.</ows:Abstract>
				<ows:Metadata xlink:title="Param8"/>
				<ows:Metadata xlink:title="Name:Remostreig"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>V</ows:Value>
						<ows:Value>M</ows:Value>
						<ows:Value>L</ows:Value>
						<ows:Value>C</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>RasterDensificat</ows:Identifier>
				<ows:Title>Ràster densificat</ows:Title>
				<ows:Abstract>Nom del ràster densificat. S'assumeix que els fitxers tenen extensió img si no s'indica.</ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:RasterDensificat"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>