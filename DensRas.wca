<?xml version="1.0" encoding="ISO-8859-1"?>
<wps:ProcessDescriptions xmlns:wps="http://www.opengis.net/wps/1.0.0" xmlns:ows="http://www.opengis.net/ows/1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/wps/1.0.0 schemas/wps/1.0.0/wpsDescribeProcess_response.xsd" service="WPS" version="1.0.0" xml:lang="ca-ES">
	<ProcessDescription wps:processVersion="1" storeSupported="true" statusSupported="false">
		<ows:Identifier>MiraMon:DensRas</ows:Identifier>
		<ows:Title>DensRas:Densificació de ràsters</ows:Title>
		<ows:Abstract>Aquest programa canvia la mida d'un píxel d'un ràster (densifica) mitjançant veí més proper, moda a 4 veïns, interpolació bilineal o bicúbica. El programa fa un tractament curós del valor del NODATA (no el considera en la interpolació).</ows:Abstract>
		<ows:Metadata xlink:title="Title:Densificació de ràsters"/>
		<ows:Metadata xlink:title="Abstract:Aquest programa canvia la mida d'un píxel d'un ràster (densifica) mitjançant veí més proper, moda a 4 veïns, interpolació bilineal o bicúbica. El programa fa un tractament curós del valor del NODATA (no el considera en la interpolació)."/>
		<DataInputs>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>RasterOriginal</ows:Identifier>
				<ows:Title>Ràster Original</ows:Title>
				<ows:Abstract>Nom de l'arxiu original a densificar.</ows:Abstract>
				<ows:Metadata xlink:title="Param1"/>
				<ows:Metadata xlink:title="Name:RasterOriginal"/>
				<ComplexData>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>xmin</ows:Identifier>
				<ows:Title>X mínima</ows:Title>
				<ows:Abstract>Defineix la X mínima de l'àmbit del ràster densificat.</ows:Abstract>
				<ows:Metadata xlink:title="Param3"/>
				<ows:Metadata xlink:title="Name:xmin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>xmax</ows:Identifier>
				<ows:Title>X màxima</ows:Title>
				<ows:Abstract>Defineix la X màxima de l'àmbit del ràster densificat.</ows:Abstract>
				<ows:Metadata xlink:title="Param4"/>
				<ows:Metadata xlink:title="Name:xmax"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ymin</ows:Identifier>
				<ows:Title>Y Mínima</ows:Title>
				<ows:Abstract>Defineix la Y mínima de l'àmbit del ràster densificat.</ows:Abstract>
				<ows:Metadata xlink:title="Param5"/>
				<ows:Metadata xlink:title="Name:ymin"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>ymax</ows:Identifier>
				<ows:Title>Y Màxima</ows:Title>
				<ows:Abstract>Defineix la Y màxima de l'àmbit del ràster densificat.</ows:Abstract>
				<ows:Metadata xlink:title="Param6"/>
				<ows:Metadata xlink:title="Name:ymax"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Cpix</ows:Identifier>
				<ows:Title>Costat píxel</ows:Title>
				<ows:Abstract>És el costat de píxel del ràster densificat. xmax i ymax seran adaptats convenientment en funció d'aquest valor.</ows:Abstract>
				<ows:Metadata xlink:title="Param7"/>
				<ows:Metadata xlink:title="Name:CPix"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#double">double</ows:DataType>
					<ows:AnyValue/>
				</LiteralData>
			</Input>
			<Input minOccurs="1" maxOccurs="1">
				<ows:Identifier>Interpol</ows:Identifier>
				<ows:Title>Tipus Interpolació</ows:Title>
				<ows:Abstract>Indica el tipus d_interpolació: 'V' per veí més proper, 'M' per moda a 4 veïns, 'L' per a interpolació bilineal i 'C' per a bicúbica.</ows:Abstract>
				<ows:Metadata xlink:title="Param8"/>
				<ows:Metadata xlink:title="Name:Interpol"/>
				<LiteralData>
					<ows:DataType ows:reference="http://www.w3.org/TR/xmlschema-2/#string">string</ows:DataType>
					<ows:AllowedValues>
						<ows:Value>V</ows:Value>
						<ows:Value>M</ows:Value>
						<ows:Value>L</ows:Value>
						<ows:Value>C</ows:Value>
					</ows:AllowedValues>
				</LiteralData>
			</Input>
		</DataInputs>
		<ProcessOutputs>
			<Output>
				<ows:Identifier>RasterDensificat</ows:Identifier>
				<ows:Title>Ràster Densificat</ows:Title>
				<ows:Abstract>És el nom de l'arxiu densificat. S'assumeix que els fitxers tenen extensió IMG si no s'indica. </ows:Abstract>
				<ows:Metadata xlink:title="Param2"/>
				<ows:Metadata xlink:title="Name:RasterDensificat"/>
				<ComplexOutput>
					<Default>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Default>
					<Supported>
						<Format>
							<MimeType>application/x-img</MimeType>
							<Encoding>Binary</Encoding>
						</Format>
					</Supported>
				</ComplexOutput>
			</Output>
		</ProcessOutputs>
	</ProcessDescription>
</wps:ProcessDescriptions>
